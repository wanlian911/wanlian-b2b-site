---
import Header from '../components/shared/Header.astro';
import Footer from '../components/shared/Footer.astro';
import WhatsAppButton from '../components/shared/WhatsAppButton.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	canonicalURL?: string;
	noindex?: boolean;
	type?: 'website' | 'article' | 'product';
	productData?: any; // 用于传递产品数据生成 JSON-LD
	faq?: { question: string; answer: string }[]; // FAQ 区块 + FAQPage JSON-LD
	breadcrumbs?: { name: string; href?: string }[]; // 面包屑 + BreadcrumbList JSON-LD
}

const { 
	title, 
	description = "Wanlian Fluid - Professional B2B industrial fluid system solutions.", 
	image = "/og-image.jpg",
	canonicalURL,
	noindex = false,
	type = 'website',
	productData,
	faq = [],
	breadcrumbs = []
} = Astro.props;

const siteBase = Astro.site ?? Astro.url;
const canonical = canonicalURL ?? new URL(Astro.url.pathname, siteBase).href;
const absoluteUrl = (value: string) => new URL(value, siteBase).href;

// 全局机构信息 (JSON-LD)
const organizationJsonLd = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": "https://wanlian911.com/#organization",
	"name": "Quanzhou Wanlian Fluid Equipment Co., Ltd.",
	"alternateName": "Wanlian Fluid",
	"description": "Quanzhou Wanlian Fluid Equipment Co., Ltd. is a professional fluid equipment enterprise integrating R&D, sales and service, supplying valves, fire protection equipment, hydraulic control products and fluid system components for international B2B projects. Production is carried out at cooperative manufacturing bases in accordance with the ISO9001 Quality Management System.",
	"url": "https://wanlian911.com",
	"logo": "https://wanlian911.com/favicon.svg",
	"email": "dhuog77@gmail.com",
	"contactPoint": {
		"@type": "ContactPoint",
		"telephone": "+86-18684324501",
		"contactType": "sales",
		"areaServed": "Global",
		"availableLanguage": ["English", "Chinese"]
	},
	"sameAs": [
		"https://wa.me/8618684324501",
		"https://www.linkedin.com/company/wanlian-fluid-equipment",
		"https://qzwlequipment.en.alibaba.com/"
	]
};

const websiteJsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": "https://wanlian911.com/#website",
	"url": "https://wanlian911.com",
	"name": "Wanlian Fluid Equipment",
	"publisher": { "@id": "https://wanlian911.com/#organization" }
};

// 按询盘报价的产品不输出 offers/price，避免产生错误的零价商品信号。
const productJsonLd = productData ? {
	"@context": "https://schema.org/",
	"@type": "Product",
	"name": productData.name,
	"image": absoluteUrl(productData.image),
	"description": productData.description,
	"sku": productData.id,
	"category": productData.category,
	"brand": {
		"@type": "Brand",
		"name": "Wanlian Fluid"
	},
	"additionalProperty": Object.entries(productData.specs ?? {}).map(([name, value]) => ({
		"@type": "PropertyValue",
		name,
		value
	}))
} : null;

// FAQPage 结构化数据 (JSON-LD)
const faqJsonLd = faq.length ? {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faq.map(item => ({
		"@type": "Question",
		"name": item.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": item.answer
		}
	}))
} : null;

// BreadcrumbList 结构化数据 (JSON-LD)
const breadcrumbJsonLd = breadcrumbs.length ? {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{
			"@type": "ListItem",
			"position": 1,
			"name": "Home",
			"item": "https://wanlian911.com/"
		},
		...breadcrumbs.map((item, index) => ({
			"@type": "ListItem",
			"position": index + 2,
			"name": item.name,
			...(item.href ? { "item": new URL(item.href, "https://wanlian911.com/").href } : {})
		}))
	]
} : null;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		{noindex ? (
			<meta name="robots" content="noindex, nofollow" />
		) : (
			<meta name="robots" content="index, follow" />
		)}
		<meta name="theme-color" content="#004797" />
		{!noindex && <link rel="canonical" href={canonical} />}

		<!-- Google Fonts: Roboto -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" rel="stylesheet">

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Wanlian Fluid Equipment" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={absoluteUrl(image)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonical} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={absoluteUrl(image)} />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
		{productJsonLd && (
			<script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
		)}
		{faqJsonLd && (
			<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
		)}
		{breadcrumbJsonLd && (
			<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
		)}
	</head>
	<body class="bg-gray-50 text-gray-900 flex flex-col min-h-screen">
		<Header />
		<div class="flex-grow">
			<slot />
		</div>
		<Footer />
		<WhatsAppButton phone="+8618684324501" message="Hi, I am interested in your valves and firefighting equipment." />
	</body>
</html>
<style is:global>
	:root {
		--accent-blue: #004797;
		--accent-red: #cc2128;
		--industrial-gray: #333333;
	}
	html {
		scroll-behavior: smooth;
		font-family: 'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji';
	}
</style>
