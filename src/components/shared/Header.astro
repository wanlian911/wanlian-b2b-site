---
import { localeFromPath, safeHref, stripLocale, localeHrefFor, localizePath, activeLocales, type Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';
import { products, type Product } from '../../utils/products';
import { productsEs } from '../../utils/products.es';
import { productsRu } from '../../utils/products.ru';
import { productsFr } from '../../utils/products.fr';
import { productsAr } from '../../utils/products.ar';

interface Props {
  locale?: Locale;
  phone?: string; // 国际区号格式纯数字，如 "+8618684324501"；提供后在顶栏显示 WhatsApp 号码
  displayPhone?: string; // 展示的格式化号码，如 "+86 186 8432 4501"
}

const { locale = localeFromPath(Astro.url.pathname), phone, displayPhone } = Astro.props;
const dict = t(locale);
const pathname = Astro.url.pathname;
const waHref = phone ? `https://wa.me/${phone.replace(/\D/g, '')}?text=${encodeURIComponent(dict.whatsapp.defaultMessage)}` : null;

// 当前页面对应各语言的地址（目标语言页面尚未翻译、或处于 404 页时回退到该语言首页）
const is404 = pathname === '/404' || pathname === '/404/';
const enPath = is404 ? '/' : stripLocale(pathname, locale);
const switcherLocales = activeLocales();
const currentHref = is404 ? localizePath('/', locale) : pathname;
const localeHref = Object.fromEntries(
  switcherLocales.map(l => [l, l === locale ? currentHref : localeHrefFor(enPath, l)])
) as Record<Locale, string>;

const navItems = dict.nav.map(item => ({
  ...item,
  href: safeHref(item.href, locale)
}));

// 导航「Products」下拉菜单：数据源与各语言产品页同源（fr 为 42 条，其余 45 条）
const catalog: Product[] = ({ en: products, es: productsEs, ru: productsRu, fr: productsFr, ar: productsAr } as Record<Locale, Product[]>)[locale] ?? products;
const productsHref = safeHref('/products/', locale);
// 分类按首现顺序排列，#category= 深链与页脚 Product Series 同源；safeHref 会保留 hash
const categoryLinks = [...new Set(catalog.map(p => p.category))].map(name => ({
  name,
  href: safeHref(`/products/#category=${encodeURIComponent(name)}`, locale)
}));
const solutionLinks = dict.footer.solutions.map(item => ({ ...item, href: safeHref(item.href, locale) }));
const inquiryHref = safeHref('/contact/#inquiry', locale);
// 构建时预渲染的搜索索引（见 src/pages/search-index/[locale].json.ts，输出 <locale>.json）
const searchIndexUrl = `/search-index/${locale}.json`;

const salesEmail = 'sales@wanlian911.com';
const displayNumber = displayPhone ?? phone;
const alibabaStoreUrl = 'https://qzwlequipment.en.alibaba.com/';

const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(href));
---

<header class="sticky top-0 z-50 bg-white shadow-sm">
  <!-- 顶部工具栏（md+）：联系方式 + Alibaba 店铺 + 语言切换，为主导航行腾出空间 -->
  <div class="hidden md:block bg-gray-50 border-b border-gray-200/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-9">
        <div class="flex items-center gap-5 min-w-0">
          {waHref && (
            <a
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
              title={dict.whatsapp.tooltip}
              aria-label={dict.whatsapp.ariaLabel}
              class="flex items-center gap-1.5 text-xs font-semibold text-gray-600 hover:text-[#128C4A] transition whitespace-nowrap"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 text-[#25D366] shrink-0">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
              <span dir="ltr">{displayNumber}</span>
            </a>
          )}
          <a
            href={`mailto:${salesEmail}`}
            dir="ltr"
            class="hidden lg:flex items-center gap-1.5 text-xs font-semibold text-gray-600 hover:text-brand-blue transition whitespace-nowrap"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-brand-blue/60 shrink-0">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            {salesEmail}
          </a>
        </div>

        <div class="flex items-center gap-4">
          <a
            href={alibabaStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-gray-600 hover:text-brand-blue transition whitespace-nowrap"
          >
            {dict.header.alibabaStore}
          </a>
          <!-- Language Switcher -->
          <details class="relative group">
            <summary
              class="flex items-center gap-1 px-2.5 py-1 border border-gray-200 bg-white rounded-full text-[11px] font-bold text-gray-700 hover:border-gray-300 transition cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden"
              aria-label={dict.header.language}
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-gray-500">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              <span>{dict.header.languageLabel[locale]}</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-2.5 h-2.5 text-gray-400 transition-transform duration-200 group-open:rotate-180">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="absolute end-0 mt-2 w-40 bg-white rounded-xl border border-gray-200 shadow-xl py-1.5 z-50 group-open:block hidden">
              {switcherLocales.map(l => {
                const active = l === locale;
                return (
                  <a
                    href={localeHref[l]}
                    lang={l}
                    aria-current={active ? 'true' : undefined}
                    class={`flex items-center justify-between px-3.5 py-2 text-xs transition ${
                      active
                        ? 'font-black text-brand-red bg-red-50/60'
                        : 'font-semibold text-gray-700 hover:text-brand-blue hover:bg-gray-50'
                    }`}
                  >
                    <span>{dict.header.languageLabel[l]}</span>
                    {active && (
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5">
                        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                      </svg>
                    )}
                  </a>
                );
              })}
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <!-- 主导航行：Logo + 导航 + 单一 CTA，空间充裕不再挤压换行 -->
  <div class="bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 xl:h-[72px]">
        <!-- Logo -->
        <div class="flex-shrink-0">
          <!-- 双行 tagline 在俄语等长文案下会撑爆 1024-1536px 视口，主行仅保留盾牌 + 品牌名 -->
          <a href={safeHref('/', locale)} class="flex items-center space-x-2.5 xl:space-x-3">
            <img
              src="/favicon.svg"
              alt="Wanlian Fluid Logo"
              class="h-11 xl:h-12 w-auto object-contain"
            />
            <span class="hidden sm:block text-lg xl:text-xl font-extrabold text-gray-900 tracking-tight leading-none">WANLIAN FLUID</span>
          </a>
        </div>

        <!-- Navigation: 「Products」为悬停两栏下拉（分类 + 方案落地页），其余保持扁平链接 -->
        <nav class="hidden lg:flex items-center gap-3 xl:gap-7" aria-label="Main navigation">
          {navItems.map(item => (
            item.href === productsHref ? (
              <div class="relative group/products">
                <a
                  href={item.href}
                  class={`whitespace-nowrap text-xs xl:text-sm font-semibold tracking-wide transition duration-150 py-2 border-b-2 inline-flex items-center gap-1 ${
                    isActive(item.href)
                      ? 'border-brand-red text-brand-red'
                      : 'border-transparent text-gray-600 hover:text-brand-blue hover:border-brand-blue/40'
                  }`}
                >
                  {item.name}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3 text-gray-400 transition-transform duration-150 group-hover/products:rotate-180 group-focus-within/products:rotate-180">
                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                  </svg>
                </a>
                <div class="invisible opacity-0 group-hover/products:visible group-hover/products:opacity-100 group-focus-within/products:visible group-focus-within/products:opacity-100 transition duration-150 absolute top-full start-0 pt-2 z-50">
                  <div class="w-[440px] bg-white rounded-xl border border-gray-100 shadow-xl p-2 grid grid-cols-2 gap-2">
                    <div class="p-1.5">
                      <p class="px-2.5 pt-1.5 pb-1 text-[10px] font-black uppercase tracking-widest text-gray-400">{dict.header.categoriesTitle}</p>
                      <a href={productsHref} class="block px-2.5 py-2 rounded-lg text-xs font-bold text-brand-blue hover:bg-blue-50/60 transition">{dict.header.allProducts}</a>
                      {categoryLinks.map(cat => (
                        <a href={cat.href} class="block px-2.5 py-2 rounded-lg text-xs font-semibold text-gray-600 hover:bg-gray-50 hover:text-brand-blue transition">{cat.name}</a>
                      ))}
                    </div>
                    <div class="p-1.5 border-s border-gray-100">
                      <p class="px-2.5 pt-1.5 pb-1 text-[10px] font-black uppercase tracking-widest text-gray-400">{dict.header.solutionsTitle}</p>
                      {solutionLinks.map(sol => (
                        <a href={sol.href} class="block px-2.5 py-2 rounded-lg text-xs font-semibold text-gray-600 hover:bg-gray-50 hover:text-brand-blue transition">{sol.name}</a>
                      ))}
                      <a href={inquiryHref} class="block mt-1 px-2.5 py-2 rounded-lg text-xs font-bold text-white bg-brand-red hover:opacity-90 transition text-center">{dict.header.inquireNow}</a>
                    </div>
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.href}
                class={`whitespace-nowrap text-xs xl:text-sm font-semibold tracking-wide transition duration-150 py-2 border-b-2 ${
                  isActive(item.href)
                    ? 'border-brand-red text-brand-red'
                    : 'border-transparent text-gray-600 hover:text-brand-blue hover:border-brand-blue/40'
                }`}
              >
                {item.name}
              </a>
            )
          ))}
        </nav>

        <!-- Right actions -->
        <div class="flex items-center gap-2 xl:gap-3 flex-shrink-0">
          <!-- 产品搜索：展开头部下方全宽搜索面板（桌面/移动通用） -->
          <button
            id="searchToggleBtn"
            type="button"
            aria-expanded="false"
            aria-controls="searchPanel"
            aria-label={dict.header.search.ariaLabel}
            title={dict.header.search.ariaLabel}
            class="inline-flex items-center justify-center w-10 h-10 rounded-lg text-gray-600 hover:bg-gray-100 hover:text-brand-blue transition"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
          <a
            href={safeHref('/contact/#inquiry', locale)}
            class="inline-flex items-center justify-center px-4 xl:px-5 py-2 border border-transparent rounded-lg text-xs xl:text-sm font-bold text-white bg-brand-red hover:opacity-90 transition shadow-sm hover:shadow whitespace-nowrap"
          >
            {dict.header.inquireNow}
          </a>
          <button
            id="mobileMenuBtn"
            type="button"
            aria-expanded="false"
            aria-controls="mobileMenu"
            aria-label="Menu"
            class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg text-gray-600 hover:bg-gray-100 transition"
          >
            <svg id="mobileMenuIconOpen" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
              <line x1="4" x2="20" y1="6" y2="6"></line>
              <line x1="4" x2="20" y1="12" y2="12"></line>
              <line x1="4" x2="20" y1="18" y2="18"></line>
            </svg>
            <svg id="mobileMenuIconClose" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6 hidden">
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- 移动/平板菜单（lg 以下）：原版本缺失，补充汉堡菜单避免小屏用户找不到入口 -->
    <div id="mobileMenu" class="hidden lg:hidden border-t border-gray-100 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4">
        <nav class="flex flex-col" aria-label="Mobile navigation">
          {navItems.map(item => (
            item.href === productsHref ? (
              <details class="group/mmenu">
                <summary class={`-mx-2 px-2 py-2.5 rounded-lg text-sm font-semibold transition cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden flex items-center justify-between ${
                  isActive(item.href)
                    ? 'text-brand-red bg-red-50/60'
                    : 'text-gray-700 hover:text-brand-blue hover:bg-gray-50'
                }`}>
                  <span>{item.name}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-gray-400 transition-transform duration-200 group-open/mmenu:rotate-180">
                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                  </svg>
                </summary>
                <div class="mt-1 mb-2 ms-2 ps-3 border-s-2 border-gray-100 flex flex-col">
                  <a href={productsHref} class="px-2 py-2 rounded-lg text-xs font-bold text-brand-blue hover:bg-blue-50/60 transition">{dict.header.allProducts}</a>
                  {categoryLinks.map(cat => (
                    <a href={cat.href} class="px-2 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-brand-blue hover:bg-gray-50 transition">{cat.name}</a>
                  ))}
                  <p class="mt-2 mb-1 px-2 text-[10px] font-black uppercase tracking-widest text-gray-400">{dict.header.solutionsTitle}</p>
                  {solutionLinks.map(sol => (
                    <a href={sol.href} class="px-2 py-2 rounded-lg text-sm font-medium text-gray-600 hover:text-brand-blue hover:bg-gray-50 transition">{sol.name}</a>
                  ))}
                </div>
              </details>
            ) : (
              <a
                href={item.href}
                class={`-mx-2 px-2 py-2.5 rounded-lg text-sm font-semibold transition ${
                  isActive(item.href)
                    ? 'text-brand-red bg-red-50/60'
                    : 'text-gray-700 hover:text-brand-blue hover:bg-gray-50'
                }`}
              >
                {item.name}
              </a>
            )
          ))}
        </nav>
        <div class="mt-4 pt-4 border-t border-gray-100 flex flex-col gap-3 text-sm">
          {waHref && (
            <a
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 font-semibold text-gray-700 hover:text-[#128C4A] transition"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-[#25D366] shrink-0">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
              <span dir="ltr">{displayNumber}</span>
            </a>
          )}
          <a
            href={`mailto:${salesEmail}`}
            dir="ltr"
            class="flex items-center gap-2 font-semibold text-gray-700 hover:text-brand-blue transition"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-brand-blue/60 shrink-0">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            {salesEmail}
          </a>
          <a
            href={alibabaStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-gray-700 hover:text-brand-blue transition"
          >
            {dict.header.alibabaStore}
          </a>
        </div>
        <div class="mt-4 pt-4 border-t border-gray-100 flex flex-wrap gap-2">
          {switcherLocales.map(l => {
            const active = l === locale;
            return (
              <a
                href={localeHref[l]}
                lang={l}
                aria-current={active ? 'true' : undefined}
                class={`px-3 py-1.5 rounded-full border text-xs font-bold transition ${
                  active
                    ? 'border-brand-red text-brand-red bg-red-50/60'
                    : 'border-gray-200 text-gray-600 hover:border-gray-300 hover:bg-gray-50'
                }`}
              >
                {dict.header.languageLabel[l]}
              </a>
            );
          })}
        </div>
      </div>
    </div>

    <!-- 产品搜索面板：由头部放大镜按钮切换；索引为构建时预渲染的 /search-index/<locale> -->
    <div
      id="searchPanel"
      class="hidden absolute top-full inset-x-0 z-50 bg-white border-b border-gray-200 shadow-xl"
      data-index-url={searchIndexUrl}
      data-view-all={productsHref}
      data-inquiry={inquiryHref}
      data-strings={JSON.stringify({
        loading: dict.header.search.loading,
        noResults: dict.header.search.noResults,
        viewAll: dict.header.search.viewAll,
        inquiry: dict.header.search.inquiry,
        error: dict.header.search.error
      })}
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex items-center gap-3 border border-gray-300 rounded-xl bg-gray-50/60 px-4 focus-within:bg-white focus-within:border-brand-blue focus-within:ring-2 focus-within:ring-brand-blue/15 transition">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-gray-400 shrink-0">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            id="searchInput"
            type="text"
            dir="auto"
            autocomplete="off"
            placeholder={dict.header.search.placeholder}
            class="flex-1 min-w-0 bg-transparent py-3 text-sm text-gray-900 placeholder:text-gray-400 outline-none"
          />
          <button id="searchClearBtn" type="button" aria-label="Clear" class="hidden inline-flex w-7 h-7 items-center justify-center rounded-md text-gray-400 hover:bg-gray-100 hover:text-gray-600 transition">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
          <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 border border-gray-200 rounded text-[10px] font-bold text-gray-400 bg-white select-none">Esc</kbd>
        </div>
        <div id="searchResults" class="mt-3" aria-live="polite"></div>
      </div>
    </div>
  </div>

  <script>
    const btn = document.getElementById('mobileMenuBtn');
    const menu = document.getElementById('mobileMenu');
    const iconOpen = document.getElementById('mobileMenuIconOpen');
    const iconClose = document.getElementById('mobileMenuIconClose');
    if (btn && menu && iconOpen && iconClose) {
      btn.addEventListener('click', () => {
        const open = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden', open);
        btn.setAttribute('aria-expanded', String(!open));
        iconOpen.classList.toggle('hidden', !open);
        iconClose.classList.toggle('hidden', open);
      });
    }
  </script>

  <script>
    // 产品搜索：拉取构建时预渲染的按语言索引，客户端多词 AND 匹配（权重：名称 > 分类/规格）。
    // GA4：回车触发 search（search_term），点击结果触发 search_click；不携带 PII。
    declare global { interface Window { gtag?: (...args: unknown[]) => void } }

    const searchBtn = document.getElementById('searchToggleBtn');
    const searchPanel = document.getElementById('searchPanel') as HTMLElement | null;
    const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
    const searchClear = document.getElementById('searchClearBtn');
    const searchResults = document.getElementById('searchResults');

    if (searchBtn && searchPanel && searchInput && searchClear && searchResults) {
      const DICT = JSON.parse(searchPanel.dataset.strings ?? '{}') as {
        loading: string; noResults: string; viewAll: string; inquiry: string; error: string
      };
      const INDEX_URL = searchPanel.dataset.indexUrl ?? '';
      const VIEW_ALL_HREF = searchPanel.dataset.viewAll ?? '/products/';
      const INQUIRY_HREF = searchPanel.dataset.inquiry ?? '/contact/';

      interface Entry { n: string; c: string; i: string; u: string; q: string }
      let entries: Entry[] | null = null;
      let loadFailed = false;
      let panelOpen = false;

      // 查询端与索引端一致地去除阿语变音符号（tashkeel），提升阿语命中率
      const norm = (s: string) => s.replace(/[\u0610-\u061A\u064B-\u065F\u0670]/g, '');
      const esc = (s: string) =>
        s.replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]!));

      const loadIndex = async (): Promise<Entry[] | null> => {
        if (entries || loadFailed) return entries;
        try {
          const res = await fetch(INDEX_URL, { headers: { accept: 'application/json' } });
          if (!res.ok) throw new Error(String(res.status));
          entries = (await res.json()) as Entry[];
        } catch {
          loadFailed = true;
        }
        return entries;
      };

      const andSearch = (terms: string[]): Entry[] => {
        const scored: [number, Entry][] = [];
        for (const e of entries!) {
          const name = norm(e.n).toLowerCase();
          let score = 0;
          for (const t of terms) {
            if (!e.q.includes(t)) { score = 0; break; }
            score += name.startsWith(t) ? 100 : name.includes(t) ? 60 : 10;
          }
          if (score > 0) scored.push([score, e]);
        }
        scored.sort((a, b) => b[0] - a[0]);
        return scored.slice(0, 8).map(([, e]) => e);
      };

      const runSearch = (raw: string): Entry[] | null => {
        if (!entries) return null;
        let terms = norm(raw).toLowerCase().split(/[\s,;،؛、]+/).filter(t => t.length >= 2);
        if (!terms.length) return [];
        // 先剔除零命中词（拼写偏差等）；多词 AND 仍为空时迭代剔除命中数最少的词
        // （如 "DN150 gate valve"：DN150 只出现在个别规格的离散值里），避免一个词拖垮整条查询
        terms = terms.filter(t => entries.some(e => e.q.includes(t)));
        let result = terms.length ? andSearch(terms) : [];
        while (!result.length && terms.length > 1) {
          let minIdx = 0;
          let minHits = Infinity;
          terms.forEach((t, i) => {
            const h = entries!.reduce((n, e) => n + (e.q.includes(t) ? 1 : 0), 0);
            if (h < minHits) { minHits = h; minIdx = i; }
          });
          terms = terms.filter((_, i) => i !== minIdx);
          result = andSearch(terms);
        }
        return result;
      };

      const arrowSvg =
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-gray-300 shrink-0"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>';

      const render = (list: Entry[] | 'error' | null, query: string) => {
        if (!list && !query) { searchResults.innerHTML = ''; return; }
        if (!list) {
          searchResults.innerHTML = `<p class="py-6 text-center text-sm text-gray-400">${esc(DICT.loading)}</p>`;
          return;
        }
        if (list === 'error') {
          searchResults.innerHTML = `
            <div class="py-3 px-2">
              <p class="text-sm leading-relaxed text-gray-500">${esc(DICT.error)}</p>
              <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
                <a href="${esc(VIEW_ALL_HREF)}" class="text-xs font-bold text-brand-blue hover:underline">${esc(DICT.viewAll)}</a>
                <a href="${esc(INQUIRY_HREF)}" class="text-xs font-bold text-brand-red hover:underline">${esc(DICT.inquiry)}</a>
              </div>
            </div>`;
          return;
        }
        if (!query) { searchResults.innerHTML = ''; return; }
        if (!list.length) {
          searchResults.innerHTML = `
            <div class="py-3 px-2">
              <p class="text-sm leading-relaxed text-gray-500">${esc(DICT.noResults).replace('{q}', esc(query))}</p>
              <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
                <a href="${esc(VIEW_ALL_HREF)}" class="text-xs font-bold text-brand-blue hover:underline">${esc(DICT.viewAll)}</a>
                <a href="${esc(INQUIRY_HREF)}" class="text-xs font-bold text-brand-red hover:underline">${esc(DICT.inquiry)}</a>
              </div>
            </div>`;
          return;
        }
        searchResults.innerHTML =
          list.map(e => `
            <a href="${esc(e.u)}" data-search-result class="flex items-center gap-3 px-2 py-2.5 rounded-lg hover:bg-gray-50 transition">
              <img src="${esc(e.i)}" alt="" loading="lazy" class="w-12 h-12 object-contain bg-white border border-gray-100 rounded-lg shrink-0" />
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-gray-900 truncate">${esc(e.n)}</span>
                <span class="block text-xs text-gray-400">${esc(e.c)}</span>
              </span>
              ${arrowSvg}
            </a>`).join('') +
          `<a href="${esc(VIEW_ALL_HREF)}" class="flex items-center justify-center gap-1.5 mt-1 px-2 py-2.5 text-xs font-bold text-brand-blue border-t border-gray-100 hover:underline">
            ${esc(DICT.viewAll)}${arrowSvg}
          </a>`;
      };

      const applyQuery = () => {
        const q = searchInput.value.trim();
        searchClear.classList.toggle('hidden', !q);
        if (!q) { render(null, ''); return; }
        if (!entries) { render(loadFailed ? 'error' : 'loading', q); return; }
        render(runSearch(q), q);
      };

      const setPanelOpen = (v: boolean) => {
        panelOpen = v;
        searchPanel.classList.toggle('hidden', !v);
        searchBtn.setAttribute('aria-expanded', String(v));
        if (v) {
          searchInput.focus();
          loadIndex().then(applyQuery);
        }
      };

      searchBtn.addEventListener('click', () => setPanelOpen(!panelOpen));

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && panelOpen) setPanelOpen(false);
      });

      document.addEventListener('click', (e) => {
        if (!panelOpen) return;
        if (!searchPanel.contains(e.target as Node) && !searchBtn.contains(e.target as Node)) setPanelOpen(false);
      });

      let debounce: number;
      searchInput.addEventListener('input', () => {
        window.clearTimeout(debounce);
        debounce = window.setTimeout(() => {
          applyQuery();
          if (!entries && !loadFailed) loadIndex().then(applyQuery);
        }, 150);
      });

      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const q = searchInput.value.trim();
          if (q) window.gtag?.('event', 'search', { search_term: q });
        }
      });

      searchClear.addEventListener('click', () => {
        searchInput.value = '';
        applyQuery();
        searchInput.focus();
      });

      searchResults.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest?.('a[data-search-result]') as HTMLAnchorElement | null;
        if (a) window.gtag?.('event', 'search_click', { product: a.getAttribute('href') ?? '' });
      });
    }
  </script>
</header>
