---
const year = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white pt-16 pb-8 border-t-4 border-brand-red">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12">
    <!-- Company Info -->
    <div class="space-y-6">
      <div class="flex items-center space-x-3">
        <img 
          src="/favicon.svg"
          alt="Wanlian Fluid Logo" 
          loading="lazy"
          class="h-12 w-auto brightness-0 invert"
        />
        <span class="text-lg font-bold tracking-wider">WANLIAN FLUID</span>
      </div>
      <p class="text-sm text-gray-400 leading-relaxed">
        Quanzhou Wanlian Fluid Equipment Co., Ltd. is a professional fluid-equipment enterprise integrating R&D, sales and service, with production carried out at cooperative manufacturing bases in accordance with the ISO9001 Quality Management System.
      </p>
      <div class="pt-2 text-xs text-gray-500 font-semibold tracking-widest uppercase">
        "Flow Far, Link Global."
      </div>
    </div>

    <!-- Quick Links -->
    <div>
      <h3 class="text-sm font-bold tracking-widest text-gray-300 uppercase mb-6">Quick Links</h3>
      <ul class="space-y-4 text-sm text-gray-400">
        <li><a href="/" class="hover:text-blue-500 transition">Home</a></li>
        <li><a href="/products/" class="hover:text-blue-500 transition">Products Center</a></li>
        <li><a href="/applications/" class="hover:text-blue-500 transition">Applications</a></li>
        <li><a href="/about/" class="hover:text-blue-500 transition">About Us</a></li>
        <li><a href="/blog/" class="hover:text-blue-500 transition">Blog</a></li>
        <li><a href="/contact/" class="hover:text-blue-500 transition">Contact & Inquiry</a></li>
      </ul>
    </div>

    <!-- Product Series -->
    <div>
      <h3 class="text-sm font-bold tracking-widest text-gray-300 uppercase mb-6">Product Series</h3>
      <ul class="space-y-4 text-sm text-gray-400">
        <li><a href="/products/#category=Gate Valves" class="hover:text-blue-500 transition">Gate Valve Series</a></li>
        <li><a href="/products/#category=Check Valves" class="hover:text-blue-500 transition">Check Valve Series</a></li>
        <li><a href="/products/#category=Butterfly Valves" class="hover:text-blue-500 transition">Butterfly Valve Series</a></li>
        <li><a href="/products/#category=Firefighting Equipment" class="hover:text-blue-500 transition">Fire Protection Series</a></li>
      </ul>
    </div>

    <!-- Keyword Landing Pages -->
    <div>
      <h3 class="text-sm font-bold tracking-widest text-gray-300 uppercase mb-6">Product Solutions</h3>
      <ul class="space-y-4 text-sm text-gray-400">
        <li><a href="/ul-fire-valves/" class="hover:text-blue-500 transition">UL Listed Fire Valves</a></li>
        <li><a href="/fire-water-cannon/" class="hover:text-blue-500 transition">Fire Water Cannon</a></li>
        <li><a href="/fire-sprinkler-systems/" class="hover:text-blue-500 transition">Fire Sprinkler Systems</a></li>
      </ul>
    </div>
    </div>

    <!-- Contact Info -->
    <div>
      <h3 class="text-sm font-bold tracking-widest text-gray-300 uppercase mb-6">Contact Us</h3>
      <ul class="space-y-4 text-sm text-gray-400">
        <li class="flex items-start">
          <span class="font-bold text-gray-300 mr-2">Email:</span>
          <span>dhuog77@gmail.com</span>
        </li>
        <li class="flex items-start">
          <span class="font-bold text-gray-300 mr-2">Phone:</span>
          <span>+86 186 8432 4501</span>
        </li>
        <li class="flex items-start">
          <span class="font-bold text-gray-300 mr-2">Address:</span>
          <span>Quanzhou, Fujian, China</span>
        </li>
      </ul>
