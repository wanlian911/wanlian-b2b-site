---
import { localeFromPath, safeHref, type Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = localeFromPath(Astro.url.pathname) } = Astro.props;
const dict = t(locale);
const year = new Date().getFullYear();
const copyright = dict.footer.copyright.replace('{year}', String(year));
const quickLinks = dict.footer.quickLinks.map(i => ({ ...i, href: safeHref(i.href, locale) }));
const productSeries = dict.footer.productSeries.map(i => ({ ...i, href: safeHref(i.href, locale) }));
const solutions = dict.footer.solutions.map(i => ({ ...i, href: safeHref(i.href, locale) }));
const resources = dict.footer.resources.map(i => ({ ...i, href: safeHref(i.href, locale) }));
---

<footer class="bg-gray-900 text-white pt-16 pb-8 border-t-4 border-brand-red">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-12">
    <!-- Company Info -->
    <div class="space-y-6">
      <div class="flex items-center space-x-3">
        <img 
          src="/favicon.svg"
          alt="Wanlian Fluid Logo" 
          loading="lazy"
          class="h-12 w-auto brightness-0 invert"
        />
        <span class="text-lg font-bold tracking-wider">{dict.footer.companyName}</span>
      </div>
      <p class="text-sm text-gray-400 leading-relaxed">
        {dict.footer.companyDesc}
      </p>
      <div class="pt-2 text-xs text-gray-500 font-semibold tracking-widest uppercase">
        {dict.footer.tagline}
      </div>

      <!-- Email Subscribe: 复用主询盘 Formspree 端点，leadSource 区分来源 -->
      <div id="footerSubscribeCard" class="pt-5 mt-2 border-t border-gray-800">
        <h3 class="text-sm font-bold tracking-widest text-gray-300 uppercase mb-1">{dict.footer.subscribeTitle}</h3>
        <p class="text-xs text-gray-500 mb-3">{dict.footer.subscribeDesc}</p>
        <form id="footerSubscribeForm" class="space-y-2">
          <input type="email" name="email" required placeholder={dict.footer.subscribePlaceholder} class="w-full px-3 py-2 rounded-lg bg-gray-800 border border-gray-700 text-sm text-white placeholder-gray-500 focus:ring-2 focus:ring-brand-blue outline-none transition" />
          <button type="submit" id="footerSubscribeBtn" class="w-full px-3 py-2 rounded-lg bg-brand-red hover:opacity-90 text-white text-sm font-bold transition">{dict.footer.subscribeButton}</button>
          <div class="cf-turnstile" data-sitekey="0x4AAAAAAEF-SD39wEwlYPuN"></div>
          <p id="footerSubscribeStatus" class="text-xs mt-1 hidden"></p>
        </form>
      </div>
    </div>

    <!-- Quick Links -->
    <div>
      <h3 class="text-sm font-bold tracking-widest text-gray-300 uppercase mb-6">{dict.footer.quickLinksTitle}</h3>
      <ul class="space-y-4 text-sm text-gray-400">
        {quickLinks.map(item => (
          <li><a href={item.href} class="hover:text-blue-500 transition">{item.name}</a></li>
        ))}
      </ul>
    </div>

    <!-- Product Series -->
    <div>
      <h3 class="text-sm font-bold tracking-widest text-gray-300 uppercase mb-6">{dict.footer.productSeriesTitle}</h3>
      <ul class="space-y-4 text-sm text-gray-400">
        {productSeries.map(item => (
          <li><a href={item.href} class="hover:text-blue-500 transition">{item.name}</a></li>
        ))}
      </ul>
    </div>

    <!-- Keyword Landing Pages -->
    <div>
      <h3 class="text-sm font-bold tracking-widest text-gray-300 uppercase mb-6">{dict.footer.solutionsTitle}</h3>
      <ul class="space-y-4 text-sm text-gray-400">
        {solutions.map(item => (
          <li><a href={item.href} class="hover:text-blue-500 transition">{item.name}</a></li>
        ))}
      </ul>
    </div>

    <!-- Resources -->
    <div>
      <h3 class="text-sm font-bold tracking-widest text-gray-300 uppercase mb-6">{dict.footer.resourcesTitle}</h3>
      <ul class="space-y-4 text-sm text-gray-400">
        {resources.map(item => (
          <li><a href={item.href} class="hover:text-blue-500 transition">{item.name}</a></li>
        ))}
      </ul>
    </div>

    <!-- Contact Info -->
    <div>
      <h3 class="text-sm font-bold tracking-widest text-gray-300 uppercase mb-6">{dict.footer.contactTitle}</h3>
      <ul class="space-y-4 text-sm text-gray-400">
        <li class="flex items-start">
          <span class="font-bold text-gray-300 mr-2">{dict.footer.contact.emailLabel}</span>
          <span>dhuog77@gmail.com</span>
        </li>
        <li class="flex items-start">
          <span class="font-bold text-gray-300 mr-2">{dict.footer.contact.phoneLabel}</span>
          <span>+86 186 8432 4501</span>
        </li>
        <li class="flex items-start">
          <span class="font-bold text-gray-300 mr-2">{dict.footer.contact.addressLabel}</span>
          <span>{dict.footer.contact.addressValue}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 pt-8 border-t border-gray-800 text-center text-xs text-gray-500 flex flex-col sm:flex-row justify-between items-center gap-4">
    <p>{copyright}</p>
    <div class="flex space-x-6">
      <a href="https://www.linkedin.com/company/wanlian-fluid-equipment" target="_blank" rel="noopener noreferrer" class="hover:text-gray-400 transition">{dict.footer.bottom.linkedin}</a>
      <a href="https://qzwlequipment.en.alibaba.com/" target="_blank" rel="noopener noreferrer" class="hover:text-gray-400 transition">{dict.footer.bottom.alibaba}</a>
      <a href={safeHref('/blog/', locale)} class="hover:text-gray-400 transition">{dict.footer.bottom.blog}</a>
      <a href={safeHref('/privacy/', locale)} class="hover:text-gray-400 transition">{dict.footer.bottom.privacy}</a>
      <a href={safeHref('/terms/', locale)} class="hover:text-gray-400 transition">{dict.footer.bottom.terms}</a>
      <a href={safeHref('/contact/', locale)} class="hover:text-gray-400 transition">{dict.footer.bottom.support}</a>
    </div>
  </div>
</footer>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script define:vars={{ subSuccess: dict.footer.subscribeSuccess, subVerify: dict.footer.subscribeVerify, subError: dict.footer.subscribeError }}>
  // 页脚邮件订阅：同端点同 Turnstile 规则；同页多个 Turnstile 组件时按本卡片 widgetId 精确取 token
  const subForm = document.getElementById('footerSubscribeForm') as HTMLFormElement | null;
  const subCard = document.getElementById('footerSubscribeCard') as HTMLElement | null;
  const subStatus = document.getElementById('footerSubscribeStatus') as HTMLParagraphElement | null;
  const subBtn = document.getElementById('footerSubscribeBtn') as HTMLButtonElement | null;

  const getToken = () => {
    const w = window as any;
    if (typeof w.turnstile !== 'undefined') {
      const widget = subCard?.querySelector('.cf-turnstile') as HTMLElement | null;
      if (widget?.getAttribute('data-turnstile-widget-id')) {
        return w.turnstile.getResponse(widget.getAttribute('data-turnstile-widget-id')) || '';
      }
      return w.turnstile.getResponse() || '';
    }
    return '';
  };

  subForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!subForm || !subStatus || !subBtn) return;

    const token = getToken();
    if (!token) {
      subStatus.innerText = subVerify;
      subStatus.className = 'text-xs mt-1 text-red-400 font-bold block';
      return;
    }

    const sendText = subBtn.innerText;
    subBtn.disabled = true;
    subBtn.innerText = '...';
    subStatus.className = 'text-xs mt-1 hidden';

    const data: Record<string, string> = { email: (new FormData(subForm).get('email') as string) || '', leadSource: 'Footer Subscribe' };
    data['cf-turnstile-response'] = token;

    try {
      const response = await fetch('https://formspree.io/f/mvzeyopz', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!response.ok) throw new Error('submission failed');
      subForm.reset();
      const w = window as any;
      if (typeof w.turnstile !== 'undefined') w.turnstile.reset();
      subStatus.innerText = subSuccess;
      subStatus.className = 'text-xs mt-1 text-green-400 font-bold block';
    } catch {
      subStatus.innerText = subError;
      subStatus.className = 'text-xs mt-1 text-red-400 font-bold block';
    } finally {
      subBtn.disabled = false;
      subBtn.innerText = sendText;
    }
  });
</script>
