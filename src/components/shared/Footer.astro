  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16 pt-8 border-t border-gray-800 text-center text-xs text-gray-500 flex flex-col sm:flex-row justify-between items-center gap-4">
    <p>© {year} Quanzhou Wanlian Fluid Equipment Co., Ltd. All Rights Reserved.</p>
    <div class="flex space-x-6">
      <a href="https://www.linkedin.com/company/wanlian-fluid-equipment" target="_blank" rel="noopener noreferrer" class="hover:text-gray-400 transition">LinkedIn</a>
      <a href="https://qzwlequipment.en.alibaba.com/" target="_blank" rel="noopener noreferrer" class="hover:text-gray-400 transition">Alibaba Store</a>
      <a href="/blog/" class="hover:text-gray-400 transition">Blog</a>
