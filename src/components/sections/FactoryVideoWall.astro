---
// "Factory Live" video wall: five real-plant clips as looping tiles.
// Tiles show a poster until scrolled into the viewport (IntersectionObserver
// starts playback, pauses on exit). Skips autoplay under prefers-reduced-motion.
interface Props {
  locale?: 'en' | 'es' | 'ru' | 'fr' | 'ar';
}

const { locale = 'en' } = Astro.props;

const copy = {
  en: {
    eyebrow: 'Factory Live',
    title: 'Real Footage From Our Plant',
    desc: 'Assembly, inspection, ready stock and dispatch at the Quanzhou facility — no stock video, nothing staged.',
    labels: { assembly: 'Assembly', inspection: 'Inspection', stock: 'Ready Stock', loading: 'Packing & Loading', dispatch: 'Dispatch' }
  },
  es: {
    eyebrow: 'En Directo de la Fábrica',
    title: 'Imágenes Reales de Nuestra Planta',
    desc: 'Montaje, inspección, stock disponible y envío en nuestras instalaciones de Quanzhou — sin vídeo de stock, nada montado.',
    labels: { assembly: 'Montaje', inspection: 'Inspección', stock: 'Stock Disponible', loading: 'Embalaje y Carga', dispatch: 'Envío' }
  },
  ru: {
    eyebrow: 'Завод в Кадре',
    title: 'Реальные Съёмки С Нашего Производства',
    desc: 'Сборка, контроль, готовая продукция и отгрузка на площадке в Цюаньчжоу — без стокового видео, без постановки.',
    labels: { assembly: 'Сборка', inspection: 'Контроль', stock: 'Готовая Продукция', loading: 'Упаковка и Погрузка', dispatch: 'Отгрузка' }
  },
  fr: {
    eyebrow: "Usine en Direct",
    title: 'Images Réelles de Notre Usine',
    desc: "Assemblage, inspection, stock disponible et expédition dans notre site de Quanzhou — sans vidéo de stock, rien de simulé.",
    labels: { assembly: 'Assemblage', inspection: 'Inspection', stock: 'Stock Disponible', loading: 'Conditionnement et Chargement', dispatch: 'Expédition' }
  },
  ar: {
    eyebrow: 'من المصنع مباشرة',
    title: 'مشاهد حقيقية من مصنعنا',
    desc: 'التجميع والفحص والمخزون الجاهز والشحن في منشأتنا بقوانتشو — بدون مقاطع جاهزة، وبدون تمثيل.',
    labels: { assembly: 'التجميع', inspection: 'الفحص', stock: 'مخزون جاهز', loading: 'التعبئة والتحميل', dispatch: 'الشحن' }
  }
};

const t = copy[locale] ?? copy.en;

const tiles = [
  { src: '/videos/factory/assembly.mp4', poster: '/videos/factory/assembly-poster.webp', label: t.labels.assembly },
  { src: '/videos/factory/blue-valves.mp4', poster: '/videos/factory/blue-valves-poster.webp', label: t.labels.inspection },
  { src: '/videos/factory/red-field.mp4', poster: '/videos/factory/red-field-poster.webp', label: t.labels.stock },
  { src: '/videos/factory/loading-close.mp4', poster: '/videos/factory/loading-close-poster.webp', label: t.labels.loading },
  { src: '/videos/factory/dispatch.mp4', poster: '/videos/factory/dispatch-poster.webp', label: t.labels.dispatch }
];
---

<section class="py-24 bg-gray-900 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
      <h2 class="text-sm font-black tracking-[0.3em] text-brand-red uppercase flex items-center justify-center gap-2">
        <span class="w-8 h-[2px] bg-brand-red"></span>
        {t.eyebrow}
        <span class="w-8 h-[2px] bg-brand-red"></span>
      </h2>
      <h3 class="text-4xl sm:text-5xl font-black text-white tracking-tight leading-tight">{t.title}</h3>
      <p class="text-gray-400 leading-relaxed">{t.desc}</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
      {tiles.map(tile => (
        <figure class="wall-tile relative aspect-video overflow-hidden rounded-xl bg-black">
          <video
            data-wall-video
            class="absolute inset-0 w-full h-full object-cover"
            muted
            loop
            playsinline
            preload="none"
            poster={tile.poster}
          >
            <source src={tile.src} type="video/mp4" />
          </video>
          <figcaption class="absolute bottom-0 inset-x-0 p-3 bg-gradient-to-t from-black/85 via-black/40 to-transparent">
            <span class="text-[11px] font-black uppercase tracking-widest text-white">{tile.label}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  const wallVideos = document.querySelectorAll<HTMLVideoElement>('[data-wall-video]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (wallVideos.length > 0 && !reducedMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) video.play().catch(() => {});
          else video.pause();
        });
      },
      { threshold: 0.35 }
    );
    wallVideos.forEach((video) => observer.observe(video));
  }
</script>
