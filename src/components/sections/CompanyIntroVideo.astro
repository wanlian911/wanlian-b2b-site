---
// Company introduction video block (homepage, right panel of the Company Profile section).
// Self-hosted H.264 at /videos/company-intro.mp4; poster preloads the video only on click.
interface Props {
  locale?: 'en' | 'es' | 'ru' | 'fr' | 'ar';
}

const { locale = 'en' } = Astro.props;

const copy = {
  en: {
    eyebrow: 'Company Video',
    title: 'Inside Wanlian Fluid in 50 Seconds',
    desc: 'Showroom, production lines and quality inspection at our Quanzhou plant — real footage, no stock video.',
    play: 'Play company video'
  },
  es: {
    eyebrow: 'Vídeo de la Empresa',
    title: 'Wanlian Fluid en 50 Segundos',
    desc: 'Sala de muestras, líneas de producción y control de calidad en nuestra planta de Quanzhou — imágenes reales, sin vídeo de stock.',
    play: 'Reproducir vídeo de la empresa'
  },
  ru: {
    eyebrow: 'Видео о Компании',
    title: 'Wanlian Fluid за 50 Секунд',
    desc: 'Выставочный зал, производственные линии и контроль качества на нашем заводе в Цюаньчжоу — реальные съёмки, без стокового видео.',
    play: 'Смотреть видео о компании'
  },
  fr: {
    eyebrow: "Vidéo d'Entreprise",
    title: 'Wanlian Fluid en 50 Secondes',
    desc: "Salle d'exposition, lignes de production et contrôle qualité dans notre usine de Quanzhou — images réelles, sans vidéo de stock.",
    play: "Lire la vidéo de l'entreprise"
  },
  ar: {
    eyebrow: 'فيديو الشركة',
    title: 'وانليان فليد خلال 50 ثانية',
    desc: 'قاعة العرض، خطوط الإنتاج وفحص الجودة في مصنع قوانتشو — مشاهد حقيقية، بدون مقاطع جاهزة.',
    play: 'تشغيل فيديو الشركة'
  }
};

const t = copy[locale] ?? copy.en;
---

<div data-intro-video-shell class="relative z-10 rounded-2xl overflow-hidden shadow-2xl shadow-gray-200 bg-white">
  <div class="relative aspect-video bg-gray-900">
    <video
      id="company-intro-video"
      class="absolute inset-0 w-full h-full object-cover"
      controls
      playsinline
      preload="none"
      poster="/videos/company-intro-poster.webp"
    >
      <source src="/videos/company-intro.mp4" type="video/mp4" />
      Your browser does not support embedded video.
    </video>
    <button
      type="button"
      class="intro-play-overlay group absolute inset-0 flex flex-col items-center justify-center gap-4 bg-black/30 hover:bg-black/20 transition-colors cursor-pointer"
      aria-label={t.play}
    >
      <span class="w-20 h-20 rounded-full bg-brand-red flex items-center justify-center shadow-xl shadow-brand-red/40 transition-transform duration-300 group-hover:scale-110">
        <svg class="w-8 h-8 text-white translate-x-0.5 rtl:-translate-x-0.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
      </span>
      <span class="px-4 py-1.5 bg-black/50 backdrop-blur-sm rounded-full text-white text-xs font-black uppercase tracking-widest">{t.play}</span>
    </button>
  </div>
  <div class="px-6 py-5">
    <span class="text-[10px] font-black uppercase tracking-widest text-brand-red">{t.eyebrow}</span>
    <h3 class="mt-1 font-bold text-lg text-gray-900 leading-snug">{t.title}</h3>
    <p class="mt-2 text-sm text-gray-500 leading-relaxed">{t.desc}</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLVideoElement>('#company-intro-video').forEach((video) => {
    const shell = video.closest('[data-intro-video-shell]');
    const overlay = shell?.querySelector<HTMLElement>('.intro-play-overlay');
    if (!overlay) return;
    overlay.addEventListener('click', () => {
      video.play().catch(() => {});
    });
    video.addEventListener('play', () => {
      overlay.classList.add('hidden');
    });
    video.addEventListener('pause', () => {
      if (video.currentTime < 1) overlay.classList.remove('hidden');
    });
  });
</script>
