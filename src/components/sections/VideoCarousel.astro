---
// "Factory Live" — framed video carousel (homepage, second screen).
// Footage stays full quality but is presented as curated content: section
// header, rounded frame, caption bar with per-slide title + one-line
// description, prev/next arrows and bar-dot pagination. Crossfade slides,
// 9s autoplay, viewport-gated playback, autoplay disabled under
// prefers-reduced-motion (arrows/dots still work).
interface Props {
  locale?: 'en' | 'es' | 'ru' | 'fr' | 'ar';
}

const { locale = 'en' } = Astro.props;

const copy = {
  en: {
    eyebrow: 'Factory Live',
    title: 'Real Footage From Our Plant',
    desc: 'No stock video, nothing staged — the Quanzhou facility at work, from assembly to dispatch.',
    slides: [
      { title: 'Assembly', desc: 'Torque-checked bolting on hydraulic control valves' },
      { title: 'Inspection', desc: 'Pressure-tested units lined up for dispatch' },
      { title: 'Ready Stock', desc: 'Finished hydrants queued and awaiting shipment' },
      { title: 'Packing & Loading', desc: 'Export order on the dock, boxed and banded' },
      { title: 'Dispatch', desc: 'Full truckload leaving the plant for the port' }
    ]
  },
  es: {
    eyebrow: 'En Directo de la Fábrica',
    title: 'Imágenes Reales de Nuestra Planta',
    desc: 'Sin vídeo de stock, nada montado: la planta de Quanzhou en acción, del montaje al envío.',
    slides: [
      { title: 'Montaje', desc: 'Juntas con par verificado en válvulas de control hidráulico' },
      { title: 'Inspección', desc: 'Unidades probadas de presión listas para el envío' },
      { title: 'Stock Disponible', desc: 'Hidrantes terminados en espera de embarque' },
      { title: 'Embalaje y Carga', desc: 'Pedido de exportación en la bodega, encajado y fajado' },
      { title: 'Envío', desc: 'Camión completo saliendo de la planta hacia el puerto' }
    ]
  },
  ru: {
    eyebrow: 'Завод в кадре',
    title: 'Реальные Съёмки С Нашего Завода',
    desc: 'Без стокового видео, без постановки: площадка в Цюаньчжоу в работе — от сборки до отгрузки.',
    slides: [
      { title: 'Сборка', desc: 'Болтовое соединение с проверкой момента затяжки' },
      { title: 'Контроль', desc: 'Единичные приборы после гидравлического испытания' },
      { title: 'Готовая Продукция', desc: 'Готовые гидранты ожидают отгрузки' },
      { title: 'Упаковка и Погрузка', desc: 'Экспортный заказ на доке, в коробах и стрейч-плёнке' },
      { title: 'Отгрузка', desc: 'Полностью загруженный грузовик едет в порт' }
    ]
  },
  fr: {
    eyebrow: 'Usine en Direct',
    title: 'Images Réelles de Notre Usine',
    desc: "Sans vidéo de stock, rien de simulé : le site de Quanzhou en action, de l'assemblage à l'expédition.",
    slides: [
      { title: 'Assemblage', desc: 'Boulonnage contrôlé en couple sur vannes de contrôle hydraulique' },
      { title: 'Inspection', desc: 'Éprouvettes pressurisées alignées avant expédition' },
      { title: 'Stock Disponible', desc: 'Hydrants terminés mis en file avant expédition' },
      { title: 'Conditionnement et Chargement', desc: 'Commande export sur la barge, en boîte et cerclée' },
      { title: 'Expédition', desc: 'Camion entièrement chargé vers le port' }
    ]
  },
  ar: {
    eyebrow: 'من المصنع مباشرة',
    title: 'مشاهد حقيقية من مصنعنا',
    desc: 'بدون مقاطع جاهزة وبدون تمثيل — منشأة قوانتشو أثناء العمل، من التجميع حتى الشحن.',
    slides: [
      { title: 'التجميع', desc: 'ربط بالموامير مع فحص عزم الشد على صمامات التحكم الهيدروليكي' },
      { title: 'الفحص', desc: 'وحدات مجربة بالضغط في انتظار الشحن' },
      { title: 'مخزون جاهز', desc: 'رؤوس حريق مكتملة في طوابير الشحن' },
      { title: 'التعبئة والتحميل', desc: 'طلب تصدير في الرصيف، صندوق ومغلف' },
      { title: 'الشحن', desc: 'شاحنة محملة بالكامل تغادر المصنع نحو الميناء' }
    ]
  }
};

const t = copy[locale] ?? copy.en;

const slides = [
  { src: '/videos/factory/assembly.mp4', poster: '/videos/factory/assembly-poster.webp' },
  { src: '/videos/factory/blue-valves.mp4', poster: '/videos/factory/blue-valves-poster.webp' },
  { src: '/videos/factory/red-field.mp4', poster: '/videos/factory/red-field-poster.webp' },
  { src: '/videos/factory/loading-close.mp4', poster: '/videos/factory/loading-close-poster.webp' },
  { src: '/videos/factory/dispatch.mp4', poster: '/videos/factory/dispatch-poster.webp' }
];
---

<section data-carousel data-slides={JSON.stringify(t.slides)} class="relative bg-gray-950 py-16 sm:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div>
        <p class="text-sm font-black tracking-[0.3em] text-brand-red flex items-center gap-3">
          <span class="w-8 h-[2px] bg-brand-red"></span>{t.eyebrow}
        </p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-black tracking-tight text-white">{t.title}</h2>
      </div>
      <p class="hidden md:block text-gray-400 text-sm max-w-sm leading-relaxed">{t.desc}</p>
    </header>

    <div class="relative rounded-2xl overflow-hidden ring-1 ring-white/10 bg-black aspect-video">
      {slides.map((s, i) => (
        <video
          data-cv-slide
          class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-in-out"
          style="opacity:0"
          muted
          playsinline
          preload={i === 0 ? 'auto' : 'none'}
          poster={s.poster}
        >
          <source src={s.src} type="video/mp4" />
        </video>
      ))}

      <button
        data-cv-prev
        class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 sm:w-12 sm:h-12 flex items-center justify-center border border-white/40 rounded-md bg-black/40 text-white hover:bg-brand-red hover:border-brand-red transition-colors"
        aria-label="Previous video"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
      </button>
      <button
        data-cv-next
        class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 sm:w-12 sm:h-12 flex items-center justify-center border border-white/40 rounded-md bg-black/40 text-white hover:bg-brand-red hover:border-brand-red transition-colors"
        aria-label="Next video"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </button>

      <div class="absolute bottom-0 inset-x-0 z-10 bg-gradient-to-t from-black/85 via-black/40 to-transparent pt-16 pb-5 px-6 sm:px-8 flex items-end justify-between gap-4">
        <div class="min-w-0">
          <p class="text-brand-red text-xs font-black tracking-widest"><span data-cv-index>01</span> / 05</p>
          <p data-cv-title class="text-white text-lg sm:text-xl font-black mt-1 truncate">{t.slides[0].title}</p>
          <p data-cv-desc class="text-gray-300 text-sm mt-1 hidden sm:block truncate">{t.slides[0].desc}</p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          {slides.map((s, i) => (
            <button
              data-cv-dot
              data-i={i}
              class={`w-6 h-1.5 rounded-full transition-colors ${i === 0 ? 'bg-brand-red' : 'bg-white/30 hover:bg-white/60'}`}
              aria-label={`Video ${i + 1}: ${t.slides[i].title}`}
            ></button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLVideoElement>('[data-cv-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-cv-dot]'));
    const titleEl = root.querySelector<HTMLElement>('[data-cv-title]');
    const descEl = root.querySelector<HTMLElement>('[data-cv-desc]');
    const indexEl = root.querySelector<HTMLElement>('[data-cv-index]');
    const slideCopy = (JSON.parse(root.dataset.slides ?? '[]') as { title: string; desc: string }[]) || [];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const HOLD = 9000;
    let idx = 0;
    let timer: number | undefined;

    const show = (i: number) => {
      idx = (i + slides.length) % slides.length;
      slides.forEach((v, j) => {
        if (j === idx) {
          if (v.readyState < 3) v.load();
          v.play().catch(() => {});
          v.style.opacity = '1';
        } else {
          v.style.opacity = '0';
          window.setTimeout(() => v.pause(), 750);
        }
      });
      dots.forEach((d, j) => {
        d.className = `w-6 h-1.5 rounded-full transition-colors ${j === idx ? 'bg-brand-red' : 'bg-white/30 hover:bg-white/60'}`;
      });
      if (titleEl && slideCopy[idx]) titleEl.textContent = slideCopy[idx].title;
      if (descEl && slideCopy[idx]) descEl.textContent = slideCopy[idx].desc;
      if (indexEl) indexEl.textContent = String(idx + 1).padStart(2, '0');
    };
    const next = () => show(idx + 1);
    const resetTimer = () => {
      window.clearTimeout(timer);
      if (!reducedMotion) timer = window.setTimeout(next, HOLD);
    };

    root.querySelector<HTMLElement>('[data-cv-next]')?.addEventListener('click', () => { next(); resetTimer(); });
    root.querySelector<HTMLElement>('[data-cv-prev]')?.addEventListener('click', () => { show(idx - 1); resetTimer(); });
    dots.forEach((d) => d.addEventListener('click', () => { show(Number(d.dataset.i) || 0); resetTimer(); }));

    const observer = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          slides[idx]?.play().catch(() => {});
          resetTimer();
        } else {
          window.clearTimeout(timer);
          slides.forEach((v) => v.pause());
        }
      }),
      { threshold: 0.3 }
    );
    observer.observe(root);

    show(0);
  }
</script>
