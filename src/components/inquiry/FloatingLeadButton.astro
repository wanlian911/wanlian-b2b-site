---
// 全站右下角悬浮留资入口：点击弹出迷你留资表单（移动端底部抽屉 / 桌面端居中卡片）。
// 与首页留资卡共用 Formspree 端点，leadSource 标记为 "Floating Lead Button" 以便区分来源。
import { localeFromPath, type Locale } from '../../i18n/locales';
import { t } from '../../i18n/ui';

interface Props {
  phone: string;
  locale?: Locale;
}

const { phone, locale = localeFromPath(Astro.url.pathname) } = Astro.props;
const dict = t(locale).lead;
const waDigits = phone.replace(/\D/g, '');
const waFollowupHref = `https://wa.me/${waDigits}?text=${encodeURIComponent(dict.waFollowupMessage)}`;
---

<!-- 悬浮按钮：叠在 WhatsApp 按钮（bottom-6）上方 -->
<button
  id="floatingLeadBtn"
  type="button"
  class="fixed bottom-24 right-6 z-50 flex items-center gap-2 h-12 ps-4 pe-5 bg-brand-red text-white font-bold text-sm rounded-full shadow-lg hover:opacity-90 transition active:scale-95"
  aria-haspopup="dialog"
  aria-expanded="false"
>
  <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
  </svg>
  {dict.floatLabel}
</button>

<!-- 遮罩 + 迷你表单 -->
<div id="floatingLeadOverlay" class="fixed inset-0 z-[60] hidden">
  <div id="floatingLeadBackdrop" class="h-full w-full bg-black/50 flex items-end sm:items-center sm:justify-center">
    <div id="floatingLeadCard" class="bg-white w-full sm:max-w-md sm:mx-4 rounded-t-2xl sm:rounded-2xl shadow-2xl max-h-[85vh] overflow-y-auto p-6" role="dialog" aria-modal="true" aria-labelledby="floatingLeadTitle">
      <div class="flex items-center justify-between mb-5">
        <h4 id="floatingLeadTitle" class="text-xl font-black text-gray-900">{dict.cardTitle}</h4>
        <button id="floatingLeadClose" type="button" class="w-9 h-9 flex items-center justify-center rounded-full text-gray-500 hover:bg-gray-100 transition" aria-label={dict.close}>
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <form id="floatingLeadForm" class="space-y-4" data-i18n-sending={dict.sending} data-i18n-send={dict.submit} data-i18n-verify={dict.verifyRequired} data-i18n-failed={dict.submitFailed}>
        <input type="hidden" name="leadSource" value="Floating Lead Button" />

        <div>
          <label for="flead-name" class="block text-sm font-semibold text-gray-700 mb-2">{dict.fullName}</label>
          <input type="text" id="flead-name" name="name" required class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand-blue outline-none transition" placeholder="John Doe" />
        </div>

        <div>
          <label for="flead-phone" class="block text-sm font-semibold text-gray-700 mb-2">{dict.phone}</label>
          <input type="tel" id="flead-phone" name="phone" class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand-blue outline-none transition" placeholder={dict.phonePlaceholder} />
        </div>

        <div>
          <label for="flead-email" class="block text-sm font-semibold text-gray-700 mb-2">{dict.email}</label>
          <input type="email" id="flead-email" name="email" required class="w-full px-4 py-3 rounded-lg border border-gray-200 focus:ring-2 focus:ring-brand-blue outline-none transition" placeholder="john@example.com" />
        </div>

        <div class="cf-turnstile" data-sitekey="0x4AAAAAAEF-SD39wEwlYPuN"></div>

        <button type="submit" id="floatingLeadSubmitBtn" class="w-full py-4 bg-brand-red text-white font-bold rounded-xl hover:opacity-90 transition shadow-lg flex items-center justify-center space-x-2">
          <span>{dict.submit}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
          </svg>
        </button>
        <p id="floatingLeadStatus" class="text-center text-sm mt-2 hidden"></p>
        <p class="text-center text-xs text-gray-400 mt-1">{dict.privacyNote}</p>
      </form>

      <!-- Success State -->
      <div id="floatingLeadSuccess" class="hidden text-center py-6">
        <div class="w-16 h-16 mx-auto bg-green-100 rounded-full flex items-center justify-center mb-5">
          <svg class="w-8 h-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h3 class="text-2xl font-black text-gray-900 mb-2">{dict.successTitle}</h3>
        <p class="text-gray-600 leading-relaxed max-w-md mx-auto">{dict.successBody}</p>
        <p class="text-gray-500 text-sm mt-5 mb-3">{dict.successWhatsappHint}</p>
        <a
          href={waFollowupHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-brand-blue text-white font-bold rounded-xl hover:opacity-90 transition shadow-lg"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {dict.chatWhatsapp}
        </a>
        <div class="mt-6">
          <button id="floatingLeadSuccessClose" type="button" class="text-sm font-bold text-blue-600 hover:underline">{dict.close}</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
  #floatingLeadCard.slide-in {
    animation: floatLeadUp 0.18s ease-out;
  }
  @keyframes floatLeadUp {
    from { transform: translateY(24px); opacity: 0.4; }
    to { transform: none; opacity: 1; }
  }
</style>

<script>
  const floatBtn = document.getElementById('floatingLeadBtn') as HTMLButtonElement;
  const floatOverlay = document.getElementById('floatingLeadOverlay') as HTMLElement;
  const floatBackdrop = document.getElementById('floatingLeadBackdrop') as HTMLElement;
  const floatCard = document.getElementById('floatingLeadCard') as HTMLElement;
  const floatClose = document.getElementById('floatingLeadClose') as HTMLButtonElement;
  const floatSuccessClose = document.getElementById('floatingLeadSuccessClose') as HTMLButtonElement;
  const floatForm = document.getElementById('floatingLeadForm') as HTMLFormElement;
  const floatStatus = document.getElementById('floatingLeadStatus');
  const floatSubmitBtn = document.getElementById('floatingLeadSubmitBtn') as HTMLButtonElement;
  const floatSuccess = document.getElementById('floatingLeadSuccess');
  const floatNameInput = document.getElementById('flead-name') as HTMLInputElement;

  const sendingText = floatForm?.dataset.i18nSending ?? 'Sending...';
  const sendText = floatForm?.dataset.i18nSend ?? 'Leave My Contact Info';
  const verifyText = floatForm?.dataset.i18nVerify ?? 'Please complete the verification check before sending.';
  const failedText = floatForm?.dataset.i18nFailed ?? 'Submission failed. Please try again or contact us via WhatsApp.';

  const resetTurnstile = () => {
    const w = window as any;
    if (typeof w.turnstile !== 'undefined') w.turnstile.reset();
  };

  const openModal = () => {
    floatOverlay!.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    floatBtn!.setAttribute('aria-expanded', 'true');
    // 重放进入动画
    floatCard!.classList.remove('slide-in');
    void floatCard!.offsetHeight;
    floatCard!.classList.add('slide-in');
    setTimeout(() => floatNameInput!.focus(), 60);
  };

  const closeModal = () => {
    floatOverlay!.classList.add('hidden');
    document.body.style.overflow = '';
    floatBtn!.setAttribute('aria-expanded', 'false');
    floatBtn!.focus();
  };

  // 提交成功后关闭：恢复表单空态
  const closeAfterSuccess = () => {
    closeModal();
    resetTurnstile();
    setTimeout(() => {
      floatForm!.classList.remove('hidden');
      floatSuccess!.classList.add('hidden');
      floatForm!.reset();
    }, 200);
  };

  floatBtn?.addEventListener('click', openModal);
  floatClose?.addEventListener('click', closeModal);
  floatSuccessClose?.addEventListener('click', closeAfterSuccess);
  floatBackdrop?.addEventListener('click', (e) => {
    if (e.target === floatBackdrop) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !floatOverlay!.classList.contains('hidden')) closeModal();
  });

  // 页面可能同时存在多个 Turnstile 组件，按本卡片内的 widgetId 精确取 token
  const getTurnstileToken = () => {
    const w = window as any;
    if (typeof w.turnstile !== 'undefined') {
      const widget = floatCard!.querySelector('.cf-turnstile') as HTMLElement | null;
      if (widget && widget.getAttribute('data-turnstile-widget-id')) {
        return w.turnstile.getResponse(widget.getAttribute('data-turnstile-widget-id')) || '';
      }
      return w.turnstile.getResponse() || '';
    }
    return '';
  };

  floatForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const turnstileToken = getTurnstileToken();
    if (!turnstileToken) {
      floatStatus!.innerText = verifyText;
      floatStatus!.className = 'text-center text-sm mt-2 text-red-600 font-bold block';
      return;
    }

    floatSubmitBtn.disabled = true;
    floatSubmitBtn.innerText = sendingText;
    floatStatus!.className = 'text-center text-sm mt-2 hidden';

    const formData = new FormData(floatForm);
    const data = Object.fromEntries(formData.entries());
    (data as any)['cf-turnstile-response'] = turnstileToken;

    try {
      const response = await fetch('https://formspree.io/f/mvzeyopz', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await response.json();

      if (response.ok) {
        floatForm.classList.add('hidden');
        floatSuccess!.classList.remove('hidden');
      } else {
        throw new Error(result.errors?.map((err: any) => err.message).join(', ') || result.message || failedText);
      }
    } catch (err) {
      floatStatus!.innerText = 'Error: ' + (err as Error).message;
      floatStatus!.className = 'text-center text-sm mt-2 text-red-600 font-bold block';
    } finally {
      floatSubmitBtn.disabled = false;
      floatSubmitBtn.innerText = sendText;
    }
  });
</script>
