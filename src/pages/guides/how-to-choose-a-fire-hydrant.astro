---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'understand-your-requirement', label: '1. Understand Your Hydrant Requirement First' },
	{ id: 'hydrant-types-explained', label: '2. Fire Hydrant Types Explained' },
	{ id: 'key-specifications', label: '3. Key Specifications to Compare' },
	{ id: 'certification-compliance', label: '4. Certification & Compliance' },
	{ id: 'common-mistakes', label: '5. Common Mistakes in Hydrant Selection' },
	{ id: 'factory-checklist', label: '6. Factory Checklist Before You Order' },
	{ id: 'faq', label: 'Frequently Asked Questions' }
];

const faq = [
	{
		question: 'What is the difference between indoor and outdoor fire hydrants?',
		answer: 'Indoor hydrants (such as the SN65 head) connect to internal standpipe and hose systems inside buildings, delivering water to fire hoses at designated floor stations. Outdoor hydrants (such as the SS100 ground hydrant) are mounted on municipal or industrial water mains and supply fire engines and external firefighting operations. The two serve different distribution points and are not interchangeable.'
	},
	{
		question: 'What pressure rating should a municipal fire hydrant have?',
		answer: 'Standard municipal hydrants are rated at PN16 (1.6 MPa), which covers most urban and industrial water supply networks. High-rise districts or high-demand industrial zones may require PN25 hydrants with verified flow capacity. Always confirm the static and residual pressure of your supply network before selecting a pressure class.'
	},
	{
		question: 'Are Wanlian hydrants available with UL or FM certification?',
		answer: 'Yes. Wanlian Fluid offers hydrants and valves with UL, FM, CE, ISO 9001 and LPCB certifications depending on the model and destination market. Contact our sales team with your project specification and target region so we can match the correct certification package.'
	},
	{
		question: 'What is the standard connection type for export fire hydrants?',
		answer: 'Common outlet connections include the BS336 instantaneous coupling (UK/Commonwealth), the NIST thread (Middle East), KWS (Germany) and flexible flange options. Wanlian can supply SS100/65 and SSFT100/65 hydrants with the connection type specified for your market, and fittings can be supplied in the same shipment.'
	},
	{
		question: 'What is the MOQ and lead time for wholesale hydrant orders?',
		answer: 'Standard MOQ is typically 20 units per model for stock sizes, with production lead times of 15–30 days depending on quantity and customisation. Sample orders are available for pre-shipment testing and approval. Your sales engineer can provide exact lead times against your order volume.'
	}
];

const hydrantProducts = [
	{
		slug: 'indoor-fire-hydrant-head-sn65',
		name: 'Indoor Fire Hydrant Head SN65',
		img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg',
		desc: 'PN16 ductile iron indoor hydrant for standpipe systems'
	},
	{
		slug: 'overground-fire-hydrant-ss100',
		name: 'Overground Antifreeze Fire Hydrant (SS100/65)',
		img: '/assets/products/overground-fire-hydrant-ss100.png',
		desc: 'Antifreeze outdoor hydrant for cold-climate municipal networks'
	},
	{
		slug: 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100',
		name: 'Anti-Collision Pressure-Regulating Hydrant (SSFT100/65)',
		img: '/assets/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100.png',
		desc: 'Breakaway body with pressure-regulating control for traffic areas'
	},
	{
		slug: 'iot-smart-ground-fire-hydrant-ss100zn',
		name: 'IoT Smart Ground Fire Hydrant (SS100/65-1.6ZN)',
		img: '/assets/products/overground-fire-hydrant-ss100.png',
		desc: 'Real-time pressure, tilt and theft monitoring for smart municipal grids'
	}
];
---

<Layout
	title="How to Choose a Fire Hydrant for Municipal & Industrial Projects (2026 Guide)"
	description="Fire hydrant selection guide: indoor vs outdoor, DN/PN specs, connection types (BS336/NIST), certifications (UL/FM/CE) and a factory checklist for B2B buyers."
	type="article"
	faq={faq}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/" class="hover:text-blue-600">Home</a>
			<span>/</span>
			<span class="text-gray-600">Guides</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Fire Protection Equipment Guide</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">How to Choose a Fire Hydrant for Municipal &amp; Industrial Projects (2026 Guide)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">A fire hydrant is a fixed asset that will sit in your network for 10–20 years — and it is only useful on the day it has to perform. Choosing the wrong type, pressure class or connection standard means replacing a buried component under emergency conditions, or worse, a hydrant that cannot deliver when firefighters arrive. This guide walks through the six decisions every procurement team must make, with reference to real product configurations available today.</p>

			<!-- Product strip -->
			<div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
				{hydrantProducts.map(p => (
					<a href={`/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			
			<TableOfContents headings={toc} />

			<h2 id="understand-your-requirement" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Understand Your Hydrant Requirement First</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Before comparing models, answer four questions with your fire authority or engineering consultant:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Where will the hydrant be installed?</strong> Indoor standpipe system, outdoor municipal main, or industrial yard — each calls for a different type.</li>
				<li><strong>What is the design flow and pressure?</strong> Firefighting flow typically starts at 15–30 L/s per hydrant; confirm the residual pressure your network can sustain.</li>
				<li><strong>Which standard governs your project?</strong> NFPA 24/291, BS 750, GB 4452 or regional municipal codes define outlet size, spacing and testing rules.</li>
				<li><strong>What is the climate?</strong> Freezing winters require antifreeze or dry-barrel designs.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Getting these four answers right eliminates most of the mistakes below before you even open a catalogue.</p>

			<h2 id="hydrant-types-explained" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Fire Hydrant Types Explained</h2>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Indoor Hydrants (Standpipe Systems)</h3>
			<p class="text-gray-700 leading-relaxed mb-4">Indoor hydrant heads connect to vertical standpipe risers and supply hose stations on each floor. The <a href="/products/indoor-fire-hydrant-head-sn65/" class="text-brand-blue font-semibold hover:underline">SN65 indoor fire hydrant head</a> is the standard interface: ductile iron body rated to PN16, with grooved or flanged inlet and a 65&nbsp;mm outlet for hose connection. For high-rise and industrial buildings it is typically paired with fire hose reels and pump systems.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Outdoor Ground Hydrants (Municipal &amp; Industrial)</h3>
			<p class="text-gray-700 leading-relaxed mb-4">Outdoor hydrants draw from water mains and feed fire engines. Two configurations dominate: the <a href="/products/overground-fire-hydrant-ss100/" class="text-brand-blue font-semibold hover:underline">SS100/65 overground hydrant</a> for standard municipal and industrial yards, and the anti-collision variant. If your hydrant sits in a traffic lane or warehouse aisle where vehicles operate, the <a href="/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100/" class="text-brand-blue font-semibold hover:underline">SSFT100 anti-collision pressure-regulating hydrant</a> adds two safety mechanisms: a breakaway body that snaps cleanly on impact (keeping the underground pipe intact) and pressure regulation that protects downstream hoses from over-pressure.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Smart Hydrants for Digitised Networks</h3>
			<p class="text-gray-700 leading-relaxed mb-4">For municipal operators modernising their water grid, the <a href="/products/iot-smart-ground-fire-hydrant-ss100zn/" class="text-brand-blue font-semibold hover:underline">SS100ZN IoT smart hydrant</a> embeds sensors for real-time pressure, tilt and water-theft detection, reporting to the SCADA platform. It is the same mechanical hydrant with a monitoring layer — useful when your tender requires remote status visibility.</p>

			<h2 id="key-specifications" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Key Specifications to Compare</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Specification</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">What to check</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Typical for export hydrants</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Nominal size (DN)</td>
							<td class="px-4 py-3 text-gray-700">Inlet &amp; outlet diameter match your main and hose</td>
							<td class="px-4 py-3 text-gray-700">DN100/65 (SS100) or DN65 (SN65)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Pressure rating (PN)</td>
							<td class="px-4 py-3 text-gray-700">Must exceed network maximum static pressure</td>
							<td class="px-4 py-3 text-gray-700">PN16 (1.6 MPa) standard; PN25 for high-pressure zones</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Body material</td>
							<td class="px-4 py-3 text-gray-700">Ductile iron resists impact; check coating for corrosion</td>
							<td class="px-4 py-3 text-gray-700">Ductile iron QT450 with epoxy/powder coating</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Connection type</td>
							<td class="px-4 py-3 text-gray-700">Must match local fire brigade couplings</td>
							<td class="px-4 py-3 text-gray-700">BS336, NIST, KWS, grooved or flanged</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Special features</td>
							<td class="px-4 py-3 text-gray-700">Antifreeze, breakaway, pressure-regulating, IoT</td>
							<td class="px-4 py-3 text-gray-700">Per project requirement</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 id="certification-compliance" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Certification &amp; Compliance</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Hydrants are life-safety equipment — certification is not optional in most markets. Ask your supplier for the certification that matches your destination: <strong>UL / FM</strong> for North America, <strong>CE</strong> for Europe, <strong>LPCB</strong> for UK/Commonwealth projects, and <strong>ISO 9001</strong> as the baseline quality system. Review the actual certificates, not just logos in a brochure. Wanlian's certification package is published on the <a href="/certificates/" class="text-brand-blue font-semibold hover:underline">certificates page</a>, and our engineers will confirm which standard applies to your tender before quoting.</p>

			<h2 id="common-mistakes" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Common Mistakes in Hydrant Selection</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Mismatched connection standard</strong> — a hydrant that cannot accept the local fire brigade's couplings is worse than no hydrant. Confirm the coupling standard before ordering.</li>
				<li><strong>Ignoring residual pressure</strong> — static pressure tells you nothing about what the hydrant delivers when three outlets are open simultaneously.</li>
				<li><strong>Installing non-antifreeze hydrants in freezing climates</strong> — barrel damage from ice is a leading cause of hydrant failure in cold regions.</li>
				<li><strong>Choosing a standard hydrant for impact zones</strong> — truck collisions bend underground stems; breakaway designs protect the network.</li>
				<li><strong>Skipping the spare parts conversation</strong> — confirm availability of repair kits (seals, stems, couplings) with your order, not after commissioning.</li>
			</ul>

			<h2 id="factory-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Factory Checklist Before You Order</h2>
			<ol class="list-decimal pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Request the certificate copies (UL/FM/CE/ISO) relevant to your market — verify them, don't just collect them.</li>
				<li>Ask for the hydrostatic test report of the specific batch, not a generic test certificate.</li>
				<li>Confirm the coupling standard with your fire authority <em>before</em> you sign the PO.</li>
				<li>For smart hydrants, request the data interface spec (modbus/SCADA) and a sample device for integration testing.</li>
				<li>Clarify MOQ, lead time, packaging for sea freight, and spare parts availability in one commercial offer.</li>
				<li>Keep one pre-shipment sample for your own testing and archive the test photos.</li>
			</ol>
			<p class="text-gray-700 leading-relaxed">A reliable supplier should answer all six points in writing within one working day. If a quotation is vague on certification or test reports, treat that as a red flag.</p>

			<!-- Related guide -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Related Guide: Wanlian Fluid vs American AVK</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Deciding between an established US brand and a China-based manufacturer? Read our side-by-side comparison: <a href="/guides/wanlian-fluid-vs-american-avk/" class="text-brand-blue font-semibold hover:underline">Wanlian Fluid vs American AVK: Which Fire Hydrant &amp; Valve Supplier Fits Your 2026 Project?</a></p>
			</div>

			<!-- FAQ Section -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Frequently Asked Questions</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Need a Hydrant Specified for Your Project?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Send us your DN/PN, connection standard and target certification — our engineers reply with a full technical datasheet and quotation within 12 hours.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/contact/?product=Fire%20Hydrant%20Selection" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Request a Quote</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20help%20choosing%20a%20fire%20hydrant" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat on WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
