---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Wet, dry or pre-action — how do I choose the right sprinkler system?',
		answer: 'Wet systems are the default for heated buildings: fastest response, lowest cost. Dry systems suit unheated spaces (parking garages, cold stores) where pipes could freeze. Pre-action systems protect water-sensitive areas (data centres, archives, museums) by holding water back until two independent signals confirm a fire. Your building code and hazard class decide the minimum requirement.'
	},
	{
		question: 'What do K-factor and temperature rating mean for a sprinkler head?',
		answer: 'K-factor defines how much water a head discharges at a given pressure — K80 and K115 are the common standards. Temperature rating sets the activation point (57°C to 141°C, color-coded glass bulbs). Match both to the hazard and ceiling height; quick-response (3mm bulb) heads react faster than standard-response (5mm bulb) types.'
	},
	{
		question: 'Are Wanlian sprinkler components UL listed?',
		answer: 'Yes. Our sprinkler heads and system components are UL/ULC listed where applicable, with certificates available on our certificates page. Our engineers confirm the exact certification package for your destination market before quoting.'
	},
	{
		question: 'Can you supply a complete sprinkler system BOM?',
		answer: 'Yes. Send project drawings or a component list and we quote heads, flexible connections, alarm valves, flow indicators, strainers and accessories as one package — one supplier for the whole loop, with matched specifications.'
	},
	{
		question: 'What is the role of the alarm check valve in a wet system?',
		answer: 'The wet alarm check valve (e.g. ZSFZ) separates the supply main from the sprinkler piping and sounds a hydraulic alarm gong when flow starts, while its retard chamber filters false alarms caused by pressure surges. Flow indicators (ZSJZ) then pinpoint the activated zone to the panel.'
	}
];

const sprinklerProducts = [
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'Glass Bulb Sprinkler (ZST)',
		img: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		desc: 'K=80/115, 57–141°C, pendent/upright/sidewall'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Wet Alarm Check Valve (ZSFZ)',
		img: 'https://s.alicdn.com/@sc04/kf/H82d57eb132e942ecba6023697838d6afn/Water-Alarm-Valves-ZSFZ-150-Flexible-Cast.png?hasNWGrade=1',
		desc: 'Alarm gong + retard chamber, DN100–DN200'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Pre-action System (ZSFY)',
		img: 'https://s.alicdn.com/@sc04/kf/H2857379540b7417c83f169d67ff70ab3a.png_300x300.jpg?v=20260729',
		desc: 'Dual-trigger failsafe for critical rooms'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Flow Indicator (ZSJZ)',
		img: 'https://sc02.alicdn.com/kf/A463ac39a948d44a391017ca222837de2B.png?v=20260729',
		desc: 'Adjustable 2–60s delay, DN50–DN200'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Deluge Valve Group (ZSFM)',
		img: 'https://s.alicdn.com/@sc04/kf/HTB1q4J9bEzrK1RjSspm763OdFXa1.png?v=20260729',
		desc: 'For deluge and water spray systems'
	}
];
---

<Layout
	title="Fire Sprinkler Systems: Wet, Dry or Pre-action? (2026 Guide)"
	description="A practical comparison of wet, dry and pre-action sprinkler systems, how to select sprinkler heads (K-factor, temperature, response), system components and a compliance checklist."
	type="article"
	faq={faq}
	breadcrumbs={[{ name: 'Blog', href: '/blog/' }, { name: 'Sprinkler Systems Guide' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/" class="hover:text-blue-600">Home</a>
			<span>/</span>
			<a href="/blog/" class="hover:text-blue-600">Blog</a>
			<span>/</span>
			<span class="text-gray-600">Sprinkler Systems Guide</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Fire Sprinkler System Guide</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Fire Sprinkler Systems: Wet, Dry or Pre-action? (2026 Guide)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Sprinkler systems share one goal — put water on the fire fast — but the plumbing between the water supply and the sprinkler head changes everything about response time, freeze resistance and water damage risk. This guide compares the three main system types, explains how to choose sprinkler heads, and lists the components your BOM actually needs.</p>

			<!-- Product strip -->
			<div class="mt-8 grid grid-cols-2 lg:grid-cols-5 gap-4">
				{sprinklerProducts.map(p => (
					<a href={`/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">1. The Three System Types Compared</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Type</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">How it works</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Typical use</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Wet system</td>
							<td class="px-4 py-3 text-gray-700">Pipes constantly filled; head opens → immediate discharge</td>
							<td class="px-4 py-3 text-gray-700">Heated commercial, residential and industrial buildings</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Dry system</td>
							<td class="px-4 py-3 text-gray-700">Pipes hold pressurized air/nitrogen; dry pipe valve admits water on activation</td>
							<td class="px-4 py-3 text-gray-700">Unheated spaces: parking garages, cold stores, loading docks</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Pre-action</td>
							<td class="px-4 py-3 text-gray-700">Air-filled pipes; water admitted only after two independent signals</td>
							<td class="px-4 py-3 text-gray-700">Data centres, archives, museums, computer rooms</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed mb-4">Wet systems respond fastest and cost least to maintain, which is why building codes default to them wherever the space is heated. Dry systems trade a few seconds of response for freeze protection. Pre-action systems deliberately delay flooding until detection confirms fire — the right trade-off where a false discharge is as damaging as the fire itself.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">2. Choosing Sprinkler Heads</h2>
			<p class="text-gray-700 leading-relaxed mb-4">The head is where the system meets the fire, and three parameters define it:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>K-factor</strong> — discharge capacity. K80 and K115 cover most occupancies; higher K-factors serve high-challenge hazards. Our <a href="/products/glass-bulb-fire-sprinkler-zst/" class="text-brand-blue font-semibold hover:underline">ZST series</a> offers both.</li>
				<li><strong>Temperature rating</strong> — the activation point, from 57°C (red) to 141°C (blue), color-coded glass bulbs. Ordinary-hazard ceilings take 68°C; heat-generating equipment areas need higher ratings.</li>
				<li><strong>Response type</strong> — quick-response (3mm bulb) reacts faster and is often required for residential and light-hazard occupancies; standard-response (5mm bulb) suits ordinary and extra-hazard groups.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Orientation matters too: pendent heads hang below the pipe, upright heads sit above it, and sidewall heads protect corridors and small rooms. Match the head to the ceiling construction, not just the catalogue photo.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">3. The Components Your BOM Needs</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Beyond heads, a complete sprinkler system includes the alarm valve group, flow detection, and protection accessories:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Wet alarm check valve</strong> (<a href="/products/wet-alarm-check-valve-zsfz-150/" class="text-brand-blue font-semibold hover:underline">ZSFZ</a>) — separates supply from sprinkler piping, sounds the hydraulic gong, and its retard chamber filters pressure-surge false alarms.</li>
				<li><strong>Deluge / pre-action valves</strong> (<a href="/products/deluge-alarm-valve-zsfm/" class="text-brand-blue font-semibold hover:underline">ZSFM</a>, <a href="/products/pre-action-alarm-system-zsfy/" class="text-brand-blue font-semibold hover:underline">ZSFY</a>) — the control brains for deluge and pre-action configurations.</li>
				<li><strong>Flow indicators</strong> (<a href="/products/water-flow-indicator-zsjz/" class="text-brand-blue font-semibold hover:underline">ZSJZ</a>) — detect flow in each zone and pinpoint the activated area to the panel.</li>
				<li><strong>Y-strainers</strong> (<a href="/products/telescopic-y-strainer-sgl41h/" class="text-brand-blue font-semibold hover:underline">SGL41H</a>) — keep particulates out of valves and heads; a cheap component that prevents expensive blockages.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">4. Compliance Notes</h2>
			<p class="text-gray-700 leading-relaxed mb-4">NFPA 13 governs installation in North America and is the de-facto reference in many export markets. Key points that catch buyers out: certified components (UL/ULC listed where applicable), correct hazard classification before selecting density, and documentation — request the actual certificates and batch test reports, not catalogue logos. Our <a href="/certificates/" class="text-brand-blue font-semibold hover:underline">certificates page</a> publishes the certification package.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">5. Procurement Checklist</h2>
			<ol class="list-decimal pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Classify the occupancy hazard (light / ordinary / extra) and confirm the design density.</li>
				<li>Choose system type: wet, dry or pre-action based on building temperature and water sensitivity.</li>
				<li>Select heads by K-factor, temperature rating, response type and orientation.</li>
				<li>Confirm component certification (UL/ULC) matches the destination market.</li>
				<li>Request a single BOM quote covering heads, valves, indicators and strainers.</li>
				<li>Clarify MOQ, lead time and spare parts in the commercial offer.</li>
			</ol>

			<!-- Cross-link to landing page -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Explore Our Sprinkler System Components</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">View the full component range — heads, alarm valves, flow indicators — on the <a href="/fire-sprinkler-systems/" class="text-brand-blue font-semibold hover:underline">fire sprinkler systems page</a>.</p>
			</div>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Frequently Asked Questions</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Need Sprinkler System Components?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Send us your building type and component list — we reply with a full BOM quotation within 12 hours.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/contact/?product=Fire%20Sprinkler%20Systems" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Request a Quote</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20fire%20sprinkler%20system%20components" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat on WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
