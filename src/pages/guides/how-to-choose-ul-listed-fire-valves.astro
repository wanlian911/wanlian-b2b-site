---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'what-ul-listing-means', label: '1. What UL Listing Means for Fire Valves' },
	{ id: 'fire-valve-types', label: '2. Fire Valve Types You Will Actually Specify' },
	{ id: 'key-specifications', label: '3. Key Specifications to Compare' },
	{ id: 'ul-vs-fm', label: '4. UL vs FM: Which One Does Your Tender Name?' },
	{ id: 'common-mistakes', label: '5. Common Mistakes in Fire Valve Procurement' },
	{ id: 'procurement-checklist', label: '6. Procurement Checklist Before You Order' },
	{ id: 'faq', label: 'Frequently Asked Questions' }
];

const faq = [
	{
		question: 'Is UL certification mandatory for fire valves?',
		answer: 'In North America and many international projects, yes — fire protection valves must be UL or ULC listed (or FM approved) to comply with NFPA and local building codes. For other markets, CE, LPCB or local standards may apply. Always confirm the certification your destination market requires.'
	},
	{
		question: 'What is the difference between UL listed and FM approved?',
		answer: 'Both are third-party certifications for fire protection products. UL listing tests valves against UL/ULC standards for construction and performance; FM approval adds factory inspection and loss-prevention requirements. Many projects accept either, but some specifications name one specifically — check your tender documents.'
	},
	{
		question: 'Which fire valve types are typically UL listed?',
		answer: 'Gate valves (OS&Y and NRS), butterfly valves, check valves, deluge valves, pre-action valves and alarm check valves are the common UL listed types used in sprinkler and standpipe systems, in sizes roughly from 1½" to 12".'
	},
	{
		question: 'How do I verify a supplier\'s UL certificate is genuine?',
		answer: 'Ask for the certificate number and file number, then look it up on the official UL Product iQ database or the certifying body\'s online directory. A copy in a brochure is not proof — the listing must be active and cover the exact model and size you intend to buy.'
	},
	{
		question: 'Can Wanlian provide UL listed valves for my project?',
		answer: 'Yes. Wanlian Fluid supplies gate, butterfly, check, deluge and pre-action valves with UL/ULC and FM certification where applicable. See our UL fire valves page or the certificates page and our engineers will confirm the right certification package for your destination market.'
	}
];

const valveProducts = [
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Resilient Seat Gate Valve (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.jpg',
		desc: 'EPDM encapsulated wedge, DN50–DN700'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Signal Grooved Wafer Butterfly Valve',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.jpg',
		desc: 'DN80 PN16 with status monitoring'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Deluge Alarm Valve Group (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.png',
		desc: 'Diaphragm-operated, DN50–DN300'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Pre-action Alarm System (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Dual-trigger failsafe design'
	}
];
---

<Layout
	title="How to Choose UL Listed Fire Valves for Your Project (2026 Guide)"
	description="A practical guide to selecting UL listed fire valves: valve types, UL vs FM certification, key specifications, verification of genuine certificates and a procurement checklist for B2B buyers."
	type="article"
	faq={faq}
	breadcrumbs={[{ name: 'Blog', href: '/blog/' }, { name: 'UL Fire Valves Guide' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/" class="hover:text-blue-600">Home</a>
			<span>/</span>
			<a href="/blog/" class="hover:text-blue-600">Blog</a>
			<span>/</span>
			<span class="text-gray-600">UL Fire Valves Guide</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Fire Protection Valve Selection Guide</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">How to Choose UL Listed Fire Valves for Your Project (2026 Guide)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">A fire protection valve is the component that decides whether your sprinkler system works the day a fire happens — and whether your building passes inspection before that. UL listing is the acceptance criterion most North American and many international projects use to judge it. This guide explains what UL listing actually means, which valve types are listed, how to verify a certificate is genuine, and what to check before you issue a purchase order.</p>

			<!-- Product strip -->
			<div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
				{valveProducts.map(p => (
					<a href={`/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			
			<TableOfContents headings={toc} />

			<h2 id="what-ul-listing-means" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. What UL Listing Means for Fire Valves</h2>
			<p class="text-gray-700 leading-relaxed mb-4">UL (Underwriters Laboratories) listing is a third-party certification that a valve has been tested against UL/ULC standards covering pressure rating, flow characteristics, materials and durability in fire protection service. It is not a marketing badge — it is the documented basis on which authorities having jurisdiction (AHJs) accept a valve into a sprinkler or standpipe system.</p>
			<p class="text-gray-700 leading-relaxed">When a spec sheet says "UL listed," verify three things: the certificate is <strong>active</strong> (not expired), it covers the <strong>exact model and size</strong> you are buying, and the <strong>certificate number</strong> resolves in the official UL database. A logo printed on a datasheet proves nothing by itself.</p>

			<h2 id="fire-valve-types" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Fire Valve Types You Will Actually Specify</h2>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Gate Valves — The System Isolation Standard</h3>
			<p class="text-gray-700 leading-relaxed mb-4">Gate valves isolate sections of a sprinkler system for maintenance. The <a href="/products/resilient-seat-flanged-gate-valve-z41x/" class="text-brand-blue font-semibold hover:underline">Z41X resilient seat gate valve</a> with its fully EPDM-encapsulated wedge is the workhorse choice: bubble-tight shutoff, low pressure drop when fully open, and sizes from DN50 to DN700 cover everything from branch lines to mains. OS&amp;Y (outside screw and yoke) patterns show open/closed status at a glance, which AHJs like for section valves.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Butterfly Valves — Compact Control with Monitoring</h3>
			<p class="text-gray-700 leading-relaxed mb-4">Where space is tight, butterfly valves take a fraction of the face-to-face length of a gate valve. The <a href="/products/signal-grooved-wafer-butterfly-valve-dn80/" class="text-brand-blue font-semibold hover:underline">signal grooved wafer butterfly valve</a> adds an integrated microswitch, so the fire alarm panel knows the valve's open/closed status — a requirement for monitored section valves in modern systems.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Deluge &amp; Pre-action Valves — The System Brains</h3>
			<p class="text-gray-700 leading-relaxed mb-4">For deluge systems (open sprinklers or spray nozzles) the <a href="/products/deluge-alarm-valve-zsfm/" class="text-brand-blue font-semibold hover:underline">ZSFM deluge alarm valve</a> holds back system water under diaphragm pressure and opens instantly when released electrically, pneumatically or manually. Where water damage must be avoided — archives, data centres, museums — the <a href="/products/pre-action-alarm-system-zsfy/" class="text-brand-blue font-semibold hover:underline">ZSFY pre-action system</a> requires two independent signals before it floods the piping.</p>

			<h2 id="key-specifications" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Key Specifications to Compare</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Specification</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Why it matters</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Size range</td>
							<td class="px-4 py-3 text-gray-700">Match the pipe schedule — typical fire valves run DN40–DN300 (1½"–12")</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Pressure rating</td>
							<td class="px-4 py-3 text-gray-700">PN16 (1.6 MPa) covers most networks; PN25 for high-rise or high-pressure zones</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">End connections</td>
							<td class="px-4 py-3 text-gray-700">Flanged for mains, grooved for fast install, threaded for small branches</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Body material</td>
							<td class="px-4 py-3 text-gray-700">Ductile iron QT450 standard; WCB/CF8/CF8M where higher corrosion resistance is needed</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Certification</td>
							<td class="px-4 py-3 text-gray-700">UL/ULC, FM, CE, LPCB — match to the destination market's code</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 id="ul-vs-fm" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. UL vs FM: Which One Does Your Tender Name?</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Both are accepted certification schemes for fire protection equipment, but tenders are often written to name one. UL listing is common in US commercial construction; FM approval is frequently required for facilities insured by FM Global and for industrial risk sites. Some projects accept either. If your specification says "UL listed or FM approved," a supplier with both can bid on either basis — confirm coverage for the specific model and size before quoting.</p>

			<h2 id="common-mistakes" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Common Mistakes in Fire Valve Procurement</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Buying "UL compliant" instead of UL listed</strong> — "compliant" is not a certification. Only a listed product with an active certificate number counts.</li>
				<li><strong>Ignoring valve status monitoring</strong> — section valves that can be closed without the panel knowing are a classic inspection failure; use signal/OS&amp;Y valves on monitored sections.</li>
				<li><strong>Mismatched pressure class</strong> — a PN10 valve in a PN16 network fails hydrostatic test.</li>
				<li><strong>Specifying the wrong valve type</strong> — a gate valve cannot do a deluge valve's job, and vice versa. Match the valve to the system function.</li>
				<li><strong>Not checking spare parts availability</strong> — seals, stems and repair kits should be confirmed with the order.</li>
			</ul>

			<h2 id="procurement-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Procurement Checklist Before You Order</h2>
			<ol class="list-decimal pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Confirm the certification your destination market requires (UL/ULC, FM, CE, LPCB).</li>
				<li>Request the certificate number and verify it in the official UL/FM database.</li>
				<li>Match DN, PN and end connections to your pipe schedule.</li>
				<li>For monitored systems, specify signal valves or OS&amp;Y patterns.</li>
				<li>Ask for the batch hydrostatic test report, not just a generic certificate.</li>
				<li>Confirm MOQ, lead time and spare parts availability in one commercial offer.</li>
			</ol>

			<!-- Cross-link to landing page -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Explore Our UL Listed Fire Valve Range</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">View the full series — gate, butterfly, check, deluge and pre-action valves with certifications published on our <a href="/certificates/" class="text-brand-blue font-semibold hover:underline">certificates page</a> — on the <a href="/ul-fire-valves/" class="text-brand-blue font-semibold hover:underline">UL fire valves page</a>.</p>
			</div>

			<!-- Related guide -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Related Guide: Verifying Your Supplier</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Need the 8-point diligence checklist for verifying any valve manufacturer before ordering? Read the <a href="/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">B2B Valve Sourcing Checklist</a>.</p>
			</div>

			<!-- FAQ -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Frequently Asked Questions</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Need UL Listed Fire Valves for Your Project?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Send us your valve type, DN/PN and target certification — our engineers reply with a full datasheet and quotation within 12 hours.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/contact/?product=UL%20Fire%20Valves" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Request a Quote</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20UL%20listed%20fire%20valves" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat on WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
