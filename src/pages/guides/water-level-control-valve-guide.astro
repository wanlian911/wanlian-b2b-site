---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/sections/TableOfContents.astro';

// FAQ: real buyer questions, rendered as visible content and as FAQPage JSON-LD
const faq = [
	{
		question: 'What is the difference between an F745X level control valve and a 100X remote control float valve?',
		answer: 'Both hold a preset water level, but they are built for different environments. The F745X hydraulic water level control valve has a ductile iron (QT450-10) or cast steel main valve with a solid brass float pilot, covers DN50 - DN400 and is offered at 1.0 MPa or 1.6 MPa working pressure - the standard choice for large reservoirs, water towers and buried steel tanks. The 100X-16P remote control float valve is cast stainless steel (CF8) with stainless pilot and tubing, covers DN40 - DN300 at 0 - 1.0 MPa and is rated -50°C to 100°C, which is why buyers specify it for hygiene-critical tanks, coastal plants and corrosive service. Choose on material and pressure first, size second.'
	},
	{
		question: 'How much inlet pressure does a hydraulic level control valve need to work?',
		answer: 'The valve is driven by the line pressure itself, so the requirement is a pressure differential, not a power supply. F745X bodies are rated 1.0 or 1.6 MPa nominal and the 100X-16P is rated 0 - 1.0 MPa, but the useful minimum differential depends on the pilot trim and the static height the valve must lift against. State your available inlet pressure at the tank - pump shutoff pressure minus line losses - on the enquiry and ask the factory to confirm the pilot arrangement for that band rather than assuming any DN will close at low head.'
	},
	{
		question: 'Do these valves need electricity or a control panel?',
		answer: 'No. The F745X and 100X-16P are self-operated: the float pilot modulates the diaphragm chamber using line pressure, so the refill keeps working during a power failure. That is the main reason they are used on elevated tanks, remote booster stations and fire water storage, where an electrically actuated valve would add a failure mode and a cabling scope.'
	},
	{
		question: 'Why is a strainer fitted upstream of a hydraulic level control valve?',
		answer: 'Because the pilot is the valve. Particles that a main-line gate valve would swallow will hold a float pilot or its needle valve off its seat, and the symptom shows up as a tank that slowly overflows weeks after handover. A telescopic Y-strainer such as the SGL41H (stainless 304/316 screen, 18-30 mesh for water, DN50 - DN600 at 1.0/1.6 MPa) is installed at the inlet, and its built-in telescopic joint lets you pull the strainer out for cleaning without cutting the pipe.'
	},
	{
		question: 'Should a backflow preventer be fitted on a tank fill line?',
		answer: 'If the tank is fed from a potable main, yes - a tank is a classic cross-connection, and pressure loss in the supply can draw tank water back into the network. A double-check device with an automatic intermediate drain such as the HS41X-16 (two independent checks, solid brass or stainless drain valve, DN50 - DN600, 1.0/1.6/2.5 MPa, ductile iron body, 0-80°C) is the usual answer for storage tanks. Confirm the required air gap or device type with your water undertaker, since local rules decide this and not the valve catalogue.'
	},
	{
		question: 'Can a level control valve be relied on to protect a fire water reserve?',
		answer: 'It can maintain the level, but it does not by itself protect the reserve. The refill valve shares the tank with domestic, evaporation, testing and leak demand, so the arrangement that works is a refill valve set to hold the normal level, a low-level alarm that cannot be silenced by the refill circuit, and a suction arrangement that keeps the fire volume available even if the refill fails. See the fire pump suction and water tank guide for how the reserve, penetrations and vortex prevention are handled.'
	}
];

// TOC: one entry per H2 id in the body
const toc = [
	{ id: 'what-the-valve-actually-controls', label: '1. What the Valve Actually Controls' },
	{ id: 'how-the-f745x-pilot-circuit-works', label: '2. How the F745X Pilot Circuit Refills a Tank' },
	{ id: 'f745x-vs-100x-vs-500x-comparison', label: '3. F745X vs 100X vs 500X: Which Valve for Which Job' },
	{ id: 'sizing-refill-flow-and-valve-size', label: '4. Sizing: Refill Flow, Valve Size and Inlet Pressure' },
	{ id: 'strainer-isolation-backflow-protection', label: '5. Strainer, Isolation and Backflow Protection' },
	{ id: 'installation-and-commissioning', label: '6. Installation, Level Settings and Commissioning' },
	{ id: 'troubleshooting-tank-fill-faults', label: '7. Troubleshooting Tank Fill Faults' },
	{ id: 'rfq-checklist-for-level-control-valves', label: '8. RFQ Checklist for Level Control Valves' },
	{ id: 'faq', label: 'Frequently Asked Questions' }
];

// Related products: slugs match src/utils/products.ts
const products = [
	{ slug: 'hydraulic-water-level-control-valve-f745x', name: 'F745X Hydraulic Water Level Control Valve', img: '/assets/products/hydraulic-water-level-control-valve-f745x.webp', desc: 'DN50 - DN400, 1.0/1.6 MPa, brass float pilot, slow closing' },
	{ slug: 'remote-control-float-valve-100x', name: '100X-16P Remote Control Float Valve', img: '/assets/products/remote-control-float-valve-100x.webp', desc: 'CF8 stainless steel, DN40 - DN300, 0 - 1.0 MPa' },
	{ slug: 'telescopic-y-strainer-sgl41h', name: 'SGL41H Telescopic Y-Strainer', img: '/assets/products/telescopic-y-strainer-sgl41h.webp', desc: 'SS304/316 screen 18-30 mesh, protects the pilot circuit' },
	{ slug: 'resilient-seat-flanged-gate-valve-z41x', name: 'Z41X Resilient Seat Gate Valve', img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp', desc: 'DN50 - DN700 PN10/PN16, isolation and bypass' }
];
---

<Layout
	title="Water Level Control Valve Guide: F745X vs 100X"
	description="How a hydraulic water level control valve holds a tank level, how to size an F745X or 100X float valve, and exactly what to put on the RFQ."
	type="article"
	faq={faq}
	breadcrumbs={[{ name: 'Guides', href: '/blog/' }, { name: 'Water Level Control Valve Guide' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumb -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/" class="hover:text-blue-600">Home</a>
			<span>/</span>
			<a href="/blog/" class="hover:text-blue-600">Guides</a>
			<span>/</span>
			<span class="text-gray-600">Water Level Control Valve Guide</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Hydraulic Control Valve Guide</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Water Level Control Valve Guide: F745X, 100X and the Tank Fill Circuit</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">In short: a hydraulic water level control valve opens and closes on a float pilot that uses the line pressure itself, so a storage tank refills to a set level, does not overflow, and does not slam its own supply line when it closes. For most projects the choice is between the <a href="/products/hydraulic-water-level-control-valve-f745x/" class="text-brand-blue font-semibold hover:underline">F745X</a> (ductile iron, DN50 - DN400, up to 1.6 MPa) and the <a href="/products/remote-control-float-valve-100x/" class="text-brand-blue font-semibold hover:underline">100X-16P</a> (stainless CF8, DN40 - DN300, up to 1.0 MPa). What decides whether the installation behaves for years is not the model name but the pilot protection, the isolation arrangement and the commissioning record - all covered below.</p>

			<TableOfContents headings={toc} />

			<!-- Product strip -->
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Section 1 -->
			<h2 id="what-the-valve-actually-controls" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. What the Valve Actually Controls</h2>
			<p class="text-gray-700 leading-relaxed mb-4">A level control valve has one measurable job: keep the water surface inside a tank between defined points. Everything else that buyers argue about - material, pilot type, size, accessories - follows from three failure modes that occur when the valve is absent, undersized or unprotected.</p>
			<p class="text-gray-700 leading-relaxed mb-4"><strong>Overflow.</strong> A fill line that keeps running after the tank is full wastes treated water, floods valve chambers and roofs, and in a heated building can drip onto electrical equipment. On a potable supply it also creates a billing and compliance issue that gets noticed long before the valve itself does.</p>
			<p class="text-gray-700 leading-relaxed mb-4"><strong>Run-down.</strong> A tank that empties because refill cannot match demand is the more expensive failure. Pump suction loses submergence, air gets drawn in, and where the tank doubles as a fire water reserve the protected volume is simply gone. See the <a href="/guides/fire-pump-suction-water-tank-guide/" class="text-brand-blue font-semibold hover:underline">fire pump suction and water tank guide</a> for how reserves and low-level alarms are arranged.</p>
			<p class="text-gray-700 leading-relaxed"><strong>Slam.</strong> A direct-acting ball float cuts the full design flow in a fraction of a second. On a long fill main that is a pressure surge, and the surge is absorbed by whichever component is weakest - usually a pilot, a gauge siphon or a seat. This is why the <a href="/products/hydraulic-water-level-control-valve-f745x/" class="text-brand-blue font-semibold hover:underline">F745X hydraulic water level control valve</a> is specified with a smooth, slow-closing mechanism: the pilot modulates the diaphragm chamber instead of chopping the flow, which prevents destructive water hammer. The wider picture is in our <a href="/guides/water-hammer-protection-fire-water-systems/" class="text-brand-blue font-semibold hover:underline">water hammer protection guide</a>.</p>

			<!-- Section 2 -->
			<h2 id="how-the-f745x-pilot-circuit-works" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. How the F745X Pilot Circuit Refills a Tank</h2>
			<p class="text-gray-700 leading-relaxed mb-4">The F745X is a diaphragm main valve plus a small control loop. The main valve body is ductile iron QT450-10 (cast steel is available), the diaphragm assembly is nylon-reinforced EPDM rubber, and the stem and spring are stainless steel 304. Above it sits a solid brass float pilot, connected by copper or stainless steel pilot piping, with stainless or brass needle and ball valves to throttle and isolate the circuit.</p>
			<p class="text-gray-700 leading-relaxed mb-4">The sequence is entirely hydraulic, which is what "driven by pipeline pressure, no external electric power required" means in the specification. As the tank level falls, the float drops and the pilot opens: pressure in the diaphragm chamber vents, and line pressure lifts the main valve. Water refills the tank. As the level rises the float lifts, the pilot throttles, pressure builds above the diaphragm, and the main valve moves toward closed - progressively rather than abruptly, so the surge that a float ball would create never appears.</p>
			<p class="text-gray-700 leading-relaxed">The <a href="/products/remote-control-float-valve-100x/" class="text-brand-blue font-semibold hover:underline">100X-16P remote control float valve</a> follows the same principle in a different material set: cast stainless steel CF8 body and bonnet, stainless pilot and tubing, a ball valve with plastic handle on top, DN40 - DN300 at 0 - 1.0 MPa and a working temperature range of -50°C to 100°C. Where the tank is hygienically sensitive, sited by the sea, or carries water hotter or colder than a ductile iron unit is comfortable with, the stainless valve is normally the cheaper decision over the life of the installation - see <a href="/guides/valve-body-material-selection-guide/" class="text-brand-blue font-semibold hover:underline">valve body material selection</a> for the full material comparison.</p>

			<!-- Section 3 -->
			<h2 id="f745x-vs-100x-vs-500x-comparison" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. F745X vs 100X vs 500X: Which Valve for Which Job</h2>
			<p class="text-gray-700 leading-relaxed mb-4">All three are self-operated hydraulic control valves from the same family, and buyers routinely quote the wrong one because the model numbers look interchangeable. The table below is the practical distinction: what each valve senses, and therefore where it belongs.</p>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Specification</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">F745X Level Control</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">100X-16P Float Valve</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">500X Pressure Reducing</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">What it senses</td>
							<td class="px-4 py-3 text-gray-700">Water level (float pilot)</td>
							<td class="px-4 py-3 text-gray-700">Water level (remote float pilot)</td>
							<td class="px-4 py-3 text-gray-700">Downstream pressure</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Size range</td>
							<td class="px-4 py-3 text-gray-700">DN50 - DN400</td>
							<td class="px-4 py-3 text-gray-700">DN40 - DN300</td>
							<td class="px-4 py-3 text-gray-700">DN20 - DN600</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Pressure rating</td>
							<td class="px-4 py-3 text-gray-700">1.0 MPa / 1.6 MPa</td>
							<td class="px-4 py-3 text-gray-700">0 - 1.0 MPa (0 - 10 bar)</td>
							<td class="px-4 py-3 text-gray-700">1.0 / 1.6 / 2.5 MPa; set 0.1 - 1.6 MPa</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Body material</td>
							<td class="px-4 py-3 text-gray-700">Ductile iron QT450-10 / cast steel</td>
							<td class="px-4 py-3 text-gray-700">Cast stainless steel CF8</td>
							<td class="px-4 py-3 text-gray-700">Ductile iron QT450-10</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Pilot and tubing</td>
							<td class="px-4 py-3 text-gray-700">Brass float pilot; copper or stainless piping</td>
							<td class="px-4 py-3 text-gray-700">Stainless pilot and tubing; top ball valve</td>
							<td class="px-4 py-3 text-gray-700">Forged brass adjustable pilot</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Temperature</td>
							<td class="px-4 py-3 text-gray-700">Water service (EPDM diaphragm)</td>
							<td class="px-4 py-3 text-gray-700">-50°C to 100°C</td>
							<td class="px-4 py-3 text-gray-700">Water service (EPDM diaphragm)</td>
							</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Typical duty</td>
							<td class="px-4 py-3 text-gray-700">Reservoirs, water towers, buried steel tanks</td>
							<td class="px-4 py-3 text-gray-700">Hygiene-critical, coastal, corrosive tanks</td>
							<td class="px-4 py-3 text-gray-700">Pressure zones, booster discharge</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed mb-4">Two consequences follow. First, a 500X will not hold a level: it holds pressure, and if you fit one at a tank inlet the tank overflows when demand stops and the set pressure is reached. Second, on a high-pressure supply feeding an elevated tank the correct architecture is a <a href="/products/adjustable-pressure-reducing-valve-500x/" class="text-brand-blue font-semibold hover:underline">500X pressure reducing valve</a> on the fill main, feeding a level control valve at the tank - two valves, each doing the one duty it was designed for. The <a href="/guides/pressure-reducing-valve-guide/" class="text-brand-blue font-semibold hover:underline">pressure reducing valve guide</a> covers the upstream half of that arrangement.</p>
			<p class="text-gray-700 leading-relaxed">Where the project also needs an electrically commanded shut-off - for example to close the fill on a leak alarm or to switch between tanks on a schedule - the usual companion is a solenoid-operated gate valve such as the <a href="/products/groove-solenoid-control-gate-valve-gkzf1/" class="text-brand-blue font-semibold hover:underline">GKZF-1</a>, wired so that the level control valve still retains its mechanical function. Never replace a self-operated level valve with a solenoid alone: a solenoid that fails closed drains the tank, and one that fails open overflows it.</p>

			<!-- Section 4 -->
			<h2 id="sizing-refill-flow-and-valve-size" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Sizing: Refill Flow, Valve Size and Inlet Pressure</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Level control valves are sized on flow, not on pipe diameter - although the two must be compatible. Work from the refill duty in three steps.</p>
			<p class="text-gray-700 leading-relaxed mb-4"><strong>Step 1 - define the required refill flow.</strong> Take the volume that must be replaced and divide by the time allowed. A 200 m3 tank that has to be refilled within 8 hours needs at least 25 m3/h; add whatever demand continues during refill, because the valve is filling against an open outlet, not into a dead tank. State both numbers on the enquiry: average demand and peak refill demand.</p>
			<p class="text-gray-700 leading-relaxed mb-4"><strong>Step 2 - check the available pressure.</strong> The valve can only use the pressure delivered at the tank: pump shutoff pressure minus main losses, minus the static height it must lift to reach the tank. The <a href="/products/remote-control-float-valve-100x/" class="text-brand-blue font-semibold hover:underline">100X-16P</a> covers 0 - 1.0 MPa and the <a href="/products/hydraulic-water-level-control-valve-f745x/" class="text-brand-blue font-semibold hover:underline">F745X</a> 1.0 or 1.6 MPa nominal, but the practical question is the residual differential across a partly open valve. Give the factory the inlet pressure band and the static height, and ask them to confirm the pilot and needle configuration for it.</p>
			<p class="text-gray-700 leading-relaxed mb-4"><strong>Step 3 - select the size from the flow curve, not habit.</strong> A fill line is frequently larger than the valve that actually delivers the duty, because an oversized valve modulates near its seat and wears unevenly, while an undersized valve never reaches the level in the time allowed. Ask for the flow-versus-lift curve for the specific DN, and where the refill duty is genuinely variable consider fitting the fill line so that flow can be verified: an <a href="/products/smart-electromagnetic-flow-meter/" class="text-brand-blue font-semibold hover:underline">electromagnetic flow meter</a> (DN10 - DN2000, 0.5% or 1.0% accuracy class, pulse or 4-20 mA output, RS485 Modbus) gives the commissioning team a number instead of an impression, and the same signal can feed a building management system.</p>
			<p class="text-gray-700 leading-relaxed">Velocity still matters on the tank side: an inlet discharging at high velocity into a small tank stirs the water column, delays the float response and can overfill against a rising surface. Where the fill enters below the surface, or where the same opening must also serve as a drain, settle the arrangement before the size is fixed - and keep the flange drilling standard (ANSI, EN, JIS or GB) consistent with the pipeline, as set out in the <a href="/guides/flange-standard-guide-ansi-din-jis/" class="text-brand-blue font-semibold hover:underline">flange standard guide</a>.</p>

			<!-- Section 5 -->
			<h2 id="strainer-isolation-backflow-protection" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Strainer, Isolation and Backflow Protection</h2>
			<p class="text-gray-700 leading-relaxed mb-4">The accessories are where tank fill specifications are usually won or lost, because they decide whether the valve is serviceable. Four items belong on nearly every level control scope.</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Strainer at the inlet.</strong> The pilot port and needle valve are the smallest passages in the system. The <a href="/products/telescopic-y-strainer-sgl41h/" class="text-brand-blue font-semibold hover:underline">SGL41H telescopic Y-strainer</a> is designed specifically to protect hydraulic water control valves: ductile iron body, stainless steel 304/316 screen at 18-30 mesh for water, DN50 - DN600 at 1.0/1.6 MPa, working temperature up to 80°C, and a built-in telescopic joint so the strainer can be withdrawn for cleaning without cutting the line.</li>
				<li><strong>Isolation either side, plus a bypass.</strong> A <a href="/products/resilient-seat-flanged-gate-valve-z41x/" class="text-brand-blue font-semibold hover:underline">Z41X resilient seat gate valve</a> upstream and downstream (ductile iron QT450-10, fully encapsulated EPDM wedge, DN50 - DN700, PN10/PN16) lets you take the control valve out of service while the tank stays in duty through a bypass line.</li>
				<li><strong>Backflow prevention on potable connections.</strong> The <a href="/products/anti-pollution-backflow-preventer-hs41x/" class="text-brand-blue font-semibold hover:underline">HS41X-16 anti-pollution backflow preventer</a> uses two series-connected checks with an automatic intermediate drain that opens when upstream pressure drops; DN50 - DN600, 1.0/1.6/2.5 MPa, EPDM-seated discs, 0-80°C drinking water service. The device class and any required air gap are a matter for the local water authority, so read our <a href="/guides/backflow-prevention-guide/" class="text-brand-blue font-semibold hover:underline">backflow prevention guide</a> before fixing the type.</li>
				<li><strong>Vortex prevention at the suction.</strong> If the same tank is pumped from, an <a href="/products/suction-vortex-preventer-en12845/" class="text-brand-blue font-semibold hover:underline">EN 12845 suction vortex preventer</a> (austenitic stainless 304 or 316, DN50 - DN1000, built to EN 12845 and GB 50974-2014, sanitary requirement GB/T 17219) stops air being pulled down into the pump and lets the tank drain to roughly 100 mm depth.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Pilot tubing material is a real specification line, not a formality: stainless piping is the choice for exposed, coastal or high-temperature plant, while copper tubing is common indoors. Ask for the tubing material and the needle valve material to be listed on the datasheet so a site substitution does not happen quietly during installation.</p>

			<!-- Section 6 -->
			<h2 id="installation-and-commissioning" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Installation, Level Settings and Commissioning</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Set the four levels on the drawing before anything is cut: high (valve shut-off), normal operating, low (alarm) and emergency or minimum fire volume. Mark them on the tank and record them. A float set only at the overflow invert guarantees that the overflow does the work, and overflows are the part of the system nobody inspects.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Physically, a flanged hydraulic control valve needs straight access for pilot tubing, headroom above the bonnet, and space for the strainer to be pulled. Confirm orientation against the tank penetration rather than assuming a standard layout: a valve installed where the pilot tube must take two tight bends will trap air and respond sluggishly.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Commission it as a system, not as a valve:</p>
			<ol class="list-decimal pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Flush the fill main and clear the strainer before connecting the pilot circuit - construction debris is the single most common cause of early pilot failure.</li>
				<li>Open the upstream and downstream isolation valves and observe the first fill cycle from low to high level: the valve should modulate, not chatter.</li>
				<li>Time the refill over a measured level drop and compare it with the design flow from section 4. If it is materially slower, suspect a blinded strainer or an incorrect needle setting before blaming the valve.</li>
				<li>After shut-off, watch the overflow for a week. Any steady weep means the pilot or main seat is not fully closing.</li>
				<li>Prove the float action again with the tank at low level, without emptying it, and confirm the low-level alarm actually annunciates at the panel.</li>
			</ol>
			<p class="text-gray-700 leading-relaxed">Hand over three documents: an as-installed sketch of the pilot circuit showing tube and needle positions, the recorded set levels, and a strainer cleaning interval. A tank refill that only one person on site understands will be found out at the first holiday weekend.</p>

			<!-- Section 7 -->
			<h2 id="troubleshooting-tank-fill-faults" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">7. Troubleshooting Tank Fill Faults</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Most complaints arrive as one sentence - "the valve does not work" - and resolve into a short list of causes. Use this table to decide what to open before you book a replacement.</p>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Symptom</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Most Likely Cause</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Check First</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Tank overflows; valve never fully closes</td>
							<td class="px-4 py-3 text-gray-700">Debris holding the float pilot or main seat off its seat; worn diaphragm</td>
							<td class="px-4 py-3 text-gray-700">Clean the SGL41H screen, then the pilot; inspect the EPDM diaphragm and its nylon reinforcement</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Valve will not open at all</td>
							<td class="px-4 py-3 text-gray-700">Isolation or pilot ball valve closed; blocked pilot tube; no differential pressure</td>
							<td class="px-4 py-3 text-gray-700">Confirm all three valves open, verify inlet pressure at the tank, blow through the pilot line</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Refill far slower than design</td>
							<td class="px-4 py-3 text-gray-700">Blinded strainer; valve too small for the duty; partly closed upstream valve</td>
							<td class="px-4 py-3 text-gray-700">Measure the refill time against the flow from section 4; clean the screen; check needle setting</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Bang in the pipe at shut-off</td>
							<td class="px-4 py-3 text-gray-700">Pilot modulating too fast, or a direct-acting float fitted instead of a control valve</td>
							<td class="px-4 py-3 text-gray-700">Verify a slow-closing hydraulic valve is installed; review pilot and needle configuration</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Valve cycles open and closed repeatedly</td>
							<td class="px-4 py-3 text-gray-700">Float set with too little travel; air in the pilot circuit; demand drawn during refill</td>
							<td class="px-4 py-3 text-gray-700">Re-set the float travel, vent the pilot tubing, separate the continuous demand from the refill duty</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Keep a spares kit with the commissioning records: one diaphragm assembly, one float pilot, and the needle and ball valves for the pilot circuit. On a 1.6 MPa F745X feeding a single elevated tank, the cost of the kit is trivial next to a fortnight of overflow while a replacement is in transit.</p>

			<!-- Section 8 -->
			<h2 id="rfq-checklist-for-level-control-valves" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">8. RFQ Checklist for Level Control Valves</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Hydraulic control valves are quoted on configuration, which is why two factories can price the same model name very differently. Put all of the following in the enquiry and the comparison becomes mechanical.</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Duty, not just model.</strong> Tank volume, required refill flow (m3/h), time allowed, available inlet pressure at the tank, and static lift.</li>
				<li><strong>Size and rating.</strong> DN plus nominal pressure: F745X covers DN50 - DN400 at 1.0 or 1.6 MPa; 100X-16P covers DN40 - DN300 at 0 - 1.0 MPa.</li>
				<li><strong>Materials.</strong> Main valve body (ductile iron QT450-10, cast steel, or CF8 stainless), diaphragm, stem and spring, float pilot, and pilot tubing material (copper or stainless).</li>
				<li><strong>End connection.</strong> Flanged, with the drilling standard named - ANSI, EN 1092, JIS or GB - plus media and temperature range.</li>
				<li><strong>Accessories in the same line item.</strong> SGL41H telescopic Y-strainer, isolation gate valves, bypass, HS41X backflow preventer, and a gauge or flow verification point.</li>
				<li><strong>Documentation.</strong> Shell and seat test reports for the delivered size (see the <a href="/guides/api-598-valve-pressure-test-guide/" class="text-brand-blue font-semibold hover:underline">API 598 test guide</a>), material certificates for body and trim, and a pilot circuit schematic with set levels.</li>
				<li><strong>Spares and service.</strong> Diaphragm assemblies and float pilots as a quantity line, so the maintenance stock arrives with the valve instead of never.</li>
				<li><strong>Supplier verification.</strong> Pilot quality is invisible in photographs. Run the <a href="/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">8-point supplier verification checklist</a> and, for a Chinese manufacturer, the <a href="/guides/how-to-verify-chinese-valve-supplier/" class="text-brand-blue font-semibold hover:underline">five-step verification guide</a> before award.</li>
			</ul>

