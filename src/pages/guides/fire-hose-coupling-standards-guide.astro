	{ id: 'specification-checklist', label: '6. Specification Checklist' },
	{ id: 'faq', label: 'Frequently Asked Questions' }
];

const products = [
	{ slug: 'storz-coupling-2-5inch-aluminum', name: 'Aluminum Storz Fire Coupling 2.5"', img: '/assets/products/storz-coupling-2-5inch-aluminum-overlay.png', desc: 'German standard, quarter-turn, 1.6 MPa, barbed' },
	{ slug: 'fire-hydrant-hose-coupling-adapter-hs', name: 'HS Hydrant Hose Coupling Adapter', img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg', desc: 'DN50/DN65, anodized aluminum, 1.6 MPa' },
