						<a href="/contact/?product=Fire%20Valve%20Certification%20RFQ%20(LatAm)" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Request a Quote</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20a%20quote%20for%20fire%20valves%20and%20hydrants%20for%20a%20Latin%20American%20project" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat on WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
