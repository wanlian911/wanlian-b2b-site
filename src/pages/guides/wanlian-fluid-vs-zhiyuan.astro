	{ id: 'sources', label: 'Sources' }
];

const faq = [
	{
		question: 'Are Wanlian Fluid and Zhiyuan Fire related companies?',
		answer: 'No. They are independent manufacturers in different provinces and different categories. Zhiyuan Fire is Jiangxi Zhiyuan Fire Technology Co., Ltd, based in Xinyu City, Jiangxi, focused on gas and special-agent suppression systems. Wanlian Fluid is Quanzhou Wanlian Fluid Equipment Co., Ltd, based in Quanzhou, Fujian, focused on water-based fire protection and industrial valves. No shared ownership, factory or brand is published by either company.'
	},
	{
		question: 'Which one should I choose for an energy storage or battery facility?',
		answer: 'Split the scope by hazard. Enclosed battery rooms, electrical rooms, converter rooms and substation panels need gas or special-agent suppression (FM200, IG541, C6, aerosol) — that is Zhiyuan Fire\u2019s published category. The yard, process areas, water networks and any monitor or hydrant protection is water-based — that is Wanlian Fluid\u2019s category. Many energy storage projects genuinely need both suppliers for different parts of the bill of materials.'
	},
	{
		question: 'Does Zhiyuan Fire make fire hydrants, water monitors or water valves?',
		answer: 'No — their published range covers gas and special-agent suppression (heptafluoropropane, ultra-fine dry powder, hot aerosol, IG541, IG100/pure nitrogen, high-pressure CO2, fire detection tube, perfluorohexanone) plus high-pressure fine water mist systems. Hydrants, fire water monitors, sprinkler alarm valves and water supply pipeline valves are not in their published catalog. Those are Wanlian Fluid\u2019s core lines.'
	},
	{
		question: 'Which certifications should I request from each company?',
		answer: 'From Zhiyuan Fire: the fire product certificates from the Fire Product Certification Center of the Ministry of Emergency Management for the exact system and model you specify, plus evidence of their engineering and special-equipment qualifications where a turnkey scope is involved. From Wanlian Fluid: the ISO 9001:2015 certificate, per-model UL 262/UL 1091 and FM 1120/1130 certificates for the specific valve models in their certificate page, CE documentation where required, and per-unit shell pressure and air-leakage test records. In both cases, verify any certificate number at the issuing body\u2019s official portal before you specify it.'
	},
	{
		question: 'Can both manufacturers do OEM / private label?',
		answer: 'Wanlian Fluid explicitly accepts OEM/ODM — custom branding, packaging and a five-language technical site (EN/ES/RU/FR/AR) for distributors building their own brand. Zhiyuan Fire publishes itself as a manufacturer, supplier and technical service provider with a Grade 1 fire-facility engineering qualification, so its strength is turnkey systems and installation; ask it directly about branding options for your market before assuming private-label supply.'
	},
	{
		question: 'Can one project use both companies without conflict?',
		answer: 'Yes — this is common in petrochemical, industrial and energy projects: water-based protection (hydrants, sprinklers, monitors, valves) for process areas and buildings from one supplier, and gas suppression for electrical rooms, server rooms and battery rooms from another. The two scopes do not overlap, so they can be quoted, inspected and shipped independently. Our procurement whitepaper covers how to manage the verification and payment controls for each scope.'
	}
];

const productRows = [
	{ slug: 'auto-tracking-jet-suppression-cannon-zdms', name: 'Auto-Tracking Jet Suppression Fire Cannon (ZDMS Series)', img: '/assets/products/auto-tracking-jet-suppression-cannon-zdms.webp', desc: 'Flame-detecting self-tracking water cannon for tank farms & open areas' },
	{ slug: 'overground-fire-hydrant-ss100', name: 'Overground Antifreeze Fire Hydrant (SS100/65)', img: '/assets/products/overground-fire-hydrant-ss100.webp', desc: 'Antifreeze dry-barrel outdoor hydrant for municipal fire networks' },
	{ slug: 'glass-bulb-fire-sprinkler-zst', name: 'Glass Bulb Fire Sprinkler (ZST Series)', img: '/assets/products/glass-bulb-fire-sprinkler-zst.webp', desc: 'Pendent & upright heads for building sprinkler systems' }
