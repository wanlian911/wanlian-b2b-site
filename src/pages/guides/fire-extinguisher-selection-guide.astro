---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/sections/TableOfContents.astro';

// FAQ:4-6 条真实采购问题(会生成 FAQPage JSON-LD)
const faq = [
	{
		question: 'Which fire classes can an ABC dry powder fire extinguisher handle?',
		answer: 'An ABC dry powder extinguisher covers Class A (wood, paper, textiles), Class B (flammable liquids), Class C (flammable gases) and Class E (electrical) fires, which is why it is the default portable unit for commercial and industrial buildings. It is not the right choice for Class F cooking-oil fires (use wet chemical) or Class D metal fires (use specialist metal powder).'
	},
	{
		question: 'What does ISO 7165 certification mean on a fire extinguisher?',
		answer: 'ISO 7165 is the international standard for portable fire extinguishers, covering performance, construction, marking and testing. Our 5kg ABC dry powder model is manufactured to ISO 7165 and also carries CCCF. Note that CCCF is the China Compulsory Certification for fire products — it qualifies the unit for the Chinese market but is not an export certificate by itself. For export, request the certificate for the exact model and destination market.'
	},
	{
		question: 'What sizes of ABC dry powder extinguishers are available?',
		answer: 'The Wanlian ABC dry powder extinguisher is available in 3kg, 4kg and 5kg net agent weights, with a discharge time of approximately 8-15 seconds and a color-coded pressure gauge on the carbon steel cylinder. A 5kg unit is the common specification for offices, warehouses and commercial installations; confirm your hazard class and coverage area when requesting a quotation.'
	},
	{
		question: 'Can I order fire extinguishers with my own brand and label (OEM)?',
		answer: 'Yes. We support OEM on cylinder color, body label, logo and language, and can match label language to your destination market. MOQ, artwork confirmation and lead time are confirmed on quotation — send your target volume and market so we can quote the correct configuration.'
	},
	{
		question: 'Do dry powder extinguishers need special packaging for export shipping?',
		answer: 'Because the cylinder is pressurized, confirm the dangerous-goods classification (UN number) and transport packaging requirements with your forwarder for the exact model. For shipments from China that are classified as dangerous goods, the exporter must provide the appraisal certificate for transport packaging of outbound dangerous goods; customs enforcement cases show that shipments without it can be detained and penalized. We confirm packaging and documentation requirements with you before production.'
	},
	{
		question: 'When should I choose CO2 instead of ABC dry powder?',
		answer: 'Use CO2 where powder residue would be costly to clean: control rooms, server rooms, laboratories and switchgear. ABC dry powder is the better all-round value for general commercial, warehouse and industrial areas covering mixed Class A/B hazards. If your project mixes both areas, a typical package combines powder units for open areas with CO2 units for sensitive equipment rooms.'
	}
];

// TOC:与正文 H2 的 id 一一对应
const toc = [
	{ id: 'why-fire-extinguishers', label: '1. Why Fire Extinguishers Lead Fire-Protection Sourcing' },
	{ id: 'fire-classes-agents', label: '2. Fire Classes and Extinguishing Agents' },
	{ id: 'abc-specifications', label: '3. ABC Dry Powder Specifications Explained' },
	{ id: 'certification-compliance', label: '4. Certification and Compliance for Export' },
	{ id: 'applications-scenarios', label: '5. Where Extinguishers Are Installed' },
	{ id: 'factory-buying-checklist', label: '6. Factory Buying Checklist: OEM, MOQ & Packaging' },
	{ id: 'faq', label: 'Frequently Asked Questions' }
];

// 关联产品(slug 与 products.ts 一致)
const products = [
	{ slug: 'abc-dry-powder-fire-extinguisher-5kg', name: 'ABC Dry Powder Fire Extinguisher (5kg)', img: '/assets/products/abc-dry-powder-fire-extinguisher-5kg.webp', desc: 'Portable ISO 7165 unit covering Class A/B/C/E fires' },
	{ slug: 'stainless-steel-fire-extinguisher-box', name: 'Stainless Steel Fire Extinguisher Box', img: '/assets/products/stainless-steel-fire-extinguisher-box.jpg', desc: 'SS304/201 cabinet for extinguisher or hose reel storage' },
	{ slug: 'metal-fire-extinguisher-box-red', name: 'Metal Fire Extinguisher Box (Red)', img: '/assets/products/metal-fire-extinguisher-box-red.jpg', desc: 'Powder-coated cabinet with instruction panel, OEM sizes' }
];
---

<Layout
	title="Fire Extinguisher Buying Guide: ABC Dry Powder for B2B & Export"
	description="Portable fire extinguisher selection guide for B2B buyers: ABC dry powder fire extinguisher classes, ISO 7165 certification, sizes, OEM supply and export packaging."
	type="article"
	faq={faq}
	breadcrumbs={[{ name: 'Guides', href: '/blog/' }, { name: 'Fire Extinguisher Selection' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- 面包屑 -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/" class="hover:text-blue-600">Home</a>
			<span>/</span>
			<a href="/blog/" class="hover:text-blue-600">Guides</a>
			<span>/</span>
			<span class="text-gray-600">Fire Extinguisher Selection</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Fire Protection Guide</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Fire Extinguisher Selection Guide: ABC Dry Powder for B2B &amp; Export Projects</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Portable fire extinguishers are the highest-volume entry point in fire-protection sourcing — but ABC dry powder, CO2, foam and water units are not interchangeable. This guide helps importers, distributors and project buyers match fire classes to extinguishing agents, check the specifications that actually matter, and get the certification and dangerous-goods paperwork right before an order ships.</p>

			<TableOfContents headings={toc} />

			<!-- 产品条 -->
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- 章节 1 -->
			<h2 id="why-fire-extinguishers" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Why Fire Extinguishers Lead Fire-Protection Sourcing</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Industry platform search data from August 2026 shows that <strong>fire extinguisher</strong> was the most-searched category in the fire-protection sample — roughly 19,800 searches, about one-third of all top-category searches — with related portable formats such as aerosol and ball-type units adding thousands more. Google's relative search-interest index for "fire extinguisher" measured 80/100 in August 2026 after peaking at 100 earlier in the year, with the strongest relative interest in Qatar, the UAE, the Philippines, the US and the UK.</p>
			<p class="text-gray-700 leading-relaxed">What the numbers really mean for a supplier: demand arrives from three different buying modes at once — distributors restocking standard SKUs, contractors fitting out buildings under specification, and facility managers replacing expired units. A generic "fire equipment" pitch blurs retail and engineering buyers into one indistinct inquiry. Presenting the extinguishing agent, capacity, class coverage and certification up front is what lets each buyer self-select the right product family.</p>

			<!-- 章节 2 -->
			<h2 id="fire-classes-agents" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Fire Classes and Extinguishing Agents</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Every portable extinguisher is rated against fire classes, and the agent must match the hazard. ABC dry powder is the multi-purpose default; other agents win where residue, reignition risk or special fuels change the picture.</p>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Fire Class</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Typical Fuels</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Most Effective Agents</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">ABC Dry Powder Fit</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Class A</td>
							<td class="px-4 py-3 text-gray-700">Wood, paper, textiles, plastics</td>
							<td class="px-4 py-3 text-gray-700">Water, foam, ABC powder</td>
							<td class="px-4 py-3 text-gray-700">Standard choice</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Class B</td>
							<td class="px-4 py-3 text-gray-700">Petrol, oils, solvents, paints</td>
							<td class="px-4 py-3 text-gray-700">ABC powder, foam, CO2</td>
							<td class="px-4 py-3 text-gray-700">Standard choice</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Class C</td>
							<td class="px-4 py-3 text-gray-700">Propane, butane, methane, LPG</td>
							<td class="px-4 py-3 text-gray-700">ABC powder (shut off supply first)</td>
							<td class="px-4 py-3 text-gray-700">Suitable</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Class E</td>
							<td class="px-4 py-3 text-gray-700">Energized electrical equipment</td>
							<td class="px-4 py-3 text-gray-700">CO2, ABC powder (non-conductive)</td>
							<td class="px-4 py-3 text-gray-700">Suitable — mind powder residue</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Class F</td>
							<td class="px-4 py-3 text-gray-700">Cooking oils and fats</td>
							<td class="px-4 py-3 text-gray-700">Wet chemical</td>
							<td class="px-4 py-3 text-gray-700">Not recommended</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Class D</td>
							<td class="px-4 py-3 text-gray-700">Combustible metals (Mg, Na)</td>
							<td class="px-4 py-3 text-gray-700">Specialist metal powder</td>
							<td class="px-4 py-3 text-gray-700">Not suitable</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">For the mixed occupancies most B2B buyers supply — offices, warehouses, workshops, retail — one ABC dry powder line typically covers 80% of the portable units on the bill of materials, with CO2 reserved for electrical rooms and foam or wet chemical for specialized hazards.</p>

			<!-- 章节 3 -->
			<h2 id="abc-specifications" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. ABC Dry Powder Specifications Explained</h2>
			<p class="text-gray-700 leading-relaxed mb-4">When a quotation arrives, check these five parameters before comparing prices across suppliers:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Agent and capacity</strong> — monoammonium-phosphate based ABC powder is the multi-purpose standard; net agent weight (3kg / 4kg / 5kg on our range) drives both coverage and freight cost.</li>
				<li><strong>Active content</strong> — our ABC powder is specified at 90% active content, which affects extinguishing performance per kilogram.</li>
				<li><strong>Discharge performance</strong> — expect roughly 8-15 seconds of effective discharge on a 5kg unit; the spec sheet should state it rather than leaving it implied.</li>
				<li><strong>Stored-pressure operation and gauge</strong> — the propellant and powder are kept under pressure in one cylinder; a color-coded gauge shows the unit is serviceable, so the gauge design matters for maintenance inspections.</li>
				<li><strong>Cylinder and valve quality</strong> — carbon steel cylinder with corrosion-resistant red coating, brass valve assembly, and a discharge hose with nozzle complete the unit.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed mb-4">Our <a href="/products/abc-dry-powder-fire-extinguisher-5kg/" class="text-brand-blue font-semibold hover:underline">5kg ABC dry powder fire extinguisher</a> is manufactured to ISO 7165 with CCCF marking, covers Class A/B/C/E fires, and is available in 3kg / 4kg / 5kg net weights with a one-year warranty. The discharge hose, pressure gauge and brass valve are included as standard.</p>
			<p class="text-gray-700 leading-relaxed">One honest caveat worth passing to your customers: dry powder leaves a residue that is cheap to clean from floors and machinery but damaging to electronics — which is exactly why the Class E row in the table above comes with a caution.</p>

			<!-- 章节 4 -->
			<h2 id="certification-compliance" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Certification and Compliance for Export</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Certification is where portable extinguisher sourcing differs from commodity buying, because the markings must match the actual model — not a brand or a series.</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>ISO 7165</strong> — the international standard for portable fire extinguishers, covering construction, performance and testing. It is the reference point for most export markets and is marked on our 5kg model.</li>
				<li><strong>CCCF</strong> — the China Compulsory Certification for fire products. It qualifies the unit for the Chinese market; it is <strong>not</strong> an export certificate, and this distinction matters when a buyer plans to resell outside China.</li>
				<li><strong>Destination-market certification</strong> — for the EU, verify CE marking against the applicable standard for the exact model; some North American applications look for UL or ULC-listed units. Always ask the manufacturer for the certificate covering the model and valve combination you intend to import, and reject generic "series-wide" statements.</li>
				<li><strong>Marking and language</strong> — operating pictograms, class labels and the language of the instruction label should be confirmed for the destination country before mass production, because re-labeling after arrival is costly.</li>
				<li><strong>Batch test reports</strong> — request the test report for the actual production batch, not a template from a different model. Our <a href="/certificates/" class="text-brand-blue font-semibold hover:underline">certificates and compliance</a> page shows how certification documentation is handled for our fire protection range.</li>
			</ul>

			<!-- 章节 5 -->
			<h2 id="applications-scenarios" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Where Extinguishers Are Installed: Commercial, Warehouse and Vehicle</h2>
			<p class="text-gray-700 leading-relaxed mb-4">The same 5kg ABC unit serves very different end users, and the specification changes with the site:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Commercial buildings and offices</strong> — wall-mounted 4-5kg ABC units near exits and common areas, with CO2 in electrical rooms. Wall boxes protect the unit and make inspection easy.</li>
				<li><strong>Warehouses and industrial floors</strong> — ABC powder for mixed Class A/B hazards; large open areas typically pair extinguishers with hose reel systems and, for very high ceilings, fixed suppression. See our <a href="/guides/fire-hose-reel-cabinet-guide/" class="text-brand-blue font-semibold hover:underline">fire hose reel and cabinet guide</a> for the fixed-equipment side of the same package.</li>
				<li><strong>Vehicle and mobile</strong> — compact units for trucks, forklifts and plant rooms; our 3kg option suits these spaces and can be quoted with mounting hardware.</li>
				<li><strong>Outdoor and corrosive environments</strong> — the <a href="/products/stainless-steel-fire-extinguisher-box/" class="text-brand-blue font-semibold hover:underline">stainless steel extinguisher box</a> (SS304/201 with viewing window) protects units at airports, seafront sites and chemical plants, while the <a href="/products/metal-fire-extinguisher-box-red/" class="text-brand-blue font-semibold hover:underline">red metal extinguisher box</a> with printed operating instructions is the economical indoor standard.</li>
			</ul>

			<!-- 章节 6 -->
			<h2 id="factory-buying-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Factory Buying Checklist: OEM, MOQ &amp; Dangerous-Goods Packaging</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Buying extinguishers from a Chinese factory is a documentation exercise as much as a product exercise. Run this checklist before you commit:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>OEM scope</strong> — cylinder color, body label, logo and label language can be customized; confirm artwork and approval timing in the order schedule.</li>
				<li><strong>MOQ and lead time</strong> — both depend on model, quantity and label configuration, so they are confirmed on quotation; state your target market and annual volume to get a realistic number.</li>
				<li><strong>Dangerous-goods classification</strong> — the pressurized cylinder may be classified as dangerous goods for transport. Confirm the UN classification and packaging requirements for the exact model with your forwarder before booking space.</li>
				<li><strong>China export paperwork</strong> — where a shipment is classified as dangerous goods, the Chinese exporter must provide the appraisal certificate for transport packaging of outbound dangerous goods; customs enforcement cases show shipments without it being detained and penalized. Ask your supplier to confirm this document is in place.</li>
				<li><strong>Consolidate the package</strong> — ordering extinguishers together with wall boxes, hose reels and valves from one manufacturer simplifies certification files and freight. Our <a href="/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">B2B valve sourcing checklist</a> covers the factory-verification side of the same due diligence.</li>
			</ul>

			<!-- FAQ 章节 -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Frequently Asked Questions</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- 双 CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Sourcing ABC Dry Powder Fire Extinguishers?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Send your target market, quantity and label language — our team confirms certification status, MOQ and dangerous-goods packaging requirements within 12 hours.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/contact/?product=ABC%20Dry%20Powder%20Fire%20Extinguisher" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Request a Quote</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20ABC%20dry%20powder%20fire%20extinguishers" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat on WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
