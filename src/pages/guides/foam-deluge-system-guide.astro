---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'Where is the cost difference between a foam deluge system and a normal water deluge system?',
		answer: 'A foam deluge system adds a concentrate supply, a proportioning device, compatible discharge devices and commissioning tests to the deluge valve and water network. The concentrate, storage arrangement, flushing provisions and disposal of test solution also affect lifecycle cost. A normal water deluge system may be adequate for a Class A hazard, but water alone is not a substitute for foam on a burning flammable-liquid surface.'
	},
	{
		question: 'How do I choose between a bladder tank and an in-line ejector?',
		answer: 'A bladder tank is a practical choice when a dedicated concentrate reserve and a predictable proportioning range are required without an electric metering pump. An in-line ejector is compact and uses the water stream to draw concentrate, but its operating flow and pressure range must match the hazard demand. Confirm the hydraulic envelope, available space, refill method and required 3% or 6% mix with the fire-protection designer.'
	},
	{
		question: 'What must be replaced when an old AFFF system is converted to F3?',
		answer: 'Do not assume that changing only the drum is safe. The concentrate, proportioner, bladder or tank materials, seals, foam devices, flush water arrangement and test procedure must be checked as a compatible package. Existing pipework may be reusable after cleaning, but residual AFFF and mixed concentrates can change performance. Obtain the F3 manufacturer\'s compatibility statement and have the authority having jurisdiction accept the conversion.'
	},
	{
		question: 'How can the foam mixture ratio be verified in the field?',
		answer: 'During a controlled discharge test, measure the water and concentrate flow or use the approved sampling and analysis method specified for the supplied proportioner and concentrate. Compare the measured result with the design ratio, commonly 3% or 6%, across the relevant operating flow range. Record water quality, pressure, temperature, sample points and the concentrate batch; a visual foam blanket alone does not prove proportioning accuracy.'
	},
	{
		question: 'Can I change foam concentrates, and what is the compatibility risk?',
		answer: 'Treat concentrate changes as an engineering change, not a simple replacement purchase. AFFF, AR-AFFF, FFFP and fluorine-free concentrates can have different viscosity, expansion, drainage and material-compatibility requirements. Do not mix products in a tank or proportioner unless both manufacturers approve it. Flush, inspect and re-verify the complete system before placing the new concentrate in service.'
	},
	{
		question: 'How should a foam deluge system be protected in a cold environment?',
		answer: 'Protect water-filled pipework, valves and concentrate equipment from freezing according to the site climate and the approved design. Options may include a dry or pre-action section, heat tracing, insulated enclosures, listed antifreeze arrangements where permitted, and a concentrate with a suitable low-temperature rating. Confirm the concentrate storage temperature and the deluge trip arrangement with the system designer; do not dilute concentrate with unapproved antifreeze.'
	}
];

const toc = [
	{ id: 'why-foam', label: '1. When Foam Beats Water' },
	{ id: 'anatomy', label: '2. Anatomy of a Foam Deluge System' },
	{ id: 'proportioning', label: '3. Proportioning Options Compared' },
	{ id: 'concentrate', label: '4. Choosing the Foam Concentrate' },
	{ id: 'discharge', label: '5. Discharge Devices: Spray Heads, Monitors and Cabinets' },
	{ id: 'testing', label: '6. Commissioning and Field Testing' },
	{ id: 'rfq-checklist', label: '7. Foam System RFQ Checklist' },
	{ id: 'faq', label: 'Frequently Asked Questions' }
];

const products = [
	{ slug: 'deluge-alarm-valve-zsfm', name: 'Deluge Alarm Valve Group (ZSFM Series)', img: '/assets/products/deluge-alarm-valve-zsfm.webp', desc: 'Fast-open deluge valve ahead of foam discharge devices' },
	{ slug: 'foam-fire-hydrant-cabinet-psg30', name: 'Foam Fire Hydrant Cabinet (PSG30 Series)', img: '/assets/products/foam-fire-hydrant-cabinet-psg30.webp', desc: '3% premix foam station with hose and monitor interface' },
	{ slug: 'manual-fire-water-cannon-ps', name: 'Manual Fire Water Monitor (PS Series)', img: '/assets/products/manual-fire-water-cannon-ps.webp', desc: 'Fixed monitor, foam-compatible jet/spray nozzle' },
	{ slug: 'adjustable-pistol-grip-fire-nozzle', name: 'Adjustable Pistol Grip Fire Nozzle', img: '/assets/products/adjustable-pistol-grip-fire-nozzle.jpg', desc: 'Handline nozzle for hose foam application' }
];
---

<Layout
	title="Foam Deluge and Foam-Water Spray Systems Guide (2026)"
	description="Foam deluge and foam-water spray systems for Class B risks: deluge valve, proportioning options, concentrates, discharge devices and field testing."
	type="article"
	faq={faq}
	breadcrumbs={[{ name: 'Guides', href: '/blog/' }, { name: 'Foam Deluge Systems Guide' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/" class="hover:text-blue-600">Home</a>
			<span>/</span>
			<a href="/blog/" class="hover:text-blue-600">Guides</a>
			<span>/</span>
			<span class="text-gray-600">Foam Deluge Systems Guide</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Foam System Guide</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Foam Deluge and Foam-Water Spray Systems: Selection and Sizing Guide</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">In short: foam deluge protects a Class B liquid hazard by opening a deluge valve, proportioning foam concentrate into the fire-water flow and sending the finished solution to open spray heads, monitors or hose stations. The right design starts with the fuel, the required application area and the approved concentrate, then checks the proportioner, valve trim, discharge pattern, drainage and field test plan as one system.</p>

			<TableOfContents headings={toc} />

			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 id="why-foam" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. When Foam Beats Water</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Foam is selected when the fuel is a flammable liquid and the design objective is to control vapour release as well as flame. Typical Class B locations include tank farms, fuel storage, aircraft hangars, paint shops, solvent areas and chemical process spaces. Water applied alone can sink beneath or spread a burning liquid, and a high-velocity jet can splash fuel beyond the original spill. A properly selected low-expansion foam blanket separates the liquid surface from air and helps suppress vapour release.</p>
			<p class="text-gray-700 leading-relaxed mb-4">A foam-water spray system is not simply a water deluge system with a foam drum nearby. The water demand, application device, concentrate percentage, drainage and discharge duration must be coordinated. The detection system normally initiates the sequence: detection releases the trim, the deluge valve opens, water reaches the open discharge devices and proportioning introduces concentrate. The finished solution then covers the hazard at the specified pattern and density.</p>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Fire Class</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Typical Fuels</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Most Effective Agents</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Foam Deluge Fit</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">Class A</td><td class="px-4 py-3 text-gray-700">Wood, paper, textiles, plastics</td><td class="px-4 py-3 text-gray-700">Water, foam, ABC powder</td><td class="px-4 py-3 text-gray-700">Usually water first</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Class B</td><td class="px-4 py-3 text-gray-700">Petrol, oils, solvents, paints</td><td class="px-4 py-3 text-gray-700">ABC powder, foam, CO2</td><td class="px-4 py-3 text-gray-700">Primary fixed-system use</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Class C</td><td class="px-4 py-3 text-gray-700">Propane, butane, methane, LPG</td><td class="px-4 py-3 text-gray-700">ABC powder (shut off supply first)</td><td class="px-4 py-3 text-gray-700">Not a substitute for gas isolation</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Class E</td><td class="px-4 py-3 text-gray-700">Energized electrical equipment</td><td class="px-4 py-3 text-gray-700">CO2, ABC powder (non-conductive)</td><td class="px-4 py-3 text-gray-700">Confirm electrical strategy</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Class F</td><td class="px-4 py-3 text-gray-700">Cooking oils and fats</td><td class="px-4 py-3 text-gray-700">Wet chemical</td><td class="px-4 py-3 text-gray-700">Not recommended</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Class D</td><td class="px-4 py-3 text-gray-700">Combustible metals (Mg, Na)</td><td class="px-4 py-3 text-gray-700">Specialist metal powder</td><td class="px-4 py-3 text-gray-700">Not suitable</td></tr>
					</tbody>
				</table>
			</div>

			<h2 id="anatomy" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Anatomy of a Foam Deluge System</h2>
			<p class="text-gray-700 leading-relaxed mb-4">The core assembly has five coordinated zones. First is the water supply and control assembly, including the <a href="/products/deluge-alarm-valve-zsfm/" class="text-brand-blue font-semibold hover:underline">ZSFM deluge alarm valve group</a>, trim, drain and supervisory points. Second is detection and release: a heat, flame, smoke or linear detection arrangement sends the release signal, which opens the valve before the open heads discharge. Third is concentrate storage, which may be a bladder tank or another approved vessel. Fourth is the proportioning device and its isolation, check and test valves. Fifth is the open discharge network, including spray heads, monitors and hose cabinets.</p>
			<p class="text-gray-700 leading-relaxed mb-4">The deluge valve is normally closed on the water side and the downstream pipe is normally dry or held in the arrangement specified for the project. When the release trim operates, the valve opens quickly and sends water to all open devices in the protected zone. A <a href="/products/pre-action-alarm-system-zsfy/" class="text-brand-blue font-semibold hover:underline">ZSFY pre-action alarm system</a> may be considered where the project requires a supervised release sequence and reduced accidental discharge risk, but the designer must confirm whether its operating sequence suits the foam application objective.</p>
			<p class="text-gray-700 leading-relaxed">Keep the system boundary clear in the RFQ. Wanlian supplies deluge valve groups, valves for foam proportioning packages, foam cabinets, monitors and nozzles. Foam concentrate can be assisted through supply channels, but it is not manufactured in-house by Wanlian; state the concentrate brand, certificate and compatibility responsibility separately.</p>

			<h2 id="proportioning" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Proportioning Options Compared</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Proportioning is the control point that determines whether water becomes the specified foam solution. Common design ratios are 3% and 6%, but the correct ratio is set by the concentrate approval and hazard design, not by a buyer preference. The table below compares the three arrangements most often discussed during procurement.</p>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Option</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">How it works</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Best fit and watch-outs</th></tr></thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">Bladder tank</td><td class="px-4 py-3 text-gray-700">Water pressure collapses a flexible concentrate bladder and pushes concentrate to the proportioner.</td><td class="px-4 py-3 text-gray-700">Dedicated reserve and broad project familiarity; needs space, refill planning and verified tank-to-concentrate compatibility.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">In-line ejector</td><td class="px-4 py-3 text-gray-700">A water-powered venturi draws concentrate from a container as water passes through the ejector.</td><td class="px-4 py-3 text-gray-700">Compact and simple for a defined flow range; pressure loss and minimum operating flow can limit selection.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Around-pump proportioner</td><td class="px-4 py-3 text-gray-700">A dedicated pump circuit and pressure-relief or return arrangement meters concentrate around the water pump.</td><td class="px-4 py-3 text-gray-700">Useful for larger or variable-flow systems; requires pump controls, relief logic and more commissioning coordination.</td></tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">For more hydraulic background, compare the project with our <a href="/guides/foam-proportioning-system-guide/" class="text-brand-blue font-semibold hover:underline">foam proportioning system guide</a> before selecting a tank or ejector. Ask for the minimum and maximum flow, inlet pressure, expected concentrate viscosity, operating temperature and test connection. Those inputs are more useful than a nominal pipe size alone.</p>

			<h2 id="concentrate" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Choosing the Foam Concentrate</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Start with the fuel chemistry. AFFF has fast film-forming action on many hydrocarbon fuels, but it contains PFAS. Many jurisdictions now restrict or review AFFF-type PFAS concentrates; confirm local rules and consider fluorine-free (F3) alternatives. AR-AFFF is designed for polar solvents, where an alcohol-resistant blanket is needed. FFFP and other formulations have their own application, expansion and drainage evidence. Do not choose from the acronym alone: request the current product data sheet, approval scope and mixing instructions.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Concentrate storage life is whatever the manufacturer certificate states for the specified storage conditions. Avoid putting an invented expiry period into the purchase order. Record batch number, manufacture date, storage temperature and inspection method, and make sure the tank, bladder, seals, proportioner and discharge devices are approved for the chosen product. A concentrate that is chemically correct but incompatible with the equipment is not a compliant design.</p>
			<p class="text-gray-700 leading-relaxed">F3 conversion deserves a documented engineering review. Existing pipework may be retained after cleaning and inspection, but residual AFFF, elastomer compatibility, proportioner calibration and foam-device performance all need confirmation. The foam supplier, system designer and authority having jurisdiction should agree the change before the old concentrate is drained.</p>

			<h2 id="discharge" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Discharge Devices: Spray Heads, Monitors and Cabinets</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Open foam spray heads are selected for coverage, droplet distribution, obstruction and application density. They suit a fixed deluge zone where the hazard geometry is known. Monitors add reach and directional control for tank bunds, loading areas and large open risks; the <a href="/products/manual-fire-water-cannon-ps/" class="text-brand-blue font-semibold hover:underline">PS Series manual fire water monitor</a> can be specified with a foam-compatible jet or spray nozzle after the project confirms flow and throw requirements.</p>
			<p class="text-gray-700 leading-relaxed mb-4">A hose station supports manual intervention and supplementary application, but it should not be treated as a substitute for automatic coverage where the risk assessment requires fixed protection. The <a href="/products/foam-fire-hydrant-cabinet-psg30/" class="text-brand-blue font-semibold hover:underline">PSG30 foam fire hydrant cabinet</a> packages a 3% premix foam station with hose and monitor interface. For handlines, an <a href="/products/adjustable-pistol-grip-fire-nozzle/" class="text-brand-blue font-semibold hover:underline">adjustable pistol grip fire nozzle</a> provides selectable application at the end of the hose; verify that its seals and flow range suit the finished foam solution.</p>
			<p class="text-gray-700 leading-relaxed">Use the separate <a href="/guides/fire-water-monitor-selection-guide/" class="text-brand-blue font-semibold hover:underline">fire water monitor selection guide</a> for monitor reach, nozzle pattern and mounting questions. Also coordinate the <a href="/guides/deluge-valve-selection-guide/" class="text-brand-blue font-semibold hover:underline">deluge valve selection guide</a> with the foam package: valve trim, release pressure, alarm outlet and drain arrangements must work together. Drainage is especially important because a test or real discharge may produce a large volume of foam solution that cannot simply enter a storm drain.</p>

			<h2 id="testing" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Commissioning and Field Testing</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Commissioning proves the complete chain from detection to discharge. Flush the water and concentrate pipework according to the approved procedure, remove construction debris, verify valve trim orientation and confirm every open device is the intended model and orifice. A deluge valve trip test should verify detection or manual release, valve opening, water motor alarm or electrical signal, downstream pressure and reset. Use the NFPA 11 and EN 12845 framework where applicable, together with the local authority requirements and the concentrate manufacturer instructions.</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Measure the mixture ratio.</strong> Test the finished solution at the approved flow range and confirm the result against the 3% or 6% design value.</li>
				<li><strong>Check foam quality.</strong> Measure expansion and 25% drainage time using the test method required for the supplied concentrate and its approval; do not invent acceptance limits from another product.</li>
				<li><strong>Prove the trip sequence.</strong> Record detection input, deluge valve opening time, alarms, pressure readings and reset procedure.</li>
				<li><strong>Inspect the discharge pattern.</strong> Confirm spray-head coverage, monitor movement, cabinet hose condition and nozzle pattern without exposing personnel to an uncontrolled hazard.</li>
				<li><strong>Document the result.</strong> Keep water quality, concentrate batch, temperature, flow, pressure, samples, photographs and corrective actions with the O&amp;M file.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">A functional trip test without mixture verification can miss a closed concentrate valve, empty tank, blocked ejector or incompatible concentrate. Plan the test water collection and disposal before the contractor arrives. Repeat inspections at the interval required by the project documents and the concentrate certificate.</p>

			<h2 id="rfq-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">7. Foam System RFQ Checklist</h2>
			<p class="text-gray-700 leading-relaxed mb-4">A useful RFQ gives the supplier enough information to check hydraulics instead of guessing from a product name. Include the following in one marked-up plan or equipment schedule:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Hazard and fuel:</strong> hydrocarbon or polar solvent, storage height, bund geometry, spill scenario and whether adjacent exposures need cooling.</li>
				<li><strong>Design demand:</strong> protected area, application density, design duration, simultaneous zones, water flow and available pressure at the proportioner inlet.</li>
				<li><strong>Concentrate:</strong> manufacturer, formulation, 3% or 6% ratio, approval documents, storage temperature, batch information and whether F3 conversion is involved.</li>
				<li><strong>Equipment scope:</strong> ZSFM deluge valve group, proportioner type, tank volume, isolation and test valves, open heads, monitor, cabinet, nozzle and detection interface.</li>
				<li><strong>Materials and interfaces:</strong> pipe sizes, flange standard, wetted materials, elastomers, electrical voltage, alarm contacts and hazardous-area requirements.</li>
				<li><strong>Testing and documents:</strong> flushing plan, trip test, mixture-ratio method, expansion and drainage test, certificates, drawings, spare seals and O&amp;M instructions.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed mb-4">For European projects, review the related <a href="/guides/ce-en12845-fire-protection-compliance/" class="text-brand-blue font-semibold hover:underline">CE and EN 12845 fire-protection compliance guide</a>, while still confirming the specific foam standard and authority requirements for the hazard. If the scope includes a separate water monitor, the <a href="/fire-water-cannon/" class="text-brand-blue font-semibold hover:underline">fire water cannon range</a> can be considered alongside the fixed spray design. Wanlian can quote the valve and discharge-equipment portion from the schedule and identify which concentrate items need an approved channel partner.</p>

			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Frequently Asked Questions</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Need a Foam Deluge System Quote?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Send the fuel type, protected area, design flow and pressure, concentrate ratio, proportioning preference and discharge devices. Wanlian can review the deluge valve, foam package, monitor, cabinet and nozzle scope for your project.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/contact/?product=Foam%20Deluge%20System" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Request a Quote</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20a%20foam%20deluge%20system%20quote" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat on WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
