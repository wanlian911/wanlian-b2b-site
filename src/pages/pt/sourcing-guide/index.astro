---
import Layout from '../../../layouts/Layout.astro';
const faq = [{ question: 'Quanto tempo leva o processo completo de compras?', answer: 'Para modelos em estoque, a especificação e a cotação levam poucos dias, a amostra normalmente leva 1–3 semanas e a produção leva 15–30 dias. Itens OEM/ODM podem exigir tempo adicional.' }, { question: 'Quais documentos devo exigir?', answer: 'Solicite fatura comercial, lista de embalagem, certificado de origem, registros de teste por unidade, certificados de material e certificados de norma aplicáveis ao modelo.' }];
const steps = [
 { n: '01', title: 'Redija a especificação', body: 'Defina norma, tamanhos, pressão nominal, materiais, quantidades, destino e Incoterm. Uma especificação clara reduz o risco de divergências.', links: [{ label: 'Glossário industrial', href: '/pt/glossary/' }, { label: 'Guia de normas', href: '/pt/guides/fire-hydrant-valve-standards-guide/' }] },
 { n: '02', title: 'Qualifique e verifique o fornecedor', body: 'Confirme a entidade legal, o sistema ISO 9001, a capacidade de fabricação, o histórico de exportação e os certificados no portal do organismo emissor.', links: [{ label: 'Checklist de compras B2B', href: '/pt/guides/b2b-valve-sourcing-checklist/' }, { label: 'Verificar fornecedor chinês', href: '/pt/guides/how-to-verify-chinese-valve-supplier/' }] },
 { n: '03', title: 'Solicite e compare cotações detalhadas', body: 'Compare o mesmo modelo, norma, material, quantidade, Incoterm e destino. Não compare apenas o preço unitário: avalie o custo total entregue.', links: [{ label: 'Calculadora de custos', href: '/pt/cost-calculator/' }] },
 { n: '04', title: 'Peça uma amostra e inspecione', body: 'Solicite uma unidade de cada modelo. Verifique placa de identificação, número de série, material e teste de pressão antes do pedido em volume.', links: [{ label: 'Como escolher um hidrante', href: '/pt/guides/how-to-choose-a-fire-hydrant/' }] },
 { n: '05', title: 'Confirme produção, qualidade e documentos', body: 'Exija cronograma, registros de teste por unidade, embalagem de exportação e documentação antes do pagamento final.', links: [{ label: 'Wanlian Fluid — fábrica e testes', href: '/pt/about/' }] },
 { n: '06', title: 'Planeje logística e pós-venda', body: 'Escolha EXW, FOB, CIF ou DDP conforme a distribuição de riscos. Guarde certificados e registros para aceitação, manutenção e futuras peças de reposição.', links: [{ label: 'Solicitar cotação', href: '/pt/contact/' }] }
];
---
<Layout title="Guia de Compras: Válvulas e Hidrantes Contra Incêndio" description="Roteiro B2B para comprar válvulas, hidrantes e equipamentos contra incêndio: especificação, verificação, amostra, qualidade e documentação." type="website" locale="pt" faq={faq} breadcrumbs={[{ name: 'Recursos' }, { name: 'Guia de compras' }]}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/pt/">Início</a><span>/</span><span class="text-gray-600">Guia de compras</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Centro de compras B2B</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Como comprar válvulas, hidrantes e equipamentos contra incêndio</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Um roteiro em seis etapas para comprar de um fabricante chinês, da especificação escrita ao pós-venda.</p><div class="bg-blue-50 border border-blue-100 rounded-xl p-5 my-6"><p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-blue">Por que seguir uma sequência:</strong> os principais riscos aparecem nas transições entre especificação, verificação, amostra e documentação. A lista abaixo ajuda você a identificá-los antes do pagamento.</p></div>{steps.map(s => <section class="mt-10"><h2 class="text-2xl font-black text-gray-900 mb-3 tracking-tight scroll-mt-24 flex items-center gap-3"><span class="text-brand-red text-2xl tabular-nums">{s.n}</span>{s.title}</h2><p class="text-gray-700 leading-relaxed mb-3">{s.body}</p><div class="flex flex-wrap gap-2">{s.links.map(l => <a href={l.href} class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 text-gray-700 text-xs font-bold rounded-full">{l.label} →</a>)}</div></section>)}<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6">Perguntas frequentes</h2><div class="space-y-4">{faq.map(item => <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>)}</div><div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white">Comece suas compras com uma cotação em até 12 horas</h2><a href="/pt/contact/" class="inline-block mt-6 px-8 py-4 bg-brand-red text-white font-bold rounded-lg">Solicitar cotação</a></div></div></article></main>
</Layout>
