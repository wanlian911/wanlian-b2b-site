---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Qual é a diferença entre um dispositivo anti-retorno e uma válvula de retenção?',
		answer: 'Uma válvula de retenção padrão impede mecanicamente o fluxo reverso, mas não é testada para vazamentos e não possui dreno intermediário. Um dispositivo anti-retorno como o HS41X combina duas retenções independentes com uma câmara de dreno automático intermediário, é testável in loco e atende aos requisitos de controle de conexões cruzadas para a proteção da água potável. Válvulas de retenção sozinhas não são aceitas em conexões cruzadas de água potável.'
	},
	{
		question: 'Onde o dispositivo anti-retorno deve ser instalado na conexão de serviço contra incêndio?',
		answer: 'Na conexão de serviço contra incêndio à rede de água potável, a montante da sucção da bomba contra incêndio ou do montante do sistema. Deve ser acessível para testes, protegido contra congelamento, e sua perda de carga incluída no cálculo hidráulico da bomba contra incêndio. Para sistemas em prédios altos, confirme que a classificação do dispositivo corresponde à pressão estática máxima do abastecimento.'
	},
	{
		question: 'Válvulas de controle hidráulico precisam de eletricidade para operar?',
		answer: 'A maioria das válvulas de controle hidráulico — a válvula redutora de pressão 500X, a válvula de controle de nível F745X e o dispositivo anti-retorno HS41X — é totalmente autoperada pela pressão da tubulação e não requer alimentação externa. Modelos com controle por solenoide, como o GKZF-1, usam AC220V ou DC24V para automação remota.'
	},
	{
		question: 'Quais materiais são usados em aplicações de água potável?',
		answer: 'Para redes de água de beber, o dispositivo anti-retorno HS41X usa corpo em ferro fundido dúctil com vedação EPDM e componentes internos em aço inox 304, conforme os requisitos sanitários GB/T17219. Confirme o certificado sanitário para o seu mercado — nossos engenheiros fornecem o pacote de documentação com o pedido.'
	},
	{
		question: 'Vocês fornecem o pacote completo de válvulas hidráulicas para uma sala de bombas?',
		answer: 'Sim. Fabricamos dispositivos anti-retorno, válvulas redutoras de pressão, válvulas de controle de nível, válvulas de controle por solenoide, preventores de vórtice e filtros em Y, e os enviamos como um pacote coordenado — classes de pressão, selos e laudos de teste correspondentes de uma única fábrica.'
	}
];

const hydraulicProducts = [
	{
		slug: 'anti-pollution-backflow-preventer-hs41x',
		name: 'Dispositivo Anti-Retorno Antipoluição (HS41X-16)',
		img: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		desc: 'Conjunto de dupla retenção com dreno intermediário, DN50–DN600'
	},
	{
		slug: 'adjustable-pressure-reducing-valve-500x',
		name: 'Válvula Redutora de Pressão Hidráulica (500X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'Controle piloto autoperado, regulagem 0,1–1,6 MPa'
	},
	{
		slug: 'hydraulic-water-level-control-valve-f745x',
		name: 'Válvula de Controle de Nível de Água Hidráulica (F745X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'Controle de nível por piloto de flutuador para reservatórios e tanques'
	},
	{
		slug: 'groove-solenoid-control-gate-valve-gkzf1',
		name: 'Válvula de Gaveta de Controle por Solenoide (GKZF-1)',
		img: '/assets/products/groove-solenoid-control-gate-valve-gkzf1.jpg',
		desc: 'Válvula ranurada com piloto DC24V/AC220V, classe 300 PSI'
	},
	{
		slug: 'suction-vortex-preventer-en12845',
		name: 'Preventor de Vórtice de Sucção (EN12845)',
		img: '/assets/02_valves_parts/valves_p21.webp',
		desc: 'SS304/316, elimina cavitação da bomba, profundidade de dreno 100mm'
	}
];

const trustBadges = ['Dupla Retenção + Dreno', 'PN10–PN25', 'Sanitário GB/T17219', 'Pilotos Autoperados'];
---

<Layout
	locale="pt"
	title="Dispositivos Anti-Retorno & Válvulas de Controle Hidráulico - WLFE"
	description="Dispositivos anti-retorno HS41X, redutores 500X, válvulas de nível F745X e solenoides para água potável e redes de incêndio. DN50-DN600, direto da fábrica."
	type="product"
	productData={{
		name: 'Prevenção de Refluxo & Controle Hidráulico',
		image: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		description: 'Dispositivos anti-retorno e válvulas de controle hidráulico para proteção de água potável, gestão de pressão e redes de água automatizadas, fabricados por Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Prevenção de Refluxo' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/pt/" class="hover:text-blue-600">Início</a>
			<span>/</span>
			<a href="/pt/products/" class="hover:text-blue-600">Produtos</a>
			<span>/</span>
			<span class="text-gray-600">Prevenção de Refluxo</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Proteção de Água Potável &amp; Controle Hidráulico</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Dispositivos Anti-Retorno &amp; Válvulas de Controle Hidráulico</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">A Wanlian Fluid fabrica a linha completa de segurança hidráulica — dispositivos anti-retorno antipoluição HS41X, válvulas redutoras de pressão 500X, válvulas de controle de nível F745X e válvulas de controle por solenoide GKZF-1 — protegendo redes de água potável e automatizando o controle de pressão e nível em um único pacote coordenado.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Linha de Válvulas de Segurança Hidráulica</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydraulicProducts.map(p => (
					<a href={`/pt/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Principais Especificações</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Válvula</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Função</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Faixa de tamanhos</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Classe</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">HS41X</td>
							<td class="px-4 py-3 text-gray-700">Prevenção de reflujo antipoluição</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">500X</td>
							<td class="px-4 py-3 text-gray-700">Redução / manutenção de pressão</td>
							<td class="px-4 py-3 text-gray-700">DN20 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">F745X</td>
							<td class="px-4 py-3 text-gray-700">Controle de nível de água</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN400</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">GKZF-1</td>
							<td class="px-4 py-3 text-gray-700">Controle de abertura/fechamento por solenoide</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN300</td>
							<td class="px-4 py-3 text-gray-700">300 PSI, AC220V/DC24V</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Preventor de Vórtice</td>
							<td class="px-4 py-3 text-gray-700">Proteção da sucção da bomba</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN1000</td>
							<td class="px-4 py-3 text-gray-700">EN12845 / GB50974</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplicações</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Controle de conexões cruzadas de água potável (redes de incêndio, irrigação, caldeiras)</li>
				<li>Controle de nível de reservatórios e tanques de cobertura</li>
				<li>Gestão de zonas de pressão em redes municipais e de edifícios</li>
				<li>Redes de água automatizadas com controle remoto de válvulas</li>
				<li>Proteção da sucção de bombas em reservatórios e tanques</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Perguntas Frequentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Precisa de um Pacote de Válvulas Hidráulicas para a Sua Rede?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envie-nos seu DN, classe de pressão e tipo de conexão — nossos engenheiros respondem com curvas de perda de carga, datasheets e cotação do pacote em até 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/pt/contact/?product=Preven%C3%A7%C3%A3o%20de%20Refluxo%20%26%20Controle%20Hidr%C3%A1ulico" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotação</a>
						<a href="https://wa.me/8618684324501?text=Ol%C3%A1%2C%20preciso%20de%20ajuda%20para%20escolher%20v%C3%A1lvulas%20de%20controle%20hidr%C3%A1ulico" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Falar no WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
