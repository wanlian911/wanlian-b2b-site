---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: "Qual é a diferença entre uma válvula de gaveta com vedação por diafragma (bellows) e uma válvula de gaveta padrão?",
		answer: "A válvula de gaveta padrão depende apenas do packing para vedar em torno da haste móvel. A válvula com vedação por diafragma adiciona um diafragma metálico soldado entre a haste e a tampa (bonete), criando uma segunda barreira estanque. Se o diafragma falhar, o packing continua segurando — por isso ela é descrita como um design de vedação dupla com zero vazamento fugitivo."
	},
	{
		question: "Quais meios exigem válvulas de gaveta com vedação por diafragma?",
		answer: "As válvulas com vedação por diafragma são tipicamente especificadas para óleo térmico, vapor e água de alta temperatura, onde o vazamento na haste é um problema de segurança e de eficiência. Também são comumente escolhidas para meios tóxicos, inflamáveis ou perigosos, onde as emissões fugitivas devem ser minimizadas, e para sistemas submetidos a regulamentação ambiental rigorosa."
	},
	{
		question: "Quais tamanhos e classes de pressão estão disponíveis para as válvulas de diafragma Wanlian?",
		answer: "Nossa válvula de gaveta com vedação por diafragma manual flangeada cobre DN15-DN300 (1/2\" a 12\") com pressões de trabalho de 1.6-4.0 MPa (Class 150/300), e faixa de temperatura de trabalho de -29°C a 425°C. Os corpos são de aço forjado (A105) ou fundido (WCB), e o diafragma é de aço inox 304 ou 316Ti."
	},
	{
		question: "As válvulas de gaveta com vedação por diafragma atendem a padrões internacionais?",
		answer: "As válvulas com vedação por diafragma Wanlian são fabricadas conforme os padrões GB, ANSI, DIN e JIS, com classes de pressão expressas tanto em termos métricos (MPa) quanto em Class ANSI. Confirme o padrão dimensional e de pressão exato exigido pelo seu projeto antes de pedir a cotação."
	},
	{
		question: "Como verificar a qualidade da válvula de diafragma antes de encomendar?",
		answer: "Solicite os relatórios de teste de pressão do corpo e do assento do lote real, os certificados de material do corpo e do diafragma, e confirme na cotação o material do diafragma (304/316Ti) e o padrão de solda. A inspeção de terceiros antes do embarque pode ser agendada."
	}
];

const toc = [
	{ id: 'what-is-bellows-gate-valve', label: '1. O que é uma válvula de gaveta com vedação por diafragma (bellows)?' },
	{ id: 'how-bellows-seal-works', label: '2. Como funciona a vedação dupla' },
	{ id: 'where-bellows-valves-are-specified', label: '3. Onde as válvulas com diafragma são especificadas' },
	{ id: 'standards-and-pressure-classes', label: '4. Padrões e classes de pressão' },
	{ id: 'bellows-vs-standard-gate-valve', label: '5. Válvula com diafragma vs válvula de gaveta padrão' },
	{ id: 'specification-checklist', label: '6. Checklist de Especificação B2B' },
	{ id: 'faq', label: 'Perguntas Frequentes' }
];

const products = [
	{ slug: 'flange-manual-bellows-gate-valve', name: 'Válvula de Gaveta Flangeada Manual com Vedação por Diafragma', img: '/assets/products/flange-manual-bellows-gate-valve.webp', desc: 'Aço forjado/fundido, DN15-DN300, Class 150/300' },
	{ slug: 'z85x-stainless-steel-grooved-gate-valve', name: 'Z85X Válvula de Gaveta Ranurada em Aço Inox', img: '/assets/products/z85x-stainless-steel-grooved-gate-valve.webp', desc: 'Válvula de gaveta em ferro fundido 316 (CF8M) para serviços corrosivos' },
	{ slug: 'brass-gate-valve-z15w-16t', name: 'Válvula de Gaveta Forjada em Latão ANSI (Z15W-16T)', img: '/assets/products/brass-gate-valve-z15w-16t.webp', desc: 'Válvula de gaveta roscada NPT para linhas de óleo e água' }
];
---

<Layout
	title="Guia da Válvula de Gaveta com Vedação por Diafragma para Vapor e Óleo"
	description="Guia da válvula de gaveta com vedação por diafragma (bellows) para vapor e óleo térmico: vedação dupla, padrões ANSI, tamanhos e checklist B2B. Fábrica, China."
	type="article"
	locale="pt"
	faq={faq}
	breadcrumbs={[{ name: 'Guias', href: '/pt/blog/' }, { name: 'Guia da Válvula de Gaveta com Vedação por Diafragma' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/pt/" class="hover:text-blue-600">Início</a>
			<span>/</span>
			<a href="/pt/blog/" class="hover:text-blue-600">Guias</a>
			<span>/</span>
			<span class="text-gray-600">Guia da Válvula de Gaveta com Vedação por Diafragma</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Guia de Válvulas Industriais</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Guia da Válvula de Gaveta com Vedação por Diafragma: Tipos Flangeados ANSI para Vapor e Óleo Térmico</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Em resumo: a válvula de gaveta com vedação por diafragma (bellows) é uma válvula de gaveta com um diafragma metálico soldado como segunda barreira de vedação atrás do packing da haste, proporcionando zero vazamento fugitivo na haste. É a válvula a especificar para óleo térmico, vapor e água de alta temperatura — e para qualquer serviço em que o vazamento na haste é inaceitável. Este guia aborda o funcionamento, as aplicações e como especificá-la.</p>

			<TableOfContents headings={toc} />

			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/pt/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 id="what-is-bellows-gate-valve" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. O que é uma válvula de gaveta com vedação por diafragma (bellows)?</h2>
			<p class="text-gray-700 leading-relaxed mb-4">A válvula de gaveta com vedação por diafragma é uma válvula de gaveta de haste ascendente em que a haste fica envolta por um diafragma metálico soldado. O diafragma se expande e se contrai com o curso da haste, vedando-a completamente em relação ao meio — enquanto uma glândula de packing convencional acima dela oferece uma segunda linha de defesa. O resultado é um sistema de vedação dupla: mesmo que o diafragma ceda por fadiga, o packing continua impedindo o vazamento para a atmosfera.</p>
			<p class="text-gray-700 leading-relaxed">É esse design que torna a válvula de gaveta com diafragma a resposta padrão para as <a href="/pt/products/flange-manual-bellows-gate-valve/" class="text-brand-blue font-semibold hover:underline">válvulas de gaveta manuais flangeadas com vedação por diafragma</a> em serviços térmicos exigentes.</p>

			<h2 id="how-bellows-seal-works" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Como funciona a vedação dupla</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Em uma válvula de gaveta padrão, a única barreira entre o meio de processo e a atmosfera é o packing da haste. O packing é um selo por compressão — ele funciona, mas pode se degradar, ressecar ou afrouxar com o tempo, especialmente sob ciclagem térmica. A vedação por diafragma elimina o problema na origem: o diafragma metálico soldado (tipicamente aço inox 304 ou 316Ti) é fixado à haste e à tampa (bonete), de modo que o meio de processo fisicamente não alcança a área do packing.</p>
			<p class="text-gray-700 leading-relaxed mb-4">O packing acima do diafragma continua existindo — ele veda o interior da tampa contra a poeira e oferece reserva caso o diafragma seja danificado. As equipes de manutenção também recebem aviso antecipado: se o diafragma falhar, a válvula começa a pingar no packing, em vez de falhar sem nenhum sinal.</p>
			<p class="text-gray-700 leading-relaxed">Como o diafragma é um componente metálico soldado, seu material, a qualidade da solda e a vida em ciclos são os verdadeiros diferenciais de qualidade entre fornecedores — vale perguntar em toda cotação.</p>

			<h2 id="where-bellows-valves-are-specified" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Onde as válvulas com diafragma são especificadas</h2>
			<p class="text-gray-700 leading-relaxed mb-4">O serviço clássico da válvula de gaveta com vedação por diafragma é <strong>óleo térmico e vapor</strong>. Sistemas de fluido térmico operam em alta temperatura (até 425°C em nossa faixa padrão) e sob ciclagem térmica repetida; uma glândula da haste vazando significa calor perdido, planta suja e risco de segurança. Sistemas de água de alta temperatura apresentam o mesmo problema sob outra forma.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Além dos serviços térmicos, as válvulas com diafragma são especificadas sempre que <strong>as emissões fugitivas devem ser controladas</strong> — meios tóxicos, inflamáveis ou com odor, e plantas sujeitas a regulamentação ambiental. O diafragma soldado atua como barreira eficaz contra emissões fugitivas, especialmente em aplicações com alta dilatação ou contração térmica.</p>
			<p class="text-gray-700 leading-relaxed">Em resumo: se a linha transporta algo quente, perigoso, ou ambos, pergunte se uma válvula de gaveta com vedação por diafragma deve substituir a válvula de gaveta padrão com apenas packing na especificação.</p>

			<h2 id="standards-and-pressure-classes" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Padrões e classes de pressão</h2>
			<p class="text-gray-700 leading-relaxed mb-4">As válvulas com vedação por diafragma são fabricadas nos mesmos referenciais dimensionais e de projeto das demais válvulas de gaveta de aço. As válvulas Wanlian com vedação por diafragma seguem os padrões GB, ANSI, DIN e JIS, e as classes de pressão são expressas tanto em termos métricos (1.6-4.0 MPa) quanto em Class ANSI (Class 150/300).</p>
			<p class="text-gray-700 leading-relaxed mb-4">Para válvulas de gaveta flangeadas de aço em projetos internacionais, as famílias de referência pertinentes são os referenciais ASME/ANSI — a ASME B16.34 rege as classes pressão-temperatura de válvulas flangeadas, e a série API 600/603 cobre o projeto de válvulas de gaveta de aço e de ligas resistentes à corrosão. Quando o projeto exige especificamente desempenho em emissões fugitivas, as válvulas são comumente especificadas contra testes de vazamento como ISO 15848 ou TA-Luft.</p>
			<p class="text-gray-700 leading-relaxed">Confirme sempre qual padrão o seu projeto adota (GB, ANSI ou DIN) antes de comparar cotações — as dimensões face-a-face e a furação das flanges podem diferir.</p>

			<h2 id="bellows-vs-standard-gate-valve" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Válvula com diafragma vs válvula de gaveta padrão</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Comparação</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Válvula de Gaveta Padrão</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Válvula de Gaveta com Vedação por Diafragma</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Vedação da haste</td>
							<td class="px-4 py-3 text-gray-700">Somente packing</td>
							<td class="px-4 py-3 text-gray-700">Diafragma metálico soldado + packing</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Vazamento fugitivo</td>
							<td class="px-4 py-3 text-gray-700">Depende do estado do packing</td>
							<td class="px-4 py-3 text-gray-700">Zero pelo diafragma; packing como reserva</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Resistência à ciclagem térmica</td>
							<td class="px-4 py-3 text-gray-700">O packing pode afrouxar ao longo dos ciclos</td>
							<td class="px-4 py-3 text-gray-700">O diafragma absorve o movimento da haste</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Serviço típico</td>
							<td class="px-4 py-3 text-gray-700">Água, ar, fluidos gerais</td>
							<td class="px-4 py-3 text-gray-700">Vapor, óleo térmico, meios perigosos</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Custo inicial</td>
							<td class="px-4 py-3 text-gray-700">Mais baixo</td>
							<td class="px-4 py-3 text-gray-700">Mais alto — justificado pelo serviço sem vazamento</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Para serviços gerais de água e ar, a válvula de gaveta padrão continua sendo a escolha econômica — veja nosso <a href="/pt/guides/gate-valve-vs-butterfly-valve-fire-protection/" class="text-brand-blue font-semibold hover:underline">guia válvula de gaveta vs válvula borboleta</a> sobre como as válvulas de gaveta se encaixam em redes de incêndio e de água, e o <a href="/pt/tags/industrial-valves/" class="text-brand-blue font-semibold hover:underline">hub de válvulas industriais</a> para a linha ampliada de produtos.</p>

			<h2 id="specification-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Checklist de Especificação B2B</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Defina o meio e a temperatura</strong> — óleo térmico, vapor ou água de alta temperatura: informe a temperatura máxima de trabalho para que o material do diafragma e a classe do corpo possam ser confirmados.</li>
				<li><strong>Fixe a classe de pressão e o padrão</strong> — Class 150/300 (PN16-PN40) com furação de flange GB, ANSI ou DIN; informe qual padrão o projeto adota.</li>
				<li><strong>Especifique o material do corpo e do diafragma</strong> — corpos de aço forjado A105 ou fundido WCB com diafragma de aço inox 304/316Ti são o ponto de partida padrão.</li>
				<li><strong>Pergunte sobre a construção do diafragma</strong> — diafragma soldado, processo de solda e eventuais testes de vida em ciclos realizados pelo fabricante.</li>
				<li><strong>Exija relatórios de teste por lote</strong> — certificados de teste de pressão do corpo e do assento do lote real, além de certificados de material sob solicitação.</li>
				<li><strong>Verifique primeiro o fornecedor</strong> — a qualidade do diafragma não aparece em fotos. Aplique nosso <a href="/pt/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">checklist B2B de compra de válvulas</a> antes de se comprometer com um fabricante.</li>
			</ul>

			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Perguntas Frequentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Precisa de Válvulas de Gaveta com Vedação por Diafragma para uma Linha Térmica ou de Vapor?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Informe-nos o meio, a temperatura, o DN e o padrão de flange — nossos engenheiros confirmam a especificação do diafragma e enviam a cotação em até 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/pt/contact/?product=V%C3%A1lvula%20de%20Gaveta%20com%20Veda%C3%A7%C3%A3o%20por%20Diafragma" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotação</a>
						<a href="https://wa.me/8618684324501?text=Ol%C3%A1%2C%20preciso%20de%20v%C3%A1lvulas%20de%20gaveta%20com%20veda%C3%A7%C3%A3o%20por%20diafragma%20para%20vapor%2F%C3%B3leo%20t%C3%A9rmico" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Conversar no WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
