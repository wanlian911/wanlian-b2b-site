---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'wet-pipe-systems-zsfz', label: '1. Sistemas Molhados: a Válvula de Alarme ZSFZ' },
	{ id: 'deluge-systems-zsfm', label: '2. Sistemas de Dilúvio: a Válvula ZSFM' },
	{ id: 'pre-action-systems-zsfy', label: '3. Sistemas de Pré-ação: a Válvula ZSFY de Duplo Acionamento' },
	{ id: 'zone-detection-zsjz', label: '4. Detecção de Zona: o Indicador de Vazão ZSJZ' },
	{ id: 'selecting-the-right-valve', label: '5. Escolhendo a Válvula Certa para Seu Projeto' },
	{ id: 'faq', label: 'Perguntas Frequentes' }
];

const faq = [
	{
		question: 'Qual é a diferença entre uma válvula de alarme do tipo molhado e uma válvula de dilúvio?',
		answer: 'Uma válvula de alarme do tipo molhado (ZSFZ) é instalada em sistemas de rociadores molhados, onde a tubulação fica sempre cheia de água; ela detecta a vazão causada pela abertura de uma cabeça de rociador e aciona o alarme. Uma válvula de dilúvio (ZSFM) é uma válvula de controle do tipo seco, usada em sistemas de dilúvio que abrem e inundam toda a área protegida com água simultaneamente — tipicamente para ocupações de alto risco, como plantas químicas e usinas elétricas.'
	},
	{
		question: 'Quando um sistema de pré-ação (ZSFY) deve ser usado?',
		answer: 'Os sistemas de pré-ação (ZSFY) combinam uma válvula do tipo dilúvio com rociadores automáticos e exigem dois acionamentos independentes (p. ex., detecção de fumaça mais calor) antes que a água entre na tubulação. São especificados para ambientes sensíveis à água, como museus, arquivos, centros de dados e câmaras frigoríficas, onde o acionamento acidental deve ser evitado.'
	},
	{
		question: 'O que um indicador de vazão de água (ZSJZ) faz em um sistema de rociadores?',
		answer: 'Um indicador de vazão de água com pala (ZSJZ) é instalado nas linhas de distribuição dos rociadores e detecta a vazão causada pela abertura de uma cabeça de rociador, enviando um sinal ao painel de alarme de incêndio para identificar a zona acionada. Possui um atraso temporal ajustável para filtrar picos de pressão transitórios.'
	},
	{
		question: 'As válvulas ZSFZ, ZSFM e ZSFY são intercambiáveis?',
		answer: 'Não. Cada tipo de válvula corresponde a uma arquitetura de sistema específica: ZSFZ para sistemas molhados, ZSFM para sistemas de dilúvio e ZSFY para sistemas de pré-ação. Substituir uma pela outra quebra a lógica do sistema e pode não passar na inspeção normativa. Selecione de acordo com a classe de perigo da ocupação e a base do projeto.'
	},
	{
		question: 'Quais certificações são exigidas para válvulas de alarme de rociadores?',
		answer: 'Os conjuntos de válvulas de alarme de rociadores devem ser homologados pelo organismo de certificação aplicável ao seu mercado — comumente UL/FM para a América do Norte, CE para a Europa, LPCB para projetos do Reino Unido/Commonwealth, além de ISO 9001 como base de qualidade. A Wanlian fornece conjuntos ZSFZ/ZSFM/ZSFY com pacotes de certificação adaptados ao mercado de destino.'
	}
];

const valveProducts = [
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Válvula de Retenção de Alarme, Tipo Molhado (ZSFZ-150)',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'Válvula de alarme para sistema molhado com detecção de vazão e acionamento do alarme'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Grupo de Válvulas de Dilúvio e Alarme (Série ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Válvula de dilúvio acionada por diafragma para ocupações de alto risco'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Sistema de Dilúvio de Pré-ação com Alarme (Série ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Válvula de pré-ação de duplo acionamento redundante para zonas sensíveis à água'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Indicador de Vazão de Água com Pala (Série ZSJZ)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'Detecção de vazão por zona com atraso ajustável para sistemas molhados'
	}
];
---

<Layout
	title="Válvulas para Sistemas de Rociadores: Molhado, Dilúvio e Pré-ação"
	description="Guia de válvulas para sistemas de rociadores: ZSFZ, ZSFM, ZSFY e ZSJZ — funcionamento, quando especificar e cotação direta da fábrica Quanzhou Wanlian Fluid."
	type="article"
	locale="pt"
	faq={faq}
	breadcrumbs={[{ name: 'Guias', href: '/pt/blog/' }, { name: 'Válvulas de Rociadores' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/pt/" class="hover:text-blue-600">Início</a>
			<span>/</span>
			<a href="/pt/blog/" class="hover:text-blue-600">Guias</a>
			<span>/</span>
			<span class="text-gray-600">Válvulas de Rociadores</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Guia de Sistemas de Rociadores</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Válvulas para Sistemas de Rociadores Contra Incêndio: Guia Completo (Molhado, Dilúvio e Pré-ação)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Cada sistema de rociadores é construído em torno de um conjunto de válvulas de controle — o ponto em que o abastecimento de água se torna o sistema de supressão de incêndio. Se a válvula for especificada incorretamente, a lógica de todo o sistema não passa na inspeção. Este guia explica os quatro tipos de válvulas que dominam o design moderno de sistemas de rociadores contra incêndio, a função de cada uma e os tipos de ocupação que protegem. Para as válvulas de isolamento e de controle de seção ao redor do conjunto — válvula de gaveta OS&Y, válvula borboleta de sinal e válvulas de retenção — leia nosso <a href="/pt/guides/fire-sprinkler-control-valve-types/" class="text-brand-blue font-semibold hover:underline">guia de tipos de válvulas de controle de rociadores</a>.</p>

			<div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
				{valveProducts.map(p => (
					<a href={`/pt/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="wet-pipe-systems-zsfz" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Sistemas Molhados: a Válvula de Alarme ZSFZ</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Os sistemas molhados são a configuração mais comum de rociadores: a tubulação permanece permanentemente cheia de água e cada cabeça de rociador abre individualmente quando seu elemento sensível ao calor estoura. A <a href="/pt/products/wet-alarm-check-valve-zsfz-150/" class="text-brand-blue font-semibold hover:underline">válvula de retenção de alarme ZSFZ do tipo molhado</a> fica posicionada na coluna montante do sistema e cumpre duas funções: impede o refluxo da água do sistema de volta para o abastecimento e detecta a vazão criada quando uma cabeça abre, acionando os alarmes mecânicos e elétricos. A vazão continua para dentro do sistema até que o abastecimento seja fechado manualmente.</p>
			<p class="text-gray-700 leading-relaxed">Os sistemas molhados são rápidos, simples e baratos de manter — mas não podem ser usados onde a temperatura ambiente arrisca congelar a tubulação.</p>

			<h2 id="deluge-systems-zsfm" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Sistemas de Dilúvio: a Válvula ZSFM</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Os sistemas de dilúvio protegem ocupações de alto risco, em que o fogo pode se propagar mais rápido do que as cabeças de rociador individuais conseguem responder: plantas químicas, oficinas de pintura, usinas elétricas, hangares de aeronaves. Todos os bocais de uma zona de dilúvio ficam abertos e o sistema é retido por uma única válvula de controle — a <a href="/pt/products/deluge-alarm-valve-zsfm/" class="text-brand-blue font-semibold hover:underline">válvula de dilúvio e alarme ZSFM</a>. Quando o sistema de detecção (fuma/calor/chama) sinaliza um incêndio, a válvula abre e a água atinge todos os bocais simultaneamente.</p>
			<p class="text-gray-700 leading-relaxed">A ZSFM acionada por diafragma abre rapidamente e resela de forma confiável após a operação, o que é importante porque as zonas de dilúvio costumam ser grandes e a válvula é o único ponto de falha do sistema.</p>

			<h2 id="pre-action-systems-zsfy" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Sistemas de Pré-ação: a Válvula ZSFY de Duplo Acionamento</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Os sistemas de pré-ação são o hardware de dilúvio com um detalhe na tubulação de rociadores: a tubulação fica seca e a água só entra <em>após dois acionamentos independentes confirmarem um incêndio</em>. O <a href="/pt/products/pre-action-alarm-system-zsfy/" class="text-brand-blue font-semibold hover:underline">sistema de alarme de pré-ação ZSFY</a> é o conjunto de controle dessa arquitetura — uma válvula do tipo dilúvio operada por sinal de detecção de incêndio, com rociadores automáticos a jusante que também atuam como fusíveis individuais.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Por que especificar pré-ação? Três razões dominam:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Conteúdo sensível à água</strong> — museus, arquivos, centros de dados, salas de transformadores: nenhuma água entra sem dois sinais de confirmação.</li>
				<li><strong>Ambientes com risco de congelamento</strong> — câmaras frigoríficas, galpões sem aquecimento: tubulação seca não congela.</li>
				<li><strong>Seguro contra acionamentos falsos</strong> — a lógica de duplo acionamento torna o acionamento acidental estatisticamente desprezível.</li>
			</ul>

			<h2 id="zone-detection-zsjz" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Detecção de Zona: o Indicador de Vazão ZSJZ</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Uma vez que o sistema está operando, o corpo de bombeiros e o gestor do prédio precisam saber <em>qual zona</em> está com vazão. O <a href="/pt/products/water-flow-indicator-zsjz/" class="text-brand-blue font-semibold hover:underline">indicador de vazão de água com pala ZSJZ</a> é instalado nas linhas de distribuição dos rociadores: quando a água se move, a pala desvia e o contato envia um sinal ao painel de alarme identificando a zona afetada. Um atraso temporal ajustável filtra os picos de pressão que causariam alarmes indevidos.</p>

			<h2 id="selecting-the-right-valve" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Escolhendo a Válvula Certa para Seu Projeto</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Ocupação / Necessidade</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Tipo de sistema</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Válvula de controle</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Escritórios, comércio, galpões (aquecidos)</td>
							<td class="px-4 py-3 text-gray-700">Molhado</td>
							<td class="px-4 py-3 text-gray-700">Válvula de alarme ZSFZ (molhado)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Química, energia, aviação, alto risco</td>
							<td class="px-4 py-3 text-gray-700">Dilúvio</td>
							<td class="px-4 py-3 text-gray-700">Válvula de dilúvio ZSFM</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Museus, centros de dados, câmaras frigoríficas</td>
							<td class="px-4 py-3 text-gray-700">Pré-ação</td>
							<td class="px-4 py-3 text-gray-700">Sistema de pré-ação ZSFY</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Identificação de zona (todos os sistemas molhados)</td>
							<td class="px-4 py-3 text-gray-700">—</td>
							<td class="px-4 py-3 text-gray-700">Indicador de vazão ZSJZ</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Um conjunto completo geralmente combina a válvula de alarme com uma válvula de gaveta de sinal à montante, uma válvula de retenção, manômetros e os acessórios de alarme. Quando você nos envia a classe de perigo e o diâmetro da tubulação, cotamos o conjunto completo de válvulas em vez de uma válvula isolada — um pacote certificado, um único conjunto de documentos.</p>

			<!-- Related guide -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Guia Relacionado: Tipos de Sistema e Cabeças de Rociador</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Escolhendo entre sistemas molhado, seco e de pré-ação, ou selecionando cabeças de rociador por fator K e temperatura? Leia o <a href="/pt/guides/fire-sprinkler-system-wet-dry-preaction/" class="text-brand-blue font-semibold hover:underline">Guia de Sistemas de Rociadores</a>.</p>
			</div>

			<!-- FAQ Section -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Perguntas Frequentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Precisa de uma Cotação para um Conjunto de Válvulas de Rociadores?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envie-nos o tipo de sistema, a classe de perigo e o diâmetro da tubulação — respondemos com a especificação completa do conjunto de válvulas e o preço de fábrica em até 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/pt/contact/?product=Conjunto%20de%20V%C3%A1lvulas%20de%20Rociadores" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotação</a>
						<a href="https://wa.me/8618684324501?text=Ol%C3%A1%2C%20preciso%20de%20uma%20cota%C3%A7%C3%A3o%20para%20um%20conjunto%20de%20v%C3%A1lvulas%20de%20rociadores" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Conversar no WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
