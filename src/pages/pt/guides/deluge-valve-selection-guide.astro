---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'Qual é a principal diferença entre uma válvula de dilúvio e uma válvula de pré-ação?',
		answer: 'Um sistema de dilúvio usa sprinklers ou bicos abertos, portanto a abertura da válvula de dilúvio envia água a todos os pontos de descarga simultaneamente. Um sistema de pré-ação normalmente possui sprinklers fechados e usa a detecção para abrir uma válvula de controle antes que um sprinkler libere água. O dilúvio é selecionado para cobertura rápida e simultânea; a pré-ação é escolhida quando uma descarga acidental de água deve ser limitada. Confirme o intertravamento e a sequência conforme a edição vigente.'
	},
	{
		question: 'A válvula de dilúvio deve usar acionamento elétrico ou hidráulico?',
		answer: 'Escolha o método de acionamento a partir do projeto de detecção, dos requisitos da área de risco, da energia disponível e da sequência fail-safe exigida. O acionamento elétrico é prático quando o painel de alarme de incêndio e o circuito supervisionado do solenoide já estão especificados. O acionamento hidráulico ou pneumático pode ser adequado quando o local dispõe de uma linha de pressão dedicada ou quando se prefere um detector pneumático. A Wanlian fornece o grupo de válvula e acessórios compatíveis; a sequência do painel de controle de detecção deve ser confirmada pelo projetista do sistema.'
	},
	{
		question: 'Como proteger um sistema de dilúvio em clima frio?',
		answer: 'Mantenha o conjunto da válvula de dilúvio e o trim em um espaço aquecido e acessível sempre que possível, evitando deixar tubulações expostas cheias de água onde possa haver congelamento. Preveja coleta e drenagem de condensado para o trim de detecção, isole as seções vulneráveis e use uma configuração seca ou pneumática aprovada quando o projeto exigir. Não substitua o fluido anticongelante nem altere o trim sem a aprovação da autoridade competente. Confirme o método de proteção contra congelamento conforme a edição vigente.'
	},
	{
		question: 'Como proteger a linha de detecção contra acionamentos acidentais?',
		answer: 'Separe a linha de detecção dos controles de serviço comuns, supervisione sua pressão ou o status do circuito, proteja os dispositivos expostos contra impactos e use a sequência do painel de acionamento exigida para o risco. O acionamento manual deve ser protegido, mas acessível, enquanto as conexões de ensaio devem estar claramente identificadas e ser restauradas após o teste. A detecção hidráulica, pneumática e elétrica exige sua própria supervisão de alarme e falha. A matriz final de causa e efeito deve ser aprovada antes do comissionamento.'
	},
	{
		question: 'Quais informações devem constar em uma RFQ de válvula de dilúvio?',
		answer: 'Envie a descrição do risco, a área protegida, a vazão e a pressão de projeto, o diâmetro nominal e a conexão das extremidades da válvula, o layout de bicos abertos ou monitores, o método de detecção, a sequência de acionamento exigida, a temperatura ambiente, a configuração de drenagem e a edição do código aplicável. Solicite também desenhos do trim, dados de materiais, registros de ensaio de pressão, informações de peças sobressalentes e instruções de operação. Se for necessária uma listagem ou aprovação, declare isso explicitamente e peça ao fornecedor que confirme a documentação vigente.'
	},
	{
		question: 'A Wanlian fornece o painel de controle de detecção do sistema de dilúvio?',
		answer: 'A Wanlian fornece grupos de válvulas de dilúvio e válvulas e acessórios de monitoramento associados, incluindo o conjunto ZSFM e componentes de isolamento ou controle adequados. Não apresentamos um painel de controle de detecção como parte do pacote padrão de válvulas quando ele não é fornecido. O painel de acionamento, os detectores e a programação de causa e efeito devem ser especificados com o contratado de alarme de incêndio ou de detecção especializada e depois conferidos com o trim da válvula e a sequência do local.'
	}
];

const toc = [
	{ id: 'when-deluge', label: '1. Quando um sistema precisa de proteção por dilúvio' },
	{ id: 'how-it-works', label: '2. Como funciona o grupo de válvula de dilúvio ZSFM' },
	{ id: 'actuation', label: '3. Escolhendo o método de acionamento' },
	{ id: 'sizing', label: '4. Dimensionando a válvula para vazão e tempo de disparo' },
	{ id: 'discharge', label: '5. Sprinklers abertos, monitores e layout de descarga' },
	{ id: 'testing', label: '6. Comissionamento e ensaios periódicos' },
	{ id: 'rfq-checklist', label: '7. Checklist de RFQ para válvula de dilúvio' },
	{ id: 'faq', label: 'Perguntas Frequentes' }
];

const products = [
	{ slug: 'deluge-alarm-valve-zsfm', name: 'Grupo de Válvula de Alarme de Dilúvio (Série ZSFM)', img: '/assets/products/deluge-alarm-valve-zsfm.webp', desc: 'Grupo de válvula de dilúvio de fundo molhado para sistemas de bicos abertos e monitores' },
	{ slug: 'pre-action-alarm-system-zsfy', name: 'Sistema de Alarme de Pré-ação (Série ZSFY)', img: '/assets/products/pre-action-alarm-system-zsfy.jpg', desc: 'Conjuntos de pré-ação com intertravamento simples e duplo' },
	{ slug: 'manual-fire-water-cannon-ps', name: 'Monitor Manual de Água para Incêndio (Série PS)', img: '/assets/products/manual-fire-water-cannon-ps.webp', desc: 'Monitor fixo para serviço de descarga de dilúvio e monitores' },
	{ slug: 'ul-fm-resilient-seat-osy-gate-valve', name: 'Válvula de Gaveta OS&amp;Y com Sede Resiliente UL/FM', img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp', desc: '2"–10", extremidades ranhuradas, haste ascendente, listada UL/FM' }
