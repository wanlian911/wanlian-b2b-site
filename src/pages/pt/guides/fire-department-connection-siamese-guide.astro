// 关联产品(slug 与 products.ts 一致)
const products = [
	{ slug: 'sqd100-1-6-fire-pump-adapter', name: 'Adaptador de Bomba Contra Incêndio SQD100-1.6 (Siamesa)', img: '/assets/products/sqd100-1-6-fire-pump-adapter.webp', desc: '2 entradas DN65, saída flangeada DN100, 1,6 MPa' },
	{ slug: 'storz-coupling-2-5inch-aluminum', name: 'Acoplamento Storz 2,5\" (Norma Alemã)', img: '/assets/products/storz-coupling-2-5inch-aluminum.webp', desc: 'DN50-DN150, 1,6 MPa, alumínio autovedante' },
	{ slug: 'fire-hydrant-hose-coupling-adapter-hs', name: 'Adaptador de Acoplamento HS', img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg', desc: 'DN50/DN65, GB12514, alumínio anodizado' },
	{ slug: 'indoor-fire-hydrant-head-sn65', name: 'Boca de Hidrante Interno (SN65)', img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg', desc: 'Boca de hidrante interno DN65 para saídas do montante' }
