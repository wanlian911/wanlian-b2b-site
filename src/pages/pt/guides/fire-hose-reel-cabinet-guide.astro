---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'Qual é a diferença entre um carrete de mangueira e um armário contra incêndio?',
		answer: 'Um carrete de mangueira (como o JPS0.8-19) é uma unidade de supressão semi-automática permanentemente conectada: um carrete com mangueira retilínea que retira água diretamente do abastecimento do edifício. O armário contra incêndio é a estrutura que abriga o carrete, a válvula do hidrante, a mangueira e o bocal — ou, no caso de um armário de espuma (PSG30), uma unidade autônoma de dosagem de espuma. Muitos projetos especificam um armário de hidrante contendo tanto a válvula SN65 quanto um carrete de mangueira.'
	},
	{
		question: 'Que comprimento e diâmetro de mangueira devo especificar?',
		answer: 'Carretes para interior são tipicamente fornecidos com 20 m, 25 m ou 30 m de mangueira retilínea de 19 mm (3/4"). O comprimento necessário é definido pelo raio de cobertura da estação do carrete — as normas de edificação normalmente exigem que todos os pontos da área estejam ao alcance do carrete (ex.: dentro de 6 m do alcance do bocal). Confirme a norma vigente (NFPA 14, EN 671, GB 15090 / XF180) para o seu mercado.'
	},
	{
		question: 'Quando devo escolher um armário de espuma contra incêndio em vez de um carrete de água?',
		answer: 'As unidades de espuma (PSG30 com 3% AFFF) são especificadas onde se esperam incêndios de líquidos inflamáveis de classe B: armazenamento de combustíveis, plantas químicas, oficinas de pintura, salas de transformadores e pátios de veículos. A água é ineficaz contra líquidos em combustão; a espuma de baixa expansão cobre a superfície e abafa o fogo. Para ocupação comercial geral com apenas cargas de incêndio da classe A, um carrete de mangueira de água padrão é suficiente e mais barato.'
	},
	{
		question: 'Que pressão um carrete de mangueira precisa para operar?',
		answer: 'O carrete JPS0.8-19 opera a 0,8–1,0 MPa com alcance de jato de pelo menos 6 metros. O abastecimento do edifício ou a bomba contra incêndio deve entregar essa pressão na entrada do carrete durante a demanda. Se o abastecimento for marginal, adicione uma bomba de pressurização ou confirme a pressão do bocal com o cálculo hidráulico — um carrete que não alcança 6 m não está em conformidade com a norma.'
	},
	{
		question: 'Carretes e armários estão disponíveis em configurações compatíveis com exportação?',
		answer: 'Sim. A Wanlian fabrica carretes com mangueiras de 20/25/30 m, bocais de latão ou liga, suportes de parede rotativos e armários com interfaces compatíveis de válvula de hidrante (acoplamentos SN65 ou BS336 por meio dos adaptadores da série HS). Especifique a norma do seu mercado e nós adaptaremos a conexão e o pacote de documentação.'
	}
];

const products = [
	{ slug: 'fire-hose-reel-jpso8-19', name: 'Conjunto de Carrete de Mangueira JPS0.8-19', img: '/assets/products/fire-hose-reel-jpso8-19.jpg', desc: 'Carrete de aço carbono, mangueira PVC 20-30m, bocal de latão' },
	{ slug: 'foam-fire-hydrant-cabinet-psg30', name: 'Armário de Espuma Contra Incêndio PSG30', img: '/assets/06_extinguishing_cannons/cannon_p42.webp', desc: 'Unidade 3% AFFF consolidada para incêndios de classe B' },
	{ slug: 'indoor-fire-hydrant-head-sn65', name: 'Boca de Incêndio Interna SN65', img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg', desc: 'Válvula de hidrante em ferro fundido dúctil PN16 para armários' },
	{ slug: 'fire-hydrant-hose-coupling-adapter-hs', name: 'Adaptador de Acoplamento de Mangueira HS', img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg', desc: 'Acoplamentos de alumínio para conexões hidrante-mangueira-bocal' }
];

const toc = [
	{ id: 'role', label: 'O Papel dos Carretes de Mangueira e Armários' },
	{ id: 'reel-vs-cabinet', label: 'Carrete de Mangueira vs Armário Contra Incêndio: Definições' },
	{ id: 'hose-specs', label: 'Comprimento, Diâmetro e Pressão da Mangueira' },
	{ id: 'nozzle', label: 'Tipos de Bocais e Modos de Jato' },
	{ id: 'foam', label: 'Armários de Espuma para Incêndios de Classe B' },
	{ id: 'materials', label: 'Materiais e Resistência à Corrosão' },
	{ id: 'compliance', label: 'Normas, Testes e Notas de Exportação' },
	{ id: 'faq', label: 'Perguntas Frequentes' }
];
---

<Layout
	title="Guia de Carretes & Armários Contra Incêndio (JPS0.8-19, PSG30 & SN65)"
	description="Como especificar carretes de mangueira e armários contra incêndio: comprimento, modos de bocal, espuma para classe B e normas. Preço de fábrica Wanlian, China."
	type="article"
	locale="pt"
	faq={faq}
	breadcrumbs={[{ name: 'Guias', href: '/pt/blog/' }, { name: 'Guia de Carretes & Armários' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/pt/" class="hover:text-blue-600">Início</a>
			<span>/</span>
			<a href="/pt/blog/" class="hover:text-blue-600">Guias</a>
			<span>/</span>
			<span class="text-gray-600">Carretes de Mangueira &amp; Armários</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Guia de Equipamentos de Proteção Contra Incêndio</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Guia de Seleção de Carretes de Mangueira e Armários Contra Incêndio</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Carretes de mangueira e armários contra incêndio são o equipamento que o ocupante do edifício realmente usa nos primeiros minutos de um incêndio — antes da chegada do Corpo de Bombeiros. Eles devem ser simples o suficiente para funcionários sem treinamento, robustos o suficiente para anos em espera e especificados para entregar o jato necessário à pressão necessária. Este guia detalha as especificações da mangueira, os modos do bocal, as opções de espuma, os materiais e as normas que os regem.</p>

			<TableOfContents headings={toc} />

			<!-- Product strip -->
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/pt/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 id="role" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. O Papel dos Carretes de Mangueira e Armários</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Um carrete de mangueira dá ao ocupante sem treinamento uma capacidade fixa de supressão com água: abra a válvula, puxe a mangueira e um jato fica imediatamente disponível. É a primeira linha de defesa para incêndios incipientes em edifícios comerciais, de hospitalidade, de escritórios e industriais, complementando os rociadores automáticos, que assumem a supressão durante a evacuação. Os armários contra incêndio organizam o equipamento — válvula do hidrante, mangueira, carrete, bocal — em uma unidade previsível e acessível na qual inspetores e usuários podem confiar.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Para compras B2B, as perguntas práticas são: qual cobertura a norma exige, qual pressão de abastecimento está disponível e quais classes de incêndio existem no local. Essas três respostas definem a especificação abaixo.</p>

			<h2 id="reel-vs-cabinet" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Carrete de Mangueira vs Armário Contra Incêndio: Definições</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Unidade</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Conteúdo</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Uso típico</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Conjunto de carrete (JPS0.8-19)</td>
							<td class="px-4 py-3 text-gray-700">Suporte giratório, tambor, mangueira retilínea, bocal</td>
							<td class="px-4 py-3 text-gray-700">Estações autônomas, com abastecimento de água conectado</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Armário de hidrante</td>
							<td class="px-4 py-3 text-gray-700">Válvula SN65 + carrete/mangueira + bocal em uma estrutura</td>
							<td class="px-4 py-3 text-gray-700">Estações internas padrão de combate a incêndio</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Armário de espuma (PSG30)</td>
							<td class="px-4 py-3 text-gray-700">Tanque de espuma + dosador + carrete de mangueira + bocal de espuma</td>
							<td class="px-4 py-3 text-gray-700">Áreas com incêndios líquidos de classe B</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">O <a href="/pt/products/fire-hose-reel-jpso8-19/" class="text-brand-blue font-semibold hover:underline">conjunto de carrete JPS0.8-19</a> é o componente central; a <a href="/pt/products/indoor-fire-hydrant-head-sn65/" class="text-brand-blue font-semibold hover:underline">boca de incêndio interna SN65</a> é a interface de válvula que a abastece a partir da coluna montante, e os <a href="/pt/products/fire-hydrant-hose-coupling-adapter-hs/" class="text-brand-blue font-semibold hover:underline">adaptadores de acoplamento HS</a> padronizam as conexões de mangueira ao hidrante e de mangueira ao bocal.</p>

			<h2 id="hose-specs" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Comprimento, Diâmetro e Pressão da Mangueira</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Três números definem um carrete: comprimento da mangueira, diâmetro interno e pressão de trabalho.</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Comprimento (20 / 25 / 30 m).</strong> Determinado pelo raio de cobertura. Normas como a EN 671-1 exigem que todos os pontos da área protegida estejam ao alcance do carrete, geralmente definido como o comprimento da mangueira mais o alcance nominal do bocal. Mangueiras mais longas aumentam a perda de carga, portanto o cálculo de pressão deve seguir o comprimento.</li>
				<li><strong>Diâmetro (19 mm / 3/4").</strong> O diâmetro padrão dos carretes internos. Diâmetros maiores entregam mais vazão, porém uma mangueira mais pesada e difícil de puxar; 19 mm equilibra alcance e facilidade de uso para incêndios incipientes de classe A.</li>
				<li><strong>Pressão (0,8–1,0 MPa).</strong> O JPS0.8-19 opera a 0,8–1,0 MPa com alcance de jato de pelo menos 6 m. Confirme a pressão da coluna montante ou do abastecimento na entrada do carrete sob demanda simultânea — uma falha comum é especificar um carrete em que o cálculo hidráulico nunca foi feito.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Para projetos de exportação, especifique a norma da mangueira (EN 694 para a Europa, NFPA 1962 para a América do Norte, GB 15090 / XF180 para certificação baseada na China) para que o pacote de documentação corresponda ao seu mercado.</p>

			<h2 id="nozzle" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Tipos de Bocais e Modos de Jato</h2>
			<p class="text-gray-700 leading-relaxed mb-4">O bocal é a interface com o usuário — ele decide se o ocupante consegue combater o fogo ou não. Os bocais de carrete suportam dois modos:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Jato reto.</strong> Alcance máximo para atacar o fogo à distância. O alcance mínimo exigido é tipicamente de 6 m na pressão nominal.</li>
				<li><strong>Neblina/jato em leque.</strong> Um cone largo para proteger o operador, resfriar a área e molhar as superfícies. O modo neblina consome mais fluxo e é menos eficiente à distância; o operador muda de modo conforme a situação.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed mb-4">O material importa: bocais de latão resistem à corrosão e mantêm a geometria; bocais de liga fundida são mais leves, mas especifique acabamentos anodizados para ambientes úmidos ou litorâneos. O JPS0.8-19 é fornecido com um bocal de neblina de latão/liga que suporta ambos os modos, com alavanca de fechamento para interromper o fluxo no próprio bocal.</p>

			<h2 id="foam" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Armários de Espuma para Incêndios de Classe B</h2>
			<p class="text-gray-700 leading-relaxed mb-4">A água não consegue apagar um líquido em combustão: ela espalha o fogo. Onde existem riscos de classe B — armazenamento de combustíveis, áreas de processo químico, salas de transformadores, depósitos de tinta e solventes, pátios de veículos — a norma exige espuma. O <a href="/pt/products/foam-fire-hydrant-cabinet-psg30/" class="text-brand-blue font-semibold hover:underline">armário de espuma contra incêndio PSG30</a> consolida todo o sistema em uma única unidade de parede: um tanque de concentrado de espuma, um dosador 3% AFFF, um carrete de mangueira e um bocal de espuma.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Quando o carrete é aberto, o dosador induz concentrado de espuma no jato de água a 3%, gerando espuma de baixa expansão com razão de expansão de pelo menos 4,5:1 e alcance de jato de 6 metros ou mais. A espuma de baixa expansão cobre a superfície do líquido em combustão, cortando o oxigênio e os vapores — eficaz contra incêndios de combustíveis, produtos químicos e solventes.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Notas de especificação para armários de espuma:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Tipo de espuma.</strong> A AFFF (espuma aquosa formadora de filme) é o padrão para riscos de hidrocarbonetos mistos; confirme a classe do concentrado (AR-AFFF para solventes polares) com o consultor de incêndio.</li>
				<li><strong>Capacidade.</strong> Dimensione o volume do tanque conforme a duração esperada da descarga — verifique na norma local o tempo mínimo de operação na vazão nominal.</li>
				<li><strong>Pressão na entrada.</strong> O PSG30 opera a 0,5–0,8 MPa; o abastecimento deve mantê-la durante a descarga.</li>
			</ul>

			<h2 id="materials" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Materiais e Resistência à Corrosão</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Equipamento em espera fica anos em corredores úmidos, salas de caldeiras e plantas litorâneas. A seleção de materiais é uma decisão de custo do ciclo de vida:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Tambor e suporte do carrete.</strong> Aço carbono laminado a frio com revestimento anticorrosivo em pó vermelho (JPS0.8-19) — econômico e padrão de norma; especifique aço inox para ambientes marinhos ou químicos.</li>
				<li><strong>Mangueira.</strong> Misturas NBR/PVC com reforço em poliéster trançado múltiplo resistem a vincos e abrasão; confirme a estabilidade UV se o carrete ficar exposto ao sol direto.</li>
				<li><strong>Bocal e dosador.</strong> Latão para resistência à corrosão e dosagem precisa; o dosador PSG30 é de latão maciço com corpo resistente à corrosão.</li>
				<li><strong>Estrutura do armário.</strong> Aço com revestimento em pó é o padrão; frentes de vidro ou aço inox são usadas em halls de entrada com requintes arquitetônicos. Especifique sempre um acesso por vidro quebra ou por chave, de acordo com a preferência do Corpo de Bombeiros local.</li>
			</ul>

			<h2 id="compliance" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">7. Normas, Testes e Notas de Exportação</h2>
			<p class="text-gray-700 leading-relaxed mb-4">A conformidade de carretes e armários é tipicamente verificada por: teste de pressão do conjunto, teste de alcance de jato e vazão na pressão nominal, e inspeção de materiais/revestimentos. As normas relevantes incluem EN 671 (Europa), NFPA 14 (América do Norte, colunas montantes e sistemas de mangueiras), GB 15090 e XF180 (China), além da BS 5306 para a prática do Reino Unido.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Checklist de exportação:</p>
			<ol class="list-decimal pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Confirme a norma de acoplamento de mangueira do seu mercado — os adaptadores da série HS cobrem os acoplamentos internacionais comuns (BS336, NIST, KWS) e podem ser enviados com o pedido.</li>
				<li>Solicite o laudo de teste de pressão por lote dos carretes e armários.</li>
				<li>Verifique se o tipo de acesso da porta do armário e a sinalização atendem às expectativas do Corpo de Bombeiros local.</li>
				<li>Para unidades de espuma, confirme o tipo de concentrado e o tratamento do prazo de validade — o concentrado AFFF tem vida útil e deve ser substituído conforme o cronograma.</li>
				<li>Defina as peças de reposição (bocais, mangueira, vedações, torneiras de teste) e o prazo de entrega antes de pedir.</li>
			</ol>
			<p class="text-gray-700 leading-relaxed">A Wanlian testa cada carrete e armário antes do embarque e fornece o pacote de documentação — laudos de teste de pressão, certificados de material e instruções de operação — junto com o contêiner.</p>

			<!-- FAQ Section -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Perguntas Frequentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Precisa de Carretes ou Armários para Seu Projeto?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envie-nos a área de cobertura, a pressão de abastecimento e as classes de incêndio — nossos engenheiros respondem com uma recomendação de layout do carrete/armário e uma cotação em até 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/pt/contact/?product=Sele%C3%A7%C3%A3o%20de%20Carretes%20%26%20Arm%C3%A1rios" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotação</a>
						<a href="https://wa.me/8618684324501?text=Ol%C3%A1%2C%20preciso%20de%20ajuda%20para%20selecionar%20carretes%20de%20mangueira%20e%20arm%C3%A1rios%20contra%20inc%C3%AEndio" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Conversar no WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
