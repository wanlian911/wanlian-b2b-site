---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'Quais classes de fogo um extintor de pó químico ABC pode combater?',
		answer: 'Um extintor de pó químico ABC cobre os fogos das classes A (madeira, papel, têxteis), B (líquidos inflamáveis), C (gases inflamáveis) e E (elétricos), por isso é a unidade portátil padrão para prédios comerciais e industriais. Não é a escolha certa para fogos de óleo de cozinha da classe F (usar químico úmido) nem para fogos de metal da classe D (usar pó metálico especializado).'
	},
	{
		question: 'O que significa a certificação ISO 7165 em um extintor?',
		answer: 'A ISO 7165 é a norma internacional para extintores portáteis, cobrindo desempenho, construção, marcação e ensaios. Nosso modelo de pó químico ABC de 5kg é fabricado conforme a ISO 7165 e também possui o CCCF. Observe que o CCCF é a Certificação Obrigatória da China para produtos de incêndio — ela qualifica a unidade para o mercado chinês, mas por si só não é um certificado de exportação. Para exportação, solicite o certificado para o modelo exato e o mercado de destino.'
	},
	{
		question: 'Quais tamanhos de extintores de pó químico ABC estão disponíveis?',
		answer: 'O extintor de pó químico ABC da Wanlian está disponível em pesos líquidos de agente de 3kg, 4kg e 5kg, com tempo de descarga de aproximadamente 8 a 15 segundos e manômetro com código de cores no cilindro de aço carbono. A unidade de 5kg é a especificação comum para escritórios, armazéns e instalações comerciais; confirme sua classe de risco e a área de cobertura ao solicitar uma cotação.'
	},
	{
		question: 'Posso pedir extintores com minha própria marca e etiqueta (OEM)?',
		answer: 'Sim. Oferecemos OEM para cor do cilindro, etiqueta do corpo, logotipo e idioma, e podemos adaptar o idioma da etiqueta ao seu mercado de destino. MOQ, confirmação da arte e prazo de entrega são confirmados na cotação — envie seu volume-alvo e o mercado para que possamos cotar a configuração certa.'
	},
	{
		question: 'Os extintores de pó químico precisam de embalagem especial para o transporte de exportação?',
		answer: 'Como o cilindro está pressurizado, confirme a classificação de carga perigosa (número ONU) e os requisitos de embalagem de transporte com seu transitário para o modelo exato. Para embarques da China classificados como carga perigosa, o exportador deve fornecer o certificado de avaliação de embalagem de transporte de cargas perigosas para exportação; casos de fiscalização aduaneira mostram que embarques sem esse documento podem ser retidos e penalizados. Confirmamos os requisitos de embalagem e de documentação com você antes da produção.'
	},
	{
		question: 'Quando devo escolher CO2 em vez de pó químico ABC?',
		answer: 'Use CO2 onde o resíduo de pó seria caro de limpar: salas de controle, salas de servidores, laboratórios e quadros de distribuição. O pó químico ABC oferece o melhor custo-benefício geral para áreas comerciais, de armazém e industriais comuns, cobrindo riscos mistos das classes A/B. Se o seu projeto mistura os dois tipos de ambiente, um pacote típico combina unidades de pó para áreas abertas e unidades de CO2 para salas de equipamentos sensíveis.'
	}
];

const toc = [
	{ id: 'why-fire-extinguishers', label: '1. Por que Extintores Lideram as Compras de Proteção Contra Incêndio' },
	{ id: 'fire-classes-agents', label: '2. Classes de Fogo e Agentes Extintores' },
	{ id: 'abc-specifications', label: '3. Especificações do Pó Químico ABC Explicadas' },
	{ id: 'certification-compliance', label: '4. Certificação e Conformidade para Exportação' },
	{ id: 'applications-scenarios', label: '5. Onde os Extintores São Instalados' },
	{ id: 'factory-buying-checklist', label: '6. Checklist de Compra na Fábrica: OEM, MOQ e Embalagem' },
	{ id: 'faq', label: 'Perguntas Frequentes' }
];

const products = [
	{ slug: 'abc-dry-powder-fire-extinguisher-5kg', name: 'Extintor de Pó Químico ABC (5kg)', img: '/assets/products/abc-dry-powder-fire-extinguisher-5kg.webp', desc: 'Unidade portátil ISO 7165 que cobre os fogos das classes A/B/C/E' },
	{ slug: 'stainless-steel-fire-extinguisher-box', name: 'Caixa para Extintor em Aço Inox', img: '/assets/products/stainless-steel-fire-extinguisher-box.jpg', desc: 'Armário SS304/201 para extintor ou carrete de mangueira' },
	{ slug: 'metal-fire-extinguisher-box-red', name: 'Caixa Metálica para Extintor (Vermelha)', img: '/assets/products/metal-fire-extinguisher-box-red.jpg', desc: 'Armário com revestimento em pó e painel de instruções, tamanhos OEM' }
];
---

<Layout
	title="Guia de Extintores: Pó Químico ABC para B2B & Exportação"
	description="Guia de seleção de extintores para compradores B2B: classes do pó químico ABC, certificação ISO 7165, tamanhos, OEM e embalagem de exportação da China."
	type="article"
	locale="pt"
	faq={faq}
	breadcrumbs={[{ name: 'Guias', href: '/pt/blog/' }, { name: 'Seleção de Extintores' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/pt/" class="hover:text-blue-600">Início</a>
			<span>/</span>
			<a href="/pt/blog/" class="hover:text-blue-600">Guias</a>
			<span>/</span>
			<span class="text-gray-600">Seleção de Extintores</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Guia de Proteção Contra Incêndio</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Guia de Seleção de Extintores: Pó Químico ABC para Projetos B2B e de Exportação</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Os extintores portáteis são o ponto de entrada de maior volume nas compras de proteção contra incêndio — mas as unidades de pó químico ABC, CO2, espuma e água não são intercambiáveis. Este guia ajuda importadores, distribuidores e compradores de projetos a combinar as classes de fogo aos agentes extintores, verificar as especificações que realmente importam e acertar a certificação e a documentação de carga perigosa antes do embarque do pedido.</p>

			<TableOfContents headings={toc} />

			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/pt/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 id="why-fire-extinguishers" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Por que Extintores Lideram as Compras de Proteção Contra Incêndio</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Dados de busca de plataformas do setor de agosto de 2026 mostram que <strong>fire extinguisher</strong> (extintor) era a categoria mais pesquisada na amostra de proteção contra incêndio — aproximadamente 19.800 buscas, cerca de um terço de todas as buscas das principais categorias — com formatos portáteis relacionados, como unidades de aerossol e tipo esfera, somando milhares de buscas a mais. O índice de interesse de busca relativo do Google para "fire extinguisher" mediu 80/100 em agosto de 2026, após atingir o pico de 100 no início do ano, com o interesse relativo mais forte em Qatar, Emirados Árabes Unidos, Filipinas, EUA e Reino Unido.</p>
			<p class="text-gray-700 leading-relaxed">O que os números realmente significam para um fornecedor: a demanda chega ao mesmo tempo de três modos de compra diferentes — distribuidores repondo SKUs padrão, empreiteiras equipando edifícios conforme especificação e gestores de instalações substituindo unidades vencidas. Uma abordagem genérica de "equipamento de incêndio" mistura compradores de varejo e de engenharia em uma única consulta indefinida. Apresentar o agente extintor, a capacidade, a cobertura de classes e a certificação desde o início é o que permite a cada comprador selecionar por conta própria a família de produtos certa.</p>

			<h2 id="fire-classes-agents" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Classes de Fogo e Agentes Extintores</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Todo extintor portátil é classificado por classe de fogo, e o agente deve corresponder ao risco. O pó químico ABC é o padrão multifuncional; os outros agentes se destacam onde resíduos, risco de reignição ou combustíveis especiais mudam o cenário.</p>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Classe de Fogo</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Combustíveis Típicos</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Agentes Mais Eficazes</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Adequação do Pó Químico ABC</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Classe A</td>
							<td class="px-4 py-3 text-gray-700">Madeira, papel, têxteis, plásticos</td>
							<td class="px-4 py-3 text-gray-700">Água, espuma, pó ABC</td>
							<td class="px-4 py-3 text-gray-700">Opção padrão</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Classe B</td>
							<td class="px-4 py-3 text-gray-700">Gasolina, óleos, solventes, tintas</td>
							<td class="px-4 py-3 text-gray-700">Pó ABC, espuma, CO2</td>
							<td class="px-4 py-3 text-gray-700">Opção padrão</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Classe C</td>
							<td class="px-4 py-3 text-gray-700">Propano, butano, metano, GLP</td>
							<td class="px-4 py-3 text-gray-700">Pó ABC (fechar o suprimento primeiro)</td>
							<td class="px-4 py-3 text-gray-700">Adequado</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Classe E</td>
							<td class="px-4 py-3 text-gray-700">Equipamentos elétricos energizados</td>
							<td class="px-4 py-3 text-gray-700">CO2, pó ABC (não condutor)</td>
							<td class="px-4 py-3 text-gray-700">Adequado — atenção ao resíduo de pó</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Classe F</td>
							<td class="px-4 py-3 text-gray-700">Óleos e gorduras de cozinha</td>
							<td class="px-4 py-3 text-gray-700">Químico úmido</td>
							<td class="px-4 py-3 text-gray-700">Não recomendado</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Classe D</td>
							<td class="px-4 py-3 text-gray-700">Metais combustíveis (Mg, Na)</td>
							<td class="px-4 py-3 text-gray-700">Pó metálico especializado</td>
							<td class="px-4 py-3 text-gray-700">Não adequado</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Para os usos mistos que a maioria dos compradores B2B atende — escritórios, armazéns, oficinas, varejo — uma única linha de pó químico ABC tipicamente cobre 80% das unidades portáteis da lista de materiais, com o CO2 reservado para salas elétricas e a espuma ou o químico úmido para riscos especializados.</p>

			<h2 id="abc-specifications" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Especificações do Pó Químico ABC Explicadas</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Quando a cotação chega, verifique esses cinco parâmetros antes de comparar preços entre fornecedores:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Agente e capacidade</strong> — o pó ABC à base de fosfato monoamônico é o padrão multifuncional; o peso líquido do agente (3kg / 4kg / 5kg na nossa linha) determina tanto a cobertura quanto o custo do frete.</li>
				<li><strong>Teor ativo</strong> — nosso pó ABC é especificado com 90% de teor ativo, o que afeta o desempenho de extinção por quilo.</li>
				<li><strong>Desempenho de descarga</strong> — espere aproximadamente 8 a 15 segundos de descarga eficaz em uma unidade de 5kg; a ficha técnica deve declará-lo, em vez de deixá-lo implícito.</li>
				<li><strong>Operação sob pressão armazenada e manômetro</strong> — o propelente e o pó ficam sob pressão em um único cilindro; um manômetro com código de cores mostra que a unidade está operacional, então o design do manômetro importa para as inspeções de manutenção.</li>
				<li><strong>Qualidade do cilindro e da válvula</strong> — cilindro de aço carbono com revestimento vermelho anticorrosivo, conjunto de válvula em latão e mangueira de descarga com bocal completam a unidade.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed mb-4">Nosso <a href="/pt/products/abc-dry-powder-fire-extinguisher-5kg/" class="text-brand-blue font-semibold hover:underline">extintor de pó químico ABC de 5kg</a> é fabricado conforme a ISO 7165 com a marcação CCCF, cobre os fogos das classes A/B/C/E e está disponível em pesos líquidos de 3kg / 4kg / 5kg com garantia de um ano. A mangueira de descarga, o manômetro e a válvula em latão estão inclusos como padrão.</p>
			<p class="text-gray-700 leading-relaxed">Um aviso honesto para repassar aos seus clientes: o pó químico deixa resíduo que é barato de limpar em pisos e máquinas, mas danifica eletrônicos — é exatamente por isso que a linha da classe E na tabela acima vem com uma ressalva.</p>

			<h2 id="certification-compliance" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Certificação e Conformidade para Exportação</h2>
			<p class="text-gray-700 leading-relaxed mb-4">A certificação é o ponto em que as compras de extintores portáteis diferem da compra de commodities, pois as marcações devem corresponder ao modelo real — não a uma marca ou a uma série.</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>ISO 7165</strong> — a norma internacional para extintores portáteis, cobrindo construção, desempenho e ensaios. É o ponto de referência para a maioria dos mercados de exportação e está marcada no nosso modelo de 5kg.</li>
				<li><strong>CCCF</strong> — a Certificação Obrigatória da China para produtos de incêndio. Ela qualifica a unidade para o mercado chinês; <strong>não</strong> é um certificado de exportação, e essa distinção importa quando o comprador planeja revender fora da China.</li>
				<li><strong>Certificação do mercado de destino</strong> — para a UE, verifique a marcação CE em relação à norma aplicável ao modelo exato; algumas aplicações na América do Norte buscam unidades listadas UL ou ULC. Sempre peça ao fabricante o certificado que cobre a combinação de modelo e válvula que você pretende importar, e rejeite declarações genéricas "de toda a série".</li>
				<li><strong>Marcação e idioma</strong> — os pictogramas de operação, as etiquetas de classe e o idioma da etiqueta de instruções devem ser confirmados para o país de destino antes da produção em massa, pois a reetiquetagem após a chegada é cara.</li>
				<li><strong>Laudos de teste por lote</strong> — peça o laudo de teste do lote de produção real, não uma ficha de outro modelo. Nossa página <a href="/pt/certificates/" class="text-brand-blue font-semibold hover:underline">certificados e conformidade</a> mostra como a documentação de certificação é tratada para a nossa linha de proteção contra incêndio.</li>
			</ul>

			<h2 id="applications-scenarios" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Onde os Extintores São Instalados: Comercial, Armazém e Veículos</h2>
			<p class="text-gray-700 leading-relaxed mb-4">A mesma unidade ABC de 5kg atende usuários finais muito diferentes, e a especificação muda conforme o local:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Prédios comerciais e escritórios</strong> — unidades ABC de 4 a 5kg em parede perto das saídas e das áreas comuns, com CO2 nas salas elétricas. As caixas de parede protegem a unidade e facilitam a inspeção.</li>
				<li><strong>Armazéns e plantas industriais</strong> — pó ABC para riscos mistos das classes A/B; grandes áreas abertas tipicamente combinam extintores com sistemas de carrete de mangueira e, para pé-direito muito alto, com supressão fixa. Veja nosso <a href="/pt/guides/fire-hose-reel-cabinet-guide/" class="text-brand-blue font-semibold hover:underline">guia de carrete de mangueira e armários</a> para o lado dos equipamentos fixos do mesmo pacote.</li>
				<li><strong>Veículos e aplicações móveis</strong> — unidades compactas para caminhões, empilhadeiras e salas de máquinas; nossa opção de 3kg se adapta a esses espaços e pode ser cotada com o material de fixação.</li>
				<li><strong>Áreas externas e ambientes corrosivos</strong> — a <a href="/pt/products/stainless-steel-fire-extinguisher-box/" class="text-brand-blue font-semibold hover:underline">caixa para extintor em aço inox</a> (SS304/201 com visor) protege as unidades em aeroportos, locais à beira-mar e plantas químicas, enquanto a <a href="/pt/products/metal-fire-extinguisher-box-red/" class="text-brand-blue font-semibold hover:underline">caixa metálica vermelha para extintor</a> com instruções de operação impressas é o padrão interno econômico.</li>
			</ul>

			<h2 id="factory-buying-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Checklist de Compra na Fábrica: OEM, MOQ &amp; Embalagem de Carga Perigosa</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Comprar extintores de uma fábrica chinesa é um exercício de documentação tanto quanto de produto. Faça este checklist antes de se comprometer:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Escopo OEM</strong> — a cor do cilindro, a etiqueta do corpo, o logotipo e o idioma da etiqueta podem ser personalizados; confirme a arte e o cronograma de aprovação no planejamento do pedido.</li>
				<li><strong>MOQ e prazo de entrega</strong> — ambos dependem do modelo, da quantidade e da configuração da etiqueta, então são confirmados na cotação; informe seu mercado-alvo e volume anual para obter um número realista.</li>
				<li><strong>Classificação de carga perigosa</strong> — o cilindro pressurizado pode ser classificado como carga perigosa para o transporte. Confirme a classificação ONU e os requisitos de embalagem para o modelo exato com seu transitário antes de reservar espaço.</li>
				<li><strong>Documentação de exportação da China</strong> — quando um embarque é classificado como carga perigosa, o exportador chinês deve fornecer o certificado de avaliação de embalagem de transporte de cargas perigosas para exportação; casos de fiscalização aduaneira mostram embarques sem esse documento retidos e penalizados. Peça ao seu fornecedor para confirmar que esse documento está em ordem.</li>
				<li><strong>Consolide o pacote</strong> — pedir extintores junto com caixas de parede, carretes de mangueira e válvulas de um único fabricante simplifica os arquivos de certificação e o frete. Nosso <a href="/pt/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">checklist de compras B2B de válvulas</a> cobre o lado da verificação da fábrica do mesmo processo.</li>
			</ul>

			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Perguntas Frequentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Comprando Extintores de Pó Químico ABC?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envie seu mercado-alvo, a quantidade e o idioma da etiqueta — nossa equipe confirma o status de certificação, o MOQ e os requisitos de embalagem de carga perigosa em até 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/pt/contact/?product=Extintor%20de%20P%C3%B3%20Qu%C3%ADmico%20ABC" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotação</a>
						<a href="https://wa.me/8618684324501?text=Ol%C3%A1%2C%20preciso%20de%20extintores%20de%20p%C3%B3%20qu%C3%ADmico%20ABC" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Conversar no WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
