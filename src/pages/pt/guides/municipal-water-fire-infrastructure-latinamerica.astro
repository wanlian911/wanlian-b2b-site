							<td class="px-4 py-3 text-gray-700">Confirme o escopo de comunicação e telemetria</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Válvula de gaveta de isolamento</td>
							<td class="px-4 py-3 text-gray-700">Ferro fundido dúctil, assento elástico, passagem plena, PN16 ou ANSI</td>
							<td class="px-4 py-3 text-gray-700"><a href="/pt/products/resilient-seat-flanged-gate-valve-z41x/" class="text-brand-blue font-semibold hover:underline">Válvula de Gaveta Flangeada, Assento Elástico, Ferro Fundido Dúctil (Z41X)</a></td>
