							<td class="px-4 py-3 text-gray-700"><a href="/pt/products/overground-fire-hydrant-ss100/" class="text-brand-blue font-semibold hover:underline">Hidrante de Coluna Anticongelante (SS100/65)</a></td>
							<td class="px-4 py-3 text-gray-700">Referência AWWA C502 / EN 14384 por modelo</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Hidrante anti-colisão/regulador de pressão</td>
							<td class="px-4 py-3 text-gray-700">Vias de tráfego intenso, proteção contra veículos</td>
							<td class="px-4 py-3 text-gray-700"><a href="/pt/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100/" class="text-brand-blue font-semibold hover:underline">Hidrante Externo Anti-Colisão e Regulador de Pressão (SSFT100/65)</a></td>
							<td class="px-4 py-3 text-gray-700">Confirme por modelo as especificações de impacto e regulagem de pressão</td>
						</tr>
