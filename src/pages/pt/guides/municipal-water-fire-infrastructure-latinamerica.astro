---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const uri = { EscapeDataString: encodeURIComponent };

const toc = [
	{ id: 'project-scope', label: '1. O que realmente inclui um projeto municipal de água e incêndio' },
	{ id: 'standards-regimes', label: '2. Normas na região: o que a licitação pode exigir' },
	{ id: 'one-purchase-order', label: '3. Como um único pedido reduz o risco de coordenação' },
	{ id: 'selection-matrix', label: '4. Matriz de seleção: componente, especificação e modelo recomendado' },
	{ id: 'specification-documentation', label: '5. Especificações e documentos a solicitar' },
	{ id: 'procurement-checklist', label: '6. Checklist de compras municipais' },
	{ id: 'faq', label: 'Perguntas frequentes' },
	{ id: 'sources', label: 'Fontes' }
