---
import ProductGallery from '../../../components/shared/ProductGallery.astro';
import Layout from '../../../layouts/Layout.astro';
import { productsPt, productsPtBySlug } from '../../../utils/products.pt';
import { PRODUCT_FAMILY_RELATED } from '../../../utils/product-families';

export async function getStaticPaths() {
  return Object.values(productsPtBySlug).map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

// FAQ genéricos de compra por categoria
const faqByCategory: Record<string, { question: string; answer: string }[]> = {
  'Válvulas e Peças': [
    { question: 'Quais normas e tipos de conexão estão disponíveis para as válvulas Wanlian?', answer: 'As válvulas Wanlian são fabricadas sob pedido conforme as normas GB, ANSI, DIN e JIS. Conexões flangeadas, ranuradas, tipo wafer e roscadas estão disponíveis conforme o modelo. Informe a nossos engenheiros o DN/PN e o tipo de conexão na consulta, e confirmaremos a configuração adequada.' },
    { question: 'Quais materiais são usados no corpo e na vedação da válvula?', answer: 'Os corpos são tipicamente de ferro fundido dúctil (QT450), ferro fundido cinzento ou aço fundido/forjado, conforme o modelo. Os elementos de vedação usam borracha EPDM ou NBR, e as hastes são de aço inox (2Cr13/304). As opções de material podem ser personalizadas para meios e faixas de temperatura específicos.' },
    { question: 'Qual é o MOQ e o prazo de entrega?', answer: 'O MOQ padrão é tipicamente de 20 unidades por modelo para tamanhos em estoque, com prazos de produção de 15 a 30 dias conforme a quantidade e a personalização. Pedidos de amostra estão disponíveis para testes antes do envio.' },
    { question: 'Como as válvulas são testadas antes do envio?', answer: 'Cada válvula passa por 100% de teste de pressão do corpo e do assento, conforme a norma aplicável (p. ex., GB/T13927, EN 12266-1). Laudos de teste e inspeção de terceiros podem ser organizados mediante solicitação.' }
  ],
  'Hidrantes e Conexões de Bomba': [
    { question: 'Quais normas de conexão de saída estão disponíveis para hidrantes de exportação?', answer: 'As conexões de saída comuns incluem BS336 (Reino Unido/Commonwealth), NIST (Oriente Médio), KWS (Alemanha) e opções de flange flexível. Podemos fornecer hidrantes com o tipo de conexão especificado para o seu mercado.' },
    { question: 'Qual classe de pressão um hidrante municipal deve ter?', answer: 'Hidrantes municipais padrão são classificados em PN16 (1.6 MPa), cobrindo a maioria das redes de abastecimento de água urbanas e industriais. Zonas industriais de grande altura ou alta demanda podem exigir hidrantes PN25.' },
    { question: 'Os hidrantes Wanlian estão disponíveis com certificação UL ou FM?', answer: 'Sim, conforme o modelo e o mercado de destino. Entre em contato com nossa equipe comercial com a especificação do seu projeto e a região de destino para que possamos selecionar o pacote de certificação adequado.' },
    { question: 'Os hidrantes de exterior têm proteção anticongelante?', answer: 'Modelos como o hidrante de coluna SS100 possuem mecanismo de dreno anticongelante automático para climas frios. As variantes anti-colisão (SSFT100) e inteligentes IoT (SS100ZN) também estão disponíveis.' }
  ],
  'Rociadores e Válvulas de Alarme': [
    { question: 'Qual é a diferença entre a válvula de alarme do tipo molhada e a válvula de dilúvio?', answer: 'A válvula de alarme do tipo molhada (ZSFZ) mantém as tubulações de rociadores cheias de água e aciona o alarme no fluxo de água. A válvula de dilúvio (ZSFM) permanece fechada sob pressão de ar ou água e inunda o sistema apenas quando um sinal de detecção de incêndio a abre — usada em áreas de alto risco que exigem descarga imediata de grande volume de água.' },
    { question: 'A quais normas os componentes do sistema de rociadores se conformam?', answer: 'Os componentes são fabricados e testados conforme a série GB 5135 e, sob pedido, outras normas internacionais. Confirme a norma aplicável ao seu projeto com nossos engenheiros.' },
    { question: 'Qual é a pressão de trabalho das válvulas de alarme?', answer: 'A pressão de trabalho padrão é de 1.6 MPa, com pressão de teste de 3.2 MPa. As faixas de dimensões cobrem geralmente DN50 a DN300, conforme o modelo.' },
    { question: 'Os conjuntos de válvulas de alarme podem ser integrados a sistemas de detecção de incêndio existentes?', answer: 'Sim. Válvulas de dilúvio e de pré-ação suportam acionamentos remotos mecânicos, pneumáticos ou elétricos (eletroválvula DC24V) e podem ser integrados à maioria dos painéis de controle de alarme de incêndio.' }
  ],
  'Segurança Hidráulica': [
    { question: 'As válvulas de controle hidráulico necessitam de alimentação elétrica?', answer: 'A maioria das válvulas de controle hidráulico (p. ex., válvula de nível F745X, redutora 500X) é totalmente autopilotada pela pressão da tubulação e não requer alimentação externa. Modelos com controle por solenoide, como o GKZF-1, usam AC220V ou DC24V.' },
    { question: 'Qual é a faixa de ajuste de pressão da válvula 500X?', answer: 'A válvula redutora de pressão 500X ajusta a pressão a jusante de 0.1 MPa a 1.6 MPa e funciona com pressões de entrada até a classe nominal (PN10/PN16/PN25).' },
    { question: 'Quais materiais são usados em aplicações de água potável?', answer: 'Para redes de água de consumo, modelos como o dispositivo anti-retorno HS41X usam corpos de ferro fundido dúctil com vedação EPDM e componentes internos de aço inox, conformes aos requisitos sanitários GB/T17219.' },
    { question: "Como o martelo d'água é evitado nas válvulas hidráulicas?", answer: 'As válvulas de controle pilotado fecham de forma suave e lenta, evitando sobrepressões bruscas. As válvulas de agulha permitem ajustar a velocidade de fechamento conforme as condições específicas da tubulação.' }
  ],
  'Canhões Monitora de Incêndio': [
    { question: 'Quais vazões e alcances de jato estão disponíveis para os canhões monitora contra incêndio?', answer: 'Os canhões manuais (série PS) cobrem 20 a 200 L/s, com alcance do jato de 50 a 110 metros. Os canhões de rastreamento automático (série ZDMS) oferecem 5 a 30 L/s (sob medida até 150 L/s), com raio de monitoramento de 40 a 65 m.' },
    { question: 'Como o canhão de rastreamento automático detecta incêndios?', answer: 'O canhão ZDMS combina sensores infravermelhos e ultravioleta para detectar e acompanhar chamas, e então mira e dispara água automaticamente. Suporta acionamento remoto manual via PC/aplicativo móvel ou um armário central.' },
    { question: 'Há versões à prova de explosão disponíveis?', answer: 'Sim, opções à prova de explosão (p. ex., Exde II BT4 Gb) estão disponíveis para ambientes petroquímicos e de risco.' },
    { question: 'Qual é a pressão de trabalho dos canhões?', answer: 'Os canhões manuais operam a 0.8–1.2 MPa e os canhões de rastreamento automático a 0.6–0.8 MPa. Confirme a dimensão da flange de entrada (DN100/DN150/DN200) para o seu sistema.' }
  ],
  'Armários de Incêndio e Interfaces': [
    { question: 'O que está incluído em um conjunto de carrete de mangueira contra incêndio?', answer: 'O conjunto da série JPS inclui um carrete de montagem pivotante em aço carbono, mangueira plana flexível de PVC (20/25/30 m) e um bocal de pulverização em latão/liga que suporta os modos de jato direto e neblina.' },
    { question: 'Há armários de espuma disponíveis para incêndios químicos?', answer: 'Sim. O armário de espuma PSG30 reúne tanque de concentrado de espuma, dosificador, carrete de mangueira e bocal de espuma em uma única unidade de parede — eficaz contra incêndios de combustíveis, químicos e solventes (classe B).' },
    { question: 'A quais normas de conexão os adaptadores de acoplamento de mangueira se conformam?', answer: 'Os adaptadores da série HS estão disponíveis em DN50/DN65, com roscas internas compatíveis com acoplamentos internacionais contra incêndio, fabricados segundo GB12514 ou as normas de fábrica.' },
    { question: 'Quais materiais são usados nos armários e carretéis?', answer: 'Os armários e carretéis usam aço carbono laminado a frio com revestimento em pó vermelho anticorrosivo. Os bocais e dosificadores são de latão ou liga de alumínio anodizado.' }
  ]
};

// Aplicações e normas de teste por categoria
const categoryInfo: Record<string, { applications: string[]; testing: string }> = {
  'Válvulas e Peças': {
    applications: ['Abastecimento e distribuição de água', 'Redes de esgoto e águas residuárias', 'Tubulações de processo industrial', 'Sistemas de HVAC'],
    testing: 'Teste de pressão do corpo e do assento a 100% conforme GB/T13927 ou EN 12266-1; revestimento em resina epóxi testado para resistência à corrosão.'
  },
  'Hidrantes e Conexões de Bomba': {
    applications: ['Redes de proteção contra incêndio municipal', 'Áreas industriais e pátios de armazéns', 'Sistemas de coluna internos', 'Instalações de exterior em clima frio'],
    testing: 'Teste de pressão hidrostática (2.4 MPa típico) e teste de vazão conforme GB 4452 ou as normas de exportação aplicáveis.'
  },
  'Rociadores e Válvulas de Alarme': {
    applications: ['Sistemas automáticos de rociadores', 'Prédios comerciais e residenciais', 'Armazéns industriais', 'Sistemas de dilúvio e de pré-ação de alto risco'],
    testing: 'Testes de pressão e estanqueidade conforme a série GB 5135; sensibilidade de alarme verificada com interruptores de vazão e campainhas de alarme.'
  },
  'Segurança Hidráulica': {
    applications: ['Controle de nível de reservatórios', 'Gestão de pressão em redes de água', 'Proteção contra reflujo de água potável', 'Proteção da sucção de bombas'],
    testing: 'Testes de funcionamento e pressão conforme as normas aplicáveis; conjuntos de diafragma e vedações testados para durabilidade.'
  },
  'Canhões Monitora de Incêndio': {
    applications: ['Usinas petroquímicas e fazendas de tanques', 'Aeroportos e centros de exposição', 'Armazéns de grande porte', 'Caminhões bombeiro e combate a incêndio marítimo'],
    testing: 'Testes de vazão, alcance do jato e rotação; modelos à prova de explosão verificados conforme as normas Ex (opcional).'
  },
  'Armários de Incêndio e Interfaces': {
    applications: ['Postos de combate a incêndio internos', 'Áreas de armazenamento de produtos químicos e combustíveis', 'Sistemas de mangueira contra incêndio de edifícios', 'Instalações marítimas e offshore'],
    testing: 'Testes de pressão e funcionamento dos carretéis, bocais e dosificadores; razão de expansão da espuma verificada por modelo.'
  }
};

// FAQ do produto tem prioridade; caso contrário, FAQ genérico por categoria
const faqs = product.faqs ?? faqByCategory[product.category] ?? [];
const info = categoryInfo[product.category];

// Vídeo do produto (opcional): renderizado + JSON-LD VideoObject quando os dados configuram
const videoData = product.video
  ? {
      name: `${product.name} — Visão Geral em Vídeo`,
      description: product.video.description ?? `Visão geral em vídeo do ${product.name}: construção, dimensões principais e pontos de instalação.`,
      thumbnail: product.video.poster ?? product.image,
      src: product.video.src,
      duration: product.video.duration ?? 'PT2M0S',
      uploadDate: product.video.uploadDate ?? '2026-09-21'
    }
  : undefined;
// Related em fechamento por família de produtos; produtos sem família usam interlinking por categoria
const bySlug = new Map(productsPt.map(p => [p.slug, p]));
const familySlugs = PRODUCT_FAMILY_RELATED[product.slug] ?? [];
const relatedProducts = familySlugs.length
  ? familySlugs.map(s => bySlug.get(s)).filter((p): p is typeof productsPt[number] => Boolean(p))
  : productsPt.filter(p => p.category === product.category && p.slug !== product.slug).slice(0, 4);
const catAnchor = encodeURIComponent(product.category);

// Links para guias de compra por categoria
const guideByCategory: Record<string, { href: string; title: string; description: string }[]> = {
  'Válvulas e Peças': [
    { href: '/pt/guides/gate-valve-vs-butterfly-valve-fire-protection/', title: 'Válvula de Gaveta vs. Válvula Borboleta para Proteção Contra Incêndio', description: 'Vedação, vazão, perda de carga e custo comparados para escolher a válvula de isolamento correta para ramais de incêndio e redes de água.' },
    { href: '/pt/guides/check-valve-types-guide/', title: 'Tipos de Válvulas de Retenção e Guia de Seleção', description: 'Retenção de esfera deslizante vs. clapeta oscilante — perda de carga, comportamento no fechamento e as aplicações ideais de cada tipo.' }
  ],
  'Hidrantes e Conexões de Bomba': [
    { href: '/pt/guides/how-to-choose-a-fire-hydrant/', title: 'Como Escolher um Hidrante Contra Incêndio', description: 'Interno vs. exterior, coluna seca vs. molhada, normas de saída e classes de pressão para projetos municipais e industriais.' },
    { href: '/pt/guides/fire-hydrant-valve-standards-guide/', title: 'Normas de Hidrantes, Mangueiras e Válvulas Explicadas', description: 'AWWA C502, NFPA 1961, EN 14384, BS 750 — qual norma se aplica ao seu pedido e como verificar a conformidade.' }
  ],
  'Rociadores e Válvulas de Alarme': [
    { href: '/pt/guides/fire-sprinkler-control-valve-types/', title: 'Tipos de Válvulas de Controle de Redes de Rociadores: OS&Y, Borboleta e Retenção', description: 'O papel de cada válvula de controle em uma rede de rociadores e como as válvulas OS&Y, borboleta e de retenção trabalham juntas.' },
    { href: '/pt/guides/fire-sprinkler-system-wet-dry-preaction/', title: 'Sistemas de Rociadores: Molhado, Seco ou de Pré-Ação?', description: 'Compare as configurações de sistemas de rociadores molhado, seco e de pré-ação conforme a classe de risco do seu prédio.' }
  ],
  'Segurança Hidráulica': [
    { href: '/pt/guides/pressure-reducing-valve-guide/', title: 'Guia de Válvulas Redutoras de Pressão: PRV Hidráulico 500X', description: "Como as redutoras pilotadas protegem equipamentos a jusante, regulam a pressão e evitam o martelo d'água." },
    { href: '/pt/guides/backflow-prevention-guide/', title: 'Guia de Prevenção de Refluxo', description: 'Quando as redes de água potável precisam de conjuntos de dupla retenção e como o HS41X protege contra o reflujo.' }
  ],
  'Canhões Monitora de Incêndio': [
    { href: '/pt/guides/fire-water-monitor-selection-guide/', title: 'Seleção de Canhões Monitora: Manual vs. Rastreamento Automático', description: 'Monitores manuais PS vs. canhões de rastreamento automático ZDMS — vazão, alcance, controle e opções à prova de explosão.' },
    { href: '/pt/guides/fire-water-cannon-buying-guide/', title: 'Guia de Compra de Canhões Monitora Contra Incêndio', description: 'Fixo, remoto ou inteligente? Alcance do jato, vazão e fatores de instalação para supressão de incêndio em grandes espaços.' }
  ],
  'Armários de Incêndio e Interfaces': [
    { href: '/pt/guides/fire-hose-reel-cabinet-guide/', title: 'Guia de Seleção de Carretéis de Mangueira e Armários Contra Incêndio', description: 'Carretéis JPS0.8-19, armários de espuma PSG30 e válvulas de hidrante SN65 — o que um posto de combate a incêndio interno completo precisa.' },
    { href: '/pt/guides/fire-extinguisher-selection-guide/', title: 'Guia de Compra de Extintores: Pó Químico ABC', description: 'Cobertura das classes A/B/C/E, classificações ISO 7165 e embalagem de exportação B2B para extintores portáteis.' }
  ]
};

const relatedGuides = (guideByCategory[product.category] ?? []).slice(0, 3);
---

<Layout
  locale="pt"
  title={product.seoTitle}
  description={product.seoDescription}
  productData={product}
  type="product"
  faq={faqs}
  video={videoData}
  breadcrumbs={[{ name: 'Produtos', href: '/pt/products/' }, { name: product.category, href: `/pt/products/#category=${catAnchor}` }, { name: product.name }]}
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 mb-20">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-8 flex gap-2">
      <a href="/pt/" class="hover:text-blue-600">Início</a>
      <span>/</span>
      <a href="/pt/products/" class="hover:text-blue-600">Produtos</a>
      <span>/</span>
      <a href={`/pt/products/#category=${catAnchor}`} class="hover:text-blue-600">{product.category}</a>
      <span>/</span>
      <span class="text-gray-600">{product.name}</span>
    </nav>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Product Image -->
      <ProductGallery 
        mainImage={product.image} 
        gallery={product.gallery} 
        alt={product.name} 
      />

      <!-- Vídeo do produto (apenas quando os dados configuram product.video) -->
      {product.video && (
        <div class="mt-4 rounded-2xl overflow-hidden shadow-sm border border-gray-100 bg-gray-900">
          <video class="w-full h-auto" controls playsinline preload="metadata" poster={product.video.poster}>
            <source src={product.video.src} type="video/mp4" />
            Seu navegador não suporta vídeo incorporado.
          </video>
        </div>
      )}

      <!-- Product Details -->
      <div class="space-y-6">
        <div>
          <span class="text-blue-600 font-semibold uppercase tracking-wider text-sm">{product.category}</span>
          <h1 class="text-4xl font-bold text-gray-900 mt-2">{product.name}</h1>
        </div>

        <div class="text-lg text-gray-600 leading-relaxed space-y-4">
          {product.description.split('\n\n').map(paragraph => (
            <p>{paragraph}</p>
          ))}
        </div>

        <div class="space-y-4">
          <h2 class="text-xl font-bold border-b pb-2">Principais Características</h2>
          <ul class="grid grid-cols-1 gap-2">
            {product.features.map(feature => (
              <li class="flex items-start">
                <svg class="h-6 w-6 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-700">{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-gray-100 p-6 rounded-xl space-y-4">
          <h2 class="text-xl font-bold">Especificações Técnicas</h2>
          <dl class="grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2">
            {Object.entries(product.specs).map(([key, value]) => (
              <div class="border-b border-gray-200 py-2">
                <dt class="text-sm font-medium text-gray-500">{key}</dt>
                <dd class="mt-1 text-sm font-bold text-gray-900">{value}</dd>
              </div>
            ))}
          </dl>
        </div>

        {product.materials && (
          <div class="bg-gray-50 p-6 rounded-xl border border-gray-200/60 space-y-4">
            <h2 class="text-xl font-bold text-gray-900">Lista de Peças e Materiais</h2>
            <dl class="grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2">
              {Object.entries(product.materials).map(([part, material]) => (
                <div class="border-b border-gray-200/60 py-2 flex justify-between items-center text-sm">
                  <dt class="font-medium text-gray-500">{part}</dt>
                  <dd class="font-bold text-gray-900 text-right">{material}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {product.dimensions && (
          <div class="bg-white p-6 rounded-xl border border-gray-100 space-y-4 shadow-sm overflow-x-auto">
            <h2 class="text-xl font-bold text-gray-900">Guia de Dimensões Padrão</h2>
            <table class="min-w-full divide-y divide-gray-200 text-sm">
              <thead class="bg-gray-50">
                <tr>
                  {product.dimensions.headers.map(header => (
                    <th class="px-3 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">{header}</th>
                  ))}
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                {product.dimensions.rows.map(row => (
                  <tr class="hover:bg-gray-50/50">
                    {row.map(cell => (
                      <td class="px-3 py-3 text-gray-700 font-medium whitespace-nowrap">{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {info && (
          <div class="space-y-4">
            <div class="bg-blue-50/50 p-6 rounded-xl border border-blue-100/50">
              <h2 class="text-xl font-bold text-gray-900 mb-3">Aplicações</h2>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                {info.applications.map(app => (
                  <li class="flex items-start text-sm text-gray-700">
                    <svg class="h-5 w-5 text-blue-600 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {app}
                  </li>
                ))}
              </ul>
            </div>
            <div class="bg-gray-50 p-6 rounded-xl border border-gray-200/60">
              <h2 class="text-xl font-bold text-gray-900 mb-3">Qualidade e Testes</h2>
              <p class="text-sm text-gray-700 leading-relaxed">{info.testing}</p>
            </div>
          </div>
        )}

        <div class="flex flex-col sm:flex-row gap-4 pt-6">
          <a
            href={`/pt/contact/?product=${encodeURIComponent(product.name)}`}
            class="flex-1 text-center py-4 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition shadow-lg shadow-blue-600/20"
          >
            Solicitar Cotação
          </a>
          <a
            href={`/pt/contact/?product=${encodeURIComponent('Solicitar Catálogo PDF')}`}
            class="flex-1 text-center py-4 bg-white text-blue-600 font-bold border-2 border-blue-600 rounded-xl hover:bg-blue-50 transition"
          >
            Solicitar Documentação do Produto
          </a>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    {faqs.length > 0 && (
      <section class="mt-20 max-w-4xl">
        <h2 class="text-3xl font-black text-gray-900 mb-8">Perguntas Frequentes</h2>
        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <details class="group bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer px-6 py-5 font-bold text-gray-900 hover:bg-gray-50 transition list-none">
                <span>{faq.question}</span>
                <svg class="w-5 h-5 text-gray-400 group-open:rotate-45 transition-transform flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
              </summary>
              <div class="px-6 pb-6 text-gray-600 leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Guides (backlinks GEO) -->
    {relatedGuides.length > 0 && (
      <section class="mt-20">
        <h2 class="text-3xl font-black text-gray-900 mb-8">Guias de Compra Relacionados</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedGuides.map(guide => (
            <a href={guide.href} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-6 flex flex-col">
              <span class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-2">Guia de Compra</span>
              <h3 class="text-sm font-bold text-gray-900 group-hover:text-brand-blue transition leading-snug">{guide.title}</h3>
              <p class="text-xs text-gray-500 leading-relaxed mt-2 flex-grow">{guide.description}</p>
              <span class="mt-4 inline-flex items-center text-brand-red font-bold text-xs group-hover:gap-1 transition-all">
                Ler o Guia
                <svg class="w-3.5 h-3.5 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <section class="mt-20">
        <h2 class="text-3xl font-black text-gray-900 mb-8">Produtos Relacionados</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {relatedProducts.map(related => (
            <a href={`/pt/products/${related.slug}/`} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-6 flex flex-col">
              <img src={related.image} alt={related.name} class="w-full h-40 object-contain rounded-lg bg-gray-50 p-2 mb-4" loading="lazy" />
              <span class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-2">{related.category}</span>
              <h3 class="text-sm font-bold text-gray-900 group-hover:text-brand-blue transition leading-snug">{related.name}</h3>
              <span class="mt-4 inline-flex items-center text-brand-red font-bold text-xs group-hover:gap-1 transition-all">
                Ver Detalhes
                <svg class="w-3.5 h-3.5 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
