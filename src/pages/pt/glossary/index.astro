---
import Layout from '../../../layouts/Layout.astro';
const groups = [{ title: 'Válvulas e componentes', terms: [{ term: 'Válvula de gaveta', definition: 'Válvula de seccionamento com cunha para interromper o fluxo em redes de água e proteção contra incêndio.' }, { term: 'Válvula borboleta', definition: 'Válvula de um quarto de volta com disco, usada para controle e seccionamento de tubulações.' }, { term: 'Válvula de retenção', definition: 'Válvula que permite o fluxo em uma direção e impede o retorno do fluido.' }, { term: 'Válvula redutora de pressão (PRV)', definition: 'Válvula que reduz automaticamente a pressão de entrada para uma pressão de saída estável.' }, { term: 'Dispositivo anti-retorno', definition: 'Dispositivo que evita a contaminação da água potável por refluxo em uma conexão cruzada.' }, { term: 'Vedação estanque', definition: 'Vedação que impede vazamento através da válvula quando fechada.' }] }, { title: 'Hidrantes e conexões', terms: [{ term: 'Hidrante contra incêndio', definition: 'Equipamento conectado à rede de água para abastecer mangueiras e equipamentos de combate a incêndio.' }, { term: 'Hidrante de coluna', definition: 'Hidrante instalado acima do solo; a versão exterior é usada em redes municipais e industriais.' }, { term: 'Hidrante subterrâneo', definition: 'Hidrante instalado abaixo do nível do solo, protegido por uma caixa de acesso.' }, { term: 'Conexão de bombeiros (FDC)', definition: 'Conexão que permite aos bombeiros injetar água no sistema de rociadores ou na rede de proteção.' }] }, { title: 'Rociadores e supressão', terms: [{ term: 'Rociador contra incêndio', definition: 'Dispositivo que descarrega água automaticamente quando o elemento térmico atinge sua temperatura de acionamento.' }, { term: 'Sistema de rociadores', definition: 'Rede de tubulações, válvulas e rociadores destinada à proteção automática contra incêndio.' }, { term: 'Sistema de pré-ação', definition: 'Sistema com tubulação normalmente seca que exige sinais independentes antes de liberar água.' }, { term: 'Válvula de dilúvio', definition: 'Válvula que libera água simultaneamente para bocais abertos quando recebe um sinal de detecção.' }, { term: 'Canhão monitora contra incêndio', definition: 'Equipamento orientável que lança água ou espuma a longa distância para supressão de incêndios.' }] }, { title: 'Certificações e normas', terms: [{ term: 'AWWA C502 / AWWA C515', definition: 'Normas AWWA para hidrantes de coluna seca e válvulas de gaveta com assento elástico.' }, { term: 'UL / FM', definition: 'Certificações e aprovações de segurança atribuídas a produtos e modelos específicos.' }, { term: 'NFPA 13 / NFPA 1961', definition: 'Referências para sistemas de rociadores e mangueiras contra incêndio.' }, { term: 'ABNT / NBR / INMETRO', definition: 'Referências oficiais brasileiras para normas, requisitos técnicos e avaliação da conformidade.' }] }, { title: 'Testes e compras', terms: [{ term: 'Pressão nominal', definition: 'Classe de pressão para a qual a válvula ou componente é especificado.' }, { term: 'Vazão', definition: 'Volume de fluido que atravessa uma seção por unidade de tempo.' }, { term: 'MOQ', definition: 'Quantidade mínima de pedido negociada para um modelo ou produto.' }, { term: 'Incoterm', definition: 'Regra comercial que define responsabilidades, custos e transferência de riscos no transporte.' }, { term: 'Inspeção de terceiros', definition: 'Verificação independente de produto, testes e documentos antes do embarque.' }] }];
---
<Layout title="Glossário de Válvulas e Proteção Contra Incêndio" description="Glossário técnico com termos de válvulas, hidrantes, rociadores, certificações, testes e compras B2B." type="website" locale="pt" breadcrumbs={[{ name: 'Glossário' }]}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/pt/">Início</a><span>/</span><span class="text-gray-600">Glossário</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Referência técnica</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Glossário de válvulas e proteção contra incêndio</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Definições objetivas para especificações, editais, fichas técnicas e compras de válvulas, hidrantes, rociadores e equipamentos contra incêndio.</p><div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-8">{groups.map(g => <a href={`#${g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="px-4 py-3 bg-gray-50 border border-gray-100 rounded-xl text-xs font-bold text-brand-blue text-center">{g.title}</a>)}</div>{groups.map(g => <section class="mt-12"><h2 id={g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')} class="text-2xl font-black text-gray-900 mb-5 tracking-tight">{g.title}</h2><div class="space-y-4">{g.terms.map(t => <div class="bg-gray-50 rounded-xl border border-gray-100 p-5"><h3 class="text-lg font-black text-gray-900">{t.term}</h3><p class="mt-2 text-gray-700 leading-relaxed text-sm">{t.definition}</p></div>)}</div></section>)}<div class="mt-12 bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center rounded-2xl"><h2 class="text-2xl font-black text-white">Pronto para especificar?</h2><p class="mt-3 text-blue-100">Envie suas quantidades e destino para receber uma cotação detalhada.</p><a href="/pt/contact/" class="inline-block mt-6 px-8 py-4 bg-brand-red text-white font-bold rounded-lg">Solicitar cotação</a></div></article></main>
</Layout>
