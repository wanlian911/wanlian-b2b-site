---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'O que significa "certificado UL" para válvulas contra incêndio?',
		answer: 'A certificação UL verifica que a válvula atende às normas de proteção contra incêndio UL/ULC de vazão, classe de pressão e durabilidade, garantindo desempenho confiável em sistemas de rociadores e colunas (montantes). É um requisito obrigatório para a maioria dos projetos na América do Norte e muitos projetos internacionais.'
	},
	{
		question: 'Quais válvulas contra incêndio a Wanlian fabrica com certificação UL?',
		answer: 'Fabricamos válvulas de gaveta, borboleta, de retenção, de dilúvio e de pré-ação em conexões flangeadas, ranuradas e roscadas, de DN40 a DN300. Contate nossa equipe comercial com a especificação do seu projeto para selecionar o tipo de válvula e o pacote de certificação corretos.'
	},
	{
		question: 'Vocês podem fornecer o certificado UL antes do pedido?',
		answer: 'Sim. Nossos certificados UL/ULC e FM estão disponíveis mediante solicitação — veja nossa página de Certificados para referência, e nossos engenheiros confirmarão a certificação exata aplicável ao seu mercado de destino antes da cotação.'
	},
	{
		question: 'Qual é o MOQ e o prazo de entrega para válvulas contra incêndio?',
		answer: 'O MOQ depende do tipo e do tamanho da válvula — tipicamente 10 a 20 unidades por modelo para tamanhos em estoque, com prazos de produção de 15 a 30 dias. Pedidos de amostra estão disponíveis para testes e aprovação antes do embarque.'
	},
	{
		question: 'Vocês oferecem OEM / marca própria para válvulas contra incêndio?',
		answer: 'Sim, oferecemos OEM/ODM com marca personalizada, embalagem e ajustes de especificação conforme os requisitos do projeto. A produção é realizada em nossas próprias linhas de produção sob um sistema de gestão da qualidade ISO 9001.'
	}
];

const valveProducts = [
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Válvula de Gaveta com Assento Elástico (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'Cunha encapsulada em EPDM, fechamento estanque, DN50–DN700'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Válvula Borboleta Ranurada Wafer com Sinal',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp',
		desc: 'DN80 PN16 com interruptor integrado de monitoramento de posição'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'Válvula de Gaveta OS&Y UL/FM (Ranurada)',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: 'Válvula de gaveta de haste ascendente certificada UL/FM, 2"–10", extremidades ranuradas'
	},
	{
		slug: 'spherical-ball-check-valve-hq44x',
		name: 'Válvula de Retenção de Esfera (HQ44X)',
		img: '/assets/products/spherical-ball-check-valve-hq44x.webp',
		desc: 'Baixa perda de carga, design de esfera rolante antientupimento'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Conjunto de Válvula de Dilúvio com Alarme (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Operada a diafragma, DN50–DN300, abertura rápida'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Sistema de Alarme de Pré-Ação (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Disparo duplo de segurança para ambientes sensíveis à água'
	},
	{
		slug: 'wafer-type-butterfly-valve-d71x',
		name: 'Válvula Borboleta Tipo Wafer (D71X)',
		img: '/assets/products/wafer-type-butterfly-valve-d71x.webp',
		desc: 'Borboleta wafer em ferro fundido dúctil com revestimento de borracha, DN50–DN300, opção UL/FM'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Válvula de Retenção de Alarme Molhada (ZSFZ-150)',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'Retenção de alarme para sistema molhado, sino hidráulico + câmara de retardo, DN100–DN200'
	}
];
---

<Layout
	locale="pt"
	title="Válvulas Contra Incêndio Certificadas UL | Fabricante - WLFE"
	description="A WLFE fabrica válvulas contra incêndio certificadas UL: gaveta, borboleta, retenção, dilúvio e pré-ação, com qualidade certificada e cotação rápida."
	type="product"
	productData={{
		name: 'Válvulas Contra Incêndio Certificadas UL',
		image: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		description: 'Válvulas de gaveta, borboleta, de retenção, de dilúvio e de pré-ação certificadas UL para sistemas de proteção contra incêndio, fornecidas por Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Válvulas Contra Incêndio UL' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/pt/" class="hover:text-blue-600">Início</a>
			<span>/</span>
			<a href="/pt/products/" class="hover:text-blue-600">Produtos</a>
			<span>/</span>
			<span class="text-gray-600">Válvulas Contra Incêndio UL</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Válvulas de Proteção Contra Incêndio Certificadas UL</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Válvulas Contra Incêndio Certificadas UL para Sistemas Confiáveis</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">A Wanlian Fluid fabrica válvulas de gaveta, borboleta, de retenção, de dilúvio e de pré-ação certificadas UL para sistemas de proteção contra incêndio comerciais e industriais. Cada válvula é produzida em nossas próprias linhas de produção próximas a Quanzhou sob um sistema de qualidade ISO 9001 — direto da fábrica, com prazos estáveis e documentação de certificação completa para o seu projeto.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Certificado UL/ULC', 'Aprovado FM', 'ISO 9001:2015', 'Direto da Fábrica'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Série de Válvulas Contra Incêndio</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{valveProducts.map(p => (
					<a href={`/pt/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Principais Especificações</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Especificação</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Detalhes</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Normas</td>
							<td class="px-4 py-3 text-gray-700">Certificado UL / ULC, aprovado FM (conforme modelo e mercado de destino)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Faixa de tamanhos</td>
							<td class="px-4 py-3 text-gray-700">DN40 – DN300 (1½" – 12")</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Classe de pressão</td>
							<td class="px-4 py-3 text-gray-700">PN16 / PN25 (conforme modelo)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Material do corpo</td>
							<td class="px-4 py-3 text-gray-700">Ferro fundido dúctil QT450 / WCB / CF8 · CF8M aço inox</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Conexões</td>
							<td class="px-4 py-3 text-gray-700">Flangeada / Ranurada / Roscada</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Meio</td>
							<td class="px-4 py-3 text-gray-700">Água, solução de espuma</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplicações</h2>
			<p class="text-gray-700 leading-relaxed">Nossas válvulas contra incêndio UL são instaladas em sistemas de rociadores de edifícios comerciais, plantas industriais, centros de armazenagem e logística, data centers e redes de proteção contra incêndio petroquímicas — onde o controle de vazão certificado e confiável é um requisito normativo.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Por Que Escolher a Wanlian Fluid</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Qualidade certificada</strong> — certificados UL/ULC e FM publicados em nossa <a href="/pt/certificates/" class="text-brand-blue font-semibold hover:underline">página de certificados</a>, verificáveis antes do seu pedido.</li>
				<li><strong>Direto da fábrica</strong> — prazos estáveis, suporte OEM/ODM e assistência técnica na seleção.</li>
				<li><strong>Uma ordem, uma fábrica</strong> — válvulas enviadas com rociadores, hidrantes e acessórios para o circuito completo de supressão.</li>
			</ul>

			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Novo nas Normas de Válvulas?</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Comece com nosso guia para compradores: <a href="/pt/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">Hidrantes, Mangueiras Contra Incêndio &amp; Normas de Válvulas Explicados</a>.</p>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Perguntas Frequentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Precisa de Válvulas UL para o Seu Projeto?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envie-nos o tipo de válvula, DN/PN e a certificação alvo — nossos engenheiros respondem com uma datasheet completa e cotação em até 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/pt/contact/?product=V%C3%A1lvulas%20Contra%20Inc%C3%AAndio%20UL" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotação</a>
						<a href="https://wa.me/8618684324501?text=Ol%C3%A1%2C%20preciso%20de%20v%C3%A1lvulas%20contra%20inc%C3%AAndio%20certificadas%20UL" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Falar no WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
