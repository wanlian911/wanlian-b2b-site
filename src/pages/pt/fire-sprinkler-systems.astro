---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Seus rociadores possuem certificação UL?',
		answer: 'Sim. Nossos rociadores e componentes de sistema possuem certificação UL/ULC quando aplicável — os certificados estão disponíveis em nossa página de Certificados. Nossos engenheiros confirmam o pacote de certificação exato para o seu mercado de destino antes da cotação.'
	},
	{
		question: 'Qual é a diferença entre sistemas de rociadores molhado e seco?',
		answer: 'Sistemas molhados mantêm água nas tubulações para descarga imediata quando um rociador é acionado. Sistemas secos usam ar ou nitrogênio pressurizados com válvula de tubulação seca, sendo adequados a espaços sem aquecimento onde o congelamento das tubulações é um risco. Sistemas de pré-ação combinam os dois benefícios para áreas sensíveis à água.'
	},
	{
		question: 'Vocês fornecem conexões flexíveis de queda para rociadores?',
		answer: 'Sim, fabricamos conexões de queda flexíveis em aço inox trançado que simplificam a instalação e permitem reposicionamento rápido dos rociadores conforme o layout do teto — reduzindo o tempo de mão de obra em comparação com tubulações rígidas.'
	},
	{
		question: 'Vocês podem fornecer cotação completa BOM do sistema?',
		answer: 'Sim. Envie-nos seus desenhos de projeto ou a lista de componentes e cotaremos rociadores, válvulas de alarme, indicadores de vazão, filtros e acessórios como um único pacote — uma única ordem de fábrica para o circuito completo de rociadores.'
	},
	{
		question: 'Quais classes de temperatura estão disponíveis?',
		answer: 'As classes padrão de bulbo de vidro incluem 57°C, 68°C, 79°C, 93°C e 141°C com bulbos de cores codificadas, em tipos de resposta padrão (bulbo 5mm) e rápida (bulbo 3mm) conforme a prática NFPA.'
	}
];

const sprinklerProducts = [
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'Rociador de Bulbo de Vidro (Série ZST)',
		img: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		desc: 'Pendente/em pé/parede lateral, K=80/115, 57–141°C'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Válvula de Retenção de Alarme Molhada (ZSFZ 150)',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'Sino de alarme hidráulico, câmara de retardo, DN100–DN200'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Conjunto de Válvula de Dilúvio com Alarme (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Operada a diafragma, para sistemas de dilúvio e jato de água'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Sistema de Alarme de Pré-Ação (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Disparo duplo de segurança para bibliotecas, arquivos, data centers'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Indicador de Vazão de Água a Pás (ZSJZ)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'Atraso ajustável 2–60s, DN50–DN200, abraçadeira/flange'
	},
	{
		slug: 'telescopic-y-strainer-sgl41h',
		name: 'Filtro em Y Telescópico (SGL41H)',
		img: '/assets/products/telescopic-y-strainer-sgl41h.webp',
		desc: 'Protege válvulas contra partículas, tela SS304/316'
	},
	{
		slug: 'horizontal-sidewall-fire-sprinkler-t-zstbs',
		name: 'Rociador de Parede Lateral Horizontal (T-ZSTBS)',
		img: '/assets/products/horizontal-sidewall-fire-sprinkler-t-zstbs.png',
		desc: 'Cabeça T de parede lateral, K=80/115, para proteção sob vigas e estantes'
	},
	{
		slug: 'zstdy-concealed-fire-sprinkler',
		name: 'Rociador Embutido (ZST-DY)',
		img: '/assets/products/zstdy-concealed-fire-sprinkler.webp',
		desc: 'Cabeça decorativa embutida, placa de acabamento combinada para tetos revestidos'
	},
	{
		slug: 'indoor-fire-hydrant-head-sn65',
		name: 'Boca de Incêndio Interna (SN65)',
		img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg',
		desc: 'Bocal de coluna interna DN65 para estações contra incêndio em edifícios'
	}
];
---

<Layout
	locale="pt"
	title="Sistemas de Rociadores & Rociadores Certificados UL - WLFE"
	description="Rociadores certificados UL, conexões flexíveis e componentes de sistemas de rociadores contra incêndio para edifícios comerciais e industriais. Fábrica."
	type="product"
	productData={{
		name: 'Sistemas de Rociadores',
		image: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		description: 'Rociadores certificados UL, válvulas de alarme, indicadores de vazão e componentes de sistema para sistemas de rociadores molhados, secos e de pré-ação em edifícios comerciais e industriais, fabricados por Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Sistemas de Rociadores' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/pt/" class="hover:text-blue-600">Início</a>
			<span>/</span>
			<a href="/pt/products/" class="hover:text-blue-600">Produtos</a>
			<span>/</span>
			<span class="text-gray-600">Sistemas de Rociadores</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Sistemas de Rociadores Completos — Direto da Fábrica</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Sistemas Completos de Rociadores com Componentes Certificados UL</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">A Wanlian Fluid fabrica e exporta rociadores certificados UL, conexões flexíveis de queda, válvulas de alarme e acessórios de sistema para instalações molhadas, secas e de pré-ação em edifícios comerciais e industriais — uma única ordem de fábrica para o circuito completo de rociadores.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Certificado UL/ULC', 'K=80 / K=115', 'Classes 57–141°C', 'BOM do Sistema Completo'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Componentes dos Sistemas de Rociadores</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{sprinklerProducts.map(p => (
					<a href={`/pt/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Principais Especificações</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Especificação</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Detalhes</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Certificação</td>
							<td class="px-4 py-3 text-gray-700">Certificado UL/ULC (conforme modelo e mercado de destino)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Tamanhos dos rociadores</td>
							<td class="px-4 py-3 text-gray-700">1/2" (DN15), 3/4" (DN20), 1" — pendente, em pé, parede lateral</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Coeficiente de vazão</td>
							<td class="px-4 py-3 text-gray-700">K=80 ±4 / K=115 ±9 (outros fatores K conforme modelo)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Classes de temperatura</td>
							<td class="px-4 py-3 text-gray-700">57°C / 68°C / 79°C / 93°C / 141°C, bulbos de vidro coloridos</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Tipos de resposta</td>
							<td class="px-4 py-3 text-gray-700">Resposta padrão (bulbo 5mm) / Rápida (bulbo 3mm)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Válvulas de sistema</td>
							<td class="px-4 py-3 text-gray-700">Alarme molhado (ZSFZ), dilúvio (ZSFM), pré-ação (ZSFY), indicadores de vazão (ZSJZ)</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplicações</h2>
			<p class="text-gray-700 leading-relaxed">Nossos componentes de sistemas de rociadores protegem edifícios comerciais, hotéis, hospitais, escolas, fábricas, armazéns, data centers e estacionamentos subterrâneos — com sistemas de pré-ação recomendados para bibliotecas, arquivos e salas de computação onde descargas acidentais devem ser evitadas.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Por Que Escolher a Wanlian Fluid</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Sistema completo, uma única ordem</strong> — rociadores, conexões, válvulas de alarme e acessórios cotados como um único pacote de uma única fábrica.</li>
				<li><strong>Componentes certificados</strong> — certificados UL/ULC quando aplicável; certificados em nossa <a href="/pt/certificates/" class="text-brand-blue font-semibold hover:underline">página de certificados</a>.</li>
				<li><strong>Alinhado às normas de construção</strong> — configurações conformes com a prática NFPA para aceitação de projetos globais.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Perguntas Frequentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Precisa de Componentes de Sistema de Rociadores?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envie-nos o tipo do seu edifício e a lista de componentes — respondemos com uma cotação BOM completa em até 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/pt/contact/?product=Sistemas%20de%20Rociadores" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotação</a>
						<a href="https://wa.me/8618684324501?text=Ol%C3%A1%2C%20preciso%20de%20componentes%20de%20sistema%20de%20rociadores%20contra%20inc%C3%AAndio" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Falar no WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
