---
import Layout from '../../layouts/Layout.astro';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';

const productName = Astro.url.searchParams.get('product') || "";
---

<Layout locale="pt" title="Contato e Cotação B2B | Quanzhou Wanlian Fluid" description="Solicite uma cotação B2B de válvulas industriais e equipamentos contra incêndio. Envie especificações e desenhos — nossa equipe responde em até 12 horas.">
  <main id="inquiry" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Contato e Consulta</span>
      <h1 class="text-4xl font-black text-gray-900 tracking-tight">Solicite uma Cotação Profissional</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
         Compartilhe seus requisitos de produto, normas, tamanhos e aplicação-alvo. Nossa equipe de vendas e engenharia revisará os detalhes e responderá com os próximos passos.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
      <!-- Informações de Contato -->
      <div class="space-y-8">
        <div>
          <h3 class="text-xs font-bold text-gray-400 tracking-widest uppercase mb-2">Localização da Empresa</h3>
           <p class="text-lg font-bold text-gray-900">Quanzhou Wanlian Fluid Equipment Co., Ltd.</p>
           <p class="text-gray-500 mt-2 text-sm leading-relaxed">
             Quanzhou, Fujian Province, China
           </p>
        </div>

        <div>
          <h3 class="text-xs font-bold text-gray-400 tracking-widest uppercase mb-3">Canais Diretos</h3>
          <ul class="space-y-3 text-sm text-gray-600">
            <li class="flex items-center">
              <span class="font-semibold text-gray-900 w-20">E-mail de Vendas:</span>
              <a href="mailto:sales@wanlian911.com" class="text-blue-600 hover:underline">sales@wanlian911.com</a>
            </li>
            <li class="flex items-center">
              <span class="font-semibold text-gray-900 w-20">Linha Direta:</span>
              <a href="tel:+8618684324501" class="text-blue-600 hover:underline">+86 186 8432 4501</a>
            </li>
            <li class="flex items-center">
              <span class="font-semibold text-gray-900 w-20">WhatsApp:</span>
              <a href="https://wa.me/8618684324501" target="_blank" rel="noopener noreferrer" class="text-green-600 font-bold hover:underline">+86 186 8432 4501</a>
            </li>
          </ul>
        </div>

        <div class="bg-blue-50/50 p-8 rounded-xl border border-blue-100/50 space-y-4">
          <h3 class="font-bold text-blue-900 text-base">Por que Parceriar com a Wanlian?</h3>
          <ul class="space-y-3 text-sm text-blue-700 font-medium">
              <li class="flex items-center gap-2">
               <span class="text-blue-500 font-bold">✓</span> Suporte na seleção de produtos para sistemas fluidos
              </li>
              <li class="flex items-center gap-2">
                <span class="text-blue-500 font-bold">✓</span> Requisitos OEM/ODM podem ser discutidos
              </li>
              <li class="flex items-center gap-2">
                <span class="text-blue-500 font-bold">✓</span> Suporte com especificações e documentação de produtos
              </li>
              <li class="flex items-center gap-2">
                <span class="text-blue-500 font-bold">✓</span> Coordenação de embalagem e frete para exportação
              </li>
          </ul>
        </div>
      </div>

      <!-- Área do Formulário -->
      <div class="lg:col-span-2 bg-white p-10 rounded-2xl border border-gray-100 shadow-sm">
        <h2 class="text-xl font-bold text-gray-900 mb-6">Enviar RFQ / Formulário de Consulta</h2>
        <InquiryForm productName={productName} />
      </div>
    </div>
  </main>
</Layout>
