---
import Layout from '../../layouts/Layout.astro';

const certifications = [
  {
    name: 'ISO 9001:2015',
    code: 'EM NOSSO NOME',
    desc: 'Sistema de gestão da qualidade mantido pela Wanlian para o controle de seus processos comerciais e técnicos.',
    scope: 'Evidência própria para a organização e seus processos; o escopo exato deve ser confirmado na documentação vigente.',
    products: 'Processos e produtos cobertos pela documentação aplicável',
    verify: 'Solicite a documentação vigente para confirmar o escopo, a validade e os detalhes de verificação.',
    icon: '⚙️'
  },
  {
    name: 'Registros de ensaio por lote',
    code: 'EM NOSSO NOME',
    desc: 'Registros próprios de ensaios de pressão do corpo e de vazamento associados a cada lote.',
    scope: 'Evidência de ensaio preparada e reconciliada pela Wanlian com lote, modelo e documentação de expedição.',
    products: 'Válvulas e equipamentos incluídos no lote fornecido',
    verify: 'Os registros e a rastreabilidade do lote são fornecidos com a documentação do pedido, conforme aplicável.',
    icon: '🧪'
  },
  {
    name: 'Base de projeto e ensaio',
    code: 'BASE DE PROJETO E ENSAIO',
    desc: 'Referências técnicas usadas como base de projeto e ensaio, sem apresentar uma listagem como credencial própria.',
    scope: 'EN 12266-1 / GB 5135 como referências técnicas aplicáveis ao projeto e aos ensaios do produto.',
    products: 'Válvulas e equipamentos conforme o escopo técnico do modelo',
    verify: 'Confirme o modelo, a norma aplicável e o relatório de ensaio correspondente antes do pedido.',
    icon: '📐'
  },
  {
    name: 'Listagem UL da fábrica produtora',
    code: 'DE TITULARIDADE DA FÁBRICA PRODUTORA',
    desc: 'Referência a listagens UL 262 / UL 1091 pertencentes à fábrica produtora, não à Wanlian.',
    scope: 'UL 262 / UL 1091 somente dentro do escopo e dos modelos listados pela fábrica titular.',
    products: 'Modelos da fábrica produtora indicados no documento correspondente',
    verify: 'A Wanlian não possui listagens UL e não as apresenta em nome próprio. Confirme o titular e o modelo no documento.',
    icon: '🏆'
  },
  {
    name: 'Aprovação FM da fábrica produtora',
    code: 'DE TITULARIDADE DA FÁBRICA PRODUTORA',
    desc: 'Referência a FM Class 1120 / 1130 pertencente à fábrica produtora, não uma credencial da Wanlian.',
    scope: 'FM Class 1120 / 1130 somente dentro do escopo e dos modelos aprovados para a fábrica titular.',
    products: 'Modelos da fábrica produtora indicados no documento FM correspondente',
    verify: 'Não apresentamos uma aprovação FM como credencial da Wanlian. Verifique o titular, o modelo e o escopo.',
    icon: '🛡️'
  },
  {
    name: 'LPCB RedBook da fábrica produtora',
    code: 'DE TITULARIDADE DA FÁBRICA PRODUTORA',
    desc: 'Referência a uma listagem LPCB RedBook pertencente à fábrica produtora, não à Wanlian.',
    scope: 'LPCB RedBook somente dentro do escopo e dos produtos listados para a fábrica titular.',
    products: 'Produtos da fábrica produtora indicados na entrada RedBook correspondente',
    verify: 'Confirme o titular, o número da entrada, o modelo e o escopo diretamente na documentação aplicável.',
    icon: '📜'
  }
];

const faq = [
  {
    question: 'A Wanlian possui ISO 9001:2015 em seu próprio nome?',
    answer: 'Sim — a documentação própria da Wanlian e seu escopo vigente devem ser confirmados antes do pedido; fornecemos os registros aplicáveis para verificação.'
  },
  {
    question: 'A Wanlian possui listagens UL ou aprovação FM?',
    answer: 'Não — essas listagens pertencem às fábricas que as detêm, não à Wanlian. A Wanlian não possui listagens UL e não as apresenta em nome próprio. Não apresentamos uma aprovação FM como credencial da Wanlian.'
  },
  {
    question: 'O que significa a base de projeto e ensaio?',
    answer: 'EN 12266-1 / GB 5135 são referências técnicas de projeto e ensaio. Elas não devem ser interpretadas como uma listagem ou certificação própria da Wanlian.'
  },
  {
    question: 'Como posso verificar o titular de cada documento?',
    answer: 'Compare o nome do titular, o fabricante, o modelo, o número do documento, o escopo e a validade com o documento emitido ou com os registros do lote fornecido.'
  },
  {
    question: 'Vocês fornecem registros de ensaio por lote?',
    answer: 'Sim — fornecemos registros próprios de ensaio de pressão do corpo e de vazamento, reconciliados com o lote e a documentação de expedição, conforme aplicável.'
  }
];
---

<Layout
  locale="pt"
  title="Documentação Técnica & Certificados | Wanlian Fluid"
  description="Solicite documentação técnica, laudos de teste, opções de material e suporte de exportação para válvulas e equipamentos contra incêndio da Wanlian Fluid."
  faq={faq}
  breadcrumbs={[{ name: 'Certificados' }]}
>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
         Documentação <span class="text-brand-red">técnica.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
         Compartilhe os requisitos do seu projeto e forneceremos as informações disponíveis de produto, as especificações técnicas e a documentação para avaliação.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p>
            <div class="space-y-3 text-sm text-gray-600">
              <p><span class="font-bold text-gray-900">Escopo: </span>{cert.scope}</p>
              <p><span class="font-bold text-gray-900">Produtos cobertos: </span>{cert.products}</p>
              <p class="text-xs text-gray-500 leading-relaxed border-t border-gray-200 pt-3">{cert.verify}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-6">
        <h2 class="text-3xl font-black">Precisa de Cópias de Certificados ou Fichas Técnicas?</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          Fornecemos cópias de certificados, laudos de teste hidrostático, fichas técnicas, desenhos CAD e manuais de instalação para nossa linha de produtos sob solicitação. Especifique a certificação, o modelo do produto e o seu mercado de destino para que possamos confirmar o escopo aplicável.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a href="/pt/contact/?product=Solicita%C3%A7%C3%A3o%20de%20Certificados%20e%20Documenta%C3%A7%C3%A3o%20T%C3%A9cnica" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
            Solicitar Certificados e Documentos
          </a>
          <a href="/pt/products/" class="inline-block px-10 py-5 bg-white/10 border border-gray-600 text-white font-black rounded-xl hover:bg-white/20 transition">
            Ver Produtos Certificados
          </a>
        </div>
        <p class="text-xs text-gray-500 pt-2">
          A certificação se aplica aos produtos, modelos e escopos específicos indicados em cada certificado. Nossos engenheiros confirmarão a cobertura de modelos antes do seu pedido.
        </p>
      </div>
    </div>
  </section>

  <!-- Perguntas Frequentes -->
  <section class="py-24 bg-gray-50 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">FAQ</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Perguntas Frequentes</h2>
      </div>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-white rounded-xl border border-gray-100 p-6 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
