---
import Layout from '../../../layouts/Layout.astro';
import { productsAr } from '../../../utils/products.ar';

// Get all unique categories
const ALL = 'الكل';
const categories = [ALL, ...new Set(productsAr.map(p => p.category))];

// 目录级采购 FAQ（同时输出 FAQPage JSON-LD）
const faqs = [
  { question: 'هل النطاق المعروض على هذه الصفحة هو الكتالوج الكامل؟', answer: 'تعرض هذه الصفحة أكثر من 43 نموذجًا متوفرًا عبر الصمامات والخلاطات وصمامات أنظمة الرش وبكرات المران والطفايات ومدافع المياه. نطاق الإنتاج لدينا أوسع — إذا لم تجد النموذج أو الحجم أو المادة المطلوبة بالضبط، أرسل الاستفسار وسيتحقق مهندسونا من التوفر والبدائل المطابقة.' },
  { question: 'ما الحد الأدنى للطلب للصمامات ومعدات الحماية من الحريق؟', answer: 'الحد الأدنى القياسي للطلب عادةً 20 وحدة لكل نموذج للأحجام المتوفرة، مع مدد توريد إنتاجية 15-30 يومًا حسب الكمية والتخصيص. الطلبات النموذجية متاحة للاختبار والمصادقة قبل الشحن.' },
  { question: 'هل يمكن تخصيص المنتجات لمعايير التصدير والاتصالات؟', answer: 'نعم. يمكن تصنيع الصمامات والخلاطات حسب مواصفات GB أو ANSI أو DIN أو JIS أو BS أو EN مع اتصالات بفلنجة أو بمسار أو وافر أو مسنّنة. يمكن مطابقة المواد والطلاءات والشهادات (UL/FM/CE على النماذج المطبقة) مع مواصفات مشروعك.' },
  { question: 'ما الوثائق التي تزودونها مع الطلب؟', answer: 'يشمل كل شحن المستندات التجارية بالإضافة إلى تقارير اختبار بالدفعة مطابقة للمعيار المطبق. يمكن ترتيب شهادات ISO 9001 وشهادات المواد وتقارير الفحص من طرف ثالث وتسميتها في أمر الشراء.' },
  { question: 'كيف أطلب عرض سعر؟', answer: 'استخدم نموذج الاستفسار على صفحة الاتصال وشمل النموذج والحجم وتصنيف الضغط ونوع الاتصال والكمية وجهة الوصول. يستجيب فريق المبيعات والهندسة خلال 12 ساعة بالمواصفات والسعر ومدة التوريد.' }
];
---

<Layout title="كتالوج المنتجات | صمامات صناعية ومعدات حماية حريق" description="تصفح كتالوج Wanlian Fluid لـ B2B: أكثر من 43 نموذجًا متوفرًا من الصمامات الصناعية وخلاطات الحريق والرؤوس وبكرات المران والصمامات الهيدروليكية. تسعير حسب الاستفسار." faq={faqs} locale="ar">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-600 uppercase">مركز المنتجات</span>
      <h1 class="text-4xl font-black text-gray-900 tracking-tight">كتالوج أنظمة السوائل الفاخر لدينا</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
        مكونات عالية الأداء مهندسة لأقصى موثوقية ومتانة وسلامة عبر الشبكات الصناعية.
      </p>
    </div>

    <!-- Browse by System: 系统级页面入口 -->
    <div class="flex flex-wrap justify-center items-center gap-2 mb-10">
      <span class="text-[11px] font-black uppercase tracking-widest text-gray-400 me-1">تصفح حسب النظام:</span>
      <a href="/ar/fire-hydrant-systems/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600 hover:border-brand-red hover:text-brand-red transition">أنظمة خلاط الحريق</a>
      <a href="/ar/fire-sprinkler-systems/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600 hover:border-brand-red hover:text-brand-red transition">أنظمة رش الحريق</a>
      <a href="/ar/fire-water-cannon/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600 hover:border-brand-red hover:text-brand-red transition">مدافع مياه الحريق</a>
      <a href="/ar/backflow-prevention/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600 hover:border-brand-red hover:text-brand-red transition">منع الارتداد</a>
      <a href="/ar/ul-fire-valves/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600 hover:border-brand-red hover:text-brand-red transition">صمامات الحريق المعتمدة UL</a>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap justify-center gap-2 mb-12" id="filter-container">
      {categories.map((category) => (
        <button
          data-category={category}
          class="px-5 py-2.5 rounded-lg text-sm font-semibold tracking-wide border border-gray-200 text-gray-600 bg-white hover:border-blue-500 hover:text-blue-600 transition cursor-pointer filter-btn [&.active]:bg-blue-600 [&.active]:text-white [&.active]:border-blue-600"
        >
          {category}
        </button>
      ))}
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="products-grid">
      {productsAr.map((product) => (
        <div 
          data-product-category={product.category}
          class="group bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-all duration-300 flex flex-col product-card"
        >
          <div class="aspect-square relative overflow-hidden bg-white">
            <img 
              src={product.image} 
              alt={product.name} 
              loading="lazy"
              class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-3 start-3 px-2.5 py-1 text-[10px] font-bold tracking-widest bg-gray-900/90 text-white rounded-md uppercase">
              {product.category}
            </span>
          </div>
          <div class="p-6 flex-grow flex flex-col space-y-3">
            <h2 class="text-lg font-bold text-gray-900 line-clamp-2 min-h-[3rem] group-hover:text-blue-600 transition">
              {product.name}
            </h2>
            <p class="text-gray-500 text-xs line-clamp-3 leading-relaxed flex-grow">
              {product.description}
            </p>
            <div class="pt-6 border-t border-gray-100 flex items-center justify-between gap-4">
              <a 
                href={`/ar/products/${product.slug}/`} 
                class="text-blue-600 text-sm font-bold hover:text-blue-700 inline-flex items-center gap-1 group/btn"
              >
                عرض المواصفات
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover/btn:-translate-x-1 rtl:group-hover/btn:translate-x-1 transition" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
              <a 
                href={`/ar/contact/?product=${encodeURIComponent(product.name)}`} 
                class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-lg transition"
              >
                استفسر
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Catalog FAQ Section -->
    <section class="mt-24 max-w-4xl mx-auto">
      <h2 class="text-3xl font-black text-gray-900 mb-8 text-center">أسئلة شائعة عن كتالوج المنتجات</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="group bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-5 font-bold text-gray-900 hover:bg-gray-50 transition list-none">
              <span>{faq.question}</span>
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-45 transition-transform flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600 leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <!-- Client-side filtering script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const ALL = 'الكل';
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.product-card');

      const applyFilter = (category) => {
        buttons.forEach(b => b.classList.toggle('active', b.getAttribute('data-category') === category));
        cards.forEach(card => {
          const cardCategory = card.getAttribute('data-product-category');
          card.style.display = (category === ALL || cardCategory === category) ? 'flex' : 'none';
        });
      };

      // Set 'All' button as active initially
      applyFilter(ALL);

      // Support /ar/products/#category=xxx deep links (keeps URLs out of the indexable query string)
      const hashMatch = window.location.hash.match(/^#category=(.+)$/);
      if (hashMatch) {
        const target = decodeURIComponent(hashMatch[1]);
        if ([...buttons].some(b => b.getAttribute('data-category') === target)) {
          applyFilter(target);
        }
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          applyFilter(btn.getAttribute('data-category'));
        });
      });
    });
  </script>
</Layout>
