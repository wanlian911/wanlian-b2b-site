---
import Layout from '../../../layouts/Layout.astro';
import WhatsAppButton from '../../../components/shared/WhatsAppButton.astro';
import { productsAr, productsArBySlug } from '../../../utils/products.ar';

export async function getStaticPaths() {
  return Object.values(productsArBySlug).map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

// 按分类生成通用采购 FAQ（数据来源：产品规格与常见询盘问题）
const faqByCategory: Record<string, { question: string; answer: string }[]> = {
  'صمامات وقطع الغيار': [
    { question: 'ما المعايير وأنواع الاتصالات المتوفرة لصمامات Wanlian؟', answer: 'تُصنع صمامات Wanlian حسب الطلب وفق معايير GB وANSI وDIN وJIS. تتوفر اتصالات بفلنجة وبمسار ووافر ومسنّنة حسب النموذج. أخبر مهندسينا بـ DN/PN ونوع الاتصال في الاستفسار وسنتحقق من التهيئة المطابقة.' },
    { question: 'ما المواد المستخدمة لجسم الصمام والإحكام؟', answer: 'الأجسام عادةً من حديد الزهر المطبوع (QT450) أو حديد الزهر أو الفولاذ المصبوب/المصبوب حسب النموذج. عناصر الإحكام تستخدم مطاط EPDM أو NBR، والأعمدة من الفولاذ المقاوم للصدأ (2Cr13/304). يمكن تخصيص خيارات المواد لوسائط ونطاقات حرارة محددة.' },
    { question: 'ما الحد الأدنى للطلب ومدة التوريد؟', answer: 'الحد الأدنى القياسي للطلب عادةً 20 وحدة لكل نموذج للأحجام المتوفرة، مع مدد توريد إنتاجية 15-30 يومًا حسب الكمية والتخصيص. الطلبات النموذجية متاحة للاختبار قبل الشحن.' },
    { question: 'كيف تُختبر الصمامات قبل الشحن؟', answer: 'تخضع كل صمام لاختبار 100% لضغط الغلاف والمقعد وفقًا للمعيار المطبق (مثل GB/T13927، EN 12266-1). يمكن ترتيب تقارير الاختبار والفحص من طرف ثالث حسب الطلب.' }
  ],
  'خلاط الحريق واتصالات المضخات': [
    { question: 'ما معايير مخرج الاتصال المتوفرة لخلاطات الحريق المصدرة؟', answer: 'تشمل اتصالات المخرج الشائعة BS336 (بريطانيا/الكومنولث) وNIST (الشرق الأوسط) وKWS (ألمانيا) وخيارات بفلنجة مرنة. يمكننا تزويد خلاطات بنوع الاتصال المحدد لسوقك.' },
    { question: 'ما تصنيف الضغط الذي يجب أن يكون لدى خلاط الحريق البلدي؟', answer: 'خلاطات البلديات القياسية مصنفة بـ PN16 (1.6 MPa)، مما يغطي معظم شبكات إمداد المياه الحضرية والصناعية. قد تتطلب مناطق المباني الشاهقة أو الصناعية عالية الطلب خلاطات PN25.' },
    { question: 'هل خلاطات Wanlian متوفرة بشهادة UL أو FM؟', answer: 'نعم، حسب النموذج وسوق الوجهة. تواصل مع فريق المبيعات بمواصفات مشروعك والمنطقة المستهدفة لنطابق حزمة الشهادات الصحيحة.' },
    { question: 'هل للخلاطات الخارجية حماية من التجمد؟', answer: 'نماذج مثل خلاط SS100 الخارجي تتميز بآلية تصريف صقيع آلية للمناخات الباردة. تتوفر أيضًا متغيرات مضادة للاصطدام (SSFT100) وذكية IoT (SS100ZN).' }
  ],
  'رؤوس رش الحريق وصمامات الإنذار': [
    { question: 'ما الفرق بين صمام الإنذار الرطب وصمام الرش الشامل؟', answer: 'صمام الإنذار الرطب (ZSFZ) يحافظ على أنابيب الرش ممتلئة بالماء ويطلق الإنذار عند تدفق الماء. صمام الرش الشامل (ZSFM) يبقى مغلقًا تحت ضغط الهواء أو الماء ويغمر النظام فقط عند فتح إشارة كشف الحريق - يُستخدم للمناطق عالية الخطورة التي تتطلب تفريغ ماء كبير فوريًا.' },
    { question: 'ما المعايير التي تلتزم بها مكونات نظام الرش؟', answer: 'تُصنع المكونات وتُختبر وفقًا لسلسلة GB 5135، كما يمكن، حسب الطلب، مطابقة معايير دولية أخرى. تحقق من المعيار المطبق لمشروعك مع مهندسينا.' },
    { question: 'ما ضغط التشغيل لصمامات الإنذار؟', answer: 'ضغط التشغيل القياسي 1.6 MPa مع ضغط اختبار 3.2 MPa. نطاقات الأحجام تغطي عادةً من DN50 إلى DN300 حسب النموذج.' },
    { question: 'هل يمكن دمج مجموعات صمامات الإنذار مع أنظمة كشف الحريق الحالية؟', answer: 'نعم. تدعم صمامات الرش الشامل والفعل المسبق مشغلات عن بعد ميكانيكية أو هوائية أو كهربائية (كهرومغناطيسي DC24V) ويمكن دمجها مع معظم لوحات التحكم في إنذارات الحريق.' }
  ],
  'السلامة الهيدروليكية': [
    { question: 'هل تتطلب صمامات التحكم الهيدروليكية طاقة كهربائية؟', answer: 'معظم صمامات التحكم الهيدروليكي (مثل F745X التحكم بالمستوى، 500X خفض الضغط) ذاتية التشغيل بالكامل بضغط الأنبوب ولا تتطلب طاقة خارجية. نماذج التحكم الكهرومغناطيسي مثل GKZF-1 تستخدم AC220V أو DC24V.' },
    { question: 'ما نطاق ضبط الضغط لصمام 500X؟', answer: 'صمام خفض الضغط 500X يضبط الضغط السفلي من 0.1 MPa إلى 1.6 MPa ويعمل مع ضغوط مدخل حتى التصنيف الاسمي (PN10/PN16/PN25).' },
    { question: 'ما المواد المستخدمة لتطبيقات مياه الشرب؟', answer: 'لشبكات مياه الشرب، نماذج مثل مانع الارتداد HS41X تستخدم أجسامًا من حديد الزهر المطبوع مع أحكام EPDM وداخليات من الفولاذ المقاوم للصدأ، متوافقة مع متطلبات الصحة GB/T17219.' },
    { question: 'كيف يُمنع صدمة الماء في الصمامات الهيدروليكية؟', answer: 'تُغلق الصمامات المطبوعة بالطيار بسلاسة وبطء، مما يتجنب هزات الضغط المفاجئة. تسمح صمامات الإبرة بضبط سرعة الإغلاق لمطابقة ظروف الأنبوب المحددة.' }
  ],
  'مدافع مياه الإطفاء': [
    { question: 'ما معدلات التدفق ومدى النفاث المتوفرة لمدافع مياه الحريق؟', answer: 'المدافع اليدوية (سلسلة PS) تغطي 20-200 L/s بمدى نفاث 50-110 مترًا. المدافع ذاتية التتبع (سلسلة ZDMS) توفر 5-30 L/s (قابلة للتخصيص حتى 150 L/s) بنطاق مراقبة 40-65م.' },
    { question: 'كيف يكتشف مدفع الحريق ذاتي التتبع الحرائق؟', answer: 'يدمج مدفع ZDMS مجسات الأشعة تحت الحمراء والأشعة فوق البنفسجية للكشف عن الألهب وتتبعها، ثم يحدد الهدف ويفرغ الماء تلقائيًا. يدعم التغطية اليدوية عن بعد عبر PC/تطبيق الجوال أو خزانة مركزية.' },
    { question: 'هل تتوفر نسخ مقاومة للانفجار؟', answer: 'نعم، تتوفر خيارات مقاومة للانفجار (مثل Exde II BT4 Gb) للبيئات البتروكيماوية والخطرة.' },
    { question: 'ما ضغط التشغيل للمدافع؟', answer: 'المدافع اليدوية تعمل عند 0.8-1.2 MPa، والمدافع ذاتية التتبع عند 0.6-0.8 MPa. تحقق من حجم فلنجة المدخل (DN100/DN150/DN200) لنظامك.' }
  ],
  'خزائن الحريق والوحدات الوسيطة': [
    { question: 'ماذا يتضمن طقم بكرة مرن الحريق؟', answer: 'يشمل طقم سلسلة JPS بكرة تثبيت متأرجحة من الفولاذ الكربوني، ومرن PVC مسطح مرن (20/25/30م)، وفوهة رش نحاس/سبائك تدعم أوضاع النفاث المستقيم والضباب.' },
    { question: 'هل تتوفر خزائن حريق بالرغوة لحرائق المواد الكيميائية؟', answer: 'نعم. تدمج خزانة الرغوة PSG30 خزان مركز الرغوة والموزع وبكرة المرن وفوهة الرغوة في وحدة حائطية واحدة - فعالة ضد حرائق الوقود والمواد الكيميائية والمذيبات (الفئة B).' },
    { question: 'ما معايير الاتصال التي تدعمها وصلات مرن الخلاط؟', answer: 'وصلات سلسلة HS متوفرة بـ DN50/DN65 مع مسامير داخلية متوافقة مع وصلات إطفاء الحريق الدولية، مصنعة وفق GB12514 أو معايير المصنع.' },
    { question: 'ما المواد المستخدمة للخزائن وبكرات؟', answer: 'تستخدم الخزائن والبكرات فولاذًا كربونيًا مدرفلًا على البارد بطلاء بودرة أحمر مضاد للتآكل. الفوهات والموزعات من النحاس الأصفر أو سبائك الألومنيوم المعالجة بالكروم.' }
  ]
};

// 按分类映射应用场景与测试标准
const categoryInfo: Record<string, { applications: string[]; testing: string }> = {
  'صمامات وقطع الغيار': {
    applications: ['إمداد وتوزيع المياه', 'شبكات الصرف الصحي والمياه', 'خطوط الأنابيب الصناعية', 'أنظمة HVAC'],
    testing: 'اختبار 100% لضغط الغلاف والمقعد وفق GB/T13927 أو EN 12266-1؛ طلاء راتنج إبوكسي مختبر لمقاومة التآكل.'
  },
  'خلاط الحريق واتصالات المضخات': {
    applications: ['شبكات حماية الحريق البلدية', 'أفنية صناعية ومستودعات', 'أنظمة عمود الماء الداخلي', 'تركيبات خارجية للمناخات الباردة'],
    testing: 'اختبار ضغط هيدروليكي (2.4 MPa نموذجي) واختبار تدفق وفق GB 4452 أو معايير التصدير المطبقة.'
  },
  'رؤوس رش الحريق وصمامات الإنذار': {
    applications: ['أنظمة الرش التلقائية', 'المباني التجارية والسكنية', 'المستودعات الصناعية', 'أنظمة الرش الشامل والفعل المسبق عالية الخطورة'],
    testing: 'اختبار الضغط والتسرب وفق سلسلة GB 5135؛ التحقق من حساسية الإنذار بمفاتيح التدفق وأجراس الإنذار.'
  },
  'السلامة الهيدروليكية': {
    applications: ['تحكم مستوى خزانات المياه', 'إدارة الضغط في شبكات المياه', 'حماية مياه الشرب من الارتداد', 'حماية سحب المضخات'],
    testing: 'اختبارات الوظيفة والضغط وفق المعايير المطبقة؛ اختبار مجموعات الحجاب والإحكام للمتانة.'
  },
  'مدافع مياه الإطفاء': {
    applications: ['المنشآت البتروكيماوية ومزارع الخزانات', 'المطارات ومراكز المعارض', 'المستودعات الكبيرة', 'سيارات الإطفاء وإطفاء الحريق البحري'],
    testing: 'اختبارات التدفق ومدى النفاث والدوران؛ التحقق من النماذج المقاومة للانفجار وفق معايير Ex (اختياري).'
  },
  'خزائن الحريق والوحدات الوسيطة': {
    applications: ['محطات إطفاء داخلية', 'مناطق تخزين الوقود والمواد الكيميائية', 'أنظمة مرن الحريق للمباني', 'التركيبات البحرية والبرية'],
    testing: 'اختبار الضغط والوظيفة للبكرات والفوهات والموزعات؛ التحقق من نسبة تمدد الرغوة حسب النموذج.'
  }
};

// 产品级 FAQ 优先，其次按分类生成通用采购 FAQ
const faqs = product.faqs ?? faqByCategory[product.category] ?? [];
const info = categoryInfo[product.category];
const relatedProducts = productsAr.filter(p => p.category === product.category && p.slug !== product.slug).slice(0, 6);

// 相关指南(GEO 内容)按产品 slug 映射 — 阿语指南下一波，暂指向 EN
const hydrantGuideSlugs = ['overground-fire-hydrant-ss100', 'indoor-fire-hydrant-head-sn65', 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100', 'iot-smart-ground-fire-hydrant-ss100zn'];
const valveGuideSlugs = ['resilient-seat-flanged-gate-valve-z41x', 'telescopic-resilient-seat-gate-valve-z41x-t', 'ul-fm-resilient-seat-osy-gate-valve', 'd381x-16q-grooved-butterfly-valve', 'signal-grooved-wafer-butterfly-valve-dn80', 'spherical-ball-check-valve-hq44x'];
const hoseGuideSlugs = ['fire-hose-pvc-rubber-lining-8-65', 'storz-coupling-2-5inch-aluminum', 'fire-hydrant-hose-coupling-adapter-hs'];
const standardsGuide = { href: '/guides/fire-hydrant-valve-standards-guide/', title: 'Hydrant, Fire Hose & Valve Standards Explained', description: 'AWWA C502, NFPA 1961, EN 14384, ISO 5208 — what each standard means and how to verify compliance in Chinese factories.' };
const avkGuide = { href: '/guides/wanlian-fluid-vs-american-avk/', title: 'Wanlian Fluid vs American AVK', description: 'Which fire hydrant & valve supplier fits your 2026 project? Scope, geography and standards compared side by side.' };

// 按分类默认回链 2 篇指南：确保每个产品页都有到指南的站内链接（阿语指南下一波，暂指 EN）
const guideByCategory: Record<string, { href: string; title: string; description: string }[]> = {
  'صمامات وقطع الغيار': [
    { href: '/guides/gate-valve-vs-butterfly-valve-fire-protection/', title: 'Gate Valve vs Butterfly Valve for Fire Protection Systems', description: 'Sealing, flow, pressure loss and cost compared so you can pick the right isolation valve for fire mains and water networks.' },
    { href: '/guides/check-valve-types-guide/', title: 'Check Valve Types & Selection Guide', description: 'Sliding ball vs swing check — head loss, slam behaviour and the applications each type fits best.' }
  ],
  'خلاط الحريق واتصالات المضخات': [
    { href: '/guides/how-to-choose-a-fire-hydrant/', title: 'How to Choose a Fire Hydrant', description: 'Indoor vs outdoor, dry vs wet barrel, outlet standards and pressure ratings for municipal and industrial projects.' },
    { href: '/guides/fire-hydrant-valve-standards-guide/', title: 'Fire Hydrant, Fire Hose & Valve Standards Explained', description: 'AWWA C502, NFPA 1961, EN 14384, BS 750 — which standard applies to your order and how to verify compliance.' }
  ],
  'رؤوس رش الحريق وصمامات الإنذار': [
    { href: '/guides/fire-sprinkler-control-valve-types/', title: 'Fire Sprinkler Control Valve Types: OS&Y, Butterfly & Check Valves', description: 'The role of each control valve in a sprinkler system and how OS&Y, butterfly and check valves work together.' },
    { href: '/guides/fire-sprinkler-system-wet-dry-preaction/', title: 'Fire Sprinkler Systems: Wet, Dry or Pre-action?', description: 'Compare wet, dry and pre-action sprinkler configurations to match the hazard class of your building.' }
  ],
  'السلامة الهيدروليكية': [
    { href: '/guides/pressure-reducing-valve-guide/', title: 'Pressure Reducing Valve Guide: 500X Hydraulic PRV', description: 'How pilot-operated PRVs protect downstream equipment, adjust set pressure and prevent water hammer.' },
    { href: '/guides/backflow-prevention-guide/', title: 'Backflow Prevention Guide', description: 'When potable water networks need double check assemblies and how HS41X protects against backflow.' }
  ],
  'مدافع مياه الإطفاء': [
    { href: '/guides/fire-water-monitor-selection-guide/', title: 'Fire Water Monitor Selection: Manual vs Auto-Tracking', description: 'Manual PS monitors vs ZDMS auto-tracking cannons — flow, range, control and explosion-proof options.' },
    { href: '/guides/fire-water-cannon-buying-guide/', title: 'Fire Water Cannon Buying Guide', description: 'Fixed, remote or smart? Jet range, flow rate and installation factors for large-space fire suppression.' }
  ],
  'خزائن الحريق والوحدات الوسيطة': [
    { href: '/guides/fire-hose-reel-cabinet-guide/', title: 'Fire Hose Reel & Fire Cabinet Selection Guide', description: 'JPS0.8-19 reels, PSG30 foam cabinets and SN65 hydrant valves — what a complete indoor fire station needs.' },
    { href: '/guides/fire-extinguisher-selection-guide/', title: 'Fire Extinguisher Buying Guide: ABC Dry Powder', description: 'Class A/B/C/E coverage, ISO 7165 ratings and B2B export packaging for portable extinguishers.' }
  ]
};

// 显式 slug 命中优先；未命中的产品按分类回链指南，去重后最多 3 篇
const explicitGuides = hydrantGuideSlugs.includes(product.slug)
  ? [standardsGuide, avkGuide]
  : valveGuideSlugs.includes(product.slug) || hoseGuideSlugs.includes(product.slug)
    ? [standardsGuide]
    : [];
const seenHrefs = new Set(explicitGuides.map(g => g.href));
const relatedGuides = [...explicitGuides, ...(guideByCategory[product.category] ?? []).filter(g => !seenHrefs.has(g.href))].slice(0, 3);
---

<Layout 
  title={product.seoTitle} 
  description={product.seoDescription}
  productData={product}
  type="product"
  locale="ar"
  faq={faqs}
  breadcrumbs={[{ name: 'المنتجات', href: '/ar/products/' }, { name: product.category, href: `/ar/products/#category=${encodeURIComponent(product.category)}` }, { name: product.name }]}
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 mb-20">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-8 flex gap-2">
      <a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
      <span>/</span>
      <a href="/ar/products/" class="hover:text-blue-600">المنتجات</a>
      <span>/</span>
      <a href={`/ar/products/#category=${encodeURIComponent(product.category)}`} class="hover:text-blue-600">{product.category}</a>
      <span>/</span>
      <span class="text-gray-600">{product.name}</span>
    </nav>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Product Image -->
      <div class="relative overflow-hidden bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
        <img 
          src={product.image} 
          alt={product.name} 
          class="w-full h-auto rounded-xl object-contain aspect-square"
        />
        <span aria-hidden="true" class="pointer-events-none select-none absolute inset-0 flex items-center justify-center overflow-hidden">
          <span class="text-7xl font-black tracking-[0.3em] text-brand-blue/[0.06] -rotate-[24deg] whitespace-nowrap">WANLIAN FLUID</span>
        </span>
      </div>

      <!-- Product Details -->
      <div class="space-y-6">
        <div>
          <span class="text-blue-600 font-semibold uppercase tracking-wider text-sm">{product.category}</span>
          <h1 class="text-4xl font-bold text-gray-900 mt-2">{product.name}</h1>
        </div>

        <p class="text-lg text-gray-600 leading-relaxed">
          {product.description}
        </p>

        <div class="space-y-4">
          <h2 class="text-xl font-bold border-b pb-2">الميزات الرئيسية</h2>
          <ul class="grid grid-cols-1 gap-2">
            {product.features.map(feature => (
              <li class="flex items-start">
                <svg class="h-6 w-6 text-green-500 me-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-700">{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-gray-100 p-6 rounded-xl space-y-4">
          <h2 class="text-xl font-bold">المواصفات الفنية</h2>
          <dl class="grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2">
            {Object.entries(product.specs).map(([key, value]) => (
              <div class="border-b border-gray-200 py-2">
                <dt class="text-sm font-medium text-gray-500">{key}</dt>
                <dd class="mt-1 text-sm font-bold text-gray-900">{value}</dd>
              </div>
            ))}
          </dl>
        </div>

        {product.materials && (
          <div class="bg-gray-50 p-6 rounded-xl border border-gray-200/60 space-y-4">
            <h2 class="text-xl font-bold text-gray-900">قائمة الأجزاء والمواد</h2>
            <dl class="grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2">
              {Object.entries(product.materials).map(([part, material]) => (
                <div class="border-b border-gray-200/60 py-2 flex justify-between items-center text-sm">
                  <dt class="font-medium text-gray-500">{part}</dt>
                  <dd class="font-bold text-gray-900 text-end">{material}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {product.dimensions && (
          <div class="bg-white p-6 rounded-xl border border-gray-100 space-y-4 shadow-sm overflow-x-auto">
            <h2 class="text-xl font-bold text-gray-900">دليل الأبعاد القياسية</h2>
            <table class="min-w-full divide-y divide-gray-200 text-sm">
              <thead class="bg-gray-50">
                <tr>
                  {product.dimensions.headers.map(header => (
                    <th class="px-3 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">{header}</th>
                  ))}
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                {product.dimensions.rows.map(row => (
                  <tr class="hover:bg-gray-50/50">
                    {row.map(cell => (
                      <td class="px-3 py-3 text-gray-700 font-medium whitespace-nowrap">{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {info && (
          <div class="space-y-4">
            <div class="bg-blue-50/50 p-6 rounded-xl border border-blue-100/50">
              <h2 class="text-xl font-bold text-gray-900 mb-3">التطبيقات</h2>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                {info.applications.map(app => (
                  <li class="flex items-start text-sm text-gray-700">
                    <svg class="h-5 w-5 text-blue-600 me-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {app}
                  </li>
                ))}
              </ul>
            </div>
            <div class="bg-gray-50 p-6 rounded-xl border border-gray-200/60">
              <h2 class="text-xl font-bold text-gray-900 mb-3">الجودة والاختبارات</h2>
              <p class="text-sm text-gray-700 leading-relaxed">{info.testing}</p>
            </div>
          </div>
        )}

        <div class="flex flex-col sm:flex-row gap-4 pt-6">
          <a 
            href={`/ar/contact/?product=${encodeURIComponent(product.name)}`} 
            class="flex-1 text-center py-4 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition shadow-lg shadow-blue-600/20"
          >
            استفسر الآن
          </a>
          <a 
            href="/ar/contact/?product=Request%20Catalog%20PDF"
            class="flex-1 text-center py-4 bg-white text-blue-600 font-bold border-2 border-blue-600 rounded-xl hover:bg-blue-50 transition"
          >
            اطلب توثيق المنتج
          </a>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    {faqs.length > 0 && (
      <section class="mt-20 max-w-4xl">
        <h2 class="text-3xl font-black text-gray-900 mb-8">أسئلة شائعة</h2>
        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <details class="group bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer px-6 py-5 font-bold text-gray-900 hover:bg-gray-50 transition list-none">
                <span>{faq.question}</span>
                <svg class="w-5 h-5 text-gray-400 group-open:rotate-45 transition-transform flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
              </summary>
              <div class="px-6 pb-6 text-gray-600 leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Guides (GEO content backlinks) -->
    {relatedGuides.length > 0 && (
      <section class="mt-20">
        <h2 class="text-3xl font-black text-gray-900 mb-8">أدلة الشراء ذات الصلة</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedGuides.map(guide => (
            <a href={guide.href} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-6 flex flex-col">
              <span class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-2">دليل شراء</span>
              <h3 class="text-sm font-bold text-gray-900 group-hover:text-brand-blue transition leading-snug">{guide.title}</h3>
              <p class="text-xs text-gray-500 leading-relaxed mt-2 flex-grow">{guide.description}</p>
              <span class="mt-4 inline-flex items-center text-brand-red font-bold text-xs group-hover:gap-1 transition-all">
                اقرأ الدليل
                <svg class="w-3.5 h-3.5 ms-1 rtl:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <section class="mt-20">
        <h2 class="text-3xl font-black text-gray-900 mb-8">منتجات ذات صلة</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {relatedProducts.map(related => (
            <a href={`/ar/products/${related.slug}/`} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-6 flex flex-col">
              <img src={related.image} alt={related.name} class="w-full h-40 object-contain rounded-lg bg-gray-50 p-2 mb-4" loading="lazy" />
              <span class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-2">{related.category}</span>
              <h3 class="text-sm font-bold text-gray-900 group-hover:text-brand-blue transition leading-snug">{related.name}</h3>
              <span class="mt-4 inline-flex items-center text-brand-red font-bold text-xs group-hover:gap-1 transition-all">
                عرض التفاصيل
                <svg class="w-3.5 h-3.5 ms-1 rtl:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
