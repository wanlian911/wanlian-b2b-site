---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'ما مادة الخزان وحماية التآكل التي ينبغي تحديدها؟',
		answer: 'حدّد مادة الخزان والبطانة والطلاء ومتطلبات جودة المياه مع مُصنّع الخزان ومهندس المشروع. تختلف تفاصيل مكافحة التآكل بين الخزانات الفولاذية والمقطعية الفولاذية والخرسانية، ويعتمد الاختيار الصحيح على المياه المخزنة والمناخ والمتطلبات المحلية. اطلب بيانات الطلاء وإمكانية الفحص وتعليمات الصيانة بدل افتراض ملاءمة بطانة عامة لمياه الحريق.'
	},
	{
		question: 'هل يحتاج مانع دوامة الشفط إلى اعتماد لخدمة الحريق؟',
		answer: 'تعتمد الحاجة إلى إدراج أو اعتماد أو قبول خاص بالمشروع على إصدار المعيار المعمول به والجهة المختصة وتجميعة الخزان كاملة. صفيحة منع الدوامة مكوّن حماية هيدروليكي وليست صمام حريق مدرجًا تلقائيًا. أكّد الأدلة المطلوبة للمشروع وقدّم مادتها وأبعادها وتفصيل تركيبها مع مستندات الخزان.'
	},
	{
		question: 'ماذا يحدث عندما يكون عمق غمر الخزان صغيرًا جدًا؟',
		answer: 'قد يسحب الشفط الهواء، أو تتكوّن دوامة مرئية، أو يصبح الجريان صاخبًا وغير مستقر. قد تُظهر المضخة ضغط شفط متذبذبًا أو فقدانًا في التدفق أو اهتزازًا أو أعراضًا شبيهة بالتجويف. افحص منسوب المياه وهندسة المدخل وجريان الاقتراب وتفصيل منع الدوامة وفق إصدار المعيار المعمول به وبيانات مُصنّع المضخة قبل تغيير المضخة.'
	},
	{
		question: 'هل يمكن لخزان واحد خدمة الاستعمال المنزلي ومياه الحريق؟',
		answer: 'قد يكون ذلك ممكنًا، لكن فقط عندما يحافظ الترتيب على احتياطي الحريق المطلوب، ويضمن الفصل أو منسوب السحب المطلوب، وتحصل المنظومة على قبول الجهة المختصة. يجب ألا يسمح مخرج منزلي أو ضبط للتحكم بالمنسوب باستهلاك حجم الحريق المحمي أثناء الاستخدام العادي. أكّد الترتيب الهيدروليكي والمراقبة وضوابط إعادة التعبئة وفق الكود المعمول به.'
	},
	{
		question: 'لماذا يُفضّل صمام البوابة عادةً على شفط المضخة؟',
		answer: 'يوفّر صمام البوابة المفتوح بالكامل ممرًا كامل القطر مع اضطراب قليل قرب مدخل المضخة، ويمكن قفله أو الإشراف على بقائه مفتوحًا. صمام عزل الشفط ليس جهاز خنق. قد يُقبل بديل مدرج في بعض المشاريع، لكن ينبغي لمورّد المضخة ومهندس التصميم والجهة المختصة تأكيد الاختيار قبل الإصدار.'
	},
	{
		question: 'كيف ينبغي حماية خزان الشفط في المناخ البارد؟',
		answer: 'أبقِ الخزان وأنبوب الشفط والصمامات ومعدات التحكم بالمنسوب فوق منسوب خطر التجمد في المشروع، أو وفّر عزلًا هندسيًا وتتبعًا حراريًا وتصريفًا. تعتمد الطريقة الدقيقة على المناخ وبنية الخزان وإصدار المعيار المعمول به. لا يكفي حماية غلاف الخزان وحده إذا كان صمام مكشوف أو خط تحكم أو نقطة منخفضة معرضة للتجمد وتعطيل إمداد مياه الحريق.'
	}
];

const toc = [
	{ id: 'water-source', label: '1. من أين يأتي حجم مياه الحريق؟' },
	{ id: 'tank-sizing', label: '2. تحديد احتياطي مياه الحريق' },
	{ id: 'two-suction', label: '3. قاعدة الشفطين واختراقات الخزان' },
	{ id: 'vortex', label: '4. منع الدوامة وتخطيط أنبوب الشفط' },
	{ id: 'level-control', label: '5. إبقاء الخزان ممتلئًا: التحكم بالمنسوب' },
	{ id: 'priming-testing', label: '6. تعبئة وتنفيـس الشفط والمانومترات وتجهيزات الاختبار' },
	{ id: 'checklist', label: '7. قائمة فحص ترتيب الشفط' },
	{ id: 'faq', label: 'الأسئلة الشائعة' }
];

const products = [
	{ slug: 'suction-vortex-preventer-en12845', name: 'مانع دوامة شفط (EN 12845)', img: '/assets/products/suction-vortex-preventer-en12845.webp', desc: 'تجميعة صفيحة منع دوامة من الفولاذ المقاوم للصدأ الأوستنيتي' },
	{ slug: 'hydraulic-water-level-control-valve-f745x', name: 'صمام هيدروليكي للتحكم بمنسوب المياه (F745X)', img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp', desc: 'حفاظ على المنسوب بتشغيل تجريبي وإغلاق سلس' },
	{ slug: 'remote-control-float-valve-100x', name: 'صمام عوّامة للتحكم عن بُعد (100X-16P)', img: '/assets/products/remote-control-float-valve-100x.webp', desc: 'صمام تجريبي بعوّامة من الفولاذ لإعادة تعبئة الخزان' },
	{ slug: 'telescopic-y-strainer-sgl41h', name: 'مصفاة Y متلسكوبية (SGL41H)', img: '/assets/products/telescopic-y-strainer-sgl41h.webp', desc: 'حماية خط الشفط من الحطام، قابلة للتنظيف داخل الخط' }
];
---

<Layout
	title="ترتيب شفط مضخة الحريق وخزان مياه الحريق (2026)"
	description="تحديد حجم خزان مياه الحريق، وقواعد الشفطين، ومنع الدوامة، والتعبئة والتحكم بالمنسوب لترتيب شفط مضخة حريق مطابق."
	type="article"
	locale="ar"
	faq={faq}
	breadcrumbs={[{ name: 'الأدلة', href: '/ar/blog/' }, { name: 'دليل شفط مضخة الحريق' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/blog/" class="hover:text-blue-600">الأدلة</a>
			<span>/</span>
			<span class="text-gray-600">دليل شفط مضخة الحريق</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">دليل خزان مياه الحريق</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">ترتيب شفط مضخة الحريق وخزان مياه الحريق</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">باختصار: لا تستطيع مضخة الحريق تقديم أدائها المعتمد إلا عندما يوفّر الخزان الاحتياطي الصحيح، وتبقى مداخل الشفط مغمورة، ويُتحكّم في دخول الهواء وتكوّن الدوامة، ولا تسمح معدات إعادة التعبئة باستهلاك الحجم المحمي. يشرح هذا الدليل مصدر المياه وتحديد حجم الخزان وترتيبات الشفطين وتفاصيل منع الدوامة والتحكم بالمنسوب والتعبئة والتنفيـس والمعلومات التي ينبغي وضعها في جدول جانب الشفط.</p>

			<TableOfContents headings={toc} />

			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 id="water-source" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. من أين يأتي حجم مياه الحريق؟</h2>
			<p class="text-gray-700 leading-relaxed mb-4">يبدأ ترتيب الشفط من مصدر المياه، لا من كتالوج الصمامات. قد تسحب مضخة الحريق من خزان جوي مفتوح، أو خزان مقطعي مخصص، أو خزان خرساني، أو وعاء ضغط، أو رئيس مياه بلدي. يغيّر كل مصدر ارتفاع الشفط المتاح وطريقة تعبئة المضخة والحماية المطلوبة عند المدخل والأدلة اللازمة عند القبول. يورّد مُصنّع المضخة المضخة ووحدة التحكم وفق NFPA 20 أو الكود المحلي؛ أما وانليان فتورّد صمامات وملحقات جانب الشفط حول هذه الحزمة، وليس مضخة الحريق نفسها.</p>
			<p class="text-gray-700 leading-relaxed mb-4">عادةً ما يكون خزان مياه الحريق المفتوح المصدر الأكثر قابلية للتنبؤ، لأن منسوب تشغيله مرئي وضغطه جوي. ومع ذلك يجب على مهندس المضخة احتساب أدنى منسوب قابل للاستخدام وارتفاع المدخل وفواقد الأنابيب ومتطلبات الشفط لدى مُصنّع المضخة. ولخزان الضغط المغلق علاقة مختلفة بين الضغط والحجم، بينما يعتمد الاتصال البلدي على إمداد عام موثوق والقيود التي تفرضها هيئة المياه. لا تنقل ترتيب الخزان إلى اتصال مباشر دون إعادة حساب ظروف الشفط.</p>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">المصدر</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">المعنى على جانب الشفط</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">سؤال التصميم</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">خزان مياه حريق مفتوح</td>
							<td class="px-4 py-3 text-gray-700">منسوب مياه ساكن، ومدخل مغمور، وتفصيل منع الدوامة، وأنابيب قابلة للتصريف</td>
							<td class="px-4 py-3 text-gray-700">هل يكفي أدنى منسوب تشغيل لمدخل المضخة؟</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">خزان ضغط مغلق</td>
							<td class="px-4 py-3 text-gray-700">ضغط الخزان، والحجم القابل للاستخدام، والعزل، وتجهيزات الصيانة الآمنة</td>
							<td class="px-4 py-3 text-gray-700">هل يبقى الضغط متاحًا طوال مدة التشغيل المطلوبة؟</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">اتصال بلدي مباشر</td>
							<td class="px-4 py-3 text-gray-700">ضغط الرئيس العام، وموثوقية التدفق، والتحكم في رجوع التدفق، وموافقة الجهة المختصة</td>
							<td class="px-4 py-3 text-gray-700">هل يستطيع الرئيس توفير حالة الشفط المطلوبة في جميع الأوقات؟</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">للاطلاع على تسلسل الصمامات في غرفة المضخة، راجع <a href="/ar/guides/municipal-fire-water-main-upgrade-guide/" class="text-brand-blue font-semibold hover:underline">دليل صمامات غرفة مضخة الحريق</a>. من المفيد تثبيت منحنى المضخة وفلسفة العزل قبل اعتماد اختراقات الخزان.</p>

			<h2 id="tank-sizing" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. تحديد احتياطي مياه الحريق</h2>
			<p class="text-gray-700 leading-relaxed mb-4">يتحدد احتياطي مياه الحريق بتصنيف خطورة المشروع والتصريف التصميمي والمدة المطلوبة وفق معيار التصميم المعمول به. لا يوجد حجم خزان عالمي مسؤول يمكن نسخه من مبنى إلى آخر. يحدد الحساب الهيدروليكي الطلب، بينما يحدد إصدار المعيار المعمول به المدة التي يجب أن يدعم فيها الاحتياطي الأنظمة المحمية. سجّل الأساس والحجم القابل للاستخدام المطلوب ومرجع المنسوب المنخفض في جداول الخزان والمضخة.</p>
			<p class="text-gray-700 leading-relaxed mb-4">افصل بين الحجم الإجمالي وحجم الحريق القابل للاستخدام. تؤثر هندسة الخزان وضبطا المنسوبين العالي والمنخفض وحيّز الرواسب والفيضان وموضع كل مخرج في ما تستطيع المضخة سحبه فعليًا. إذا شارك مخرج منزلي الخزان، فيجب ترتيب سحبه بحيث لا يستهلك الاستخدام العادي احتياطي الحريق المحمي. ينبغي لصمام إعادة التعبئة الحفاظ على المنسوب العادي دون إغلاق عنيف، بينما تصل إشارة المنسوب المنخفض المراقبة إلى إنذار الحريق أو نظام إدارة المبنى حسب المطلوب.</p>
			<p class="text-gray-700 leading-relaxed">للسياق المتعلق بالكود، قارن حسابات فريق التصميم مع <span class="font-semibold">معايير NFPA</span>. استخدم هذه النظرة العامة لتحديد الأسئلة، ثم أكّد كل متطلب للحجم والمدة والمنسوب وفق إصدار المعيار المعمول به والجهة المختصة.</p>

			<h2 id="two-suction" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. قاعدة الشفطين واختراقات الخزان</h2>
			<p class="text-gray-700 leading-relaxed mb-4">تحتاج خزانات مياه الحريق الكبيرة إلى أكثر من نقطة اعتماد واحدة. تتطلب أحكام NFPA 20 لخزانات التخزين الكبيرة أكثر من مخرج شفط أو رئيس شفط واحد، وتحد من الاعتماد على خط شفط واحد، لكن العتبة والتكوين الدقيقين يعتمدان على إصدار المعيار المعمول به. أكّد الإصدار قبل رسم جدار الخزان، وبيّن ما إذا كانت لكل مضخة مسار مستقل، وكيف تُعزل المسارات، وكيف يمكن إنجاز الصيانة دون إزالة سعة الحريق المطلوبة.</p>
			<p class="text-gray-700 leading-relaxed mb-4">اختراق الخزان تفصيل منظومة، وليس مجرد ثقب ذي شفة. نسّق موضع الجلبة والتسليح ومادة الحشية والعزل الخارجي وصفائح منع الدوامة الداخلية وإمكانية الوصول للفحص. أبقِ الصمام خارج الخزان حيث يمكن تشغيله وصيانته، وتأكد من إمكانية تصريف أو إزالة وصلة الأنابيب دون التأثير في الشفط الآخر. يُنظر عادةً في <a href="/ar/products/ul-fm-resilient-seat-osy-gate-valve/" class="text-brand-blue font-semibold hover:underline">صمام البوابة OS&amp;Y بمقعد مرن UL/FM</a> عندما يلزم صمام عزل مدرج كامل المجرى ومفتوح بوضوح؛ ويبقى الاختيار خاضعًا لمواصفة المشروع.</p>
			<p class="text-gray-700 leading-relaxed">لا تعني مسارا الشفط فرعين للزينة يُجمعان فورًا في عنق زجاجة واحد. تتبّع كل مسار حتى ترتيب المضخة، وافحص مساحة التدفق المتاحة وحدد الصمامات التي يجب أن تبقى مقفلة أو تحت إشراف الفتح. عند وجود مضخة ثانية أو حجرة ثانية، ينبغي للمصمم إثبات أن عطل مكوّن واحد لا يلغي سعة الشفط المطلوبة.</p>

			<h2 id="vortex" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. منع الدوامة وتخطيط أنبوب الشفط</h2>
			<p class="text-gray-700 leading-relaxed mb-4">يجب أن يبقى مدخل الخزان مغمورًا بالحد الأدنى المطلوب وفق المعيار المعمول به وترتيب المضخة. إذا انخفض منسوب المياه قريبًا جدًا من الفتحة، فقد تسحب دوامة الهواء إلى الشفط حتى بينما يبدو أن الخزان ما زال يحوي ماءً. يقلل دخول الهواء التدفق المسلم ويسبب عدم استقرار ضغط الشفط وقد يتلف المكره. تساعد صفيحة منع الدوامة أو <a href="/ar/products/suction-vortex-preventer-en12845/" class="text-brand-blue font-semibold hover:underline">مانع دوامة الشفط EN 12845</a> في كسر نمط الجريان الدوراني، لكنها لا تستبدل عمق الغمر المطلوب أو تحديد مقاس الأنبوب الصحيح.</p>
			<p class="text-gray-700 leading-relaxed mb-4">أبقِ الاقتراب من المضخة بسيطًا بقدر ما تسمح به الغرفة. استخدم مقاس أنبوب الشفط وطول المسار المستقيم المحددين من مُصنّع المضخة، وتجنب الأكواع غير الضرورية قرب شفة الشفط، وثبّت مخفّضًا لا مركزيًا بحيث يكون جانبه المستوي إلى أعلى كي لا يتجمع الهواء عند مدخل المضخة. ادعم الأنبوب مستقلًا حتى لا يحمّل وزنه وحركته الحرارية غلاف المضخة. صمام الشفط للعزل فقط، وليس للخنق.</p>
			<p class="text-gray-700 leading-relaxed">إذا كان الحطام خطرًا محتملًا، فقد تحمي <a href="/ar/products/telescopic-y-strainer-sgl41h/" class="text-brand-blue font-semibold hover:underline">مصفاة Y المتلسكوبية SGL41H</a> القابلة للتنظيف خط الشفط حيث يسمح التصميم المعتمد بذلك، لكن أي شبكة تضيف فقدًا وتحتاج إلى صيانة. أكّد الشبكة وإمكانية الوصول وهبوط الضغط وقبول خدمة الحريق قبل التركيب. قد تبدو المصفاة المسدودة كأنها خزان صغير الحجم بينما يكون العَرَض الحقيقي هو هبوط قراءة مانومتر الشفط.</p>

			<h2 id="level-control" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. إبقاء الخزان ممتلئًا: التحكم بالمنسوب</h2>
			<p class="text-gray-700 leading-relaxed mb-4">الخزان الذي كان ممتلئًا عند التسليم ليس بالضرورة مصدر حريق موثوقًا. يجب أن تحافظ معدات إعادة التعبئة على المنسوب العادي، وتغلق بسلاسة، وتتحمل ضغط المدخل المتاح، وتصدر إشارة واضحة عند انخفاض المنسوب. الهدف التصميمي هو منع الطلب المنزلي والتبخر والاختبار والتسربات الصغيرة من استهلاك الاحتياطي المحمي، مع منع إعادة تعبئة غير مضبوطة من فيضان الخزان.</p>
			<p class="text-gray-700 leading-relaxed mb-4">يستخدم <a href="/ar/products/hydraulic-water-level-control-valve-f745x/" class="text-brand-blue font-semibold hover:underline">صمام التحكم الهيدروليكي بمنسوب المياه F745X</a> ترتيبًا يعمل بطيار للحفاظ على المنسوب والإغلاق السلس. عندما يتطلب المشروع ترتيبًا بعيدًا يعمل بعوّامة، يوفّر <a href="/ar/products/remote-control-float-valve-100x/" class="text-brand-blue font-semibold hover:underline">صمام العوّامة للتحكم عن بُعد 100X-16P</a> طيار عوّامة من الفولاذ لإعادة تعبئة الخزان. لا يحدد أي من المنتجين احتياطي الحريق بمفرده؛ بل يجب أن تتبع نقاط الضبط والتحويلات الالتفافية والضغط upstream والإنذارات التصميم الهيدروليكي المعتمد.</p>
			<p class="text-gray-700 leading-relaxed">أظهر المناسيب العالي والعادي والمنخفض والطارئ على مخطط التحكم. أدرج صمام عزل علويًا سهل الوصول، ووسيلة تصريف أو اختبار عند الحاجة، وطريقة لإثبات عمل الطيار أو العوّامة دون تفريغ الخزان. إذا كان الخزان مشتركًا، فاربط إشارة المنسوب بضوابط الاستخدام المنزلي كي لا يقلل عطل صمام إعادة التعبئة احتياطي الحريق بصمت.</p>

			<h2 id="priming-testing" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. التعبئة والتنفيـس والمانومترات وتجهيزات الاختبار</h2>
			<p class="text-gray-700 leading-relaxed mb-4">قبل أن تؤدي مضخة الحريق الطاردة المركزية عملها، يجب ملء غلافها وشفطها بصورة صحيحة، ويجب أن يبقى جانب الشفط مغمورًا كما صُمّم. يعتمد الترتيب النهائي على نوع المضخة وارتفاع المصدر، لذا اتبع تعليمات التعبئة والتنفيـس لدى مورّد المضخة بدل الارتجال بتركيب صمام قدم أو صمام عدم رجوع إضافي. يوضح مانومتر الشفط عند شفة المضخة ما إذا كان المصدر متاحًا فعليًا؛ قارنه بمانومتر الطرد ومنحنى المضخة المعتمد أثناء القبول.</p>
			<p class="text-gray-700 leading-relaxed mb-4">وفّر نقاط عزل وتصريف تتيح فحص وصلة الشفط والصمام والأجهزة دون تفريغ الخزان كله. احمِ المانومترات من الصدمات العرضية واجعل مجالاتها مناسبة للظروف الساكنة وظروف التشغيل المتوقعة. أثناء التشغيل التجريبي، تحقق من وضع الصمامات وإنذار المنسوب المنخفض وعمل إعادة التعبئة وتركيب منع الدوامة ودعامات الأنابيب وغياب تسرب الهواء قبل تسجيل أداء المضخة.</p>
			<p class="text-gray-700 leading-relaxed">ينبغي للاختبار إثبات السعة الهيدروليكية وهدف الأمان عند الفشل. حاكِ حالة منسوب منخفض حيثما يسمح الأمر، وشغّل صمام إعادة التعبئة، وافحص اختراق الخزان، وأكّد بقاء الشفط المطلوب متاحًا مع حالة العزل المخطط لها. أما واجهة الاتصال الخارجية وواجهة جانب الطرد، فيشرح <a href="/ar/guides/fire-department-connection-siamese-guide/" class="text-brand-blue font-semibold hover:underline">دليل وصلة سيامي لقسم الإطفاء</a> كيفية تنسيق وصلة فريق الإطفاء مع بقية غرفة المضخة.</p>

			<h2 id="checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">7. قائمة فحص ترتيب الشفط</h2>
			<ul class="list-disc ps-6 space-y-2 text-gray-700 leading-relaxed mb-4">
				<li><strong>حدّد المصدر.</strong> اذكر خزانًا مفتوحًا أو خزان ضغط أو اتصالًا بلديًا، وأدنى منسوب تشغيل والضغط المتاح وحالة الشفط المطلوبة من مورّد المضخة.</li>
				<li><strong>وثّق الاحتياطي.</strong> أظهر حجم الحريق ومدته المطلوبين من حساب المشروع، مع جميع مراجع المناسيب وأي حجم محمي مشترك مع الاستخدام المنزلي.</li>
				<li><strong>نسّق المخارج.</strong> أكّد إصدار NFPA 20 المعمول به ومتطلب الشفطين لحجم الخزان واستقلالية كل مسار.</li>
				<li><strong>امنع دخول الهواء.</strong> تحقّق من الغمر وهندسة منع الدوامة واتجاه المخفّض اللامركزي وطول المسار المستقيم ودعامات الأنابيب المستقلة.</li>
				<li><strong>احمِ المياه.</strong> حدّد صمام العزل الخارجي والمصفاة القابلة للتنظيف فقط عند اعتمادها والمانومترات والمصارف وإمكانية الوصول للصيانة.</li>
				<li><strong>تحكم بالمنسوب.</strong> اختر معدات الطيار F745X أو 100X بما يلائم ضغط المدخل، واضبط المناسيب العادي والمنخفض، ووصل الإنذارات المطلوبة.</li>
				<li><strong>خطط للقبول.</strong> أدرج تعليمات التعبئة والتنفيـس ومانومترات الشفط والطرد واختبار إعادة التعبئة ومحاكاة المنسوب المنخفض وسجلات المواد واختبارات الضغط والتشغيل والصيانة.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">للحصول على جدول صمامات كامل، اربط هذا العمل بـ<a href="/ar/guides/municipal-fire-water-main-upgrade-guide/" class="text-brand-blue font-semibold hover:underline">دليل ترقية رئيس مياه الحريق البلدي</a> وأكّد شروط هيئة المياه المحلية. تستطيع وانليان مراجعة رسم مخرج الخزان ومنحنى المضخة ومقاسات الأنابيب وإصدار المعيار المطلوب قبل تسعير صمامات وملحقات الشفط.</p>

