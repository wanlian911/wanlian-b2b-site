---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'standards-families', label: 'عائلات المعايير الخمس التي ستقابلها فعليًا' },
	{ id: 'reading-test-reports', label: 'كيف تقرأ معيارًا مقابل تقرير اختبار' },
	{ id: 'pressure-ratings', label: 'ما تعنيه تصنيفات وفئات الضغط عمليًا' },
	{ id: 'five-checks', label: 'شراء معدات مطابقة من الصين: الفحوصات الخمس' },
	{ id: 'wanlian-compliance', label: 'كيف تموضع Wanlian Fluid الامتثال' },
	{ id: 'faq', label: 'الأسئلة الشائعة' },
	{ id: 'sources', label: 'المصادر' }
];

const faq = [
	{
		question: 'ما الفرق بين خلاطات AWWA وخلاطات EN؟',
		answer: 'AWWA C502 يصف خلاطات البرميل الجاف لسوق المرافق في الولايات المتحدة/كندا؛ أمّا EN 14384 وBS 750 فيصفان خلاطات الأعمدة (والمدفونة) المستخدمة في أوروبا والعديد من أسواق التصدير. تختلف في التصميم والواجهات وطرق الاختبار — اختر حسب مواصفة مشروعك، لا حسب التوفر.'
	},
	{
		question: 'أي معيار خراطيم حريق تطالب به إدارات الحريق الأمريكية؟',
		answer: 'NFPA 1961 هو المرجع لخراطيم الهجوم في الولايات المتحدة. في أوروبا تنطبق EN 14540 ونظائرها الوطنية، ونوع الموصّل (NH، Storz، فوري) مهم بقدر أهمية الخرطوم نفسه.'
	},
	{
		question: 'هل تعني "مُختبَر حتى 1.5 MPa" أن الخرطوم يطابق NFPA 1961؟',
		answer: 'لا بحد ذاتها. الامتثال يعني أن المنتج خُوطب وفق طرق وحدود المعيار المسمّى. اطلب دائمًا التقرير الذي يشير إلى المعيار في أمر شرايك.'
	},
	{
		question: 'هل يمكن لمصنع صيني واحد توريد الخلاطات والصمامات والخراطيم معًا؟',
		answer: 'نعم — المورّدون أصحاب الخط الكامل مثل Wanlian Fluid يجمعون الخلاطات والصمامات والمكونات وخراطيم الحريق تحت أمر شراء واحد، مما يبسّط التوثيق والفحص والمسؤولية.'
	},
	{
		question: 'هل أحتاج شهادة UL/FM لكل طلب تصدير؟',
		answer: 'لا — إلا عندما يتطلبها عقداك أو سوق الوجهة. لأعمال البلدية والصناعة الدولية في الغالب تسيطر مواصفات AWWA أو EN أو BS أو ISO. تأكّد مع السلطة المتعاقدة لديك على النظام المطبق قبل الدفع من أجل الشهادة.'
	},
	{
		question: 'ما المستندات التي تثبت امتثال مورد صيني؟',
		answer: 'شهادة ISO 9001 سارية (تُتحقق لدى الجهة المانحة)، تقارير اختبار لكل دفعة مطابقة لمعيارك، تقرير فحص من طرف ثالث إن وُطلب، ووضع علامة دائمة على المنتج. ضع كل ذلك في أمر الشراء ليكون واجبًا تعاقديًا.'
	}
];

const productRows = [
	{ slug: 'overground-fire-hydrant-ss100', name: 'خلاط حريق خارجي مقاوم تجمد (SS100/65)', img: '/assets/products/overground-fire-hydrant-ss100.webp', desc: 'خلاط خارجي برميل جاف مقاوم تجمد للشبكات البلدية' },
	{ slug: 'resilient-seat-flanged-gate-valve-z41x', name: 'صمام بوابة بفلنجة بمقعد مرن (Z41X)', img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp', desc: 'صمام عزل كامل القطر لخطوط المياه وشبكات الحريق' },
	{ slug: 'fire-hose-pvc-rubber-lining-8-65', name: 'خرطوم حريق مسطح بطانة مطاطية PVC (النموذج 8-65)', img: '/assets/products/fire-hose-pvc-rubber-lining-8-65.jpg', desc: 'خرطوم مسطح بطانة مطاطية لمكافحة الحريق ونقل المياه' }
];
---

<Layout
	title="معايير خلاطات وخراطيم وصمامات الحريق: AWWA وNFPA وEN وISO"
	description="دليل المشتري لمعايير خلاطات وخراطيم وصمامات الحريق: AWWA C502، NFPA 1961، EN 14384، BS 750، EN 1074، ISO 5208 — كيف تشتري معدات مطابقة من الصين."
	type="article"
	locale="ar"
	faq={faq}
	breadcrumbs={[{ name: 'أدلة', href: '/ar/blog/' }, { name: 'دليل المعايير' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/blog/" class="hover:text-blue-600">الأدلة</a>
			<span>/</span>
			<span class="text-gray-600">دليل المعايير</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">دليل المعايير والامتثال</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">معايير خلاطات الحريق وخراطيم الحريق والصمامات موضحة: AWWA وNFPA وEN وISO</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">الامتثال يُحسم بوثيقة واحدة — المعيار المسمّى في أمر شرايك. لخلاطات الحريق هو عادةً AWWA C502 (البرميل الجاف الأمريكي)، أو EN 14384 وBS 750 (أوروبا/بريطانيا). لخراطيم الحريق هو NFPA 1961 (أمريكا) أو EN 14540، إضافةً إلى معيار الموصّل الذي تثبّتونه فعليًا على خراطيمكم. للصمامات هو AWWA C515 أو EN 1074 أو ISO 5208، مع فئة الضغط (PN أو ANSI) التي يحتاجها نظامك. قبل مقارنة الأسعار بين الموردين الصينيين، قارن تقارير الاختبار مع <em>ذلك</em> المعيار.</p>

			<div class="bg-blue-50 border border-blue-100 rounded-xl p-5 my-6">
				<p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-blue">لماذا هذا يهم أكثر من أي وقت مضى:</strong> في مراقبتنا لشهر سبتمبر 2026 لـ 30 سؤال مشتريات حقيقي عبر البحث بالذكاء الاصطناعي، أشارت إجابات AI إلى منظمات المعايير — AWWA وNFPA وUL وBSI — أكثر بكثير من بأي مصنع على حدة. المشترين الذين يتحدثون "المعيار أولًا" يحصلون على أجوبة أفضل، والمورّدون الذين يوثّقون الامتثال معيارًا بمعيار هم من يثق بهم AI والمهندسون.</p>
			</div>

			<!-- Product strip -->
			<div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
				{productRows.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-32 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="standards-families" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. عائلات المعايير الخمس التي ستقابلها فعليًا</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">المعيار</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">ما يغطيه</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">أين يُحدَّد</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">المشتري النموذجي</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">AWWA C502</td>
							<td class="px-4 py-3 text-gray-700">خلاطات حريق بالبرميل الجاف</td>
							<td class="px-4 py-3 text-gray-700">الولايات المتحدة، كندا (المرافق البلدية)</td>
							<td class="px-4 py-3 text-gray-700">مرافق المياه، المقاولون البلديون</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">AWWA C515</td>
							<td class="px-4 py-3 text-gray-700">صمامات بوابة بمقاعد مرنة</td>
							<td class="px-4 py-3 text-gray-700">الولايات المتحدة، كندا</td>
							<td class="px-4 py-3 text-gray-700">مرافق المياه، محطات المعالجة</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">NFPA 1961</td>
							<td class="px-4 py-3 text-gray-700">خراطيم الحريق (أداء خراطيم الهجوم)</td>
							<td class="px-4 py-3 text-gray-700">الولايات المتحدة</td>
							<td class="px-4 py-3 text-gray-700">إدارات الحريق، الفرق الصناعية</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">EN 14384 / BS 750</td>
							<td class="px-4 py-3 text-gray-700">خلاطات الحريق بالأعمدة</td>
							<td class="px-4 py-3 text-gray-700">أوروبا، بريطانيا، مواصفات تصدير الشرق الأوسط</td>
							<td class="px-4 py-3 text-gray-700">المشاريع البلدية، المستشارون</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">EN 14540 / النظائر الوطنية</td>
							<td class="px-4 py-3 text-gray-700">خراطيم الحريق لأنظمة ثابتة أو عامة</td>
							<td class="px-4 py-3 text-gray-700">أوروبا</td>
							<td class="px-4 py-3 text-gray-700">مكاتب تكامل أنظمة الحريق</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">EN 1074 / ISO 5208</td>
							<td class="px-4 py-3 text-gray-700">صمامات إمداد المياه؛ اختبار تسرب الصمامات</td>
							<td class="px-4 py-3 text-gray-700">أوروبا، دولي</td>
							<td class="px-4 py-3 text-gray-700">عطاءات بلدية، صناعية، وتصديرية</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">الموصلات تضيف طبقة ثانية: حدّد نوع المسمار أو الموصّل الذي يحتاجه مستخدموك — مسمار NH (أمريكا)، Storz (معظم أوروبا)، فوري/BS 336 (بريطانيا) — واجعل المورد يؤكد ذلك كتابةً. ورقة المواصفات في صفحة <a href="/ar/products/fire-hose-pvc-rubber-lining-8-65/" class="text-brand-blue font-semibold hover:underline">خرطوم 8-65 المسطح ببطانة مطاطية</a> لدينا توثق خيارات الموصلات التي نوفرها، و<a href="/ar/guides/fire-hose-buying-guide/" class="text-brand-blue font-semibold hover:underline">دليل شراء خراطيم الحريق المسطحة</a> لدينا يمرر المقاس والبطانات ومعايير الموصلات بالتفصيل.</p>

			<h2 id="reading-test-reports" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. كيف تقرأ معيارًا مقابل تقرير اختبار</h2>
			<p class="text-gray-700 leading-relaxed mb-4">يُعرَّف المنتج المطابق للمعيار بثلاثة أشياء: التصميم (المواد والبناء)، والأداء (الضغط والتسرب والتدفق)، والعلامة (التعرّف الدائم). عندما يسلّمك المورد تقرير اختبار، افحصه ضد الثلاثة جميعًا، لا الرقم البارز وحده:</p>
			<ol class="list-decimal ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>المادة تطابق المعيار.</strong> يُتوقع خلاطات AWWA C502 من حديد زهر مطبوع مع بطانة داخلية مقاومة للتآكل — شاهد جدول المواد في صفحة <a href="/ar/products/overground-fire-hydrant-ss100/" class="text-brand-blue font-semibold hover:underline">خلاط SS100 الخارجي</a> لدينا لكيفية توثيق ذلك من مصنع؛ معايير الصمامات EN تشير إلى مواد جسم محددة. اسأل عمّا هو الصب والبطانة فعليًا — "حديد زهر" و"حديد زهر مطبوع" منتجان مختلفان بثمن وعمر مختلفين.</li>
				<li><strong>الاختبارات هي اختبارات المعيار.</strong> للخلاطات، توقّع اختبار ضغط الغلاف واختبار المقعد/التسرب وفق المعيار المسمّى. للخراطيم، توقّع الأداء للتمزق واللصق وبقاء الموصّل وفق NFPA 1961 أو EN 14540. تقرير "ضغط ماء 1.5 MPa" ليس تلقائيًا تقريرًا لمعيارك — قارن طريقة الاختبار، لا الرقم.</li>
				<li><strong>كل وحدة أم عينة؟</strong> اسأل ما إذا كان الاختبار لكل وحدة أم سحب دفعة. لمعدات السلامة الحريقية، اختبار ضغط الغلاف وتسرب الهواء لكل وحدة هو الحد الأدنى المسؤول — وهي السياسة التي تعلنها Wanlian Fluid لصماماتها وخلاطاتها وخراطيمها (اختبار ضغط وتسرب 100% لكل وحدة قبل التجهيز).</li>
			</ol>

			<h2 id="pressure-ratings" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. ما تعنيه تصنيفات وفئات الضغط عمليًا</h2>
			<p class="text-gray-700 leading-relaxed mb-4">تحمل الصمامات والخلاطات إما فئة ضغط (PN — مثلًا PN10/PN16/PN25) أو فئة ضغط ANSI. اختر الفئة التي تتجاوز أقصى ضغط تشغيل لنظامك، ثم أكّد ضغط اختبار الغلاف لدى المورد مقابل المعيار، لا ضغط التشغيل فقط. إذا كانت مواصفاتك تخلط مراجع أمريكية وأوروبية (مثلًا خلاط AWWA على حلقة محددة بـ EN)، فاجعل المورد يؤكد التوافق كتابةً قبل الطلب — الواجهات غير المطابقة سبب رئيسي لتأخيرات الموقع.</p>
			<p class="text-gray-700 leading-relaxed">كنقطة مرجعية، <a href="/ar/products/resilient-seat-flanged-gate-valve-z41x/" class="text-brand-blue font-semibold hover:underline">صمام البوابة بفلنجة بمقعد مرن Z41X</a> لدينا متوفر بفئتي PN10 وPN16 مع إحكام هوائي مُختبَر وفق ISO 5208 — الفئة التي تطلبها يجب أن تُطابق أقصى ضغط تشغيل لنظامك، لا أن تُفترض من اسم المنتج.</p>

			<h2 id="five-checks" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. شراء معدات مطابقة من الصين: الفحوصات الخمس</h2>
			<ol class="list-decimal ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>سمِّ المعيار في RFQ.</strong> سطر واحد في استفسارك ("خلاطات حريق وفق AWWA C502، برميل جاف، مدخل 6&quot;، مخارج مسمار NH") يفحص فورًا 80% من الموردين غير المناسبين.</li>
				<li><strong>اطلب تقرير الاختبار المطابق.</strong> اطلب سجلات اختبار لكل دفعة بالمعيار والنموذج الدقيق — لا شهادة مطابقة عامة.</li>
				<li><strong>تحقق أن الشهادة حية وفي النطاق.</strong> شهادات ISO 9001 يجب فحصها لدى الجهة المانحة؛ شهادات الامتثال يجب أن تسمّي المنتج والمعيار.</li>
				<li><strong>اطلب فحصًا من طرف ثالث.</strong> اجعل وكالة مستقلة تشهد الاختبار وتتحقق من العلامة قبل الشحن، خاصة في الطلبات الأولى.</li>
				<li><strong>افحص لوحة البيانات.</strong> يجب أن تشمل العلامة المعيار والمقاس وتصنيف الضغط وقابلية تتبع المصنع. العلامة الناقصة فشل في الفحص الأولي، لا تفصيلة.</li>
			</ol>
			<p class="text-gray-700 leading-relaxed">لعملية الفحص الكامل للمورّد خلف هذه الفحوصات — التحقق من الكيان القانوني، فحص نطاق ISO، الاختبار لكل وحدة والتوثيق — اتبع خطوة بخطوة <a href="/ar/guides/how-to-verify-chinese-valve-supplier/" class="text-brand-blue font-semibold hover:underline">كيف تتحقق من مورد صمامات ومعدات حريق صيني</a> لدينا.</p>

			<h2 id="wanlian-compliance" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. كيف تموضع Wanlian Fluid الامتثال</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Wanlian Fluid (Quanzhou Wanlian Fluid Equipment Co., Ltd.) يورد صمامات صناعية ومكونات خلاطات وخراطيم حريق ومعدات حماية حريق لمشاريع بلدية وصناعية وحريقية دولية. خطوط منتجاته — صمامات بوابة بمقاعد مرنة ومعادن مقعد معدنية، وصمامات فراشة ورجوع، وخلاطات ومكونات، وخراطيم حريق ببطانة مطاطية — تُصنَع تحت نظام إدارة جودة ISO 9001، مع اختبار 100% لضغط الغلاف وتسرب الهواء لكل وحدة، وتوثيق تصدير منسق لكل طلب. عندما ترسل معيارًا أو ورقة مواصفات، يردّ فريق الهندسة بمصفوفة امتثال لمشروعك بدل كتيّب عام — هذا هو الحوار الذي يمنع فشل المواصفات. لترى كيف يقف هذا النهج المتمحور حول الامتثال مقابل علامة أمريكية رائدة، اقرأ <a href="/ar/guides/wanlian-fluid-vs-american-avk/" class="text-brand-blue font-semibold hover:underline">مقارنة Wanlian Fluid مقابل American AVK</a> للموردين.</p>
