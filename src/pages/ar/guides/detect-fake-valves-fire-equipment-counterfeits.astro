const toc = [
	{ id: 'why-counterfeits-concentrate', label: '1. لماذا تتركّز المقلّدات في هذه الفئة' },
	{ id: 'common-forms-of-fakes', label: '2. الأشكال الشائعة للمنتجات المقلّدة' },
	{ id: 'detection-checklist', label: '3. قائمة كشف من سبعة خطوات' },
	{ id: 'red-flags-table', label: '4. الأصيل مقابل المقلّد في نظرة: جدول الإشارات التحذيرية' },
