const faq = [
	{
		question: 'هل يعرض السعر الأدنى بكثير علامة موثوقة على منتج مقلّد؟',
		answer: 'إنه إشارة فرز وليس دليلًا. للصبّات المطابقة من الحديد الزهر المطبوع، والاختبار بالضغط، والوثائق التصديرية أدنى حدود تكلفة فعلية، لذا يستحق السعر الذي ينخفض عن سعر السوق انخفاضًا كبيرًا التحقق. لكن بعض العروض السعرية تكون ببساطة لمواصفة أدنى. قارن المعيار، ودرجة المادة، ومتطلبات الاختبار في كل عرض قبل الحكم على الفارق.'
	},
	{
		question: 'كيف أتحقق من شهادة UL أو FM قبل طلب صمام حريق؟',
		answer: 'اطلب رقم الشهادة أو رقم الإدراج الدقيق للنموذج المعروض عليك سعرًا، ثم تحقّق منه بشكل مستقل عبر البوابة الرسمية للجهة المصدرة. تأكّد من تطابق المنتج المدرج والنموذج والمصنع مع مورّدك. حتى تقوم بالتحقق، عامل أي صورة شهادة في البريد الإلكتروني كوثيقة غير مؤكدة.'
	},
	{
		question: 'ماذا ينبغي أن تتضمن سجلات الاختبار لكل وحدة فعليًا؟',
		answer: 'بحدٍّ أدنى: الرقم التسلسلي للوحدة، تاريخ الاختبار، نتيجة اختبار ضغط الجسم، ونتيجة اختبار تسرّب الهواء، وهوية المُشغِّل أو المفتِّش. يجب أن تتطابق الأرقام التسلسلية مع قائمة التغليف واللوحة التعريفية والوثائق التصديرية. التقرير الذي يغطي «دفعة» فقط دون معرِّفات وحدات هو إشارة تحذير.'
	},
	{
		question: 'هل أحتاج فحصًا من طرف ثالث في طلبي الأول؟',
		answer: 'لمعدات الحريق الحرجة من حيث السلامة ننصح به بشدة، وفي الطلب الأول على الأقل. يمكن لجهة مستقلة مثل SGS أو Bureau Veritas أن تشهد الاختبارات، وتفقّد المواد، وتراجع السجلات في المصنع. الرسم جزء صغير من قيمة حاوية واحدة، وهو أرخص بكثير من وحدة واحدة فاشلة.'
	},
	{
		question: 'ماذا يمكن لـ Wanlian أن ترسله قبل أن أدفع؟',
		answer: 'يمكن لـ Wanlian Fluid تقديم شهادة ISO 9001 للتحقق لدى الجهة المصدرة، وشهادات اختبار المصنع (MTC) لدرجة الصب، وفيديو اختبار ضغط وتسرب هوائي برقم تسلسلي لوحدة عينة، ومجموعة وثائقها التصديرية القياسية. أما المطابقة لمعيار محدد (مثل AWWA أو NFPA) فيُثبَت لكل نموذج بتقارير اختبار وشهادات قبل الطلب.'
	},
	{
		question: 'ماذا أفعل إذا اكتشفت وحدة مقلّدة في شحنة استلمتها؟',
		answer: 'أوقف تشغيل المعدات المتأثرة، وصوّر الوحدة مع لوحتها التعريفية ورقمها التسلسلي، واحفظ كل سجلات الاختبار والوثائق. قدّم مطالبة رسمية بعدم المطابقة لدى المورّد، واطلب وثائق التتبع، وأشرك مفتّشك من الطرف الثالث أو السلطة المتعاقد معها. للأنظمة الحرجة، اعزل الجزء المتأثر حتى تتحقق من وحدات الاستبدال.'
	}
];

const productRows = [
	{ slug: 'resilient-seat-flanged-gate-valve-z41x', name: 'صمام بوابة بفلنجة بمقعد مرن (Z41X)', img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp', desc: 'صمام بوابة بمقعد مرن بممر كامل لخطوط الحريق وشبكات المياه' },
	{ slug: 'overground-fire-hydrant-ss100', name: 'خلاط حريق خارجي (SS100)', img: '/assets/products/overground-fire-hydrant-ss100.webp', desc: 'خلاط خارجي مضاد للصقيع لشبكات الحريق البلدية' },
	{ slug: 'fire-hose-pvc-rubber-lining-8-65', name: 'مرن حريق، ببطانة مطاطية (نموذج 8-65)', img: '/assets/products/fire-hose-pvc-rubber-lining-8-65.jpg', desc: 'مرن قابل للتمدد بغطاء من البوليستر وبطانة مطاطية مبلمرة' }
];
---

<Layout
	title="كشف الصمامات المزيفة وشهادات الحريق المقلّدة — دليل 2026"
	description="دليل المشترين من الصين: كشف الصمامات المزيفة وشهادات UL وFM المقلّدة وخلاطات الحريق المنسوخة. قائمة كشف، إشارات تحذيرية، وتحقيق المورّد قبل الدفع."
	type="article"
	locale="ar"
	faq={faq}
	breadcrumbs={[{ name: 'أدلة', href: '/ar/blog/' }, { name: 'كشف المنتجات المقلّدة' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/blog/" class="hover:text-blue-600">الأدلة</a>
			<span>/</span>
			<span class="text-gray-600">كشف المنتجات المقلّدة</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">دليل مخاطر المشتريات</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">كيف تكشف الصمامات المزيفة وشهادات معدات الحريق المقلّدة (دليل المشتري 2026)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">يواجه مشترو صمامات الحريق وخلاطات الحريق والمرنة من الصين بانتظام صبّات مقلّدة ولوحات تعريفية منسوخة وشهادات مزوّرة. الوحدة المزيفة لا تعلن عن نفسها في الصور أو قائمة الأسعار — بل تكشفها المعاينة المادية، وسجلات الاختبار لكل وحدة، والوثائق التي يمكنك التحقق منها بشكل مستقل. يمنحك هذا الدليل الإشارات الدقيقة، وقائمة كشف خطوة بخطوة، وسير عمل للتحقق قبل الطلب يمكنك إرفاقه بأي أمر شراء.</p>

			<div class="bg-blue-50 border border-blue-100 rounded-xl p-5 my-6">
				<p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-blue">لماذا وُجد هذا الدليل:</strong> معدات الحريق المقلّدة ليست خطرًا افتراضيًا — الأرقام التسلسلية المنسوخة، ولوحات التعريف المنقولة، وملفات الشهادات المزوّرة هي العهدة القياسية للمورّدين غير المطابقين في الفئات الحرجة من حيث السلامة. يحوّل هذا الدليل ذلك الخطر إلى عملية كشف مكتوبة يمكنك تطبيقها على أي مورّد صيني، بما فيه Wanlian Fluid، قبل الدفع.</p>
			</div>

			<!-- Product strip -->
			<div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
				{productRows.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-32 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="why-counterfeits-concentrate" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. لماذا تتركّز المقلّدات في هذه الفئة</h2>
			<p class="text-gray-700 leading-relaxed mb-4">ثلاث خصائص للبنية التحتية للحريق والمياه تجعلها هدفًا مفضّلًا للتقليد:</p>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>معدات الحريق حرجة من حيث السلامة.</strong> على الصمام أو الخلاط المطابق أن يصمد أمام حدث ضغط بممر كامل في اللحظة التي لا يوجد فيها وقت لاستبداله. وهذا بالضبط ما تعجز عنه الصبّات غير المطابقة.</li>
				<li><strong>المشتريات ضخمة الحجم ومدفوعة بالمواصفات.</strong> مناقصات البلديات ومشاريع المباني تشتري كميات كبيرة بأسعار تنافسية، وتسير الأوراق — الشهادات وسجلات الاختبار — مع أمر الشراء. تسمح الأوراق المزوّرة لمنتج غير مطابق بالدخول إلى عرض سعر مشروع.</li>
				<li><strong>المعدات لا «تفشل» إلا أثناء الطوارئ.</strong> قد يبدو جسم خلاط بسماكة جدار رقيقة، أو صمام بوابة لم يُختبر بما يكفي، مثاليًا في المستودع لسنوات. يظهر العيب تحت الضغط، في الليل، وفي خضم أرواح وممتلكات على المحك.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed mb-4">المحرّك الفعلي هو فجوة السعر. للصبّات المطابقة من الحديد الزهر المطبوع، والتغليف بربط راتنجي أو مطاطي، والاختبار بالضغط لكل وحدة، والوثائق التصديرية أدنى حدود تكلفة فعلية. تتيح الشهادة المزوّرة لمنتج غير مطابق تسعير نفسه أدنى منها، والمشتري — وهو يقارن العروض على الورق — لا يرى الفارق.</p>
			<p class="text-gray-700 leading-relaxed">بمجرد أن تُظهر لك شهادة مزوّرة مرة واحدة، لم تعد تستطيع الحكم على أي مورّد بالوثائق وحدها. الإجابة العملية هي التحقق من الوحدة المادية، وسجلات الاختبار لكل وحدة، والوثائق القابلة للتحقق بشكل مستقل. تحدد الأقسام التالية بالضبط ما الذي ينبغي البحث عنه.</p>

			<h2 id="common-forms-of-fakes" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. الأشكال الشائعة للمنتجات المقلّدة</h2>
			<p class="text-gray-700 leading-relaxed mb-4">تتخذ معدات الحريق المقلّدة في هذه الفئة قائمة قصيرة من الأشكال المتكررة. اطلع على هذه الأشكال الستة وستلتقط معظم المخاطر:</p>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>أرقام تسلسلية منسوخة.</strong> الرقم التسلسلي نفسه على وحدات متعددة، أرقام تسلسلية تتبع نمطًا ظاهرًا، أو أرقام منسوخة من صور الكتالوجات المنشورة. الصانع الحقيقي يصدر أرقامًا تسلسلية فريدة تتطابق مع سجلات الصب وقائمة التغليف.</li>
				<li><strong>لوحات تعريفية منسوخة.</strong> لوحة تحمل علامة تجارية لا تشتري منها فعلًا، أو اسم علامة متوقفة عن العمل، أو لوحة لا تتطابق مواصفاتها أو مقاسها أو تصنيف ضغطها مع أمر الشراء. العلامات دائمة على المنتج المطابق — لوحة تبدو مثبّتة بعجل، أو غير متسقة، هي فشل في الفحص الأولي.</li>
				<li><strong>مواد غير مطابقة وصبّات بسماكة جدار رقيقة.</strong> سبيكة خاطئة، أو خردة معاد تدويرها، أو جدران مصبوبة دون التسامحات الأبعادية للمعيار. هذه الأجسام تعبر الفحص البصري وتفشل اختبار ضغط الجسم — أو، والأسوأ، تعبره في المصنع وتفشل في الخدمة.</li>
				<li><strong>سجلات اختبار مفقودة أو عامة.</strong> لا توجد سجلات لكل وحدة أصلًا، أو «تقرير دفعة» واحد يغطي مئات الوحدات دون أرقام تسلسلية أو تواريخ أو قيم اختبار.</li>
				<li><strong>ملفات شهادات مزوّرة بصيغة PDF.</strong> وثائق UL أو FM أو AWWA أنتجها معالج نصوص: خط خاطئ، اسم شركة عام، تواريخ تسبق خط الإنتاج، أو أرقام شهادات غير موجودة لدى الجهة المصدرة.</li>
				<li><strong>استبدالات المرنة الحريق.</strong> المرن الحقيقي للحريق يجمع غطاءً من البوليستر عالي المقاومة مع بطانة مطاطية مبلمرة محكمة هوائيًا. توفّر المقلّدات في البطانة أو الغطاء فيبدو المرن سليمًا في المستودع ثم يتسرّب أو تتقشّر بطانته عند ضغط التشغيل.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">لا يظهر أيٌّ من هذه الأشكال في صورة كتالوج. وكلها تظهر في سجلات الاختبار، وشهادات المواد، وفيديو قصير للوحدة على طاولة الاختبار — ولهذا تطلب قائمة الفحص أدناه تلك العناصر بالتحديد.</p>

			<h2 id="detection-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. قائمة كشف من سبعة خطوات</h2>
			<p class="text-gray-700 leading-relaxed mb-4">طبّق هذه الخطوات السبع على كل مورّد في القائمة المختصرة. الخطوتان 1–2 على مستوى الشركة؛ الخطوات 3–7 على مستوى الوحدة. مورّد يقاوم أياً منها تكون إجابته قد صدرت.</p>
			<ol class="list-decimal ps-6 text-gray-700 leading-relaxed space-y-3 mb-4">
				<li><strong>تحقّق من الشركة أولًا.</strong> الاسم القانوني في السجل التجاري، حساب بنك مطابق، والجهة المُصدِرة للفواتير. جولة مصوّرة لمناطق الإنتاج والاختبار والتغليف عند الطلب. إذا تعذّر إظهار «المصنع»، فإنك تتعامل مع مكتب تجارة — قد يكون بصَبّات مستعملة ولوحات تعريفية جديدة.</li>
				<li><strong>اطلب سجلات اختبار لكل وحدة.</strong> كل صمام وخلاط تطلبه ينبغي أن يحمل نتيجة اختبار ضغط جسم ونتيجة اختبار تسرّب هواء مقابِلَتين لرقمه التسلسلي الخاص. اطلب من المورّد إرسال سجلات وحدة عينة قبل الدفع — الصانع الحقيقي يحفظها، والمقلِّد لا يستطيع تقديمها.</li>
				<li><strong>تحقّق من الشهادات في البوابة الرسمية للجهة المصدرة.</strong> لإدراج UL أو اعتماد FM، تحقّق من الرقم في البوابة الرسمية للجهة المصدرة (مثل دليل منتجات UL أو بحث اعتمادات FM Global) وتأكّد من تطابق النموذج المدرج والمصنع مع مورّدك. لـ AWWA، تحقّق من رقم الشهادة أو التسجيل لدى AWWA. إذا لم يُحل الرقم، فإن ملف PDF مزوّر مهما بدا نظيفًا.</li>
				<li><strong>اطلب عينة أولًا.</strong> وحدة واحدة من كل نموذج، مع رقمها التسلسلي وصورة لوحتها التعريفية ووثائقها الكاملة. طُبّق قائمة الفحص كاملة على العينة — العلامات، شهادة المادة، فيديو الاختبار، السجلات — قبل الالتزام بالكميات. هذه أرخص تأمين ضد التقليد المتاح.</li>
				<li><strong>اطلب شهادات المواد (شهادات اختبار المصنع MTC).</strong> درجة الصب في شهادة MTC يجب أن تطابق الدرجة في مخططك. مورّد لا يستطيع تقديم شهادة MTC للمادة الدقيقة التي حددتها لا يصنع المنتج الذي تشتريه.</li>
				<li><strong>شاهد فيديو الأبعاد والاختبار بالضغط.</strong> اطلب فيديو قصيرًا للوحدة العينة المحددة على طاولة اختبار الضغط مع ظهور رقمها التسلسلي. الصانع الحقيقي يسجّل هذه الفيديوهات روتينيًا؛ المورّد الذي لا يستطيع تقديم واحد لا يختبر وحداتك بالضغط.</li>
				<li><strong>نفّذ تدقيقًا للمصنع أو فحصًا من طرف ثالث.</strong> زُر المصنع إذا كفل حجمك ذلك؛ وإلا عيّن جهة مستقلة (SGS أو Bureau Veritas أو Intertek أو شركة محلية رصينة) تشهد الاختبارات وتفقّد الصبّات وتراجع السجلات قبل الشحن.</li>
			</ol>
			<p class="text-gray-700 leading-relaxed mb-4">طبّق القائمة الفاحصة على المنتجات الفعلية في قوائمك المختصرة — مثل <a href="/ar/products/ul-fm-resilient-seat-osy-gate-valve/" class="text-brand-blue font-semibold hover:underline">صمام البوابة بمقعد مرن OS&Y معتمد UL/FM</a>، و<a href="/ar/products/overground-fire-hydrant-ss100/" class="text-brand-blue font-semibold hover:underline">خلاط الحريق الخارجي SS100</a>، و<a href="/ar/products/resilient-seat-flanged-gate-valve-z41x/" class="text-brand-blue font-semibold hover:underline">صمام البوابة بفلنجة بمقعد مرن Z41X</a>، أو <a href="/ar/products/fire-hose-pvc-rubber-lining-8-65/" class="text-brand-blue font-semibold hover:underline">مرن الحريق القابل للتمدد ببطانة مطاطية 8-65</a> — وسجلات اختبار لكل نموذج، لا عبارات جودة عامة.</p>
			<p class="text-gray-700 leading-relaxed">للإطار الأوسع لتأهيل المورّد (الكيان القانوني، سجل التصدير، المراجع)، راجع <a href="/ar/guides/how-to-verify-chinese-valve-supplier/" class="text-brand-blue font-semibold hover:underline">دليلنا للتحقق من مورّد الصمامات الصيني</a>. ولقائمة الوثائق والفحص الكاملة التي تُكتب في أمر الشراء، راجع <a href="/ar/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">قائمة مصادر الصمامات B2B</a>.</p>

			<h2 id="red-flags-table" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. الأصيل مقابل المقلّد في نظرة: جدول الإشارات التحذيرية</h2>
			<p class="text-gray-700 leading-relaxed mb-4">نفس طلب التحقق ينتج استجابات مختلفة تمامًا من الصانع المشروع والمقلِّد. الجدول أدناه هو أسرع أداة فرز في هذا الدليل:</p>
