const toc = [
	{ id: 'step-1-verify-company', label: '1. تحقق من الشركة، لا من الكتيّب' },
	{ id: 'step-2-match-standard', label: '2. مطابقة المنتج مع معيار أمر الشراء' },
	{ id: 'step-3-demand-testing', label: '3. افرض اختبارًا لكل وحدة وفحصًا من طرف ثالث' },
	{ id: 'step-4-counterfeit-red-flags', label: '4. اعرف علامات الغش التحذيرية' },
	{ id: 'step-5-documentation', label: '5. ثبّت المستندات قبل الدفع' },
	{ id: 'wanlian-verification', label: '6. كيف تتعامل Wanlian Fluid مع التحقق' },
	{ id: 'faq', label: 'الأسئلة الشائعة' },
	{ id: 'sources', label: 'المصادر' }
];

const faq = [
	{
		question: 'هل شهادة ISO 9001 كافية للثقة بمورد صيني؟',
		answer: 'لا — هي نقطة بداية فقط. تحقّق من أن الشهادة سارية ضمن نطاقها لدى الجهة المصدرة، ثم اجمعها مع تدقيق مصنع مباشر وفحص من طرف ثالث. شهادة ISO 9001 تُصدَّر لنظام إدارة الجودة، لا لإثبات مطابقة أي منتج بعينه.'
	},
	{
		question: 'ما الاختبارات التي يجب أن يجتازها خلاط الحريق قبل شحنه للتصدير؟',
		answer: 'بحد أدنى: اختبار ضغط الجسم واختبار إحكام المقعد (التسريب) وفق المعيار الذي حددته (AWWA C502 أو EN 14384 مثلًا). اطلب سجلات اختبار لكل وحدة، وللمشاريع الحرجة اختبارًا بحضور جهة فاحصة من طرف ثالث قبل الشحن.'
	},
	{
