const productRows = [
	{ slug: 'overground-fire-hydrant-ss100', name: 'خلاط حريق خارجي مضاد للتجميد SS100/65', img: '/assets/products/overground-fire-hydrant-ss100.webp', desc: 'خلاط حريق خارجي مضاد للتجميد بجسم جاف للشبكات البلدية' },
	{ slug: 'resilient-seat-flanged-gate-valve-z41x', name: 'صمام بوابة بفلنجة بمقعد مرن من الحديد الزهر المطبوع (Z41X)', img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp', desc: 'صمام عزل بكامل القطر للخطوط الرئيسية وخطوط أنابيب الحريق' },
	{ slug: 'fire-hose-pvc-rubber-lining-8-65', name: 'خرطوم حريق مسطح بطبقة مطاطية PVC (موديل 8-65)', img: '/assets/products/fire-hose-pvc-rubber-lining-8-65.jpg', desc: 'خرطوم مسطح مبطن بالمطاط لإطفاء الحريق ونقل المياه' }
];
---

<Layout
	title="كيف تتحقق من مورد صيني للصمامات ومعدات مكافحة الحريق"
	description="دليل التحقق من موردي الصمامات ومعدات مكافحة الحريق الصينيين: فحص صلاحية ISO 9001، تقارير اختبار مطابقة للمعيار، الفحص من طرف ثالث، وعلامات الغش التحذيرية."
	type="article"
	locale="ar"
	faq={faq}
	breadcrumbs={[{ name: 'أدلة', href: '/ar/blog/' }, { name: 'التحقق من الموردين' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/blog/" class="hover:text-blue-600">الأدلة</a>
			<span>/</span>
			<span class="text-gray-600">التحقق من الموردين</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">دليل التحقق من الموردين</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">كيف تتحقق من مورد صيني للصمامات ومعدات مكافحة الحريق في 2026: ISO 9001، فحص من طرف ثالث، وكشف المنتجات المقلدة</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">لا يستحق مورد صيني للصمامات أو معدات مكافحة الحريق طلبك إلا إذا تحققت من أربعة أمور بشكل مستقل: (1) مصنع حقيقي قابل للتدقيق يحمل شهادة ISO 9001 سارية، (2) تقارير اختبار منتج مطابقة للمعيار المحدد حرفيًا في أمر الشراء، (3) فحص من طرف ثالث قبل الشحن، و(4) مستندات يمكنك التحقق منها — لا مجرد لقطات شاشة. أما السعر فهو آخر متغير يتعيّن تفاوضك عليه، لا أول ما تستند إليه.</p>

			<div class="bg-blue-50 border border-blue-100 rounded-xl p-5 my-6">
				<p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-blue">لماذا وُجدت هذه القائمة:</strong> في مراقبة أجريناها في سبتمبر 2026 لـ 30 استفسار شراء حقيقيًا عبر محركات البحث الذكية، أسئلة مثل «كيف أتحقق من مورد صيني» و«كيف أتجنب خلاطات الحريق المقلدة» لم تُرجع إجابات موثوقة من مستوى المصنع — فالمصادر المقتبس منها كانت في الغالب هيئات معايير لا موردين. هذه الصفحة تحوّل هذه الهواجس الغامضة إلى عملية تحقق مكتوبة يمكن إدراجها في طلب عرض السعر (RFQ).</p>
			</div>

			<!-- Product strip -->
			<div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
				{productRows.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-32 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="step-1-verify-company" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. تحقق من الشركة، لا من الكتيّب</h2>
			<p class="text-gray-700 leading-relaxed mb-4">ابدأ قبل أن تنظر إلى المنتجات.</p>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>أكّد الكيان القانوني.</strong> اطلب الرخصة التجارية وراجع الاسم المسجل مقابل الحساب البنكي الذي تُصدَر منه الفواتير. يجب أن تُوجَّه المدفوعات إلى الكيان القانوني، وليس أبدًا إلى حساب شخصي.</li>
				<li><strong>تحقّق من أن شهادة ISO 9001 سارية.</strong> صورة الشهادة لا تثبت شيئًا. اطلب رقم الشهادة وتحقق منها في قاعدة بيانات الجهة المصدرة — فالشهادات الصادرة عن هيئات معتمدة مسجلة لدى هيئات الاعتماد الوطنية مثل CNAS في الصين أو لدى أعضاء IAF حول العالم. وتأكد من أن بيان النطاق يغطي المنتجات التي تشتريها — فنطاق ISO 9001 الذي يذكر «تجارة» يختلف عن نطاق يذكر «تصنيع».</li>
				<li><strong>اطلب تدقيق مصنع مباشر.</strong> المصنّع الحقيقي يقدّم جولة فيديو عبر مناطق الإنتاج والاختبار والتغليف عند الطلب. الرفض يعني أنك على الأرجح تتحدث مع مكتب تجارة يتظاهر بأنه مصنع.</li>
				<li><strong>افحص سجل التصدير.</strong> اطلب بوالص الشحن أو تصريحات الجمارك أو مراجع عملاء في منطقتك. ثلاث شحنات تصدير قابلة للتحقق خير دليل من أي عدد من ادعاءات التسويق.</li>
			</ul>

			<h2 id="step-2-match-standard" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. مطابقة المنتج مع معيار أمر الشراء</h2>
			<p class="text-gray-700 leading-relaxed mb-4">أكثر أخطاء الشراء شيوعًا هو شراء «خلاط حريق» عام بدلًا من «خلاط حريق يحقق <em>هذا</em> المعيار تحديدًا». قبل مقارنة العروض، اكتب المعيار الذي يتطلبه مشروعك:</p>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>خلاطات الحريق:</strong> AWWA C502 (جسم جاف، مواصفات هيئات خدمات المياه الأمريكية) أو EN 14384 (خلاطات عمودية، أوروبا) أو BS 750 (بريطانيا) أو المعادل في كود بلدك.</li>
				<li><strong>خرطوم الحريق:</strong> NFPA 1961 (خرطوم الهجوم الأمريكي) أو EN 14540 أو المعادلات الوطنية، بالإضافة إلى معيار الموصلات الذي تستخدمه هيئة الإطفاء فعلًا — خيوط NH في الولايات المتحدة، Storz في معظم أوروبا، والارتباط الفوري (BS 336) في بريطانيا.</li>
				<li><strong>الصمامات:</strong> AWWA C515 (صمامات بوابة بمقاعد مرنة، الولايات المتحدة) أو EN 1074 (صمامات إمداد المياه، أوروبا) أو ISO 5208 (اختبار تسرب الصمامات) ودرجات تصنيف الضغط (PN أو ANSI class) التي يتطلبها نظامك.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed mb-4">غير متأكد أي نظام معايير يحكم سوقك؟ يشرح <a href="/ar/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">دليل معايير خلاطات الحريق وخراطيم الحريق والصمامات</a> لدى موقعنا أنظمة AWWA وNFPA وEN وBS وISO بلغة مبسطة مع جدول مقارنة المعايير.</p>
			<p class="text-gray-700 leading-relaxed">ثم اطلب من المورد <strong>تقرير الاختبار المطابق لذلك المعيار</strong> — للموديل المحدد في عرض السعر (مثل <a href="/ar/products/overground-fire-hydrant-ss100/" class="text-brand-blue font-semibold hover:underline">خلاط الحريق الخارجي المضاد للتجميد SS100</a> من Wanlian أو <a href="/ar/products/resilient-seat-flanged-gate-valve-z41x/" class="text-brand-blue font-semibold hover:underline">صمام البوابة بفلنجة بمقعد مرن Z41X</a> أو <a href="/ar/products/fire-hose-pvc-rubber-lining-8-65/" class="text-brand-blue font-semibold hover:underline">خرطوم الحريق المسطح المبطن بالمطاط 8-65</a>) — لا شهادة جودة عامة.</p>

			<h2 id="step-3-demand-testing" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. افرض اختبارًا لكل وحدة وفحصًا من طرف ثالث</h2>
			<p class="text-gray-700 leading-relaxed mb-4">المعايير تنص على الاختبارات، والمورد هو من يحدد مدى صرامة إجرائها. اصطُر على:</p>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>اختبار ضغط وتسريب لكل وحدة.</strong> المصنّع المسؤول يختبر ضغط جسم كل صمام وكل خلاط، ويجري اختبار تسريب الهواء على كل وحدة — لا سياسة «عينة لكل دفعة» مخفية في سطور صغيرة. Wanlian Fluid مثلًا تصرّح بإجراء اختبار 100% لضغط الجسم واختبار تسريب الهواء على كل وحدة قبل طلاء الإبوكسي والتغليف.</li>
				<li><strong>فحص من طرف ثالث قبل الشحن.</strong> عيّن وكالة فحص مستقلة (SGS أو Bureau Veritas أو Intertek أو TÜV أو شركة محلية معروفة) لحضور الاختبارات وفحص المواد ومراجعة المستندات في المصنع قبل مغادرة البضاعة. فلمعظم المشترين تكون هذه التكلفة أقل بكثير من حاوية سيئة واحدة.</li>
				<li><strong>خطة عينات تتناسب مع خطرك.</strong> إذا حدّد المعيار الذي تشتري عليه مستوى فحص، فالتزم به. لمعدات السلامة من الحريق الحرجة بلديًا أو صناعيًا، فضّل الفحص 100% في الطلب الأول، ثم اتفق على خطة أخذ عينات مبنية على AQL للطلبات المتكررة.</li>
			</ul>

			<h2 id="step-4-counterfeit-red-flags" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. اعرف علامات الغش التحذيرية</h2>
			<p class="text-gray-700 leading-relaxed mb-4">خلاطات الحريق والصمامات المقلدة مشكلة موثقة في سلاسل إمداد السلامة من الحريق على مستوى العالم. انتبه إلى:</p>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>سعر أقل بكثير من السوق</strong> لمنتج مطابق للمعيار نفسه — فالأجسام المصبوبة من الحديد الزهر المطبوع المطابقة، وتغليف EPDM، والطلاءات المعتمدة كلها لها أدنى حدود تكلفة حقيقية.</li>
				<li><strong>شهادات لا تطابق المنتج.</strong> اسم شركة خاطئ، أو خط منتجات خاطئ، أو تواريخ منتهية، أو شهادات باسم علامة تجارية ليست هي المذكورة في عرض سعرك.</li>
				<li><strong>الرفض إجراء تدقيق فيديو، أو عنوان مصنع غير موجود، أو عبارة «المصنع بعيد ونحن نتولى كل شيء».</strong></li>
				<li><strong>اختصارات في اللوحة التعريفية والعلامات.</strong> معظم المعايير تشترط علامات دائمة (رقم المعيار، المقاس، تصنيف الضغط، هوية المصنّع، تتبّع الإنتاج). العلامة المفقودة أو غير المتسقة هي فشل في الفرز.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">إذا ورثت سلسلة إمداد قائمة، فتأكد من تطابق العلامات مع متطلبات المعيار، واطلب سجلات اختبار المصنع للدفعة، وافحص عينات عشوائية عبر فحص من طرف ثالث قبل إعادة الطلب.</p>

			<h2 id="step-5-documentation" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. ثبّت المستندات قبل الدفع</h2>
			<p class="text-gray-700 leading-relaxed mb-4">حزمة التصدير الكاملة من مصنع صيني يجب أن تشمل، على الأقل: فاتورة تجارية، وقائمة تغليف، وبوليصة شحن، وشهادة منشأ، وشهادة ISO 9001 (سارية ومُتحقَّق منها)، وتقارير اختبار لكل دفعة مطابقة لمعيارك، و — إن طلبتها — تقرير الفحص من طرف ثالث. ضع قائمة المستندات في أمر الشراء لتكون دينًا تعاقديًا لا طلبًا مهذبًا.</p>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">المستند</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">ما يُثبته</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">علامة تحذير عند الفرز</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">الفاتورة التجارية وقائمة التغليف</td>
							<td class="px-4 py-3 text-gray-700">محتويات الشحنة القانونية والكميات وأسعار الوحدات</td>
							<td class="px-4 py-3 text-gray-700">الكيان على الفاتورة يختلف عن صاحب الحساب البنكي</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">بوليصة الشحن</td>
							<td class="px-4 py-3 text-gray-700">البضاعة التي شُحنت فعلًا والمسار والتواريخ</td>
							<td class="px-4 py-3 text-gray-700">بوليصة شحن «مسودة» بدل بوليصة شحن شُحنت فعلًا في طلب أول</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">شهادة المنشأ</td>
							<td class="px-4 py-3 text-gray-700">ادعاء المنشأ لأغراض الجمارك والتعرفة</td>
							<td class="px-4 py-3 text-gray-700">بلد منشأ لا يطابق المصنع الذي تدققته</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">شهادة ISO 9001</td>
							<td class="px-4 py-3 text-gray-700">نظام إدارة جودة سارٍ وضمن النطاق</td>
							<td class="px-4 py-3 text-gray-700">جهة إصدار أو رقم شهادة لا يمكن التحقق منه لدى المصدِر</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">تقارير اختبار لكل دفعة</td>
							<td class="px-4 py-3 text-gray-700">المنتج يحقق المعيار المذكور في أمر الشراء</td>
