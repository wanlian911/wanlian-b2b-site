---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'manual-monitors-ps', label: 'المنظورات اليدوية (سلسلة PS): تحكم المشغل' },
	{ id: 'auto-tracking-monitors-zdms', label: 'المنظورات ذاتية التتبع (ZDMS): استجابة مستقلة' },
	{ id: 'head-to-head-comparison', label: 'مقارنة مباشرة' },
	{ id: 'sizing-and-installation', label: 'أساسيات حساب المقاس والتركيب' },
	{ id: 'faq', label: 'الأسئلة الشائعة' }
];

const faq = [
	{
		question: 'ما الفرق بين مدفع ماء حريق يدوي ومدفع ذاتي التتبع؟',
		answer: 'مدفع ماء الحريق اليدوي (سلسلة PS) يُوجَّه ويُشغَّل من قِبل رجل إطفاء في الموقع، إما مباشرةً على البرج أو عبر عجلة يد عن بُعد. أما المدفع ذو التتبع الآلي (سلسلة ZDMS) فيمسح المنطقة المحمية باستمرار بكواشف لهب ثنائية النطاق (أشعة تحت حمراء/أشعة فوق بنفسجية)، ويصوب نحو الحريق تلقائيًا ثم يُخمده دون تدخل مشغل — وهو أمر حاسم في المساحات الكبيرة التي يجب توجيه النفاث إلى الحريق فيها خلال ثوانٍ.'
	},
	{
		question: 'أين يُطلب مدفع الإطفاء الذاتي التتبع (ZDMS)؟',
		answer: 'تُخصص مدافع التتبع الآلي عادةً للمساحات الداخلية الكبيرة ذات الأسقف العالية حيث يجب أن يكون اكتشاف الحريق والاستجابة تلقائيين: قاعات المعارض، الفتحات الداخلية بين الطوابق (الأتريوم)، المستودعات، أجنحة الطائرات وورش التصنيع الصناعية. يحدد ارتفاع السقف ومساحة الأرضية عدد المدافع ومناطق تغطيتها.'
	},
	{
		question: 'ما المدى الفعّال لمدفع ماء الحريق؟',
		answer: 'يعتمد المدى الفعّال على معدل التدفق وتكوين الفوهة. توفر مدافع PS اليدوية عادةً 20–60 L/s بمدى 30–70 m؛ وتُحسب مدافع ZDMS ذاتية التتبع عادةً عند 20–40 L/s للتغطية الداخلية مع وقت استجابة أقل من 30 ثانية. يجب أن يحدد تصميم حماية الحريق مقاس المدفع انطلاقًا من كثافة الماء المطلوبة ومساحة التغطية.'
	},
	{
		question: 'هل يمكن استخدام مدافع ماء الحريق مع الرغوة؟',
		answer: 'نعم. تدعم معظم مدافع سلسلة PS رش الماء أو الرغوة بتبديل إعداد الفوهة، ولهذا هي شائعة في المحطات البتروكيماوية وحقول الخزانات. إذا كان استخدام الرغوة مخططًا له، فاذكر ذلك في استفسارك ليُركَّب المدفع بواجهة تبنية الرغوة الصحيحة.'
	}
];

const monitorProducts = [
	{
		slug: 'manual-fire-water-cannon-ps',
		name: 'مدفع ماء حريق يدوي (سلسلة PS)',
		img: '/assets/products/manual-fire-water-cannon-ps.webp',
		desc: 'منظور يدوي عالي التدفق للماء أو الرغوة، بمدى 30–70 m'
	},
	{
		slug: 'auto-tracking-jet-suppression-cannon-zdms',
		name: 'مدفع إطفاء بنفاث ذاتي التتبع (سلسلة ZDMS)',
		img: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		desc: 'مدفع مسح IR/UV بالكشف والإطفاء المستقلين'
	}
];
---

<Layout
	title="دليل اختيار مدافع ماء الحريق: يدوي PS مقابل ذاتي التتبع ZDMS"
	description="دليل اختيار مدفع ماء الحريق: مدافع يدوية PS مقابل ذاتية التتبع ZDMS — المدى، معدل التدفق، الكشف، وقت الاستجابة والتكلفة. من مصنع Wanlian Fluid في الصين."
	type="article"
	locale="ar"
	faq={faq}
	breadcrumbs={[{ name: 'الأدلة', href: '/ar/blog/' }, { name: 'اختيار مدافع ماء الحريق' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<span class="text-gray-600">الأدلة</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">دليل معدات إطفاء الحريق</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">اختيار مدافع ماء الحريق: يدوي PS مقابل ذاتي التتبع ZDMS</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">مدافع ماء الحريق — وتُعرف أيضًا بالمنظورات المائية — تضخ نفاثًا مركّزًا عالي التدفق على مدى بعيد. تأتي بفلسفتين تشغيليتين مختلفتين جوهريًا: <strong>منظورات يدوية</strong> يوجّهها المشغلون، و<strong>منظورات ذاتية التتبع</strong> تكتشف وتصوب وتُطفئ بأنفسها. الاختيار بينهما مسألة وقت استجابة وخطورة الإشغال والميزانية. يفصّل هذا الدليل القرار.</p>

			<div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
				{monitorProducts.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-40 object-contain bg-white p-3" />
						<div class="p-4">
							<p class="text-sm font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-xs text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			
			<TableOfContents headings={toc} />

			<h2 id="manual-monitors-ps" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. المنظورات اليدوية (سلسلة PS): تحكم المشغل</h2>
			<p class="text-gray-700 leading-relaxed mb-4"><a href="/ar/products/manual-fire-water-cannon-ps/" class="text-brand-blue font-semibold hover:underline">منظور ماء الحريق اليدوي من سلسلة PS</a> هو حصان العمل في إطفاء الحريق الصناعي: برج ثابت يقدّم 20–60 L/s بمدى حتى 70 m، قابل للتبديل بين نفاث مستقيم ورش، ويُستخدم بالماء أو الرغوة. يكون التشغيل مباشرًا (عجلة يد أو على البرج) أو عن بُعد بواسطة مشغل يرصد المشهد.</p>
			<p class="text-gray-700 leading-relaxed mb-4">أين يُستخدم:</p>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>المحطات البتروكيماوية وحقول الخزانات وأرصفة التحميل</strong> — منظورات قادرة على الرغوة مع نقاط حماية ثابتة.</li>
				<li><strong>الساحات الخارجية ومناطق العمليات</strong> حيث يمكن للمشغلين الوصول بأمان إلى المنظور أو إلى موضع تحكم عن بُعد.</li>
				<li><strong>دعم التبريد والرش الشامل</strong> حيث تكمل النفاثات اليدوية الموجهة الأنظمة التلقائية.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">المعادلة بسيطة: المنظور اليدوي لا يكون أسرع من مشغله. إن لم يستطع أحد الوصول بأمان إلى نقطة التحكم عند اندلاع الحريق، فقد لا يُطلق إطلاقًا.</p>

			<h2 id="auto-tracking-monitors-zdms" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. المنظورات ذاتية التتبع (ZDMS): استجابة مستقلة</h2>
			<p class="text-gray-700 leading-relaxed mb-4">مدفع <a href="/ar/products/auto-tracking-jet-suppression-cannon-zdms/" class="text-brand-blue font-semibold hover:underline">الإطفاء بالنفاث ZDMS ذو التتبع الآلي</a> يُخرج الإنسان من حلقة الاستجابة. كواشف لهب ثنائية النطاق (أشعة تحت حمراء/أشعة فوق بنفسجية) تمسح المساحة المحمية باستمرار؛ عند تأكيد بصمة اللهب، يدور المدفع نحو الحريق ويفتح الصمام ويُخمده — عادةً خلال 30 ثانية من الاشتعال، على مدار الساعة.</p>
			<p class="text-gray-700 leading-relaxed mb-4">أين يُستخدم:</p>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>المساحات الداخلية الكبيرة ذات الأسقف العالية</strong> — قاعات المعارض، الفتحات الداخلية (الأتريوم)، المستودعات، الورش، أجنحة الطائرات.</li>
				<li><strong>الإشغالات التي قد يتوسع فيها الحريق أسرع من استجابة الكوادر</strong>.</li>
				<li><strong>خطر في أوقات غير مراقبة أو ليلية</strong> — النظام يراقب دائمًا.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">بما أن مدافع ZDMS تُحسب مقاساتها حسب منطقة التغطية وارتفاع السقف، يجب أن يحدد التصميم نطاقات رؤية الكواشف وكثافة الماء عبر المنطقة بأكملها. لهذا كان الدعم الهندسي للمورّد بنفس أهمية الأجهزة نفسها.</p>

			<h2 id="head-to-head-comparison" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. مقارنة مباشرة</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">المعيار</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">يدوي (PS)</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">ذاتي التتبع (ZDMS)</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">الاستجابة</td>
							<td class="px-4 py-3 text-gray-700">يعتمد على وصول المشغل وسرعته</td>
							<td class="px-4 py-3 text-gray-700">مستقل، عادة &lt;30 ثانية من الاشتعال</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">التدفق / المدى</td>
							<td class="px-4 py-3 text-gray-700">20–60 L/s، 30–70 m</td>
							<td class="px-4 py-3 text-gray-700">20–40 L/s، تغطية داخلية حسب المنطقة</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">الكشف</td>
							<td class="px-4 py-3 text-gray-700">لا يوجد (يوجّهه المشغل)</td>
							<td class="px-4 py-3 text-gray-700">مسح ثنائي النطاق IR/UV</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">الوسيط</td>
							<td class="px-4 py-3 text-gray-700">ماء أو رغوة (قابل للتبديل)</td>
							<td class="px-4 py-3 text-gray-700">ماء؛ رغوة حسب التكوين</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">الاستخدام النموذجي</td>
							<td class="px-4 py-3 text-gray-700">حقول الخزانات، الساحات، مناطق العمليات</td>
							<td class="px-4 py-3 text-gray-700">الأتريوم، المستودعات، القاعات، الورش</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">التكلفة</td>
							<td class="px-4 py-3 text-gray-700">تكلفة أجهزة أقل</td>
							<td class="px-4 py-3 text-gray-700">أعلى؛ تشمل الكشف والتحكم</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 id="sizing-and-installation" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. أساسيات حساب المقاس والتركيب</h2>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>الهيدروليكا أولًا</strong> — يجب التحقق من طلب تدفق المنظور (L/s) والضغط المتبقي المطلوب مقابل المضخة وشبكة الأنابيب قبل الاختيار.</li>
				<li><strong>رسم خريطة التغطية لـ ZDMS</strong> — نطاق رؤية الكاشف وارتفاع السقف وكثافة الماء يحددان عدد المدافع وموضعها؛ اطلب رسمًا تخطيطيًا من المورّد.</li>
				<li><strong>توافق الرغوة</strong> — لحقول الخزانات، أكّد فوهة المنظور وواجهة تبنية الرغوة لخدمة الرغوة.</li>
				<li><strong>بروتوكول الاختبار</strong> — اتفق مع المورّد في العقد على اختبار تجليسير (المدى ووقت الاستجابة).</li>
			</ul>

			<!-- Related guide -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">دليل ذات صلة: قرار الشراء</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">تتردد بين التحكم الثابت وعن بُعد والذكي — وتحسب التدفق والمدى لموقعك؟ اقرأ <a href="/ar/guides/fire-water-cannon-buying-guide/" class="text-brand-blue font-semibold hover:underline">دليل شراء مدافع ماء الحريق</a>.</p>
			</div>

			<!-- FAQ Section -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">الأسئلة الشائعة</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">تحسب مقاس نظام منظورات لموقعك؟</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">أرسل نوع موقعك والمساحة المحمية وارتفاع السقف — يردّ مهندسونا بتصميم توزيع المدافع والتسعير خلال 12 ساعة.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ar/contact/?product=Fire%20Water%20Monitor" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">اطلب عرض سعر</a>
						<a href="https://wa.me/8618684324501?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D8%8C%20%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%AA%20%D9%81%D9%8A%20%D8%AA%D8%AD%D8%AF%D9%8A%D8%AF%20%D9%85%D9%82%D8%A7%D8%B3%20%D9%85%D8%AF%D8%A7%D9%81%D8%B9%20%D9%85%D8%A7%D8%A7%20%D8%A7%D9%84%D8%AD%D8%B1%D9%8A%D9%82" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">دردشة عبر واتساب</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
