---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'ما الفرق الرئيسي بين صمام الرش الشامل وصمام الفعل المسبق؟',
		answer: 'يحتوي نظام الرش الشامل على مرشات أو فوهات مفتوحة، لذلك يؤدي فتح الصمام إلى إرسال الماء إلى جميع نقاط التصريف دفعة واحدة. أما نظام الفعل المسبق فعادةً ما يستخدم مرشات مغلقة، ويعتمد على الكشف لفتح صمام التحكم قبل خروج الماء من المرشة. يُختار الرش الشامل للتغطية السريعة والمتزامنة، بينما يُختار الفعل المسبق عندما يجب الحد من التصريف العرضي للماء. أكّد تسلسل التعشيق والكود المطلوبين وفق الإصدار الحالي.'
	},
	{
		question: 'هل يستخدم صمام الرش الشامل تشغيلًا كهربائيًا أم هيدروليكيًا؟',
		answer: 'اختر طريقة التشغيل وفق تصميم الكشف، ومتطلبات المنطقة الخطرة، والطاقة المتاحة وتسلسل الفشل الآمن المطلوب. يكون التشغيل الكهربائي عمليًا عند تحديد لوحة إنذار الحريق ودائرة الملف اللولبي المراقبة مسبقًا. وقد يناسب التشغيل الهيدروليكي أو الهوائي المواقع التي تفضّل خط ضغط مخصصًا أو كاشفًا هوائيًا. تورّد Wanlian مجموعة الصمام وملحقاتها المتوافقة؛ ويجب أن يؤكد مصمم النظام تسلسل لوحة التحكم بالكشف.'
	},
	{
		question: 'كيف ينبغي حماية نظام الرش الشامل في المناخ البارد؟',
		answer: 'ضع مجموعة الصمام وملحقاتها في مكان مدفأ وسهل الوصول كلما أمكن، وتجنب ترك أنابيب مملوءة بالماء مكشوفة حيث يمكن أن تتجمد. وفّر تجميعًا للمكثفات وتصريفًا لملحقات الكشف، واعزل الأجزاء المعرضة، واستخدم ترتيبًا جافًا أو هوائيًا معتمدًا عندما يتطلب التصميم ذلك. لا تستبدل المائع المضاد للتجمد أو تغيّر الملحقات دون موافقة الجهة المختصة. أكّد طريقة الحماية من التجمد وفق الإصدار الحالي.'
	},
	{
		question: 'كيف يمكن حماية خط الكشف من التشغيل العرضي؟',
		answer: 'افصل خط الكشف عن أدوات التحكم الخدمية العادية، وراقب ضغطه أو حالة دائرته، واحمِ الأجهزة المكشوفة من الصدمات، واستخدم تسلسل لوحة الإطلاق المطلوب للخطر. يجب حماية الإطلاق اليدوي مع إبقائه سهل الوصول، كما ينبغي تعريف وصلات الاختبار بوضوح وإعادتها إلى وضعها بعد الاختبار. يحتاج الكشف الهيدروليكي والهوائي والكهربائي إلى مراقبة مستقلة للإنذار والعطل. ويجب اعتماد مصفوفة السبب والنتيجة النهائية قبل التشغيل.'
	},
	{
		question: 'ما المعلومات التي يجب إدراجها في طلب عرض سعر لصمام رش شامل؟',
		answer: 'أرسل وصف الخطر، والمساحة المحمية، والتدفق والضغط التصميميين، والمقاس الاسمي للصمام ونوع الوصلة النهائية، وتخطيط الرؤوس المفتوحة أو المراقبات، وطريقة الكشف، وتسلسل التشغيل المطلوب، ودرجة الحرارة المحيطة، وترتيب التصريف وإصدار الكود المطبق. واطلب أيضًا رسومات الملحقات وبيانات المواد وسجلات اختبار الضغط ومعلومات قطع الغيار وتعليمات التشغيل. إذا كان الاعتماد أو الإدراج مطلوبًا، فاذكره صراحة واطلب تأكيد الوثائق الحالية.'
	},
	{
		question: 'هل تورّد Wanlian لوحة التحكم بكشف الرش الشامل؟',
		answer: 'تورّد Wanlian مجموعات صمامات الرش الشامل والصمامات المرتبطة وملحقات المراقبة، بما في ذلك مجموعة ZSFM ومكونات العزل أو التحكم المناسبة. ولا نعرض لوحة تحكم بالكشف ضمن حزمة الصمام القياسية عندما لا تكون مورّدة. ينبغي تحديد لوحة الإطلاق والكاشفات وبرمجة السبب والنتيجة مع مقاول إنذار الحريق أو الكشف المتخصص، ثم فحصها مقابل ملحقات الصمام وتسلسل الموقع.'
	}
];

const toc = [
	{ id: 'when-deluge', label: '1. متى يحتاج النظام إلى حماية بالرش الشامل' },
	{ id: 'how-it-works', label: '2. كيف تعمل مجموعة صمام الرش الشامل ZSFM' },
	{ id: 'actuation', label: '3. اختيار طريقة التشغيل' },
	{ id: 'sizing', label: '4. تحديد مقاس الصمام للتدفق وزمن التشغيل' },
	{ id: 'discharge', label: '5. المرشات المفتوحة والمراقبات وتخطيط التصريف' },
	{ id: 'testing', label: '6. التشغيل التجريبي والاختبار الدوري' },
	{ id: 'rfq-checklist', label: '7. قائمة طلب عرض سعر صمام الرش الشامل' },
	{ id: 'faq', label: 'الأسئلة الشائعة' }
];

const products = [
	{ slug: 'deluge-alarm-valve-zsfm', name: 'مجموعة صمام إنذار الرش الشامل (سلسلة ZSFM)', img: '/assets/products/deluge-alarm-valve-zsfm.webp', desc: 'مجموعة صمام رش شامل بقاع رطب لأنظمة الرؤوس المفتوحة والمراقبات' },
	{ slug: 'pre-action-alarm-system-zsfy', name: 'نظام إنذار الفعل المسبق والرش الشامل (سلسلة ZSFY)', img: '/assets/products/pre-action-alarm-system-zsfy.jpg', desc: 'تجميعات فعل مسبق بتعشيق مفرد ومزدوج' },
	{ slug: 'manual-fire-water-cannon-ps', name: 'مراقب مياه حريق يدوي (سلسلة PS)', img: '/assets/products/manual-fire-water-cannon-ps.webp', desc: 'مراقب ثابت لمهام تصريف الرش الشامل والمراقبة' },
	{ slug: 'ul-fm-resilient-seat-osy-gate-valve', name: 'صمام بوابة OS&amp;Y بمقعد مرن UL/FM', img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp', desc: '2–10 بوصات، نهايات ذات مجرى، ساق صاعد، مدرج UL/FM' }
];
---

<Layout
	title="دليل اختيار وتحديد مقاس صمام الرش الشامل (2026)"
	description="شرح عمل صمام الرش الشامل ZSFM، وحساب التدفق وزمن التشغيل، وخيارات التشغيل، وتخطيطات الرؤوس المفتوحة والمراقبات، والاختبار وبيانات طلب السعر."
	type="article"
	locale="ar"
	faq={faq}
	breadcrumbs={[{ name: 'أدلة', href: '/ar/blog/' }, { name: 'دليل اختيار صمام الرش الشامل' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/blog/" class="hover:text-blue-600">الأدلة</a>
			<span>/</span>
			<span class="text-gray-600">دليل اختيار صمام الرش الشامل</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">دليل صمام الرش الشامل</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">تحديد مقاس صمام الرش الشامل واختياره: أنظمة المرشات المفتوحة والمراقبات</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">باختصار: صمام الرش الشامل هو البوابة المتحكم بها بين مصدر ماء مضغوط وشبكة من المرشات أو الفوهات أو المراقبات المفتوحة. يعمل خط الكشف أولًا، ثم يسمح الصمام بدخول الماء إلى جميع نقاط التصريف المفتوحة في وقت واحد. يبدأ الاختيار الجيد من الخطر والتدفق التصميمي، ثم يتحقق من سعة Kv أو Cv وفقد الضغط وزمن التشغيل وطريقة التفعيل والتصريف وإمكانية الاختبار. يشرح هذا الدليل مجموعة ZSFM، ومقارنتها بالأنظمة الرطبة والجافة وأنظمة الفعل المسبق، والبيانات التي ينبغي للمشتري إدراجها في طلب عرض السعر.</p>

			<TableOfContents headings={toc} />

			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 id="when-deluge" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. متى يحتاج النظام إلى حماية بالرش الشامل</h2>
			<p class="text-gray-700 leading-relaxed mb-4">تناسب حماية الرش الشامل الحالات التي يمكن أن ينمو فيها الحريق بسرعة، أو يلزم فيها ترطيب الخطر بأكمله معًا، أو يجب أن تتلقى مراقبة اتجاهية الماء فورًا بعد الكشف. تشمل الأمثلة المعتادة ديكورات المسارح وفضاءات المسرح العلوية، وحظائر الطائرات، والمحولات، والسيور الناقلة، ومناطق المركبات وتطبيقات الفعل المسبق بالماء والرغوة. والميزة الحاسمة هي أن المرشات أو الفوهات مفتوحة؛ فلا ينتظر الماء تشغيل كبسولة مرشة منفردة، بل يرسل تسلسل إطلاق واحد الماء عبر كامل الشبكة المفتوحة.</p>
			<p class="text-gray-700 leading-relaxed mb-4">المقابل هو الطلب المتعمد على كمية كبيرة من الماء. يجب أن يراعي مصمم الرش الشامل كل نقطة تصريف مفتوحة يمكن أن تعمل في الوقت نفسه، والإمداد المتاح عند مدخل الصمام، واحتكاك الأنابيب والضغط المطلوب عند أبعد مخرج هيدروليكيًا. يتطلب EN 12845 وNFPA 13 أن يزوّد صمام الرش الشامل جميع المخارج المفتوحة سريعًا بعد الكشف، ويُعبّر عن ذلك عادةً بنحو 60 ثانية، لكن الإصدار المطبق وخطر المشروع يحددان أساس التصميم الدقيق. أكّد المتطلب دائمًا وفق الإصدار الحالي.</p>
			<p class="text-gray-700 leading-relaxed">لا يتمثل القرار ببساطة في اختيار «أكبر صمام متاح». فصمام الرجوع للإنذار الرطب <a href="/ar/products/wet-alarm-check-valve-zsfz-150/" class="text-brand-blue font-semibold hover:underline">ZSFZ</a> يخص ترتيبًا مختلفًا بمرشات مغلقة عادةً. أما النظام ذي الرؤوس المفتوحة، فمجموعة صمام إنذار الرش الشامل <a href="/ar/products/deluge-alarm-valve-zsfm/" class="text-brand-blue font-semibold hover:underline">ZSFM</a> هي نقطة البداية المناسبة، رهناً بالحساب الهيدروليكي ومتطلبات الاعتماد.</p>

			<h2 id="how-it-works" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. كيف تعمل مجموعة صمام الرش الشامل ZSFM</h2>
			<p class="text-gray-700 leading-relaxed mb-4">يُحافظ على صمام الرش الشامل مغلقًا بترتيب تحضير بينما يبقى جانب الإمداد مضغوطًا. تستشعر دائرة كشف مستقلة الخطر وتطلق الملحقات عبر تسلسل هيدروليكي أو هوائي أو كهربائي. وعند إزالة ضغط التثبيت أو تشغيل جهاز الإطلاق، يتحرك الحاجز الرئيسي أو الرفرف ويدخل ماء الإمداد إلى أنابيب الرش الشامل. يصل الماء عندئذ إلى جميع المرشات أو الفوهات أو المراقبات المفتوحة بدل انتظار التشغيل الحراري لكل مخرج.</p>
			<p class="text-gray-700 leading-relaxed mb-4">ينبغي مراجعة مجموعة ZSFM كتجميع كامل، لا كجسم صمام فقط. يجب أن يحدد طلب السعر مقاس الصمام، ووصلة الدخول والخروج، وملحقات التحضير، وترتيب التصريف والاختبار، ومخرج الإنذار، ومفاتيح الضغط والإطلاق اليدوي للطوارئ. قد يشغّل مسار الإنذار جرس إنذار بمحرك مائي أو ينقل الضغط إلى لوحة مراقبة، وفق الملحقات المحددة. ويجعل صمام عزل مراقب قبل المجموعة وترتيب اختبار متحكم به بعدها عملية الصيانة ممكنة دون إخفاء صمام مغلق.</p>
			<p class="text-gray-700 leading-relaxed">تورّد Wanlian مجموعات صمامات الرش الشامل مع الصمامات المرتبطة وملحقات المراقبة. ولا تُدرج لوحة الكشف والكاشفات ومنطق السبب والنتيجة المبرمج ضمن العرض بصمت عندما يوردها متخصص آخر. يجب أن يظهر هذا الحد في جدول المعدات ليعرف المركّب المسؤول عن دائرة الإطلاق والإخطار بالإنذار وتسلسل إعادة الضبط.</p>

			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">نوع النظام</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">حالة التصريف</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">منطق الاختيار المعتاد</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">رش شامل</td>
							<td class="px-4 py-3 text-gray-700">تتدفق جميع المخارج المفتوحة بعد تشغيل الصمام</td>
							<td class="px-4 py-3 text-gray-700">ترطيب سريع ومتزامن لمنطقة عالية الخطر</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">أنبوب رطب</td>
							<td class="px-4 py-3 text-gray-700">تصرّف المرشات التي شغلتها الحرارة فقط</td>
							<td class="px-4 py-3 text-gray-700">مساحات مدفأة بمرشات مغلقة</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">أنبوب جاف</td>
							<td class="px-4 py-3 text-gray-700">يُفرّغ الهواء قبل دخول الماء إلى الشبكة الجافة</td>
							<td class="px-4 py-3 text-gray-700">أماكن يمنع التجمد فيها النظام الرطب</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">فعل مسبق</td>
							<td class="px-4 py-3 text-gray-700">يفتح الكشف الصمام، وتظل المرشات المغلقة تتحكم في التصريف</td>
							<td class="px-4 py-3 text-gray-700">أماكن حساسة للماء تحتاج شرط إطلاق إضافيًا</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 id="actuation" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. اختيار طريقة التشغيل</h2>
			<p class="text-gray-700 leading-relaxed mb-4">ينفصل خط الكشف عن أنابيب توزيع الماء ويعمل قبل صمام الرش الشامل. يمكن لخط كشف هيدروليكي مملوء بالسائل أن يطلق الصمام عبر جهاز تجريبي، وقد يستخدم الخط الهوائي ضغط الهواء وترتيبًا تجريبيًا جافًا، بينما يعتمد الإطلاق الكهربائي على ملف لولبي مراقب ولوحة إطلاق. ويعتمد الاختيار على بيئة الموقع والمرافق المتاحة ومسار الكابلات وفلسفة المراقبة والتسلسل المطلوب للإطلاق اليدوي والإنذار وإعادة الضبط.</p>
			<p class="text-gray-700 leading-relaxed mb-4">غالبًا ما يكون الإطلاق الكهربائي مناسبًا حيث توجد الكاشفات ولوحة إنذار الحريق ونقاط الحالة البعيدة. وقد يُفضّل الإطلاق الهيدروليكي أو الهوائي عندما تكون فلسفة التحكم محلية أو يجب أن يظل خط الكشف مستقلًا عن دائرة كهربائية طويلة. قد يناسب <a href="/ar/products/groove-solenoid-control-gate-valve-gkzf1/" class="text-brand-blue font-semibold hover:underline">صمام التحكم ذي الملف اللولبي GKZF1</a> ترتيبًا كهربائيًا، لكن يجب أن يؤكد مصمم النظام خرج لوحة الإطلاق والجهد والمراقبة وطريقة إعادة الضبط.</p>
			<p class="text-gray-700 leading-relaxed">وبالنسبة لبديل الفعل المسبق، يوفر <a href="/ar/products/pre-action-alarm-system-zsfy/" class="text-brand-blue font-semibold hover:underline">نظام إنذار الفعل المسبق ZSFY</a> مقارنة مفيدة، لأن تسلسلي التعشيق المفرد والمزدوج يفرضان شروط إطلاق مختلفة. لا تختر بناءً على كلمة «كهربائي» وحدها؛ وثّق ما يحدث عند فقد الطاقة أو ضغط التشغيل التجريبي أو إنذار الكاشف أو الإطلاق اليدوي أو إنذار تدفق الماء والاستعادة. وينبغي اختبار المصفوفة النهائية كتسلسل تشغيل، لا فحصها كمخطط توصيل فقط.</p>

			<h2 id="sizing" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. تحديد مقاس الصمام للتدفق وزمن التشغيل</h2>
			<p class="text-gray-700 leading-relaxed mb-4">حدّد مقاس الصمام من الطلب المحسوب، لا من قطر الأنبوب الفرعي وحده. احسب التدفق التصميمي من جميع الرؤوس أو المراقبات أو الفوهات المفتوحة التي يتطلب الخطر تشغيلها، ثم افحص ضغط الدخول المتاح والضغط عند المخرج البعيد. يجب أن يمرر الصمام المختار التدفق المطلوب بفقد مقبول، مع بقاء الملحقات ومسار الإنذار ضمن نطاق تشغيلهما. وتُعد قيمة Kv أو Cv للمقارنة مفيدة، لكن يجب قراءتها عند هبوط الضغط المناسب لا نسخها من حالة اختبار غير مرتبطة.</p>
			<p class="text-gray-700 leading-relaxed mb-4">زمن التشغيل نتيجة للنظام كله. فهو يشمل استجابة الكشف، وانخفاض ضغط خط التشغيل أو الإطلاق الكهربائي، وفتح الصمام، واستجابة الملحقات، وامتلاء الأنابيب ووصول الماء إلى المخارج البعيدة. يستخدم EN 12845 وNFPA 13 توقعات التسليم السريع لخدمة الرش الشامل، وغالبًا نحو 60 ثانية لتغذية المخارج المفتوحة بعد الكشف. أكّد متطلب المشروع الدقيق وفق الإصدار الحالي، ثم تحقّق منه عند أطول فرع وأكثرها سوءًا هيدروليكيًا بدل وصلة الاختبار الأقصر.</p>
			<p class="text-gray-700 leading-relaxed">يحتاج خط الكشف إلى حساب مستقل. فقد يتحكم أطول مسار تجريبي أو أبعده في انخفاض الضغط أو حجم الهواء أو إزاحة الماء أو المراقبة الكهربائية. أدرج الارتفاع والوصلات ونقاط المكثفات وجهاز الإطلاق الفعلي. وإذا سببت الظروف الباردة أو الرطبة تكاثفًا، فوفّر مجمّع مكثفات ومصرفًا عند نقطة منخفضة مناسبة. يسهل حذف هذه التفاصيل من عرض صمام فقط، وغالبًا ما تفسر اختلاف اختبار التشغيل في الموقع عن الرسم.</p>

			<h2 id="discharge" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. المرشات المفتوحة والمراقبات وتخطيط التصريف</h2>
			<p class="text-gray-700 leading-relaxed mb-4">تُرتب المرشات والفوهات المفتوحة لتغطية الخطر كمجموعة. وتؤثر فتحتها وزاوية الرش وتباعدها وارتفاعها في الطلب الهيدروليكي، بينما قد تؤثر العوائق والرياح في التغطية الفعلية. يضيف ترتيب المراقبات اعتبارات المدى والتوجيه ورد الفعل؛ ويمكن أن يكون <a href="/ar/products/manual-fire-water-cannon-ps/" class="text-brand-blue font-semibold hover:underline">مراقب المياه اليدوي PS</a> جزءًا من مهمة تصريف الرش الشامل أو المراقبة، لكن يجب فحص الإمداد لتدفق المراقب مع أي رؤوس مفتوحة تعمل في الوقت نفسه.</p>
			<p class="text-gray-700 leading-relaxed mb-4">وفّر ترتيب عزل بعدي فقط عندما يسمح التصميم المعتمد بذلك، وراقب أي صمام يمكن أن يعطل جزءًا من الخطر. ينبغي أن يصرّف مصرف الرش الشامل ووصلة الاختبار بأمان دون إغراق غرفة الصمام أو إرسال ماء ملوث إلى مصرف غير مناسب. أبقِ مخرج الإنذار ظاهرًا وسهل الوصول، وعلّم الإطلاق اليدوي كي يميّزه المشغّل أثناء الطوارئ ولا يخلطه بصمام الاختبار أو التصريف.</p>
			<p class="text-gray-700 leading-relaxed">ولفهم النظام، قارن الافتراضات الهيدروليكية مع <a href="/ar/guides/foam-deluge-system-guide/" class="text-brand-blue font-semibold hover:underline">دليل نظام الرش الشامل بالرغوة</a> ومع <a href="/ar/guides/deluge-valve-selection-guide/" class="text-brand-blue font-semibold hover:underline">دليل أنظمة الرش الشامل الرطبة والجافة والفعل المسبق</a>. وعند إضافة الرغوة، راجع <a href="/ar/guides/foam-deluge-system-guide/" class="text-brand-blue font-semibold hover:underline">دليل نظام الرش الشامل بالرغوة</a> حتى يُعامل صمام الرش الشامل ومعدات المركز وأجهزة التصريف كتسلسل هيدروليكي وتحكمي واحد.</p>

			<h2 id="testing" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. التشغيل التجريبي والاختبار الدوري</h2>
			<p class="text-gray-700 leading-relaxed mb-4">يجب أن يثبت التشغيل التجريبي مسار الماء ومسار الإطلاق معًا. أكّد أن صمام الإمداد العلوي وصمامات عزل الملحقات في مواضعها المقصودة، وأن ضغط التحضير مستقر، والمصرف مفتوح، ومخرج الإنذار متصل. شغّل الإطلاق اليدوي وتسلسل الكشف العادي كلًا على حدة حيث يسمح الإجراء المعتمد، ثم سجّل الزمن من الإطلاق إلى تشغيل الصمام وإشارة الإنذار ووصول الماء إلى المخرج البعيد التمثيلي.</p>
			<p class="text-gray-700 leading-relaxed mb-4">اختبر المسار الالتفافي والمصرف دون ترك مسار خفي مفتوحًا. وتحقق من جرس الإنذار المائي أو مفتاح الضغط ونقل الإنذار وملامسات الإشراف وإعادة الضبط. يمكن لمفتاح أو مؤشر تدفق بعدي دعم مراقبة الحالة؛ ويوفر <a href="/ar/guides/deluge-valve-selection-guide/" class="text-brand-blue font-semibold hover:underline">دليل مؤشر تدفق المياه</a> سياقًا أوسع لاختيار تلك الإشارة ومراقبتها. وقبل موسم الأمطار أو أي فترة تشغيل عالية الخطورة، نفّذ اختبار التشغيل المخطط مع مواءمة المالك ومقاول الإنذار ومتطلبات الجهة المختصة.</p>
			<p class="text-gray-700 leading-relaxed">ينبغي أن تتبع الصيانة الدورية NFPA 25 أو كود الصيانة المحلي المطبق وتعليمات الشركة المصنعة. افحص الملحقات بحثًا عن التآكل، وتأكد من عدم انسداد المصارف ومجمّعات المكثفات، وسجّل قراءات الضغط بدل الاعتماد على الذاكرة. يجب التحكم في الاختبار لتأمين منطقة التصريف وإعادة النظام سريعًا. وإذا غيّر الإصدار الحالي فترة أو معيار قبول أو متطلب توثيق، فأكّد ذلك وفق الإصدار الحالي بدل إعادة استخدام قائمة قديمة.</p>

			<h2 id="rfq-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">7. قائمة طلب عرض سعر صمام الرش الشامل</h2>
			<ul class="list-disc pl-6 space-y-2 text-gray-700 leading-relaxed mb-4">
				<li><strong>صف الخطر.</strong> اذكر الغرفة أو العملية والحمل القابل للاحتراق والمساحة المحمية وما إذا كانت المخارج مرشات مفتوحة أو فوهات أو مراقبات أو أجهزة ماء ورغوة.</li>
				<li><strong>قدّم البيانات الهيدروليكية.</strong> أرسل التدفق التصميمي والضغط البعيد المطلوب وضغط الإمداد المتاح ومقاس الأنبوب والارتفاع وافتراضات الحساب الهيدروليكي الحاكمة.</li>
				<li><strong>حدّد مجموعة الصمام.</strong> اذكر المقاس الاسمي والوصلة النهائية ومواد الجسم والملحقات ومقاس المصرف ومخرج الإنذار وترتيب الاختبار وأي صمام عزل مراقب.</li>
				<li><strong>حدّد الإطلاق.</strong> عرّف الكشف الهيدروليكي أو الهوائي أو الكهربائي، وطول خط التشغيل، والإطلاق اليدوي، وتفاصيل الملف اللولبي، وواجهة اللوحة وتسلسل التشغيل المطلوب.</li>
				<li><strong>عالج البيئة.</strong> اذكر أدنى وأعلى درجة حرارة محيطة، والموقع الداخلي أو الخارجي، وخطر التكاثف ومسار التصريف والتعرض للتآكل.</li>
				<li><strong>اطلب الوثائق.</strong> اطلب رسم التجميع ومخطط الملحقات وتعليمات التركيب والصيانة وسجل اختبار الضغط وبيانات المواد ووثائق الاعتماد أو الإدراج الحالية عندما يتطلبها المشروع.</li>
				<li><strong>حدّد اختبار القبول.</strong> عرّف زمن التشغيل المستهدف وإشارات الإنذار ومراقبة المخرج البعيد وإجراء الاستعادة والسجلات المطلوبة بعد اختبار التشغيل.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">ولإطار شراء أوسع، استخدم <a href="/ar/fire-sprinkler-systems/" class="text-brand-blue font-semibold hover:underline">نظرة عامة على أنظمة رش الحريق</a> مع الأدلة ذات الصلة أعلاه. يتيح طلب السعر الكامل لـ Wanlian تأكيد مجموعة الصمام دون الادعاء بتصميم تخطيط الكاشفات أو لوحة إنذار الحريق كاملة. والنتيجة تقسيم أوضح للتوريد، وفحص هيدروليكي أكثر موثوقية، وتغييرات أقل أثناء التشغيل التجريبي.</p>

