---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'american-avk-overview', label: 'American AVK: من هم فعليًا' },
	{ id: 'wanlian-fluid-overview', label: 'Wanlian Fluid: من هم فعليًا' },
	{ id: 'product-lines-compared', label: 'كيف تقارن خطوط المنتجات؟' },
	{ id: 'quality-and-certifications', label: 'نظم الجودة والشهادات' },
	{ id: 'cost-and-lead-time', label: 'التكلفة ومدة التوريد' },
	{ id: 'which-should-you-choose', label: 'أيها تختار؟' },
	{ id: 'faq', label: 'الأسئلة الشائعة' },
	{ id: 'sources', label: 'المصادر' }
];

const faq = [
	{
		question: 'هل American AVK وWanlian Fluid مرتبطان؟',
		answer: 'لا. American AVK جزء من AVK Group ومقرها الدنمارك. أما Wanlian Fluid فهي شركة صينية مستقلة في Quanzhou، Fujian.'
	},
	{
		question: 'هل يصنع American AVK مروان الحريق؟',
		answer: 'لا ضمن نطاق المنتجات المنشور. يركّز American AVK على صمامات البوابة وصمامات الفراشة وخلاطات الحريق والإكسسوارات.'
	},
	{
		question: 'هل يمكن لـ Wanlian Fluid تصنيع خلاطات مطابقة لـ AWWA C502؟',
		answer: 'تصنع Wanlian Fluid خلاطات الحريق ومكوناتها للمشاريع الدولية وتعمل وفق ISO 9001؛ يجب تأكيد المطابقة لمعيار محدد مثل AWWA C502 موديلًا بموديل بتقارير الاختبار والشهادات قبل الطلب.'
	},
	{
		question: 'أي الموردين أرخص؟',
		answer: 'بوجه عام Wanlian Fluid، خصوصًا لباقات الصمام + الخلاط + مرونة الحريق التي تُشحن دوليًا. تسعير American AVK يعكس التصنيع الأمريكي والمستودعات الإقليمية وموقع الضمان. اطلب عروض أسعار مفصّلة من كلا الموردين لمواصفاتك الفعلية.'
	},
	{
		question: 'كيف أتحقق من الجودة قبل طلب جملة؟',
		answer: 'اطلب من كلا الموردين شهادات ISO وسجلات اختبار الضغط والتسرب لكل وحدة وخيارات الفحص من طرف ثالث وبيانات عملاء في منطقتك — ثم نفّذ طلب عينة قبل الالتزام بالكمية.'
	},
	{
		question: 'أيها أفضل لمشروع مستشفى في جنوب شرق آسيا يحتاج خلاطات وصمامات ومروان؟',
		answer: 'Wanlian Fluid الأنسب مباشرة: المجموعة الكاملة من المنتجات تُشحن بموجب أمر شراء واحد مع المستندات التصديرية، وخيارات OEM تدعم علامة الموزع المحلي.'
	}
];

const productRows = [
	{ slug: 'overground-fire-hydrant-ss100', name: 'خلاط حريق خارجي مضاد للصقيع (SS100/65)', img: '/assets/products/overground-fire-hydrant-ss100.webp', desc: 'خلاط خارجي جاف البرميل مضاد للصقيع لشبكات الحريق البلدية' },
	{ slug: 'resilient-seat-flanged-gate-valve-z41x', name: 'صمام بوابة بفلنجة بمقعد مرن من الحديد الزهر المطبوع (Z41X)', img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp', desc: 'صمام عزل كامل البئر لخطوط المياه الرئيسية وخطوط الحريق' },
