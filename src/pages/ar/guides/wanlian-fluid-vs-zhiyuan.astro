---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'zhiyuan-overview', label: '1. Zhiyuan Fire: من هي فعليًا' },
	{ id: 'wanlian-overview', label: '2. Wanlian Fluid: من نحن فعليًا' },
	{ id: 'side-by-side', label: '3. مقارنة جنبًا إلى جنب' },
	{ id: 'water-vs-gas', label: '4. السؤال الحقيقي: مائي أم غازي؟' },
	{ id: 'quality-and-certifications', label: '5. أنظمة الجودة والشهادات' },
	{ id: 'where-each-wins', label: '6. أين يفوز كل مصنع' },
	{ id: 'which-should-you-choose', label: '7. أيهما تختار؟' },
	{ id: 'faq', label: 'الأسئلة الشائعة' },
	{ id: 'sources', label: 'المصادر' }
];

const faq = [
	{
		question: 'هل Wanlian Fluid وZhiyuan Fire شركة واحدة أو مرتبطة؟',
		answer: 'لا. هما مصنعان مستقلان في محافظتين مختلفتين وفئتين مختلفتين. Zhiyuan Fire هي Jiangxi Zhiyuan Fire Technology Co., Ltd، مقرها مدينة Xinyu بمقاطعة Jiangxi، متخصصة في أنظمة الإطفاء الغازي والمواد الخاصة. أما Wanlian Fluid فهي Quanzhou Wanlian Fluid Equipment Co., Ltd، مقرها Quanzhou بمقاطعة Fujian، متخصصة في الحماية من الحريق المائية والصمامات الصناعية. لم تنشر أي من الشركتين ملكية أو مصنعًا أو علامة مشتركة.'
	},
	{
		question: 'أيّهما أختار لمشروع تخزين طاقة أو بطاريات؟',
		answer: 'قسّم النطاق حسب الخطر. غرف البطاريات المغلقة وغرف الكهرباء وغرف المحولات ولوحات محطات التحويل تحتاج إطفاء غازيًا أو بمادة خاصة (FM200، IG541، C6، Aerosol) — وهذه الفئة المنشورة لدى Zhiyuan Fire. أما الساحة والمناطق الصناعية وشبكات المياه وأي حماية بمدافع أو خلاطات فمائية — وهذه فئة Wanlian Fluid. كثير من مشاريع تخزين الطاقة تحتاج فعليًا الموردين الاثنين لأجزاء مختلفة من قائمة المواد.'
	},
	{
		question: 'هل تصنع Zhiyuan Fire خلاطات حريق أو مدافع مياه أو صمامات مائية؟',
		answer: 'لا — نطاقها المنشور يغطي الإطفاء الغازي والمواد الخاصة (سباعي فلورو بروبان، مسحوق جاف فائق الدقة، Aerosol ساخن، IG541، IG100/نيتروجين نقي، CO2 عالي الضغط، أنبوب كشف الحريق، Perfluorohexanone) إضافة إلى أنظمة الرذاذ المائي الدقيق عالي الضغط. الخلاطات ومدافع مياه الحريق وصمامات إنذار الرش وصمامات خطوط إمداد المياه غير موجودة في كتالوجها المنشور. هذه هي الخطوط الأساسية لدى Wanlian Fluid.'
	},
	{
		question: 'ما الشهادات التي أطلبها من كل شركة؟',
		answer: 'من Zhiyuan Fire: شهادات منتجات الحريق من مركز اعتماد منتجات الحريق التابع لوزارة إدارة الطوارئ (Ministry of Emergency Management) للنظام والموديل المحدد الذي تحدده، إضافة إلى أدلة أهليتها الهندسية وأهليتها في المعدات الخاصة عندما يكون النطاق تسليمًا كليًا. من Wanlian Fluid: شهادة ISO 9001:2015، وشهادات UL 262/UL 1091 وFM 1120/1130 الموديل-بالموديل للموديلات المحددة في صفحة الشهادات، ووثائق CE عند الحاجة، وتسجيلات اختبار ضغط الجسم واختبار تسرب الهواء لكل وحدة. في الحالتين: تحقّق من رقم الشهادة على البوابة الرسمية للجهد المصدّر قبل أن تحدده في مواصفاتك.'
	},
	{
		question: 'هل يقبل كلا المصنعين OEM / العلامة الخاصة؟',
		answer: 'Wanlian Fluid تقبل OEM/ODM صراحةً — علامة مخصصة وتغليف وموقع تقني بخمس لغات (EN/ES/RU/FR/AR) لموزّعين يبنيون علامتهم الخاصة. أما Zhiyuan Fire فنشر عن نفسها كمصنّع ومورّد ومقدّم خدمات تقنية مع أهلية عقد أعمال حريق من الدرجة الأولى، فتركيزها في الأنظمة تسليم-كامل والتركيب؛ اسألها مباشرة عن خيارات العلامة لسوقك قبل أن تفترض التوريد باسم علامتك.'
	},
	{
		question: 'هل يمكن أن يستخدم مشروع واحد الشركتين دون تعارض؟',
		answer: 'نعم — وهذا شائع في مشاريع البتروكيماويات والصناعة والطاقة: حماية مائية (خلاطات، رش، مدافع، صمامات) للمناطق الصناعية والمباني من مورد، وإطفاء غازي لغرف الكهرباء وغرف الخوادم وغرف البطاريات من مورد آخر. النطاقان لا يتداخلان، فيمكن تسعيرهما وفحصهما وشحنهما بشكل مستقل. يغطي whitepaper مخاطر التوريد عبر الحدود لدينا كيفية إدارة التحقق ودفعات كل نطاق.'
	}
];

const productRows = [
	{ slug: 'auto-tracking-jet-suppression-cannon-zdms', name: 'مدفع إطفاء نفاث بتتبّع آلي (سلسلة ZDMS)', img: '/assets/products/auto-tracking-jet-suppression-cannon-zdms.webp', desc: 'مدفع ماء بتتبّع ذاتي مع كشف لهب لمزارع الخزانات والمناطق المفتوحة' },
	{ slug: 'overground-fire-hydrant-ss100', name: 'خلاط حريق خارجي مضاد للتجمد (SS100/65)', img: '/assets/products/overground-fire-hydrant-ss100.webp', desc: 'خلاط خارجي جاف مضاد للتجمد لشبكات الحريق البلدية' },
	{ slug: 'glass-bulb-fire-sprinkler-zst', name: 'رأس رش حريق بكبسولة زجاجية (سلسلة ZST)', img: '/assets/products/glass-bulb-fire-sprinkler-zst.webp', desc: 'رؤوس معلقة وبسطحية لأنظمة رش المباني' }
