---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'the-8-point-verification-checklist', label: 'قائمة التحقق الثمانية' },
	{ id: 'red-flags-summary', label: 'ملخص العلامات التحذيرية' },
	{ id: 'how-to-request-a-verified-quote', label: 'كيف تطلب عرض سعر موثّق' },
	{ id: 'faq', label: 'الأسئلة الشائعة' }
];

const faq = [
	{
		question: 'كيف أتحقق من أن مصنع الصمامات حقيقي؟',
		answer: 'اتبع قائمة التحقق في هذا الدليل: اطلب نسخ الشهادات (UL/FM/CE/ISO) وتحقّق منها، واطلب تقارير اختبار الضغط الهيدروليكي وتسريب المقعد لكل دفعة، واطلب عينة قبل الشحن، وقدّم — كلما أمكن — جولة مصوّرة في المصنع أو فحصًا ميدانيًا. المصنّعون الحقيقيون يستقبلون هذه الطلبات بترحيب؛ أما الوسطاء وشركات الواجهة فيترددون عادةً أو يُطلون الأمر.'
	},
	{
		question: 'ما المستندات التي يجب طلبها قبل وضع طلب صمامات؟',
		answer: 'الحد الأدنى: الترخيص التجاري، شهادات المنتجات المطبّقة (UL/FM/CE/LPCB/ISO)، تقارير اختبار الضغط الهيدروليكي وتسريب المقعد لكل دفعة، شهادات المواد للمكونات الحرجة، وبنود الفحص في العقد التجاري. للتصدير، تأكد أيضًا من وثائق بلد المنشأ والمستندات الجمركية المطلوبة.'
	},
	{
		question: 'ما MOQ ومدة التوريد المعقولتان لصمامات حماية الحريق؟',
		answer: 'الحد الأدنى للطلب (MOQ) القياسي عادةً 20–50 وحدة لكل نمط حسب نوع الصمام ومقاسه؛ ومدة التوريد للإنتاج عمومًا 15–30 يومًا. تكون العينات متاحة عادةً قبل الطلب الرئيسي. مدة توريد تتجاوز 45 يومًا دون تفسير هي علامة تحذيرية تستحق التوضيح.'
	},
	{
		question: 'كيف أفحص جودة المصنع بما يتجاوز المستندات؟',
		answer: 'اطلب جولة مصوّرة مباشرة في خط الإنتاج وورشة الاختبار، واطلب صورًا للدفعة الفعلية (لا صورًا جاهزة من الإنترنت)، وادرس إجراء فحص من طرف ثالث (بنمط SGS/BV/TUV) قبل الشحن. مصنع يُخفي أرضيته، مصنع لديه ما يُخفيه.'
	}
];

const referencePages = [
	{ slug: 'resilient-seat-flanged-gate-valve-z41x', name: 'صمام بوابة Z41X' },
	{ slug: 'overground-fire-hydrant-ss100', name: 'خلاط حريق SS100' },
	{ slug: 'wet-alarm-check-valve-zsfz-150', name: 'صمام إنذار رطب ZSFZ' }
];
---

<Layout
	title="قائمة تحقق توريد الصمامات B2B: كيف توثّق مصنع معدات الحريق"
	description="قائمة تحقق من 8 نقاط لتوثيق مصنع صمامات ومعدات الحريق قبل التوريد من الصين: الشهادات، تقارير الدفعات، العينات، تدقيق المصنع، شروط الدفع، العلامات التحذيرية."
	type="article"
	locale="ar"
	faq={faq}
	breadcrumbs={[{ name: 'أدلة', href: '/ar/blog/' }, { name: 'قائمة تحقق توريد الصمامات' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/blog/" class="hover:text-blue-600">الأدلة</a>
			<span>/</span>
			<span class="text-gray-600">توريد الصمامات</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">دليل التوريد</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">قائمة تحقق توريد الصمامات B2B: كيف توثّق مصنع معدات الحريق</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">معدات حماية الحريق من أجهزة السلامة الحياتية؛ صمام مزوّر أو لم يُختبر على نحو كافٍ قد يفشل في الحادثة ذاتها التي وُجد من أجلها. ومع ذلك، يزخر القطاع بشركات تجارية تُقدّم نفسها كمصنّعين. هذه القائمة هي ذات إجراءات التحقق من 8 نقاط التي يطبّقها المشترون علينا. استخدمها مع كل مورد — بمن فيهم نحن.</p>

			<TableOfContents headings={toc} />

			<h2 id="the-8-point-verification-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">قائمة التحقق الثمانية</h2>

			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">1. الشهادات — تحقّق، لا تجمع</h3>
			<p class="text-gray-700 leading-relaxed mb-4">اطلب وثائق الشهادات الفعلية (UL, FM, CE, LPCB, ISO 9001) وتحقّق من ثلاثة أشياء: تطابق اسم حامل الشهادة مع اسم المصنّع، أن المعيار/الإصدار الحالي سارٍ، وأن نطاق المنتجات في الشهادة يغطي النموذج الدقيق الذي تشتريه. الشعارات في كتيّب لا تثبت شيئًا. المصنّع الحقيقي ينشر حزمة شهاداته — حزمة شهاداتنا على <a href="/ar/certificates/" class="text-brand-blue font-semibold hover:underline">صفحة الشهادات</a>.</p>

			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">2. تقارير الاختبار — للدفعة، لا قالب</h3>
			<p class="text-gray-700 leading-relaxed mb-4">شهادة اختبار عامة يمكن تنزيلها من أي مكان. اطلب تقارير اختبار الضغط الهيدروليكي وتسريب المقعد الخاصة بـ<em>الدفعة الفعلية</em> التي ستستلمها، مع أرقام التسلسل والتواريخ. إن لم يستطع المورد تقديم تقارير على مستوى الدفعة، فربما «مصنّعك» لا يملك ورشة اختبار أصلًا.</p>

			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">3. أدلة المصنع — فيديو أو زيارة</h3>
			<p class="text-gray-700 leading-relaxed mb-4">جولة مصوّرة مباشرة في خط الإنتاج وركيزة الاختبار الهيدروليكي تستغرق عشر دقائق وتقصي معظم المنتحلين. إن رفض مورد ما أو أصرّ على صور جاهزة من الإنترنت، عامل الأمر كعلامة تحذيرية. للطلبات الكبيرة، خصص ميزانية لفحص من طرف ثالث (بنمط SGS/BV) قبل الشحن.</p>

			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">4. عينة قبل الطلب الرئيسي</h3>
			<p class="text-gray-700 leading-relaxed mb-4">اطلب وحدة عينة واحدة أولًا. اختبرها مقابل مواصفاتك، وزنْها، وقارن جودة الصبّ وسماكة الطلاء بصور المصنع. العينة تأمين رخيص — والمصنّع الحقيقي يبيعك عينة بارتياح.</p>

			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">5. جوهر الشركة</h3>
			<p class="text-gray-700 leading-relaxed mb-4">افحص الترخيص التجاري وعنوان المصنع ومدّة عمل الشركة. ابحث عن موقع حقيقي بعمق تقني (مواصفات، أوراق بيانات، أدلة) لا واجهة صفحة واحدة. المصنّع الذي يصدّر منذ سنوات يترك أثرًا تقنيًا قابلًا للتتبّع.</p>

			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">6. شروط الدفع</h3>
			<p class="text-gray-700 leading-relaxed mb-4">للطلبات الأولى، التقسيم 30/70 (30% دفعة مقدمة، 70% مقابل B/L أو الفحص) ممارسة قياسية. احذر المطالبات بسداد كامل مقدمًا أو الدفع إلى حسابات شخصية. استخدم اعتمادًا مستنديًا أو وسيلة دفع مؤمّنة حتى تتأسس الثقة.</p>

			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">7. مدة التوريد والتواصل</h3>
			<p class="text-gray-700 leading-relaxed mb-4">المصنع الكفء يجيب عن الأسئلة التقنية كتابيًا خلال يوم عمل واحد ويلتزم بجدول إنتاج يستطيع الوفاء به. فترات توريد غامضة، أو إجابات متهرّبة عن بيانات الاختبار، أو باعة لا يشرحون مواصفات منتجهم هم علامات إنذار.</p>

			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">8. قطع الغيار والدعم</h3>
			<p class="text-gray-700 leading-relaxed mb-4">اسأل عن قطع الغيار (الأحكام، الأعمدة، الموصلات) والدعم بعد البيع قبل الطلب لا بعد التفعيل. المصنّع الذي يخزّن قطع الغيار ويوثّق إجراءات الصيانة يبني علاقة طويلة الأمد؛ أما التاجر فيختفي بعد الشحن.</p>

			<h2 id="red-flags-summary" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">ملخص العلامات التحذيرية</h2>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>لا يستطيع تقديم تقارير اختبار على مستوى الدفعة</li>
				<li>اسم حامل الشهادة لا يطابق اسم «المصنع»</li>
				<li>يرفض الجولة المصوّرة أو الفحص المباشر</li>
				<li>يشترط دفع 100% مقدمًا</li>
				<li>فريق المبيعات لا يجيب عن أسئلة المواصفات الأساسية</li>
				<li>صور جاهزة من الإنترنت فقط، بلا توثيق تقني وبلا عمق هندسي في الموقع</li>
			</ul>

			<h2 id="how-to-request-a-verified-quote" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">كيف تطلب عرض سعر موثّق</h2>
			<p class="text-gray-700 leading-relaxed mb-4">الاستفسار الجيد يجلب ردًا جيدًا. تضمّن: نوع المنتج ونموذه، DN/PN، معيار الاتصال، الشهادة المطلوبة (UL/FM/CE/أخرى)، الكمية المستهدفة، بلد الوجهة والميناء. المورد الذي يجيب بورقة بيانات منظمة وخطة اختبار — لا سعرًا فقط — يثبت بالضبط الكفاءة التي تتحقق منها القائمة أعلاه.</p>
			<p class="text-gray-700 leading-relaxed">تصفّح منتجات ممثلة معتمدة لترى معيار التوثيق الذي نشحن به: <a href="/ar/products/resilient-seat-flanged-gate-valve-z41x/" class="text-brand-blue font-semibold hover:underline">صمام البوابة Z41X</a> و<a href="/ar/products/overground-fire-hydrant-ss100/" class="text-brand-blue font-semibold hover:underline">خلاط الحريق SS100</a> و<a href="/ar/products/wet-alarm-check-valve-zsfz-150/" class="text-brand-blue font-semibold hover:underline">صمام الإنذار الرطب ZSFZ</a>. ثم طبّق هذه القائمة علينا — نحن ننشر <a href="/ar/certificates/" class="text-brand-blue font-semibold hover:underline">شهاداتنا</a> و<a href="/ar/about/" class="text-brand-blue font-semibold hover:underline">ملفّ شركتنا</a>، ونجيب عن الأسئلة التقنية كتابيًا خلال يوم عمل واحد.</p>

			<!-- Related guide -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">دليل ذي صلة: اختيار صمامات UL</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">تبحث عن النوع الصحيح من صمامات UL المسجّلة والتحقيق من شهادات حقيقية؟ اقرأ <a href="/ar/guides/how-to-choose-ul-listed-fire-valves/" class="text-brand-blue font-semibold hover:underline">كيف تختار صمامات الحريق المسجلة لدى UL</a>.</p>
			</div>

			<!-- Related guide -->
			<div class="mt-6 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">دليل ذي صلة: عملية التحقق الكاملة</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">لعملية التحقق الكاملة خلف هذه القائمة — فحص صلاحية ISO 9001، الفحص من طرف ثالث، وعلامات التزوير التحذيرية — راجع <a href="/ar/guides/how-to-verify-chinese-valve-supplier/" class="text-brand-blue font-semibold hover:underline">كيف تتحقق من مورد صمامات ومعدات حريق صيني</a>.</p>
			</div>

			<!-- FAQ Section -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">الأسئلة الشائعة</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">مستعد لاختبارنا وفق هذه القائمة؟</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">أرسل RFQ — نرد عليك بالشهادات وتقارير اختبار الدفعة وورقة بيانات، لا بسعر فقط.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ar/contact/" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">أرسل RFQ الخاص بك</a>
						<a href="https://wa.me/8618684324501?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%2C%20%D8%A3%D8%B1%D8%BA%D8%A8%20%D8%A8%D8%A7%D9%84%D8%AA%D8%AD%D9%82%D9%82%20%D9%85%D9%86%20%D9%85%D8%B5%D9%86%D8%B9%D9%83%D9%85%20%D9%88%D8%A5%D8%B1%D8%B3%D8%A7%D9%84%20RFQ" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">دردشة على واتساب</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
