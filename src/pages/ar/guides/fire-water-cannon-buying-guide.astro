---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'do-you-need-a-water-cannon', label: '1. هل تحتاج فعلًا إلى مدفع مياه؟' },
	{ id: 'fixed-remote-or-auto-tracking', label: '2. ثابت، تحكم عن بُعد، أو تتبّع آلي؟' },
	{ id: 'sizing-flow-and-range', label: '3. حساب التدفق والمدى' },
	{ id: 'control-and-integration', label: '4. التحكم والتكامل' },
	{ id: 'procurement-checklist', label: '5. قائمة التحقق قبل الشراء' },
	{ id: 'faq', label: 'الأسئلة الشائعة' }
];

const faq = [
	{
		question: 'متى أحتاج مدفع ماء حريق بدل رؤوس الرش القياسية؟',
		answer: 'تلائم مدافع المياه المساحات المفتوحة الكبيرة أو ذات الأسقف العالية حيث تكون تغطية رؤوس الرش غير عملية: مناطق العمليات البتروكيميائية، مزارع خزانات النفط وLNG، منصات التحميل، حظائر الطائرات والمستودعات الكبيرة. توجّه نفاثًا مركّزًا عالي التدفق لمسافة 50–110 متر، تحت تحكم يدوي أو عن بُعد أو آلي.'
	},
	{
		question: 'ما معدل التدفق والمدى اللذان أحتاجهما؟',
		answer: 'يتبع التدفق الخطر: 5–30 ل/ث تكفي حماية المستودعات والقاعات، بينما تخدم 30–200 ل/ث مزارع الخزانات ووحدات المعالجة. يعتمد المدى على ضغط الدخول — عادةً 50–110 متر عند التدفق الاسمي. أرسل تخطيط موقعك وسيتولى مهندسونا تحديد النموذج.'
	},
	{
		question: 'مدفع تحكم عن بُعد أو تتبّع آلي — أيهما أختار؟',
		answer: 'إذا أمكن تواجد مشغّل، تمنحك نماذج التحكم عن بُعد التفافًا يدويًا مرنًا من مسافة آمنة. أما للمناطق غير المأهولة أو ذات المخاطر على مدار الساعة، فتكشف مدافع التتبّع الآلي بكواشف IR/UV اللهب وتصوّبه وتطلق النفاث خلال 30 ثانية دون تدخل بشري.'
	},
	{
		question: 'هل يمكن استخدام مدافع المياه مع الرغوة؟',
		answer: 'نعم. تدعم سلسلتنا PS وسطَي الماء والرغوة معًا، ويمكن تكامل تحضير الرغوة لمخاطر الفئة B (الوقود السائل). وخزانة الرغوة PSG30 خيار معبأ متكامل لمخاطر الوقود والكيميائيات الأصغر.'
	},
	{
		question: 'هل توفّرون المدفع مع النظام الكامل — الصمامات والموصلات والمضخات؟',
		answer: 'نعم. نصنع المدفع على خطوط إنتاجنا الخاصة ونشحنه مع صمامات وموصلات وخلاطات حريق وإكسسوارات مطابقة للحلقة الكاملة للإطفاء، ليصل طلبك كحزمة من مصنع واحد.'
	}
];

const cannonProducts = [
	{
		slug: 'auto-tracking-jet-suppression-cannon-zdms',
		name: 'مدفع التتبّع الآلي (ZDMS)',
		img: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		desc: 'كشف IR/UV، تدفق 5–150 ل/ث'
	},
	{
		slug: 'manual-fire-water-cannon-ps',
		name: 'مدفع ماء يدوي (PS)',
		img: '/assets/products/manual-fire-water-cannon-ps.webp',
		desc: '20–200 ل/ث، مدى حتى 110 م'
	},
	{
		slug: 'foam-fire-hydrant-cabinet-psg30',
		name: 'خزانة رغوة (PSG30)',
		img: '/assets/06_extinguishing_cannons/cannon_p42.webp',
		desc: 'AFFF 3% لحرائق الوقود والكيميائيات'
	}
];
---

<Layout
	title="دليل شراء مدفع ماء الحريق: ثابت أو تحكم عن بُعد أو آلي (2026)"
	description="كيف تختار مدفع ماء الحريق المناسب لموقعك: ثابت، تحكم عن بُعد، أو تتبّع آلي — حساب التدفق والمدى، التكامل مع أنظمة الإنذار، وقائمة تحقق قبل الشراء."
	type="article"
	locale="ar"
	faq={faq}
	breadcrumbs={[{ name: 'أدلة', href: '/ar/blog/' }, { name: 'دليل مدافع المياه' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/blog/" class="hover:text-blue-600">الأدلة</a>
			<span>/</span>
			<span class="text-gray-600">دليل مدافع المياه</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">دليل الإطفاء الصناعي</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">دليل شراء مدفع ماء الحريق: ثابت، تحكم عن بُعد، أو ذكي؟ (2026)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">مدفع ماء الحريق هو منظور مائي عالي التدفق يوجّه نفاثًا مركّزًا لمسافة 50–110 أمتار — أداة الإطفاء المفضلة للمصانع البتروكيميائية ومزارع الخزانات ومنصات التحميل والمستودعات الكبيرة حيث لا تصل رؤوس الرش. قرار الشراء ينحصر في أربعة أسئلة: ثابت أم قابل للتحكم، أي تدفق، أي مدى، وهل يحتاج إلى العمل تلقائيًا. يعالج هذا الدليل كل سؤال منها.</p>

			<!-- Product strip -->
			<div class="mt-8 grid grid-cols-2 lg:grid-cols-3 gap-4">
				{cannonProducts.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			
			<TableOfContents headings={toc} />

			<h2 id="do-you-need-a-water-cannon" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. هل تحتاج فعلًا إلى مدفع مياه؟</h2>
			<p class="text-gray-700 leading-relaxed mb-4">تبرّر مدافع المياه تكلفتها في ثلاث حالات: <strong>مساحات مفتوحة واسعة</strong> (مستودعات، قاعات، حظائر طائرات) حيث تتطلب كثافة رؤوس رش ثابتة غير عملية؛ و<strong>خطوط خطر خارجية</strong> (مزارع خزانات، منصات تحميل، وحدات معالجة) حيث لا توجد أسقف لتعليق رؤوس الرش؛ و<strong>مخاطر عالية القيمة</strong> حيث يفوق الإطفاء السريع المركّز أضرار المياه الواسعة. إذا كان موقعك مبنى مغلقًا بالاستخدام القياسي، فغالبًا يكون نظام الرش هو الحل الأنسب بدلًا من المدفع — راجع <a href="/ar/fire-sprinkler-systems/" class="text-brand-blue font-semibold hover:underline">صفحة أنظمة الرش</a>.</p>

			<h2 id="fixed-remote-or-auto-tracking" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. ثابت، تحكم عن بُعد، أو تتبّع آلي؟</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">النوع</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">طريقة التشغيل</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">الأنسب لـ</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">منظور ثابت</td>
							<td class="px-4 py-3 text-gray-700">توجيه بمقبض يدوي، وتثبيت ذاتي للغيار يحفظ الوضع</td>
							<td class="px-4 py-3 text-gray-700">المواقع ذات المشغّلين المناوبين؛ أساس اقتصادي</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">تحكم عن بُعد</td>
							<td class="px-4 py-3 text-gray-700">تحكم سلكي/لاسلكي من مسافة آمنة، تدوير 360°</td>
							<td class="px-4 py-3 text-gray-700">المخاطر القريبة التي لا تسمح بالتشغيل اليدوي</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">تتبّع آلي</td>
							<td class="px-4 py-3 text-gray-700">كشف لهب IR/UV، تصويب وإطلاق ذاتيان في ~30 ثانية</td>
							<td class="px-4 py-3 text-gray-700">المناطق غير المأهولة، مخاطر 24/7، متطلبات الاستجابة السريعة</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed mb-4">مدفع التتبّع الآلي <a href="/ar/products/auto-tracking-jet-suppression-cannon-zdms/" class="text-brand-blue font-semibold hover:underline">ZDMS</a> يجمع الاستشعار بالأشعة تحت الحمراء والأشعة فوق البنفسجية للتأكد من لهب حقيقي قبل العمل — ما يقلّل التنشيطات الخاطئة — ويدعم التفافًا يدويًا من حاسوب أو تطبيق جوال أو خزانة مركزية. وتبقى <a href="/ar/products/manual-fire-water-cannon-ps/" class="text-brand-blue font-semibold hover:underline">السلسلة اليدوية PS</a> الأداة الاقتصادية الموثوقة حيث يتواجد المشغلون.</p>

			<h2 id="sizing-flow-and-range" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. حساب التدفق والمدى</h2>
			<p class="text-gray-700 leading-relaxed mb-4">رقمان يحدّدا قدرة المدفع: <strong>معدل التدفق</strong> (ل/ث) و<strong>مدى النفاث</strong> (م). يحدّد الخطر وحساب طلب مياه الحريق التدفق؛ ويحدّد ضغط الدخول وتصميم الفوهة المدى.</p>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>مستودعات وقاعات</strong>: مدافع 5–30 ل/ث بنطاق مراقبة 40–65 م — نقطة قوة ZDMS.</li>
				<li><strong>مزارع خزانات ووحدات معالجة</strong>: 30–200 ل/ث بمدى نفاث حتى 110 م — نطاق السلسلة PS.</li>
				<li><strong>مخاطر الرغوة</strong>: حدد تحضير الرغوة أو وحدة معبأة مثل <a href="/ar/products/foam-fire-hydrant-cabinet-psg30/" class="text-brand-blue font-semibold hover:underline">خزانة الرغوة PSG30</a> لمخاطر الفئة B.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">قاعدة عملية: إذا لم تستطع تحديد التدفق بثقة، أرسل تخطيط الموقع وطلب مياه الحريق إلى المورد — فالنموذج الصحيح يستنبط من الخطر، لا من صفحة في الكتالوج.</p>

			<h2 id="control-and-integration" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. التحكم والتكامل</h2>
			<p class="text-gray-700 leading-relaxed mb-4">مدافع التتبّع الآلي لا تنفع إلا بقدر تكاملها: يجب ربطها بلوحة إنذار الحريق، واختبار مسار التفاف اليدوي (الخزانة المحلية أو المحطة البعيدة) مع مشغّليك. تفقّد واجهة الاتصال، وتصنيف مقاومة الانفجار إذا كان المدفع في منطقة مصنّفة (متوفر تصنيف Exde II BT4 Gb)، وتصنيف الحماية IP للتعرض الخارجي.</p>

			<h2 id="procurement-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. قائمة التحقق قبل الشراء</h2>
			<ol class="list-decimal ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>حدّد الخطر وطلب مياه الحريق؛ أكّد تدفق المدفع ومداه مع المورد.</li>
				<li>اختر نمط التحكم: ثابت، عن بُعد، أو تتبّع آلي — بما يناسب التجهيز البشري وزمن الاستجابة.</li>
				<li>أكّد توافق الوسيط (ماء فقط، أو تحضير رغوة).</li>
				<li>تفقّد تصنيفي مقاومة الانفجار والحماية IP لبيئة التركيب.</li>
				<li>اطلب حزمة الحلقة الكاملة: مدفع، صمامات، موصلات، خلاطات حريق — قائمة مواد واحدة من مصنع واحد.</li>
				<li>وضّح MOQ ومدة التوريد ودعم التركيب وقطع الغيار في العرض التجاري.</li>
			</ol>

			<!-- Cross-link to landing page -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">استكشف تشكيلة مدافع مياه الحريق لدينا</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">قارن النماذج الثابتة والمُتحكَّم عنها عن بُعد والذكية بمواصفاتها الكاملة في <a href="/ar/fire-water-cannon/" class="text-brand-blue font-semibold hover:underline">صفحة مدافع مياه الحريق</a>.</p>
			</div>

			<!-- Related guide -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">دليل ذو صلة: يدوي مقابل تتبّع آلي</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">تحتاج مقارنة تقنية مباشرة بين المنظور اليدوي (PS) ومدفع التتبّع الآلي (ZDMS)؟ راجع <a href="/ar/guides/fire-water-monitor-selection-guide/" class="text-brand-blue font-semibold hover:underline">دليل اختيار مدفع مياه الحريق</a>.</p>
			</div>

			<!-- FAQ -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">الأسئلة الشائعة</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">تحتاج مدفع ماء لموقعك؟</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">أرسل لنا تخطيط موقعك والمدى والتدفق المطلوبين — يوصي مهندسونا بالنموذج المناسب ويردون بعرض سعر كامل خلال 12 ساعة.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ar/contact/?product=Fire%20Water%20Cannon" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">اطلب عرض سعر</a>
						<a href="https://wa.me/8618684324501?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%DB%86%20%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%AF%D9%81%D8%B9%20%D9%85%D8%A7%D8%A2%20%D8%AD%D8%B1%D9%8A%D9%82" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">دردشة عبر واتساب</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
