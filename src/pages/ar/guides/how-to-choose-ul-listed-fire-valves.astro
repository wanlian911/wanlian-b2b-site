---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'what-ul-listing-means', label: '1. ما يعنيه اعتماد UL لصمامات الحريق' },
	{ id: 'fire-valve-types', label: '2. أنواع صمامات الحريق التي ستخصصها فعليًا' },
	{ id: 'key-specifications', label: '3. مواصفات رئيسية للمقارنة' },
	{ id: 'ul-vs-fm', label: '4. UL مقابل FM: أيهما تنص عليه العطاءات؟' },
	{ id: 'common-mistakes', label: '5. أخطاء شائعة في توريد صمامات الحريق' },
	{ id: 'procurement-checklist', label: '6. قائمة فحص قبل الطلب' },
	{ id: 'faq', label: 'الأسئلة الشائعة' }
];

const faq = [
	{
		question: 'هل شهادة UL إلزامية لصمامات الحريق؟',
		answer: 'في أمريكا الشمالية والعديد من المشاريع الدولية، نعم — يجب أن تكون صمامات حماية الحريق معتمدة UL أو ULC (أو FM Approved) للامتثال لمتطلبات NFPA وأكواد المباني المحلية. أما لأسواق أخرى فقد تنطبق معايير CE أو LPCB أو المعايير المحلية. تأكد دائمًا من الشهادة المطلوبة في السوق الوجهة.'
	},
	{
		question: 'ما الفرق بين UL Listed وFM Approved؟',
		answer: 'كلاهما شهادات طرف ثالث لمنتجات حماية الحريق. اختبارات الاعتماد UL تقيس الصمامات وفق معايير UL/ULC الخاصة بالهيكل والأداء؛ أما اعتماد FM فيضيف تفتيش المصنع ومتطلبات منع الخسائر. تقبل كثير من المشاريع أيً منهما، لكن بعض المواصفات تنص على أحدهما تحديدًا — راجع مستندات العطاء.'
	},
	{
		question: 'ما أنواع صمامات الحريق التي تكون عادةً معتمدة UL؟',
		answer: 'صمامات البوابة (OS&Y وNRS)، وصمامات الفراشة، وصمامات الرجوع، وصمامات الرش الشامل، وصمامات الفعل المسبق، وصمامات الإنذار الرجوعية هي الأنواع المعتمدة UL الشائعة المستخدمة في أنظمة الرش وعمود الماء، بمقاسات من 1½" إلى 12" تقريبًا.'
	},
	{
		question: 'كيف أتأكد أن شهادة UL لدى المورّد أصلية؟',
		answer: 'اطلب رقم الشهادة ورقم الملف، ثم ابحث بهما في قاعدة بيانات UL Product iQ الرسمية أو الدليل الإلكتروني للجهة المصدّقة. نسخة في نشرة تعريفية ليست دليلًا — يجب أن يكون الاعتماد ساريًا وأن يغطي النموذج والمقاس الدقيق اللذين تنوي شرائهما.'
	},
	{
		question: 'هل يمكن لـ Wanlian تزويد مشروعي بصمامات معتمدة UL؟',
		answer: 'نعم. تصنع Wanlian Fluid صمامات بوابة وفراشة ورجوع ورش شامل وفعل مسبق معتمدة UL/ULC وFM حيثما ينطبق ذلك. راجع صفحة صمامات الحريق UL أو صفحة الشهادات، وسيؤكد مهندسونا حزمة الشهادات المناسبة للسوق الوجهة.'
	}
];

const valveProducts = [
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'صمام بوابة بمقعد مرن (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'سدة مغلفة بمطاط EPDM، من DN50 إلى DN700'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'صمام فراشة بمسار (واfer) بوحدة إشارة',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp',
		desc: 'DN80 PN16 مع مراقبة حالة الصمام'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'مجموعة صمام رش شامل مع إنذار (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'تشغيل بالحجاب، من DN50 إلى DN300'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'نظام فعل مسبق مع إنذار (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'تصميم آمن بإشارات مزدوجة'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'صمام بوابة OS&Y بمقعد مرن معتمد UL/FM',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: 'صمام بوابة OS&Y بعمود صاعد معتمد UL/FM، أطراف بمسار من 2" إلى 10"'
	}
];
---

<Layout
	title="كيف تختار صمامات الحريق المعتمدة UL لمشروعك؟ دليل 2026"
	description="دليل اختيار صمامات الحريق المعتمدة UL/FM: أنواع الصمامات، مقارنة المواصفات، التحقق من الشهادات، وقائمة فحص قبل الشراء للمشترين في المشاريع وفق متطلبات NFPA."
	type="article"
	locale="ar"
	faq={faq}
	breadcrumbs={[{ name: 'أدلة', href: '/ar/blog/' }, { name: 'دليل صمامات الحريق UL' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/blog/" class="hover:text-blue-600">الأدلة</a>
			<span>/</span>
			<span class="text-gray-600">دليل صمامات الحريق UL</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">دليل اختيار صمامات حماية الحريق</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">كيف تختار صمامات الحريق المعتمدة UL لمشروعك (دليل 2026)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">صمام حماية الحريق هو المكوّن الذي يحدد ما إذا كان نظام الرش سيعمل يوم وقوع الحريق — وما إذا كان المبنى سيمرّ فحص السلامة قبل ذلك. اعتماد UL هو معيار القبول الذي تستند إليه معظم المشاريع الأمريكية الشمالية والعديد من المشاريع الدولية. يشرح هذا الدليل ما يعنيه اعتماد UL فعلًا، وأي أنواع الصمامات مشمولة بالاعتماد، وكيف تتحقق من صحة الشهادة، وما الذي يتعين فحصه قبل إصدار أمر الشراء.</p>

			<!-- Product strip -->
			<div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
				{valveProducts.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="what-ul-listing-means" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. ما يعنيه اعتماد UL لصمامات الحريق</h2>
			<p class="text-gray-700 leading-relaxed mb-4">اعتماد UL (Underwriters Laboratories) هو شهادة طرف ثالث على أن الصمام خضع للاختبار وفق معايير UL/ULC التي تغطي تصنيف الضغط، وخصائص التدفق، والمواد، والمتانة في خدمة حماية الحريق. إنه ليس شعارًا تسويقيًا — بل هو الأساس الموثّق الذي تستند إليه الجهات الرقابية المختصة (AHJ) لقبول الصمام في نظام رش أو عمود ماء.</p>
			<p class="text-gray-700 leading-relaxed">عندما تنص ورقة المواصفات على "UL listed"، تحقّق من ثلاثة أمور: أن الشهادة <strong>سارية</strong> (غير منتهية)، وأن تغطي <strong>النموذج والمقاس الدقيق</strong> اللذين تشتريهما، وأن <strong>رقم الشهادة</strong> قابل للاستعلام في قاعدة بيانات UL الرسمية. الشعار المطبوع على ورقة البيانات لا يثبت شيئًا بذاته.</p>

			<h2 id="fire-valve-types" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. أنواع صمامات الحريق التي ستخصصها فعليًا</h2>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">صمامات البوابة — معيار عزل النظام</h3>
			<p class="text-gray-700 leading-relaxed mb-4">تُعزل مقاطع نظام الرش للصيانة بصمامات البوابة. <a href="/ar/products/resilient-seat-flanged-gate-valve-z41x/" class="text-brand-blue font-semibold hover:underline">صمام البوابة Z41X بمقعد مرن</a> بسدّته المغلفة بالكامل بمطاط EPDM هو الخيار العملي: إغلاق بإحكام هوائي، وانخفاض في فقدان الضغط عند الفتح الكامل، ومقاسات من DN50 إلى DN700 تغطي كل شيء من خطوط التفرعات إلى الخطوط الرئيسية. الأنماط OS&amp;Y (برغي خارجي ووصاد) تُظهر حالة الفتح/الإغلاق للوهلة الأولى، وهو ما تفضّله الجهات الرقابية لصمامات المقاطع.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">صمامات الفراشة — تحكم مدمج مع مراقبة</h3>
			<p class="text-gray-700 leading-relaxed mb-4">حيث تكون المساحة ضيّقة، تتخذ صمامات الفراشة جزءًا يسيرًا من الطول بين الوجهين مقارنة بصمام البوابة. <a href="/ar/products/signal-grooved-wafer-butterfly-valve-dn80/" class="text-brand-blue font-semibold hover:underline">صمام الفراشة بمسار (واfer) بوحدة الإشارة</a> يضيف مفتاحًا ميكرويًا مدمجًا، فتعرف لوحة إنذار الحريق حالة فتح/إغلاق الصمام — وهو شرط لصمامات المقاطع المراقبة في الأنظمة الحديثة.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">صمامات الرش الشامل والفعل المسبق — عقل النظام</h3>
			<p class="text-gray-700 leading-relaxed mb-4">لأنظمة الرش الشامل (رؤوس رش مفتوحة أو فوهات رش)، <a href="/ar/products/deluge-alarm-valve-zsfm/" class="text-brand-blue font-semibold hover:underline">صمام الرش الشامل مع الإنذار ZSFM</a> يحبس ماء النظام تحت ضغط الحجاب ويفتح فورًا عند التحرير كهربائيًا أو هوائيًا أو يدويًا. حيث يجب تجنّب أضرار المياه — الأرشيف، مراكز البيانات، المتاحف — يتطلب <a href="/ar/products/pre-action-alarm-system-zsfy/" class="text-brand-blue font-semibold hover:underline">نظام الفعل المسبق ZSFY</a> إشارتين مستقلتين قبل إغراق الأنابيب.</p>

			<h2 id="key-specifications" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. مواصفات رئيسية للمقارنة</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">المواصفة</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">لماذا تهمّ</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">نطاق المقاسات</td>
							<td class="px-4 py-3 text-gray-700">طابقها لجدول الأنابيب — صمامات الحريق النموذجية تتراوح من DN40 إلى DN300 (1½"–12")</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">تصنيف الضغط</td>
							<td class="px-4 py-3 text-gray-700">PN16 (1.6 MPa) تغطي معظم الشبكات؛ PN25 للأبراج أو مناطق الضغط العالي</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">أطراف الاتصال</td>
							<td class="px-4 py-3 text-gray-700">بفلنجة للخطوط الرئيسية، بمسار للتثبيت السريع، بمسامير للتفرعات الصغيرة</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">مادة الجسم</td>
							<td class="px-4 py-3 text-gray-700">حديد الزهر المطبوع QT450 معيارًا؛ WCB/CF8/CF8M حيث تُطلب مقاومة أعلى للتآكل</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">الشهادات</td>
							<td class="px-4 py-3 text-gray-700">UL/ULC وFM وCE وLPCB — طبّقها حسب كود السوق الوجهة</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 id="ul-vs-fm" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. UL مقابل FM: أيهما تنص عليه العطاءات؟</h2>
			<p class="text-gray-700 leading-relaxed mb-4">كلاهما نظاما شهادات مقبولان لمعدات حماية الحريق، لكن كثيرًا ما تُكتب العطاءات لتنص على أحدهما. الاعتماد UL شائع في الإنشاءات التجارية الأمريكية؛ أما اعتماد FM فغالبًا ما يُطلب للمرافق المؤمَّنة لدى FM Global وللمواقع الصناعية عالية الخطورة. تقبل بعض المشاريع أيً منهما. إذا نصت مواصفاتك على "UL listed or FM approved"، فالمورّد الحاصل على كلتيهما يستطيع العطاء على أساس أيّهما — تحقّق من التغطية للنموذج والمقاس المحددين قبل تقديم السعر.</p>

			<h2 id="common-mistakes" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. أخطاء شائعة في توريد صمامات الحريق</h2>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>الشراء بوصف "مطابق لـ UL" بدل الاعتماد UL</strong> — "المطابقة" ليست شهادة. المنتج المعتمد برقم شهادة ساري فقط هو الذي يُحسب.</li>
				<li><strong>تجاهل مراقبة حالة الصمام</strong> — صمامات المقاطع التي تُغلق دون علم اللوحة سبب كلاسيكي لفشل الفحص؛ استخدم صمامات إشارة أو OS&amp;Y للمقاطع المراقبة.</li>
				<li><strong>تصنيف ضغط غير مطابق</strong> — صمام PN10 في شبكة PN16 يفشل اختبار الضغط الهيدروستاتيكي.</li>
				<li><strong>تخصيص نوع صمام خاطئ</strong> — صمام البوابة لا يؤدي عمل صمام الرش الشامل، والعكس صحيح. طابق الصمام لوظيفة النظام.</li>
				<li><strong>عدم التحقق من توفّر قطع الغيار</strong> — الأحكام والعمود ومجموعات الإصلاح يجب أن تُؤكد مع الطلب.</li>
			</ul>

			<h2 id="procurement-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. قائمة فحص قبل الطلب</h2>
			<ol class="list-decimal ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>تحقّق من الشهادة المطلوبة في السوق الوجهة (UL/ULC أو FM أو CE أو LPCB).</li>
				<li>اطلب رقم الشهادة وتحقّق منه في قاعدة بيانات UL/FM الرسمية.</li>
				<li>طابق DN وPN وأطراف الاتصال مع جدول أنابيبك.</li>
				<li>للأنظمة المراقبة، خصّص صمامات إشارة أو أنماط OS&amp;Y.</li>
				<li>اطلب تقرير اختبار الضغط الهيدروستاتيكي للدفعة، لا مجرد شهادة عامة.</li>
				<li>أكد MOQ ومدة التوريد وتوفّر قطع الغيار في عرض تجاري واحد.</li>
			</ol>

			<!-- Cross-link to landing page -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">استكشف مجموعتنا من صمامات الحريق المعتمدة UL</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">تصفّح السلسلة الكاملة — صمامات بوابة وفراشة ورجوع ورش شامل وفعل مسبق مع شهادات منشورة على <a href="/ar/certificates/" class="text-brand-blue font-semibold hover:underline">صفحة الشهادات</a> — في <a href="/ar/ul-fire-valves/" class="text-brand-blue font-semibold hover:underline">صفحة صمامات الحريق UL</a>.</p>
			</div>

			<!-- Related guide -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">دليل ذات صلة: التحقق من مورّدك</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">تحتاج إلى قائمة فحص من 8 نقاط للتحقق من أي مصنع صمامات قبل الطلب؟ اقرأ <a href="/ar/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">قائمة فحص توريد الصمامات B2B</a>.</p>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">UL هو قطعة واحدة فقط من معزوفة الامتثال — اقرأ <a href="/ar/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">معايير خلاطات الحريق وخراطيمه وصماماته مبسطة</a>، ثم تحقّق من أي مصنع عبر <a href="/ar/guides/how-to-verify-chinese-valve-supplier/" class="text-brand-blue font-semibold hover:underline">كيف تتحقق من مورد صمامات ومعدات حريق صيني</a>.</p>
			</div>

			<!-- FAQ -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">الأسئلة الشائعة</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

