---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'understand-your-requirement', label: 'افهم متطلب خلاطك أولًا' },
	{ id: 'hydrant-types-explained', label: 'أنواع خلاطات الحريق موضحة' },
	{ id: 'key-specifications', label: 'المواصفات الرئيسية للمقارنة' },
	{ id: 'certification-compliance', label: 'الشهادات والامتثال' },
	{ id: 'common-mistakes', label: 'أخطاء شائعة في اختيار الخلات' },
	{ id: 'factory-checklist', label: 'قائمة المصنع قبل الطلب' },
	{ id: 'faq', label: 'الأسئلة الشائعة' }
];

const faq = [
	{
		question: 'ما الفرق بين خلاطات الحريق الداخلية والخارجية؟',
		answer: 'تتصل رؤوس الخلاطات الداخلية (مثل رأس SN65) بأنظمة عمود الماء والخراطيم داخل المباني، وتُغذّي خراطيم الحريق عبر محطات خراطيم في الطوابق المحددة. أمّا الخلاطات الخارجية (مثل خلاط SS100 الأرضي) فتُركَّب على خطوط المياه البلدية أو الصناعية، وتُغذّي شاحنات الإطفاء وعمليات مكافحة الحريق الخارجية. النوعان يخدمان نقطتي توزيع مختلفتين ولا يتبادلان.'
	},
	{
		question: 'ما تصنيف الضغط الذي يجب أن يكون على خلاط حريق بلدي؟',
		answer: 'تصنّف الخلاطات البلدية القياسية عادةً عند PN16 (1.6 MPa)، وهو ما يغطي معظم شبكات إمداد المياه الحضرية والصناعية. قد تحتاج أحياء المباني العالية أو المناطق الصناعية عالية الطلب إلى خلاطات PN25 بسعة تدفق مؤكدة. تأكّد دائمًا من ضغط الشبكة الساكن والمتبقي قبل اختيار فئة الضغط.'
	},
	{
		question: 'هل خلاطات Wanlian متوفرة بشهادة UL أو FM؟',
		answer: 'نعم. تقدّم Wanlian Fluid خلاطات وصمامات بشهادات UL وFM وCE وISO 9001 وLPCB حسب النموذج وسوق الوجهة. تواصل مع فريق المبيعات بمواصفات مشروعك والمنطقة المستهدفة ليطابقوا حزمة الشهادات الصحيحة.'
	},
	{
		question: 'ما نوع الاتصال القياسي لخلاطات الحريق المصدَّرة؟',
		answer: 'تشمل اتصالات المخارج الشائعة موصل BS336 الفوري (بريطانيا/دول الكومنولث)، والمسمار NIST (الشرق الأوسط)، وKWS (ألمانيا)، وخيارات الفلنجة المرنة. يمكن لـ Wanlian توريد خلاطات SS100/65 وSSFT100/65 بنوع الاتصال المحدد لسوقك، ويمكن توريد قطع التثبيت في نفس الشحنة.'
	},
	{
		question: 'ما الحد الأدنى للطلب ومدة التوريد لطلبات الخلاطات الجملة؟',
		answer: 'عادةً يكون MOQ القياسي 20 وحدة لكل نموذج للمقاسات المخزنية، مع مدد إنتاج 15–30 يومًا حسب الكمية والتخصيص. تتوفر طلبات عينات للاختبار والموافقة قبل الشحن. يمكن لمهندس المبيعات لديك تقديم مدد توريد دقيقة مقابل حجم طلبك.'
	}
];

const hydrantProducts = [
	{
		slug: 'indoor-fire-hydrant-head-sn65',
		name: 'رأس خلاط حريق داخلي SN65',
		img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg',
		desc: 'خلاط داخلي بفلنجة حديد زهر مطبوع PN16 لأنظمة عمود الماء'
	},
	{
		slug: 'overground-fire-hydrant-ss100',
		name: 'خلاط حريق خارجي مقاوم تجمد (SS100/65)',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'خلاط خارجي مقاوم تجمد للشبكات البلدية في مناخ بارد'
	},
	{
		slug: 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100',
		name: 'خلاط مضاد اصطدام منظم ضغط (SSFT100/65)',
		img: '/assets/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100.webp',
		desc: 'جسم قابل للانفصال مع تحكم بتنظيم ضغط لمناطق المرور'
	},
	{
		slug: 'iot-smart-ground-fire-hydrant-ss100zn',
		name: 'خلاط أرضي ذكي IoT (SS100/65-1.6ZN)',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'مراقبة ضغط وميل وسرقة مياه لحظية لشبكات بلدية ذكية'
	}
];
---

<Layout
	title="كيف تختار خلاط حريق لمشاريع بلدية وصناعية"
	description="دليل اختيار خلاطات الحريق: داخلي مقابل خارجي، مواصفات DN/PN، أنواع الاتصال (BS336/NIST)، الشهادات (UL/FM/CE)، وقائمة مصنع لمشترين B2B."
	type="article"
	locale="ar"
	faq={faq}
	breadcrumbs={[{ name: 'أدلة', href: '/ar/blog/' }, { name: 'كيف تختار خلاط حريق' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/blog/" class="hover:text-blue-600">الأدلة</a>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">دليل معدات الحماية من الحريق</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">كيف تختار خلاط حريق لمشاريع بلدية وصناعية (دليل 2026)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">خلاط الحريق أصل ثابت سيبقى في شبكتك 10–20 عامًا — ولا فائدة منه إلا في اليوم الذي يجب أن يعمل فيه. اختيار النوع الخاطئ، أو فئة الضغط، أو معيار الاتصال يعني استبدال مكوّن مدفون تحت ظروف طوارئ، أو الأسوأ: خلاط لا يستطيع الإمداد عندما يصل رجال الإطفاء. يسلك هذا الدليل القرارات الستة التي يجب أن يتخذها كل فريق مشتريات، مع الإشارة إلى تكوينات منتجات حقيقية متوفرة اليوم.</p>

			<!-- Product strip -->
			<div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
				{hydrantProducts.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="understand-your-requirement" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. افهم متطلب خلاطك أولًا</h2>
			<p class="text-gray-700 leading-relaxed mb-4">قبل مقارنة النماذج، أجب عن أربعة أسئلة مع هيئة الحريق لديك أو مستشار الهندسة:</p>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>أين سيُركَّب الخلات؟</strong> نظام عمود ماء داخلي، خط بلدي خارجي، أم ساحة صناعية — كلٌّ منها يتطلب نوعًا مختلفًا.</li>
				<li><strong>ما هو تدفق وضغط التصميم؟</strong> يبدأ تدفق مكافحة الحريق عادةً من 15–30 ل/ث لكل خلاط؛ تأكّد من الضغط المتبقي الذي تستطيع شبكتك الاستمرار عليه.</li>
				<li><strong>أي معيار يحكم مشروعك؟</strong> تحدد NFPA 24/291، وBS 750، وGB 4452، أو الأكواد البلدية الإقليمية حجم المخارج والمسافات وقواعد الاختبار.</li>
				<li><strong>ما هو المناخ؟</strong> الشتاء المتجمد يتطلب تصميمات مقاومة تجمد أو برميل جاف.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">إجابتك الصحيحة عن هذه الأسئلة الأربع تتخلص من معظم الأخطاء أدناه قبل أن تفتح الكتالوج أصلًا.</p>

			<h2 id="hydrant-types-explained" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. أنواع خلاطات الحريق موضحة</h2>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">خلاطات داخلية (أنظمة عمود الماء)</h3>
			<p class="text-gray-700 leading-relaxed mb-4">تتصل رؤوس الخلاطات الداخلية بأنبوب عمود الماء الرأسي وتُغذّي محطات الخراطيم في كل طابق. رأس <a href="/ar/products/indoor-fire-hydrant-head-sn65/" class="text-brand-blue font-semibold hover:underline">خلاط الحريق الداخلي SN65</a> هو الواجهة القياسية: جسم حديد زهر مطبوع مصنف حتى PN16، بمدخل بمسار أو بفلنجة ومخرج 65&nbsp;ملم لاتصال الخراطيم. للمباني العالية والصناعية يُقرن عادةً ببكرات خراطيم الحريق وأنظمة المضخات.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">خلاطات أرضية خارجية (بلدية وصناعية)</h3>
			<p class="text-gray-700 leading-relaxed mb-4">تسحب الخلاطات الخارجية من خطوط المياه وتُغذّي شاحنات الإطفاء. يتفوق تكوينان: <a href="/ar/products/overground-fire-hydrant-ss100/" class="text-brand-blue font-semibold hover:underline">خلاط SS100/65 الخارجي</a> للساحات البلدية والصناعية القياسية، والمتغير المضاد للاصطدام. إذا كان خلاطك يقف في ممر مرور أو ممر مستودع تعمل فيه المركبات، فإن <a href="/ar/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100/" class="text-brand-blue font-semibold hover:underline">خلاط SSFT100 المضاد للاصطدام المنظم للضغط</a> يضيف آليتي سلامة: جسم قابل للانفصال ينقطع نظيفًا عند الاصطدام (مع بقاء الأنبوب الأرضي سليمًا)، وتنظيم ضغط يحمي الخراطيم أسفل التيار من الضغط الزائد.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">خلاطات ذكية للشبكات الرقمية</h3>
			<p class="text-gray-700 leading-relaxed mb-4">لمشغلي المياه البلدية الذين يحدّثون شبكتهم، <a href="/ar/products/iot-smart-ground-fire-hydrant-ss100zn/" class="text-brand-blue font-semibold hover:underline">خلاط SS100ZN الذكي IoT</a> يدمج حساسات لضغط لحظي وكشف ميل وكشف سرقة مياه، ويرسل إلى منصة SCADA. إنه نفس الخلات الميكانيكي مع طبقة مراقبة — مفيد عندما تتطلب عطاءك رؤية عن بُعد لحالة الخلات.</p>

			<h2 id="key-specifications" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. المواصفات الرئيسية للمقارنة</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">المواصفة</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">ماذا تتحقق</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">القياسي لخلاطات التصدير</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">المقاس الاسمي (DN)</td>
							<td class="px-4 py-3 text-gray-700">تطابق قطر المدخل والمخرج مع خطك الرئيسي وخراطيمك</td>
							<td class="px-4 py-3 text-gray-700">DN100/65 (SS100) أو DN65 (SN65)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">تصنيف الضغط (PN)</td>
							<td class="px-4 py-3 text-gray-700">يجب أن يتجاوز أقصى ضغط ساكن في الشبكة</td>
							<td class="px-4 py-3 text-gray-700">PN16 (1.6 MPa) قياسي؛ PN25 لمناطق الضغط العالي</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">مادة الجسم</td>
							<td class="px-4 py-3 text-gray-700">الزهر المطبوع يقاوم الاصطدام؛ تحقق الطلاء من التآكل</td>
							<td class="px-4 py-3 text-gray-700">حديد زهر مطبوع QT450 مع طلاء إبوكسي/بودرة</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">نوع الاتصال</td>
							<td class="px-4 py-3 text-gray-700">يجب أن يطابق موصلات فرقة الحريق المحلية</td>
							<td class="px-4 py-3 text-gray-700">BS336، NIST، KWS، بمسار أو بفلنجة</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">مزايا خاصة</td>
							<td class="px-4 py-3 text-gray-700">مقاومة تجمد، قابل للانفصال، منظم ضغط، IoT</td>
							<td class="px-4 py-3 text-gray-700">حسب متطلبات المشروع</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 id="certification-compliance" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. الشهادات والامتثال</h2>
			<p class="text-gray-700 leading-relaxed mb-4">خلاطات الحريق معدات سلامة حياة — الشهادة ليست اختيارية في معظم الأسواق. اطلب من موردك الشهادة المطابقة لوجهتك: <strong>UL / FM</strong> لأمريكا الشمالية، <strong>CE</strong> لأوروبا، <strong>LPCB</strong> لمشاريع بريطانيا/الكومنولث، و<strong>ISO 9001</strong> كنظام جودة أساسي. راجع الشهادات الفعلية، لا مجرد شعارات في كتيّب. حزمة شهادات Wanlian منشورة على <a href="/ar/certificates/" class="text-brand-blue font-semibold hover:underline">صفحة الشهادات</a>، وسيؤكّد مهندسونا أي معيار يطابق عطاءك قبل تسعير.</p>

			<h2 id="common-mistakes" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. أخطاء شائعة في اختيار الخلات</h2>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>معيار اتصال غير مطابق</strong> — خلاط لا يقبل موصلات فرقة الحريق المحلية أسوأ من عدم وجود خلاط. تأكّد معيار الموصّل قبل الطلب.</li>
				<li><strong>تجاهل الضغط المتبقي</strong> — الضغط الساكن لا يخبرك بشيء عمّا سيُقدّمه الخلات عند فتح ثلاثة مخارج في آنٍ واحد.</li>
				<li><strong>تركيب خلاطات غير مقاومة تجمد في مناخ متجمد</strong> — تلف البرميل من الجليد سبب رئيسي لفشل الخلاطات في المناطق الباردة.</li>
				<li><strong>اختيار خلاط قياسي لمناطق الاصطدام</strong> — اصطدامات الشاحنات تحني الأعواد الأرضية؛ التصميمات القابلة للانفصال تحمي الشبكة.</li>
				<li><strong>تخطي حديث قطع الغيار</strong> — أكّد توفر مجموعات الإصلاح (الأحكام، الأعواد، الموصلات) مع طلبك، لا بعد التشغيل.</li>
			</ul>

			<h2 id="factory-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. قائمة المصنع قبل الطلب</h2>
			<ol class="list-decimal ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>اطلب نسخ الشهادات (UL/FM/CE/ISO) ذات الصلة بسوقك — تحقق منها، لا تجمعها فقط.</li>
				<li>اطلب تقرير الاختبار الهيدروستاتيكي للدفعة المحددة، لا شهادة اختبار عامة.</li>
				<li>أكّد معيار الموصّل مع هيئة الحريق لديك <em>قبل</em> توقيع أمر الشراء.</li>
				<li>للخلاطات الذكية، اطلب مواصفة واجهة البيانات (modbus/SCADA) وجهاز عينة لاختبار التكامل.</li>
				<li>وضّح MOQ ومدة التوريد والتغليف للشحن البحري وتوفر قطع الغيار في عرض تجاري واحد.</li>
				<li>احتفظ بعينة ما قبل الشحن لاختبارك الخاص وأرشف صور الاختبار.</li>
			</ol>
			<p class="text-gray-700 leading-relaxed">يجب أن يجيب مورد موثوق على كل النقاط الستة كتابةً خلال يوم عمل واحد. إذا كان التسعير غامضًا في الشهادة أو تقارير الاختبار، فاعتبر ذلك إشارة تنبيه.</p>

			<!-- Related guide -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">دليل ذات صلة: Wanlian Fluid مقابل American AVK</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">أمام خيار بين علامة أمريكية راسخة ومصنع صيني؟ اقرأ مقارنة جنبًا إلى جنب: <a href="/ar/guides/wanlian-fluid-vs-american-avk/" class="text-brand-blue font-semibold hover:underline">Wanlian Fluid مقابل American AVK: أي مورد خلاطات وصمامات حريق يناسب مشروعك في 2026؟</a></p>
			</div>

			<!-- FAQ Section -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">الأسئلة الشائعة</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
