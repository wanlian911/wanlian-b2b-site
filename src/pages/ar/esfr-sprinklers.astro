---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'ما هو رشاش ESFR؟',
		answer: 'اختصار ESFR هو الإخماد المبكر عالي الاستجابة. يستخدم رأس الرش ESFR في هذه السلسلة تصميمًا عالي التدفق، وأنبوبة زجاجية سريعة الاستجابة عند 74°C، واتجاهًا معلقًا أو عموديًا للتخزين المرتفع على الرفوف والمستودعات والمنشآت الصناعية.'
	},
	{
		question: 'هل يمكن لرشاشات ESFR أن تحل محل رشاشات الرفوف؟',
		answer: 'يمكن ذلك في ترتيبات التخزين التي تستوفي معايير التصميم المعمول بها. يعتمد القرار النهائي على البضاعة المخزنة وارتفاع التخزين وارتفاع السقف وتخطيط الرفوف ومعامل K وضغط التصميم، لذلك يجب أن يوافق مصمم الحماية من الحريق والجهة المختصة على الترتيب.'
	},
	{
		question: 'كيف يؤثر معامل K على اختيار ESFR؟',
		answer: 'يحدد معامل K وضغط التشغيل كمية الماء التي يزود بها كل رأس. استخدم الحساب الهيدروليكي ومعايير التخزين لتحديد موديل ESFR؛ لا تختر رأسًا اعتمادًا على القطر الاسمي للأنبوب وحده.'
	},
	{
		question: 'أي تصنيف حرارة يستخدم رأس الرش ESFR؟',
		answer: 'يُحدد منتج ESFR بأنبوبة زجاجية سريعة الاستجابة عند 74°C (165°F). تحقق من ظروف المحيط ومن المدرج أو الموافقة المطلوبة لمشروع الوجهة قبل الطلب.'
	},
	{
		question: 'ما الذي يجب أن تشمله حزمة رشاشات ESFR؟',
		answer: 'يبدأ الطلب المعتاد بجدول الرؤوس ثم يضيف رؤوس الرش المختارة، وصمام الرجوع الإنذاري الرطب، ومؤشرات تدفق الماء، وصمامات العزل المراقبة، وأي ملحقات نظام قياسية يتطلبها التصميم المعتمد.'
	},
	{
		question: 'هل يمكنكم تسعير قائمة مواد رشاشات المستودع بالكامل؟',
		answer: 'نعم. أرسل جدول الرؤوس المعتمد، ومعلومات التخزين والسقف، وبيانات التصميم الهيدروليكي، وجدول الصمامات. يمكننا تسعير الرؤوس الموثقة ومكونات النظام كحزمة مشروع واحدة.'
	}
];

const products = [
	{
		slug: 'esfr-sprinkler-head',
		name: 'ESFR Early Suppression Fast Response Sprinkler',
		img: '/assets/products/esfr-sprinkler-head.webp',
		desc: 'ESFR-202 / ESFR-242 / ESFR-363، 74°C، معلق وعمودي'
	},
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'Glass Bulb Fire Sprinkler (ZST Series)',
		img: '/assets/products/glass-bulb-fire-sprinkler-zst.webp',
		desc: 'DN15 / DN20، K=80 ±4 / K=115 ±9، معلق / عمودي / جانبي'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Wet Alarm Check Valve ZSFZ 150',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'DN100 / DN150 / DN200، 1.6 MPa، جرس إنذار وغرفة تأخير'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Vane Type Water Flow Indicator (ZSJZ Series)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'DN50–DN200، 1.2 / 1.6 MPa، تأخير قابل للضبط 2–60 ثانية'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Signal Butterfly Valve (DN80 PN16)',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80-overlay.png',
		desc: 'DN50–DN300، PN16، موضع فتح/إغلاق مراقب'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'UL/FM Fire Protection Resilient Seated OS&Y Gate Valve',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: '2"–10"، أطراف محززة، ساق صاعدة، مُدرج UL / FM'
	}
];
---

<Layout
	title="رؤوس رشاشات ESFR وأنظمة رش المستودعات | WLFE"
	description="رؤوس رشاشات ESFR لأنظمة رش المستودعات: قارن معامل K وتخطيط الضغط وبدائل رفوف التخزين وحزم الصمامات الكاملة من Wanlian."
	type="product"
	locale="ar"
	productData={{
		name: 'أنظمة رشاشات ESFR',
		image: '/assets/products/esfr-sprinkler-head.webp',
		description: 'رؤوس رشاشات ESFR ومكونات نظام حماية من الحريق موثقة للتخزين المرتفع على الرفوف والمستودعات والمنشآت الصناعية.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'رشاشات ESFR' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/products/" class="hover:text-blue-600">المنتجات</a>
			<span>/</span>
			<span class="text-gray-600">رشاشات ESFR</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">أنظمة رشاشات المستودعات — مباشر من المصنع</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">رؤوس رشاشات ESFR لحماية المستودعات المرتفعة</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">يُختار رأس رشاش ESFR عندما يتطلب تصميم المستودع تصريفًا سقفيًا سريعًا وعالي الكمية لحماية التخزين. توفر Wanlian رأس ESFR وصمامات العزل المراقبة ومكونات الإنذار والتدفق المحيطة به، بحيث يمكن تسعير التصميم المعتمد كحزمة واحدة منسقة.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['استجابة سريعة 74°C', 'معلق / عمودي', 'تخطيط معامل K', 'دعم قائمة مواد المستودع'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">رؤوس رشاشات ESFR ومكونات النظام</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{products.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">اختيار ESFR ومواصفاته</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">نقطة الاختيار</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">معلومات المنتج الموثقة</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">رأس ESFR</td><td class="px-4 py-3 text-gray-700">ESFR-202 / ESFR-242 / ESFR-363 و ZSTX-161؛ 74°C؛ معلق PY أو عمودي UY؛ وصلة لولبية R1/2" أو R3/4" NPT.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">التخطيط الهيدروليكي</td><td class="px-4 py-3 text-gray-700">استخدم تصميم التخزين المعتمد لتحديد معامل K وضغط التشغيل ومتطلب الماء وتباعد الرؤوس قبل الإصدار.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">خيار الرشاش القياسي</td><td class="px-4 py-3 text-gray-700">رؤوس ZST بأنبوبة زجاجية: DN15 / DN20، K=80 ±4 أو K=115 ±9، بأنواع معلق وعمودي وجانبي.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">الإنذار والتدفق</td><td class="px-4 py-3 text-gray-700">صمام الإنذار الرطب ZSFZ: DN100 / DN150 / DN200 عند 1.6 MPa؛ مؤشر التدفق ZSJZ: DN50–DN200 عند 1.2 / 1.6 MPa.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">العزل والمراقبة</td><td class="px-4 py-3 text-gray-700">صمام فراشة بإشارة: DN50–DN300، PN16، مع مفتاح إشارة كهربائية مدمج؛ صمام بوابة OS&Y: 2"–10"، محزز، مُدرج UL / FM.</td></tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">ما يجب أن تتضمنه طلبية ESFR واحدة</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2">
				<li><strong>جدول الرؤوس المعتمد</strong> — البضاعة المخزنة، ومعلومات الرفوف والسقف، وموديل الرأس، والاتجاه، ونوع الوصلة اللولبية، والكمية.</li>
				<li><strong>أساس التصميم الهيدروليكي</strong> — معامل K المختار، وضغط التصميم، ومتطلب الماء، ومعيار المشروع أو ملاحظات الجهة المختصة.</li>
				<li><strong>طقم تحكم النظام</strong> — صمام الرجوع الإنذاري الرطب، ومؤشرات تدفق الماء، وصمامات العزل المراقبة المحددة.</li>
				<li><strong>الوثائق والتغليف</strong> — بيانات المنتج، والشهادات المطلوبة، وكميات العبوات، ووسم سوق الوجهة، ويُأكد كل ذلك قبل الإنتاج.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">مصادر تصميم ESFR</h2>
			<p class="text-gray-700 leading-relaxed">لاتخاذ قرارات التصميم، راجع <a href="/ar/guides/commercial-building-sprinkler-system-bom-guide/" class="text-brand-blue font-semibold hover:underline">دليل قائمة مواد نظام الرشاشات</a>, <a href="/ar/guides/fire-sprinkler-head-selection-guide/" class="text-brand-blue font-semibold hover:underline">دليل اختيار رؤوس رش الحريق</a> and <a href="/ar/guides/fire-sprinkler-system-valves-guide/" class="text-brand-blue font-semibold hover:underline">دليل صمامات أنظمة رش الحريق</a>.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">الأسئلة الشائعة</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">تحتاج حزمة رشاشات ESFR للمستودع؟</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">أرسل جدول الرؤوس وأساس التصميم الهيدروليكي — سنؤكد قائمة المكونات ونرد بعرض سعر منسق خلال 12 ساعة.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ar/contact/?product=%D8%A3%D9%86%D8%B8%D9%85%D8%A9%20%D8%B1%D8%B4%D8%A7%D8%B4%D8%A7%D8%AA%20ESFR" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">اطلب عرض سعر</a>
						<a href="https://wa.me/8618684324501?text=%D9%85%D8%B1%D8%AD%D8%A8%D9%8B%D8%A7%D8%8C%20%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D8%AD%D8%B2%D9%85%D8%A9%20%D8%B1%D8%B4%D8%A7%D8%B4%D8%A7%D8%AA%20ESFR%20%D9%84%D9%84%D9%85%D8%B3%D8%AA%D9%88%D8%AF%D8%B9" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">دردشة عبر واتساب</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
