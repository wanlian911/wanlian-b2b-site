---
import Layout from '../../../layouts/Layout.astro';

const faq = [
  {
    question: 'لماذا تعرض هذه الأداة مؤشرًا وليس سعرًا؟',
    answer: 'Wanlian Fluid تسعّر بالاستفسار، لذلك لا ننشر أسعارًا للوحدة. مؤشر التخطيط رقم نسبي (الخط الأساسي: 100 = خلاط حريق واحد، EXW، وجهة آسيا الشرقية) يتيح لك مقارنة التكوينات ورؤية أي العوامل — الحجم وشرط التصدير وجهة الشحن — تحرك تكلفة الوجهة النهائية. وهو للتخطيط فقط؛ عرض سعرك الفعلي المفصل يصل بالاستفسار خلال 12 ساعة.'
  },
  {
    question: 'ماذا تفعل مستويات الكمية بالمؤشر؟',
    answer: 'ينطبق على النموذج عامل كفاءة حسب إجمالي الوحدات: 1–9 (عينة) ×1.00، 10–99 (دفعة) ×0.90، 100–999 (جملة) ×0.82 و1,000+ (مشروع) ×0.75. كلما زاد الحجم انخفض مؤشر التخطيط للوحدة، انعكاسًا لاقتصاديات الإنتاج واللوجستيات.'
  },
  {
    question: 'ما مدى أثر شرط التصدير وجهة الشحن على النتيجة؟',
    answer: 'يضيف شرط التصدير عامل لوجستي (EXW ×1.00، FOB ×1.05، CIF ×1.15، DDP ×1.25) وتضيف الوجهة عامل مسافة/تعقيد (الآسيا الشرقية ×1.00 حتى أمريكا الشمالية ×1.30). معًا يحركان المؤشر عادةً بين 10 و50% مقابل الخط الأساسي EXW آسيا الشرقية.'
  },
  {
    question: 'هل يغيّر شيء حزمة بأمر شراء واحد (صمامات + خلاطات + خراطيم)؟',
    answer: 'نعم. توحيد الصمامات والخلاطات والخراطيم تحت صانع واحد وأمر شراء واحد يزيل هوامش موردين متعددين والشحن المنفصل وخطر التنسيق. أدخل كل بند في الأداة لترى مؤشر التخطيط المجمّع مقابل طلب كل عنصر من مصدر مختلف.'
  }
];
---

<Layout
  title="حاسبة تكلفة توريد الصمامات وخلاطات الحريق | Wanlian Fluid"
  description="أداة تفاعلية لتقدير مؤشر التكلفة النسبي للصمامات والخلاطات وخراطيم الحريق حسب الكمية وشرط التصدير وجهة الشحن. بلا أسعار ثابتة — اطلب عرض سعر في 12 ساعة."
  type="website"
  locale="ar"
  faq={faq}
  breadcrumbs={[{ name: 'الموارد' }, { name: 'حاسبة التكاليف' }]}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
    <nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
      <a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
      <span>/</span>
      <span class="text-gray-600">حاسبة التكاليف</span>
    </nav>

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
      <p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">أداة تفاعلية</p>
      <h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">حاسبة تكلفة توريد صمامات وخلاطات الحريق</h1>
      <p class="mt-5 text-gray-600 leading-relaxed text-lg">قدّر <strong>مؤشر التكلفة النسبي للوجهة النهائية</strong> لحزمة حماية حريق أو بنية مائية بتعديل الكميات وشروط التجارة وجهة الشحن. هذا نموذج تخطيط، لا قائمة أسعار — Wanlian Fluid تسعّر بالاستفسار، لذا المخرج هو مؤشر قابل للمقارنة يظهر كيف يحرك الحجم وشرط التصدير والمنطقة تكلفة. استخدمه لتشكل مواصفاتك قبل طلب عرض سعر رسمي.</p>

      <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 my-6">
        <p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-red">كيف تقرأ المؤشر:</strong> الخط الأساسي 100 = خلاط حريق واحد، EXW، وجهة آسيا الشرقية. المؤشر نسبي وللتنظيم فقط. المضاعفات المعروضة افتراضات معلنة للنموذج — سعرك الفعلي المفصل يعتمد على النموذج الدقيق والمقاس والمادة والمعيار والكمية، ويوفر بالاستفسار خلال 12 ساعة.</p>
      </div>

      <!-- ESTIMATOR -->
      <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 sm:p-8 my-6">
        <h2 class="text-lg font-black text-gray-900 mb-4">1 · رتّب حزمتك</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="line-items">
          <label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3">
            <span class="text-sm font-semibold text-gray-800">خلاطات حريق (SS100)</span>
            <input type="number" min="0" step="1" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="100" />
          </label>
          <label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3">
            <span class="text-sm font-semibold text-gray-800">صمامات بوابة (Z41X)</span>
            <input type="number" min="0" step="1" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="70" />
          </label>
          <label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3">
            <span class="text-sm font-semibold text-gray-800">صمامات إنذار رؤوس الرش</span>
            <input type="number" min="0" step="1" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="120" />
          </label>
          <label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3">
            <span class="text-sm font-semibold text-gray-800">خراطيم حريق (8-65، لكل 20 م)</span>
            <input type="number" min="0" step="1" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="25" />
          </label>
          <label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3">
            <span class="text-sm font-semibold text-gray-800">مانعات الارتداد</span>
            <input type="number" min="0" step="1" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="60" />
          </label>
          <label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3">
            <span class="text-sm font-semibold text-gray-800">طفايات حريق</span>
            <input type="number" min="0" step="1" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="20" />
          </label>
        </div>

        <h2 class="text-lg font-black text-gray-900 mt-6 mb-4">2 · شروط التجارة وجهة الشحن</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <label class="block">
            <span class="text-sm font-semibold text-gray-800">شرط التصدير</span>
            <select id="incoterm" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 text-sm bg-white">
              <option value="1.00">EXW (من المصنع، الصين)</option>
              <option value="1.05">FOB (ميناء الصين)</option>
              <option value="1.15" selected>CIF (مينائك)</option>
              <option value="1.25">DDP (مسلّم، الرسوم مدفوعة)</option>
            </select>
          </label>
          <label class="block">
            <span class="text-sm font-semibold text-gray-800">منطقة الوجهة</span>
            <select id="region" class="mt-1 w-full border border-gray-200 rounded-lg px-3 py-2 text-sm bg-white">
              <option value="1.00">الآسيا الشرقية</option>
              <option value="1.10">الشرق الأوسط</option>
              <option value="1.15">إفريقيا</option>
              <option value="1.20">أمريكا اللاتينية</option>
              <option value="1.25" selected>أوروبا</option>
              <option value="1.30">أمريكا الشمالية</option>
            </select>
          </label>
        </div>

        <button id="estimate" type="button" class="mt-6 w-full sm:w-auto px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">قدّر مؤشر التخطيط</button>
      </div>

      <!-- OUTPUT -->
      <div id="result" class="hidden rounded-2xl border border-brand-blue/30 bg-brand-blue/5 p-6 sm:p-8 my-6">
        <p class="text-xs font-black uppercase tracking-widest text-brand-blue mb-2">مؤشر التخطيط لديك</p>
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <span id="index-value" class="text-5xl font-black text-gray-900">–</span>
          <span id="band-label" class="text-lg font-bold text-brand-blue">–</span>
        </div>
        <p class="mt-3 text-sm text-gray-600"><span id="tier-label" class="font-semibold text-gray-800">–</span> · <span id="units-label">–</span> وحدة · <span id="incoterm-label">–</span> · <span id="region-label">–</span></p>
        <ul id="drivers" class="mt-4 list-disc ps-6 text-sm text-gray-700 leading-relaxed space-y-1"></ul>
        <div class="mt-5 rounded-xl bg-white border border-gray-100 p-4">
          <p class="text-sm font-semibold text-gray-900 mb-2">الخطوة التالية: حوّله إلى عرض سعر حقيقي</p>
          <p class="text-sm text-gray-600 mb-4">هذا المؤشر للتخطيط فقط. أرسل نفس المواصفة لفريقنا واستلم عرض سعر مفصلًا لكل وحدة مع سجلات اختبار — خلال 12 ساعة.</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/ar/contact/?product=%D8%AD%D8%A7%D8%B3%D8%A8%D8%A9%20%D8%A7%D9%84%D8%AA%D9%83%D8%A7%D9%84%D9%8A%D9%81%20%D9%88%D8%B9%D8%B1%D8%B6%20%D8%A7%D9%84%D8%B3%D8%B9%D8%B1" class="px-6 py-3 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition text-center">اطلب عرض سعر مفصل</a>
            <a href="https://wa.me/8618684324501?text=%D9%85%D8%B1%D8%AD%D8%A8%D9%8B%D8%A7%D8%8C%20%D8%A7%D8%B3%D8%AA%D8%AE%D8%AF%D9%85%D8%AA%20%D8%AD%D8%A7%D8%B3%D8%A8%D8%A9%20%D8%A7%D9%84%D8%AA%D9%83%D8%A7%D9%84%D9%8A%D9%81%20%D9%84%D8%AF%D9%8A%D9%83%D9%85%20%D9%88%D8%A3%D8%B1%D8%BA%D8%A8%20%D8%A8%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1%20%D8%AA%D9%81%D8%B5%D9%8A%D9%84%D9%8A" class="px-6 py-3 bg-white border border-brand-blue text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition text-center" target="_blank" rel="noopener">تحدث معنا عبر واتساب</a>
          </div>
        </div>
      </div>

      <!-- Citable driver model -->
      <h2 id="driver-model" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">محركات التكلفة وراء المؤشر</h2>
      <p class="text-gray-700 leading-relaxed mb-4">الحاسبة شفافة في افتراضاتها، لتستطيع استشهدها في ميزانية أو مناقصة. أربعة عوامل تحرك مؤشر التكلفة النسبي للوجهة النهائية؛ كل واحد مضاعف يطبق على الخط الأساسي للحزمة.</p>
      <div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">العامل</th>
              <th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">المستويات</th>
              <th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">الأثر على المؤشر</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <tr><td class="px-4 py-3 font-bold text-gray-900">الكمية / الحجم</td><td class="px-4 py-3 text-gray-700">عينة (1–9) · دفعة (10–99) · جملة (100–999) · مشروع (1,000+)</td><td class="px-4 py-3 text-gray-700">×1.00 حتى ×0.75 — الكفاءة لكل وحدة تزداد مع الحجم</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">شرط التصدير</td><td class="px-4 py-3 text-gray-700">EXW · FOB · CIF · DDP</td><td class="px-4 py-3 text-gray-700">×1.00 إلى ×1.25 — الشحن والتأمين ومسؤولية الرسوم الجمركية</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">منطقة الوجهة</td><td class="px-4 py-3 text-gray-700">الآسيا الشرقية → أمريكا الشمالية</td><td class="px-4 py-3 text-gray-700">×1.00 إلى ×1.30 — المسافة وتعقيد اللوجستيات</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">توحيد الحزمة</td><td class="px-4 py-3 text-gray-700">أمر شراء واحد (صمامات + خلاطات + خراطيم) مقابل متعدد الموردين</td><td class="px-4 py-3 text-gray-700">يزيل هوامش مكررة وشحنًا وخطر التنسيق</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-gray-700 leading-relaxed">في هذا النموذج، الانتقال من العينة إلى الحجم بالجملة يخفض مؤشر التخطيط للوحدة بنحو 10–25%؛ شروط CIF تضيف نحو 10–20% فوق FOB للشحن البحري والتأمين؛ والوجهات في أمريكا اللاتينية أو أوروبا تضيف نحو 15–30% فوق آسيا الشرقية لتعقيد اللوجستيات. هذه افتراضات معلنة وراء كل رقم تصدره الأداة.</p>

      <!-- Citable supplier comparison matrix -->
      <h2 id="supplier-matrix" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">مقابلة قابلة للاستشهاد: صانع صيني مقابل موزّع إقليمي غربي</h2>
      <p class="text-gray-700 leading-relaxed mb-4">مصفوفة نوعية عادلة للطريقين الشائعين لتوريد الصمامات والخلاطات والخراطيم خارج أمريكا الشمالية. استخدمها كنقطة مرجع عند شرح الأمر لفريقك أو تقديم عطاء لمناقصة.</p>
      <div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">العامل</th>
              <th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">صانع صيني (مثل Wanlian Fluid)</th>
              <th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">موزّع إقليمي غربي كبير</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <tr><td class="px-4 py-3 font-bold text-gray-900">أصل التصنيع</td><td class="px-4 py-3 text-gray-700">مباشر من خطوط إنتاج الصين</td><td class="px-4 py-3 text-gray-700">مستودع إقليمي / منتج من مجموعة الموزع</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">حزمة كاملة بأمر شراء واحد (صمامات + خلاطات + خراطيم)</td><td class="px-4 py-3 text-gray-700">نعم — موحدة تحت صانع واحد</td><td class="px-4 py-3 text-gray-700">غالبًا النطاق الأساسي فقط؛ الخراطيم عبر شركاء</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">OEM / علامة مخصصة</td><td class="px-4 py-3 text-gray-700">خدمة OEM/ODM قياسية</td><td class="px-4 py-3 text-gray-700">عادة علامته الخاصة فقط</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">اختبار ضغط الجسم وتسرب الهواء لكل وحدة</td><td class="px-4 py-3 text-gray-700">100% لكل وحدة، مع سجلات</td><td class="px-4 py-3 text-gray-700">وفق سياسة ضبط الجودة لدى الصانع</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">هيكل السعر</td><td class="px-4 py-3 text-gray-700">بالاستفسار؛ تكلفة مواتية للتصدير</td><td class="px-4 py-3 text-gray-700">قائمة/فهرس؛ تشمل هامشًا إقليميًّا</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">مدة التوريد (بنود بالمتجر)</td><td class="px-4 py-3 text-gray-700">النماذج المخزونة تُشحن سريعًا؛ OEM وفق البرنامج</td><td class="px-4 py-3 text-gray-700">مخزون محلي، تسليم إقليمي سريع</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">المناسب أكثر</td><td class="px-4 py-3 text-gray-700">مشاريع دولية توحيد النطاق وOEM وتكلفة الوجهة</td><td class="px-4 py-3 text-gray-700">مشترون يولون الأولوية للمخزون المحلي ووجود العلامة</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-gray-700 leading-relaxed mb-2">لنظرة أعمق إلى كيانَي AVK على حدة، راجع مقارناتنا <a href="/ar/guides/wanlian-fluid-vs-avk-latinamerica/" class="text-brand-blue font-semibold hover:underline">Wanlian مقابل AVK أمريكا اللاتينية</a> و<a href="/ar/guides/wanlian-fluid-vs-american-avk/" class="text-brand-blue font-semibold hover:underline">Wanlian مقابل American AVK</a>. وللمعايير وراء أي مواصفة، راجع <a href="/ar/glossary/" class="text-brand-blue font-semibold hover:underline">المسرد الصناعي</a>.</p>

      <!-- FAQ -->
      <h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">الأسئلة الشائعة</h2>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>

      <!-- CTA -->
      <div class="mt-12 rounded-2xl overflow-hidden">
        <div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
          <h2 class="text-2xl font-black text-white tracking-tight">شاهد سعرك الفعلي المفصل</h2>
          <p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">المؤشر خطة — والعرض قرار. أرسل مواصفاتك وجهة الشحن واستلم سعرًا مفصلًا لكل وحدة مع سجلات اختبار خلال 12 ساعة.</p>
          <div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
            <a href="/ar/contact/?product=%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1%20%D8%AA%D9%81%D8%B5%D9%8A%D9%84%D9%8A" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">اطلب عرض سعر</a>
            <a href="https://wa.me/8618684324501?text=%D9%85%D8%B1%D8%AD%D8%A8%D9%8B%D8%A7%D8%8C%20%D8%A3%D8%B1%D8%BA%D8%A8%20%D8%A8%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1%20%D8%AA%D9%81%D8%B5%D9%8A%D9%84%D9%8A%20%D9%84%D8%B5%D9%85%D8%A7%D9%85%D8%A7%D8%AA%20%D8%AD%D8%B1%D9%8A%D9%82%20%D9%88%D8%AE%D9%84%D8%A7%D8%B7%D8%A7%D8%AA%20%D9%88%D8%AE%D8%B1%D8%A7%D8%B7%D9%8A%D9%85" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">تحدث معنا عبر واتساب</a>
          </div>
        </div>
      </div>
    </article>
  </main>
</Layout>

<script>
  const tierLabel = (u) => u < 10 ? 'عينة' : u < 100 ? 'دفعة' : u < 1000 ? 'جملة' : 'مشروع';
  const tierMult = (u) => u < 10 ? 1.0 : u < 100 ? 0.9 : u < 1000 ? 0.82 : 0.75;
  const band = (i) => i < 150 ? 'أساسي / مبدئي' : i < 500 ? 'طلب قياسي' : i < 1500 ? 'حزمة شاملة' : i < 5000 ? 'مشروع كبير' : 'نطاق على مستوى برنامج';

  function estimate() {
    const inputs = [...document.querySelectorAll('.qty')];
    let base = 0; let units = 0;
    for (const inp of inputs) {
      const q = Math.max(0, parseInt(inp.value || '0', 10));
      const idx = parseFloat(inp.dataset.index || '0');
      base += q * idx; units += q;
    }
    if (units === 0) {
      document.getElementById('result').classList.remove('hidden');
      document.getElementById('index-value').textContent = '0';
      document.getElementById('band-label').textContent = 'لم تُحدد بنود';
      document.getElementById('tier-label').textContent = 'عينة';
      document.getElementById('units-label').textContent = '0';
      const d = document.getElementById('drivers'); d.innerHTML = '<li>أضف بندًا واحدًا على الأقل لترى مؤشر التخطيط ومحركات التكلفة.</li>';
      return;
    }
    const incoterm = document.getElementById('incoterm');
    const region = document.getElementById('region');
    const incMult = parseFloat(incoterm.value);
    const regMult = parseFloat(region.value);
    const tMult = tierMult(units);
    const index = Math.round(base * tMult * incMult * regMult);
    const tLabel = tierLabel(units);

    document.getElementById('index-value').textContent = String(index);
    document.getElementById('band-label').textContent = band(index);
    document.getElementById('tier-label').textContent = tLabel;
    document.getElementById('units-label').textContent = String(units);
    document.getElementById('incoterm-label').textContent = incoterm.options[incoterm.selectedIndex].text.split(' (')[0];
    document.getElementById('region-label').textContent = region.options[region.selectedIndex].text;

    const drivers = [
      `الخط الأساسي للحزمة (مؤشرات التكلفة للوحدة × الكميات): ${base}.`,
      `مستوى الحجم “${tLabel}” (${units} وحدة) يضرب بـ ${tMult.toFixed(2)} — ${units >= 100 ? 'كفاءة الحجم تخفض مؤشر الوحدة.' : 'قياس عينة/دفعة.'}`,
      `شروط ${incoterm.options[incoterm.selectedIndex].text.split(' (')[0]} تضرب بـ ${incMult.toFixed(2)} لمسؤولية الشحن/التأمين.`,
      `الوجهة ${region.options[region.selectedIndex].text} تضرب بـ ${regMult.toFixed(2)} للمسافة وتعقيد اللوجستيات.`,
      'المؤشر النسبي للتخطيط فقط — اطلب عرض السعر المفصل لمعرفة السعر الفعلي.'
    ];
    document.getElementById('drivers').innerHTML = drivers.map(x => `<li>${x}</li>`).join('');
    document.getElementById('result').classList.remove('hidden');
    document.getElementById('result').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
  document.getElementById('estimate').addEventListener('click', estimate);
</script>
