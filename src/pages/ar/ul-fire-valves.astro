---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'ماذا يعني المدرج UL لصمامات الحريق؟',
		answer: 'التدريج UL يتحقق من أن الصمام يلبي معايير UL/ULC للحماية من الحريق من حيث التدفق وتصنيف الضغط والمتانة، مما يضمن أداءً موثوقًا في أنظمة الرش وعمود الماء. إنه متطلب إلزامي لمعظم المشاريع الأمريكية الشمالية والعديد من المشاريع الدولية.'
	},
	{
		question: 'ما صمامات الحريق التي يصنعها Wanlian بتدريج UL؟',
		answer: 'نصنع صمامات البوابة والفراشة والرجوع والرش الشامل والفعل المسبق باتصالات بفلنجة وبمسار ومسنّنة من DN40 إلى DN300. تواصل مع فريق المبيعات بمواصفات مشروعك لمطابقة النوع الصحيح من الصمام وحزمة الشهادات.'
	},
	{
		question: 'هل يمكنكم توفير شهادة UL قبل الطلب؟',
		answer: 'نعم. شهاداتنا UL/ULC وFM متاحة عند الطلب — راجع صفحة الشهادات للمرجعية، وسيؤكد مهندسونا الشهادة الدقيقة المطبقة على سوق الوجهة لديك قبل عرض السعر.'
	},
	{
		question: 'ما الحد الأدنى للطلب ومدة التوريد لصمامات الحريق؟',
		answer: 'يعتمد الحد الأدنى للطلب على نوع الصمام وحجمه — عادةً 10–20 وحدة لكل نموذج للأحجام المتوفرة، مع مدد توريد إنتاجية 15–30 يومًا. الطلبات النموذجية متاحة للاختبار والمصادقة قبل الشحن.'
	},
	{
		question: 'هل تدعمون OEM/العلامة الخاصة لصمامات الحريق؟',
		answer: 'نعم، ندعم OEM/ODM مع تسمية وتغليف وضبط مواصفات مخصص حسب متطلبات المشروع. يُنفَّذ الإنتاج على خطوط الإنتاج الخاصة بنا وفق نظام إدارة جودة ISO 9001.'
	}
];

const valveProducts = [
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'صمام بوابة بمقعد مرن (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'شفة مغلفة EPDM، إحكام هوائي، DN50–DN700'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'صمام فراشة وافر بمسار وإشارة',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp',
		desc: 'DN80 PN16 مع مفتاح مراقبة حالة مدمج'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'صمام بوابة OS&Y UL/FM (بمسار)',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
	 desc: 'صمام بوابة مدرج UL/FM بعمود مرتفع، 2"–10"، أطراف بمسار'
	},
	{
		slug: 'sliding-ball-check-valve-hq41x',
		name: 'صمام رجوع كروي منزلق (HQ41X)',
		img: '/assets/products/spherical-ball-check-valve-hq44x.webp',
		desc: 'فقد منخفض، تصميم كرة متدحرجة غير مانعة للانسدال'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'مجموعة صمام إنذار رش شامل (ZSFM)',
	 img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'بالحجاب، DN50–DN300، فتح سريع'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'نظام إنذار فعل مسبق (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'تصميم فشل آمن بإشارة مزدوجة للغرف الحساسة للماء'
	}
];
---

<Layout
	locale="ar"
	title="صمامات حريق مدرجة UL | صانع صمامات حريق UL - WLFE"
	description="يصنع WLFE صمامات حريق مدرجة UL: أنواع البوابة والفراشة والرجوع والرش الشامل والفعل المسبق، مُنتجة على خطوط الإنتاج الخاصة بنا بجودة معتمدة وعرض سعر سريع."
	type="product"
	productData={{
		name: 'صمامات حريق مدرجة UL',
		image: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		description: 'صمامات بوابة وفراشة ورجوع و رش شامل وفعل مسبق مدرجة UL لأنظمة الحماية من الحريق، مقدمة من شركة قوانتشو وانليان للمعدات السائلة المحدودة.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'صمامات حريق UL' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/products/" class="hover:text-blue-600">المنتجات</a>
			<span>/</span>
			<span class="text-gray-600">صمامات حريق UL</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">صمامات حماية حريق معتمدة UL</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">صمامات حريق مدرجة UL لأنظمة حماية حريق موثوقة</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">تصنع Wanlian Fluid صمامات البوابة والفراشة والرجوع والرش الشامل والفعل المسبق المدرجة UL لأنظمة الحماية من الحريق التجارية والصناعية. كل صمام يُنتَج على خطوط الإنتاج الخاصة بنا قرب قوانتشو وفق نظام جودة ISO 9001 — مباشر من المصنع، بمدد توريد مستقرة وتوثيق شهادات كامل لمشروعك.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['مدرج UL/ULC', 'موافق FM', 'ISO 9001:2015', 'مباشر من المصنع'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">سلسلة صمامات الحريق</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{valveProducts.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">المواصفات الرئيسية</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">المواصفة</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">التفاصيل</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">المعايير</td>
							<td class="px-4 py-3 text-gray-700">مدرج UL / ULC، موافق FM (حسب النموذج وسوق الوجهة)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">نطاق الأحجام</td>
							<td class="px-4 py-3 text-gray-700">DN40 – DN300 (1½" – 12")</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">تصنيف الضغط</td>
							<td class="px-4 py-3 text-gray-700">PN16 / PN25 (حسب النموذج)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">مادة الجسم</td>
							<td class="px-4 py-3 text-gray-700">حديد زهر مطبوع QT450 / WCB / CF8 · CF8M فولاذ مقاوم للصدأ</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">اتصالات الأطراف</td>
							<td class="px-4 py-3 text-gray-700">بفلنجة / بمسار / مسنّنة</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">الوسيط</td>
							<td class="px-4 py-3 text-gray-700">ماء، محلول رغوة</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">التطبيقات</h2>
			<p class="text-gray-700 leading-relaxed">تُركّب صمامات الحريق UL لدينا في أنظمة الرش التجارية، والمنشآت الصناعية، والمستودعات ومراكز اللوجستية، ومراكز البيانات وشبكات الحريق البتروكيماوية — في أي مكان يكون فيه التحكم الموثوق المدرج في التدفق متطلبًا تنظيميًا.</p>

			<!-- Why WLFE -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">لماذا تختار Wanlian Fluid</h2>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>جودة معتمدة</strong> — شهادات UL/ULC وFM منشورة على <a href="/ar/certificates/" class="text-brand-blue font-semibold hover:underline">صفحة الشهادات</a>، قابلة للتحقق قبل طلبك.</li>
				<li><strong>مباشر من المصنع</strong> — مدد توريد مستقرة، ودعم OEM/ODM ومساعدة في الاختيار الهندسي.</li>
				<li><strong>طلب واحد، مصنع واحد</strong> — صمامات تُشحن مع رؤوس الرش والخلاطات والمكملات للحلقة الكاملة للإطفاء.</li>
			</ul>

			<!-- Related guide -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">جديد على معايير الصمامات؟</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">ابدأ بمرشد المشتري لدينا: <a href="/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">خلاطات الحريق و مران الحريق ومعايير الصمامات مفسرة</a>.</p>
			</div>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">الأسئلة الشائعة</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">تحتاج صمامات حريق UL لمشروعك؟</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">أرسل لنا نوع الصمام وDN/PN والشهادة المستهدفة — سيرد مهندسونا بورقة بيانات كاملة وعرض سعر خلال 12 ساعة.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ar/contact/?product=UL%20Fire%20Valves" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">اطلب عرض سعر</a>
						<a href="https://wa.me/8618684324501?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D8%B5%D9%85%D8%A7%D9%85%D8%A7%D8%AA%20%D8%AD%D8%B1%D9%8A%D9%82%20%D9%85%D8%AF%D8%B1%D8%AC%D8%A9%20UL" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">دردشة عبر واتساب</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
