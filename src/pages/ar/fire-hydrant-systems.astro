---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'ما الفرق بين خلاطات الحريق الداخلية والخارجية؟',
		answer: 'تتصل خلاطات الحريق الداخلية (رأس SN65) بأنظمة عمود الماء في المباني وتغذي محطات المران في كل طابق. خلاطات الحريق الخارجية (نوع SS100 الأرضي) تسحب من الشبكات البلدية أو الصناعية وتُغذي مركبات الإطفاء والمكافحة الخارجية. النوعان يخدمان نقاط توزيع مختلفة ويُحددان وفق معايير مختلفة.'
	},
	{
		question: 'ما معايير اتصال المخرج المتاحة لخلاطات التصدير؟',
		answer: 'تشمل اتصالات المخرج الشائعة BS336 (بريطانيا/الكومنولث) وNIST (الشرق الأوسط) وKWS (ألمانيا) وخيارات بفلنجة مرنة. نصنع في Wanlian خلاطات SS100/65 وSSFT100/65 بنوع الاتصال المحدد لسوقك، ويمكننا شحن الوصلات والموصلات المطابقة في نفس الحاوية.'
	},
	{
		question: 'هل خلاطات Wanlian متوفرة بشهادة UL أو FM؟',
		answer: 'نعم، حسب النموذج وسوق الوجهة. تواصل مع فريق المبيعات بمواصفات مشروعك والمنطقة المستهدفة لنطابق حزمة الشهادات الصحيحة — UL/FM لأمريكا الشمالية، CE لأوروبا، LPCB لمشاريع بريطانيا/الكومنولث.'
	},
	{
		question: 'أي خلاط أختار لمدينة ذات مناخ بارد؟',
		answer: 'يمتاز خلاط SS100 الخارجي بآلية تصريف جافة آلية ما بعد الإغلاق تمنع التجمد وانفجار العمود — الاختيار القياسي للشبكات البلدية في المناطق الباردة. للمواقع المعرضة للزحام المروري، يضيف متغير SSFT100 المضاد للاصطدام جسمًا قاطعًا وتنظيم ضغط.'
	},
	{
		question: 'هل يمكن دمج الخلاطات الذكية مع نظام SCADA لدينا؟',
		answer: 'نعم. ينقل خلاط SS100ZN IoT بيانات الضغط والميل وحالة الصمام عبر NB-IoT/LTE-M/GPRS ويتكامل مع منصات SCADA القياسية. اطلب مواصفة واجهة البيانات وجهازًا عينة لاختبار التكامل قبل الطلب.'
	}
];

const hydrantProducts = [
	{
		slug: 'indoor-fire-hydrant-head-sn65',
		name: 'رأس خلاط حريق داخلي SN65',
		img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg',
		desc: 'خلاط حريق داخلي PN16 من حديد الزهر المطبوع لأنظمة عمود الماء'
	},
	{
		slug: 'overground-fire-hydrant-ss100',
		name: 'خلاط حريق خارجي مضاد للتجمد (SS100/65)',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'تصميم جاف العمود مضاد للتجمد للشبكات البلدية في المناخات الباردة'
	},
	{
		slug: 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100',
		name: 'خلاط حريق مضاد للاصطدام منظم الضغط (SSFT100/65)',
		img: '/assets/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100.webp',
		desc: 'جسم قاطع + تنظيم ضغط لأفنية الزحام والصناعة'
	},
	{
		slug: 'iot-smart-ground-fire-hydrant-ss100zn',
		name: 'خلاط حريق أرضي ذكي IoT (SS100/65-1.6ZN)',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'مراقبة الضغط والميل وسرقة الماء في الوقت الفعلي للشبكات الذكية'
	},
	{
		slug: 'fire-hydrant-hose-coupling-adapter-hs',
		name: 'محول وصلات مران الألومنيوم (سلسلة HS)',
		img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg',
		desc: 'وصلات متوافقة مع BS336/NIST/KWS لاتصال الخلاط بالمران'
	}
];

const trustBadges = ['PN16 / 2.4 MPa مُختبَرة', 'BS336 / NIST / KWS', 'جاف العمود مضاد للتجمد', 'جاهز IoT / SCADA'];
---

<Layout
	locale="ar"
	title="أنظمة خلاط الحريق وصمامات خلاط الحريق البلدي - WLFE"
	description="أنظمة خلاط الحريق: رؤوس SN65 الداخلية، SS100 الخارجي، SSFT100 المضاد للاصطدام وSS100ZN الذكي. PN16، مباشر من المصنع مع اتصالات تصدير."
	type="product"
	productData={{
		name: 'أنظمة خلاط الحريق',
		image: '/assets/products/overground-fire-hydrant-ss100.webp',
		description: 'صمامات خلاط الحريق الداخلية والخارجية وأنظمة الخلاط الذكية للشبكات البلدية والأفنية الصناعية وأنظمة عمود الماء في المباني، من تصنيع شركة قوانتشو وانليان للمعدات السائلة المحدودة.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'أنظمة خلاط الحريق' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/products/" class="hover:text-blue-600">المنتجات</a>
			<span>/</span>
			<span class="text-gray-600">أنظمة خلاط الحريق</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">نطاق كامل لخلاطات الحريق — مصنوع داخليًا</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">أنظمة خلاط الحريق المتكاملة للشبكات البلدية والصناعية</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">تصنع Wanlian Fluid كامل نطاق خلاطات الحريق — رؤوس SN65 الداخلية وخلاطات SS100 الخارجية وخلاطات SSFT100 المضادة للاصطدام وخلاطات SS100ZN الذكية IoT — مع معايير اتصال التصدير (BS336, NIST, KWS) والوصلات المطابقة، كل ذلك على خطوط الإنتاج الخاصة بنا لشبكة الخلاط بأكملها.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">مكونات نظام خلاط الحريق</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydrantProducts.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">المواصفات الرئيسية</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">النموذج</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">النوع</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">الميزة الرئيسية</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">التصنيف</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SN65</td>
							<td class="px-4 py-3 text-gray-700">رأس خلاط داخلي</td>
							<td class="px-4 py-3 text-gray-700">دخول بمسار/بفلنجة، تثبيت خزانة حائطية</td>
							<td class="px-4 py-3 text-gray-700">PN16 (مُختبَرة 2.4 MPa)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SS100/65</td>
							<td class="px-4 py-3 text-gray-700">خلاط خارجي</td>
							<td class="px-4 py-3 text-gray-700">تصريف جاف عمود آلي مضاد للتجمد</td>
							<td class="px-4 py-3 text-gray-700">PN16، 2×65مم + 1×100مم مخارج</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SSFT100/65</td>
							<td class="px-4 py-3 text-gray-700">خلاط مضاد للاصطدام</td>
							<td class="px-4 py-3 text-gray-700">جسم قاطع + تنظيم ضغط + تصريف ذاتي</td>
							<td class="px-4 py-3 text-gray-700">PN16، براغي قطع معايرة</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SS100ZN</td>
							<td class="px-4 py-3 text-gray-700">خلاط ذكي IoT</td>
							<td class="px-4 py-3 text-gray-700">NB-IoT/4G، مراقبة ضغط/ميل/سرقة</td>
							<td class="px-4 py-3 text-gray-700">GB4452-2011، بطارية 5 سنوات</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">التطبيقات</h2>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>شبكات إمداد المياه البلدية وشبكات الحماية من الحريق</li>
				<li>الأفنية الصناعية ومزارع الخزانات ومكافحة حريق المستودعات</li>
				<li>أنظمة عمود الماء والمران في المباني (رؤوس خلاط داخلية)</li>
				<li>شبكات المدن الذكية ذات متطلبات المراقبة عن بعد</li>
				<li>التصاميم في المناخات الباردة التي تحتاج حماية من التجمد</li>
			</ul>

			<!-- FAQ Section -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">الأسئلة الشائعة</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">تحتاج شبكة خلاطات محددة لمشروعك؟</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">أرسل لنا DN/PN ومعيار الاتصال والشهادة المستهدفة — سيرد مهندسونا بورقة بيانات تقنية كاملة وعرض سعر خلال 12 ساعة.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ar/contact/?product=Fire%20Hydrant%20System" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">اطلب عرض سعر</a>
						<a href="https://wa.me/8618684324501?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%D9%81%D9%8A%20%D8%A7%D8%AE%D8%AA%D9%8A%D8%A7%D8%B1%20%D9%86%D8%B8%D8%A7%D9%85%20%D8%AE%D9%84%D8%A7%D8%B7%20%D8%A7%D9%84%D8%AD%D8%B1%D9%8A%D9%82" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">دردشة عبر واتساب</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
