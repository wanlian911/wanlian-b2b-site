---
import Layout from '../../layouts/Layout.astro';
import { guidesAr } from '../../utils/guides.ar';

// صفحات النظام / الحلول (ليست مقالات أدلة، تُعرض في مجموعة منفصلة)
const solutions = [
  {
    title: 'الحل: أنظمة خلاط الحريق',
    description: 'خلاطات داخلية وخارجية ومضادة للاصطدام وذكية IoT للشبكات البلدية والمنشآت الصناعية والمدن الذكية.',
    href: '/ar/fire-hydrant-systems/',
    date: '2026',
    category: 'حل منتج',
    readTime: '5 دقائق قراءة'
  },
  {
    title: 'الحل: منع الارتداد والتحكم الهيدروليكي',
    description: 'أجهزة منع ارتداد، صمامات خفض ضغط، صمامات تحكم مستوى وكهرومغناطيسية لمياه الشرب والسلامة الهيدروليكية.',
    href: '/ar/backflow-prevention/',
    date: '2026',
    category: 'حل منتج',
    readTime: '5 دقائق قراءة'
  },
  {
    title: 'تطبيقات: حماية الحريق، شبكات المياه، الخطوط الصناعية',
    description: 'اختيار المنتجات حسب التطبيق: من المياه البلدية وHVAC إلى مشاريع النفط والتخزين والبحري.',
    href: '/ar/applications/',
    date: '2026',
    category: 'تطبيقات',
    readTime: '5 دقائق قراءة'
  },
  {
    title: 'صمامات حريق UL، أنظمة رش، ومدافع مياه',
    description: 'أقسام الحلول لدينا: صمامات حريق UL، أنظمة رش، مدافع مياه — مع دليل تقني ووصلة طلب عرض سعر.',
    href: '/ar/ul-fire-valves/',
    date: '2026',
    category: 'حل منتج',
    readTime: '5 دقائق قراءة'
  },
  {
    title: 'الحل: مدافع مياه الحريق',
    description: 'مدافع مياه يدوية وذاتية التتبع لمصافي النفط والمستودعات والمطارات وغيرها من المواقع عالية الخطورة.',
    href: '/ar/fire-water-cannon/',
    date: '2026',
    category: 'حل منتج',
    readTime: '5 دقائق قراءة'
  },
  {
    title: 'الحل: أنظمة رش الحريق',
    description: 'صمامات إنذار رطبة، رش شامل، فعل مسبق ومؤشرات تدفق لأنظمة رش المباني التجارية والصناعية والتخزين.',
    href: '/ar/fire-sprinkler-systems/',
    date: '2026',
    category: 'حل منتج',
    readTime: '5 دقائق قراءة'
  }
];
---

<Layout
  title="المدونة وأدلة الشراء | Wanlian Fluid Equipment"
  description="أدلة شراء تقنية ومعرفة قطاعية: معدات حماية الحريق والصمامات الصناعية وأنظمة التحكم السوائل من Wanlian Fluid."
  locale="ar"
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-600 uppercase">المدونة والأدلة</span>
      <h1 class="text-4xl font-black text-gray-900 tracking-tight">أدلة الشراء والمعرفة القطاعية</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
        معرفة هندسية وتوريد عملية لمشاريع الحماية من الحريق والتحكم السوائل.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {guidesAr.map(article => (
        <a
          href={article.href}
          class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-8 flex flex-col"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2.5 py-1 bg-brand-blue/10 text-brand-blue text-[11px] font-black rounded-full uppercase tracking-wider">{article.category}</span>
            <span class="text-xs text-gray-400">{article.date} · {article.readTime}</span>
          </div>
          <h2 class="text-lg font-black text-gray-900 group-hover:text-brand-blue transition leading-snug mb-3">
            {article.title}
          </h2>
           <p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p>
           {article.tocPreview && article.tocPreview.length > 0 && (
             <div class="mt-4 rounded-lg border border-gray-100 bg-gray-50 px-4 py-3">
               <p class="mb-2 text-[10px] font-black uppercase tracking-widest text-brand-red">في هذا الدليل</p>
               <ol class="space-y-1">
                 {article.tocPreview.map((item, i) => (
                   <li class="flex items-baseline gap-2 text-xs leading-snug text-gray-500">
                     <span class="shrink-0 font-black tabular-nums text-gray-300">{String(i + 1).padStart(2, '0')}</span>
                     <span class="font-medium">{item}</span>
                   </li>
                 ))}
               </ol>
             </div>
           )}
           <div class="flex flex-wrap gap-2 mt-4">
            {article.tags.map(tag => (
              <a href={`/ar/tags/${tag}/`} class="text-[10px] font-bold text-gray-400 uppercase tracking-wider hover:text-brand-blue transition">#{tag.replace(/-/g, ' ')}</a>
            ))}
          </div>
          <span class="mt-6 inline-flex items-center text-brand-red font-bold text-sm group-hover:gap-2 transition-all">
            اقرأ الدليل
            <svg class="w-4 h-4 ms-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-16 mb-8 flex items-center gap-4">
      <h2 class="text-2xl font-black text-gray-900 tracking-tight">حلول المنتجات</h2>
      <div class="flex-1 h-px bg-gray-200"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {solutions.map(article => (
        <a
          href={article.href}
          class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-red/30 transition p-8 flex flex-col"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2.5 py-1 bg-brand-red/10 text-brand-red text-[11px] font-black rounded-full uppercase tracking-wider">{article.category}</span>
            <span class="text-xs text-gray-400">{article.date} · {article.readTime}</span>
          </div>
          <h2 class="text-lg font-black text-gray-900 group-hover:text-brand-red transition leading-snug mb-3">
            {article.title}
          </h2>
          <p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p>
          <span class="mt-6 inline-flex items-center text-brand-blue font-bold text-sm group-hover:gap-2 transition-all">
            استعرض الحل
            <svg class="w-4 h-4 ms-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4">
      <h2 class="text-2xl font-black">تحتاج استشارة تقنية محددة؟</h2>
      <p class="text-gray-400 max-w-xl mx-auto">
        يساعدك مهندسونا على اختيار الصمامات ومعدات الحماية من الحريق المناسبة لمشروعك.
      </p>
      <a href="/ar/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-xl hover:opacity-90 transition">
        اسأل مهندسًا
      </a>
    </div>
  </main>
</Layout>
