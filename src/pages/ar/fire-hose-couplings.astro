---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'هل كل موصل خرطوم حريق مقاس 2.5 إنش قابل للتبديل؟',
		answer: 'لا. المقاس الاسمي 2.5 إنش أو 65 مم لا يحدد نمط القفل أو النمط اللولبي. تتطلب موصلات طراز Storz أو National أو John Morris أو Nakajima أو الفورية نصف النظير المطابق أو محولًا موثقًا.'
	},
	{
		question: 'ما هو موصل Storz؟',
		answer: 'موصل Storz توصيل سريع متناظر. المنتج الموثق هو موصل ألماني المعيار مقاس 2.5 إنش من الألومنيوم بحافة ذاتية الإحكام، واتصال ربع دورة، وأشواك للخرطوم المسطح.'
	},
	{
		question: 'متى أستخدم موصل محول الخلاط؟',
		answer: 'استخدم محولًا عندما يختلف معيار مخرج الخلاط عن معيار الخرطوم أو الفوهة. تحقق من وصلة الطرفين، والقطر الاسمي، والجوان، وضغط التشغيل؛ فالمحول يحل عدم تطابق محدد، ولا يغطي جدول خراطيم غير مؤكد.'
	},
	{
		question: 'أي ضغط تشغيل يجب أن أحدد؟',
		answer: 'صنّف الخط الكامل: الخلاط، والموصل، والخرطوم، والفوهة، وأي محول. الموصل الموثق Storz ومحول مرن الخلاط HS مدرجان عند 1.6 MPa؛ تحقق من متطلب الضغط الدقيق للمجموعة الكاملة قبل الطلب.'
	},
	{
		question: 'هل أختار الألومنيوم أم النحاس؟',
		answer: 'الألومنيوم خفيف الوزن ويُستخدم في موصل Storz وفي موصل HS ضمن هذه السلسلة. يجب أن ينص الطلب على المادة المطلوبة والتشطيب والجوان وبيئة الخدمة؛ تحقق من أي خيار نحاس أو متطلب توافق مع عرض السعر.'
	},
	{
		question: 'ما الذي يجب أن يكون في طلبية موصلات واحدة؟',
		answer: 'حدد المعيار بالاسم، والقطر الاسمي، ونصف النظير، أو مؤخر الخرطوم أو الطرف اللولبي، والمادة، والجوان، وضغط التشغيل، وطول الخرطوم، ووصلة الفوهة. تكون عينة أو رسم أبعاد مفيدًا عندما لا يكون معيار الدفاع المدني المحلي واضحًا.'
	}
];

const products = [
	{
		slug: 'storz-coupling-2-5inch-aluminum',
		name: 'Aluminum Storz Fire Coupling (2.5" · German Standard)',
		img: '/assets/products/storz-coupling-2-5inch-aluminum-overlay.png',
		desc: 'Storz ألماني المعيار، ألومنيوم، 1.6 MPa، ذاتي الإحكام، بأشواك'
	},
	{
		slug: 'fire-hydrant-hose-coupling-adapter-hs',
		name: 'Aluminum Firefighting Hydrant Hose Coupling Adapter (HS Series)',
		img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg',
		desc: 'DN50 / DN65، ولبة داخلية 2.5 إنش، 1.6 MPa'
	},
	{
		slug: 'fire-hose-pvc-rubber-lining-8-65',
		name: 'PVC Rubber Lining Layflat Fire Hose (Model 8-65)',
		img: '/assets/products/fire-hose-pvc-rubber-lining-8-65.jpg',
		desc: 'قطر داخلي 19–400 مم، مقاس موصل قياسي 65 مم'
	},
	{
		slug: 'adjustable-pistol-grip-fire-nozzle',
		name: 'Adjustable Pistol Grip Firefighting Nozzle',
		img: '/assets/products/adjustable-pistol-grip-fire-nozzle.jpg',
		desc: 'مدخل 1.5" / 2" / 2.5"، 150–500 LPM، من تيار مستقيم إلى رذاذ'
	}
];
---

<Layout
	title="موصلات Storz وخراطيم الحريق ومحولات الخلاط | WLFE"
	description="اختيار موصل Storz وموصلات خراطيم الحريق ومحولات الخلاط: قارن المعايير والمواد وضغط التشغيل وصلات الخرطوم والفوهة لطلبيات B2B."
	type="product"
	locale="ar"
	productData={{
		name: 'موصلات خراطيم الحريق ومحولات الخلاط',
		image: '/assets/products/storz-coupling-2-5inch-aluminum-overlay.png',
		description: 'موصلات خراطيم الحريق، وصلات Storz، محولات مرن الخلاط، الخراطيم المسطحة، والفوهات القابلة للضبط لمجموعات خطوط الإطفاء لطلبيات B2B.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'موصلات خراطيم الحريق' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/ar/" class="hover:text-blue-600">الرئيسية</a><span>/</span><a href="/ar/products/" class="hover:text-blue-600">المنتجات</a><span>/</span><span class="text-gray-600">موصلات خراطيم الحريق</span></nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">وصلات خراطيم الحريق — مباشر من المصنع</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">اختيار موصل Storz وموصلات خراطيم الحريق</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">لا يكون موصل خرطوم الحريق صحيحًا إلا عندما يطابق معياره ونصف النظير والجوان والمادة والضغط بقية الخط. توفر Wanlian موصل Storz، ومحولات الخلاط، والخراطيم المسطحة، وصلات الفوهات للمشترين الذين يطلبون مجموعة اتصال كاملة.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">{['توصيل Storz السريع', 'محولات الخلاط', 'خرطوم 19–400 مم', 'فوهة 150–500 LPM'].map(b => (<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span></div>))}</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">منتجات موصلات خراطيم الحريق</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">{products.map(p => (<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition"><img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" /><div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p><p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p></div></a>))}</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">جدول معايير الموصلات والاختيار</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5"><table class="min-w-full divide-y divide-gray-200 text-sm"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">نقطة الاختيار</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">ما يجب التحقق منه</th></tr></thead><tbody class="bg-white divide-y divide-gray-200">
				<tr><td class="px-4 py-3 font-bold text-gray-900">Storz</td><td class="px-4 py-3 text-gray-700">توصيل Storz السريع الألماني المعيار؛ المنتج الموثق مقاس 2.5 إنش بهيكل ألومنيوم وحافة ذاتية الإحكام وأشواك وضغط 1.6 MPa.</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">National / John Morris / Nakajima / فوري</td><td class="px-4 py-3 text-gray-700">تعامل مع كل منها كوصلة مستقلة. تحقق من نمط الدفاع المدني المحلي واستخدم موصلًا أو محولًا مطابقًا موثقًا بدلًا من افتراض أن القطر الاسمي كافٍ.</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">محول الخلاط</td><td class="px-4 py-3 text-gray-700">سلسلة HS: مدى مقاسات DN50 / DN65، ولبة داخلية 2.5 إنش، سبيكة ألومنيوم مؤكسدة، وضغط تشغيل 1.6 MPa.</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Hose</td><td class="px-4 py-3 text-gray-700">خرطوم 8-65 ببطانة مطاط PVC: قطر داخلي 19–400 مم، مقاس الموصل القياسي 65 مم؛ تحقق من الطول والقطر وأطراف الموصلات.</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">الفوهة</td><td class="px-4 py-3 text-gray-700">فوهة بمقبض مسدسي قابل للضبط: مدخل 1.5" أو 2" أو 2.5"، سبيكة ألومنيوم، 150–500 LPM وأنماط من التيار المستقيم إلى الرذاذ.</td></tr>
			</tbody></table></div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">ما يجب أن تتضمنه طلبية موصلات واحدة</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2"><li><strong>المعيار ونصف النظير</strong> — Storz أو National أو John Morris أو Nakajima أو الفوري، مسميًا بوضوح لكل طرف.</li><li><strong>المقاس وتكوين الأطراف</strong> — القطر الاسمي للخرطوم، ومقاس الموصل، الوصلة اللولبية أو مؤخر الخرطوم، وما إذا كان الموصل مستقلًا أو مركبًا في المصنع.</li><li><strong>المادة والإحكام</strong> — الألومنيوم أو مادة أخرى محددة، التشطيب، الجوان، والوسيط مثل الماء الصافي أو خليط الرغوة.</li><li><strong>مطابقة الخط الكاملة</strong> — الخرطوم، والمحول، والفوهة، وضغط التشغيل، والطول، ووصلة الدفاع المدني في سوق الوجهة.</li></ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">مصادر موصلات خراطيم الحريق</h2>
			<p class="text-gray-700 leading-relaxed">اقرأ <a href="/ar/guides/how-to-choose-a-fire-hydrant/" class="text-brand-blue font-semibold hover:underline">دليل اختيار الخلاط</a>, <a href="/ar/guides/fire-hose-buying-guide/" class="text-brand-blue font-semibold hover:underline">دليل شراء خراطيم الحريق</a> and <a href="/ar/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">دليل معايير صمامات الخلاط</a> قبل إصدار جدول الموصلات.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">الأسئلة الشائعة</h2><div class="space-y-4">{faq.map(item => (<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>))}</div>

			<div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white tracking-tight">تحتاج طقم موصلات خراطيم حريق متوافقة؟</h2><p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">أرسل معيار الموصلات المحلي، ومقاس الخرطوم، ووصلة الفوهة — سنؤكد الحزمة المتوافقة ونرد بعرض سعر خلال 12 ساعة.</p><div class="mt-6 flex flex-col sm:flex-row justify-center gap-4"><a href="/ar/contact/?product=%D9%85%D9%88%D8%B5%D9%84%D8%A7%D8%AA%20%D8%AE%D8%B1%D8%A7%D8%B7%D9%8A%D9%85%20%D8%A7%D9%84%D8%AD%D8%B1%D9%8A%D9%82" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">اطلب عرض سعر</a><a href="https://wa.me/8618684324501?text=%D9%85%D8%B1%D8%AD%D8%A8%D9%8B%D8%A7%D8%8C%20%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D9%88%D8%B5%D9%84%D8%A7%D8%AA%20%D8%AE%D8%B1%D8%A7%D8%B7%D9%8A%D9%85%20%D8%A7%D9%84%D8%AD%D8%B1%D9%8A%D9%82" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">دردشة عبر واتساب</a></div></div></div>
		</article>
	</main>
</Layout>
