---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'ما مدى النفاث الفعلي لمدفع مياه الحريق؟',
		answer: 'يعتمد المدى على النموذج وضغط المدخل — عادةً من 50 إلى 110 مترًا عند التدفق المقنن لسلسلة PS لدينا، مع أنصاف أقطار مراقبة 40–65 م لسلسلة ZDMS ذاتية التتبع. أخبرنا بتخطيط موقعك وسنوصي بالنموذج المناسب.'
	},
	{
		question: 'هل يمكن تشغيل مدفع المياه عن بعد؟',
		answer: 'نعم. يعمل مدفع ZDMS ذاتي التتبع بشكل كامل مستقل مع كشف لهب IR/UV، ويدعم التغطية اليدوية عن بعد عبر PC أو تطبيق الجوال أو الخزانة المركزية. المنظورات الثابتة متوفرة أيضًا بتشغيل يدوي بدرفعة.'
	},
	{
		question: 'ما معدلات التدفق المتوفرة؟',
		answer: 'تتراوح النماذج القياسية من 5 ل/ث حتى 200 ل/ث. سلسلة ZDMS متوفرة عند 5 و10 و20 و30 ل/ث (قابلة للتخصيص حتى 150 ل/ث)، بينما تغطي سلسلة PS اليدوية 20–200 ل/ث. يمكن هندسة معدلات تدفق مخصصة لكل مشروع.'
	},
	{
		question: 'هل يتكامل النموذج الذكي مع أنظمة إنذار الحريق؟',
		answer: 'نعم، تستخدم مدافع المياه الذكية ZDMS مجسات الأشعة تحت الحمراء متعددة النطاقات والأشعة فوق البنفسجية للكشف التلقائي عن الحريق وتثبيته والإفلات خلال 30 ثانية، ويمكن ربطها بلوحات إنذار الحريق. تتوفر تركيبات مقاومة للانفجار كخيار.'
	},
	{
		question: 'هل توفرون النظام الكامل بما في ذلك الصمامات والأنابيب؟',
		answer: 'نعم. نصنع المدفع ونشحنه مع صمامات وصلات وخلاطات ومكملات مطابقة للحلقة الكاملة للإطفاء، ما يبسط التوريد ويضمن توافق النظام.'
	}
];

const cannonProducts = [
	{
		slug: 'auto-tracking-jet-suppression-cannon-zdms',
		name: 'مدفع نفاث ذاتي التتبع (ZDMS)',
		img: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		desc: 'كشف تلقائي IR/UV، دوران 360°، نصف قطر 40–65م'
	},
	{
		slug: 'manual-fire-water-cannon-ps',
		name: 'مدفع مياه حريق يدوي (سلسلة PS)',
		img: '/assets/products/manual-fire-water-cannon-ps.webp',
		desc: '20–200 ل/ث، مدى نفاث حتى 110م، ماء أو رغوة'
	},
	{
		slug: 'foam-fire-hydrant-cabinet-psg30',
		name: 'خزانة خلاط حريق بالرغوة (PSG30)',
		img: '/assets/06_extinguishing_cannons/cannon_p42.webp',
		desc: 'وحدة رغوة 3% AFFF لحرائق المواد الكيميائية والنفط'
	},
	{
		slug: 'fire-hose-reel-jpso8-19',
		name: 'طقم ملحقات بكرة مرن الحريق (JPS0.8-19)',
		img: '/assets/products/fire-hose-reel-jpso8-19.jpg',
		desc: 'مران مسطح 20–30م، تركيب متأرجح، استجابة سريعة'
	}
];
---

<Layout
	locale="ar"
	title="مدفع مياه الحريق | تحكم عن بعد ومنظورات حريق ذكية"
	description="مدافع مياه الحريق من WLFE تقدم إطفاء تدفق عالي ومدى بعيد للمنشآت والمرافئ والمستودعات. نماذج ثابتة وعن بُعد وذاتية التتبع ذكية."
	type="product"
	productData={{
		name: 'مدفع مياه الحريق',
		image: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		description: 'مدافع مياه حريق ثابتة وعن بُعد وذكية بتدفق 5-200 ل/ث ومدى حتى 110 م للحماية من الحريق الصناعي، من تصنيع شركة قوانتشو وانليان للمعدات السائلة المحدودة.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'مدفع مياه الحريق' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/products/" class="hover:text-blue-600">المنتجات</a>
			<span>/</span>
			<span class="text-gray-600">مدفع مياه الحريق</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">أنظمة مدافع مياه الحريق</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">أنظمة مدافع مياه الحريق للبيئات الصناعية عالية الخطورة</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">تصنع Wanlian Fluid مدافع مياه حريق عالية التدفق للمنشآت البتروكيماوية ومرافئ LNG والمستودعات والمطارات — من المنظورات اليدوية الثابتة إلى المدافع ذاتية التتبع المستقلة بالكامل مع التحكم عن بعد والذكي.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['تدفق حتى 200 ل/ث', 'مدى حتى 110 م', 'دوران 360°', 'كشف تلقائي IR/UV'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">سلسلة مدافع المياه</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{cannonProducts.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Core tech -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">المواصفات التقنية الأساسية</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">المواصفة</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">التفاصيل</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">التدفق المقنن</td>
							<td class="px-4 py-3 text-gray-700">5 – 200 ل/ث لكل نموذج (قابل للتخصيص حتى 150 ل/ث على ZDMS)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">مدى النفاث</td>
							<td class="px-4 py-3 text-gray-700">50 – 110 م حسب النموذج وضغط المدخل</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">الدوران</td>
							<td class="px-4 py-3 text-gray-700">أفقي 360°، رأسي -90° إلى +70°</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">أوضاع التحكم</td>
							<td class="px-4 py-3 text-gray-700">يدوي / عن بعد (PC، تطبيق الجوال، الخزانة المركزية) / تلقائي (كشف اللهب)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">مادة الجسم</td>
							<td class="px-4 py-3 text-gray-700">سبائك ألومنيوم T6 معالجة بالكروم الصلب / برونز، مجرى ماء SS304</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">اختياري</td>
							<td class="px-4 py-3 text-gray-700">مقاوم للانفجار (Exde II BT4 Gb)، تناسب الرغوة</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">التطبيقات</h2>
			<p class="text-gray-700 leading-relaxed">تحمي مدافع مياه الحريق مناطق العمليات البتروكيماوية ومزارع خزانات النفط وLNG ومرافئ التحميل والمستودعات الكبيرة وحظائر المطارات والمحطات الفرعية — مواقع سقف عالٍ أو مكشوفة حيث يجب أن يصل الإطفاء الثابت لمسافات طويلة تحت حرارة عالية.</p>

			<!-- Why WLFE -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">لماذا تختار Wanlian Fluid</h2>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>طلب واحد، مصنع واحد</strong> — مدافع مياه تُشحن مع صمامات وصلات وخلاطات مطابقة للحلقة الكاملة للإطفاء.</li>
				<li><strong>هندسة المشاريع</strong> — نوصي بالمدى والتدفق وتركيب التحكم من تخطيط موقعك.</li>
				<li><strong>جودة معتمدة</strong> — أنظمة جودة UL/ULC وFM وISO 9001؛ راجع <a href="/ar/certificates/" class="text-brand-blue font-semibold hover:underline">صفحة الشهادات</a>.</li>
			</ul>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">الأسئلة الشائعة</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">تحتاج مدفع مياه لموقعك؟</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">أرسل لنا تخطيط موقعك والمدى والتدفق المطلوبين — يوصي مهندسونا بالنموذج المناسب ويرد بعرض سعر كامل خلال 12 ساعة.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ar/contact/?product=Fire%20Water%20Cannon" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">اطلب عرض سعر</a>
						<a href="https://wa.me/8618684324501?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%AF%D9%81%D8%B9%20%D9%85%D9%8A%D8%A7%D9%87%20%D8%AD%D8%B1%D9%8A%D9%82" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">دردشة عبر واتساب</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
