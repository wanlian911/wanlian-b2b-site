---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'هل توردون مضخة الحريق نفسها؟',
		answer: 'لا. توفر Wanlian المحول والصمامات ومعدات الاتصال المرتبطة بمحيط مجموعة مضخة الحريق الموردة من جهة أخرى. يقدم مورد المضخة اختيار المضخة والمنحنى المعتمد؛ نستخدم مدخلات المشروع هذه لتنسيق المكونات المحيطة.'
	},
	{
		question: 'ما هو محول مضخة الحريق الشيميزي؟',
		answer: 'محول مضخة الحريق SQD100-1.6 هو اتصال شيميزي لهيئة الإطفاء بمدخلي DN65 ومخرج DN100 بشفة، مع صمام تحكم مدمج، لتغذية ماء سيارة الإطفاء في شبكة الحماية من الحريق.'
	},
	{
		question: 'أي صمام يوضع على جانب سحب المضخة؟',
		answer: 'يحدد ترتيب السحب تصميم غرفة المضخة المعتمد والجهة المختصة ذات الولاية. يُبقى على العزل مفتوحًا بالكامل عادة أثناء تشغيل المضخة؛ تحقق من نوع الصمام المختار ومقاسه واتصاله مع مورد المضخة والمصمم.'
	},
	{
		question: 'أين يوضع صمام الرجوع على خط التصريف؟',
		answer: 'ينسق صمام الرجوع على التصريف بين مجموعة مضخة الحريق الموردة من جهة أخرى وصمام عزل التصريف للحد من الرجوع الخلفي. الموقع النهائي والمقاس وفئة الضغط يتبعان مخطط الأنابيب المعتمد وبيانات مورد المضخة.'
	},
	{
		question: 'هل يمكن لصمام خفض الضغط أن يحل محل ضوابط المضخة؟',
		answer: 'لا. الطراز 500X صمام هيدروليكي لخفض الضغط لإدارة الضغط في المصب داخل خط ماء؛ وهو ليس بديلًا عن متحكم مضخة الحريق أو ترتيب تنفيس المضخة أو تصميم النظام المعتمد لمورد المضخة.'
	},
	{
		question: 'ما المعلومات التي يجب أن أرسلها لتسعير حزمة غرفة المضخة؟',
		answer: 'أرسل بيانات التدفق والرفع لدى مورد المضخة، ومقاسات أنابيب السحب والتصريف، ومعايير الاتصال، وترتيب الاختبار، ومعيار مدخل هيئة الإطفاء، والشهادات المطلوبة، وجدول الصمامات أو المرسومات.'
	}
];

const products = [
	{
		slug: 'sqd100-1-6-fire-pump-adapter',
		name: 'SQD100-1.6 Fire Pump Adapter (Siamese Connection)',
		img: '/assets/products/sqd100-1-6-fire-pump-adapter.webp',
		desc: '2 × مدخل DN65، مخرج بشفة DN100، 1.6 MPa'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'UL/FM Fire Protection Resilient Seated OS&Y Gate Valve',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: '2"–10"، أطراف محززة، ساق صاعدة، مُدرج UL / FM'
	},
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Ductile Iron Resilient Seat Flanged Gate Valve (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'DN50–DN700، PN10 / PN16، حديد مطيل، بشفاه'
	},
	{
		slug: 'spherical-ball-check-valve-hq44x',
		name: 'Spherical Cast Iron Ball Check Valve (HQ44X-16)',
		img: '/assets/products/spherical-ball-check-valve-hq44x.webp',
		desc: 'DN50–DN400، PN16، كرة EPDM غير قابلة للانسداد'
	},
	{
		slug: 'adjustable-pressure-reducing-valve-500x',
		name: 'Hydraulic Adjustable Pressure Reducing Valve (500X)',
		img: '/assets/products/pressure-reducing-valve-500x-dn50.webp',
		desc: 'DN20–DN600، ضبط 0.1–1.6 MPa، طيار هيدروليكي'
	}
];
---

<Layout
	title="محول مضخة الحريق واتصال شيميز وصمامات غرفة المضخة | WLFE"
	description="محول مضخة الحريق، واتصال شيميزي، وصمامات غرفة المضخة لترتيبات السحب والتصريف والاختبار حول مجموعة مضخة موردة من جهة أخرى."
	type="product"
	locale="ar"
	productData={{
		name: 'اتصالات مضخة الحريق وصمامات غرفة المضخة',
		image: '/assets/products/sqd100-1-6-fire-pump-adapter.webp',
		description: 'اتصالات هيئة الإطفاء، محولات المضخة، صمامات البوابة، صمامات الرجوع، ومكونات التحكم بالضغط لحزم غرفة مضخة الحريق المنسقة.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'اتصالات مضخة الحريق' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/products/" class="hover:text-blue-600">المنتجات</a>
			<span>/</span>
			<span class="text-gray-600">اتصالات مضخة الحريق</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">صمامات غرفة المضخة واتصالات هيئة الإطفاء</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">حزم محول مضخة الحريق وصمامات غرفة المضخة</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">غرفة مضخة الحريق ليست المضخة فقط: بل هي ترتيب السحب والتصريف والرجوع والعزل والاختبار الذي يتيح لمجموعة مضخة الحريق لدى المورد أن تعمل بأمان ويتيح لهيئة الإطفاء إضافة ماء عبر اتصال شيميز متوافق. توفر Wanlian الصمامات والاتصالات المحيطة؛ أما مجموعة مضخة الحريق فموردة من جهة أخرى.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['محول شيميزي', 'عزل السحب', 'رجوع التصريف', 'مجموعة المضخة من جهة أخرى'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span></div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">مكونات اتصال مضخة الحريق</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{products.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p><p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p></div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">جدول اختيار غرفة المضخة</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">الترتيب</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">مرجع اختيار موثق</th></tr></thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">اتصال هيئة الإطفاء</td><td class="px-4 py-3 text-gray-700">SQD100-1.6: مدخلا DN65 بأغطية SQS65 / KWS65، مخرج DN100 بشفة، 1.6 MPa، صمام تحكم مدمج.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">صمامات العزل</td><td class="px-4 py-3 text-gray-700">صمام بوابة OS&Y UL/FM: 2"–10"، أطراف محززة، ساق صاعدة؛ صمام بوابة بشفاه Z41X: DN50–DN700، PN10 / PN16.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">رجوع التصريف</td><td class="px-4 py-3 text-gray-700">صمام رجوع بكرة كروية HQ44X: DN50–DN400، 1.6 MPa (PN16)، قناة تدفق غير قابلة للانسداد وإحكام EPDM / NBR.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">إدارة الضغط</td><td class="px-4 py-3 text-gray-700">صمام خفض الضغط الهيدروليكي 500X: DN20–DN600؛ مدى الضبط 0.1–1.6 MPa؛ تحقق من دوره في التصميم المعتمد في المصب.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">بيانات المضخة والاختبار</td><td class="px-4 py-3 text-gray-700">وفّر بيانات التدفق والرفع لدى مورد المضخة، ومقاسات الأنابيب، وترتيب الاختبار، ومتطلبات الموافقة المعمول بها قبل التحديد النهائي لمقاسات الصمامات.</td></tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">ما يجب أن تتضمنه طلبية غرفة المضخة</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2">
				<li><strong>نقطة الاتصال</strong> — معيار مدخل شيميز، وشفة المخرج، وترتيب الأغطية، ووصلة هيئة الإطفاء.</li>
				<li><strong>طقم السحب والتصريف</strong> — صمام العزل، وصمام الرجوع، وأي عنصر تحكم بالضغط مطابق لجدول الأنابيب المعتمد.</li>
				<li><strong>تفاصيل الاختبار والتشغيل</strong> — ترتيب أنبوب الاختبار أو مخرج الاختبار، والأدوات الموردة من جهة أخرى عند الاقتضاء، والمنحنى المعتمد لمورد المضخة.</li>
				<li><strong>حزمة التقديم</strong> — المرسومات، وبيانات المنتج، والشهادات، وأبعاد الاتصال، وفئة الضغط، ووسم سوق الوجهة.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">مصادر تصميم غرفة المضخة</h2>
			<p class="text-gray-700 leading-relaxed">استخدم <a href="/ar/guides/fire-pump-suction-water-tank-guide/" class="text-brand-blue font-semibold hover:underline">دليل صمامات غرفة مضخة الحريق</a> لتخطيط السحب والتصريف والاختبار، و <a href="/ar/guides/fire-department-connection-siamese-guide/" class="text-brand-blue font-semibold hover:underline">دليل اتصال هيئة الإطفاء شيميز</a>، و <a href="/ar/guides/check-valve-types-guide/" class="text-brand-blue font-semibold hover:underline">دليل أنواع صمامات الرجوع</a> عند إعداد جدول الصمامات.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">الأسئلة الشائعة</h2>
			<div class="space-y-4">{faq.map(item => (<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>))}</div>

			<div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white tracking-tight">تحتاج حزمة اتصالات مضخة الحريق؟</h2><p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">أرسل بيانات التدفق والرفع لدى مورد المضخة وجدول الصمامات — سننسق حزمة المحول والصمامات الموثقة خلال 12 ساعة.</p><div class="mt-6 flex flex-col sm:flex-row justify-center gap-4"><a href="/ar/contact/?product=%D8%A7%D8%AA%D8%B5%D8%A7%D9%84%D8%A7%D8%AA%20%D9%85%D8%B6%D8%AE%D8%A9%20%D8%A7%D9%84%D8%AD%D8%B1%D9%8A%D9%82" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">اطلب عرض سعر</a><a href="https://wa.me/8618684324501?text=%D9%85%D8%B1%D8%AD%D8%A8%D9%8B%D8%A7%D8%8C%20%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D8%A7%D8%AA%D8%B5%D8%A7%D9%84%D8%A7%D8%AA%20%D9%85%D8%B6%D8%AE%D8%A9%20%D8%A7%D9%84%D8%AD%D8%B1%D9%8A%D9%82" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">دردشة عبر واتساب</a></div></div></div>
		</article>
	</main>
</Layout>
