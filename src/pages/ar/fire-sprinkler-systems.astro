---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'هل رؤوس الرش لديكم مدرجة UL؟',
		answer: 'نعم. رؤوس الرش ومكونات النظام لدينا مدرجة UL/ULC حيث ينطبق — الشهادات متاحة في صفحة الشهادات. يؤكد مهندسونا حزمة الشهادات الدقيقة لسوق الوجهة لديك قبل عرض السعر.'
	},
	{
		question: 'ما الفرق بين أنظمة الرش الرطبة والجافة؟',
		answer: 'الأنظمة الرطبة تحتفظ بالماء في الأنابيب للتفريغ الفوري عند تفعيل رأس الرش. الأنظمة الجافة تستخدم هواءً أو أزوت مضغوطًا مع صمام أنبوب جاف، مما يجعلها مناسبة للمساحات غير المدفأة حيث خطر تجمد الأنابيب. الأنظمة بفعل مسبق تجمع بين كلا المزايا للمناطق الحساسة للماء.'
	},
	{
		question: 'هل توفرون وصلات ساق رش مرنة؟',
		answer: 'نعم، نصنع وصلات ساق مرنة مضفورة من الفولاذ المقاوم للصدأ تبسط التركيب وتسمح بإعادة تموضع رؤوس الرش بسرعة لتطابق تخطيطات السقف — ما يقلل وقت العمل مقارنة بالأنابيب الصلبة.'
	},
	{
		question: 'هل يمكنكم توفير عرض سعر BOM كامل للنظام؟',
		answer: 'نعم. أرسلنا رسومات مشروعك أو قائمة المكونات وسنقدّم عرض سعر لرؤوس الرش وصمامات الإنذار ومؤشرات التدفق والفلاتر والمكملات كحزمة واحدة — طلب مصنع واحد للحلقة الكاملة للرش.'
	},
	{
		question: 'ما تصنيفات الحرارة المتوفرة؟',
		answer: 'تشمل تصنيفات الكبسولة الزجاجية القياسية 57°م، 68°م، 79°م، 93°م و141°م بكبسولات ملونة، من نوع الاستجابة القياسية (كبسولة 5مم) والاستجابة السريعة (كبسولة 3مم) وفق ممارسة NFPA.'
	}
];

const sprinklerProducts = [
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'رأس رش حريق بكبسولة زجاجية (سلسلة ZST)',
		img: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		desc: 'معلّق/عمودي/جانبي، K=80/115، 57–141°م'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'صمام رجوع إنذار رطب (ZSFZ 150)',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'جرس إنذار هيدروليكي، غرفة تأخير، DN100–DN200'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'مجموعة صمام إنذار رش شامل (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'بالحجاب، لأنظمة الرش الشامل ورش الماء'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'نظام إنذار فعل مسبق (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'فشل آمن بإشارة مزدوجة للمكتبات والأرشيف ومراكز البيانات'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'مؤشر تدفق ماء من نوع الشراع (ZSJZ)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'تأخير قابل للضبط 2–60ث، DN50–DN200، سرجي/بفلنجة'
	},
	{
		slug: 'telescopic-y-strainer-sgl41h',
		name: 'فلتر Y متسلسق (SGL41H)',
		img: '/assets/products/telescopic-y-strainer-sgl41h.webp',
		desc: 'يحمي الصمامات من الجسيمات، شبكة SS304/316'
	}
];
---

<Layout
	locale="ar"
	title="أنظمة رش الحريق ورؤوس الرش UL - WLFE"
	description="رؤوس رش مدرجة UL ووصلات مرنة ومكونات كاملة لأنظمة رش الحريق للمباني التجارية والصناعية. مباشر من المصنع."
	type="product"
	productData={{
		name: 'أنظمة رش الحريق',
		image: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		description: 'رؤوس رش مدرجة UL وصمامات إنذار ومؤشرات تدفق ومكونات النظام لأنظمة رش الحريق الرطبة والجافة وبفعل مسبق في المباني التجارية والصناعية، من تصنيع شركة قوانتشو وانليان للمعدات السائلة المحدودة.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'أنظمة رش الحريق' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/products/" class="hover:text-blue-600">المنتجات</a>
			<span>/</span>
			<span class="text-gray-600">أنظمة رش الحريق</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">أنظمة رش متكاملة — مباشر من المصنع</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">أنظمة رش حريق متكاملة بمكونات مدرجة UL</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">تصنع Wanlian Fluid وتصدر رؤوس الرش المدرجة UL ووصلات الساق المرنة وصمامات الإنذار وملحقات النظام لتثبيتات الرطب والجاف والفعل المسبق في المباني التجارية والصناعية — طلب مصنع واحد للحلقة الكاملة للرش.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['مدرج UL/ULC', 'K=80 / K=115', 'تصنيفات 57–141°م', 'BOM نظام كامل'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">مكونات نظام الرش</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{sprinklerProducts.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">المواصفات الرئيسية</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">المواصفة</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">التفاصيل</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">الاعتماد</td>
							<td class="px-4 py-3 text-gray-700">مدرج UL/ULC (حسب النموذج وسوق الوجهة)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">أحجام الرؤوس</td>
							<td class="px-4 py-3 text-gray-700">1/2" (DN15)، 3/4" (DN20)، 1" — معلّق، عمودي، جانبي</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">معامل التدفق</td>
							<td class="px-4 py-3 text-gray-700">K=80 ±4 / K=115 ±9 (معاملات K أخرى حسب النموذج)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">تصنيفات الحرارة</td>
							<td class="px-4 py-3 text-gray-700">57°م / 68°م / 79°م / 93°م / 141°م، كبسولات زجاجية ملونة</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">أنواع الاستجابة</td>
							<td class="px-4 py-3 text-gray-700">استجابة قياسية (كبسولة 5مم) / استجابة سريعة (كبسولة 3مم)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">صمامات النظام</td>
							<td class="px-4 py-3 text-gray-700">إنذار رطب (ZSFZ)، رش شامل (ZSFM)، فعل مسبق (ZSFY)، مؤشرات تدفق (ZSJZ)</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">التطبيقات</h2>
			<p class="text-gray-700 leading-relaxed">تحمي مكونات نظام الرش لدينا المباني المكتبية التجارية والفنادق والمستشفيات والمدارس والمصانع والمستودعات ومراكز البيانات والمواقف السفلية — مع توصية بأنظمة الفعل المسبق للمكتبات والأرشيف وغرف الحواسيب حيث يجب تجنب التفريغ العرضي.</p>

			<!-- Why WLFE -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">لماذا تختار Wanlian Fluid</h2>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>نظام كامل، طلب واحد</strong> — رؤوس ووصلات وصمامات إنذار ومكملات مقدَّمة كحزمة واحدة من مصنع واحد.</li>
				<li><strong>مكونات معتمدة</strong> — مدرجة UL/ULC حيث ينطبق؛ الشهادات في <a href="/ar/certificates/" class="text-brand-blue font-semibold hover:underline">صفحة الشهادات</a>.</li>
				<li><strong>موجه نحو أكواد البناء</strong> — تهيئة متوافقة مع ممارسة NFPA لقبول المشاريع العالمية.</li>
			</ul>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">الأسئلة الشائعة</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">تحتاج مكونات نظام رش؟</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">أرسل لنا نوع المبنى وقائمة المكونات — نرد بعرض سعر BOM كامل خلال 12 ساعة.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ar/contact/?product=Fire%20Sprinkler%20Systems" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">اطلب عرض سعر</a>
						<a href="https://wa.me/8618684324501?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D9%83%D9%88%D9%86%D8%A7%D8%AA%20%D9%86%D8%B8%D8%A7%D9%85%20%D8%B1%D8%B4%20%D8%A7%D9%84%D8%AD%D8%B1%D9%8A%D9%82" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">دردشة عبر واتساب</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
