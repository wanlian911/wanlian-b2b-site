---
import Layout from '../../layouts/Layout.astro';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';

const productName = Astro.url.searchParams.get('product') || "";
---

<Layout locale="ar" title="اتصل بنا | استفسار B2B فوري | Quanzhou Wanlian Fluid" description="اطلب عرض سعر B2B للصمامات الصناعية ومعدات الحماية من الحريق. شارك رسوماتك ومواصفاتك وسيرد فريقنا خلال 12 ساعة بالبريد أو واتساب.">
  <main id="inquiry" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-600 uppercase">التواصل والاستفسار</span>
      <h1 class="text-4xl font-black text-gray-900 tracking-tight">اطلب عرض سعر احترافي</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
        شارك متطلبات المنتج والمعايير والأحجام والتطبيق المستهدف. سيراجع فريق المبيعات والهندسة التفاصيل ويرد بخطوات التنفيذ التالية.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div>
          <h3 class="text-xs font-bold text-gray-400 tracking-widest uppercase mb-2">موقع الشركة</h3>
          <p class="text-lg font-bold text-gray-900">Quanzhou Wanlian Fluid Equipment Co., Ltd.</p>
          <p class="text-gray-500 mt-2 text-sm leading-relaxed">
            قوانتشو، مقاطعة فوجيان، الصين
          </p>
        </div>

        <div>
          <h3 class="text-xs font-bold text-gray-400 tracking-widest uppercase mb-3">قنوات مباشرة</h3>
          <ul class="space-y-3 text-sm text-gray-600">
            <li class="flex items-center">
              <span class="font-semibold text-gray-900 w-20">بريد المبيعات:</span>
              <a href="mailto:dhuog77@gmail.com" class="text-blue-600 hover:underline" dir="ltr">dhuog77@gmail.com</a>
            </li>
            <li class="flex items-center">
              <span class="font-semibold text-gray-900 w-20">الخط الساخن:</span>
              <a href="tel:+8618684324501" class="text-blue-600 hover:underline" dir="ltr">+86 186 8432 4501</a>
            </li>
            <li class="flex items-center">
              <span class="font-semibold text-gray-900 w-20">واتساب:</span>
              <a href="https://wa.me/8618684324501" target="_blank" rel="noopener noreferrer" class="text-green-600 font-bold hover:underline" dir="ltr">+86 186 8432 4501</a>
            </li>
          </ul>
        </div>

        <div class="bg-blue-50/50 p-8 rounded-xl border border-blue-100/50 space-y-4">
          <h3 class="font-bold text-blue-900 text-base">لماذا تتعاون مع Wanlian؟</h3>
          <ul class="space-y-3 text-sm text-blue-700 font-medium">
              <li class="flex items-center gap-2">
               <span class="text-blue-500 font-bold">✓</span> دعم اختيار المنتجات لأنظمة السوائل
              </li>
              <li class="flex items-center gap-2">
                <span class="text-blue-500 font-bold">✓</span> متطلبات OEM/ODM قابلة للنقاش
              </li>
              <li class="flex items-center gap-2">
                <span class="text-blue-500 font-bold">✓</span> دعم مواصفات وتوثيق المنتجات
              </li>
              <li class="flex items-center gap-2">
                <span class="text-blue-500 font-bold">✓</span> تنسيق تغليف التصدير والشحن
              </li>
           </ul>
        </div>
      </div>

      <!-- Form Area -->
      <div class="lg:col-span-2 bg-white p-10 rounded-2xl border border-gray-100 shadow-sm">
        <h2 class="text-xl font-bold text-gray-900 mb-6">قدّم نموذج RFQ / الاستفسار</h2>
        <InquiryForm productName={productName} />
      </div>
    </div>
  </main>
</Layout>
