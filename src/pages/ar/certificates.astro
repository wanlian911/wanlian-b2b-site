---
import Layout from '../../layouts/Layout.astro';

const certifications = [
  {
    name: 'مدرج UL',
    code: 'UL 262 / UL 1091',
    desc: 'معيار صمامات البوابة وصمامات الرجوع لخدمة الحماية من الحريق.',
    scope: 'صمامات البوابة وصمامات الرجوع لخدمة الحماية من الحريق المُقدمة للسوق الأمريكية الشمالية (UL 262 / UL 1091).',
    products: 'صمامات بوابة بمقعد مرن، صمامات رجوع',
    verify: 'نطاق الشهادة ينطبق على النماذج المحددة في شهادة UL. تواصل معنا للتأكد من تغطية النموذج وطلب نسخة.',
    icon: '🏆'
  },
  {
    name: 'موافق FM',
    code: 'Class 1120/1130',
    desc: 'معيار الموافقة لصمامات التحكم لخدمة الحريق (نوع OS&Y وNRS).',
    scope: 'صمامات التحكم لخدمة الحريق (نوع OS&Y وNRS) معتمدة وفق FM Class 1120/1130.',
    products: 'صمامات بوابة OS&Y، صمامات تحكم لخدمة الحريق',
    verify: 'تغطي الموافقة النماذج المدرجة في شهادة موافقة FM. تُقدَّم نسخات عند الطلب لتوثيق مشروعك.',
    icon: '🛡️'
  },
  {
    name: 'محكم CE',
    code: 'EN 12266-1',
    desc: 'الامتثال لمعايير الصحة والسلامة والحماية البيئية الأوروبية.',
    scope: 'معدات الضغط المُختبرة والموسومة وفق التوجيهات الأوروبية المطبقة ومعيار الاختبار EN 12266-1.',
    products: 'صمامات مُقدمة لمشاريع الاتحاد الأوروبي (وفق نطاق التوجيه المطبق)',
    verify: 'علامة CE تُطبَّق ضمن نطاق التوجيهات ذات الصلة. تأكد من التوجيه والفئة المطبقتين لمشروعك.',
    icon: '🇪🇺'
  },
  {
    name: 'ISO 9001:2015',
    code: 'إدارة الجودة',
    desc: 'المعيار الدولي لأنظمة إدارة الجودة في التصنيع.',
    scope: 'تصميم وإنتاج ومبيعات الصمامات ومعدات الإطفاء ومنتجات التحكم السوائل وفق نظام إدارة جودة ISO 9001:2015 محكم.',
    products: 'جميع خطوط الإنتاج',
    verify: 'شهادة نظام صادرة من جهة اعتماد معتمدة؛ سارية حسب مدة الشهادة. نسخة متاحة عند الطلب.',
    icon: '⚙️'
  },
  {
    name: 'محكم LPCB',
    code: 'الوقاية من الخسائر',
    desc: 'تسجيل RedBook لمنتجات وخدمات الحماية من الحريق.',
    scope: 'منتجات الحماية من الحريق المسجلة ضمن نظام LPCB RedBook لأسواق المملكة المتحدة/الكومنولث.',
    products: 'منتجات الحماية من الحريق المسجلة (وفق بند RedBook)',
    verify: 'تسجيل RedBook يغطي المنتجات والمعايير المحددة في بند التسجيل. تحقق من رقم البند لمنتجك المستهدف.',
    icon: '📜'
  },
  {
    name: 'معيار GB',
    code: 'GB 5135 / GB 4452',
    desc: 'الامتثال للمعايير الوطنية الصينية لمعدات الحماية من الحريق.',
    scope: 'تصنيع واختبار وفق المعايير الوطنية الصينية المطبقة (سلسلة GB 5135، GB 4452، GB 50974).',
    products: 'مكونات أنظمة الرش، خلاطات الحريق، صمامات الإنذار',
    verify: 'الامتثال حسب معيار GB المحدد المطبق لكل نموذج منتج. تقارير الاختبار متاحة عند الطلب.',
    icon: '🇨🇳'
  }
];
---

<Layout
  locale="ar"
  title="توثيق المنتج ودعم فني | Wanlian Fluid"
  description="اطلب توثيق المنتج ومتطلبات الاختيار وخيارات المواد ودعم التصدير لصمامات ومعدات الحماية من الحريق من Wanlian Fluid."
>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
         توثيق <span class="text-brand-red">المنتج.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
         شارك متطلبات مشروعك وسنوفر معلومات المنتج المتاحة والمواصفات التقنية والتوثيق للمراجعة.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p>
            <div class="space-y-3 text-sm text-gray-600">
              <p><span class="font-bold text-gray-900">النطاق: </span>{cert.scope}</p>
              <p><span class="font-bold text-gray-900">المنتجات المغطاة: </span>{cert.products}</p>
              <p class="text-xs text-gray-500 leading-relaxed border-t border-gray-200 pt-3">{cert.verify}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-6">
        <h2 class="text-3xl font-black">تحتاج نسخ شهادات أو أوراق بيانات تقنية؟</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          نوفر نسخ الشهادات وتقارير الاختبار الهيدروليكي وأوراق البيانات التقنية والمخططات CAD ودلائل التثبيت لنطاق منتجاتنا عند الطلب. يرجى تحديد الشهادة ونموذج المنتج وسوقك المستهدف حتى نستطيع تأكيد النطاق المطبق.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a href="/ar/contact/?product=Certificate%20%26%20Technical%20Documentation%20Request" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
            اطلب الشهادة والتوثيق
          </a>
          <a href="/ar/products/" class="inline-block px-10 py-5 bg-white/10 border border-gray-600 text-white font-black rounded-xl hover:bg-white/20 transition">
            تصفح المنتجات المعتمدة
          </a>
        </div>
        <p class="text-xs text-gray-500 pt-2">
          تنطبق الشهادة على المنتجات والنماذج والنطاق المحدد في كل شهادة. سيؤكد مهندسونا تغطية النموذج قبل طلبك.
        </p>
      </div>
    </div>
  </section>
</Layout>
