---
import Layout from '../../layouts/Layout.astro';

const certifications = [
  {
    name: 'ISO 9001:2015',
    code: 'باسمنا الخاص',
    desc: 'نظام إدارة الجودة المستخدم في التصنيع وضبط العمليات.',
    scope: 'نظام إدارة الجودة للتصميم والإنتاج والمبيعات ضمن نطاق Wanlian الخاص.',
    products: 'جميع خطوط الإنتاج',
    verify: 'نوفر وثائق نظام الجودة ذات الصلة عند الطلب للمراجعة.',
    icon: '⚙️'
  },
  {
    name: 'سجلات اختبار الدفعة',
    code: 'باسمنا الخاص',
    desc: 'أدلة الاختبار الخاصة بالدفعة المنتجة قبل الشحن.',
    scope: 'سجلات اختبار الضغط والتسرب للدفعة المحددة، صادرة ضمن إجراءات Wanlian الخاصة.',
    products: 'الدفعة المحددة في طلب الشراء',
    verify: 'تُراجع السجلات مقابل رقم الدفعة والمواصفات قبل التسليم.',
    icon: '🧾'
  },
  {
    name: 'EN 12266-1 / GB 5135',
    code: 'أساس التصميم والاختبار',
    desc: 'معايير مرجعية لتصميم المنتج واختباره وفق نطاق المشروع.',
    scope: 'يُستخدم EN 12266-1 وGB 5135 كأساس للتصميم والاختبار، وليس كاعتماد باسم Wanlian.',
    products: 'الصمامات ومكونات الحماية من الحريق ضمن النطاق المحدد',
    verify: 'يؤكد المهندسون المعيار المطبق وتقارير الاختبار للنموذج قبل الطلب.',
    icon: '🧪'
  },
  {
    name: 'UL 262 / UL 1091',
    code: 'باسم المصنع المنتج',
    desc: 'مراجع UL لصمامات البوابة وصمامات الرجوع لخدمة الحماية من الحريق.',
    scope: 'تعود أي قوائم UL إلى المصنع المنتج الحاصل عليها للنموذج المحدد، ولا تمثل اعتماداً باسم Wanlian.',
    products: 'صمامات البوابة وصمامات الرجوع لخدمة الحماية من الحريق',
    verify: 'تُراجع القائمة مع اسم المصنع ورقم النموذج في السجل الرسمي قبل الطلب.',
    icon: '🏆'
  },
  {
    name: 'FM Class 1120 / 1130',
    code: 'باسم المصنع المنتج',
    desc: 'مراجع FM لصمامات التحكم لخدمة الحريق ضمن نطاق المصنع المنتج.',
    scope: 'تعود موافقة FM إلى المصنع المنتج الحاصل عليها للنموذج المحدد، ولا تمثل اعتماداً باسم Wanlian.',
    products: 'صمامات التحكم لخدمة الحريق من نوع OS&Y وNRS',
    verify: 'تُراجع الموافقة مع اسم المصنع ورقم النموذج في السجل الرسمي قبل الطلب.',
    icon: '🛡️'
  },
  {
    name: 'LPCB RedBook',
    code: 'باسم المصنع المنتج',
    desc: 'مرجع تسجيل منتجات الحماية من الحريق لدى المصنع المنتج.',
    scope: 'يعود تسجيل LPCB RedBook إلى المصنع المنتج الحاصل عليه وللبند المحدد، وليس إلى Wanlian.',
    products: 'منتجات الحماية من الحريق ضمن بند التسجيل المحدد',
    verify: 'يُراجع رقم البند واسم المصنع في سجل RedBook قبل الطلب.',
    icon: '📜'
  }
];

const faq = [
  {
    question: 'هل تملك Wanlian Fluid شهادة ISO 9001؟',
    answer: 'نعم — نستخدم نظام إدارة جودة خاصاً بنا في التصميم والإنتاج والمبيعات، ونوفر وثائق النظام ذات الصلة عند الطلب. لا تمتلك Wanlian قوائم UL ولا تدّعيها باسمها الخاص.'
  },
  {
    question: 'هل صمامات الحريق لديكم مدرجة UL أو حاصلة على موافقة FM؟',
    answer: 'لا — هذه القوائم تعود إلى المصانع الحاصلة عليها، لا إلى Wanlian. نستخدم UL 262 / UL 1091 وFM Class 1120 / 1130 كمرجع للتحقق من نموذج المصنع ونطاقه. لا نقدّم موافقة FM كاعتماد باسم Wanlian.'
  },
  {
    question: 'ما المقصود بـ EN 12266-1 وGB 5135 في وثائقكم؟',
    answer: 'هما أساس للتصميم والاختبار وفق نطاق النموذج والمشروع، ولا يعني ذكرهما امتلاك اعتماد مستقل باسم Wanlian. يؤكد المهندسون المعيار المطبق وتقارير الاختبار قبل الطلب.'
  },
  {
    question: 'كيف أتحقق من أن القائمة أو التسجيل يخص المصنع الصحيح؟',
    answer: 'يمكن التحقق من اسم المصنع ورقم النموذج ورقم البند عبر السجل الرسمي للجهة المانحة. نطابق هذه البيانات مع طلبك قبل تقديم أي وثيقة أو عرض.'
  },
  {
    question: 'هل تقدّمون سجلات اختبار الدفعة مع الشحن؟',
    answer: 'نعم — نوفر سجلات اختبار الضغط والتسرب للدفعة المحددة وفق الطلب، مع مطابقة رقم الدفعة والمواصفات ووثائق الشحن ذات الصلة.'
  }
];
---

<Layout
  locale="ar"
  title="توثيق المنتج ودعم فني | Wanlian Fluid"
  description="اطلب توثيق المنتج ومتطلبات الاختيار وخيارات المواد ودعم التصدير لصمامات ومعدات الحماية من الحريق من Wanlian Fluid."
  faq={faq}
  breadcrumbs={[{ name: 'الشهادات' }]}
>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
         توثيق <span class="text-brand-red">المنتج.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
         شارك متطلبات مشروعك وسنوفر معلومات المنتج المتاحة والمواصفات التقنية والتوثيق للمراجعة.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p>
            <div class="space-y-3 text-sm text-gray-600">
              <p><span class="font-bold text-gray-900">النطاق: </span>{cert.scope}</p>
              <p><span class="font-bold text-gray-900">المنتجات المغطاة: </span>{cert.products}</p>
              <p class="text-xs text-gray-500 leading-relaxed border-t border-gray-200 pt-3">{cert.verify}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-6">
        <h2 class="text-3xl font-black">تحتاج نسخ شهادات أو أوراق بيانات تقنية؟</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          نوفر نسخ الشهادات وتقارير الاختبار الهيدروليكي وأوراق البيانات التقنية والمخططات CAD ودلائل التثبيت لنطاق منتجاتنا عند الطلب. يرجى تحديد الشهادة ونموذج المنتج وسوقك المستهدف حتى نستطيع تأكيد النطاق المطبق.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a href="/ar/contact/?product=Certificate%20%26%20Technical%20Documentation%20Request" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
            اطلب الشهادة والتوثيق
          </a>
          <a href="/ar/products/" class="inline-block px-10 py-5 bg-white/10 border border-gray-600 text-white font-black rounded-xl hover:bg-white/20 transition">
            تصفح المنتجات المعتمدة
          </a>
        </div>
        <p class="text-xs text-gray-500 pt-2">
          تنطبق الشهادة على المنتجات والنماذج والنطاق المحدد في كل شهادة. سيؤكد مهندسونا تغطية النموذج قبل طلبك.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 bg-gray-50 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">FAQ</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">الأسئلة الشائعة</h2>
      </div>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-white rounded-xl border border-gray-100 p-6 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
