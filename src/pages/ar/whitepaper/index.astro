---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
  { id: 'design-drivers', label: '1. ما الذي يقود المواصفة فعليًا' },
  { id: 'standards', label: '2. مشهد المعايير عبر المناطق' },
  { id: 'verification', label: '3. جسر الفجوة: من المواصفة إلى المنتج الموثق' },
  { id: 'lifecycle', label: '4. تكلفة دورة الحياة، لا سعر الشراء وحده' },
  { id: 'manufacturing', label: '5. أدلة التصنيع (E-E-A-T)' },
  { id: 'cases', label: '6. أدلة المشاريع وبرامج المرجع' },
  { id: 'faq', label: 'الأسئلة الشائعة' }
];

const faq = [
  {
    question: 'من كتب هذه الوثيقة المرجعية؟',
    answer: 'أعدّها فريق الهندسة والتطبيقات في Wanlian Fluid بقوانتشو، استنادًا إلى المعايير التي نصمم ونختبر وفقها (AWWA، ISO 5208، NFPA، EN) وإلى عملية التحقق التي ننفذها في إنتاجنا. إنها مرجع تقني لا نشرة تسويقية: الادعاءات حول عملية صناعتنا هي أدلة عملية (ISO 9001، تشغيل CNC داخلي، اختبار ضغط الجسم وتسرب الهواء بنسبة 100%)، لا اعتمادات طرف ثالث لا نملكها.'
  },
  {
    question: 'هل تمتلك Wanlian شهادات UL أو FM أو AWWA؟',
    answer: 'الاعتماد يمنح لكل منتج ولكل نموذج من الجهة المصدرة، لا للشركة ككل. Wanlian Fluid تنتج وفق نظام ISO 9001 وتختبر كل وحدة. مطابقة معيار محدد مثل AWWA C502 أو اعتماد UL أو اعتماد FM تُؤكد لكل نموذج بتقارير الاختبارات والشهادات قبل الطلب — ونوفر التوثيق المناسب للنموذج الدقيق الذي تحدده.'
  },
  {
    question: 'هل يمكنني الاطلاع على مراجع مشاريع حقيقية لعملاء؟',
    answer: 'نعم — تُقدم مراجع العملاء والمشاريع المسماة للعملاء المحتملين المؤهلين، وعادةً بموجب اتفاقية عدم إفصاح عندما يطلب العميل ذلك، ويمكننا تقديم سجلات اختبار لكل وحدة ومستندات تصدير وتقارير فحص من طرف ثالث تربط المشروع بمعداته المسلمة. لا ننشر هويات العملاء أو أرقام المشاريع في هذه الصفحة دون موافقة العميل.'
  },
  {
    question: 'ما الفرق بين خلاط الحريق ببندقية جافة وخلاط ببندقية رطبة؟',
    answer: 'خلاط البندقية الرطبة يبقي الماء في البندقية فوق مستوى الأرض ويُستخدم حيث لا تتجمد التربة. خلاط البندقية الجافة يبقي البندقية فارغة تحت خط التجمد وتمتلئ فقط عند فتح منفذ، لذلك يُطلب للمناخات الباردة أو المعتدلة. المرجع القياسي لخلاطات البندقية الجافة هو AWWA C502 (أمريكا) وEN 14384 (أوروبا).'
  }
];
---

<Layout
  title="وثيقة مرجعية: توريد صمامات وخلاطات الحريق (2026) | Wanlian Fluid"
  description="وثيقة تقنية حول تحديد مواصفات والتحقق من ومشتريات صمامات وخلاطات الحريق والبنية المائية: محركات التصميم ونظرة المعايير وتكلفة دورة الحياة وأدلة التصنيع."
  type="article"
  locale="ar"
  faq={faq}
  breadcrumbs={[{ name: 'الموارد' }, { name: 'وثيقة مرجعية' }]}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
    <nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
      <a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
      <span>/</span>
      <span class="text-gray-600">وثيقة مرجعية</span>
    </nav>

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
      <p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">وثيقة مرجعية · 2026</p>
      <h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">تحديد مواصفات والتحقق من وتوريد صمامات وخلاطات حماية الحريق والبنية المائية</h1>
      <p class="mt-5 text-gray-600 leading-relaxed text-lg">مرجع تقني للمهندسين وفِرق المشتريات والمقاولين الذين يحددون مواصفات صمامات البوابة والتحكم وخلاطات الحريق وخراطيم الحريق لمشاريع بلدية وصناعية. يتناول ما يقود المواصفة فعليًا، وكيف يختلف مشهد المعايير من منطقة لأخرى، وكيف تُجسر الفجوة بين المواصفة المكتوبة والمنتج الموثق، وكيف تُحسب تكلفة المشروع عبر دورة حياته — مع أدلة التصنيع وراء عملية Wanlian Fluid نفسها.</p>

      <div class="bg-blue-50 border border-blue-100 rounded-xl p-5 my-6">
        <p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-blue">المنهجية:</strong> بُنيت هذه الوثيقة من المعايير التي نصمم ونختبر وفقها — AWWA وISO 5208 وNFPA وEN — ومن التحقق لكل وحدة الذي ننفذه في إنتاجنا. تُعرض الادعاءات عن Wanlian Fluid كأدلة عملية (ISO 9001، تشغيل CNC داخلي، اختبار ضغط الجسم وتسرب الهواء بنسبة 100%)، ويُشار صراحةً إلى أين تكون الأرقام افتراضات مقابل حقائق موثقة.</p>
      </div>

      <TableOfContents headings={toc} />

      <h2 id="design-drivers" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. ما الذي يقود مواصفة حماية الحريق والبنية المائية فعليًا</h2>
      <p class="text-gray-700 leading-relaxed mb-4">معظم صفقات التوريد الفاشلة لا تفشل على السعر — بل تفشل لأن المواصفة لم تكن مكتملة بما يكفي لمحاسبة المورد. خمس متغيرات تقود مواصفة قابلة للدفاع بالنسبة للصمامات والخلاطات والخراطيم:</p>
      <ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
        <li><strong>المعيار الحاكم.</strong> AWWA C502/C515 (أمريكا ومعظم الأمريكيتين)، ISO 5208 وEN 1074 (أوروبا وكثير من أسواق التصدير)، NFPA 13/1961 (رؤوس الرش والخراطيم)، وأنظمة إقليمية مثل NOM في المكسيك وABNT في البرازيل. المعيار يحدد الأبعاد والمواد وفئة الضغط والاختبارات المطلوبة.</li>
        <li><strong>المقاس وفئة الضغط.</strong> القطر الاسمي (DN/NPS) وضغط التشغيل وضغط الاختبار. عدم مطابقة واجهة الفلنجة (PN مقابل ANSI) أو فئة الضغط للنظام خطأ في المواصفة، لا في التصنيع.</li>
        <li><strong>المادة والتشطيب.</strong> الحديد الزهر المطبوع (QT450/QT450-10) هو المعيار للتطبيقات المائية والحريق؛ الفولاذ المقاوم للصدأ للوسائط العدوانية ومكونات السحب. التشطيب (إبوكسي غير سام، تغليف مطاطي، EPDM) هو ما يحدد عمر مقاومة التآكل والإحكام بلا فقاعات.</li>
        <li><strong>الاعتماد المطلوب عند الاستلام.</strong> هل تشترط المناقلة اعتماد UL أو اعتماد FM أو AWWA أو NOM أو توثيق ISO 9001 — وهل هو لكل نموذج أم لكل مصنع. هنا يختلف المشترون والموردون أكثر ما يختلفون.</li>
        <li><strong>اللوجستيات وتقاسم المخاطر.</strong> شرط التصدير (EXW، FOB، CIF، DDP)، وحجز الحاويات، ومن يتحمل الشحن والتأمين ومخاطر الجمارك حتى الوجهة.</li>
      </ul>
      <p class="text-gray-700 leading-relaxed">للمفردات المشتركة التي تجعل هذه المصطلحات دقيقة، يعرّف <a href="/ar/glossary/" class="text-brand-blue font-semibold hover:underline">مسردنا الصناعي</a> كل مصطلح منها، و<a href="/ar/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">دليل المعايير</a> يوضح أنظمة AWWA/NFPA/EN/ISO جنبًا إلى جنب.</p>

      <h2 id="standards" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. مشهد المعايير عبر المناطق</h2>
      <p class="text-gray-700 leading-relaxed mb-4">قد يُطلب نفس الخلاط أو الصمام وفق أنظمة مختلفة حسب موقع المشروع. الجدول التالي هو التوجه الذي يحتاجه المشتري متعدد المناطق؛ وبند المناولة المحدد يبقى هو الغالب دائمًا.</p>
      <div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">المنطقة / النظام</th>
              <th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">المراجع الشائعة</th>
              <th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">ملاحظة للمشتري</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <tr><td class="px-4 py-3 font-bold text-gray-900">أمريكا ومعظم الأمريكيتين</td><td class="px-4 py-3 text-gray-700">AWWA C502/C515، NFPA 13/24/1961، UL / FM عند الطلب</td><td class="px-4 py-3 text-gray-700">UL/FM لكل نموذج؛ تأكد من النموذج المعتمد الدقيق</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">أمريكا اللاتينية</td><td class="px-4 py-3 text-gray-700">AWWA (مواصفة أمريكية)، NOM / NR المكسيكي، ABNT البرازيلي، EN لإعادة التصدير</td><td class="px-4 py-3 text-gray-700">بند المناولة هو الغالب؛ تحقق من المطابقة لكل نموذج</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">أوروبا</td><td class="px-4 py-3 text-gray-700">EN 1074، EN 14384، EN 12845، CE، ISO 5208</td><td class="px-4 py-3 text-gray-700">علامة CE لكل نموذج؛ EN 12845 لسحب المضخات</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">الشرق الأوسط وأفريقيا</td><td class="px-4 py-3 text-gray-700">غالبًا AWWA أو BS 750؛ تتغير مواصفة المشروع</td><td class="px-4 py-3 text-gray-700">أكد المعيار المرجعي في قائمة الكميات (BOQ)</td></tr>
          </tbody>
        </table>
      </div>
      <p class="text-gray-700 leading-relaxed">القاعدة العملية: <strong>المعيار خاصية للمنتج والوجهة، لا للعلامة التجارية.</strong> يجب أن يستطيع الصانع أن يخبرك، لكل نموذج، بماذا يختبر ويعيد السجلات. <a href="/ar/guides/latinamerica-certification-requirements-fire-valves/" class="text-brand-blue font-semibold hover:underline">دليل متطلبات اعتماد صمامات الحريق في مشاريع أمريكا اللاتينية</a> يفكك الحالة اللاتينية الأمريكية بالتفصيل.</p>

      <h2 id="verification" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. جسر الفجوة: من المواصفة المكتوبة إلى المنتج الموثق</h2>
      <p class="text-gray-700 leading-relaxed mb-4">المواصفة لا تساوي إلا ما تحققه ضدها. الترتيب الذي يلتقط أكبر قدر من العيوب قبل تحرك الأموال هو:</p>
      <ol class="list-decimal ps-6 text-gray-700 leading-relaxed space-y-3 mb-4">
        <li><strong>التحقق على مستوى الشركة.</strong> الكيان القانوني، نطاق ISO 9001، سجل التصدير، وفيديو للمصنع أو زيارة إليه. هذا يستبعد مكاتب التجارة التي تعيد بيع قوالب مستعملة.</li>
        <li><strong>التحقق من الشهادات.</strong> أي رقم UL أو FM أو AWWA أو NOM يُفحص في البوابة الرسمية للجهة المصدرة مقابل النموذج والمصنع الدقيق. الرقم الذي لا يتحقق هو تزوير مهما بدا PDF نظيفًا.</li>
        <li><strong>طلب عينة.</strong> وحدة واحدة لكل نموذج، مع اللوحة المعدنية والرقم التسلسلي وشهادة المادة (MTC) وفيديو اختبار ضغط بالرقم التسلسلي، تُفحص مقابل المواصفة قبل الطلبات الكبيرة.</li>
        <li><strong>فحص من طرف ثالث.</strong> وكالة مستقلة (SGS، Bureau Veritas، Intertek) تشهد الاختبارات وتراجع السجلات في المصنع قبل شحن الدفعة الإنتاجية.</li>
      </ol>
      <p class="text-gray-700 leading-relaxed">هذا هو الترتيب نفسه الذي يمكن إرفاقه بأمر الشراء — <a href="/ar/guides/detect-fake-valves-fire-equipment-counterfeits/" class="text-brand-blue font-semibold hover:underline">دليل كشف التزوير</a> حوله إلى قائمة تحقق، و<a href="/ar/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">قائمة التحقق للتوريد B2B</a> تذكر التوثيق الدقيق المطلوب.</p>

      <h2 id="lifecycle" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. تكلفة دورة الحياة، لا سعر الشراء وحده</h2>
      <p class="text-gray-700 leading-relaxed mb-4">سعر الشراء هو الحد الأدنى في ميزانية حماية الحريق أو البنية المائية. عبر عمر يصل إلى 20–30 عامًا، التكلفة التي تتحرك فعليًا هي مجموع:</p>
      <ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
        <li><strong>تكلفة الموثوقية / العطل.</strong> صمام أو خلاط يفشل تحت الضغط، ليلًا، أثناء طارئ، تكلفته تتجاوز سعر الوحدة بكثير. اختبار كل وحدة هو ما يسعّر هذا الخطر.</li>
        <li><strong>الصيانة وقطع الغيار.</strong> صمامات المقاعد المرنة يمكن إعادة إحكام مقاعدها؛ ختم العمود والغطاء قابلان للصيانة. تحديد مواصفات قابلة للصيانة يخفض صيانة العمر.</li>
        <li><strong>عمر مقاومة التآكل.</strong> الإبوكسي غير السام والتغليف المطاطي يطيلان عمر الجسم والمقعد ضد التآكل، مؤخرين الاستبدال.</li>
        <li><strong>مخاطر التنسيق واللوجستيات.</strong> توحيد الصمامات والخلاطات والخراطيم تحت صانع واحد وأمر شراء واحد يزيل هوامش الموردين المتعددين والشحن المنفصل وخطر تأخر خط واحد عن البرنامج.</li>
      </ul>
      <p class="text-gray-700 leading-relaxed"><a href="/ar/cost-calculator/" class="text-brand-blue font-semibold hover:underline">حاسبة تكلفة التوريد</a> تنمذج جانب التخطيط — الكمية وشرط التصدير والوجهة — لتقدر مبادلة دورة الحياة قبل إخطار الميزانية.</p>

      <h2 id="manufacturing" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. أدلة التصنيع (E-E-A-T)</h2>
      <p class="text-gray-700 leading-relaxed mb-4">الخبرة والخبرة الفنية والثقة في مورد B2B تأتي مما يستطيع إثباته، لا مما يدعيه. هذه أدلة العملية التي تستند إليها Wanlian Fluid، معروضة كما نفعلها — لتتحقق منها كما تتحقق من أي مورد:</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-5">
        <div class="bg-gray-50 border border-gray-100 rounded-xl p-5"><p class="font-black text-gray-900 text-sm mb-1">نظام جودة ISO 9001</p><p class="text-sm text-gray-600">يعمل الإنتاج وفق نظام إدارة جودة ISO 9001؛ رقم الشهادة متاح للتحقق لدى الجهة المصدرة.</p></div>
        <div class="bg-gray-50 border border-gray-100 rounded-xl p-5"><p class="font-black text-gray-900 text-sm mb-1">أجسام مصنعة بتقنية CNC داخليًا</p><p class="text-sm text-gray-600">أجسام الصمامات تُشغّل بتقنية CNC في مصنعنا بقوانتشو؛ بعض البنود تنتجه شركاء تصنيع مؤهلون، موثقون في الطلب.</p></div>
        <div class="bg-gray-50 border border-gray-100 rounded-xl p-5"><p class="font-black text-gray-900 text-sm mb-1">اختبار ضغط الجسم وتسرب الهواء 100%</p><p class="text-sm text-gray-600">كل صمام وخلاط وخرطوم يخضع لاختبار ضغط الجسم واختبار تسرب الهواء قبل الشحن، مع سجلات لكل وحدة. فيديو اختبار بالرقم التسلسلي متاح للوحدة العينة.</p></div>
        <div class="bg-gray-50 border border-gray-100 rounded-xl p-5"><p class="font-black text-gray-900 text-sm mb-1">OEM/ODM وتوثيق التصدير</p><p class="text-sm text-gray-600">علامات مخصصة وتعبئة تصدير وحزمة مستندات تصدير كاملة، مع التزام برد عرض السعر خلال 12 ساعة.</p></div>
      </div>
      <p class="text-gray-700 leading-relaxed">نطاقنا المنشور يمتد على ست خطوط منتجات وأكثر من 43 نموذجًا بالمتجر — صمامات بوابة بمقعد مرن ومعدني، صمامات فراشة ورجوع، خلاطات حريق ومكوناتها، صمامات رؤوس الرش والإنذار، وخراطيم حريق مبطنة بالمطاط. راجع <a href="/ar/products/" class="text-brand-blue font-semibold hover:underline">الفهرس الكامل</a> و<a href="/ar/about/" class="text-brand-blue font-semibold hover:underline">المصنع وخطوط الإنتاج</a>.</p>

      <h2 id="cases" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. أدلة المشاريع وبرامج المرجع</h2>
      <p class="text-gray-700 leading-relaxed mb-4">ننشر أدلة المشاريع كـ<strong>قدرة</strong> — فئة المعدات والتحقق المنجز والتوثيق الذي يسافر معها — لأن هويات العملاء وأرقام المشاريع تُشارك مع العملاء المحتملين المؤهلين بموجب اتفاقية عدم إفصاح عندما يطلب العميل ذلك. النمط التالي يمثل البرامج التي ندعمها:</p>
      <div class="space-y-4 my-5">
        <div class="border border-gray-200 rounded-xl p-5">
          <p class="text-xs font-black uppercase tracking-widest text-brand-blue mb-2">مرجع قدرة — برنامج بلدي للخلاطات والعزل</p>
