---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'ما الفرق بين مانع الارتداد وصمام الرجوع؟',
		answer: 'صمام الرجوع القياسي يمنع التدفق العكسي ميكانيكيًا لكنه غير مُختبَر للتسرب ولا يملك غرفة تصريف وسيطة. مانع الارتداد مثل HS41X يجمع بين صمامي رجوع مستقلين مع غرفة تصريف وسيطة آلية، وقابل للاختبار في مكانه، ويلبي متطلبات التحكم في الاتصالات المتقاطعة لحماية مياه الشرب. لا تُقبل صمامات الرجوع وحدها في الاتصالات المتقاطعة لمياه الشرب.'
	},
	{
		question: 'أين يجب تركيب مانع الارتداد في اتصال خدمة الحريق؟',
		answer: 'في اتصال خدمة الحريق على شبكة مياه الشرب، قبل سحب مضخة الحريق أو مخرج النظام. يجب أن يكون قابلًا للوصول للاختبار ومحميًا من التجمد، وأن يُدرج فقد رأسه في الحساب الهيدروليكي لمضخة الحريق. للأنظمة شائعة الارتفاع، تأكد من أن تصنيف الجهاز يطابق أقصى ضغط ثابت للإمداد.'
	},
	{
		question: 'هل تحتاج صمامات التحكم الهيدروليكي إلى كهرباء للعمل؟',
		answer: 'معظم صمامات التحكم الهيدروليكي — صمام خفض الضغط 500X وصمام التحكم بالمستوى F745X ومانع الارتداد HS41X — ذاتية التشغيل بالكامل بضغط الأنبوب ولا تحتاج طاقة خارجية. النماذج بالكهرباء المغناطيسية مثل GKZF-1 تستخدم AC220V أو DC24V للأتمتة عن بعد.'
	},
	{
		question: 'ما المواد المستخدمة لتطبيقات مياه الشرب؟',
		answer: 'لشبكات مياه الشرب، يستخدم مانع الارتداد HS41X جسمًا من حديد الزهر المطبوع مع أحكام EPDM وداخليات من الفولاذ المقاوم للصدأ 304، متوافق مع متطلبات الصحة GB/T17219. تأكد من شهادة الصحة لسوقك — يوفّر مهندسونا حزمة التوثيق مع الطلب.'
	},
	{
		question: 'هل يمكنكم توفير حزمة صمامات هيدروليكية كاملة لغرفة المضخات؟',
		answer: 'نعم. نصنع مانعات الارتداد وصمامات خفض الضغط وصمامات التحكم بالمستوى وصمامات التحكم الكهرومغناطيسي ومانعات الدوامة وفلترة Y، ونشحنها كحزمة منسقة — فئات ضغط وملحقات وتقارير اختبار متطابقة من مصنع واحد.'
	}
];

const hydraulicProducts = [
	{
		slug: 'anti-pollution-backflow-preventer-hs41x',
		name: 'مانع ارتداد مضاد للتلوث (HS41X-16)',
		img: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		desc: 'تجميع رجوع مزدوج مع تصريف وسيط، DN50–DN600'
	},
	{
		slug: 'adjustable-pressure-reducing-valve-500x',
		name: 'صمام خفض ضغط هيدروليكي (500X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'تحكم ذاتي بالطيار، ضبط 0.1–1.6 MPa'
	},
	{
		slug: 'hydraulic-water-level-control-valve-f745x',
		name: 'صمام تحكم مستوى ماء هيدروليكي (F745X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'تحكم مستوى بطيار طافية للخزانات والأحواض'
	},
	{
		slug: 'groove-solenoid-control-gate-valve-gkzf1',
		name: 'صمام بوابة تحكم كهرومغناطيسي (GKZF-1)',
		img: '/assets/products/groove-solenoid-control-gate-valve-gkzf1.jpg',
		desc: 'صمام بمسار بطيار DC24V/AC220V، تصنيف 300 PSI'
	},
	{
		slug: 'suction-vortex-preventer-en12845',
		name: 'مانع دوامة سحب (EN12845)',
		img: '/assets/02_valves_parts/valves_p21.webp',
		desc: 'SS304/316، يقضي على تكهف المضخات، عمق تصريف 100مم'
	}
];

const trustBadges = ['رجوع مزدوج + تصريف', 'PN10–PN25', 'صحي GB/T17219', 'طيّارات ذاتية التشغيل'];
---

<Layout
	locale="ar"
	title="مانعات الارتداد وصمامات التحكم الهيدروليكي - WLFE"
	description="مانعات الارتداد (HS41X)، خفض الضغط (500X)، التحكم بالمستوى (F745X) والصمامات الكهرومغناطيسية لشبكات مياه الشرب والحريق. DN50-DN600 مباشر من المصنع."
	type="product"
	productData={{
		name: 'منع الارتداد والتحكم الهيدروليكي',
		image: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		description: 'مانعات الارتداد وصمامات التحكم الهيدروليكي لحماية مياه الشرب وإدارة الضغط والشبكات المائية المؤتمتة، من تصنيع شركة قوانتشو وانليان للمعدات السائلة المحدودة.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'منع الارتداد' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ar/" class="hover:text-blue-600">الرئيسية</a>
			<span>/</span>
			<a href="/ar/products/" class="hover:text-blue-600">المنتجات</a>
			<span>/</span>
			<span class="text-gray-600">منع الارتداد</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">حماية مياه الشرب والتحكم الهيدروليكي</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">مانعات الارتداد وصمامات التحكم الهيدروليكي</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">تصنع Wanlian Fluid كامل نطاق السلامة الهيدروليكية — مانعات الارتداد المضادة للتلوث HS41X، وصمامات خفض الضغط 500X، وصمامات التحكم بالمستوى F745X، وصمامات التحكم الكهرومغناطيسي GKZF-1 — حماية لشبكات مياه الشرب وأتمتة التحكم بالضغط والمستوى في حزمة واحدة منسقة.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">نطاق صمامات السلامة الهيدروليكية</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydraulicProducts.map(p => (
					<a href={`/ar/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">المواصفات الرئيسية</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">الصمام</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">الوظيفة</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">نطاق الأحجام</th>
							<th class="px-4 py-3 text-start font-bold text-gray-500 uppercase tracking-wider">التصنيف</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">HS41X</td>
							<td class="px-4 py-3 text-gray-700">منع الارتداد المضاد للتلوث</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">500X</td>
							<td class="px-4 py-3 text-gray-700">خفض/تثبيت الضغط</td>
							<td class="px-4 py-3 text-gray-700">DN20 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">F745X</td>
							<td class="px-4 py-3 text-gray-700">التحكم بمستوى الماء</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN400</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">GKZF-1</td>
							<td class="px-4 py-3 text-gray-700">تحكم فتح/إغلاق كهرومغناطيسي</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN300</td>
							<td class="px-4 py-3 text-gray-700">300 PSI, AC220V/DC24V</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">مانع الدوامة</td>
							<td class="px-4 py-3 text-gray-700">حماية سحب المضخة</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN1000</td>
							<td class="px-4 py-3 text-gray-700">EN12845 / GB50974</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">التطبيقات</h2>
			<ul class="list-disc ps-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>التحكم في الاتصالات المتقاطعة لمياه الشرب (شبكات الحريق، الري، الغلايات)</li>
				<li>التحكم بمستوى أحواض المياه والخزانات السقفية</li>
				<li>إدارة مناطق الضغط في الشبكات البلدية والمباني</li>
				<li>شبكات المياه المؤتمتة مع تحكم صمامات عن بعد</li>
				<li>حماية سحب المضخات في الخزانات والأحواض</li>
			</ul>

			<!-- FAQ Section -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">الأسئلة الشائعة</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">تحتاج حزمة صمامات هيدروليكية لشبكتك؟</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">أرسل لنا DN وفئة الضغط ونوع الاتصال — سيرد مهندسونا بمنحنيات فقد الرأس وأوراق البيانات وعرض سعر الحزمة خلال 12 ساعة.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ar/contact/?product=Backflow%20Prevention%20%26%20Hydraulic%20Control" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">اطلب عرض سعر</a>
						<a href="https://wa.me/8618684324501?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D8%AD%D8%AA%D8%A7%D8%AC%20%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9%20%D9%81%D9%8A%20%D8%A7%D8%AE%D8%AA%D9%8A%D8%A7%D8%B1%20%D8%B5%D9%85%D8%A7%D9%85%D8%A7%D8%AA%20%D8%A7%D9%84%D8%AA%D8%AD%D9%83%D9%85%20%D8%A7%D9%84%D9%87%D9%8A%D8%AF%D8%B1%D9%88%D9%84%D9%8A%D9%83%D9%8A" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">دردشة عبر واتساب</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
