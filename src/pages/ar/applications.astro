---
import Layout from '../../layouts/Layout.astro';

const faq = [
  {
    question: 'ما الصناعات التي تخدمها منتجات Wanlian Fluid؟',
    answer: 'شبكات المياه البلدية وشبكات الحريق، وخطوط الأنابيب الصناعية، وHVAC، ومنشآت البتروكيماويات والتحويلية، والمستودعات والمباني عالية السقف، والتطبيقات البحرية — في أي مكان تحتاج فيه الصمامات وخلاطات الحريق ومران الحريق إلى أداء موثوق تحت الضغط.'
  },
  {
    question: 'هل يمكنكم توريد الصمامات وخلاطات الحريق ومران الحريق كحزمة واحدة لمشروع؟',
    answer: 'نعم. يمكن لأمر شراء واحد أن يجمع صمامات بوابة بمقعد مرن وخلاطات حريق ومران حريق مبطّن بالمطاط، مع علامة OEM/ODM وتوثيق تصدير تنسّقه جهة تصنيع واحدة مسؤولة.'
  },
  {
    question: 'ما المعايير التي تعمل وفقها منتجاتكم؟',
    answer: 'تُهندَس منتجاتنا وفق معايير AWWA وISO 5208 وNFPA وEN والمعايير الإقليمية. يتم تأكيد الامتثال الدقيق للمعيار (مثل AWWA C502/C515 أو NFPA 1961 أو NOM) لكل نموذج عبر تقارير اختبار وشهادات قبل الطلب.'
  },
  {
    question: 'كيف أختار الصمام المناسب لتطبيقي؟',
    answer: 'ابدأ من الوسيط والحجم وفئة الضغط والمعيار، ثم من الخدمة (العزل مقابل التحكم مقابل الرجوع مقابل منع الارتداد). تشرح أدلجتنا وقائمة تحقق التوريد خطوات الاختيار — أو أرسل مواصفاتك وسنوصي بالنماذج خلال 12 ساعة.'
  }
];

const applications = [
  {
    title: 'حماية الحريق والسلامة الحياتية',
    icon: '🚒',
    description: 'بنية تحتية متكاملة للحماية من الحريق للمباني التجارية والمنشآت الصناعية والشبكات البلدية: خلاطات معتمدة، صمامات إنذار، رؤوس رش، مدافع إطفاء وأنظمة مران الحريق.',
    points: ['شبكات خلاطات حريق داخلية وخارجية', 'أنظمة رش و رش شامل تلقائية', 'مدافع مياه حريق للمساحات عالية السقف', 'بكرات مران الحريق والخزائن'],
    links: [
      { label: 'خلاطات الحريق', href: '/ar/products/#category=%D8%AE%D9%84%D8%A7%D8%B7%20%D8%A7%D9%84%D8%AD%D8%B1%D9%8A%D9%82%20%D9%88%D8%A7%D8%AA%D8%B5%D8%A7%D9%84%D8%A7%D8%AA%20%D8%A7%D9%84%D9%85%D8%B6%D8%AE%D8%A7%D8%AA' },
      { label: 'رؤوس رش وصمامات الإنذار', href: '/ar/products/#category=%D8%B1%D8%A4%D9%88%D8%B3%20%D8%B1%D8%B4%20%D8%A7%D9%84%D8%AD%D8%B1%D9%8A%D9%82%20%D9%88%D8%B5%D9%85%D8%A7%D9%85%D8%A7%D8%AA%20%D8%A7%D9%84%D8%A5%D9%86%D8%B0%D8%A7%D8%B1' },
      { label: 'مدافع المياه', href: '/ar/products/#category=%D9%85%D8%AF%D8%A7%D9%81%D8%B9%20%D9%85%D9%8A%D8%A7%D9%87%20%D8%A7%D9%84%D8%A5%D8%B7%D9%81%D8%A7%D8%A1' }
    ]
  },
  {
    title: 'إمداد المياه والصرف البلدي',
    icon: '🏙️',
    description: 'حلول تدفق وإغلاق متينة لشبكات مياه المدن وشبكات الصرف ومحطات الضخ، مصممة لتحمل عقودًا من التشغيل المستمر.',
    points: ['صمامات بوابة وفراشة لشبكات التوزيع', 'صمامات كروية منزلقية ورجوع للصرف', 'خلاطات ذكية IoT للشبكات الرقمية', 'منع الارتداد لمياه الشرب'],
    links: [
      { label: 'صمامات البوابة', href: '/ar/products/resilient-seat-flanged-gate-valve-z41x/' },
      { label: 'صمامات الرجوع', href: '/ar/products/spherical-ball-check-valve-hq44x/' },
      { label: 'مانعات الارتداد', href: '/ar/products/anti-pollution-backflow-preventer-hs41x/' }
    ]
  },
  {
    title: 'خطوط الأنابيب الصناعية',
    icon: '🏭',
    description: 'صمامات وفلاترة عالية الضغط للصناعات التحويلية بما في ذلك البتروكيماويات وتوليد الطاقة ومعالجة المعادن والأغذية.',
    points: ['صمامات حجاب محكم للوسائط عالية الحرارة', 'فلترة Y لحماية المعدات الحرجة', 'صمامات خفض ضغط لتشغيل مستقر', 'عدادات تدفق كهرومغناطيسية للقياس'],
    links: [
      { label: 'صمامات الحجاب المحكم', href: '/ar/products/flange-manual-bellows-gate-valve/' },
      { label: 'فلترة Y', href: '/ar/products/telescopic-y-strainer-sgl41h/' },
      { label: 'عدادات التدفق', href: '/ar/products/smart-electromagnetic-flow-meter/' }
    ]
  },
  {
    title: 'HVAC وخدمات المباني',
    icon: '🏢',
    description: 'صمامات مدمجة منخفضة الصيانة لأنظمة التدفئة والتهوية والتكييف في المباني التجارية والسكنية.',
    points: ['صمامات فراشة وافر لتركيب موفّر للمساحة', 'صمامات بوابة بمقعد مرن للخدمة العامة', 'صمامات تحكم مستوى لمياه الخزانات السقفية', 'صمامات بوابة متسلسقة لتعويض التمدد'],
    links: [
      { label: 'صمامات الفراشة', href: '/ar/products/wafer-type-butterfly-valve-d71x/' },
      { label: 'صمامات التحكم بالمستوى', href: '/ar/products/hydraulic-water-level-control-valve-f745x/' }
    ]
  },
  {
    title: 'النفط والغاز والبتروكيماويات',
    icon: '🛢️',
    description: 'حماية حريق وتحكم تدفق شديد التحمّل لمصافي التكرير ومزارع الخزانات والمنشآت الكيميائية، مع خيارات مقاومة للانفجار حيث يلزم.',
    points: ['مدافع مياه حريق يدوية وذاتية التتبع', 'خزائن حريق بالرغوة لحرائق الفئة B', 'خيارات معدات مقاومة للانفجار', 'مواد مقاومة للتآكل للوسائط العدوانية'],
    links: [
      { label: 'مدافع مياه الحريق', href: '/ar/products/manual-fire-water-cannon-ps/' },
      { label: 'خزائن الرغوة', href: '/ar/products/foam-fire-hydrant-cabinet-psg30/' },
      { label: 'مدافع ذاتية التتبع', href: '/ar/products/auto-tracking-jet-suppression-cannon-zdms/' }
    ]
  },
  {
    title: 'اللوجستيات والمستودعات ومراكز البيانات',
    icon: '📦',
    description: 'أنظمة سلامة حياتية للمساحات المغلقة الكبيرة حيث يجب أن يكون الإطفاء سريعًا وموثوقًا واعيًا بأضرار الماء.',
    points: ['أنظمة الفعل المسبق لحماية الأصول الحساسة', 'مدافع ذاتية التتبع للسقف العالي', 'أنظمة الإنذار الرطبة للمستودعات القياسية', 'مؤشرات تدفق لمراقبة المناطق'],
    links: [
      { label: 'أنظمة الفعل المسبق', href: '/ar/products/pre-action-alarm-system-zsfy/' },
      { label: 'صمامات الإنذار', href: '/ar/products/wet-alarm-check-valve-zsfz-150/' },
      { label: 'مؤشرات التدفق', href: '/ar/products/water-flow-indicator-zsjz/' }
    ]
  },
  {
    title: 'البحري والعابر البحري',
    icon: '🚢',
    description: 'تحكم سوائل ومعدات إطفاء مقاومة للتآكل للسفن والموانئ والمنصات البحرية التي تعمل في بيئات بحرية قاسية.',
    points: ['مكونات ألومنيوم وبرونز بجودة بحرية', 'مانعات دوامة لسلامة سحب المضخات', 'أنظمة خلاط ومران حريق للسطح', 'طلاءات غير سامة لأنظمة المياه'],
    links: [
      { label: 'مانعات الدوامة', href: '/ar/products/suction-vortex-preventer-en12845/' },
      { label: 'وصلات المران', href: '/ar/products/fire-hydrant-hose-coupling-adapter-hs/' }
    ]
  }
];
---

<Layout
  locale="ar"
  title="التطبيقات والصناعات | Wanlian Fluid Equipment"
  description="كيف تخدم صمامات Wanlian ومعدات الحماية من الحريق تطبيقات مياه البلديات وخطوط الأنابيب الصناعية وHVAC والبتروكيماويات والمستودعات والبحري."
  faq={faq}
  breadcrumbs={[{ name: 'التطبيقات' }]}
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-600 uppercase">التطبيقات</span>
      <h1 class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight">مُهندسة لـ<span class="text-brand-red">بيئات قاسية</span></h1>
      <p class="mt-4 text-lg text-gray-500 max-w-3xl mx-auto leading-relaxed">
        تُنتشر منتجات التحكم السوائل والحماية من الحريق من Wanlian عبر صناعات لا تقبل المساومة في الموثوقية والسلامة.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {applications.map(app => (
        <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition-all">
          <div class="flex items-center gap-4 mb-4">
            <span class="text-4xl">{app.icon}</span>
            <h2 class="text-xl font-black text-gray-900">{app.title}</h2>
          </div>
          <p class="text-gray-600 leading-relaxed mb-5">{app.description}</p>
          <ul class="space-y-2 mb-6">
            {app.points.map(point => (
              <li class="flex items-start text-sm text-gray-700">
                <svg class="h-5 w-5 text-brand-blue me-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {point}
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-3 border-t border-gray-100 pt-4">
            {app.links.map(link => (
              <a href={link.href} class="text-sm font-bold text-brand-red hover:underline">
                {link.label} <span aria-hidden="true" class="rtl:inline-block rtl:rotate-180">→</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4">
      <h2 class="text-2xl font-black">غير متأكد أي منتج يناسب مشروعك؟</h2>
      <p class="text-gray-400 max-w-xl mx-auto">
        أرسل تفاصيل تطبيقك وسيرد مهندسونا بالتوصية بالحل المناسب خلال 12 ساعة.
      </p>
      <a href="/ar/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-xl hover:opacity-90 transition">
        احصل على نصيحة هندسية
      </a>
    </div>
  </main>
</Layout>
