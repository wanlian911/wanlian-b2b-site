---
import Layout from '../layouts/Layout.astro';

const faq = [
	{
		question: 'What is an ESFR sprinkler?',
		answer: 'ESFR means Early Suppression Fast Response. The ESFR head in this range uses a high-flow design, a 74°C fast-response glass bulb and pendent or upright orientations for high-pile storage, warehouses and industrial facilities.'
	},
	{
		question: 'Can ESFR sprinklers replace in-rack sprinklers?',
		answer: 'They can in storage arrangements that satisfy the applicable design criteria. The final decision depends on commodity, storage height, ceiling height, rack layout, K-factor and design pressure, so the fire protection designer and AHJ must approve the arrangement.'
	},
	{
		question: 'How does K-factor affect ESFR selection?',
		answer: 'K-factor and operating pressure determine the water delivered by each head. Use the hydraulic calculation and storage criteria to select the ESFR model; do not choose a head from nominal pipe size alone.'
	},
	{
		question: 'What temperature rating does the ESFR head use?',
		answer: 'The ESFR product is specified with a 74°C (165°F) fast-response glass bulb. Confirm ambient conditions and the required listing or approval for the destination project before ordering.'
	},
	{
		question: 'What should be included in an ESFR sprinkler package?',
		answer: 'A typical order starts with the head schedule and adds the selected sprinkler heads, wet alarm check valve, water-flow indicators, monitored isolation valves and any standard system accessories required by the approved design.'
	},
	{
		question: 'Can you quote the complete warehouse sprinkler BOM?',
		answer: 'Yes. Send the approved head schedule, storage and ceiling information, hydraulic design data and valve schedule. We can quote the verified heads and system components as one project package.'
	}
];

const products = [
	{
		slug: 'esfr-sprinkler-head',
		name: 'ESFR Early Suppression Fast Response Sprinkler',
		img: '/assets/products/esfr-sprinkler-head.webp',
		desc: 'ESFR-202 / ESFR-242 / ESFR-363, 74°C, pendent & upright'
	},
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'Glass Bulb Fire Sprinkler (ZST Series)',
		img: '/assets/products/glass-bulb-fire-sprinkler-zst.webp',
		desc: 'DN15 / DN20, K=80 ±4 / K=115 ±9, pendent / upright / sidewall'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Wet Alarm Check Valve ZSFZ 150',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'DN100 / DN150 / DN200, 1.6 MPa, alarm gong and retard chamber'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Vane Type Water Flow Indicator (ZSJZ Series)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'DN50–DN200, 1.2 / 1.6 MPa, adjustable 2–60 s delay'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Signal Butterfly Valve (DN80 PN16)',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80-overlay.png',
		desc: 'DN50–DN300, PN16, monitored open/closed position'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'UL/FM Fire Protection Resilient Seated OS&Y Gate Valve',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: '2"–10", grooved ends, rising stem, UL / FM listed'
	}
];
---

<Layout
	title="ESFR Sprinkler Heads & Warehouse Sprinkler Systems | WLFE"
	description="ESFR sprinkler heads for warehouse sprinkler systems: compare K-factor, pressure planning, in-rack alternatives and complete valve packages from Wanlian."
	type="product"
	productData={{
		name: 'ESFR Sprinkler Systems',
		image: '/assets/products/esfr-sprinkler-head.webp',
		description: 'ESFR sprinkler heads and verified fire protection system components for high-pile storage, warehouses and industrial facilities.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'ESFR Sprinklers' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/" class="hover:text-blue-600">Home</a>
			<span>/</span>
			<a href="/products/" class="hover:text-blue-600">Products</a>
			<span>/</span>
			<span class="text-gray-600">ESFR Sprinklers</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Warehouse Sprinkler Systems — Factory Direct</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">ESFR Sprinkler Heads for High-Pile Warehouse Protection</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">ESFR sprinkler heads are selected when a warehouse design needs fast, high-volume ceiling discharge for storage protection. Wanlian supplies the ESFR head and the monitored valves, alarm and flow components around it, so the approved design can be quoted as one coordinated package.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['74°C Fast Response', 'Pendent / Upright', 'K-Factor Planning', 'Warehouse BOM Support'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">ESFR Sprinkler and System Components</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{products.map(p => (
					<a href={`/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">ESFR Selection and Specification</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Selection point</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Verified product information</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">ESFR head</td><td class="px-4 py-3 text-gray-700">ESFR-202 / ESFR-242 / ESFR-363 and ZSTX-161; 74°C; pendent PY or upright UY; R1/2" or R3/4" NPT.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Hydraulic planning</td><td class="px-4 py-3 text-gray-700">Use the approved storage design to establish K-factor, operating pressure, water demand and head spacing before release.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Standard sprinkler option</td><td class="px-4 py-3 text-gray-700">ZST glass bulb heads: DN15 / DN20, K=80 ±4 or K=115 ±9, with pendent, upright and sidewall types.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Alarm and flow</td><td class="px-4 py-3 text-gray-700">ZSFZ wet alarm valve: DN100 / DN150 / DN200 at 1.6 MPa; ZSJZ flow indicator: DN50–DN200 at 1.2 / 1.6 MPa.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Isolation and monitoring</td><td class="px-4 py-3 text-gray-700">Signal butterfly valve: DN50–DN300, PN16, with integrated electrical signal switch; OS&Y gate valve: 2"–10", grooved, UL / FM listed.</td></tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">What to Include in One ESFR Order</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2">
				<li><strong>Approved head schedule</strong> — storage commodity, rack and ceiling information, head model, orientation, thread and quantity.</li>
				<li><strong>Hydraulic design basis</strong> — selected K-factor, design pressure, water demand and the project standard or AHJ comments.</li>
				<li><strong>System control set</strong> — wet alarm check valve, water-flow indicators and the specified monitored isolation valves.</li>
				<li><strong>Documentation and packing</strong> — product data, required certificates, box quantities and destination-market marking confirmed before production.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">ESFR Design Resources</h2>
			<p class="text-gray-700 leading-relaxed">For design decisions, see the <a href="/guides/esfr-sprinkler-system-guide/" class="text-brand-blue font-semibold hover:underline">ESFR sprinkler system guide</a>, <a href="/guides/fire-sprinkler-head-selection-guide/" class="text-brand-blue font-semibold hover:underline">fire sprinkler head selection guide</a> and <a href="/guides/fire-sprinkler-system-valves-guide/" class="text-brand-blue font-semibold hover:underline">fire sprinkler system valves guide</a>.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Frequently Asked Questions</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Need an ESFR Warehouse Sprinkler Package?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Send the head schedule and hydraulic design basis — we will confirm the component list and reply with a coordinated quotation within 12 hours.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/contact/?product=ESFR%20Sprinkler%20Systems" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Request a Quote</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20an%20ESFR%20sprinkler%20package" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat on WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
