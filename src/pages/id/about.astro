---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';

// Factory evidence assets are dropped into public/assets/factory/.
// The section only renders for files that actually exist, so the live site
// never shows a broken image or an empty placeholder before assets arrive.
const factoryDir = path.join(process.cwd(), 'public', 'assets', 'factory');
const hasFactoryAsset = (file) => fs.existsSync(path.join(factoryDir, file));

const plantPhotos = [
  { file: 'plant-exterior.webp', alt: 'Gedung pabrik Wanlian Fluid di Quanzhou, Fujian', caption: 'Pabrik kami — Quanzhou, Fujian' },
  { file: 'workshop.webp', alt: 'Area pembentukan plat dengan press brake dan crane gantri di area produksi Wanlian Fluid', caption: 'Area pembentukan plat — press brake dan crane gantri' },
  { file: 'powder-coating.webp', alt: 'Lantai coating serbuk dengan konveyor gantung di Wanlian Fluid', caption: 'Lantai coating serbuk — dari ruang semprot sampai curing' },
  { file: 'assembly.webp', alt: 'Area perakitan dan finishing dengan kabinet selang kebakaran di Wanlian Fluid', caption: 'Area perakitan dan finishing' },
  { file: 'fire-hose.webp', alt: 'Gulungan selang kebakaran jadi dan selang tergulung siap ekspor di Wanlian Fluid', caption: 'Produksi selang kebakaran dan gulungannya' },
  { file: 'qc-test-bench.webp', alt: 'Bench uji tekanan bodi dan kebocoran udara katup Wanlian Fluid', caption: 'Bench uji tekanan bodi dan kebocoran udara' }
].filter((p) => hasFactoryAsset(p.file));

const verifiableItems = [
  'Sertifikat sistem manajemen mutu ISO 9001, beserta lingkup dan lembaga penerbitnya',
  'Laporan uji tekanan bodi dan kebocoran udara per batch untuk unit dalam PO Anda',
  'Inspeksi pihak ketiga (model SGS / BV) sebelum pengiriman, atas instruksi Anda',
  'Tur video langsung di area produksi dan di bench uji selama produksi Anda berjalan',
  'Branding OEM/ODM, pengemasan ekspor, dan paket dokumen ekspor lengkap'
];

const hasBusinessLicense = hasFactoryAsset('business-license.webp');
const hasProductionVideo = hasFactoryAsset('production-line.mp4');
const hasFactoryEvidence = plantPhotos.length > 0 || hasBusinessLicense || hasProductionVideo;
const heroPhoto = hasFactoryAsset('plant-exterior.webp') ? '/assets/factory/plant-exterior.webp' : '/og-image.jpg';

const productionSteps = [
  { step: '01', name: 'Inspeksi Material Masuk', desc: 'Inspeksi material masuk terhadap spesifikasi pesanan: besi ulet, coran, material penyegel, dan lapisan.' },
  { step: '02', name: 'Permesinan CNC', desc: 'Permesinan presisi bodi katup, disc, dan trim sesuai toleransi dimensi yang disyaratkan.' },
  { step: '03', name: 'Perakitan', desc: 'Perakitan komponen internal, elemen penyegel, dan mekanisme pengoperasian dalam area produksi yang terkendali.' },
  { step: '04', name: 'Uji Tekanan dan Kebocoran', desc: '100% uji tekanan bodi dan uji kebocoran dudukan pada setiap unit sebelum finishing.' },
  { step: '05', name: 'Lapisan Epoksi', desc: 'Lapisan resin epoksi tidak beracun diterapkan untuk ketahanan korosi dan umur pakai yang panjang.' },
  { step: '06', name: 'Pengemasan Ekspor', desc: 'Pengemasan, penandaan, dan dokumen standar ekspor disiapkan untuk pengiriman internasional.' }
];

const values = [
  { title: 'Inovasi', desc: 'Optimasi desain dan terobosan riset berkelanjutan untuk menciptakan sistem pemadam kebakaran dan sistem fluida yang lebih cerdas serta lebih efisien.' },
  { title: 'Mutu', desc: 'Mengingat kritisnya sistem pemadam kebakaran dan perpipaan industri, kami memeriksa setiap katup secara ketat hingga melampaui standar internasional.' },
  { title: 'Tanggung Jawab', desc: 'Sebagai perusahaan yang bertanggung jawab secara sosial, kami berupaya meningkatkan keselamatan publik dan memastikan keamanan fluida di jaringan global.' },
  { title: 'Lingkungan', desc: 'Menanamkan standar manufaktur hijau dan konsep keberlanjutan ke dalam alur produksi kami untuk mendukung keselamatan ekologis.' }
];

const faq = [
  {
    question: 'Apakah Wanlian Fluid produsen atau perusahaan dagang?',
    answer: 'Kami adalah produsen dengan lini produksi sendiri di Quanzhou, Fujian: bodi katup dimesin secara internal dengan CNC, dan perakitan serta uji tekanan dilakukan di area produksi kami sendiri. Item tertentu diproduksi oleh mitra manufaktur yang memenuhi syarat dan terdokumentasi per pesanan. Entitas yang menerbitkan invoice pesanan Anda adalah entitas manufaktur yang tercantum pada izin usaha kami.'
  },
  {
    question: 'Lini produk apa saja yang diproduksi Wanlian Fluid?',
    answer: 'Enam lini produk dan 43+ model ready stok: katup gerbang dudukan karet dan dudukan logam, katup kupu-kupu dan katup searah, hidran kebakaran beserta komponen hidran, sprinkler dan katup alarm, selang kebakaran berlapis karet, serta meriam air dan alat pemadam api ringan (APAR) — untuk proyek pasokan air, pengendalian fluida industri, dan proteksi kebakaran.'
  },
  {
    question: 'Bagaimana katup dan hidran diuji sebelum pengiriman?',
    answer: 'Setiap unit menjalani 100% uji tekanan bodi dan uji kebocoran udara di bench uji kami sendiri sebelum finishing, dengan catatan pengujian per unit. Video pengujian bernomor seri pada satu unit contoh serta inspeksi pihak ketiga (model SGS / BV) dapat kami siapkan atas permintaan.'
  },
  {
    question: 'Apakah Wanlian Fluid melayani OEM dan ODM?',
    answer: 'Ya — branding OEM/ODM, kustomisasi non-standar, pengemasan ekspor, dan paket dokumen ekspor lengkap, dengan komitmen respons 12 jam untuk penawaran maupun pertanyaan teknis.'
  },
  {
    question: 'Bagaimana saya bisa memverifikasi perusahaan Anda sebelum melakukan pemesanan?',
    answer: 'Minta sertifikat ISO 9001 beserta lembaga penerbitnya, tur video langsung di area produksi dan di bench uji, laporan pengujian per batch untuk model yang Anda pilih, serta pesanan sampel satu unit. Pemasok yang menghindari verifikasi pada dasarnya sudah menjawab pertanyaan tersebut.'
  }
];
---

<Layout
  locale="id"
  title="Tentang Kami | Produsen Katup Wanlian Fluid"
  description="Produsen dan eksportir katup, peralatan proteksi kebakaran, dan perangkat pengendalian fluida dengan lini produksi sendiri di Quanzhou, Fujian."
  faq={faq}
  breadcrumbs={[{ name: 'Tentang Kami' }]}
>
  <!-- Banner Header -->
  <section class="relative bg-gray-900 text-white overflow-hidden py-20">
    <div class="absolute inset-0 bg-cover bg-center opacity-20" style="background-image: url('/og-image.jpg');"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-500 uppercase">Profil Perusahaan</span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight">Tentang Quanzhou Wanlian</h1>
      <p class="text-base sm:text-lg text-gray-400 max-w-2xl mx-auto">
        Produsen dan eksportir katup serta peralatan proteksi kebakaran, dengan lini produksi sendiri di pusat industri katup dan perpipaan Tiongkok.
      </p>
    </div>
  </section>

  <!-- Factory Profile -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-6">
          <div class="border-l-4 border-blue-600 pl-4">
            <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Profil Perusahaan</span>
            <h2 class="text-3xl font-black text-gray-900 tracking-tight mt-1">Berakar di Jantung Pusat Industri Katup</h2>
          </div>
           <p class="text-base text-gray-600 leading-relaxed">
             Quanzhou Wanlian Fluid Equipment Co., Ltd. berlokasi di Quanzhou, Fujian — titik awal Jalur Sutra Maritim dan klaster inti industri katup serta perpipaan Tiongkok. Kami memproduksi dan mengekspor katup, peralatan pemadam kebakaran, perangkat pengendalian fluida, dan solusi terpadu untuk sektor industri, perkotaan, proteksi kebakaran, serta pasokan dan drainase air; tim insinyur kami mendukung pemilihan produk dan kustomisasi pada setiap pesanan.
           </p>
           <p class="text-base text-gray-600 leading-relaxed">
             Lini produksi kami sendiri di Quanzhou, Fujian memadukan tim insinyur senior dengan permesinan CNC, perakitan, dan uji tekanan internal — didukung mitra manufaktur yang memenuhi syarat untuk item tertentu. Bodi katup dimesin secara internal dengan CNC, setiap unit menjalani uji tekanan bodi dan uji kebocoran udara sebelum pengiriman, dan produksi berjalan di bawah sistem manajemen mutu ISO 9001 bersama standar industri nasional terkait, sehingga stabilitas, keandalan, dan keawetan setiap produk terjaga.
           </p>
           <p class="text-base text-gray-600 leading-relaxed">
             Katalog kami disusun berdasarkan spesifikasi yang benar-benar dipakai insinyur perancang — pressure class, standar sambungan, material bodi dan trim, serta aplikasi — dengan penawaran berbasis inquiry dan dukungan teknis untuk proyek pasokan air, pengendalian fluida industri, dan pemadam kebakaran.
           </p>
           <div class="grid grid-cols-2 gap-6 pt-4 border-t border-gray-100">
             <div>
               <span class="block text-2xl font-black text-blue-600">Katup</span>
               <span class="block text-xs text-gray-400 font-bold tracking-wider uppercase mt-1">Sistem Pengendalian Fluida</span>
             </div>
             <div>
               <span class="block text-2xl font-black text-blue-600">Proteksi Kebakaran</span>
                <span class="block text-xs text-gray-400 font-bold tracking-wider uppercase mt-1">Lini Produksi Sendiri</span>
             </div>
           </div>
        </div>

        <div class="relative rounded-2xl overflow-hidden aspect-video shadow-lg border border-gray-100 bg-gray-50">
          <img 
            src={heroPhoto}
            alt="Pabrik dan produksi katup Wanlian Fluid, Quanzhou, Fujian"
            loading="lazy"
            class="object-cover w-full h-full"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Manufacturing Evidence: plant photos, business license, production video -->
  {hasFactoryEvidence && (
  <section class="py-24 bg-gray-50 border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Bukti Produksi</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Di Dalam Lini Produksi Kami di Quanzhou</h2>
        <p class="text-base text-gray-500">Dokumen dan rekaman untuk keperluan verifikasi Anda — catatan yang sama yang diperiksa pembeli kami sendiri. Minta paket sertifikat dan laporan pengujian lengkap yang sesuai PO Anda.</p>
      </div>

      {plantPhotos.length > 0 && (
      <div class="columns-1 sm:columns-2 gap-6 mb-16">
        {plantPhotos.map((photo) => (
          <figure class="mb-6 break-inside-avoid bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-sm">
            <img src={`/assets/factory/${photo.file}`} alt={photo.alt} loading="lazy" class="w-full h-auto" />
            <figcaption class="px-5 py-4 text-sm font-semibold text-gray-700">{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
      )}

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        {hasProductionVideo && (
        <div class="lg:col-span-1 bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
          <video
            class="w-full aspect-[9/16] bg-gray-900 object-cover"
            controls
            playsinline
            preload="metadata"
            poster={hasFactoryAsset('production-line-poster.webp') ? '/assets/factory/production-line-poster.webp' : undefined}
          >
            <source src="/assets/factory/production-line.mp4" type="video/mp4" />
            Browser Anda tidak mendukung pemutaran video tertanam.
          </video>
          <div class="px-6 py-5">
            <h3 class="font-bold text-lg text-gray-900">Di Area Produksi</h3>
            <p class="mt-2 text-sm text-gray-500 leading-relaxed">Dua puluh lima detik rekaman tanpa penyuntingan dari lini produksi kami sendiri — pembentukan plat, pengelasan, lantai coating serbuk, dan penenunan lapisan luar selang kebakaran. Bukan video stok.</p>
          </div>
        </div>
        )}

        <div class={hasProductionVideo ? 'lg:col-span-2 space-y-8' : 'lg:col-span-3 space-y-8'}>
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 sm:p-8">
            <h3 class="font-bold text-lg text-gray-900">Yang dapat Anda verifikasi bersama kami</h3>
            <p class="mt-2 text-sm text-gray-500 leading-relaxed">Verifikasi adalah bagian normal dari bekerja sama dengan pemasok Tiongkok. Ini yang akan kami serahkan sebelum Anda mengambil keputusan — silakan minta semuanya.</p>
            <ul class="mt-6 space-y-3">
              {verifiableItems.map((item) => (
                <li class="flex items-start gap-3 text-sm text-gray-600 leading-relaxed">
                  <span class="mt-1.5 w-1.5 h-1.5 bg-brand-red rounded-full flex-shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          {hasBusinessLicense && (
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
            <img src="/assets/factory/business-license.webp" alt="Izin usaha Quanzhou Wanlian Fluid Equipment Co., Ltd. dengan lingkup usaha yang mencakup manufaktur" loading="lazy" class="w-full object-contain bg-gray-50 max-h-[420px]" />
            <div class="px-6 py-5">
              <h3 class="font-bold text-lg text-gray-900">Izin Usaha</h3>
              <p class="mt-2 text-sm text-gray-500 leading-relaxed">Terdaftar di Quanzhou, Fujian. Lingkup usaha mencakup manufaktur, pengolahan, dan ekspor katup serta peralatan proteksi kebakaran — entitas yang menerbitkan invoice pesanan Anda adalah entitas yang memproduksi barangnya.</p>
            </div>
          </div>
          )}
        </div>
      </div>

      <p class="mt-10 text-center text-sm text-gray-500">
        Ingin tur video langsung di area produksi dan di bench uji untuk proyek Anda? <a href="/id/contact/" class="text-brand-blue font-semibold hover:underline">Jadwalkan tur pabrik</a>.
      </p>
    </div>
  </section>
  )}

  <!-- Products & Services -->
  <section class="py-24 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Produk &amp; Layanan</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Lini Produk Lengkap &amp; Layanan yang Beragam</h2>
        <p class="text-base text-gray-500">Menjalankan fungsi transmisi, regulasi, penutupan, dan proteksi keselamatan pada sistem fluida di berbagai industri.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-gray-50 p-8 rounded-xl border border-gray-100">
          <h3 class="font-bold text-lg text-gray-900 mb-4">Produk Utama</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            {['Katup Gerbang', 'Katup Kupu-kupu', 'Katup Bola', 'Katup Penyeimbang', 'Katup Globe', 'Katup Searah', 'Filter', 'Katup Kontrol Hidrolik', 'Aksesori Pipa', 'Aktuator'].map(item => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-brand-red rounded-full flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-gray-50 p-8 rounded-xl border border-gray-100">
          <h3 class="font-bold text-lg text-gray-900 mb-4">Peralatan Pemadam Kebakaran</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            {['Kabinet Kebakaran', 'Hidran Kebakaran', 'Alat Pemadam Api Ringan (APAR)', 'Gulungan Selang Kebakaran', 'Selang Kebakaran', 'Nozel Kebakaran', 'Kopling Selang Kebakaran', 'Sprinkler Kebakaran'].map(item => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-brand-blue rounded-full flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-gray-50 p-8 rounded-xl border border-gray-100">
          <h3 class="font-bold text-lg text-gray-900 mb-4">Aplikasi &amp; Layanan</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-6">Banyak digunakan di industri petrokimia, pembangkit listrik, metalurgi, pasokan &amp; drainase air perkotaan, proteksi kebakaran gedung, pengolahan limbah, HVAC, dan lainnya.</p>
          <div class="flex flex-wrap gap-2">
            {['OEM', 'ODM', 'Kustomisasi Non-Standar'].map(tag => (
              <span class="px-3 py-1.5 bg-white border border-gray-200 text-xs font-black uppercase tracking-wider text-gray-700 rounded-full">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Production Process -->
  <section class="py-24 bg-gray-50 border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Kontrol Mutu</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Alur Produksi Standar Kami</h2>
          <p class="text-base text-gray-500">Setiap pesanan mengikuti urutan produksi terkendali yang sama — mulai dari inspeksi material masuk hingga pengemasan ekspor.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {productionSteps.map(step => (
          <div class="bg-white p-8 rounded-xl border border-gray-100 shadow-sm relative overflow-hidden group">
            <span class="absolute right-6 top-6 text-4xl font-black text-gray-100 group-hover:text-blue-50 transition duration-300">
              {step.step}
            </span>
            <div class="space-y-4">
              <h3 class="font-bold text-lg text-gray-900 pr-12">{step.name}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Nilai Inti</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Empat Pilar Utama Perusahaan</h2>
        <p class="text-base text-gray-500">Mendorong keselamatan berkelanjutan dan keunggulan industri di seluruh dunia.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {values.map(val => (
          <div class="flex gap-6 items-start">
            <div class="bg-blue-500/10 p-4 rounded-xl text-blue-600 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <div class="space-y-2">
              <h3 class="font-bold text-xl text-gray-900">{val.title}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">{val.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Business Philosophy & Vision -->
  <section class="py-24 bg-gray-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-500 uppercase">Komitmen Kami</span>
        <h2 class="text-3xl font-black tracking-tight">Filosofi Bisnis</h2>
      </div>

      <blockquote class="text-center text-2xl sm:text-3xl font-black tracking-tight text-white mb-16">
        "Berorientasi mutu, pelanggan terlebih dahulu, integritas untuk kemenangan bersama, <span class="text-brand-red">inovasi untuk pembangunan berkelanjutan</span>"
      </blockquote>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        {[
          { title: 'Konsultasi Pra-Penjualan', desc: 'Panduan pemilihan produk secara profesional dan solusi teknis yang dikustomisasi sesuai kebutuhan proyek Anda.' },
          { title: 'Dukungan Selama Proses', desc: 'Panduan teknis untuk instalasi dan komisioning, dengan respons cepat terhadap kebutuhan pelanggan.' },
          { title: 'Layanan Purna Jual', desc: 'Perawatan purna jual dan pemecahan masalah praktis pada aplikasi sistem fluida.' }
        ].map((item, idx) => (
          <div class="p-8 bg-white/5 border border-white/10 rounded-2xl text-center">
            <span class="block text-4xl font-black text-white/10 mb-4">{String(idx + 1).padStart(2, '0')}</span>
            <h3 class="font-bold text-lg mb-3">{item.title}</h3>
            <p class="text-xs text-gray-400 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center max-w-3xl mx-auto space-y-6">
        <p class="text-lg text-gray-300 leading-relaxed">
          Berakar di Quanzhou, menjangkau pasar nasional dan merangkul peluang global, kami terus berfokus pada bidang peralatan fluida — mendorong peningkatan produk melalui inovasi teknologi dan membangun reputasi merek yang kokoh lewat layanan berkualitas tinggi.
        </p>
        <p class="text-gray-400 leading-relaxed">
          Kami bertujuan menjadi produsen dan mitra ekspor yang tepercaya di sektor pengendalian fluida domestik maupun internasional, menghadirkan solusi sistem fluida yang lebih efisien, lebih aman, dan lebih cerdas bagi pelanggan dari berbagai kalangan, serta berkontribusi pada pembangunan industri dan infrastruktur.
        </p>
        <a href="/id/contact/" class="inline-flex items-center gap-2 px-8 py-4 bg-brand-red hover:opacity-90 text-white font-bold rounded-lg transition">
          Mulai Konsultasi <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 bg-gray-50 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">FAQ</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Pertanyaan yang Sering Diajukan</h2>
      </div>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-white rounded-xl border border-gray-100 p-6 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
