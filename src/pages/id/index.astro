---
import Layout from '../../layouts/Layout.astro';
import { productsId } from '../../utils/products.id';
import { guidesId } from '../../utils/guides.id';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';
import LeadCaptureSection from '../../components/inquiry/LeadCaptureSection.astro';
import CompanyIntroVideo from '../../components/sections/CompanyIntroVideo.astro';
import VideoCarousel from '../../components/sections/VideoCarousel.astro';

const faq = [
  {
    question: 'O que Wanlian Fluid fabrica e exporta?',
    answer: 'A Wanlian Fluid é uma fabricante e exportadora sediada em Quanzhou de katup industriais e equipamentos de proteksi kebakaran: katup gerbang com dudukan elástico e metálico, katup kupu-kupu e de retensi, hidran kebakaran e componentes de hidran, katup de sprinkler e de alarm, e selang kebakaran revestidas de borracha — seis lini de produk com lebih de 43 modelos em estoque.'
  },
  {
    question: 'Como obtenho o harga de uma katup ou hidran?',
    answer: 'O harga é berdasarkan permintaan. Envie spesifikasi Anda — modelo ou standar, ukuran, classe de tekanan, material, quantidade e tujuan — e tim kami menanggapi com uma penawaran terperinci dalam waktu hingga 12 jam.'
  },
  {
    question: 'Cada unit é testada sebelum do pengiriman?',
    answer: 'Sim. Cada katup, hidran e selang é submetida a ensaio de tekanan de bodi e de kebocoran de ar sebelum do pengiriman, com registros per unit. A produksi opera sob um sistem manajemen mutu ISO 9001.'
  },
  {
    question: 'Vocês atendem pesanan OEM ou de marca própria?',
    answer: 'Sim. OEM/ODM, marca personalizada e embalagem untuk exportação são layanan standar. A kesesuaian com uma standar específica (misalnya AWWA C502, listagem UL ou aprovação FM) é confirmada por modelo, com laudos de pengujian e sertifikat sebelum do pesanan.'
  }
];

// Produtos em destaque da página inicial (produk reais Wanlian)
const featuredProducts = productsId.filter(p => [
  'resilient-seat-flanged-gate-valve-z41x',
  'indoor-fire-hydrant-head-sn65',
  'wet-alarm-check-valve-zsfz-150',
  'signal-grooved-wafer-butterfly-valve-dn80',
  'spherical-ball-check-valve-hq44x',
  'hydraulic-water-level-control-valve-f745x',
  'telescopic-y-strainer-sgl41h',
  'anti-collision-pressure-regulating-outdoor-hydrant-ssft100'
].includes(p.slug));

const categories = [
  { name: 'Válvulas e Peças', count: '150+', image: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp' },
  { name: 'Hidrantes e Conexões de Bomba', count: '80+', image: '/assets/products/indoor-fire-hydrant-head-sn65.jpg' },
  { name: 'Sprinkler dan Katup Alarm', count: '120+', image: '/assets/products/wet-alarm-check-valve-zsfz-150.webp' },
  { name: 'Segurança Hidráulica', count: '60+', image: '/assets/products/adjustable-pressure-reducing-valve-500x.webp' },
  { name: 'Monitor Air Kebakaran de Incêndio', count: '40+', image: '/assets/products/manual-fire-water-cannon-ps.webp' },
  { name: 'Armários de Incêndio e Interfaces', count: '90+', image: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg' }
];

const productionSteps = [
  { step: '01', title: 'Trançado de Precisão', desc: 'Trançado de poliéster de tinggi resistência untuk capas de selang kebakaran duráveis.', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
  { step: '02', title: 'Adesão do Revestimento', desc: 'Processo avançado de vulcanização untuk revestimento de borracha com vedação estanque.', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { step: '03', title: 'Usinagem CNC', desc: 'Usinagem de precisão de corpos de katup em ferro fundido dúctil e componentes.', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
  { step: '04', title: 'Testes de Segurança', desc: 'Ensaios de tekanan de bodi e de kebocoran de ar em 100% das unit.', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { step: '05', title: 'Revestimento Epóxi', desc: 'Revestimento em resina epóxi não tóxica untuk resistência à corrosão superior.', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' }
];

// Entradas de guias e páginas de sistem (conteúdo que direciona peso à página inicial);
// o spread de guidesId mantém o data source PT — a lista cresce sesuai as publicações PT forem lançadas
const resources = [
  { href: '/id/guides/fire-sprinkler-system-valves-guide/', eyebrow: 'Guia de Compra', title: 'Guia de Válvulas untuk Sistem Sprinkler', desc: 'Grupos de katup de alarm molhado, dilúvio e pré-ação explicados untuk compradores de sistem de sprinkler.' },
  { href: '/id/guides/fire-sprinkler-system-wet-dry-preaction/', eyebrow: 'Guia de Compra', title: 'Sistem Sprinkler: Molhado, Seco ou Pré-Ação', desc: 'Compare os tipos de sistem e escolha a configuração certa untuk o perfil de risco do seu gedung.' },
  { href: '/id/fire-water-cannon/', eyebrow: 'Visão Geral do Sistema', title: 'Monitor Air Kebakaran de Água Contra Incêndio', desc: 'Monitores manual PS e canhões de pelacakan otomatis ZDMS untuk supressão de incêndio em grandes espaços.' },
  { href: '/id/guides/how-to-choose-a-fire-hydrant/', eyebrow: 'Guia de Compra', title: 'Como Escolher um Hidrante Contra Incêndio', desc: 'Tipos de hidran, classes de tekanan, standar de conexão e checklist de compras direto da pabrik.' },
  { href: '/id/guides/how-to-choose-ul-listed-fire-valves/', eyebrow: 'Guia de Compra', title: 'Como Escolher Válvulas Contra Incêndio Listadas UL', desc: 'O que realmente significa a listagem UL, UL vs FM e bagaimana verificar sertifikat genuínos.' },
  { href: '/id/guides/gate-valve-vs-butterfly-valve-fire-protection/', eyebrow: 'Guia de Compra', title: 'Válvula de Gaveta vs Válvula Borboleta', desc: 'Comparação de vazão, espaço, custo e aplikasi untuk redes de incêndio e lini de derivada de sprinkler.' },
  ...guidesId.map(g => ({
    href: g.href,
    eyebrow: 'Guia de Compra',
    title: g.title,
    desc: g.description
  }))
];

// Evidência de proyek no local: casa de bombas kebakaran instalada (fotos + vídeo vertical de visita)
const projectPhotos = [
  { src: '/assets/projects/pump-skids.webp', alt: 'Linha de grupos de bombas kebakaran com etiquetas de posição OPEN e CLOSE em casa de bombas instalada', caption: 'Skids de bombas com etiquetas de posição OPEN/CLOSE' },
  { src: '/assets/projects/valve-train.webp', alt: 'Linha de katup gerbang e manômetros em montantes vermelhos da casa de bombas instalada', caption: 'Montantes e lini de katup gerbang' },
  { src: '/assets/projects/riser-grid.webp', alt: 'Grade de montantes com dutos superiores e bandejas de cabos na casa de bombas instalada', caption: 'Grade de montantes e dutos superiores' },
  { src: '/assets/projects/pump-room-final.webp', alt: 'Casa de bombas kebakaran instalada, preparada untuk inspeção e entrega', caption: 'Casa de bombas pronta untuk entrega' }
];

const projectScope = [
  'Vários grupos de bombas de sprinkler e kebakaran instalados sobre bases de concreto',
  'Grade lengkap de montantes com katup gerbang, manômetros e etiquetas de posição OPEN/CLOSE',
  'Dutos superiores e bandejas de cabos roteados ao longo da grade de montantes',
  'Local preparado untuk inspeção final e entrega'
];

const industries = [
  { name: 'Minyak dan Gas', desc: 'Transporte de fluidos aman em condições industriais extremas.', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { name: 'Pengolahan Air', desc: 'Redes municipais de abastecimento de air, drenagem e filtração.', icon: 'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3' },
  { name: 'Proteksi Kebakaran', desc: 'Hidrantes sertifikat, katup de sprinkler e sistem de supressão.', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' }
];
---

<Layout
  locale="id"
  title="Wanlian Fluid | Fábrica de Válvulas e Proteção Contra Incêndio"
  description="Fabricante de válvulas industriais e equipamentos de proteção contra incêndio em Quanzhou, China. Fábrica própria, ISO 9001, usinagem CNC e cotação em 12 horas."
  faq={faq}
  breadcrumbs={[{ name: 'Beranda', href: '/id/' }]}
  video={{ name: 'Wanlian Fluid dalam 50 Detik', description: 'Video pengenalan perusahaan: ruang pamer, lini produksi, kustomisasi OEM, dan pengendalian mutu di pabrik Quanzhou.', thumbnail: '/videos/company-intro-poster.webp', src: '/videos/company-intro.mp4', duration: 'PT49S', uploadDate: '2026-09-18' }}
>
  <!-- Seção Hero com Estética Diagonal -->
  <section class="relative bg-gray-900 text-white min-h-[85vh] flex items-center overflow-hidden">
    <!-- Fundo cinematográfico de produk com Ken Burns lento; gradientes mantêm o texto legível e o logotipo embutido discreto -->
    <div class="absolute inset-0 z-0" aria-hidden="true">
      <img src="/og-image.jpg" alt="" fetchpriority="high" class="w-full h-full object-cover object-center opacity-90 hero-kenburns" />
      <div class="absolute inset-0 bg-gradient-to-r from-gray-950 via-gray-950/75 to-gray-950/15"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-gray-950 to-transparent"></div>
    </div>

    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-24">
      <div class="max-w-3xl space-y-6 sm:space-y-8">
        <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full border border-white/20">
          <span class="flex h-2 w-2 rounded-full bg-brand-red animate-pulse"></span>
          <span class="text-sm font-bold tracking-widest uppercase">Produsen &amp; Eksportir — Katup &amp; Proteksi Kebakaran</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-black tracking-tight leading-[1.15]">
          Válvulas &amp; Proteção Contra <br/>
          <span class="text-brand-red">Incêndio untuk Proyek Global.</span>
        </h1>

        <p class="text-lg sm:text-xl text-gray-300 max-w-2xl leading-relaxed">
          Katup industri, hidran kebakaran, serta sistem katup sprinkler dan alarm — 100% ensaiadas de tekanan, ISO 9001, penawaran terperinci dalam waktu hingga 12 jam.
        </p>

        <div class="flex flex-wrap gap-4 pt-4">
          <a href="/id/products/" class="px-8 py-4 bg-brand-red hover:opacity-90 text-white font-bold rounded-lg transition shadow-xl shadow-brand-red/20 transform hover:-translate-y-1">
            Lihat Katalog
          </a>
          <a href="/id/contact/#inquiry" class="px-8 py-4 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white font-bold rounded-lg border border-white/30 transition">
            Minta Penawaran
          </a>
        </div>
      </div>
    </div>
  </section>

  <VideoCarousel locale="id" />

  <!-- Mural de Certificação -->
  <div class="bg-gray-100 py-8 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-50 grayscale hover:grayscale-0 transition duration-500">
        <span class="text-gray-900 font-black text-xl tracking-tighter">DADOS TÉCNICOS</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">DESENHOS DO PRODUTO</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">OPÇÕES DE MATERIAIS</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">CLASSES DE PRESSÃO</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">OEM / ODM</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">SUPORTE À EXPORTAÇÃO</span>
      </div>
    </div>
  </div>

  <!-- Seção Sobre: Força da Fábrica -->
  <section class="py-24 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="flex-1 space-y-8">
          <div class="space-y-4">
            <h2 class="text-sm font-black tracking-[0.3em] text-brand-red uppercase flex items-center gap-2">
              <span class="w-8 h-[2px] bg-brand-red"></span>
              Profil Perusahaan
            </h2>
            <h3 class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight leading-tight">
              Solusi Pengendalian Fluida <br/><span class="text-brand-blue">untuk Proyek Global.</span>
            </h3>
          </div>

          <div class="space-y-6 text-gray-600 text-lg leading-relaxed">
            <p>
              Sediada em Quanzhou, Fujian — o utama polo da indústria de tubulações e katup da Tiongkok — a Quanzhou Wanlian Fluid Equipment Co., Ltd. fabrica e exporta katup industriais, produk de pengendalian hidráulico, componentes de hidran e equipamentos de proteksi kebakaran untuk proyek B2B internasional. A manufaktur é realizada em kami próprias lini de produksi em Quanzhou, com itens selecionados produzidos por parceiros de manufaktur qualificados; os corpos de katup são usinados em CNC e setiap unit é submetida a ensaio de tekanan de bodi e de estanqueidade a ar sebelum do pengiriman, sob um sistem manajemen mutu ISO 9001.
            </p>
            <p>
              Construímos setiap página de produk em torno das spesifikasi que os compradores realmente utilizam — classe de tekanan, standar de conexão, material do bodi e do conjunto, e aplikasi — com penawaran berdasarkan permintaan e dukungan de teknik untuk abastecimento de air, pengendalian fluida industriais e sistem de combate a incêndio.
            </p>
          </div>

          <!-- Cards de Métricas: nomor em destaque (semua verificáveis no próprio situs) -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 pt-4">
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-red tabular-nums">{productsId.length}+</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Modelos em Estoque</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-blue tabular-nums">{categories.length}</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Linha de Produtos</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-red tabular-nums">100%</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Ensaio de Pressão</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-blue tabular-nums">ISO 9001</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Sistema de Mutu</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-3 pt-2">
            <span class="px-4 py-2 bg-brand-red/5 border border-brand-red/20 text-brand-red text-xs font-black uppercase tracking-widest rounded-full">P&amp;D · Vendas · Serviços</span>
            <span class="px-4 py-2 bg-brand-blue/5 border border-brand-blue/20 text-brand-blue text-xs font-black uppercase tracking-widest rounded-full">Certificada ISO 9001</span>
            <span class="px-4 py-2 bg-gray-100 border border-gray-200 text-gray-700 text-xs font-black uppercase tracking-widest rounded-full">OEM · ODM · Sob Medida</span>
          </div>

          <a href="/id/about/" class="inline-flex items-center gap-2 font-bold text-brand-blue hover:underline pt-2">
            Baca Profil Perusahaan Lengkap <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="flex-1 relative">
          <div class="absolute -top-10 -left-10 w-40 h-40 bg-blue-100 rounded-full blur-3xl opacity-50 z-0"></div>
          <CompanyIntroVideo locale="id" />
        </div>
      </div>
    </div>
  </section>

  <!-- Mengapa Memilih Kami: três vantagens (setiap afirmação verificável no situs: processo/certificações/FAQ 12h) -->
  <section class="py-24 bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
        <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Mengapa Memilih Kami</h2>
        <h3 class="text-4xl font-black text-gray-900 tracking-tight">Mengapa Memilih <span class="text-brand-red">Wanlian</span></h3>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-8 rounded-2xl border border-gray-200 bg-gray-50 hover:shadow-lg transition-shadow duration-300">
          <div class="w-12 h-12 rounded-lg bg-brand-red/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h4 class="text-lg font-black text-gray-900 mb-2">Linhas de Produção Próprias</h4>
          <p class="text-gray-600 text-sm leading-relaxed">Usinagem CNC, montagem, pengujian de tekanan e revestimento em kami próprias lini na planta de Quanzhou, com capacidade de parceiros qualificados untuk picos de pesanan.</p>
        </div>
        <div class="p-8 rounded-2xl border border-gray-200 bg-gray-50 hover:shadow-lg transition-shadow duration-300">
          <div class="w-12 h-12 rounded-lg bg-brand-red/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h4 class="text-lg font-black text-gray-900 mb-2">Certificada, Ensaio Lote a Lote</h4>
          <p class="text-gray-600 text-sm leading-relaxed">Sistema de mutu ISO 9001:2015, produk UL Listed / Recognized e ensaio de tekanan de bodi e dudukan em 100% das unit sesuai GB/T13927 / EN 12266-1 sebelum da embalagem.</p>
        </div>
        <div class="p-8 rounded-2xl border border-gray-200 bg-gray-50 hover:shadow-lg transition-shadow duration-300">
          <div class="w-12 h-12 rounded-lg bg-brand-red/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h4 class="text-lg font-black text-gray-900 mb-2">Cotações Detalhadas em 12 Horas</h4>
          <p class="text-gray-600 text-sm leading-relaxed">Envie gambar, spesifikasi ou hanya uma foto — insinyur kami respondem com penawaran terperinci, status de estoque e prazo de entrega dalam waktu hingga 12 jam, 7 hari por semana.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Grade de Categorias de Produtos -->
  <section class="py-24 bg-gray-50 border-y border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <h2 class="text-4xl font-black text-gray-900 tracking-tight uppercase">Kategori Produk Utama</h2>
        <div class="h-1.5 w-20 bg-brand-red mx-auto"></div>
        <p class="text-gray-500 font-medium italic">Engenharia de tinggi precisão untuk redes de incêndio e de air di seluruh dunia.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {categories.map(cat => (
          <a href={`/id/products/#category=${encodeURIComponent(cat.name)}`} class="group relative bg-white rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-200">
            <div class="aspect-[4/3] overflow-hidden bg-gray-50 p-6 flex items-center justify-center">
              <img src={cat.image} alt={cat.name} loading="lazy" class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-6 bg-white/95 backdrop-blur-sm flex justify-between items-center group-hover:bg-brand-red group-hover:text-white transition-colors">
              <div>
                <h4 class="font-black text-lg">{cat.name}</h4>
                <p class="text-[10px] font-black uppercase tracking-widest opacity-60">Ver lini de produk</p>
              </div>
              <span class="text-2xl font-light">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <!-- Excelência em Produção -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="w-full lg:w-1/2 space-y-6">
          <div class="space-y-4">
            <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Alur Produksi</h2>
            <h3 class="text-4xl font-black text-gray-900 tracking-tight">Proses Manufaktur Kami</h3>
          </div>
          <p class="text-gray-500 max-w-md">
            Cada unit segue a mesma sequência controlada — da fundição e usinagem CNC ao ensaio de tekanan em 100% e ao revestimento epóxi.
          </p>
        </div>

        <div class="w-full lg:w-1/2 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {productionSteps.map(step => (
            <div class="relative bg-gray-50 rounded-xl p-6 border border-gray-100 hover:border-brand-blue/50 transition-colors group">
              <div class="absolute top-5 right-5 text-gray-200 font-black text-2xl group-hover:text-brand-blue/20 transition-colors">
                {step.step}
              </div>
              <svg class="w-8 h-8 text-brand-blue mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={step.icon} />
              </svg>
              <h4 class="font-black text-gray-900 mb-2">{step.title}</h4>
              <p class="text-sm text-gray-600 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Studi Kasus Proyek: evidência real de instalação no local (fotos + vídeo vertical de visita) -->
  <section class="py-24 bg-gray-50 border-y border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-14 lg:gap-20 items-center">
        <div class="w-full lg:w-1/2 space-y-5">
          <div class="space-y-4">
            <h2 class="text-sm font-black tracking-[0.3em] text-brand-red uppercase">Studi Kasus Proyek</h2>
            <h3 class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight leading-tight">
              Proyek Kami, <span class="text-brand-red">di Lokasi</span>
            </h3>
          </div>
          <p class="text-gray-600 text-lg leading-relaxed">
            Fotos e vídeo de um proyek de casa de bombas kebakaran — instalação real, pronta untuk a entrega.
          </p>

          <h4 class="font-black text-gray-900 text-lg pt-3">Yang Dipasang di Lokasi Ini</h4>
          <ul class="space-y-3">
            {projectScope.map(item => (
              <li class="flex items-start gap-3 text-gray-600 leading-relaxed">
                <svg class="w-5 h-5 text-brand-red mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <a href="/id/contact/" class="inline-flex items-center gap-2 px-7 py-3.5 bg-brand-red hover:opacity-90 text-white font-bold rounded-lg transition shadow-lg shadow-brand-red/20">
            Diskusikan Proyek Anda <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="w-full lg:w-1/2">
          <div class="grid grid-cols-2 gap-3">
            <figure class="rounded-2xl overflow-hidden border border-gray-200 bg-white shadow-sm">
              <div class="aspect-[4/3] overflow-hidden bg-gray-50">
                <img src={projectPhotos[0].src} alt={projectPhotos[0].alt} loading="lazy" class="w-full h-full object-cover" />
              </div>
              <figcaption class="px-3 py-2.5 text-[11px] font-bold text-gray-500 uppercase tracking-wide">{projectPhotos[0].caption}</figcaption>
            </figure>
            <figure class="rounded-2xl overflow-hidden border border-gray-200 bg-white shadow-sm relative col-span-1">
              <div class="aspect-[4/5] overflow-hidden bg-gray-50">
                <video src="/videos/pump-room-walkthrough.mp4" poster="/videos/pump-room-walkthrough-poster.webp" muted loop playsInline preload="metadata" class="w-full h-full object-cover"></video>
              </div>
              <span class="absolute top-3 left-3 px-2.5 py-1 bg-brand-red text-white text-[10px] font-black uppercase tracking-widest rounded-full">Video di Lokasi</span>
              <figcaption class="px-3 py-2.5 text-[11px] font-bold text-gray-500 uppercase tracking-wide">Video: kunjungan ruang pompa</figcaption>
            </figure>
            <figure class="rounded-2xl overflow-hidden border border-gray-200 bg-white shadow-sm">
              <div class="aspect-[4/3] overflow-hidden bg-gray-50">
                <img src={projectPhotos[1].src} alt={projectPhotos[1].alt} loading="lazy" class="w-full h-full object-cover" />
              </div>
              <figcaption class="px-3 py-2.5 text-[11px] font-bold text-gray-500 uppercase tracking-wide">{projectPhotos[1].caption}</figcaption>
            </figure>
            <figure class="rounded-2xl overflow-hidden border border-gray-200 bg-white shadow-sm">
              <div class="aspect-[4/3] overflow-hidden bg-gray-50">
                <img src={projectPhotos[2].src} alt={projectPhotos[2].alt} loading="lazy" class="w-full h-full object-cover" />
              </div>
              <figcaption class="px-3 py-2.5 text-[11px] font-bold text-gray-500 uppercase tracking-wide">{projectPhotos[2].caption}</figcaption>
            </figure>
            <figure class="rounded-2xl overflow-hidden border border-gray-200 bg-white shadow-sm col-span-2">
              <div class="aspect-[21/9] overflow-hidden bg-gray-50">
                <img src={projectPhotos[3].src} alt={projectPhotos[3].alt} loading="lazy" class="w-full h-full object-cover" />
              </div>
              <figcaption class="px-3 py-2.5 text-[11px] font-bold text-gray-500 uppercase tracking-wide">{projectPhotos[3].caption}</figcaption>
            </figure>
          </div>
        </div>
      </div>
    </div>
