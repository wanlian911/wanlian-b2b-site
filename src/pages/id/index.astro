            <h2 class="text-4xl font-black text-gray-900 tracking-tight uppercase">Dapatkan Penawaran Profesional</h2>
            <div class="h-1.5 w-20 bg-brand-red"></div>
          </div>
          <p class="text-lg text-gray-600 leading-relaxed">
            Envie Anda gambar técnicos ou persyaratan de produk. Analisaremos os detalhes e retornaremos com informasi do produk e etapas de penawaran adequadas.
          </p>
          <ul class="space-y-4">
            {['Cotação berdasarkan permintaan', 'Suporte de aplikasi e seleção', 'Coordenação de embalagem untuk exportação', 'Suporte com dokumentasi de produk'].map(item => (
              <li class="flex items-center gap-3 text-gray-700 font-medium">
                <span class="w-2 h-2 rounded-full bg-brand-red"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="w-full lg:w-3/5">
          <InquiryForm />
        </div>
      </div>
    </div>
  </section>

  <!-- Captura de Leads -->
  <LeadCaptureSection />

  <style is:global>
    @keyframes hero-kenburns { from { transform: scale(1); } to { transform: scale(1.07); } }
    .hero-kenburns { animation: hero-kenburns 26s ease-in-out infinite alternate; will-change: transform; }
    @media (prefers-reduced-motion: reduce) { .hero-kenburns { animation: none; } }
  </style>
