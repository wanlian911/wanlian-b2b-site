---
import Layout from '../../layouts/Layout.astro';
import { productsId } from '../../utils/products.id';
import { guidesId } from '../../utils/guides.id';
import { isTranslated, stripLocale } from '../../i18n/locales';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';
import LeadCaptureSection from '../../components/inquiry/LeadCaptureSection.astro';
import CompanyIntroVideo from '../../components/sections/CompanyIntroVideo.astro';
import VideoCarousel from '../../components/sections/VideoCarousel.astro';

const faq = [
  {
    question: 'Apa saja yang diproduksi dan diekspor oleh Wanlian Fluid?',
    answer: 'Wanlian Fluid adalah produsen dan eksportir berbasis di Quanzhou untuk katup industri dan peralatan proteksi kebakaran: katup gerbang dudukan karet dan dudukan logam, katup kupu-kupu serta katup searah, hidran kebakaran dan komponen hidran, katup sprinkler dan katup alarm, serta selang kebakaran berlapis karet — enam lini produk dengan lebih dari 43 model dalam stok.'
  },
  {
    question: 'Bagaimana saya memperoleh harga untuk sebuah katup atau hidran?',
    answer: 'Harga ditentukan berdasarkan permintaan. Kirimkan spesifikasi Anda — model atau standar, ukuran, kelas tekanan, material, jumlah, dan tujuan pengiriman — tim kami akan merespons dengan penawaran terperinci dalam waktu hingga 12 jam.'
  },
  {
    question: 'Apakah setiap unit diuji sebelum pengiriman?',
    answer: 'Ya. Setiap katup, hidran, dan selang menjalani uji tekanan bodi dan uji kebocoran udara sebelum pengiriman, dengan catatan per unit. Produksi berjalan di bawah sistem manajemen mutu ISO 9001.'
  },
  {
    question: 'Apakah Anda melayani pesanan OEM atau private label?',
    answer: 'Ya. OEM/ODM, merek sendiri, dan kemasan ekspor adalah layanan standar. Kesesuaian dengan standar tertentu (misalnya AWWA C502, terdaftar UL, atau persetujuan FM) dikonfirmasi per model, disertai laporan pengujian dan sertifikat sebelum pesanan diproses.'
  }
];

// Produk unggulan halaman depan (produk nyata Wanlian)
const featuredProducts = productsId.filter(p => [
  'resilient-seat-flanged-gate-valve-z41x',
  'indoor-fire-hydrant-head-sn65',
  'wet-alarm-check-valve-zsfz-150',
  'signal-grooved-wafer-butterfly-valve-dn80',
  'spherical-ball-check-valve-hq44x',
  'hydraulic-water-level-control-valve-f745x',
  'telescopic-y-strainer-sgl41h',
  'anti-collision-pressure-regulating-outdoor-hydrant-ssft100'
].includes(p.slug));

// 分类名与数量取自本语种产品数据本身。此前这里硬编码了一套与数据不一致的名称
// （id 残留葡语标签），使 /id/products/#category= 深链筛不到任何产品，
// 且 count 为无依据的估算值。字段形状保持 { name, count, image } 不变，模板无需改动。
// 卡片配图用全站统一 slug 反查，不新增未核实的图片路径。
const CARD_LEAD_SLUGS = [
  'resilient-seat-flanged-gate-valve-z41x',
  'indoor-fire-hydrant-head-sn65',
  'wet-alarm-check-valve-zsfz-150',
  'hydraulic-water-level-control-valve-f745x',
  'manual-fire-water-cannon-ps',
  'foam-fire-hydrant-cabinet-psg30',
  'pvc-fire-hose',
];
const categoryNames: string[] = [...new Set(productsId.map((p) => p.category))];
const categories = categoryNames.map((name) => {
  const inCategory = productsId.filter((p) => p.category === name);
  const lead = inCategory.find((p) => CARD_LEAD_SLUGS.includes(p.slug)) ?? inCategory[0];
  return { name, count: String(inCategory.length), image: lead.image };
});

const productionSteps = [
  { step: '01', title: 'Anyaman Presisi', desc: 'Anyaman poliester presisi tinggi untuk lapisan luar selang kebakaran yang tahan lama.', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
  { step: '02', title: 'Perekatan Lapisan', desc: 'Proses vulkanisasi lanjutan untuk lapisan karet dengan penutupan rapat.', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { step: '03', title: 'Permesinan CNC', desc: 'Permesinan presisi untuk bodi katup dari besi ulet dan komponen pendukungnya.', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
  { step: '04', title: 'Uji Keselamatan', desc: 'Uji tekanan bodi dan uji kebocoran udara pada 100% unit.', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { step: '05', title: 'Lapisan Epoksi', desc: 'Lapisan resin epoksi yang tidak beracun untuk ketahanan korosi yang lebih tinggi.', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' }
];

// Entri panduan dan halaman sistem (konten yang memberi bobot pada halaman depan);
// spread dari guidesId memakai sumber data id — daftar ini bertambah seiring terbitnya publikasi id
const publishedGuides = guidesId.filter((g) => isTranslated(stripLocale(g.href, 'id'), 'id'));
const resources = [
  { href: '/id/guides/fire-sprinkler-system-valves-guide/', eyebrow: 'Panduan Pembeli', title: 'Panduan Katup untuk Sistem Sprinkler', desc: 'Grup katup alarm basah, deluge, dan pra-aksi dijelaskan untuk pembeli sistem sprinkler.' },
  { href: '/id/guides/fire-sprinkler-system-wet-dry-preaction/', eyebrow: 'Panduan Pembeli', title: 'Sistem Sprinkler: Basah, Kering, atau Pra-Aksi', desc: 'Bandingkan tipe sistem dan pilih konfigurasi yang tepat untuk profil risiko gedung Anda.' },
  { href: '/id/fire-water-cannon/', eyebrow: 'Tinjauan Sistem', title: 'Meriam Air Kebakaran', desc: 'Monitor manual seri PS dan meriam air dengan pelacakan otomatis ZDMS untuk pemadaman kebakaran di area luas.' },
  { href: '/id/guides/how-to-choose-a-fire-hydrant/', eyebrow: 'Panduan Pembeli', title: 'Cara Memilih Hidran Kebakaran', desc: 'Tipe hidran, kelas tekanan, standar koneksi, dan daftar periksa pembelian langsung dari pabrik.' },
  { href: '/id/guides/how-to-choose-ul-listed-fire-valves/', eyebrow: 'Panduan Pembeli', title: 'Cara Memilih Katup Kebakaran Terdaftar UL', desc: 'Apa arti sebenarnya dari pendaftaran UL, UL vs FM, dan cara memverifikasi keaslian sertifikat.' },
  { href: '/id/guides/gate-valve-vs-butterfly-valve-fire-protection/', eyebrow: 'Panduan Pembeli', title: 'Katup Gerbang vs Katup Kupu-kupu', desc: 'Perbandingan aliran, ruang, biaya, dan aplikasi untuk jaringan kebakaran dan lini cabang sprinkler.' },
  ...publishedGuides.map(g => ({
    href: g.href,
    eyebrow: 'Panduan Pembeli',
    title: g.title,
    desc: g.description
  }))
];

// Bukti proyek di lapangan: ruang pompa kebakaran yang telah terpasang (foto + video vertikal tur lokasi)
const projectPhotos = [
  { src: '/assets/projects/pump-skids.webp', alt: 'Deretan unit pompa kebakaran dengan penanda posisi OPEN dan CLOSE di ruang pompa yang telah dipasang', caption: 'Unit pompa di atas rangka dengan penanda posisi OPEN/CLOSE' },
  { src: '/assets/projects/valve-train.webp', alt: 'Deretan katup gerbang dan manometer pada pipa tegak merah di ruang pompa yang telah dipasang', caption: 'Pipa tegak dan deretan katup gerbang' },
  { src: '/assets/projects/riser-grid.webp', alt: 'Susunan pipa tegak dengan pipa di bagian atas dan baki kabel di ruang pompa', caption: 'Susunan pipa tegak dan pipa di bagian atas' },
  { src: '/assets/projects/pump-room-final.webp', alt: 'Ruang pompa kebakaran yang telah dipasang, siap untuk inspeksi dan serah terima', caption: 'Ruang pompa siap untuk serah terima' }
];

const projectScope = [
  'Berbagai unit pompa sprinkler dan kebakaran dipasang di atas dudukan beton',
  'Susunan pipa tegak lengkap dengan katup gerbang, manometer, dan penanda posisi OPEN/CLOSE',
  'Pipa di bagian atas dan baki kabel diletakkan sepanjang susunan pipa tegak',
  'Lokasi disiapkan untuk inspeksi akhir dan serah terima'
];

const industries = [
  { name: 'Minyak dan Gas', desc: 'Pengaliran fluida yang aman dalam kondisi industri yang ekstrem', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { name: 'Pengolahan Air', desc: 'Jaringan penyediaan air bersih kota, drainase, dan filtrasi', icon: 'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3' },
  { name: 'Proteksi Kebakaran', desc: 'Hidran bersertifikat, katup sprinkler, dan sistem pemadaman', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' }
];
---

<Layout
  locale="id"
  title="Wanlian Fluid | Pabrik Katup dan Proteksi Kebakaran"
  description="Produsen katup industri dan peralatan proteksi kebakaran di Quanzhou, China. Pabrik sendiri, ISO 9001, permesinan CNC, dan penawaran dalam 12 jam."
  faq={faq}
  breadcrumbs={[{ name: 'Beranda', href: '/id/' }]}
  video={{ name: 'Wanlian Fluid dalam 50 Detik', description: 'Video pengenalan perusahaan: ruang pamer, lini produksi, kustomisasi OEM, dan pengendalian mutu di pabrik Quanzhou.', thumbnail: '/videos/company-intro-poster.webp', src: '/videos/company-intro.mp4', duration: 'PT49S', uploadDate: '2026-09-18' }}
>
  <!-- Bagian Hero dengan Estetika Diagonal -->
  <section class="relative bg-gray-900 text-white min-h-[85vh] flex items-center overflow-hidden">
    <!-- Latar produk sinematik dengan efek Ken Burns lambat; gradien menjaga teks tetap terbaca dan logo di dalamnya tetap halus -->
    <div class="absolute inset-0 z-0" aria-hidden="true">
      <img src="/og-image.jpg" alt="" fetchpriority="high" class="w-full h-full object-cover object-center opacity-90 hero-kenburns" />
      <div class="absolute inset-0 bg-gradient-to-r from-gray-950 via-gray-950/75 to-gray-950/15"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-gray-950 to-transparent"></div>
    </div>

    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-24">
      <div class="max-w-3xl space-y-6 sm:space-y-8">
        <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full border border-white/20">
          <span class="flex h-2 w-2 rounded-full bg-brand-red animate-pulse"></span>
          <span class="text-sm font-bold tracking-widest uppercase">Produsen &amp; Eksportir — Katup &amp; Proteksi Kebakaran</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-black tracking-tight leading-[1.15]">
          Katup dan Proteksi Kebakaran <br/>
          <span class="text-brand-red">untuk Proyek Global.</span>
        </h1>

        <p class="text-lg sm:text-xl text-gray-300 max-w-2xl leading-relaxed">
          Katup industri, hidran kebakaran, serta sistem katup sprinkler dan alarm — 100% uji tekanan, ISO 9001, penawaran terperinci dalam waktu hingga 12 jam.
        </p>

        <div class="flex flex-wrap gap-4 pt-4">
          <a href="/id/products/" class="px-8 py-4 bg-brand-red hover:opacity-90 text-white font-bold rounded-lg transition shadow-xl shadow-brand-red/20 transform hover:-translate-y-1">
            Lihat Katalog
          </a>
          <a href="/id/contact/#inquiry" class="px-8 py-4 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white font-bold rounded-lg border border-white/30 transition">
            Minta Penawaran
          </a>
        </div>
      </div>
    </div>
  </section>

  <VideoCarousel locale="id" />

  <!-- Deretan Sertifikasi -->
  <div class="bg-gray-100 py-8 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-50 grayscale hover:grayscale-0 transition duration-500">
        <span class="text-gray-900 font-black text-xl tracking-tighter">DATA TEKNIS</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">GAMBAR PRODUK</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">OPSI MATERIAL</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">KELAS TEKANAN</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">OEM / ODM</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">DUKUNGAN EKSPOR</span>
      </div>
    </div>
  </div>

  <!-- Tentang Kami: Kekuatan Pabrik -->
  <section class="py-24 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="flex-1 space-y-8">
          <div class="space-y-4">
            <h2 class="text-sm font-black tracking-[0.3em] text-brand-red uppercase flex items-center gap-2">
              <span class="w-8 h-[2px] bg-brand-red"></span>
              Profil Perusahaan
            </h2>
            <h3 class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight leading-tight">
              Solusi Pengendalian Fluida <br/><span class="text-brand-blue">untuk Proyek Global.</span>
            </h3>
          </div>

          <div class="space-y-6 text-gray-600 text-lg leading-relaxed">
            <p>
              Berbasis di Quanzhou, Fujian — pusat utama industri perpipaan dan katup di Tiongkok — Quanzhou Wanlian Fluid Equipment Co., Ltd. memproduksi dan mengekspor katup industri, produk pengendalian hidrolik, komponen hidran, serta peralatan proteksi kebakaran untuk proyek B2B internasional. Produksi dikerjakan pada lini produksi kami sendiri di Quanzhou, dengan sejumlah item dikerjakan oleh mitra manufaktur yang memenuhi kualifikasi; bodi katup diproses dengan permesinan CNC dan setiap unit menjalani uji tekanan bodi serta uji kebocoran udara sebelum pengiriman, di bawah sistem manajemen mutu ISO 9001.
            </p>
            <p>
              Kami menyusun setiap halaman produk di sekitar spesifikasi yang benar-benar dipakai pembeli — kelas tekanan, standar koneksi, material bodi dan komponen internal, serta aplikasi — dengan penawaran berdasarkan permintaan dan dukungan teknik untuk penyediaan air bersih, pengendalian fluida industri, serta sistem pemadaman kebakaran.
            </p>
          </div>

          <!-- Kartu Metrik: angka menonjol (semua dapat diverifikasi langsung di situs ini) -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 pt-4">
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-red tabular-nums">{productsId.length}+</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Model Tersedia</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-blue tabular-nums">{categories.length}</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Lini Produk</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-red tabular-nums">100%</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Uji Tekanan</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-blue tabular-nums">ISO 9001</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Sistem Mutu</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-3 pt-2">
            <span class="px-4 py-2 bg-brand-red/5 border border-brand-red/20 text-brand-red text-xs font-black uppercase tracking-widest rounded-full">P&amp;D · Penjualan · Layanan</span>
            <span class="px-4 py-2 bg-brand-blue/5 border border-brand-blue/20 text-brand-blue text-xs font-black uppercase tracking-widest rounded-full">Bersertifikat ISO 9001</span>
            <span class="px-4 py-2 bg-gray-100 border border-gray-200 text-gray-700 text-xs font-black uppercase tracking-widest rounded-full">OEM · ODM · Sesuai Pesanan</span>
          </div>

          <a href="/id/about/" class="inline-flex items-center gap-2 font-bold text-brand-blue hover:underline pt-2">
            Baca Profil Perusahaan Lengkap <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="flex-1 relative">
          <div class="absolute -top-10 -left-10 w-40 h-40 bg-blue-100 rounded-full blur-3xl opacity-50 z-0"></div>
          <CompanyIntroVideo locale="id" />
        </div>
      </div>
    </div>
  </section>

  <!-- Mengapa Memilih Kami: tiga keunggulan (setiap klaim dapat diverifikasi langsung di situs ini: proses/sertifikasi/FAQ 12 jam) -->
  <section class="py-24 bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
        <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Mengapa Memilih Kami</h2>
        <h3 class="text-4xl font-black text-gray-900 tracking-tight">Mengapa Memilih <span class="text-brand-red">Wanlian</span></h3>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-8 rounded-2xl border border-gray-200 bg-gray-50 hover:shadow-lg transition-shadow duration-300">
          <div class="w-12 h-12 rounded-lg bg-brand-red/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h4 class="text-lg font-black text-gray-900 mb-2">Lini Produksi Kami Sendiri</h4>
          <p class="text-gray-600 text-sm leading-relaxed">Permesinan CNC, perakitan, pengujian tekanan, dan pelapisan dikerjakan pada lini produksi kami sendiri di kawasan industri Quanzhou, dengan tambahan kapasitas dari mitra terkualifikasi untuk lonjakan pesanan.</p>
        </div>
        <div class="p-8 rounded-2xl border border-gray-200 bg-gray-50 hover:shadow-lg transition-shadow duration-300">
          <div class="w-12 h-12 rounded-lg bg-brand-red/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h4 class="text-lg font-black text-gray-900 mb-2">Bersertifikat, Diuji per Lote</h4>
          <p class="text-gray-600 text-sm leading-relaxed">Sistem manajemen mutu ISO 9001:2015, produk terdaftar dan diakui UL, serta uji tekanan pada bodi dan dudukan untuk 100% unit sesuai GB/T13927 / EN 12266-1 sebelum pengemasan.</p>
        </div>
        <div class="p-8 rounded-2xl border border-gray-200 bg-gray-50 hover:shadow-lg transition-shadow duration-300">
          <div class="w-12 h-12 rounded-lg bg-brand-red/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h4 class="text-lg font-black text-gray-900 mb-2">Penawaran Rinci dalam 12 Jam</h4>
