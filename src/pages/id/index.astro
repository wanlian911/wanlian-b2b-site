            <h4 class="text-xl font-black text-gray-900 mb-3 group-hover:text-brand-blue transition-colors leading-snug">{item.title}</h4>
            <p class="text-sm text-gray-600 leading-relaxed mb-6">{item.desc}</p>
            <span class="inline-flex items-center gap-2 text-sm font-bold text-brand-red group-hover:gap-3 transition-all">
              Baca Sumber Daya
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <!-- Cenários de Indústria -->
  <section class="py-24 bg-gray-900 text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="flex-1 space-y-8">
          <div class="space-y-4">
            <h2 class="text-4xl font-black tracking-tight leading-tight">Dirancang untuk <br/><span class="text-brand-blue">Layanan Tekanan Tinggi.</span></h2>
            <p class="text-gray-400">
              Nossa teknik foca em ketahanan e keandalan em infraestruturas perigosas e críticas.
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <a href="/id/certificates/" class="px-7 py-3 bg-white/10 hover:bg-white/20 backdrop-blur-sm font-bold rounded-lg border border-white/30 transition">
              Lihat Sertifikasi &amp; Spesifikasi
            </a>
          </div>
        </div>

        <div class="flex-1 grid grid-cols-1 gap-4 w-full">
          {industries.map(industry => (
            <div class="flex items-start gap-5 p-6 bg-white/5 backdrop-blur-sm rounded-2xl border border-white/10">
              <div class="w-12 h-12 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={industry.icon} />
                </svg>
              </div>
              <div>
                <h4 class="font-black text-lg">{industry.name}</h4>
                <p class="text-sm text-gray-400 mt-1 leading-relaxed">{industry.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Seção de Consulta Rápida -->
  <section id="inquiry" class="py-24 bg-white scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row gap-14 lg:gap-20">
        <div class="w-full lg:w-2/5 space-y-6">
