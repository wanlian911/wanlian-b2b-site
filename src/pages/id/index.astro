    .c68-inlink { color: var(--red); font-weight: 700; font-size: 14px; text-decoration: none; }
    .c68-rfq-grid h2 { font-size: clamp(28px, 4vw, 44px); line-height: 1.08; font-weight: 800; text-transform: uppercase; margin: 0; color: #fff; }

