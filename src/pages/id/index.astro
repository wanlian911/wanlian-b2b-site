---
import Layout from '../../layouts/Layout.astro';
import { productsId as products } from '../../utils/products.id';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';
import LeadCaptureSection from '../../components/inquiry/LeadCaptureSection.astro';

const faq = [
  {
    question: 'Apa saja yang diproduksi dan diekspor oleh Wanlian Fluid?',
    answer: 'Wanlian Fluid adalah produsen dan eksportir berbasis di Quanzhou untuk katup industri dan peralatan proteksi kebakaran: katup gerbang dudukan karet dan dudukan logam, katup kupu-kupu serta katup searah, hidran kebakaran dan komponen hidran, katup sprinkler dan katup alarm, serta selang kebakaran berlapis karet — enam lini produk dengan lebih dari 43 model dalam stok.'
  },
  {
    question: 'Bagaimana saya memperoleh harga untuk sebuah katup atau hidran?',
    answer: 'Harga ditentukan berdasarkan permintaan. Kirimkan spesifikasi Anda — model atau standar, ukuran, kelas tekanan, material, jumlah, dan tujuan pengiriman — tim kami akan merespons dengan penawaran terperinci dalam waktu hingga 12 jam.'
  },
  {
    question: 'Apakah setiap unit diuji sebelum pengiriman?',
    answer: 'Ya. Setiap katup, hidran, dan selang menjalani uji tekanan bodi dan uji kebocoran udara sebelum pengiriman, dengan catatan per unit. Produksi berjalan di bawah sistem manajemen mutu ISO 9001.'
  },
  {
    question: 'Apakah Anda melayani pesanan OEM atau private label?',
    answer: 'Ya. OEM/ODM, merek sendiri, dan kemasan ekspor adalah layanan standar. Kesesuaian dengan standar tertentu (misalnya AWWA C502, terdaftar UL, atau persetujuan FM) dikonfirmasi per model, disertai laporan pengujian dan sertifikat sebelum pesanan diproses.'
  }
];

// Category grid and the grouped catalog index are both derived from this locale's product
// module, so line names, counts and card photography cannot drift from the live catalog.
// is keyed by English category names, so it stays empty and each line uses its first photo.
const CATEGORY_LEAD: Record<string, string> = {};

const categoryNames: string[] = [...new Set(products.map(p => p.category))];

const categories = categoryNames.map(name => {
  const inCategory = products.filter(p => p.category === name);
  const lead = inCategory.find(p => p.slug === CATEGORY_LEAD[name]) ?? inCategory[0];
  return { name, count: inCategory.length, image: lead.image, leadName: lead.name, href: `/id/products/#category=${encodeURIComponent(name)}` };
});

const catalogByCategory = categoryNames.map(name => ({
  name,
  href: `/id/products/#category=${encodeURIComponent(name)}`,
  items: products.filter(p => p.category === name).map(p => ({ name: p.name, href: '/id/products/' + p.slug + '/' }))
}));

const productionSteps = [{"step":"01","title":"Anyaman Presisi","desc":"Anyaman poliester presisi tinggi untuk lapisan luar selang kebakaran yang tahan lama."},{"step":"02","title":"Perekatan Lapisan","desc":"Proses vulkanisasi lanjutan untuk lapisan karet dengan penutupan rapat."},{"step":"03","title":"Permesinan CNC","desc":"Permesinan presisi untuk bodi katup dari besi ulet dan komponen pendukungnya."},{"step":"04","title":"Uji Keselamatan","desc":"Uji tekanan bodi dan uji kebocoran udara pada 100% unit."},{"step":"05","title":"Lapisan Epoksi","desc":"Lapisan resin epoksi yang tidak beracun untuk ketahanan korosi yang lebih tinggi."}];



// Own-name assurance only. Third-party listings belong to the factory that holds them, so this
// strip must never imply that Wanlian itself holds UL, FM, CE or LPCB listings.
const certifications = [];

const waCallbackHref = `https://wa.me/8618684324501?text=${encodeURIComponent('Halo, saya tertarik dengan katup industri dan peralatan pemadam kebakaran Anda. Mohon kirimkan katalog produk dan daftar harga.')}`;

const resources = [{"href":"/id/guides/fire-sprinkler-system-valves-guide/","eyebrow":"Panduan Pembeli","title":"Panduan Katup untuk Sistem Sprinkler","desc":"Grup katup alarm basah, deluge, dan pra-aksi dijelaskan untuk pembeli sistem sprinkler."},{"href":"/id/guides/fire-sprinkler-system-wet-dry-preaction/","eyebrow":"Panduan Pembeli","title":"Sistem Sprinkler: Basah, Kering, atau Pra-Aksi","desc":"Bandingkan tipe sistem dan pilih konfigurasi yang tepat untuk profil risiko gedung Anda."},{"href":"/id/fire-water-cannon/","eyebrow":"Tinjauan Sistem","title":"Meriam Air Kebakaran","desc":"Monitor manual seri PS dan meriam air dengan pelacakan otomatis ZDMS untuk pemadaman kebakaran di area luas."},{"href":"/id/guides/how-to-choose-a-fire-hydrant/","eyebrow":"Panduan Pembeli","title":"Cara Memilih Hidran Kebakaran","desc":"Tipe hidran, kelas tekanan, standar koneksi, dan daftar periksa pembelian langsung dari pabrik."},{"href":"/id/guides/how-to-choose-ul-listed-fire-valves/","eyebrow":"Panduan Pembeli","title":"Cara Memilih Katup Kebakaran Terdaftar UL","desc":"Apa arti sebenarnya dari pendaftaran UL, UL vs FM, dan cara memverifikasi keaslian sertifikat."},{"href":"/id/guides/gate-valve-vs-butterfly-valve-fire-protection/","eyebrow":"Panduan Pembeli","title":"Katup Gerbang vs Katup Kupu-kupu","desc":"Perbandingan aliran, ruang, biaya, dan aplikasi untuk jaringan kebakaran dan lini cabang sprinkler."}];

// On-site project evidence: real fire pump room installation (photos + portrait walkthrough video)
const projectPhotos = [
  { src: '/assets/projects/pump-skids.webp', alt: 'Deretan unit pompa kebakaran dengan penanda posisi OPEN dan CLOSE di ruang pompa yang telah dipasang', caption: 'Unit pompa di atas rangka dengan penanda posisi OPEN/CLOSE' },
  { src: '/assets/projects/valve-train.webp', alt: 'Deretan katup gerbang dan manometer pada pipa tegak merah di ruang pompa yang telah dipasang', caption: 'Pipa tegak dan deretan katup gerbang' },
  { src: '/assets/projects/riser-grid.webp', alt: 'Susunan pipa tegak dengan pipa di bagian atas dan baki kabel di ruang pompa', caption: 'Susunan pipa tegak dan pipa di bagian atas' },
  { src: '/assets/projects/pump-room-final.webp', alt: 'Ruang pompa kebakaran yang telah dipasang, siap untuk inspeksi dan serah terima', caption: 'Ruang pompa siap untuk serah terima' }
];

const projectScope = [
  'Berbagai unit pompa sprinkler dan kebakaran dipasang di atas dudukan beton',
  'Susunan pipa tegak lengkap dengan katup gerbang, manometer, dan penanda posisi OPEN/CLOSE',
  'Pipa di bagian atas dan baki kabel diletakkan sepanjang susunan pipa tegak',
  'Lokasi disiapkan untuk inspeksi akhir dan serah terima'
];

const industries = [{"name":"Minyak dan Gas","desc":"Pengaliran fluida yang aman dalam kondisi industri yang ekstrem","icon":"pipe"},{"name":"Pengolahan Air","desc":"Jaringan penyediaan air bersih kota, drainase, dan filtrasi","icon":"drop"},{"name":"Proteksi Kebakaran","desc":"Hidran bersertifikat, katup sprinkler, dan sistem pemadaman","icon":"flame"}];

type Clip = { src: string; poster: string; title: string; desc: string };

const clips = [{"src":"/videos/factory/assembly.mp4","poster":"/videos/factory/assembly-poster.webp","title":"Perakitan","desc":"Pemeriksaan torsi pada sambungan katup kontrol hidrolik"},{"src":"/videos/factory/blue-valves.mp4","poster":"/videos/factory/blue-valves-poster.webp","title":"Uji Tekanan","desc":"Unit yang telah lulus uji tekanan siap untuk pengiriman"},{"src":"/videos/factory/red-field.mp4","poster":"/videos/factory/red-field-poster.webp","title":"Gudang Barang Jadi","desc":"Hidran pemadam yang telah selesai diproduksi siap dikirim"},{"src":"/videos/factory/loading-close.mp4","poster":"/videos/factory/loading-close-poster.webp","title":"Pengepakan & Pemuatan","desc":"Pesanan ekspor di dok muat, dikemas dalam peti kayu dan dipalet"},{"src":"/videos/factory/dispatch.mp4","poster":"/videos/factory/dispatch-poster.webp","title":"Pengiriman","desc":"Truk bermuatan penuh meninggalkan pabrik menuju pelabuhan laut"}];

const walkthroughClip = {"src":"/assets/projects/project-walkthrough.mp4","poster":"/assets/projects/pump-room-wide.webp","title":"Video di Lokasi"};

const stats = [
  { value: String(products.length), unit: '', label: "Model Tersedia" },
  { value: String(categories.length), unit: '', label: "Lini Produk" },
  { value: '100', unit: '%', label: "Uji Tekanan" },
  { value: 'ISO 9001', unit: '', label: "Sistem Mutu" }
];

const capability = [{"icon":"valve","title":"Lini Produksi Kami Sendiri","body":"Permesinan CNC, perakitan, pengujian tekanan, dan pelapisan dikerjakan pada lini produksi kami sendiri di kawasan industri Quanzhou, dengan tambahan kapasitas dari mitra terkualifikasi untuk lonjakan pesanan."},{"icon":"gauge","title":"Penawaran Rinci dalam 12 Jam","body":"Kirimkan gambar, spesifikasi, atau cukup sebuah foto — tim insinyur kami membalas dengan penawaran terperinci, status stok, dan waktu produksi dalam waktu hingga 12 jam, 7 hari dalam seminggu."},{"icon":"doc","title":"Bersertifikat, Diuji per Lote","body":"Setiap unit melewati urutan terkendali yang sama — mulai dari pengecoran dan permesinan CNC, uji tekanan 100%, hingga pelapisan epoksi."}];

const svgOpen = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">';
const icons: Record<string, string> = {
  valve: svgOpen + '<path d="M4 16 12 9l8 7H4Z"/><path d="M12 9V4"/><path d="M8.5 4h7"/></svg>',
  gauge: svgOpen + '<circle cx="12" cy="10" r="6"/><path d="M12 10l3.2-2.6"/><path d="M6 20h12"/></svg>',
  cog: svgOpen + '<circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.4M12 18.6V21M3 12h2.4M18.6 12H21M5.6 5.6l1.7 1.7M16.7 16.7l1.7 1.7M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7"/></svg>',
  doc: svgOpen + '<path d="M7 3h7l4 4v14H7V3Z"/><path d="M14 3v4h4"/><path d="M10 12h6M10 16h6"/></svg>',
  flame: svgOpen + '<path d="M12 3c3 4 5 6 5 9a5 5 0 0 1-10 0c0-2.2 1.1-3.8 2.6-5.2"/></svg>',
  drop: svgOpen + '<path d="M12 3l5.4 7a6.4 6.4 0 1 1-10.8 0L12 3Z"/></svg>',
  pipe: svgOpen + '<path d="M3 8.5h7v7H3zM14 8.5h7v7h-7z"/><path d="M10 12h4"/><path d="M3 8.5v7M21 8.5v7"/></svg>',
  guide: svgOpen + '<path d="M4 5h7v15H4zM13 5h7v15h-7z"/><path d="M7 9h1M16 9h1"/></svg>',
  chat: svgOpen + '<path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9h8M8 12h5"/></svg>'
};
const tick = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9 17.5 20 6.5"/></svg>';
---

<Layout
  locale="id"
  title="Wanlian Fluid | Pabrik Katup dan Proteksi Kebakaran"
  description="Produsen katup industri dan peralatan proteksi kebakaran di Quanzhou, China. Pabrik sendiri, ISO 9001, permesinan CNC, dan penawaran dalam 12 jam."
  faq={faq}
  video={{ name: 'Wanlian Fluid dalam 50 Detik', description: 'Video pengenalan perusahaan: ruang pamer, lini produksi, kustomisasi OEM, dan pengendalian mutu di pabrik Quanzhou.', thumbnail: '/videos/company-intro-poster.webp', src: '/videos/company-intro.mp4', duration: 'PT49S', uploadDate: '2026-09-18' }}
>
  <div class="c68">

    <section class="c68-hero">
      <div class="c68-wrap c68-hero-grid">
        <div class="c68-rv">
          <p class="c68-eyebrow"><span class="c68-dot"></span>Produsen &amp; Eksportir — Katup &amp; Proteksi Kebakaran</p>
          <h1>Katup dan Proteksi Kebakaran <em>untuk Proyek Global.</em></h1>
          <p class="c68-rule" aria-hidden="true"></p>
          <p class="c68-lede">Katup industri, hidran kebakaran, serta sistem katup sprinkler dan alarm — 100% uji tekanan, ISO 9001, penawaran terperinci dalam waktu hingga 12 jam.</p>
          <div class="c68-cta">
            <a class="c68-btn c68-btn-red" href="/id/products/">Lihat Katalog</a>
            <a class="c68-btn c68-btn-ghost" href="/id/contact/#inquiry">Minta Penawaran</a>
          </div>
        </div>
        <figure class="c68-frame c68-rv">
          <span class="c68-frame-tab"></span>
          <img src="/assets/factory/plant-exterior.webp" alt="Gedung pabrik Wanlian Fluid di Quanzhou, Fujian" decoding="async" />
          <figcaption>Rekaman Nyata dari Fasilitas Produksi Kami</figcaption>
        </figure>
      </div>
      <div class="c68-stats">
        <div class="c68-wrap c68-stats-grid">
          {stats.map((s) => (
            <div class="c68-stat">
              <p class="c68-stat-num">{s.value}<span>{s.unit}</span></p>
              <p class="c68-stat-label">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="product-lines">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Kategori Produk Utama</p>
          <h2>Rekayasa presisi tinggi untuk jaringan kebakaran dan jaringan air di seluruh dunia.</h2>
        </header>
        <div class="c68-lines">
          {categories.map((c) => (
            <a class="c68-line c68-rv" href={c.href}>
              <span class="c68-line-media"><img src={c.image} alt={c.leadName} loading="lazy" decoding="async" /></span>
              <span class="c68-line-body">
                <span class="c68-line-count">{c.count}</span>
                <span class="c68-line-name">{c.name}</span>
                <span class="c68-line-more">Buka Lini Ini <i aria-hidden="true">&rarr;</i></span>
              </span>
            </a>
          ))}
          <a class="c68-line c68-line-full c68-rv" href="/id/products/">
            <span class="c68-line-body">
              <span class="c68-line-count">Katalog Lengkap →</span>
              <span class="c68-line-name c68-line-name-inv">{products.length}</span>
              <span class="c68-line-more c68-line-more-inv">Semua Produk →</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="c68-band">
      <div class="c68-wrap">
        <div class="c68-cap-grid">
          {capability.map((c) => (
            <article class="c68-cap c68-rv">
              <span class="c68-ico" set:html={icons[c.icon]}></span>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="about">
      <div class="c68-wrap c68-profile-grid">
        <div class="c68-rv">
          <header class="c68-head">
            <p class="c68-kicker">Tentang Kami</p>
            <h2>Solusi Pengendalian Fluida <em>untuk Proyek Global.</em></h2>
          </header>
          <p class="c68-body">Berbasis di Quanzhou, Fujian — pusat utama industri perpipaan dan katup di Tiongkok — Quanzhou Wanlian Fluid Equipment Co., Ltd. memproduksi dan mengekspor katup industri, produk pengendalian hidrolik, komponen hidran, serta peralatan proteksi kebakaran untuk proyek B2B internasional. Produksi dikerjakan pada lini produksi kami sendiri di Quanzhou, dengan sejumlah item dikerjakan oleh mitra manufaktur yang memenuhi kualifikasi; bodi katup diproses dengan permesinan CNC dan setiap unit menjalani uji tekanan bodi serta uji kebocoran udara sebelum pengiriman, di bawah sistem manajemen mutu ISO 9001.</p>
          <p class="c68-profile-link"><a href="/id/about/">Tentang Kami &rarr;</a><a href="/id/applications/">Aplikasi &rarr;</a></p>
        </div>
        <div class="c68-shots">
          <figure class="c68-shot c68-rv">
            <img src="/assets/factory/workshop.webp" alt="Area produksi utama di pabrik Quanzhou" loading="lazy" decoding="async" />
            <figcaption>Area Produksi</figcaption>
          </figure>
          <figure class="c68-shot c68-rv">
            <img src="/assets/factory/powder-coating.webp" alt="Lini lapisan serbuk di pabrik Quanzhou" loading="lazy" decoding="async" />
            <figcaption>Lapisan Serbuk</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="c68-band" id="process">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Alur Produksi</p>
          <h2>Proses Manufaktur Kami</h2>
        </header>
        <ol class="c68-steps">
          {productionSteps.map((s) => (
            <li class="c68-step c68-rv">
              <span class="c68-step-n">{s.step}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="c68-band c68-dark" id="factory">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker c68-kicker-red">Langsung Dari Pabrik</p>
          <h2>Rekaman Nyata dari Fasilitas <em>Produksi Kami</em></h2>
          <p class="c68-head-sub">Bukan video stok, bukan rekayasa — fasilitas Quanzhou kami sedang beroperasi, mulai dari perakitan hingga pengiriman.</p>
        </header>
        <div class="c68-video-lead">
          <figure class="c68-vid c68-rv">
            <video src="/videos/company-intro.mp4" poster="/videos/company-intro-poster.webp" controls playsinline preload="none"></video>
            <figcaption><strong>Wanlian Fluid dalam 50 Detik</strong><span>Ruang pamer, lini produksi mandiri, dan inspeksi kualitas di pabrik Quanzhou kami — rekaman nyata, tanpa video stok.</span></figcaption>
          </figure>
          <div class="c68-side">
            <ul class="c68-video-note">
              <li>Inspeksi pihak ketiga sebelum pengiriman, sesuai permintaan Anda.</li>
              <li>Putar Video Perusahaan</li>
              <li>Lihat Sertifikasi &amp; Spesifikasi</li>
            </ul>
            <div class="c68-side-shots">
              <figure class="c68-sshot c68-rv">
                <img src="/assets/factory/assembly.webp" alt="Assembly and finishing bay" loading="lazy" decoding="async" style="aspect-ratio: 5 / 2" />
                <figcaption>Perakitan</figcaption>
              </figure>
              <figure class="c68-sshot c68-rv">
                <img src="/assets/factory/fire-hose.webp" alt="Gudang Barang Jadi" loading="lazy" decoding="async" style="aspect-ratio: 5 / 2" />
                <figcaption>Gudang Barang Jadi</figcaption>
              </figure>
            </div>
          </div>
        </div>
        <div class="c68-clips">
          {clips.map((c) => (
            <figure class="c68-clip c68-rv">
              <video src={c.src} poster={c.poster} controls playsinline preload="none"></video>
              <figcaption><strong>{c.title}</strong><span>{c.desc}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Solusi Sistem</p>
          <h2>Dirancang untuk <em>Layanan Tekanan Tinggi.</em></h2>
          <p class="c68-head-sub"><a class="c68-inlink" href="/id/applications/">Aplikasi &rarr;</a></p>
        </header>
        <div class="c68-ind">
          {industries.map((i) => (
            <a class="c68-ind-card c68-rv" href="/id/applications/">
              <span class="c68-ico" set:html={icons[i.icon]}></span>
              <h3>{i.name}</h3>
              <p>{i.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band" id="quality">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Mengapa Memilih Kami</p>
          <h2>Mengapa Memilih <em>Wanlian</em></h2>
        </header>
        <div class="c68-cert-grid">
          {certifications.map((c) => (
            <div class="c68-cert c68-rv">
              <p class="c68-cert-name">{c.name}</p>
              <p class="c68-cert-code">{c.code}</p>
            </div>
          ))}
        </div>
        <p class="c68-scope">Ya. OEM/ODM, merek sendiri, dan kemasan ekspor adalah layanan standar. Kesesuaian dengan standar tertentu (misalnya AWWA C502, terdaftar UL, atau persetujuan FM) dikonfirmasi per model, disertai laporan pengujian dan sertifikat sebelum pesanan diproses.</p>
        <div class="c68-chips">
          <a class="c68-chip c68-chip-link" href="/id/certificates/">Sertifikasi &rarr;</a>
          <a class="c68-chip c68-chip-link" href="/id/faq/">Pertanyaan Umum (FAQ) &rarr;</a>
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="resources">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Sumber Daya Teknis</p>
          <h2>Panduan Seleksi &amp; Ikhtisar Sistem</h2>
          <p class="c68-head-sub">Lembar data teknis memang berguna, tetapi konteks teknisnya lebih berguna lagi. Bacalah sebelum menentukan spesifikasi.</p>
        </header>
        <div class="c68-guides">
          {resources.map((r) => (
            <a class="c68-guide c68-rv" href={r.href}>
              <span class="c68-guide-eyebrow">{r.eyebrow}</span>
              <span class="c68-guide-title">{r.title}</span>
              <span class="c68-guide-desc">{r.desc}</span>
              <span class="c68-guide-more">Baca Sumber Daya <i aria-hidden="true">&rarr;</i></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band" id="projects">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Studi Kasus Proyek</p>
          <h2>Proyek Kami, <em>di Lokasi</em></h2>
          <p class="c68-head-sub">Foto dan video dari proyek ruang pompa kebakaran — pemasangan nyata, siap untuk serah terima.</p>
        </header>
        <div class="c68-proj-grid">
          <figure class="c68-vid c68-vid-tall c68-rv">
            <video src={walkthroughClip.src} poster={walkthroughClip.poster} controls playsinline preload="none"></video>
            <figcaption><strong>{walkthroughClip.title}</strong></figcaption>
          </figure>
          <div class="c68-proj-cards">
            {projectPhotos.map((s) => (
              <figure class="c68-pcard c68-rv">
                <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
                <figcaption>{s.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
        <ul class="c68-scope-list">
          {projectScope.map((s) => (<li set:html={tick + '<span>' + s + '</span>'}></li>))}
        </ul>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="model-index">
      <div class="c68-wrap">
