---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Apa a diferença entre um dispositivo anti-retorno e uma válvula de retenção?',
		answer: 'Uma válvula de retenção padrão impede mecanicamente o fluxo reverso, mas não é testada para vazamentos e não possui dreno intermediário. Um dispositivo anti-retorno como o HS41X combina duas retenções independentes com uma câmara de dreno otomatis intermediário, é testável in loco e atende aos requisitos de controle de conexões cruzadas para a proteção da air minum. Katup de retenção sozinhas não são aceitas em conexões cruzadas de air minum.'
	},
	{
		question: 'Di mana o dispositivo anti-retorno deve ser instalado na conexão de serviço proteksi kebakaran?',
		answer: 'Na conexão de serviço proteksi kebakaran à rede de air minum, a montante da sucção da bomba proteksi kebakaran ou do montante do sistem. Deve ser acessível para testes, protegido contra congelamento, e Anda perda de carga incluída no cálculo hidráulico da bomba proteksi kebakaran. Para sistems em prédios altos, confirme que a classificação do dispositivo corresponde à tekanan estática máxima do abastecimento.'
	},
	{
		question: 'Katup de controle hidráulico precisam de eletricidade para operar?',
		answer: 'A maioria das katup de controle hidráulico — a válvula redutora de tekanan 500X, a válvula de controle de level F745X e o dispositivo anti-retorno HS41X — é totalmente autoperada pela tekanan da tubulação e não requer alimentação externa. Models com controle por solenoide, como o GKZF-1, usam AC220V ou DC24V para automação remota.'
	},
	{
		question: 'Apa saja materiais são usados em aplicações de air minum?',
		answer: 'Para redes de air de beber, o dispositivo anti-retorno HS41X usa corpo em ferro fundido dúctil com vedação EPDM e componentes internos em aço inox 304, sesuai os requisitos sanitários GB/T17219. Confirme o certificado sanitário para o Anda mercado — kami engenheiros fornecem o pacote de documentação com o pedido.'
	},
	{
		question: 'Apakah Anda fornecem o pacote lengkap de katup hidráulicas para uma sala de bombas?',
		answer: 'Ya. Fabricamos dispositivos anti-retorno, katup redutoras de tekanan, katup de controle de level, katup de controle por solenoide, preventores de vórtice e filtros em Y, e os enviamos como um pacote coordenado — classes de tekanan, selos e laudos de teste correspondentes de uma única fábrica.'
	}
];

const hydraulicProducts = [
	{
		slug: 'anti-pollution-backflow-preventer-hs41x',
		name: 'Dispositivo Anti-Retorno Antipoluição (HS41X-16)',
		img: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		desc: 'Conjunto de dupla retenção com dreno intermediário, DN50–DN600'
	},
	{
		slug: 'adjustable-pressure-reducing-valve-500x',
		name: 'Válvula Redutora de Tekanan Hidráulica (500X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'Controle piloto autoperado, regulagem 0,1–1,6 MPa'
	},
	{
		slug: 'hydraulic-water-level-control-valve-f745x',
		name: 'Válvula de Controle de Level de Água Hidráulica (F745X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'Controle de level por piloto de flutuador para reservatórios e tanques'
	},
	{
		slug: 'groove-solenoid-control-gate-valve-gkzf1',
		name: 'Válvula de Gaveta de Controle por Solenoide (GKZF-1)',
		img: '/assets/products/groove-solenoid-control-gate-valve-gkzf1.jpg',
		desc: 'Válvula ranurada com piloto DC24V/AC220V, classe 300 PSI'
	},
	{
		slug: 'suction-vortex-preventer-en12845',
		name: 'Preventor de Vórtice de Sucção (EN12845)',
		img: '/assets/02_valves_parts/valves_p21.webp',
		desc: 'SS304/316, elimina cavitação da bomba, profundidade de dreno 100mm'
	}
];

const trustBadges = ['Dupla Retenção + Dreno', 'PN10–PN25', 'Sanitário GB/T17219', 'Pilotos Autoperados'];
---

<Layout
	locale="id"
	title="Dispositivos Anti-Retorno & Katup de Kontrol Hidraulik - WLFE"
	description="Dispositivos anti-retorno HS41X, redutores 500X, katup de level F745X e solenoides para air minum e redes de incêndio. DN50-DN600, direto da fábrica."
	type="product"
	productData={{
		name: 'Pencegahan Aliran Balik & Kontrol Hidraulik',
		image: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		description: 'Dispositivos anti-retorno e katup de controle hidráulico para proteção de air minum, gestão de tekanan e redes de air automatizadas, memproduksidos por Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Pencegahan Aliran Balik' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/id/" class="hover:text-blue-600">Beranda</a>
			<span>/</span>
			<a href="/id/products/" class="hover:text-blue-600">Produk</a>
			<span>/</span>
			<span class="text-gray-600">Pencegahan Aliran Balik</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Proteção de Água Potável &amp; Kontrol Hidraulik</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Dispositivos Anti-Retorno &amp; Katup de Kontrol Hidraulik</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">A Wanlian Fluid memproduksi a linha lengkap de segurança hidráulica — dispositivos anti-retorno antipoluição HS41X, katup redutoras de tekanan 500X, katup de controle de level F745X e katup de controle por solenoide GKZF-1 — protegendo redes de air minum e automatizando o controle de tekanan e level em um único pacote coordenado.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Linha de Katup de Segurança Hidráulica</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydraulicProducts.map(p => (
					<a href={`/id/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Spesifikasi Utama</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Válvula</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Fungsi</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Rentang ukuran</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Classe</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">HS41X</td>
							<td class="px-4 py-3 text-gray-700">Prevenção de reflujo antipoluição</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">500X</td>
							<td class="px-4 py-3 text-gray-700">Redução / manutenção de tekanan</td>
							<td class="px-4 py-3 text-gray-700">DN20 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">F745X</td>
							<td class="px-4 py-3 text-gray-700">Controle de level de air</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN400</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">GKZF-1</td>
							<td class="px-4 py-3 text-gray-700">Controle de abertura/fechamento por solenoide</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN300</td>
							<td class="px-4 py-3 text-gray-700">300 PSI, AC220V/DC24V</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Preventor de Vórtice</td>
							<td class="px-4 py-3 text-gray-700">Proteção da sucção da bomba</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN1000</td>
							<td class="px-4 py-3 text-gray-700">EN12845 / GB50974</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplikasi</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Controle de conexões cruzadas de air minum (redes de incêndio, irrigação, caldeiras)</li>
				<li>Controle de level de reservatórios e tanques de cobertura</li>
				<li>Gestão de zonas de tekanan em redes municipais e de edifícios</li>
				<li>Redes de air automatizadas com controle jarak jauh de katup</li>
				<li>Proteção da sucção de bombas em reservatórios e tanques</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Pertanyaan Umum</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Membutuhkan um Pacote de Katup Hidráulicas para a Sua Rede?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envie-nos Anda DN, classe de tekanan e tipo de conexão — kami engenheiros respondem com curvas de perda de carga, datasheets e cotação do pacote em até 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/id/contact/?product=Preven%C3%A7%C3%A3o%20de%20Refluxo%20%26%20Controle%20Hidr%C3%A1ulico" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Minta Penawaran</a>
						<a href="https://wa.me/8618684324501?text=Ol%C3%A1%2C%20preciso%20de%20ajuda%20para%20escolher%20v%C3%A1lvulas%20de%20controle%20hidr%C3%A1ulico" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Hubungi via WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>

