---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Apa perbedaan antara pencegah aliran balik dan katup searah?',
		answer: 'Katup searah biasa mencegah aliran balik secara mekanis, tetapi tidak diuji kebocorannya dan tidak memiliki ruang drain di antaranya. Pencegah aliran balik seperti HS41X menggabungkan dua pemeriksaan independen dengan ruang drain otomatis di tengah, dapat diuji tanpa dibongkar, dan memenuhi persyaratan pengendalian sambung silang untuk perlindungan air minum. Katup searah saja tidak diterima pada sambung silang air minum.'
	},
	{
		question: 'Di mana pencegah aliran balik harus dipasang pada sambungan layanan kebakaran?',
		answer: 'Pada sambungan layanan kebakaran ke pipa induk air minum, di hilir pompa kebakaran atau di ujung riser sistem. Alat harus mudah dijangkau untuk pengujian, terlindung dari pembekuan, dan kehilangan tekanannya diperhitungkan dalam perhitungan hidrolik pompa kebakaran. Untuk sistem gedung tinggi, pastikan rating alat sesuai dengan tekanan statis maksimum pasokan.'
	},
	{
		question: 'Apakah katup kontrol hidrolik memerlukan listrik untuk beroperasi?',
		answer: 'Sebagian besar katup kontrol hidrolik — katup pengatur tekanan 500X, katup kontrol level air F745X, dan pencegah aliran balik HS41X — beroperasi sepenuhnya mandiri memakai tekanan perpipaan dan tidak membutuhkan daya eksternal. Model dengan kontrol solenoid seperti GKZF-1 memakai AC220V atau DC24V untuk otomasi jarak jauh.'
	},
	{
		question: 'Material apa yang dipakai untuk aplikasi air minum?',
		answer: 'Untuk jaringan air minum, pencegah aliran balik HS41X memakai bodi besi ulet, penyegel EPDM, serta komponen internal baja tahan karat 304, dan memenuhi persyaratan sanitasi GB/T17219. Konfirmasi sertifikat sanitasi untuk pasar Anda — tim insinyur kami menyediakan berkas dokumennya bersama pesanan.'
	},
	{
		question: 'Bisakah Anda menyediakan paket katup hidrolik lengkap untuk ruang pompa?',
		answer: 'Bisa. Kami memproduksi pencegah aliran balik, katup pengatur tekanan, katup kontrol level air, katup kontrol solenoid, pencegah pusaran air, dan saringan tipe Y, lalu mengirimkannya sebagai satu paket terkoordinasi — kelas tekanan, trim, dan laporan pengujian yang saling cocok dari satu pabrik.'
	}
];

const hydraulicProducts = [
	{
		slug: 'anti-pollution-backflow-preventer-hs41x',
		name: 'Pencegah Aliran Balik Antipolusi (HS41X-16)',
		img: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		desc: 'Rangkaian dua pemeriksaan dengan drain tengah, DN50–DN600'
	},
	{
		slug: 'adjustable-pressure-reducing-valve-500x',
		name: 'Katup Kontrol Pengurang Tekanan Hidrolik yang Dapat Disetel (500X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'Kontrol pilot yang beroperasi mandiri, penyetelan 0,1–1,6 MPa'
	},
	{
		slug: 'hydraulic-water-level-control-valve-f745x',
		name: 'Katup Kontrol Level Air Hidrolik F745X',
		img: '/assets/products/hydraulic-water-level-control-valve-f745x.webp',
		desc: 'Kontrol level dengan pilot pelampung untuk reservoir dan tandon'
	},
	{
		slug: 'groove-solenoid-control-gate-valve-gkzf1',
		name: 'Katup Gerbang Kontrol Solenoid Beralur (GKZF-1)',
		img: '/assets/products/groove-solenoid-control-gate-valve-gkzf1.jpg',
		desc: 'Katup alur dengan pilot DC24V/AC220V, rating 300 PSI'
	},
	{
		slug: 'suction-vortex-preventer-en12845',
		name: 'Pelat Pencegah Pusaran Air Baja Tahan Karat EN12845',
		img: '/assets/02_valves_parts/valves_p21.webp',
		desc: 'SS304/316, menghilangkan kavitasi pompa, kedalaman drain 100 mm'
	}
];

const trustBadges = ['Dua Katup + Drain', 'PN10–PN25', 'Sanitasi GB/T17219', 'Pilot Mandiri'];
---

<Layout
	locale="id"
	title="Pencegah Aliran Balik & Katup Kontrol Hidrolik - WLFE"
	description="Pencegah aliran balik HS41X, katup pengatur tekanan 500X, kontrol level F745X, dan katup solenoid untuk jaringan air minum dan kebakaran. Langsung pabrik."
	type="product"
	productData={{
		name: 'Pencegahan Aliran Balik & Kontrol Hidrolik',
		image: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		description: 'Pencegah aliran balik dan katup kontrol hidrolik untuk perlindungan air minum, pengelolaan tekanan, dan jaringan air terotomasi, diproduksi oleh Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Pencegahan Aliran Balik' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/id/" class="hover:text-blue-600">Beranda</a>
			<span>/</span>
			<a href="/id/products/" class="hover:text-blue-600">Produk</a>
			<span>/</span>
			<span class="text-gray-600">Pencegahan Aliran Balik</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Perlindungan Air Minum &amp; Kontrol Hidrolik</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Pencegah Aliran Balik &amp; Katup Kontrol Hidrolik</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid memproduksi seluruh rangkaian katup pengaman hidrolik — pencegah aliran balik HS41X, katup pengatur tekanan 500X, katup kontrol level F745X, dan katup kontrol solenoid GKZF-1 — untuk melindungi jaringan air minum serta mengotomasi pengendalian tekanan dan level dalam satu paket terkoordinasi.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Rangkaian Katup Pengaman Hidrolik</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydraulicProducts.map(p => (
					<a href={`/id/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Spesifikasi Utama</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Katup</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Fungsi</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Rentang ukuran</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Rating</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">HS41X</td>
							<td class="px-4 py-3 text-gray-700">Pencegahan aliran balik antipolusi</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">500X</td>
							<td class="px-4 py-3 text-gray-700">Penurun / penahan tekanan</td>
							<td class="px-4 py-3 text-gray-700">DN20 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">F745X</td>
							<td class="px-4 py-3 text-gray-700">Kontrol level air</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN400</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">GKZF-1</td>
							<td class="px-4 py-3 text-gray-700">Kontrol buka/tutup solenoid</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN300</td>
							<td class="px-4 py-3 text-gray-700">300 PSI, AC220V/DC24V</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Pencegah Pusaran</td>
							<td class="px-4 py-3 text-gray-700">Perlindungan isapan pompa</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN1000</td>
							<td class="px-4 py-3 text-gray-700">EN12845 / GB50974</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplikasi</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Pengendalian sambung silang pada air minum (pipa kebakaran, irigasi, boiler)</li>
				<li>Kontrol level pada reservoir dan tandon atap</li>
				<li>Pengelolaan zona tekanan pada jaringan municipal dan gedung</li>
				<li>Jaringan air terotomasi dengan kontrol katup jarak jauh</li>
				<li>Perlindungan isapan pompa pada reservoir dan tandon</li>
			</ul>

			<!-- FAQ Section -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Pertanyaan yang Sering Diajukan</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Butuh Paket Katup Hidrolik untuk Jaringan Anda?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Kirimkan DN, kelas tekanan, dan jenis sambungan Anda — tim insinyur kami membalas dengan kurva kehilangan tekanan, lembar data, dan penawaran paket dalam waktu 12 jam.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/id/contact/?product=Pencegahan%20Aliran%20Balik%20%26%20Kontrol%20Hidrolik" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Minta Penawaran</a>
						<a href="https://wa.me/8618684324501?text=Halo%2C%20saya%20butuh%20bantuan%20untuk%20memilih%20katup%20kontrol%20hidrolik" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat via WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
