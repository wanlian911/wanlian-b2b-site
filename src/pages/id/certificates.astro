---
import Layout from '../../layouts/Layout.astro';

const certifications = [
  {
    name: 'ISO 9001:2015',
    code: 'ATAS NAMA KAMI',
    desc: 'Sistem manajemen mutu yang kami gunakan untuk mengendalikan proses dan dokumentasi produk.',
    scope: 'Ruang lingkup sistem mencakup perancangan, produksi, dan penjualan produk Wanlian sesuai dokumen sertifikat ISO 9001:2015.',
    products: 'Sistem manajemen mutu Wanlian',
    verify: 'Sertifikat sistem dan periode berlakunya dapat diminta untuk verifikasi terhadap badan sertifikasi yang menerbitkannya.',
    icon: '⚙️'
  },
  {
    name: 'Catatan Uji Batch',
    code: 'ATAS NAMA KAMI',
    desc: 'Bukti uji batch dan pemeriksaan unit yang kami siapkan untuk dokumentasi pesanan.',
    scope: 'Catatan uji batch menunjukkan hasil pemeriksaan dan uji produk yang dipasok untuk pesanan Anda.',
    products: 'Katup dan peralatan pemadam kebakaran yang dipasok Wanlian',
    verify: 'Catatan uji batch adalah bukti kami sendiri dan tidak boleh dibaca sebagai daftar sertifikasi pabrik pihak lain.',
    icon: '🧪'
  },
  {
    name: 'EN 12266-1 / GB 5135',
    code: 'DASAR DESAIN DAN UJI',
    desc: 'Standar rujukan untuk desain, pemeriksaan, dan pengujian produk sesuai kebutuhan proyek.',
    scope: 'Persyaratan EN 12266-1 atau GB 5135 digunakan sebagai dasar desain dan uji bila berlaku pada model serta proyek terkait.',
    products: 'Katup dan komponen perlindungan kebakaran sesuai spesifikasi proyek',
    verify: 'Konfirmasikan model, pasar tujuan, dan laporan uji yang relevan sebelum pemesanan karena penerapan standar bergantung pada cakupan produk.',
    icon: '📐'
  },
  {
    name: 'UL Listed',
    code: 'DIMELEKI PABRIK PRODUSEN',
    desc: 'Daftar UL yang dipegang oleh pabrik produsen untuk model tertentu.',
    scope: 'UL 262 / UL 1091 hanya merujuk pada model dan pabrik yang tercantum dalam daftar UL terkait.',
    products: 'Model katup yang tercantum pada daftar UL pabrik produsen',
    verify: 'Wanlian tidak memiliki daftar UL dan tidak mengakuinya atas nama sendiri. Verifikasi model dan pabrik pemegang daftar pada sumber UL resmi.',
    icon: '🏆'
  },
  {
    name: 'FM Approved',
    code: 'DIMELEKI PABRIK PRODUSEN',
    desc: 'Persetujuan FM yang dipegang oleh pabrik produsen untuk model tertentu.',
    scope: 'FM Class 1120 / 1130 hanya merujuk pada model dan pabrik yang tercantum dalam persetujuan FM terkait.',
    products: 'Model katup kontrol layanan kebakaran yang disetujui FM',
    verify: 'Kami tidak menyajikan persetujuan FM sebagai kredensial Wanlian. Verifikasi model dan pabrik pemegang persetujuan pada sumber FM resmi.',
    icon: '🛡️'
  },
  {
    name: 'LPCB RedBook',
    code: 'DIMELEKI PABRIK PRODUSEN',
    desc: 'Entri RedBook LPCB yang dipegang oleh pabrik produsen untuk produk tertentu.',
    scope: 'Entri LPCB RedBook hanya berlaku untuk produk, model, dan pabrik yang tercantum pada entri RedBook terkait.',
    products: 'Produk perlindungan kebakaran yang tercantum pada entri RedBook pabrik',
    verify: 'Verifikasi nomor entri RedBook, model, dan pabrik pemegang daftar sebelum menjadikannya dasar persyaratan proyek.',
    icon: '📜'
  }
];

const faq = [
  {
    question: 'Apakah Wanlian memiliki sertifikasi ISO 9001?',
    answer: 'Ya — ISO 9001:2015 adalah sistem manajemen mutu yang kami gunakan atas nama Wanlian. Dokumen dan badan sertifikasi dapat dikonfirmasi untuk ruang lingkup yang berlaku.'
  },
  {
    question: 'Apakah katup Wanlian terdaftar UL atau FM?',
    answer: 'Bukan — daftar itu milik pabrik yang memegangnya, bukan Wanlian. Wanlian tidak memiliki daftar UL dan tidak mengakuinya atas nama sendiri, dan kami tidak menyajikan persetujuan FM sebagai kredensial Wanlian. Kami membantu mencocokkan model serta pabrik pemegang daftar dengan kebutuhan proyek.'
  },
  {
    question: 'Apa arti EN 12266-1 dan GB 5135 pada dokumentasi Anda?',
    answer: 'Keduanya dapat menjadi dasar desain dan uji bila berlaku untuk model serta proyek terkait. Kami mengonfirmasi standar, cakupan model, dan laporan uji yang relevan sebelum pemesanan.'
  },
  {
    question: 'Bagaimana memeriksa daftar pabrik dan dokumen uji?',
    answer: 'Periksa nomor entri atau sertifikat pada sumber resmi badan penerbit dan cocokkan dengan model serta pabrik pemegangnya. Untuk produk yang kami pasok, kami dapat menyediakan catatan uji batch dan dokumen pesanan yang tersedia.'
  },
  {
    question: 'Apakah Anda menyediakan dokumen untuk setiap pengiriman?',
    answer: 'Kami menyediakan catatan uji batch dan dokumen ekspor yang tersedia sesuai pesanan. Sertifikat atau daftar pihak ketiga hanya disertakan bila model serta pabrik pemegangnya telah dikonfirmasi.'
  }
];
---

<Layout 
  locale="id"
  title="Sertifikasi & Dokumentasi Produk | Wanlian Fluid"
  description="Minta salinan sertifikat, laporan uji, datasheet teknis, gambar CAD, dan dukungan ekspor untuk katup serta peralatan pemadam kebakaran Wanlian Fluid."
  faq={faq}
  breadcrumbs={[{ name: 'Sertifikat' }]}
>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
         Dokumentasi <span class="text-brand-red">Produk & Sertifikasi.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
         Sampaikan kebutuhan proyek Anda, lalu kami menyediakan informasi produk, spesifikasi teknis, dan dokumentasi yang tersedia untuk ditinjau.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p>
            <div class="space-y-3 text-sm text-gray-600">
              <p><span class="font-bold text-gray-900">Cakupan: </span>{cert.scope}</p>
              <p><span class="font-bold text-gray-900">Produk tercakup: </span>{cert.products}</p>
              <p class="text-xs text-gray-500 leading-relaxed border-t border-gray-200 pt-3">{cert.verify}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-6">
        <h2 class="text-3xl font-black">Butuh Salinan Sertifikat atau Datasheet Teknis?</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          Kami menyediakan salinan sertifikat, laporan uji tekanan hidrostatis, datasheet teknis, gambar CAD, dan manual pemasangan untuk seluruh rangkaian produk kami atas permintaan. Sebutkan sertifikasi, model produk, dan pasar target Anda agar kami dapat memastikan cakupan yang berlaku.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a href="/id/contact/?product=Permintaan%20Sertifikat%20dan%20Dokumentasi%20Teknis" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
            Minta Sertifikat &amp; Dokumen
          </a>
          <a href="/id/products/" class="inline-block px-10 py-5 bg-white/10 border border-gray-600 text-white font-black rounded-xl hover:bg-white/20 transition">
            Lihat Produk Bersertifikat
          </a>
        </div>
        <p class="text-xs text-gray-500 pt-2">
          Sertifikasi berlaku untuk produk, model, dan cakupan yang tertera pada setiap sertifikat. Tim teknis kami memastikan cakupan model sebelum Anda melakukan pemesanan.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 bg-gray-50 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">FAQ</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Pertanyaan yang Sering Diajukan</h2>
      </div>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-white rounded-xl border border-gray-100 p-6 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
