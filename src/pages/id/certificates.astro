---
import Layout from '../../layouts/Layout.astro';

const certifications = [
  {
    name: 'UL Listed',
    code: 'UL 262 / UL 1091',
    desc: 'Standar untuk katup gerbang dan katup balik (check valves) layanan perlindungan kebakaran.',
    scope: 'Katup gerbang dan katup balik untuk layanan perlindungan kebakaran yang dipasok ke pasar Amerika Utara (UL 262 / UL 1091).',
    products: 'Katup gerbang dudukan elastis, katup balik',
    verify: 'Cakupan sertifikat berlaku untuk model tertentu yang tercantum dalam sertifikat UL. Hubungi kami untuk memastikan cakupan model dan meminta salinannya.',
    icon: '🏆'
  },
  {
    name: 'FM Approved',
    code: 'Class 1120/1130',
    desc: 'Standar persetujuan untuk katup kontrol layanan kebakaran (tipe OS&Y dan NRS).',
    scope: 'Katup kontrol layanan kebakaran (tipe OS&Y dan NRS) yang disetujui menurut FM Class 1120/1130.',
    products: 'Katup gerbang OS&Y, katup kontrol layanan kebakaran',
    verify: 'Persetujuan mencakup model yang tercantum pada sertifikat persetujuan FM. Salinan disediakan atas permintaan untuk dokumentasi proyek Anda.',
    icon: '🛡️'
  },
  {
    name: 'CE Certified',
    code: 'EN 12266-1',
    desc: 'Kepatuhan terhadap standar kesehatan, keselamatan, dan perlindungan lingkungan Eropa.',
    scope: 'Peralatan tekanan diuji dan ditandai sesuai arahan UE yang berlaku dan standar pengujian EN 12266-1.',
    products: 'Katup untuk proyek UE (sesuai cakupan arahan yang berlaku)',
    verify: 'Penandaan CE berlaku dalam cakupan arahan terkait. Konfirmasikan arahan dan kategori yang berlaku untuk proyek Anda.',
    icon: '🇪🇺'
  },
  {
    name: 'ISO 9001:2015',
    code: 'Manajemen Mutu',
    desc: 'Standar internasional untuk sistem manajemen mutu di bidang manufaktur.',
    scope: 'Perancangan, produksi, dan penjualan katup, peralatan pemadam kebakaran, serta produk pengendali fluida dalam sistem manajemen mutu bersertifikat ISO 9001:2015.',
    products: 'Semua lini produksi',
    verify: 'Sertifikat sistem diterbitkan oleh badan sertifikasi terakreditasi dan berlaku sepanjang periode sertifikat. Salinan tersedia atas permintaan.',
    icon: '⚙️'
  },
  {
    name: 'LPCB Certified',
    code: 'Loss Prevention',
    desc: 'Daftar RedBook untuk produk dan jasa perlindungan kebakaran.',
    scope: 'Produk perlindungan kebakaran yang terdaftar dalam skema RedBook LPCB untuk pasar Inggris dan negara Persemakmuran.',
    products: 'Produk perlindungan kebakaran terdaftar (sesuai entri RedBook)',
    verify: 'Daftar RedBook mencakup produk dan standar tertentu yang tertera pada entri daftar tersebut. Verifikasi nomor entri untuk produk target Anda.',
    icon: '📜'
  },
  {
    name: 'Standar GB',
    code: 'GB 5135 / GB 4452',
    desc: 'Kepatuhan terhadap Standar Nasional China untuk peralatan perlindungan kebakaran.',
    scope: 'Diproduksi dan diuji sesuai Standar Nasional China terkait (seri GB 5135, GB 4452, GB 50974).',
    products: 'Komponen sistem sprinkler, hidran kebakaran, katup alarm',
    verify: 'Kepatuhan mengacu pada standar GB tertentu yang berlaku untuk setiap model produk. Laporan uji tersedia atas permintaan.',
    icon: '🇨🇳'
  }
];

const faq = [
  {
    question: 'Apakah Wanlian Fluid memiliki sertifikasi ISO 9001?',
    answer: 'Ya — produksi berjalan di bawah sistem manajemen mutu ISO 9001:2015 yang mencakup perancangan, produksi, dan penjualan katup, peralatan pemadam kebakaran, serta produk pengendali fluida. Nomor sertifikat dan badan penerbitnya kami sediakan untuk verifikasi.'
  },
  {
    question: 'Apakah katup pemadam Anda terdaftar UL atau FM?',
    answer: 'Katup gerbang dan katup balik untuk perlindungan kebakaran terdaftar pada UL 262 / UL 1091, dan katup kontrol layanan kebakaran (tipe OS&Y dan NRS) memegang persetujuan FM Class 1120/1130. Pendaftaran diberikan per model — kami memastikan model terdaftar yang tepat serta cakupan sertifikat sesuai spesifikasi Anda sebelum pemesanan.'
  },
  {
    question: 'Apa saja yang dicakup penandaan CE untuk katup Anda?',
    answer: 'Penandaan CE diterapkan per model, dalam cakupan arahan UE terkait, dengan pengujian katup mengikuti EN 12266-1. Sampaikan proyek dan negara tujuan Anda, lalu kami mengonfirmasi arahan, kategori, dan dokumentasi yang berlaku untuk model yang tepat.'
  },
  {
    question: 'Bagaimana saya bisa memastikan sertifikat Anda asli?',
    answer: 'Setiap nomor sertifikat dapat diperiksa di portal resmi badan penerbitnya terhadap model dan pabrik yang tepat — nomor yang tidak dapat diverifikasi adalah tanda bahaya pada pemasok mana pun. Kami menyertakan salinan sertifikat terkait bersama dokumentasi pesanan Anda.'
  },
  {
    question: 'Apakah Anda menyertakan laporan uji bersama pengiriman?',
    answer: 'Ya — catatan uji tekanan bodi dan uji kebocoran udara per unit yang dicocokkan dengan nomor seri pada packing list berjalan bersama dokumen ekspor (invoice, packing list, certificate of origin), ditambah sertifikat material dan sertifikat sesuai standar atas permintaan.'
  }
];
---

<Layout 
  locale="id"
  title="Sertifikasi & Dokumentasi Produk | Wanlian Fluid"
  description="Minta salinan sertifikat, laporan uji, datasheet teknis, gambar CAD, dan dukungan ekspor untuk katup serta peralatan pemadam kebakaran Wanlian Fluid."
  faq={faq}
  breadcrumbs={[{ name: 'Sertifikat' }]}
>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
         Dokumentasi <span class="text-brand-red">Produk & Sertifikasi.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
         Sampaikan kebutuhan proyek Anda, lalu kami menyediakan informasi produk, spesifikasi teknis, dan dokumentasi yang tersedia untuk ditinjau.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p>
            <div class="space-y-3 text-sm text-gray-600">
              <p><span class="font-bold text-gray-900">Cakupan: </span>{cert.scope}</p>
              <p><span class="font-bold text-gray-900">Produk tercakup: </span>{cert.products}</p>
              <p class="text-xs text-gray-500 leading-relaxed border-t border-gray-200 pt-3">{cert.verify}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-6">
        <h2 class="text-3xl font-black">Butuh Salinan Sertifikat atau Datasheet Teknis?</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          Kami menyediakan salinan sertifikat, laporan uji tekanan hidrostatis, datasheet teknis, gambar CAD, dan manual pemasangan untuk seluruh rangkaian produk kami atas permintaan. Sebutkan sertifikasi, model produk, dan pasar target Anda agar kami dapat memastikan cakupan yang berlaku.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a href="/id/contact/?product=Permintaan%20Sertifikat%20dan%20Dokumentasi%20Teknis" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
            Minta Sertifikat &amp; Dokumen
          </a>
          <a href="/id/products/" class="inline-block px-10 py-5 bg-white/10 border border-gray-600 text-white font-black rounded-xl hover:bg-white/20 transition">
            Lihat Produk Bersertifikat
          </a>
        </div>
        <p class="text-xs text-gray-500 pt-2">
          Sertifikasi berlaku untuk produk, model, dan cakupan yang tertera pada setiap sertifikat. Tim teknis kami memastikan cakupan model sebelum Anda melakukan pemesanan.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 bg-gray-50 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">FAQ</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Pertanyaan yang Sering Diajukan</h2>
      </div>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-white rounded-xl border border-gray-100 p-6 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
