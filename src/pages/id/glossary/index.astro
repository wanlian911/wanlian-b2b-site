---
import Layout from '../../../layouts/Layout.astro';
const groups = [{ title: 'Katup dan komponen', terms: [{ term: 'Katup gerbang', definition: 'Katup isolasi dengan baji untuk menghentikan aliran pada jaringan air dan perlindungan kebakaran.' }, { term: 'Katup kupu-kupu', definition: 'Katup seperempat putaran dengan cakram yang digunakan untuk mengendalikan dan mengisolasi perpipaan.' }, { term: 'Katup periksa', definition: 'Katup yang memungkinkan aliran satu arah dan mencegah fluida mengalir kembali.' }, { term: 'Katup pengurang tekanan (PRV)', definition: 'Katup yang secara otomatis mengurangi tekanan masuk menjadi tekanan keluar yang stabil.' }, { term: 'Perangkat pencegah aliran balik', definition: 'Perangkat yang mencegah kontaminasi air bersih akibat aliran balik pada sambungan silang.' }, { term: 'Penyekat kedap', definition: 'Penyekat yang mencegah kebocoran melalui katup ketika katup berada dalam posisi tertutup.' }] }, { title: 'Hidran dan sambungan', terms: [{ term: 'Hidran kebakaran', definition: 'Peralatan yang terhubung ke jaringan air untuk memasok selang dan peralatan pemadam kebakaran.' }, { term: 'Hidran tegak', definition: 'Hidran yang dipasang di atas tanah; versi luar digunakan pada jaringan kota dan industri.' }, { term: 'Hidran bawah tanah', definition: 'Hidran yang dipasang di bawah permukaan tanah dan dilindungi kotak akses.' }, { term: 'Sambungan pemadam kebakaran (FDC)', definition: 'Sambungan yang memungkinkan petugas pemadam memasukkan air ke sistem sprinkler atau jaringan perlindungan.' }] }, { title: 'Sprinkler dan pemadaman', terms: [{ term: 'Sprinkler kebakaran', definition: 'Perangkat yang mengeluarkan air secara otomatis ketika elemen termalnya mencapai suhu aktivasi.' }, { term: 'Sistem sprinkler', definition: 'Jaringan pipa, katup, dan sprinkler untuk perlindungan kebakaran otomatis.' }, { term: 'Sistem pra-aksi', definition: 'Sistem dengan pipa yang biasanya kering dan memerlukan sinyal independen sebelum air dilepaskan.' }, { term: 'Katup deluge', definition: 'Katup yang membuka saluran air ke perangkat pemadam setelah menerima sinyal aktivasi.' }] }, { title: 'Standar, pengujian, dan pengadaan', terms: [{ term: 'Tekanan nominal', definition: 'Kelas tekanan acuan yang digunakan untuk menentukan kemampuan kerja komponen pada kondisi tertentu.' }, { term: 'Uji hidrostatik', definition: 'Pengujian dengan media cair untuk memeriksa kekuatan dan kekedapan komponen bertekanan.' }, { term: 'Sertifikasi UL/FM', definition: 'Pengesahan oleh lembaga pengujian atau sertifikasi terhadap produk dan model tertentu.' }, { term: 'Incoterm', definition: 'Ketentuan perdagangan internasional yang menetapkan pembagian biaya, risiko, dan tanggung jawab pengiriman.' }] }];
---
<Layout title="Glosarium Katup dan Perlindungan Kebakaran" description="Glosarium teknis berisi istilah katup, hidran, sprinkler, sertifikasi, pengujian, dan pengadaan B2B." type="website" locale="id" breadcrumbs={[{ name: 'Glosarium' }]}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/id/">Beranda</a><span>/</span><span class="text-gray-600">Glosarium</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Referensi teknis</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Glosarium katup dan perlindungan kebakaran</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Definisi ringkas untuk spesifikasi, dokumen tender, lembar data, dan pengadaan katup, hidran, sprinkler, serta peralatan kebakaran.</p><div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-8">{groups.map(g => <a href={`#${g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="px-4 py-3 bg-gray-50 border border-gray-100 rounded-xl text-xs font-bold text-brand-blue text-center">{g.title}</a>)}</div>{groups.map(g => <section class="mt-12"><h2 id={g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')} class="text-2xl font-black text-gray-900 mb-5 tracking-tight">{g.title}</h2><div class="space-y-4">{g.terms.map(t => <div class="bg-gray-50 rounded-xl border border-gray-100 p-5"><h3 class="text-lg font-black text-gray-900">{t.term}</h3><p class="mt-2 text-gray-700 leading-relaxed text-sm">{t.definition}</p></div>)}</div></section>)}<div class="mt-12 bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center rounded-2xl"><h2 class="text-2xl font-black text-white">Siap menyusun spesifikasi?</h2><p class="mt-3 text-blue-100">Kirimkan jumlah dan tujuan penggunaan untuk memperoleh penawaran terperinci.</p><a href="/id/contact/" class="inline-block mt-6 px-8 py-4 bg-brand-red text-white font-bold rounded-lg">Minta penawaran</a></div></article></main>
</Layout>
