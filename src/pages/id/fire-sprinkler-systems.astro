---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Seus sprinkler possuem sertifikasi UL?',
		answer: 'Ya. Nossos sprinkler e componentes de sistem possuem sertifikasi UL/ULC quando aplicável — os sertifikat estão tersedia em kami página de Certificados. Nossos engenheiros confirmam o pacote de sertifikasi exato para o Anda mercado de destino antes da cotação.'
	},
	{
		question: 'Apa a diferença entre sistems de sprinkler molhado e seco?',
		answer: 'Sistem molhados mantêm air nas tubulações para descarga imediata quando um rociador é acionado. Sistem secos usam ar ou nitrogênio pressurizados com válvula de tubulação seca, sendo adequados a espaços sem aquecimento onde o congelamento das tubulações é um risco. Sistem de pré-ação combinam os dois benefícios para áreas sensíveis à air.'
	},
	{
		question: 'Apakah Anda fornecem conexões flexíveis de queda para sprinkler?',
		answer: 'Ya, kami memproduksi conexões de queda flexíveis em aço inox trançado que simplificam a instalação e permitem reposicionamento rápido dos sprinkler sesuai o layout do teto — reduzindo o tempo de mão de obra em comparação com tubulações rígidas.'
	},
	{
		question: 'Apakah Anda podem fornecer cotação lengkap BOM do sistem?',
		answer: 'Ya. Envie-nos Andas desenhos de projeto ou a lista de componentes e cotaremos sprinkler, katup de alarme, indicadores de aliran, filtros e acessórios como um único pacote — uma única ordem de fábrica para o circuito lengkap de sprinkler.'
	},
	{
		question: 'Apa saja classes de temperatura estão tersedia?',
		answer: 'As classes padrão de bulbo de vidro incluem 57°C, 68°C, 79°C, 93°C e 141°C com bulbos de cores codificadas, em tipos de resposta padrão (bulbo 5mm) e rápida (bulbo 3mm) sesuai a prática NFPA.'
	}
];

const sprinklerProducts = [
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'Rociador de Bulbo de Vidro (Série ZST)',
		img: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		desc: 'Pendente/em pé/parede lateral, K=80/115, 57–141°C'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Válvula de Retenção de Alarme Molhada (ZSFZ 150)',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'Sino de alarme hidráulico, câmara de retardo, DN100–DN200'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Conjunto de Válvula de Dilúvio com Alarme (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Operada a diafragma, para sistems de dilúvio e jato de air'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Sistem de Alarme de Pré-Ação (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Disparo duplo de segurança para bibliotecas, arquivos, data centers'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Indicador de Aliran de Água a Pás (ZSJZ)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'Atraso ajustável 2–60s, DN50–DN200, abraçadeira/flange'
	},
	{
		slug: 'telescopic-y-strainer-sgl41h',
		name: 'Filtro em Y Telescópico (SGL41H)',
		img: '/assets/products/telescopic-y-strainer-sgl41h.webp',
		desc: 'Protege katup contra partículas, tela SS304/316'
	},
	{
		slug: 'horizontal-sidewall-fire-sprinkler-t-zstbs',
		name: 'Rociador de Parede Lateral Horizontal (T-ZSTBS)',
		img: '/assets/products/horizontal-sidewall-fire-sprinkler-t-zstbs.png',
		desc: 'Cabeça T de parede lateral, K=80/115, para proteção sob vigas e estantes'
	},
	{
		slug: 'zstdy-concealed-fire-sprinkler',
		name: 'Rociador Embutido (ZST-DY)',
		img: '/assets/products/zstdy-concealed-fire-sprinkler.webp',
		desc: 'Cabeça decorativa embutida, placa de acabamento combinada para tetos revestidos'
	},
	{
		slug: 'indoor-fire-hydrant-head-sn65',
		name: 'Boca de Kebakaran Interna (SN65)',
		img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg',
		desc: 'Bocal de coluna interna DN65 para estações proteksi kebakaran em edifícios'
	}
];
---

<Layout
	locale="id"
	title="Sistem de Sprinkler & Sprinkler Certificados UL - WLFE"
	description="Sprinkler sertifikat UL, conexões flexíveis e componentes de sistems de sprinkler proteksi kebakaran para edifícios comerciais e industriais. Fábrica."
	type="product"
	productData={{
		name: 'Sistem de Sprinkler',
		image: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		description: 'Sprinkler sertifikat UL, katup de alarme, indicadores de aliran e componentes de sistem para sistems de sprinkler molhados, secos e de pré-ação em edifícios comerciais e industriais, memproduksidos por Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Sistem de Sprinkler' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/id/" class="hover:text-blue-600">Beranda</a>
			<span>/</span>
			<a href="/id/products/" class="hover:text-blue-600">Produk</a>
			<span>/</span>
			<span class="text-gray-600">Sistem de Sprinkler</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Sistem de Sprinkler Lengkaps — Langsung dari Pabrik</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Sistem Lengkaps de Sprinkler com Componentes Certificados UL</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">A Wanlian Fluid memproduksi e exporta sprinkler sertifikat UL, conexões flexíveis de queda, katup de alarme e acessórios de sistem para instalações molhadas, secas e de pré-ação em edifícios comerciais e industriais — uma única ordem de fábrica para o circuito lengkap de sprinkler.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Bersertifikat UL/ULC', 'K=80 / K=115', 'Classes 57–141°C', 'BOM do Sistem Lengkap'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Componentes dos Sistem de Sprinkler</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{sprinklerProducts.map(p => (
					<a href={`/id/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Spesifikasi Utama</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Spesifikasi</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Detail</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Sertifikasi</td>
							<td class="px-4 py-3 text-gray-700">Bersertifikat UL/ULC (sesuai modelo e mercado de destino)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Tamanhos dos sprinkler</td>
							<td class="px-4 py-3 text-gray-700">1/2" (DN15), 3/4" (DN20), 1" — pendente, em pé, parede lateral</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Coeficiente de aliran</td>
							<td class="px-4 py-3 text-gray-700">K=80 ±4 / K=115 ±9 (outros fatores K sesuai modelo)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Classes de temperatura</td>
							<td class="px-4 py-3 text-gray-700">57°C / 68°C / 79°C / 93°C / 141°C, bulbos de vidro coloridos</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Jeniss de resposta</td>
							<td class="px-4 py-3 text-gray-700">Resposta padrão (bulbo 5mm) / Rápida (bulbo 3mm)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Katup de sistem</td>
							<td class="px-4 py-3 text-gray-700">Alarme molhado (ZSFZ), dilúvio (ZSFM), pré-ação (ZSFY), indicadores de aliran (ZSJZ)</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplikasi</h2>
			<p class="text-gray-700 leading-relaxed">Nossos componentes de sistems de sprinkler protegem edifícios comerciais, hotéis, hospitais, escolas, fábricas, armazéns, data centers e estacionamentos subterrâneos — com sistems de pré-ação recomendados para bibliotecas, arquivos e salas de computação onde descargas acidentais devem ser evitadas.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Mengapa Memilih a Wanlian Fluid</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Sistem lengkap, uma única ordem</strong> — sprinkler, conexões, katup de alarme e acessórios cotados como um único pacote de uma única fábrica.</li>
				<li><strong>Componentes sertifikat</strong> — sertifikat UL/ULC quando aplicável; sertifikat em kami <a href="/id/certificates/" class="text-brand-blue font-semibold hover:underline">página de sertifikat</a>.</li>
				<li><strong>Alinhado às normas de construção</strong> — configurações sesuais com a prática NFPA para aceitação de projetos globais.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Pertanyaan Umum</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Membutuhkan Componentes de Sistem de Sprinkler?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envie-nos o tipo do Anda edifício e a lista de componentes — respondemos com uma cotação BOM lengkap em até 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/id/contact/?product=Sistem%20de%20Sprinkler" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Minta Penawaran</a>
						<a href="https://wa.me/8618684324501?text=Ol%C3%A1%2C%20preciso%20de%20componentes%20de%20sistem%20de%20sprinkler%20contra%20inc%C3%AAndio" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Hubungi via WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>

