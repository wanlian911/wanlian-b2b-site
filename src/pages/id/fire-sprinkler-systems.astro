---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Apakah kepala sprinkler Anda terdaftar UL?',
		answer: 'Ya. Kepala sprinkler dan komponen sistem kami terdaftar UL/ULC bila berlaku — sertifikatnya dapat dilihat di halaman Sertifikat kami. Tim insinyur kami mengonfirmasi paket sertifikasi yang persis untuk pasar tujuan Anda sebelum penawaran diberikan.'
	},
	{
		question: 'Apa perbedaan sistem sprinkler pipa basah dan pipa kering?',
		answer: 'Sistem pipa basah menyimpan air di dalam pipa sehingga langsung membuang saat kepala sprinkler aktif. Sistem pipa kering memakai udara atau nitrogen bertekanan bersama katup pipa kering, sehingga cocok untuk ruang tanpa pemanas yang berisiko membekukan pipa. Sistem pre-action menggabungkan keunggulan keduanya untuk area yang sensitif terhadap air.'
	},
	{
		question: 'Apakah Anda menyediakan sambungan turun sprinkler yang fleksibel?',
		answer: 'Ya, kami memproduksi sambungan turun fleksibel berlapis jaring baja tahan karat yang memudahkan pemasangan dan memungkinkan penempatan ulang kepala sprinkler dengan cepat agar sesuai tata letak plafon — memangkas waktu kerja dibanding perpipaan kaku.'
	},
	{
		question: 'Bisakah Anda memberikan penawaran BOM sistem lengkap?',
		answer: 'Bisa. Kirimkan gambar proyek atau daftar komponen Anda, dan kami akan menawarkan kepala sprinkler, katup alarm, indikator aliran, saringan, serta aksesori sebagai satu paket — satu pesanan pabrik untuk seluruh loop sprinkler.'
	},
	{
		question: 'Rating suhu apa saja yang tersedia?',
		answer: 'Rating ampul kaca standar meliputi 57°C, 68°C, 79°C, 93°C, dan 141°C dengan ampul berwarna sesuai kode, dalam tipe respon standar (ampul 5 mm) dan respon cepat (ampul 3 mm) mengikuti praktik NFPA.'
	}
];

const sprinklerProducts = [
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'Kepala Sprinkler Pemadam dengan Ampul Kaca (Seri ZST)',
		img: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		desc: 'Pendent/upright/sidewall, K=80/115, 57–141°C'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Katup Alarm Pipa Basah ZSFZ 150',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'Gong alarm hidrolik, ruang penunda, DN100–DN200'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Rakitan Katup Alarm Deluge Seri ZSFM',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Operasi diafragma, untuk sistem deluge dan water spray'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Sistem Katup Alarm Pre-Action ZSFY',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Pengaman dua pemicu untuk perpustakaan, arsip, pusat data'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Indikator Aliran Air Tipe Palet (Seri ZSJZ)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'Tunda 2–60 detik yang dapat disetel, DN50–DN200, pelana/flensa'
	},
	{
		slug: 'telescopic-y-strainer-sgl41h',
		name: 'Saringan Tipe Y Teleskopik SGL41H',
		img: '/assets/products/telescopic-y-strainer-sgl41h.webp',
		desc: 'Melindungi katup dari partikel, saringan SS304/316'
	},
	{
		slug: 'horizontal-sidewall-fire-sprinkler-t-zstbs',
		name: 'Kepala Sprinkler Pemadam Dinding Samping Horizontal (T-ZSTBS)',
		img: '/assets/products/horizontal-sidewall-fire-sprinkler-t-zstbs.png',
		desc: 'Kepala sidewall T, K=80/115, untuk proteksi bawah balok dan rak'
	},
	{
		slug: 'zstdy-concealed-fire-sprinkler',
		name: 'Kepala Sprinkler Pemadam Tersembunyi di Plafon ZSTDY',
		img: '/assets/products/zstdy-concealed-fire-sprinkler.webp',
		desc: 'Kepala tanam dekoratif, cincin penutup senada untuk plafon sudah jadi'
	},
	{
		slug: 'indoor-fire-hydrant-head-sn65',
		name: 'Katup Hidran Kebakaran Dalam Ruangan SN65',
		img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg',
		desc: 'Nozzle standpipe dalam ruangan DN65 untuk pos pemadaman di dalam gedung'
	}
];
---

<Layout
	locale="id"
	title="Sistem Sprinkler & Kepala Sprinkler UL - WLFE"
	description="Kepala sprinkler terdaftar UL, sambungan fleksibel, dan komponen sistem sprinkler lengkap untuk gedung komersial dan industri. Langsung dari pabrik."
	type="product"
	productData={{
		name: 'Sistem Sprinkler Kebakaran',
		image: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		description: 'Kepala sprinkler terdaftar UL, katup alarm, indikator aliran, dan komponen sistem untuk instalasi pipa basah, pipa kering, dan pre-action pada gedung komersial dan industri, diproduksi oleh Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Sistem Sprinkler' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/id/" class="hover:text-blue-600">Beranda</a>
			<span>/</span>
			<a href="/id/products/" class="hover:text-blue-600">Produk</a>
			<span>/</span>
			<span class="text-gray-600">Sistem Sprinkler</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Sistem Sprinkler Lengkap — Langsung dari Pabrik</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Sistem Sprinkler Kebakaran Lengkap dengan Komponen Terdaftar UL</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid memproduksi dan mengekspor kepala sprinkler terdaftar UL, sambungan turun fleksibel, katup alarm, dan aksesori sistem untuk instalasi pipa basah, pipa kering, dan pre-action pada gedung komersial dan industri — satu pesanan pabrik untuk seluruh loop sprinkler.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Terdaftar UL/ULC', 'K=80 / K=115', 'Rating 57–141°C', 'BOM Sistem Lengkap'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Komponen Sistem Sprinkler</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{sprinklerProducts.map(p => (
					<a href={`/id/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Spesifikasi Utama</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Spesifikasi</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Rincian</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Sertifikasi</td>
							<td class="px-4 py-3 text-gray-700">Terdaftar UL/ULC (per model dan pasar tujuan)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Ukuran sprinkler</td>
							<td class="px-4 py-3 text-gray-700">1/2" (DN15), 3/4" (DN20), 1" — pendent, upright, sidewall</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Koefisien aliran</td>
							<td class="px-4 py-3 text-gray-700">K=80 ±4 / K=115 ±9 (K-faktor lain per model)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Rating suhu</td>
							<td class="px-4 py-3 text-gray-700">57°C / 68°C / 79°C / 93°C / 141°C, ampul kaca berwarna sesuai kode</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Tipe respon</td>
							<td class="px-4 py-3 text-gray-700">Respon standar (ampul 5 mm) / Respon cepat (ampul 3 mm)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Katup sistem</td>
							<td class="px-4 py-3 text-gray-700">Alarm pipa basah (ZSFZ), deluge (ZSFM), pre-action (ZSFY), indikator aliran (ZSJZ)</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplikasi</h2>
			<p class="text-gray-700 leading-relaxed">Komponen sistem sprinkler kami melindungi gedung kantor komersial, hotel, rumah sakit, sekolah, pabrik, gudang, pusat data, dan area parkir bawah tanah — dengan sistem pre-action yang direkomendasikan untuk perpustakaan, arsip, dan ruang komputer yang harus terhindar dari pembuangan air tidak sengaja.</p>

			<!-- Why WLFE -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Mengapa Memilih Wanlian Fluid</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Sistem lengkap, satu pesanan</strong> — kepala, sambungan, katup alarm, dan aksesori ditawarkan sebagai satu paket dari satu pabrik.</li>
				<li><strong>Komponen bersertifikat</strong> — terdaftar UL/ULC bila berlaku; sertifikatnya ada di <a href="/id/certificates/" class="text-brand-blue font-semibold hover:underline">halaman sertifikat</a> kami.</li>
				<li><strong>Orientasi kode gedung</strong> — konfigurasi diselaraskan dengan praktik NFPA agar diterima proyek di berbagai negara.</li>
			</ul>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Pertanyaan yang Sering Diajukan</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Butuh Komponen Sistem Sprinkler?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Kirimkan jenis gedung dan daftar komponen Anda — kami membalas dengan penawaran BOM lengkap dalam waktu 12 jam.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/id/contact/?product=Sistem%20Sprinkler%20Kebakaran" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Minta Penawaran</a>
						<a href="https://wa.me/8618684324501?text=Halo%2C%20saya%20butuh%20komponen%20sistem%20sprinkler%20kebakaran" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat via WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
