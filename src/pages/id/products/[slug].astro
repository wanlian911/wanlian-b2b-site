---
import Layout from '../../../layouts/Layout.astro';
import { productsId, productsIdBySlug } from '../../../utils/products.id';
import { PRODUCT_FAMILY_RELATED } from '../../../utils/product-families';

export async function getStaticPaths() {
  return Object.values(productsIdBySlug).map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

// FAQ umum per kategori (kunci harus identik dengan nilai category di src/utils/id-parts)
const faqByCategory: Record<string, { question: string; answer: string }[]> = {
  'Katup Industri & Saringan (Strainer)': [
    { question: 'Standar dan jenis koneksi apa saja yang tersedia untuk katup Wanlian?', answer: 'Katup Wanlian diproduksi sesuai pesanan mengikuti standar GB, ANSI, DIN, dan JIS. Koneksi flens, alur (grooved), tipe wafer, dan ulir tersedia sesuai model. Sampaikan DN/PN dan jenis koneksi kepada tim teknis kami saat menanyakan harga, dan kami akan mengonfirmasi konfigurasi yang tepat.' },
    { question: 'Material apa saja yang digunakan untuk badan katup dan dudukan (seat)?', answer: 'Badan katup umumnya dari besi cor ulet (QT450), besi cor kelabu, atau baja cor/tempa sesuai model. Elemen penyekat menggunakan karet EPDM atau NBR, dan batang katup dari baja tahan karat (2Cr13/304). Pilihan material dapat disesuaikan untuk media dan rentang suhu tertentu.' },
    { question: 'Berapa MOQ dan waktu pengirimannya?', answer: 'MOQ standar umumnya 20 unit per model untuk ukuran yang tersedia di gudang, dengan waktu produksi 15 hingga 30 hari sesuai kuantitas dan tingkat kustomisasi. Pesanan sampel tersedia untuk pengujian sebelum pengiriman massal.' },
    { question: 'Bagaimana katup diuji sebelum dikirim?', answer: 'Setiap katup menjalani uji tekanan badan dan dudukan 100% sesuai standar yang berlaku (misalnya GB/T13927, EN 12266-1). Laporan pengujian dan inspeksi pihak ketiga dapat diselenggarakan atas permintaan.' }
  ],
  'Hidran Pemadam & Adaptor Pompa': [
    { question: 'Standar koneksi keluaran apa saja yang tersedia untuk hidran ekspor?', answer: 'Koneksi keluaran umum meliputi BS336 (Inggris Raya/Persemakmuran), NIST (Timur Tengah), KWS (Jerman), dan opsi flensa fleksibel. Kami dapat menyediakan hidran dengan jenis koneksi yang ditentukan untuk pasar Anda.' },
    { question: 'Kelas tekanan berapa yang seharusnya dimiliki hidran kota?', answer: 'Hidran kota standar diklasifikasikan pada PN16 (1,6 MPa), mencakup sebagian besar jaringan pasokan air perkotaan dan industri. Kawasan industri bertekanan tinggi atau berkebutuhan besar mungkin memerlukan hidran PN25.' },
    { question: 'Apakah hidran Wanlian tersedia dengan sertifikasi UL atau FM?', answer: 'Ya, sesuai model dan pasar tujuan. Hubungi tim penjualan kami dengan spesifikasi proyek dan wilayah tujuan Anda agar kami dapat memilih paket sertifikasi yang tepat.' },
    { question: 'Apakah hidran luar ruangan memiliki perlindungan anti-beku?', answer: 'Model seperti hidran pilar SS100 memiliki mekanisme pembuangan anti-beku otomatis untuk iklim dingin. Varian anti-tabrakan (SSFT100) dan hidran pintar IoT (SS100ZN) juga tersedia.' }
  ],
  'Sprinkler Pemadam & Katup Alarm': [
    { question: 'Apa perbedaan antara katup alarm basah dan katup deluge?', answer: 'Katup alarm basah (ZSFZ) menjaga pipa sprinkler selalu terisi air dan memicu alarm saat terjadi aliran air. Katup deluge (ZSFM) tetap tertutup menahan tekanan udara atau air, dan menggenangi sistem hanya ketika sinyal deteksi kebakaran membukanya — digunakan di area berisiko tinggi yang membutuhkan pembuangan air volume besar seketika.' },
    { question: 'Komponen sistem sprinkler ini sesuai standar apa?', answer: 'Komponen diproduksi dan diuji sesuai seri GB 5135, serta atas permintaan dapat mengikuti standar internasional lainnya. Konfirmasikan standar yang berlaku untuk proyek Anda bersama tim teknis kami.' },
    { question: 'Berapa tekanan kerja katup alarm?', answer: 'Tekanan kerja standar adalah 1,6 MPa, dengan tekanan uji 3,2 MPa. Rentang ukuran umumnya mencakup DN50 hingga DN300, sesuai model.' },
    { question: 'Apakah set katup alarm dapat diintegrasikan dengan sistem deteksi kebakaran yang sudah ada?', answer: 'Ya. Katup deluge dan pra-aksi (pre-action) mendukung penggerak mekanis, pneumatik, atau listrik jarak jauh (katup solenoida DC24V) dan dapat diintegrasikan ke sebagian besar panel kontrol alarm kebakaran.' }
  ],
  'Katup Kontrol Hidrolik': [
    { question: 'Apakah katup kontrol hidrolik membutuhkan pasokan listrik?', answer: 'Sebagian besar katup kontrol hidrolik (misalnya katup pengatur level F745X, katup pengurang tekanan 500X) sepenuhnya bertenaga tekanan pipa itu sendiri dan tidak memerlukan pasokan listrik eksternal. Model dengan kontrol solenoida, seperti GKZF-1, menggunakan AC220V atau DC24V.' },
    { question: 'Berapa rentang pengaturan tekanan katup 500X?', answer: 'Katup pengurang tekanan 500X mengatur tekanan hilir dari 0,1 MPa hingga 1,6 MPa dan beroperasi dengan tekanan masuk hingga kelas nominalnya (PN10/PN16/PN25).' },
    { question: 'Material apa saja yang digunakan untuk aplikasi air minum?', answer: 'Untuk jaringan air minum, model seperti perangkat anti-balik HS41X menggunakan badan besi cor ulet dengan penyekat EPDM dan komponen internal baja tahan karat, memenuhi persyaratan sanitasi GB/T17219.' },
    { question: 'Bagaimana palu air (water hammer) dihindari pada katup hidrolik?', answer: 'Katup kontrol berpilot menutup secara halus dan lambat sehingga menghindari lonjakan tekanan mendadak. Katup jarum memungkinkan penyesuaian kecepatan penutupan sesuai kondisi spesifik jaringan pipa.' }
  ],
  'Monitor Pemadam & Meriam Air': [
    { question: 'Debit dan jangkauan semburan apa saja yang tersedia untuk monitor pemadam?', answer: 'Meriam air manual (seri PS) mencakup 20 hingga 200 L/s dengan jangkauan semburan 50 hingga 110 meter. Meriam air pelacak otomatis (seri ZDMS) menyediakan 5 hingga 30 L/s (khusus hingga 150 L/s) dengan radius pemantauan 40 hingga 65 m.' },
    { question: 'Bagaimana meriam air pelacak otomatis mendeteksi kebakaran?', answer: 'Meriam ZDMS menggabungkan sensor inframerah dan ultraviolet untuk mendeteksi serta melacak api, lalu mengarahkan dan menyemprotkan air secara otomatis. Didukung pengoperasian manual jarak jauh melalui PC/aplikasi ponsel atau kabinet pusat.' },
    { question: 'Apakah tersedia versi tahan ledakan (explosion-proof)?', answer: 'Ya, opsi tahan ledakan (misalnya Exde II BT4 Gb) tersedia untuk lingkungan petrokimia dan kawasan berbahaya.' },
    { question: 'Berapa tekanan kerja meriam air?', answer: 'Meriam manual beroperasi pada 0,8–1,2 MPa dan meriam pelacak otomatis pada 0,6–0,8 MPa. Konfirmasikan ukuran flensa masuk (DN100/DN150/DN200) untuk sistem Anda.' }
  ],
  'Gulungan Selang & Lemari Hidran': [
    { question: 'Apa saja yang termasuk dalam set gulungan selang kebakaran?', answer: 'Set seri JPS mencakup gulungan dengan dudukan pivot baja karbon, selang layflat PVC fleksibel (20/25/30 m), dan moncong semprot dari kuningan/alo yang mendukung mode semburan lurus dan kabut.' },
    { question: 'Apakah tersedia lemari busa untuk kebakaran bahan kimia?', answer: 'Ya. Lemari busa PSG30 mengumpulkan tangki konsentrat busa, pencampur takar (proportioner), gulungan selang, dan moncong busa dalam satu unit dinding — efektif untuk kebakaran bahan bakar, bahan kimia, dan pelarut (kelas B).' },
    { question: 'Adaptor kopling selang ini sesuai standar koneksi apa?', answer: 'Adaptor seri HS tersedia dalam DN50/DN65 dengan ulir dalam yang kompatibel dengan kopling kebakaran internasional, diproduksi menurut GB12514 atau standar pabrik.' },
    { question: 'Material apa yang digunakan untuk lemari dan gulungan?', answer: 'Lemari dan gulungan menggunakan baja karbon roll dingin dengan lapisan bubuk (powder coating) merah anti-korosi. Moncong dan pencampur takar terbuat dari kuningan atau alo aluminium anodized.' }
  ]
};

// Aplikasi dan standar pengujian per kategori
const categoryInfo: Record<string, { applications: string[]; testing: string }> = {
  'Katup Industri & Saringan (Strainer)': {
    applications: ['Pasokan dan distribusi air', 'Jaringan limbah dan air buangan', 'Pipa proses industri', 'Sistem HVAC'],
    testing: 'Uji tekanan badan dan dudukan 100% sesuai GB/T13927 atau EN 12266-1; lapisan resin epoksi diuji untuk ketahanan korosi.'
  },
  'Hidran Pemadam & Adaptor Pompa': {
    applications: ['Jaringan pemadam kebakaran kota', 'Kawasan industri dan halaman gudang', 'Sistem hidran dalam ruangan', 'Instalasi luar ruangan beriklim dingin'],
    testing: 'Uji tekanan hidrostatis (umumnya 2,4 MPa) dan uji aliran sesuai GB 4452 atau standar ekspor yang berlaku.'
  },
  'Sprinkler Pemadam & Katup Alarm': {
    applications: ['Sistem sprinkler otomatis', 'Gedung komersial dan residensial', 'Gudang industri', 'Sistem deluge dan pra-aksi risiko tinggi'],
    testing: 'Pengujian tekanan dan kekedapan sesuai seri GB 5135; sensitivitas alarm diverifikasi dengan sakelar aliran dan bel alarm.'
  },
  'Katup Kontrol Hidrolik': {
    applications: ['Pengaturan level tangki', 'Manajemen tekanan jaringan air', 'Perlindungan anti-balik air minum', 'Perlindungan isapan pompa'],
    testing: 'Pengujian fungsi dan tekanan sesuai standar yang berlaku; set diafragma dan penyekat diuji untuk ketahanan.'
  },
  'Monitor Pemadam & Meriam Air': {
    applications: ['Pabrik petrokimia dan tangki timbunan', 'Bandara dan pusat pameran', 'Gudang berukuran besar', 'Mobil pemadam dan pemadaman kapal'],
    testing: 'Pengujian aliran, jangkauan semburan, dan rotasi; model tahan ledakan diverifikasi sesuai standar Ex (opsional).'
  },
  'Gulungan Selang & Lemari Hidran': {
    applications: ['Pos pemadam dalam ruangan', 'Area penyimpanan bahan kimia dan bahan bakar', 'Sistem selang kebakaran gedung', 'Instalasi maritim dan lepas pantai'],
    testing: 'Pengujian tekanan dan fungsi gulungan, moncong, dan pencampur takar; rasio pengembangan busa diverifikasi per model.'
  }
};

// FAQ produk lebih diutamakan; jika tidak ada, pakai FAQ umum per kategori
const faqs = product.faqs ?? faqByCategory[product.category] ?? [];
const info = categoryInfo[product.category];

// Vídeo do produto (opcional): renderizado + JSON-LD VideoObject quando os dados configuram
const videoData = product.video
  ? {
      name: `${product.name} — Gambaran Umum Video`,
      description: product.video.description ?? `Gambaran video ${product.name}: konstruksi, dimensi utama, dan poin-poin instalasi.`,
      thumbnail: product.video.poster ?? product.image,
      src: product.video.src,
      duration: product.video.duration ?? 'PT2M0S',
      uploadDate: product.video.uploadDate ?? '2026-09-21'
    }
  : undefined;
// Related em fechamento por família de produtos; produtos sem família usam interlinking por categoria
const bySlug = new Map(productsId.map(p => [p.slug, p]));
const familySlugs = PRODUCT_FAMILY_RELATED[product.slug] ?? [];
const relatedProducts = familySlugs.length
  ? familySlugs.map(s => bySlug.get(s)).filter((p): p is typeof productsId[number] => Boolean(p))
  : productsId.filter(p => p.category === product.category && p.slug !== product.slug).slice(0, 4);
const catAnchor = encodeURIComponent(product.category);

// Tautan panduan pembelian per kategori
const guideByCategory: Record<string, { href: string; title: string; description: string }[]> = {
  'Katup Industri & Saringan (Strainer)': [
    { href: '/id/guides/gate-valve-vs-butterfly-valve-fire-protection/', title: 'Katup Gerbang vs. Katup Kupu untuk Proteksi Kebakaran', description: 'Perbandingan penyekatan, aliran, kehilangan tekanan, dan biaya untuk memilih katup isolasi yang tepat pada jaringan kebakaran dan perpipaan air.' },
    { href: '/id/guides/check-valve-types-guide/', title: 'Jenis-Jenis Katup Cek dan Panduan Pemilihannya', description: 'Cek bola apung vs. kupu-kupu terayun (clapper) — kehilangan tekanan, perilaku penutupan, dan aplikasi ideal masing-masing tipe.' }
  ],
  'Hidran Pemadam & Adaptor Pompa': [
    { href: '/id/guides/how-to-choose-a-fire-hydrant/', title: 'Cara Memilih Hidran Pemadam Kebakaran', description: 'Dalam vs. luar ruangan, pilar kering vs. basah, standar sambungan keluar, dan kelas tekanan untuk proyek kota dan industri.' },
    { href: '/id/guides/fire-hydrant-valve-standards-guide/', title: 'Penjelasan Standar Hidran, Selang, dan Katup', description: 'AWWA C502, NFPA 1961, EN 14384, BS 750 — standar mana yang berlaku untuk pesanan Anda dan cara memverifikasi kepantauhan.' }
  ],
  'Sprinkler Pemadam & Katup Alarm': [
    { href: '/id/guides/fire-sprinkler-control-valve-types/', title: 'Jenis Katup Kontrol Jaringan Sprinkler: OS&Y, Kupu, dan Cek', description: 'Peran tiap katup kontrol pada jaringan sprinkler dan bagaimana katup OS&Y, kupu, serta cek bekerja bersamaan.' },
    { href: '/id/guides/fire-sprinkler-system-wet-dry-preaction/', title: 'Sistem Sprinkler: Basah, Kering, atau Pra-Aksi?', description: 'Bandingkan konfigurasi sistem sprinkler basah, kering, dan pra-aksi sesuai kelas risiko gedung Anda.' }
  ],
  'Katup Kontrol Hidrolik': [
    { href: '/id/guides/pressure-reducing-valve-guide/', title: 'Panduan Katup Pengurang Tekanan: PRV Hidrolik 500X', description: 'Bagaimana katup pengurang berpilot melindungi peralatan hilir, mengatur tekanan, dan mencegah palu air.' },
    { href: '/id/guides/backflow-prevention-guide/', title: 'Panduan Pencegahan Aliran Balik', description: 'Kapan jaringan air minum membutuhkan set dual check dan bagaimana HS41X melindungi dari aliran balik.' }
  ],
  'Monitor Pemadam & Meriam Air': [
    { href: '/id/guides/fire-water-monitor-selection-guide/', title: 'Pemilihan Monitor Pemadam: Manual vs. Pelacak Otomatis', description: 'Monitor manual PS vs. meriam pelacak otomatis ZDMS — aliran, jangkauan, pengendalian, dan opsi tahan ledakan.' },
    { href: '/id/guides/fire-water-cannon-buying-guide/', title: 'Panduan Pembelian Meriam Air Pemadam Kebakaran', description: 'Statis, jarak jauh, atau cerdas? Jangkauan semburan, aliran, dan faktor pemasangan untuk pemadaman api di ruang luas.' }
  ],
  'Gulungan Selang & Lemari Hidran': [
    { href: '/id/guides/fire-hose-reel-cabinet-guide/', title: 'Panduan Pemilihan Gulungan Selang dan Lemari Hidran', description: 'Gulungan JPS0.8-19, lemari busa PSG30, dan katup hidran SN65 — kebutuhan lengkap pos pemadam dalam ruangan.' },
    { href: '/id/guides/fire-extinguisher-selection-guide/', title: 'Panduan Pembelian Alat Pemadam Ringan: Serbuk Kimia ABC', description: 'Cakupan kelas A/B/C/E, klasifikasi ISO 7165, dan pengemasan ekspor B2B untuk APAR portabel.' }
  ]
};

const relatedGuides = (guideByCategory[product.category] ?? []).slice(0, 3);
---

<Layout
  locale="id"
  title={product.seoTitle}
  description={product.seoDescription}
  productData={product}
  type="product"
  faq={faqs}
  video={videoData}
  breadcrumbs={[{ name: 'Produk', href: '/id/products/' }, { name: product.category, href: `/id/products/#category=${catAnchor}` }, { name: product.name }]}
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 mb-20">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-8 flex gap-2">
      <a href="/id/" class="hover:text-blue-600">Beranda</a>
      <span>/</span>
      <a href="/id/products/" class="hover:text-blue-600">Produk</a>
      <span>/</span>
      <a href={`/id/products/#category=${catAnchor}`} class="hover:text-blue-600">{product.category}</a>
      <span>/</span>
      <span class="text-gray-600">{product.name}</span>
    </nav>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Product Image -->
      <div class="relative overflow-hidden bg-white p-4 rounded-2xl shadow-sm border border-gray-100">
        <img
          src={product.image}
          alt={product.name}
          class="w-full h-auto rounded-xl object-contain aspect-square"
        />
        <span aria-hidden="true" class="pointer-events-none select-none absolute inset-0 flex items-center justify-center overflow-hidden">
          <span class="text-7xl font-black tracking-[0.3em] text-brand-blue/[0.06] -rotate-[24deg] whitespace-nowrap">WANLIAN FLUID</span>
        </span>
      </div>

      <!-- Vídeo do produto (apenas quando os dados configuram product.video) -->
      {product.video && (
        <div class="mt-4 rounded-2xl overflow-hidden shadow-sm border border-gray-100 bg-gray-900">
          <video class="w-full h-auto" controls playsinline preload="metadata" poster={product.video.poster}>
            <source src={product.video.src} type="video/mp4" />
            Browser Anda tidak mendukung video tersemat.
          </video>
        </div>
      )}

      <!-- Product Details -->
      <div class="space-y-6">
        <div>
          <span class="text-blue-600 font-semibold uppercase tracking-wider text-sm">{product.category}</span>
          <h1 class="text-4xl font-bold text-gray-900 mt-2">{product.name}</h1>
        </div>

        <div class="text-lg text-gray-600 leading-relaxed space-y-4">
          {product.description.split('\n\n').map(paragraph => (
            <p>{paragraph}</p>
          ))}
        </div>

        <div class="space-y-4">
          <h2 class="text-xl font-bold border-b pb-2">Fitur Utama</h2>
          <ul class="grid grid-cols-1 gap-2">
            {product.features.map(feature => (
              <li class="flex items-start">
                <svg class="h-6 w-6 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-700">{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-gray-100 p-6 rounded-xl space-y-4">
          <h2 class="text-xl font-bold">Spesifikasi Teknis</h2>
          <dl class="grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2">
            {Object.entries(product.specs).map(([key, value]) => (
              <div class="border-b border-gray-200 py-2">
                <dt class="text-sm font-medium text-gray-500">{key}</dt>
                <dd class="mt-1 text-sm font-bold text-gray-900">{value}</dd>
              </div>
            ))}
          </dl>
        </div>

        {product.materials && (
          <div class="bg-gray-50 p-6 rounded-xl border border-gray-200/60 space-y-4">
            <h2 class="text-xl font-bold text-gray-900">Daftar Suku Cadang dan Material</h2>
            <dl class="grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2">
              {Object.entries(product.materials).map(([part, material]) => (
                <div class="border-b border-gray-200/60 py-2 flex justify-between items-center text-sm">
                  <dt class="font-medium text-gray-500">{part}</dt>
                  <dd class="font-bold text-gray-900 text-right">{material}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {product.dimensions && (
          <div class="bg-white p-6 rounded-xl border border-gray-100 space-y-4 shadow-sm overflow-x-auto">
            <h2 class="text-xl font-bold text-gray-900">Panduan Dimensi Standar</h2>
            <table class="min-w-full divide-y divide-gray-200 text-sm">
              <thead class="bg-gray-50">
                <tr>
                  {product.dimensions.headers.map(header => (
                    <th class="px-3 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">{header}</th>
                  ))}
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                {product.dimensions.rows.map(row => (
                  <tr class="hover:bg-gray-50/50">
                    {row.map(cell => (
                      <td class="px-3 py-3 text-gray-700 font-medium whitespace-nowrap">{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {info && (
          <div class="space-y-4">
            <div class="bg-blue-50/50 p-6 rounded-xl border border-blue-100/50">
              <h2 class="text-xl font-bold text-gray-900 mb-3">Aplikasi</h2>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                {info.applications.map(app => (
                  <li class="flex items-start text-sm text-gray-700">
                    <svg class="h-5 w-5 text-blue-600 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {app}
                  </li>
                ))}
              </ul>
            </div>
            <div class="bg-gray-50 p-6 rounded-xl border border-gray-200/60">
              <h2 class="text-xl font-bold text-gray-900 mb-3">Aplikasi dan Pengujian</h2>
              <p class="text-sm text-gray-700 leading-relaxed">{info.testing}</p>
            </div>
          </div>
        )}

        <div class="flex flex-col sm:flex-row gap-4 pt-6">
          <a
            href={`/id/contact/?product=${encodeURIComponent(product.name)}`}
            class="flex-1 text-center py-4 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition shadow-lg shadow-blue-600/20"
          >
            Minta Penawaran
          </a>
          <a
            href={`/id/contact/?product=${encodeURIComponent('Minta Katalog PDF')}`}
            class="flex-1 text-center py-4 bg-white text-blue-600 font-bold border-2 border-blue-600 rounded-xl hover:bg-blue-50 transition"
          >
            Minta Dokumentasi Produk
          </a>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    {faqs.length > 0 && (
      <section class="mt-20 max-w-4xl">
        <h2 class="text-3xl font-black text-gray-900 mb-8">Pertanyaan Umum</h2>
        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <details class="group bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer px-6 py-5 font-bold text-gray-900 hover:bg-gray-50 transition list-none">
                <span>{faq.question}</span>
                <svg class="w-5 h-5 text-gray-400 group-open:rotate-45 transition-transform flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
              </summary>
              <div class="px-6 pb-6 text-gray-600 leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Guides (backlinks GEO) -->
    {relatedGuides.length > 0 && (
      <section class="mt-20">
        <h2 class="text-3xl font-black text-gray-900 mb-8">Panduan Pembelian Terkait</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedGuides.map(guide => (
            <a href={guide.href} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-6 flex flex-col">
              <span class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-2">Panduan Pembelian</span>
              <h3 class="text-sm font-bold text-gray-900 group-hover:text-brand-blue transition leading-snug">{guide.title}</h3>
              <p class="text-xs text-gray-500 leading-relaxed mt-2 flex-grow">{guide.description}</p>
              <span class="mt-4 inline-flex items-center text-brand-red font-bold text-xs group-hover:gap-1 transition-all">
                Baca Panduan
                <svg class="w-3.5 h-3.5 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <section class="mt-20">
        <h2 class="text-3xl font-black text-gray-900 mb-8">Produk Terkait</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {relatedProducts.map(related => (
            <a href={`/id/products/${related.slug}/`} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-6 flex flex-col">
              <img src={related.image} alt={related.name} class="w-full h-40 object-contain rounded-lg bg-gray-50 p-2 mb-4" loading="lazy" />
              <span class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-2">{related.category}</span>
              <h3 class="text-sm font-bold text-gray-900 group-hover:text-brand-blue transition leading-snug">{related.name}</h3>
              <span class="mt-4 inline-flex items-center text-brand-red font-bold text-xs group-hover:gap-1 transition-all">
                Lihat Detail
                <svg class="w-3.5 h-3.5 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
