---
import Layout from '../../../layouts/Layout.astro';
import { productsId } from '../../../utils/products.id';

// Get all unique categories
const categories = ['Semua', ...new Set(productsId.map(p => p.category))];

// ItemList JSON-LD (PT): 45 produtos + 3 páginas temáticas (prefixo /id/)
const itemCatalog = [
  ...[...productsId].sort((a, b) => a.slug.localeCompare(b.slug)).map(p => ({
    name: p.name,
    url: `https://wanlian911.com/id/products/${p.slug}/`
  })),
  { name: 'Sistem Sprinkler Pemadam Kebakaran', url: 'https://wanlian911.com/id/fire-sprinkler-systems/' },
  { name: 'Monitor Pemadam Kebakaran', url: 'https://wanlian911.com/id/fire-water-cannon/' },
  { name: 'Katup Pemadam Bersertifikat UL', url: 'https://wanlian911.com/id/ul-fire-valves/' }
];
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Katalog Produk Wanlian Fluid',
  description: 'Katalog lengkap katup, hidran, selang kebakaran, sprinkler, dan peralatan proteksi kebakaran produksi Quanzhou Wanlian Fluid Equipment Co., Ltd.',
  itemListElement: itemCatalog.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    url: item.url
  }))
};

// FAQ de compra do catálogo (também sae como JSON-LD FAQPage)
const faqs = [
  { question: 'Apakah daftar produk di halaman ini adalah katalog lengkap?', answer: 'Halaman ini mencantumkan lebih dari 43 model yang tersedia di gudang, mencakup katup, hidran, katup jaringan sprinkler, gulungan selang, alat pemadam api ringan (APAR), dan monitor pemadam. Lini produksi kami lebih luas — jika model, ukuran, atau material spesifik yang Anda cari tidak ditemukan, kirimkan pertanyaan dan tim teknis kami akan mengonfirmasi ketersediaan serta alternatif yang setara.' },
  { question: 'Berapa MOQ untuk katup dan peralatan proteksi kebakaran?', answer: 'MOQ standar umumnya 20 unit per model untuk ukuran yang tersedia di gudang, dengan waktu produksi 15 hingga 30 hari sesuai kuantitas dan tingkat kustomisasi. Pesanan sampel tersedia untuk pengujian dan persetujuan sebelum pengiriman.' },
  { question: 'Apakah produk dapat dikustomisasi untuk standar dan koneksi ekspor?', answer: 'Ya. Katup dan hidran dapat diproduksi menurut standar GB, ANSI, DIN, JIS, BS, atau EN, dengan koneksi flens, alur (grooved), tipe wafer, atau ulir. Material, lapisan, dan sertifikasi (UL/FM/CE pada model yang berlaku) dapat disesuaikan dengan spesifikasi proyek Anda.' },
  { question: 'Dokumentasi apa saja yang disertakan dengan pemesanan?', answer: 'Setiap pengiriman menyertakan dokumen komersial, ditambah laporan pengujian per batch sesuai standar yang berlaku. Sertifikat ISO 9001, sertifikat material, dan laporan inspeksi pihak ketiga dapat diatur dan dicantumkan dalam purchase order.' },
  { question: 'Bagaimana cara meminta penawaran harga?', answer: 'Gunakan formulir konsultasi di halaman kontak dan cantumkan model, ukuran, kelas tekanan, jenis koneksi, kuantitas, dan tujuan pengiriman. Tim penjualan dan teknik kami menjawab dalam waktu hingga 12 jam beserta spesifikasi, harga, dan waktu pengiriman.' }
];
---

<Layout locale="id" faq={faqs} title="Katalog Produk | Katup Industri & Proteksi Kebakaran" description="Katalog B2B Wanlian Fluid: 43+ model katup, hidran, sprinkler, gulungan selang, dan katup hidrolik. Penawaran melalui konsultasi.">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 mb-20">
    <div class="text-center mb-8 space-y-3">
      <span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Centro de Produk</span>
      <h1 class="text-4xl font-black text-gray-900 tracking-tight">Katalog Sistem Fluida Premium Kami</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
        Komponen berperforma tinggi yang dirancang untuk keandalan, ketahanan, dan keamanan maksimal di seluruh jaringan industri.
      </p>
    </div>

    <!-- Browse by System: entrada das páginas temáticas por sistem -->
    <div class="flex flex-wrap justify-center items-center gap-2 mb-6">
      <span class="text-[11px] font-black uppercase tracking-widest text-gray-400 mr-1">Jelajahi berdasarkan Sistem:</span>
      <a href="/id/fire-hydrant-systems/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600 hover:border-brand-red hover:text-brand-red transition">Sistem Hidran</a>
      <a href="/id/fire-sprinkler-systems/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600 hover:border-brand-red hover:text-brand-red transition">Sistem Sprinkler</a>
      <a href="/id/fire-water-cannon/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600 hover:border-brand-red hover:text-brand-red transition">Monitor Pemadam</a>
      <a href="/id/backflow-prevention/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600 hover:border-brand-red hover:text-brand-red transition">Pencegahan Aliran Balik</a>
      <a href="/id/ul-fire-valves/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600 hover:border-brand-red hover:text-brand-red transition">Katup UL Proteksi Kebakaran</a>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap justify-center items-center gap-2 mb-10" id="filter-container">
      <span class="text-[11px] font-black uppercase tracking-widest text-gray-400 mr-1">Filter berdasarkan kategori:</span>
      {categories.map((category) => (
        <button
          data-category={category}
          class="px-5 py-2.5 rounded-lg text-sm font-semibold tracking-wide border border-gray-200 text-gray-600 bg-white hover:border-blue-500 hover:text-blue-600 transition cursor-pointer filter-btn [&.active]:bg-blue-600 [&.active]:text-white [&.active]:border-blue-600"
        >
          {category}
        </button>
      ))}
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="products-grid">
      {productsId.map((product) => (
        <div
          data-product-category={product.category}
          class="group bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-all duration-300 flex flex-col product-card"
        >
          <div class="aspect-square relative overflow-hidden bg-white">
            <img
              src={product.image}
              alt={product.name}
              loading="lazy"
              class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform duration-500"
            />
            <span class="absolute top-3 left-3 px-2.5 py-1 text-[10px] font-bold tracking-widest bg-gray-900/90 text-white rounded-md uppercase">
              {product.category}
            </span>
          </div>
          <div class="p-6 flex-grow flex flex-col space-y-3">
            <h2 class="text-lg font-bold text-gray-900 line-clamp-2 min-h-[3rem] group-hover:text-blue-600 transition">
              {product.name}
            </h2>
            <p class="text-gray-500 text-xs line-clamp-3 leading-relaxed flex-grow">
              {product.description}
            </p>
            <div class="pt-6 border-t border-gray-100 flex items-center justify-between gap-4">
              <a
                href={`/id/products/${product.slug}/`}
                class="text-blue-600 text-sm font-bold hover:text-blue-700 inline-flex items-center gap-1 group/btn"
              >
                Lihat Spesifikasi
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transform group-hover/btn:translate-x-1 transition" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
              <a
                href={`/id/contact/?product=${encodeURIComponent(product.name)}`}
                class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-lg transition"
              >
                Konsultasi
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Catalog FAQ Section -->
    <section class="mt-24 max-w-4xl mx-auto">
      <h2 class="text-3xl font-black text-gray-900 mb-8 text-center">Pertanyaan Umum Katalog</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="group bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-5 font-bold text-gray-900 hover:bg-gray-50 transition list-none">
              <span>{faq.question}</span>
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-45 transition-transform flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="px-6 pb-6 text-gray-600 leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <!-- ItemList structured data (①) -->
  <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />

  <!-- Client-side filtering script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.product-card');

      const applyFilter = (category) => {
        buttons.forEach(b => b.classList.toggle('active', b.getAttribute('data-category') === category));
        cards.forEach(card => {
          const cardCategory = card.getAttribute('data-product-category');
          card.style.display = (category === 'Semua' || cardCategory === category) ? 'flex' : 'none';
        });
      };

      // Set 'Semua' button as active initially
      applyFilter('Semua');

      // Suporta links diretos /id/products/#category=xxx (mantém a URL fora da query string indexável)
      const hashMatch = window.location.hash.match(/^#category=(.+)$/);
      if (hashMatch) {
        const target = decodeURIComponent(hashMatch[1]);
        if ([...buttons].some(b => b.getAttribute('data-category') === target)) {
          applyFilter(target);
        }
      }

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          applyFilter(btn.getAttribute('data-category'));
        });
      });
    });
  </script>
</Layout>

