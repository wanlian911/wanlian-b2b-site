---
import Layout from '../../../layouts/Layout.astro';
const faq = [{ question: 'Mengapa alat ini menampilkan indeks?', answer: 'Wanlian Fluid menyediakan penawaran berdasarkan permintaan. Indeks relatif membantu membandingkan volume, Incoterm, dan tujuan; indeks ini bukan daftar harga.' }, { question: 'Apakah indeks ini merupakan penawaran akhir?', answer: 'Bukan. Harga aktual bergantung pada model, ukuran, material, standar, jumlah, dan tujuan, lalu dikonfirmasi melalui penawaran terperinci.' }];
---
<Layout title="Kalkulator Biaya: Katup dan Hidran" description="Alat interaktif untuk memperkirakan indeks biaya relatif berdasarkan jumlah, Incoterm, dan tujuan." type="website" locale="id" faq={faq} breadcrumbs={[{ name: 'Sumber daya' }, { name: 'Kalkulator biaya' }]}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/id/">Beranda</a><span>/</span><span class="text-gray-600">Kalkulator biaya</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Alat interaktif</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Kalkulator biaya katup dan hidran</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Perkirakan <strong>indeks biaya relatif sampai tujuan</strong> dengan menyesuaikan jumlah, Incoterm, dan tujuan. Basis 100 = satu hidran, EXW, tujuan Asia Timur.</p><div class="bg-amber-50 border border-amber-200 rounded-xl p-4 my-6"><p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-red">Penting:</strong> indeks ini hanya untuk perencanaan. Penawaran akhir bergantung pada model, ukuran, material, standar, dan jumlah yang tepat.</p></div><div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 sm:p-8 my-6"><h2 class="text-lg font-black text-gray-900 mb-4">1 · Atur lot</h2><div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="line-items"><label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3"><span class="text-sm font-semibold text-gray-800">Hidran (SS100)</span><input type="number" min="0" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="100"/></label><label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3"><span class="text-sm font-semibold text-gray-800">Katup gerbang (Z41X)</span><input type="number" min="0" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="70"/></label><label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3"><span class="text-sm font-semibold text-gray-800">Katup kupu-kupu (D71X)</span><input type="number" min="0" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="55"/></label><label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3"><span class="text-sm font-semibold text-gray-800">Katup alarm (ZSFZ)</span><input type="number" min="0" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="130"/></label></div><h2 class="text-lg font-black text-gray-900 mt-8 mb-4">2 · Pilih kondisi pengiriman</h2><div class="grid grid-cols-1 sm:grid-cols-2 gap-4"><label class="text-sm font-semibold text-gray-800">Incoterm<select id="incoterm" class="mt-2 w-full border border-gray-200 rounded-lg px-3 py-2 font-normal"><option value="1">EXW</option><option value="1.08">FOB</option><option value="1.22">CIF</option><option value="1.38">DDP</option></select></label><label class="text-sm font-semibold text-gray-800">Tujuan<select id="region" class="mt-2 w-full border border-gray-200 rounded-lg px-3 py-2 font-normal"><option value="1">Asia Timur</option><option value="1.12">Asia Tenggara</option><option value="1.25">Eropa</option><option value="1.32">Amerika</option></select></label></div><button id="estimate" class="mt-6 px-8 py-3 bg-brand-red text-white font-bold rounded-lg">Hitung indeks</button></div><div id="result" class="hidden bg-blue-50 border border-blue-100 rounded-2xl p-6 sm:p-8 my-6"><p class="text-sm text-brand-blue font-bold uppercase tracking-wider">Indeks biaya relatif</p><p id="index-value" class="text-5xl font-black text-gray-900 mt-2">0</p><p class="text-sm text-gray-600 mt-3">Unit: <span id="units-label">0</span> · <span id="incoterm-label"></span> · <span id="region-label"></span></p><p id="drivers" class="text-sm text-gray-600 leading-relaxed mt-4"></p></div><div class="mt-10"><h2 class="text-2xl font-black text-gray-900 mb-4">Perlu harga aktual?</h2><p class="text-gray-600 leading-relaxed">Kirimkan model, ukuran, material, standar, jumlah, dan tujuan kepada tim kami untuk memperoleh penawaran B2B terperinci.</p><a href="/id/contact/" class="inline-block mt-6 px-8 py-4 bg-brand-red text-white font-bold rounded-lg">Minta penawaran</a></div><h2 class="text-2xl font-black text-gray-900 mt-12 mb-6">Pertanyaan umum</h2><div class="space-y-4">{faq.map(item => <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5"><summary class="font-bold text-gray-800 cursor-pointer list-none">{item.question}</summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>)}</div></article>
  </main>
</Layout>
<script>function estimate(){const inputs=[...document.querySelectorAll('.qty')];let base=0,units=0;for(const i of inputs){const q=Math.max(0,parseInt(i.value||'0',10));base+=q*parseFloat(i.dataset.index||'0');units+=q}const result=document.getElementById('result');result.classList.remove('hidden');const inc=document.getElementById('incoterm');const reg=document.getElementById('region');const mult=units<10?1:units<100?.9:units<1000?.82:.75;document.getElementById('index-value').textContent=String(Math.round(base*mult*parseFloat(inc.value)*parseFloat(reg.value)));document.getElementById('units-label').textContent=String(units);document.getElementById('incoterm-label').textContent=inc.options[inc.selectedIndex].text;document.getElementById('region-label').textContent=reg.options[reg.selectedIndex].text;document.getElementById('drivers').textContent=units?'Indeks relatif untuk perencanaan; kirim spesifikasi untuk memperoleh harga aktual.':'Tambahkan setidaknya satu item untuk menghitung indeks.'}document.getElementById('estimate').addEventListener('click',estimate)</script>
