---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Apakah Anda menyediakan pompa pemadamnya sendiri?',
		answer: 'Tidak. Wanlian menyediakan adaptor, katup, dan peralatan sambungan terkait di sekitar set pompa pemadam yang disediakan pihak lain. Pemasok pompa menyediakan pemilihan pompa dan kurva tersertifikasi; kami memakai masukan proyek itu untuk mengoordinasikan komponen di sekitarnya.'
	},
	{
		question: 'Apa itu adaptor pompa pemadam sambungan Siamese?',
		answer: 'Adaptor Pompa Pemadam SQD100-1.6 adalah sambungan Siamese untuk petugas kebakaran dengan dua inlet DN65 dan satu outlet flensa DN100, ditambah katup kontrol terintegrasi, untuk pasokan air mobil pemadam ke jaringan proteksi kebakaran.'
	},
	{
		question: 'Katup mana yang berada di sisi hisap pompa?',
		answer: 'Susunan hisap ditetapkan oleh desain ruang pompa yang disetujui dan pihak yang berwenang. Isolasi biasanya dibiarkan terbuka penuh selama pompa beroperasi; konfirmasi tipe, ukuran, dan sambungan katup yang dipilih bersama pemasok pompa dan perencana.'
	},
	{
		question: 'Ke mana katup searah pada sisi buang dipasang?',
		answer: 'Katup searah pada sisi buang dikoordinasikan antara set pompa pemadam dari pihak lain dan katup isolasi buang untuk membatasi aliran balik. Lokasi akhir, ukuran, dan kelas tekanan mengikuti tata letak pipa yang disetujui dan data pemasok pompa.'
	},
	{
		question: 'Dapatkah katup penurun tekanan menggantikan kontrol pompa?',
		answer: 'Tidak. 500X adalah katup penurun tekanan hidrolik untuk mengelola tekanan hilir pada jalur air; katup ini bukan pengganti pengendali pompa pemadam, susunan pengaman pompa, atau desain sistem tersertifikasi pemasok pompa.'
	},
	{
		question: 'Informasi apa yang perlu saya kirim untuk penawaran paket ruang pompa?',
		answer: 'Kirimkan data debit dan head dari pemasok pompa, ukuran pipa hisap dan buang, standar sambungan, susunan uji, standar inlet petugas kebakaran, sertifikasi yang diminta, serta jadwal atau gambar katup.'
	}
];

const products = [
	{
		slug: 'sqd100-1-6-fire-pump-adapter',
		name: 'SQD100-1.6 Fire Pump Adapter (Siamese Connection)',
		img: '/assets/products/sqd100-1-6-fire-pump-adapter.webp',
		desc: '2 inlet DN65, outlet flensa DN100, 1.6 MPa'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'UL/FM Fire Protection Resilient Seated OS&Y Gate Valve',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: '2"–10", ujung beralur, batang naik, tercatat UL / FM'
	},
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Ductile Iron Resilient Seat Flanged Gate Valve (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'DN50–DN700, PN10 / PN16, besi ulet, berflensa'
	},
	{
		slug: 'spherical-ball-check-valve-hq44x',
		name: 'Spherical Cast Iron Ball Check Valve (HQ44X-16)',
		img: '/assets/products/spherical-ball-check-valve-hq44x.webp',
		desc: 'DN50–DN400, PN16, bola EPDM tidak mudah tersumbat'
	},
	{
		slug: 'adjustable-pressure-reducing-valve-500x',
		name: 'Hydraulic Adjustable Pressure Reducing Valve (500X)',
		img: '/assets/products/pressure-reducing-valve-500x-dn50.webp',
		desc: 'DN20–DN600, penyetelan 0.1–1.6 MPa, pilot hidrolik'
	}
];
---

<Layout
	title="Adaptor Pompa Pemadam, Siamese & Katup | WLFE"
	description="Adaptor pompa pemadam, sambungan Siamese, dan katup ruang pompa untuk susunan hisap, buang, dan uji di sekitar set pompa pemadam dari pihak lain."
	type="product"
	locale="id"
	productData={{
		name: 'Sambungan Pompa Pemadam dan Katup Ruang Pompa',
		image: '/assets/products/sqd100-1-6-fire-pump-adapter.webp',
		description: 'Sambungan petugas kebakaran, adaptor pompa, katup gerbang, katup searah, dan komponen kontrol tekanan untuk paket ruang pompa pemadam yang terkoordinasi.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Sambungan Pompa Pemadam' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/id/" class="hover:text-blue-600">Beranda</a>
			<span>/</span>
			<a href="/id/products/" class="hover:text-blue-600">Produk</a>
			<span>/</span>
			<span class="text-gray-600">Sambungan Pompa Pemadam</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Katup Ruang Pompa dan Sambungan Petugas Kebakaran</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Paket Adaptor Pompa Pemadam dan Katup Ruang Pompa</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Ruang pompa pemadam lebih dari sekadar pompa: ruang ini adalah susunan hisap, buang, searah, isolasi, dan uji yang membuat set pompa pemadam dari pemasok beroperasi dengan aman serta memungkinkan petugas kebakaran menambahkan air melalui sambungan Siamese yang cocok. Wanlian menyediakan katup dan sambungan di sekitarnya; set pompa pemadam disediakan pihak lain.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Adaptor Siamese', 'Isolasi Hisap', 'Searah Buang', 'Set Pompa dari Pihak Lain'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span></div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Komponen Sambungan Pompa Pemadam</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{products.map(p => (
					<a href={`/id/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p><p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p></div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Tabel Pemilihan Ruang Pompa</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Susunan</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Referensi pemilihan terverifikasi</th></tr></thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">Sambungan petugas kebakaran</td><td class="px-4 py-3 text-gray-700">SQD100-1.6: dua inlet DN65 dengan tutup SQS65 / KWS65, outlet flensa DN100, 1.6 MPa, katup kontrol terintegrasi.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Katup isolasi</td><td class="px-4 py-3 text-gray-700">Katup gerbang OS&Y UL/FM: 2"–10", ujung beralur, batang naik; katup gerbang berflensa Z41X: DN50–DN700, PN10 / PN16.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Searah buang</td><td class="px-4 py-3 text-gray-700">Katup searah bola bulat HQ44X: DN50–DN400, 1.6 MPa (PN16), saluran aliran tidak mudah tersumbat dan penyegelan EPDM / NBR.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Pengelolaan tekanan</td><td class="px-4 py-3 text-gray-700">Katup penurun tekanan hidrolik 500X: DN20–DN600; rentang penyetelan 0.1–1.6 MPa; konfirmasi peran pada desain hilir yang disetujui.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Data pompa dan uji</td><td class="px-4 py-3 text-gray-700">Sediakan data debit/head pemasok pompa, ukuran pipa, susunan uji, dan persyaratan persetujuan yang berlaku sebelum penentuan ukuran katup akhir.</td></tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Yang Perlu Masuk dalam Satu Pesanan Ruang Pompa</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2">
				<li><strong>Titik sambungan</strong> — standar inlet Siamese, flensa outlet, susunan tutup, dan sambungan petugas kebakaran.</li>
				<li><strong>Set hisap dan buang</strong> — katup isolasi, katup searah, dan setiap item kontrol tekanan yang cocok dengan jadwal pipa yang disetujui.</li>
				<li><strong>Rincian uji dan pengoperasian</strong> — susunan header uji atau outlet uji, instrumen dari pihak lain bila berlaku, dan kurva tersertifikasi pemasok pompa.</li>
				<li><strong>Paket dokumen submittal</strong> — gambar, data produk, sertifikat, dimensi sambungan, kelas tekanan, dan penandaan pasar tujuan.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Sumber Desain Ruang Pompa</h2>
			<p class="text-gray-700 leading-relaxed">Gunakan <a href="/id/guides/fire-pump-suction-water-tank-guide/" class="text-brand-blue font-semibold hover:underline">panduan katup ruang pompa pemadam</a> untuk perencanaan hisap, buang, dan uji, serta <a href="/id/guides/fire-department-connection-siamese-guide/" class="text-brand-blue font-semibold hover:underline">panduan sambungan Siamese petugas kebakaran</a>, dan <a href="/id/guides/check-valve-types-guide/" class="text-brand-blue font-semibold hover:underline">panduan jenis katup searah</a> ketika menyiapkan jadwal katup.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Pertanyaan yang Sering Diajukan</h2>
			<div class="space-y-4">{faq.map(item => (<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>))}</div>

			<div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white tracking-tight">Butuh Paket Sambungan Pompa Pemadam?</h2><p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Kirimkan data debit/head pemasok pompa dan jadwal katup Anda — kami mengoordinasikan paket adaptor dan katup terverifikasi dalam 12 jam.</p><div class="mt-6 flex flex-col sm:flex-row justify-center gap-4"><a href="/id/contact/?product=Sambungan%20Pompa%20Pemadam" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Minta Penawaran</a><a href="https://wa.me/8618684324501?text=Halo%2C%20saya%20butuh%20sambungan%20pompa%20pemadam" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat via WhatsApp</a></div></div></div>
		</article>
	</main>
</Layout>
