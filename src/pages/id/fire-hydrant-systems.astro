---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Apa a diferença entre hidran internos e externos proteksi kebakaran?',
		answer: 'Hidran internos (boca SN65) conectam-se aos sistems de coluna (montante) de edifícios e alimentam estações de mangueira em cada andar. Hidran externos (tipo coluna SS100) alimentam-se de redes municipais ou industriais e abastecem caminhões de bombeiro e o combate a incêndio externo. Os dois atendem a pontos de distribuição diferentes e são especificados sesuai normas diferentes.'
	},
	{
		question: 'Apa saja normas de conexão de saída estão tersedia para hidran de exportação?',
		answer: 'As conexões de saída comuns incluem BS336 (Reino Unido/Commonwealth), NIST (Oriente Médio), KWS (Alemanha) e opções de flange flexível. A Wanlian memproduksi hidran SS100/65 e SSFT100/65 com o tipo de conexão especificado para o Anda mercado, e pode enviar acoplamentos e adaptadores correspondentes no mesmo contêiner.'
	},
	{
		question: 'Os hidran Wanlian estão tersedia com sertifikasi UL ou FM?',
		answer: 'Ya, dependendo do modelo e do mercado de destino. Contate kami equipe comercial com a especificação do Anda projeto e a região-alvo para selecionarmos o pacote de sertifikasi correto — UL/FM para a América do Norte, CE para a Europa, LPCB para projetos do Reino Unido/Commonwealth.'
	},
	{
		question: 'Apa hidrante devo escolher para uma cidade de clima frio?',
		answer: 'O hidrante de coluna SS100 tem um mecanismo de dreno anticongelante otomatis de coluna seca após o fechamento, que impede o congelamento e a ruptura da coluna — a escolha padrão para redes municipais em regiões frias. Para locais expostos ao tráfego, a variante anti-colisão SSFT100 adiciona corpo de fratura e regulação de tekanan.'
	},
	{
		question: 'Hidran inteligentes podem se integrar ao kami sistem SCADA?',
		answer: 'Ya. O hidrante IoT SS100ZN transmite dados de tekanan, inclinação e estado da válvula via NB-IoT/LTE-M/GPRS e integra-se a plataformas SCADA padrão. Solicite a especificação da interface de dados e um dispositivo de amostra para testes de integração antes de fazer o pedido.'
	}
];

const hydrantProducts = [
	{
		slug: 'indoor-fire-hydrant-head-sn65',
		name: 'Boca de Kebakaran Interna SN65',
		img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg',
		desc: 'Hidrante interno PN16 em ferro fundido dúctil para sistems de coluna (montante)'
	},
	{
		slug: 'overground-fire-hydrant-ss100',
		name: 'Hidrante de Coluna Anticongelante (SS100/65)',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'Design de coluna seca anticongelante para redes municipais em clima frio'
	},
	{
		slug: 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100',
		name: 'Hidrante Anti-Colisão Regulador de Tekanan (SSFT100/65)',
		img: '/assets/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100.webp',
		desc: 'Corpo de fratura + regulação de tekanan para pátios e áreas industriais'
	},
	{
		slug: 'iot-smart-ground-fire-hydrant-ss100zn',
		name: 'Hidrante Subterrâneo Inteligente IoT (SS100/65-1.6ZN)',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'Monitoramento em tempo real de tekanan, inclinação e roubo de air'
	},
	{
		slug: 'fire-hydrant-hose-coupling-adapter-hs',
		name: 'Adaptador de Acoplamento de Mangueira em Alumínio (Série HS)',
		img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg',
		desc: 'Acoplamentos compatíveis BS336/NIST/KWS para conexão hidrante-mangueira'
	}
];

const trustBadges = ['PN16 / 2.4 MPa Testado', 'BS336 / NIST / KWS', 'Coluna Seca Anticongelante', 'Pronto IoT / SCADA'];
---

<Layout
	locale="id"
	title="Sistem de Hidran & Katup de Hidrante Municipal - WLFE"
	description="Sistem de hidran: bocas internas SN65, coluna SS100, anti-colisão SSFT100 e inteligentes IoT SS100ZN. PN16, direto da fábrica com conexões para exportação."
	type="product"
	productData={{
		name: 'Sistem de Hidran',
		image: '/assets/products/overground-fire-hydrant-ss100.webp',
		description: 'Katup de hidrante internas e externas e sistems de hidran inteligentes para redes municipais, áreas industriais e sistems de coluna (montante) de edifícios, memproduksidos por Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Sistem de Hidran' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/id/" class="hover:text-blue-600">Beranda</a>
			<span>/</span>
			<a href="/id/products/" class="hover:text-blue-600">Produk</a>
			<span>/</span>
			<span class="text-gray-600">Sistem de Hidran</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Linha Lengkap de Hidran — Fabricada em Própria Fábrica</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Sistem Lengkaps de Hidran para Redes Municipais &amp; Industriais</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">A Wanlian Fluid memproduksi a linha lengkap de hidran proteksi kebakaran — bocas internas SN65, hidran de coluna SS100, hidran anti-colisão SSFT100 e hidran inteligentes IoT SS100ZN — com normas de conexão para exportação (BS336, NIST, KWS) e acoplamentos correspondentes, tudo produzido em kamis próprias linhas de produção para toda a rede de hidran.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Componentes dos Sistem de Hidran</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydrantProducts.map(p => (
					<a href={`/id/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Spesifikasi Utama</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Model</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Jenis</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Característica principal</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Classe</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SN65</td>
							<td class="px-4 py-3 text-gray-700">Boca de hidrante interna</td>
							<td class="px-4 py-3 text-gray-700">Entrada ranurada/flangeada, montagem em armário de parede</td>
							<td class="px-4 py-3 text-gray-700">PN16 (teste 2.4 MPa)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SS100/65</td>
							<td class="px-4 py-3 text-gray-700">Hidrante de coluna</td>
							<td class="px-4 py-3 text-gray-700">Dreno anticongelante otomatis de coluna seca</td>
							<td class="px-4 py-3 text-gray-700">PN16, 2×65mm + 1×100mm saídas</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SSFT100/65</td>
							<td class="px-4 py-3 text-gray-700">Hidrante anti-colisão</td>
							<td class="px-4 py-3 text-gray-700">Corpo de fratura + regulação de tekanan + autoesvaziamento</td>
							<td class="px-4 py-3 text-gray-700">PN16, parafusos de cisalhamento calibrados</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SS100ZN</td>
							<td class="px-4 py-3 text-gray-700">Hidrante inteligente IoT</td>
							<td class="px-4 py-3 text-gray-700">NB-IoT/4G, monitoramento tekanan/inclinação/roubo</td>
							<td class="px-4 py-3 text-gray-700">GB4452-2011, bateria 5 anos</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplikasi</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Redes municipais de abastecimento de air e redes de proteção proteksi kebakaran</li>
				<li>Pátios industriais, parques de tanques e combate a incêndio em armazéns</li>
				<li>Sistem de coluna (montante) e mangueiras de edifícios (bocas internas)</li>
				<li>Redes de cidades inteligentes com requisitos de monitoramento jarak jauh</li>
				<li>Instalações em clima frio que exigem proteção anticongelante</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Pertanyaan Umum</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Membutuhkan uma Rede de Hidran Especificada untuk Proyek Anda?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envie-nos Anda DN/PN, a norma de conexão e a sertifikasi alvo — kami engenheiros respondem com uma datasheet técnica lengkap e cotação em até 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/id/contact/?product=Sistem%20de%20Hidran" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Minta Penawaran</a>
						<a href="https://wa.me/8618684324501?text=Ol%C3%A1%2C%20preciso%20de%20ajuda%20para%20escolher%20um%20sistem%20de%20hidran" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Hubungi via WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>

