---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Apa perbedaan hidran kebakaran dalam dan luar gedung?',
		answer: 'Hidran dalam gedung (kepala SN65) terhubung ke sistem pipa tegak bangunan dan menyuplai stasiun selang di setiap lantai. Hidran luar gedung (SS100 tipe tanah) mengambil air dari jaringan induk kota atau industri dan menyuplai mobil pemadam serta pemadaman dari luar. Keduanya menempati titik distribusi yang berbeda dan ditentukan menurut standar yang berbeda pula.'
	},
	{
		question: 'Standar koneksi keluaran apa saja yang tersedia untuk hidran ekspor?',
		answer: 'Koneksi keluaran yang umum meliputi BS336 (Inggris/Persemakmuran), NIST (Timur Tengah), KWS (Jerman), serta opsi flens fleksibel. Wanlian memproduksi hidran SS100/65 dan SSFT100/65 dengan tipe koneksi yang ditentukan untuk pasar Anda, dan dapat mengirimkan kopling serta adaptor yang cocok dalam satu kontainer.'
	},
	{
		question: 'Apakah hidran Wanlian tersedia dengan sertifikasi UL atau FM?',
		answer: 'Ya, tergantung model dan pasar tujuannya. Hubungi tim penjualan kami bersama spesifikasi proyek dan wilayah target Anda agar kami dapat mencocokkan paket sertifikasi yang tepat — UL/FM untuk Amerika Utara, CE untuk Eropa, dan LPCB untuk proyek di Inggris/Persemakmuran.'
	},
	{
		question: 'Hidran mana yang sebaiknya saya pilih untuk kota beriklim dingin?',
		answer: 'Hidran atas tanah SS100 memiliki mekanisme pembuangan kolom kering otomatis setelah katup menutup, yang mencegah pembekuan dan pecahnya badan hidran — pilihan standar untuk jaringan kota di wilayah dingin. Untuk lokasi yang rawan tertabrak kendaraan, varian anti-tabrak SSFT100 menambahkan badan pemutus dan fungsi pengatur tekanan.'
	},
	{
		question: 'Apakah hidran pintar dapat diintegrasikan dengan sistem SCADA kami?',
		answer: 'Ya. Hidran IoT SS100ZN mengirimkan data tekanan, kemiringan, dan status katup melalui NB-IoT/LTE-M/GPRS serta dapat diintegrasikan dengan platform SCADA standar. Mintalah spesifikasi antarmuka data dan satu unit contoh untuk pengujian integrasi sebelum melakukan pemesanan.'
	}
];

const hydrantProducts = [
	{
		slug: 'indoor-fire-hydrant-head-sn65',
		name: 'Kepala Hidran Dalam Gedung SN65',
		img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg',
		desc: 'Hidran dalam gedung dari besi ulet PN16 untuk sistem pipa tegak'
	},
	{
		slug: 'overground-fire-hydrant-ss100',
		name: 'Hidran Atas Tanah Anti-Beku (SS100/65)',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'Desain kolom kering anti-beku untuk jaringan kota beriklim dingin'
	},
	{
		slug: 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100',
		name: 'Hidran Anti-Tabrak Pengatur Tekanan (SSFT100/65)',
		img: '/assets/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100.webp',
		desc: 'Badan pemutus + pengatur tekanan untuk area lalu lintas dan lahan industri'
	},
	{
		slug: 'iot-smart-ground-fire-hydrant-ss100zn',
		name: 'Hidran Tanah Pintar IoT (SS100/65-1.6ZN)',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'Pemantauan tekanan, kemiringan, dan pencurian air secara langsung untuk jaringan cerdas'
	},
	{
		slug: 'fire-hydrant-hose-coupling-adapter-hs',
		name: 'Adaptor Kopling Selang Aluminium (Seri HS)',
		img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg',
		desc: 'Kopling kompatibel BS336/NIST/KWS untuk koneksi hidran ke selang'
	}
];

const trustBadges = ['Teruji PN16 / 2,4 MPa', 'BS336 / NIST / KWS', 'Kolom Kering Anti-Beku', 'Siap IoT / SCADA'];
---

<Layout
	locale="id"
	title="Sistem Hidran Kebakaran & Katup Hidran Kota - WLFE"
	description="Sistem hidran kebakaran: kepala dalam SN65, hidran atas tanah SS100, anti-tabrak SSFT100, dan hidran pintar SS100ZN. PN16, langsung pabrik, koneksi ekspor."
	type="product"
	productData={{
		name: 'Sistem Hidran Kebakaran',
		image: '/assets/products/overground-fire-hydrant-ss100.webp',
		description: 'Katup hidran kebakaran dalam dan luar gedung serta sistem hidran pintar untuk jaringan kota, lahan industri, dan sistem pipa tegak bangunan, diproduksi oleh Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Sistem Hidran Kebakaran' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/id/" class="hover:text-blue-600">Beranda</a>
			<span>/</span>
			<a href="/id/products/" class="hover:text-blue-600">Produk</a>
			<span>/</span>
			<span class="text-gray-600">Sistem Hidran Kebakaran</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Seluruh Rentang Hidran Kebakaran — Diproduksi Sendiri</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Sistem Hidran Kebakaran Lengkap untuk Jaringan Kota &amp; Industri</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid memproduksi seluruh rentang hidran kebakaran — kepala hidran dalam SN65, hidran atas tanah SS100, hidran anti-tabrak SSFT100, dan hidran pintar SS100ZN — dengan standar koneksi ekspor (BS336, NIST, KWS) beserta kopling yang cocok, semuanya dikerjakan pada lini produksi kami sendiri untuk seluruh jaringan hidran.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Komponen Sistem Hidran Kebakaran</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydrantProducts.map(p => (
					<a href={`/id/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Spesifikasi Utama</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Model</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Tipe</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Fitur Utama</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Kelas</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SN65</td>
							<td class="px-4 py-3 text-gray-700">Kepala hidran dalam gedung</td>
							<td class="px-4 py-3 text-gray-700">Inlet grooved/flens, dudukan pada lemari dinding</td>
							<td class="px-4 py-3 text-gray-700">PN16 (teruji 2,4 MPa)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SS100/65</td>
							<td class="px-4 py-3 text-gray-700">Hidran atas tanah</td>
							<td class="px-4 py-3 text-gray-700">Pembuangan kolom kering anti-beku otomatis</td>
							<td class="px-4 py-3 text-gray-700">PN16, keluaran 2×65mm + 1×100mm</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SSFT100/65</td>
							<td class="px-4 py-3 text-gray-700">Hidran anti-tabrak</td>
							<td class="px-4 py-3 text-gray-700">Badan pemutus + pengatur tekanan + pembuangan mandiri</td>
							<td class="px-4 py-3 text-gray-700">PN16, baut geser terkalibrasi</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SS100ZN</td>
							<td class="px-4 py-3 text-gray-700">Hidran pintar IoT</td>
							<td class="px-4 py-3 text-gray-700">NB-IoT/4G, pemantauan tekanan/kemiringan/pencurian air</td>
							<td class="px-4 py-3 text-gray-700">GB4452-2011, baterai 5 tahun</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplikasi</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Jaringan penyediaan air bersih kota dan pipa induk kebakaran</li>
				<li>Lahan industri, area tangki, dan pemadaman gudang</li>
				<li>Sistem pipa tegak dan selang dalam gedung (kepala hidran dalam)</li>
				<li>Jaringan kota cerdas dengan persyaratan pemantauan jarak jauh</li>
				<li>Pemasangan di wilayah dingin yang membutuhkan perlindungan dari pembekuan</li>
			</ul>

			<!-- Complete the system: riser alarm valves (margin-line cross-sell) -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Lengkapi Sistemnya: Katup Riser &amp; Katup Alarm</h2>
			<p class="text-gray-600 leading-relaxed mb-6">Jaringan hidran hanya akan bekerja bersama katup riser yang menyuplainya. Wanlian memproduksi katup alarm, deluge, dan pra-aksi dalam program besi ulet PN16 yang sama — tentukan hidran dan set katupnya sekaligus, maka semuanya dikirim dalam satu kontainer dengan satu paket catatan pengujian dan satu titik tindak lanjut.</p>
			<div class="grid sm:grid-cols-2 gap-4">
				<a href="/id/products/deluge-alarm-valve-zsfm/" class="group bg-gray-50 rounded-xl border border-gray-100 hover:border-brand-red p-4 transition">
					<p class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-1">Produk</p>
					<p class="text-sm font-bold text-gray-900 group-hover:text-brand-red leading-snug">Katup Alarm Deluge ZSFM (PN16)</p>
				</a>
				<a href="/id/guides/how-to-choose-ul-listed-fire-valves/" class="group bg-gray-50 rounded-xl border border-gray-100 hover:border-brand-red p-4 transition">
					<p class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-1">Panduan</p>
					<p class="text-sm font-bold text-gray-900 group-hover:text-brand-red leading-snug">Cara Memilih Katup Kebakaran Terdaftar UL</p>
				</a>
			</div>

			<!-- Buying guides: internal link network -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Panduan Memilih Hidran</h2>
			<div class="grid sm:grid-cols-3 gap-4">
				<a href="/id/guides/how-to-choose-a-fire-hydrant/" class="group bg-gray-50 rounded-xl border border-gray-100 hover:border-brand-red p-4 transition">
					<p class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-1">Pemilihan</p>
					<p class="text-sm font-bold text-gray-900 group-hover:text-brand-red leading-snug">Cara Memilih Hidran Kebakaran</p>
					<p class="text-[11px] text-gray-500 mt-1">Dalam vs luar gedung, kolom kering vs basah, standar keluaran</p>
				</a>
				<a href="/id/guides/fire-hydrant-valve-standards-guide/" class="group bg-gray-50 rounded-xl border border-gray-100 hover:border-brand-red p-4 transition">
					<p class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-1">Standar</p>
					<p class="text-sm font-bold text-gray-900 group-hover:text-brand-red leading-snug">Penjelasan Standar Hidran &amp; Katup Kebakaran</p>
					<p class="text-[11px] text-gray-500 mt-1">AWWA C502, NFPA 1963, dan cara keduanya dipetakan ke proyek Anda</p>
				</a>
				<a href="/id/guides/antifreeze-anti-collision-fire-hydrant-guide/" class="group bg-gray-50 rounded-xl border border-gray-100 hover:border-brand-red p-4 transition">
					<p class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-1">Tugas Khusus</p>
					<p class="text-sm font-bold text-gray-900 group-hover:text-brand-red leading-snug">Hidran Anti-Beku &amp; Anti-Tabrak</p>
					<p class="text-[11px] text-gray-500 mt-1">Pembuangan kolom kering dan desain pemutus untuk lokasi berat</p>
				</a>
			</div>

			<!-- Sourcing for Southeast Asia (pilot market, EN-first) -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Pengadaan Hidran untuk Asia Tenggara</h2>
			<p class="text-gray-600 leading-relaxed mb-6">Wanlian mengirim dari pelabuhan Xiamen dan Quanzhou, dengan rute laut pendek menuju pelabuhan-pelabuhan utama Asia Tenggara. Penawaran diterbitkan FOB Xiamen atau CIF ke pelabuhan tujuan Anda — sebutkan pelabuhan Anda dan standar keluaran yang disyaratkan proyek lokal.</p>
			<ul class="space-y-3 mb-4">
				<li class="flex gap-3 items-start">
					<span class="mt-1 w-2 h-2 bg-brand-red rounded-full shrink-0"></span>
					<span class="text-gray-700 text-sm leading-relaxed">Koneksi keluaran dikerjakan menurut standar yang ditentukan proyek Anda, beserta kopling dan adaptor yang cocok dikirim dalam kontainer yang sama</span>
				</li>
				<li class="flex gap-3 items-start">
					<span class="mt-1 w-2 h-2 bg-brand-red rounded-full shrink-0"></span>
					<span class="text-gray-700 text-sm leading-relaxed">Pengemasan dengan peti kayu yang layak laut; dokumentasi pemuatan tersedia atas permintaan sebelum pengiriman</span>
				</li>
				<li class="flex gap-3 items-start">
					<span class="mt-1 w-2 h-2 bg-brand-red rounded-full shrink-0"></span>
					<span class="text-gray-700 text-sm leading-relaxed">Paket dokumentasi bersama setiap pesanan: catatan uji bodi dan dudukan, daftar kemas, dan sertifikat asal atas permintaan</span>
				</li>
				<li class="flex gap-3 items-start">
					<span class="mt-1 w-2 h-2 bg-brand-red rounded-full shrink-0"></span>
					<span class="text-gray-700 text-sm leading-relaxed">Kuantitas dari penggantian satuan proyek hingga penuh kontainer semuanya diberi penawaran — kirimkan model, jumlah, dan pelabuhan tujuan</span>
				</li>
			</ul>

			<!-- FAQ Section -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Pertanyaan yang Sering Diajukan</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Butuh Jaringan Hidran yang Disesuaikan untuk Proyek Anda?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Kirimkan DN/PN, standar koneksi, dan sertifikasi target Anda — tim insinyur kami membalas dengan lembar data teknis lengkap dan penawaran dalam waktu hingga 12 jam.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/id/contact/?product=Sistem%20Hidran%20Kebakaran" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Minta Penawaran</a>
						<a href="https://wa.me/8618684324501?text=Halo%2C%20saya%20butuh%20bantuan%20untuk%20memilih%20sistem%20hidran%20kebakaran" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat via WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
