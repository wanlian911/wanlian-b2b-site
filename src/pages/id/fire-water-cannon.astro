---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Apa o alcance efetivo do Anda canhão monitora proteksi kebakaran?',
		answer: 'O alcance depende do modelo e da tekanan de entrada — tipicamente 50 a 110 metros na aliran nominal para kami série PS, com raios de monitoramento de 40–65 m para a série ZDMS de rastreamento otomatis. Informe-nos o layout do Anda site e recomendaremos o modelo adequado.'
	},
	{
		question: 'O canhão monitora pode ser operado remotamente?',
		answer: 'Ya. Nosso canhão de rastreamento otomatis ZDMS opera totalmente de forma autônoma com detecção de chama IR/UV, e suporta acionamento jarak jauh manual via PC, aplicativo móvel ou armário de controle central. Monitores fixos também estão tersedia com operação manual por alavanca.'
	},
	{
		question: 'Apa saja vazões estão tersedia?',
		answer: 'Os modelos padrão variam de 5 L/s até 200 L/s. A série ZDMS está dispolevel em 5, 10, 20 e 30 L/s (personalizável até 150 L/s), enquanto a série manual PS cobre 20–200 L/s. Vazões personalizadas podem ser projetadas por projeto.'
	},
	{
		question: 'O modelo inteligente integra-se a sistems de alarme proteksi kebakaran?',
		answer: 'Ya, os monitor pemadam inteligentes ZDMS usam sensores de infravermelho e ultravioleta multibanda para detecção, posicionamento e jateamento otomatiss em 30 segundos, e podem ser conectados a painéis de alarme proteksi kebakaran. Configurações à prova de explosão estão tersedia como opção.'
	},
	{
		question: 'Apakah Anda fornecem o sistem lengkap, incluindo katup e tubulação?',
		answer: 'Ya. Fabricamos o canhão monitora e o enviamos junto com katup, acoplamentos, hidran e acessórios correspondentes para o circuito lengkap de sutekanan, simplificando a compra e garantindo a compatibilidade do sistem.'
	}
];

const cannonProducts = [
	{
		slug: 'auto-tracking-jet-suppression-cannon-zdms',
		name: 'Canhão de Rastreamento Otomatis de Sutekanan por Jato (ZDMS)',
		img: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		desc: 'Detecção automática IR/UV, rotação 360°, raio 40–65m'
	},
	{
		slug: 'manual-fire-water-cannon-ps',
		name: 'Canhão Monitora Proteksi Kebakaran Manual (Série PS)',
		img: '/assets/products/manual-fire-water-cannon-ps.webp',
		desc: '20–200 L/s, alcance do jato até 110m, air ou espuma'
	},
	{
		slug: 'foam-fire-hydrant-cabinet-psg30',
		name: 'Armário de Kebakaran com Espuma (PSG30)',
		img: '/assets/06_extinguishing_cannons/cannon_p42.webp',
		desc: 'Unidade de espuma AFFF 3% para incêndios químicos e de petróleo'
	},
	{
		slug: 'fire-hose-reel-jpso8-19',
		name: 'Kit de Acessórios de Carrete de Mangueira (JPS0.8-19)',
		img: '/assets/products/fire-hose-reel-jpso8-19.jpg',
		desc: 'Mangueira plana 20–30m, montagem giratória, resposta rápida'
	},
	{
		slug: 'adjustable-pistol-grip-fire-nozzle',
		name: 'Bocal de Kebakaran Ajustável com Empunhadura de Pistola',
		img: '/assets/products/adjustable-pistol-grip-fire-nozzle.jpg',
		desc: 'Jato reto / névoa, empunhadura de pistola em latão para linhas de mangueira'
	},
	{
		slug: 'sqd100-1-6-fire-pump-adapter',
		name: 'Adaptador de Bomba Proteksi Kebakaran (SQD100/1-6)',
		img: '/assets/products/sqd100-1-6-fire-pump-adapter.webp',
		desc: 'Conexão de bomba siamesa DN100/1.6 para dupla entrada'
	}
];
---

<Layout
	locale="id"
	title="Canhão Monitora de Kebakaran | Controle Jarak Jauh e Inteligente"
	description="Canhões monitora WLFE de alta aliran e longo alcance para plantas, terminais e armazéns. Models fixos, jarak jauhs e inteligentes de rastreamento otomatis."
	type="product"
	productData={{
		name: 'Canhão Monitora de Kebakaran',
		image: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		description: 'Canhões monitora proteksi kebakaran fixos, de controle jarak jauh e inteligentes, com aliran de 5 a 200 L/s e alcance de até 110 m para proteção proteksi kebakaran industrial, memproduksidos por Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Canhão Monitora de Kebakaran' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/id/" class="hover:text-blue-600">Beranda</a>
			<span>/</span>
			<a href="/id/products/" class="hover:text-blue-600">Produk</a>
			<span>/</span>
			<span class="text-gray-600">Canhão Monitora de Kebakaran</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Sistem de Monitor Pemadam Proteksi Kebakaran</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Sistem de Monitor Pemadam para Ambientes Industriais de Alto Risco</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">A Wanlian Fluid memproduksi monitor pemadam proteksi kebakaran de alta aliran para plantas petroquímicas, terminais de GNL, armazéns e aeroportos — de monitores manuais fixos a canhões totalmente autônomos de rastreamento otomatis com controle jarak jauh e inteligente.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Aliran até 200 L/s', 'Jangkauan até 110 m', 'Rotasi 360°', 'Detecção Automática IR/UV'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Série de Monitor Pemadam</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{cannonProducts.map(p => (
					<a href={`/id/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Spesifikasi Teknis Principais</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Spesifikasi</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Detail</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Aliran nominal</td>
							<td class="px-4 py-3 text-gray-700">5 – 200 L/s por modelo (personalizável até 150 L/s no ZDMS)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Jangkauan do jato</td>
							<td class="px-4 py-3 text-gray-700">50 – 110 m sesuai o modelo e a tekanan de entrada</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Rotasi</td>
							<td class="px-4 py-3 text-gray-700">Horizontal 360°, vertical -90° a +70°</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Modos de controle</td>
							<td class="px-4 py-3 text-gray-700">Manual / Jarak Jauh (PC, aplicativo móvel, armário central) / Otomatis (detecção de chama)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Material bodi</td>
							<td class="px-4 py-3 text-gray-700">Liga de alumínio T6 anodizado duro / bronze, via d'air SS304</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Opções</td>
							<td class="px-4 py-3 text-gray-700">À prova de explosão (Exde II BT4 Gb), dosagem de espuma</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplikasi</h2>
			<p class="text-gray-700 leading-relaxed">Canhões monitora proteksi kebakaran protegem áreas de processo petroquímico, parques de tanques de óleo e GNL, terminais de carga, grandes armazéns, hangares de aeroporto e subestações — sites com pé-direito alto ou ao ar livre onde a sutekanan fixa deve alcançar longas distâncias sob forte calor.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Mengapa Memilih a Wanlian Fluid</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Uma ordem, uma fábrica</strong> — monitor pemadam enviados com katup, acoplamentos e hidran correspondentes para o circuito lengkap de sutekanan.</li>
				<li><strong>Engenharia de projeto</strong> — recomendamos alcance, aliran e configuração de controle sesuai o layout do Anda site.</li>
				<li><strong>Apaidade certificada</strong> — sistems de qualidade UL/ULC, FM e ISO 9001; veja kami <a href="/id/certificates/" class="text-brand-blue font-semibold hover:underline">página de sertifikat</a>.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Pertanyaan Umum</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Membutuhkan um Canhão Monitora para o Seu Site?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envie-nos o layout do Anda site, o alcance e a aliran necessários — kami engenheiros recomendam o modelo adequado e respondem com uma cotação lengkap em até 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/id/contact/?product=Canh%C3%A3o%20Monitora%20de%20Inc%C3%AAndio" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Minta Penawaran</a>
						<a href="https://wa.me/8618684324501?text=Ol%C3%A1%2C%20preciso%20de%20um%20canh%C3%A3o%20monitora%20contra%20inc%C3%AAndio" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Hubungi via WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>

