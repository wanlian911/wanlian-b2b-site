---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';
const uri = { EscapeDataString: encodeURIComponent };
const toc = [
	{ id: 'american-avk-overview', label: '1. Siapa Sebenarnya American AVK' },
	{ id: 'wanlian-fluid-overview', label: '2. Siapa Sebenarnya Wanlian Fluid' },
	{ id: 'product-lines-compared', label: '3. Perbandingan Lini Produk' },
	{ id: 'quality-and-certifications', label: '4. Sistem Mutu & Sertifikasi' },
	{ id: 'cost-and-lead-time', label: '5. Biaya & Waktu Pengiriman' },
