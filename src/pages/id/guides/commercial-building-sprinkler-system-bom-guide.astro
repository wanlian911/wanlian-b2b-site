	{ slug: 'ul-fm-resilient-seat-osy-gate-valve', name: 'V谩lvula de Gaveta OS&Y (Ranurada)', img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp', desc: 'Pemisahan utama 2"-10 "dengan batang yang jelas untuk saluran api' },
