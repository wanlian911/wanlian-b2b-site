import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'why-counterfeits-concentrate', label: '1. Mengapa Pemalsuan Fokus pada Kategori ini' },
	{ id: 'common-forms-of-fakes', label: '2. Bentuk Pemalsuan yang Paling Umum' },
	{ id: 'detection-checklist', label: '3. Daftar Periksa Deteksi Tujuh Langkah' },
	{ id: 'red-flags-table', label: '4. Autêntico vs. Falso de Olho Rápido: Tabela de Sinais de Alerta' },
