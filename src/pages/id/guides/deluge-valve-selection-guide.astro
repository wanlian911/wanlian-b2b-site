---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'Apa perbedaan utama antara katup deluge dan katup pre-action?',
		answer: 'Sistem deluge menggunakan sprinkler atau nozzle terbuka, sehingga pembukaan katup deluge mengalirkan air ke semua titik pembuangan sekaligus. Sistem pre-action biasanya memakai sprinkler tertutup dan deteksi untuk membuka katup kontrol sebelum sprinkler mengeluarkan air. Deluge dipilih untuk cakupan cepat dan serentak; pre-action dipilih ketika pembuangan air yang tidak disengaja harus dibatasi. Konfirmasikan interlock dan urutan kode sesuai edisi yang berlaku.'
	},
	{
		question: 'Sebaiknya katup deluge menggunakan pelepasan elektrik atau hidraulik?',
		answer: 'Pilih metode pelepasan berdasarkan desain deteksi, persyaratan area berbahaya, daya yang tersedia, dan urutan fail-safe yang diperlukan. Pelepasan elektrik praktis ketika panel alarm kebakaran dan rangkaian solenoid tersupervisi sudah ditentukan. Pelepasan hidraulik atau pneumatik sesuai untuk lokasi yang membutuhkan jalur tekanan khusus atau detektor pneumatik. Wanlian memasok rakitan katup dan aksesori kompatibel; urutan panel kontrol deteksi harus dikonfirmasi oleh perancang sistem.'
	},
	{
		question: 'Bagaimana sistem deluge harus dilindungi di iklim dingin?',
		answer: 'Tempatkan rakitan katup deluge dan trim di ruang yang dipanaskan serta mudah diakses bila memungkinkan, dan jangan biarkan pipa terbuka berisi air berada di lokasi yang dapat membeku. Sediakan pengumpulan kondensat dan drainase untuk trim deteksi, isolasi bagian yang rentan, dan gunakan susunan kering atau pneumatik yang disetujui bila desain memerlukannya. Jangan mengganti media dengan antifreeze atau mengubah trim tanpa persetujuan otoritas berwenang. Konfirmasikan metode perlindungan beku sesuai edisi yang berlaku.'
	},
	{
		question: 'Bagaimana jalur deteksi dilindungi dari aktivasi yang tidak disengaja?',
		answer: 'Pisahkan jalur deteksi dari kontrol layanan biasa, supervisi tekanan atau status rangkaiannya, lindungi perangkat terbuka dari benturan, dan gunakan urutan panel pelepas yang dipersyaratkan untuk bahaya tersebut. Pelepas manual harus terlindung tetapi tetap mudah diakses, sedangkan sambungan uji harus diberi identifikasi jelas dan dikembalikan setelah pengujian. Deteksi hidraulik, pneumatik, dan elektrik masing-masing memerlukan supervisi alarm serta gangguan. Matriks sebab-akibat final harus disetujui sebelum commissioning.'
	},
	{
		question: 'Informasi apa yang harus dicantumkan dalam RFQ katup deluge?',
		answer: 'Kirimkan uraian bahaya, area terlindungi, aliran dan tekanan desain, ukuran nominal serta sambungan ujung katup, tata letak kepala terbuka atau monitor, metode deteksi, urutan aktuasi yang diperlukan, temperatur lingkungan, susunan drainase, dan edisi kode yang berlaku. Minta juga gambar trim, data material, catatan uji tekanan, informasi suku cadang, dan petunjuk pengoperasian. Jika diperlukan listing atau persetujuan, nyatakan secara eksplisit dan minta pemasok mengonfirmasi dokumentasi yang berlaku.'
	},
	{
		question: 'Apakah Wanlian memasok panel kontrol deteksi deluge?',
		answer: 'Wanlian memasok rakitan katup deluge serta katup dan aksesori pemantauan terkait, termasuk rakitan ZSFM dan komponen isolasi atau kontrol yang sesuai. Kami tidak menyatakan panel kontrol deteksi sebagai bagian dari paket katup standar bila panel tersebut tidak kami pasok. Panel pelepas, detektor, serta pemrograman sebab-akibat harus ditentukan bersama kontraktor alarm kebakaran atau spesialis deteksi, kemudian diperiksa terhadap trim katup dan urutan di lokasi.'
	}
];

const toc = [
	{ id: 'when-deluge', label: '1. Kapan Sistem Memerlukan Perlindungan Deluge' },
	{ id: 'how-it-works', label: '2. Cara Kerja Rakitan Katup Deluge ZSFM' },
	{ id: 'actuation', label: '3. Memilih Metode Aktuasi' },
	{ id: 'sizing', label: '4. Menentukan Ukuran Katup untuk Aliran dan Waktu Trip' },
	{ id: 'discharge', label: '5. Sprinkler Terbuka, Monitor, dan Tata Letak Pembuangan' },
	{ id: 'testing', label: '6. Commissioning dan Pengujian Berkala' },
	{ id: 'rfq-checklist', label: '7. Checklist RFQ Katup Deluge' },
	{ id: 'faq', label: 'Pertanyaan yang Sering Diajukan' }
];

const products = [
	{ slug: 'deluge-alarm-valve-zsfm', name: 'Rakitan Katup Alarm Deluge (Seri ZSFM)', img: '/assets/products/deluge-alarm-valve-zsfm.webp', desc: 'Rakitan katup deluge wet-bottom untuk sistem kepala terbuka dan monitor' },
	{ slug: 'pre-action-alarm-system-zsfy', name: 'Sistem Alarm Pre-Action (Seri ZSFY)', img: '/assets/products/pre-action-alarm-system-zsfy.jpg', desc: 'Rakitan pre-action interlock tunggal dan ganda' },
	{ slug: 'manual-fire-water-cannon-ps', name: 'Monitor Air Pemadam Manual (Seri PS)', img: '/assets/products/manual-fire-water-cannon-ps.webp', desc: 'Monitor tetap untuk tugas pembuangan deluge dan monitor' },
	{ slug: 'ul-fm-resilient-seat-osy-gate-valve', name: 'Katup Gerbang Dudukan Elastis OS&amp;Y UL/FM', img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp', desc: '2"-10", ujung grooved, stem naik, terdaftar UL/FM' }
];
---

<Layout
