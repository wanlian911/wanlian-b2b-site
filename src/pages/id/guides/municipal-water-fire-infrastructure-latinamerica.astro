							<td class="px-4 py-3 text-gray-700">Storz (standar alemã), 2,5&quot;</td>
							<td class="px-4 py-3 text-gray-700"><a href="/id/products/storz-coupling-2-5inch-aluminum/" class="text-brand-blue font-semibold hover:underline">Acoplamento Storz de Alumínio de 2,5&quot; (Norma Alemã)</a></td>
