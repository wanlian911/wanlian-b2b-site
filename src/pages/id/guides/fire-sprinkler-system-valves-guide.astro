---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'wet-pipe-systems-zsfz', label: '1. Sistem Basah: Katup Alarm ZSFZ' },
	{ id: 'deluge-systems-zsfm', label: '2. Sistem Deluge: Katup ZSFM' },
	{ id: 'pre-action-systems-zsfy', label: '3. Sistem Pre-Action: Katup Aktivasi Ganda ZSFY' },
	{ id: 'zone-detection-zsjz', label: '4. Deteksi Zona: Indikator Aliran ZSJZ' },
	{ id: 'selecting-the-right-valve', label: '5. Memilih Katup yang Tepat untuk Proyek' },
	{ id: 'faq', label: 'Pertanyaan Umum' }
];

const faq = [
	{
		question: 'Apa perbedaan katup alarm tipe basah dan katup deluge?',
		answer: 'Katup alarm tipe basah (ZSFZ) dipasang pada sistem sprinkler basah, dengan pipa yang selalu terisi air; katup ini mendeteksi aliran akibat terbukanya kepala sprinkler dan mengaktifkan alarm. Katup deluge (ZSFM) adalah katup kontrol tipe kering untuk sistem deluge yang membuka dan membanjiri seluruh area terlindungi secara serentak鈥攂iasanya untuk hunian berisiko tinggi seperti pabrik kimia dan pembangkit listrik.'
	},
	{
		question: 'Kapan sistem pre-action (ZSFY) harus digunakan?',
		answer: 'Sistem pre-action (ZSFY) menggabungkan katup deluge dengan sprinkler otomatis dan memerlukan dua aktivasi independen (misalnya deteksi asap dan panas) sebelum air masuk ke pipa. Sistem ini ditentukan untuk lingkungan sensitif terhadap air seperti museum, arsip, pusat data, dan ruang pendingin, ketika aktivasi tidak sengaja harus dihindari.'
	},
	{
		question: 'Apa fungsi indikator aliran air (ZSJZ) dalam sistem sprinkler?',
		answer: 'Indikator aliran air dengan vane (ZSJZ) dipasang pada jalur distribusi sprinkler dan mendeteksi aliran akibat terbukanya kepala sprinkler, lalu mengirimkan sinyal ke panel alarm kebakaran untuk mengidentifikasi zona yang aktif. Indikator ini memiliki penundaan waktu yang dapat disetel untuk menyaring lonjakan tekanan sementara.'
	},
	{
		question: 'Apakah katup ZSFZ, ZSFM, dan ZSFY dapat dipertukarkan?',
		answer: 'Tidak. Setiap jenis katup sesuai dengan arsitektur sistem tertentu: ZSFZ untuk sistem basah, ZSFM untuk sistem deluge, dan ZSFY untuk sistem pre-action. Mengganti salah satunya dapat merusak logika sistem dan tidak lolos inspeksi normatif. Pilih berdasarkan kelas bahaya hunian dan basis desain.'
	},
	{
		question: 'Sertifikasi apa yang diperlukan untuk katup alarm sprinkler?',
		answer: 'Rakitan katup alarm sprinkler harus disetujui lembaga sertifikasi yang berlaku di pasar Anda鈥攗mumnya UL/FM untuk Amerika Utara, CE untuk Eropa, LPCB untuk proyek Inggris/Persemakmuran, serta ISO 9001 sebagai dasar mutu. Wanlian menyediakan rakitan ZSFZ/ZSFM/ZSFY dengan paket sertifikasi yang disesuaikan dengan pasar tujuan.'
	}
];

const valveProducts = [
	{ slug: 'wet-alarm-check-valve-zsfz-150', name: 'Katup Searah Alarm Tipe Basah (ZSFZ-150)', img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp', desc: 'Katup alarm sistem basah dengan deteksi aliran dan aktivasi alarm' },
	{ slug: 'deluge-alarm-valve-zsfm', name: 'Rakitan Katup Deluge dan Alarm (Seri ZSFM)', img: '/assets/products/deluge-alarm-valve-zsfm.webp', desc: 'Katup deluge diafragma untuk hunian berisiko tinggi' },
	{ slug: 'pre-action-alarm-system-zsfy', name: 'Sistem Deluge Pre-Action dengan Alarm (Seri ZSFY)', img: '/assets/products/pre-action-alarm-system-zsfy.jpg', desc: 'Katup pre-action aktivasi ganda redundan untuk zona sensitif terhadap air' },
	{ slug: 'water-flow-indicator-zsjz', name: 'Indikator Aliran Air Vane (Seri ZSJZ)', img: '/assets/products/water-flow-indicator-zsjz.png', desc: 'Deteksi aliran per zona dengan penundaan yang dapat disetel untuk sistem basah' }
];
---

<Layout
	title="Panduan Katup Sistem Sprinkler: Basah, Deluge, Pre-Action"
	description="Panduan katup sistem sprinkler: ZSFZ, ZSFM, ZSFY, dan ZSJZ鈥攃ara kerja, waktu pemilihan, serta penawaran langsung dari pabrik Quanzhou Wanlian Fluid."
	type="article"
	locale="id"
	faq={faq}
	breadcrumbs={[{ name: 'Panduan', href: '/id/blog/' }, { name: 'Katup Sprinkler' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/id/" class="hover:text-blue-600">Beranda</a><span>/</span><a href="/id/blog/" class="hover:text-blue-600">Panduan</a><span>/</span><span class="text-gray-600">Katup Sprinkler</span></nav>
		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Panduan Sistem Sprinkler</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Katup Sistem Sprinkler Kebakaran: Panduan Lengkap (Basah, Deluge, dan Pre-Action)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Setiap sistem sprinkler dibangun di sekitar rakitan katup kontrol鈥攖itik ketika suplai air berubah menjadi sistem pemadaman kebakaran. Jika katup ditentukan secara keliru, logika seluruh sistem tidak akan lolos inspeksi. Panduan ini menjelaskan empat jenis katup yang mendominasi desain sistem sprinkler kebakaran modern, fungsi masing-masing, serta jenis hunian yang dilindungi. Untuk katup isolasi dan kontrol zona di sekitar rakitan鈥攌atup gerbang OS&amp;Y, katup butterfly bersinyal, dan katup searah鈥攂aca <a href="/id/guides/fire-sprinkler-control-valve-types/" class="text-brand-blue font-semibold hover:underline">panduan jenis katup kontrol sprinkler</a> kami.</p>

			<div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4">{valveProducts.map(p => (<a href={`/id/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition"><img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" /><div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p><p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p></div></a>))}</div>
			<TableOfContents headings={toc} />

			<h2 id="wet-pipe-systems-zsfz" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Sistem Basah: Katup Alarm ZSFZ</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Sistem basah merupakan konfigurasi sprinkler yang paling umum: pipa selalu terisi air dan setiap kepala sprinkler terbuka secara individual ketika elemen peka panasnya pecah. <a href="/id/products/wet-alarm-check-valve-zsfz-150/" class="text-brand-blue font-semibold hover:underline">Katup searah alarm tipe basah ZSFZ</a> ditempatkan pada riser hulu sistem dan menjalankan dua fungsi: mencegah aliran balik air sistem ke suplai serta mendeteksi aliran yang muncul ketika kepala sprinkler terbuka, lalu mengaktifkan alarm mekanis dan elektrik. Aliran terus masuk ke sistem hingga suplai ditutup secara manual.</p>
			<p class="text-gray-700 leading-relaxed">Sistem basah cepat, sederhana, dan murah dirawat鈥攖etapi tidak dapat digunakan ketika suhu lingkungan berisiko membekukan pipa.</p>

			<h2 id="deluge-systems-zsfm" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Sistem Deluge: Katup ZSFM</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Sistem deluge melindungi hunian berisiko tinggi, ketika api dapat menyebar lebih cepat daripada respons kepala sprinkler individual: pabrik kimia, bengkel pengecatan, pembangkit listrik, dan hanggar pesawat. Semua nozzle zona deluge terbuka dan sistem ditahan oleh satu katup kontrol鈥?a href="/id/products/deluge-alarm-valve-zsfm/" class="text-brand-blue font-semibold hover:underline">katup deluge dan alarm ZSFM</a>. Ketika sistem deteksi (asap/panas/api) memberi sinyal kebakaran, katup terbuka dan air mencapai semua nozzle secara bersamaan.</p>
			<p class="text-gray-700 leading-relaxed">ZSFM yang digerakkan diafragma membuka dengan cepat dan menutup kembali secara andal setelah operasi, hal penting karena zona deluge biasanya besar dan katup merupakan satu-satunya titik kegagalan sistem.</p>

			<h2 id="pre-action-systems-zsfy" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Sistem Pre-Action: Katup Aktivasi Ganda ZSFY</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Sistem pre-action merupakan perangkat deluge dengan perbedaan pada perpipaan sprinkler: pipa tetap kering dan air baru masuk <em>setelah dua aktivasi independen mengonfirmasi kebakaran</em>. <a href="/id/products/pre-action-alarm-system-zsfy/" class="text-brand-blue font-semibold hover:underline">Sistem alarm pre-action ZSFY</a> adalah rakitan kontrol arsitektur ini鈥攌atup tipe deluge yang dioperasikan sinyal deteksi kebakaran, dengan sprinkler otomatis di hilir yang juga berfungsi sebagai sekering individual.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Mengapa menentukan pre-action? Tiga alasan utama:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4"><li><strong>Isi sensitif terhadap air</strong>鈥攎useum, arsip, pusat data, ruang transformator: air tidak masuk tanpa dua sinyal konfirmasi.</li><li><strong>Lingkungan berisiko membeku</strong>鈥攔uang pendingin, gudang tanpa pemanas: pipa kering tidak membeku.</li><li><strong>Perlindungan dari aktivasi palsu</strong>鈥攍ogika aktivasi ganda membuat aktivasi tidak sengaja secara statistik dapat diabaikan.</li></ul>

			<h2 id="zone-detection-zsjz" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Deteksi Zona: Indikator Aliran ZSJZ</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Ketika sistem beroperasi, pemadam kebakaran dan pengelola gedung perlu mengetahui <em>zona mana</em> yang mengalami aliran. <a href="/id/products/water-flow-indicator-zsjz/" class="text-brand-blue font-semibold hover:underline">Indikator aliran air vane ZSJZ</a> dipasang pada jalur distribusi sprinkler: ketika air bergerak, vane menyimpang dan kontak mengirimkan sinyal ke panel alarm untuk mengidentifikasi zona yang terdampak. Penundaan waktu yang dapat disetel menyaring lonjakan tekanan yang dapat menimbulkan alarm keliru.</p>

			<h2 id="selecting-the-right-valve" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Memilih Katup yang Tepat untuk Proyek</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5"><table class="min-w-full divide-y divide-gray-200 text-sm"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Hunian / Kebutuhan</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Jenis Sistem</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Katup Kontrol</th></tr></thead><tbody class="bg-white divide-y divide-gray-200"><tr><td class="px-4 py-3 font-bold text-gray-900">Kantor, ritel, gudang (berpemanas)</td><td class="px-4 py-3 text-gray-700">Basah</td><td class="px-4 py-3 text-gray-700">Katup alarm ZSFZ (basah)</td></tr><tr><td class="px-4 py-3 font-bold text-gray-900">Kimia, energi, aviasi, risiko tinggi</td><td class="px-4 py-3 text-gray-700">Deluge</td><td class="px-4 py-3 text-gray-700">Katup deluge ZSFM</td></tr><tr><td class="px-4 py-3 font-bold text-gray-900">Museum, pusat data, ruang pendingin</td><td class="px-4 py-3 text-gray-700">Pre-action</td><td class="px-4 py-3 text-gray-700">Sistem pre-action ZSFY</td></tr><tr><td class="px-4 py-3 font-bold text-gray-900">Identifikasi zona (semua sistem basah)</td><td class="px-4 py-3 text-gray-700">鈥?/td><td class="px-4 py-3 text-gray-700">Indikator aliran ZSJZ</td></tr></tbody></table></div>
			<p class="text-gray-700 leading-relaxed">Rakitan lengkap biasanya menggabungkan katup alarm dengan katup gerbang bersinyal di hulu, katup searah, manometer, dan aksesori alarm. Ketika Anda mengirimkan kelas bahaya dan diameter pipa, kami dapat mengutip rakitan katup lengkap, bukan katup terpisah鈥攕atu paket tersertifikasi dengan satu set dokumen.</p>

			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8"><h2 class="text-xl font-black text-gray-900 tracking-tight">Panduan Terkait: Jenis Sistem dan Kepala Sprinkler</h2><p class="mt-2 text-gray-600 text-sm leading-relaxed">Memilih sistem basah, kering, atau pre-action, atau menentukan kepala sprinkler berdasarkan faktor K dan suhu? Baca <a href="/id/guides/fire-sprinkler-system-wet-dry-preaction/" class="text-brand-blue font-semibold hover:underline">Panduan Sistem Sprinkler</a>.</p></div>

			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Pertanyaan Umum</h2><div class="space-y-4">{faq.map(item => (<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>))}</div>

			<div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white tracking-tight">Memerlukan Penawaran Rakitan Katup Sprinkler?</h2><p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Kirimkan jenis sistem, kelas bahaya, dan diameter pipa鈥攌ami akan menjawab dengan spesifikasi rakitan katup lengkap dan harga pabrik dalam waktu maksimal 12 jam.</p><div class="mt-6 flex flex-col sm:flex-row justify-center gap-4"><a href="/id/contact/?product=Rakitan%20Katup%20Sprinkler" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Minta Penawaran</a><a href="https://wa.me/8618684324501?text=Halo%2C%20saya%20memerlukan%20penawaran%20rakitan%20katup%20sprinkler" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Hubungi via WhatsApp</a></div></div></div>
		</article>
	</main>
</Layout>
