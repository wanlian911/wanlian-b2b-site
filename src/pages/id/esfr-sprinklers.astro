---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Apa itu sprinkler ESFR?',
		answer: 'ESFR berarti Early Suppression Fast Response. Kepala sprinkler ESFR pada lini ini memakai desain debit tinggi, ampul kaca respons cepat 74°C, serta orientasi menggantung atau tegak untuk gudang rak tinggi, gudang, dan fasilitas industri.'
	},
	{
		question: 'Bisakah sprinkler ESFR menggantikan sprinkler di dalam rak?',
		answer: 'Bisa, pada susunan penyimpanan yang memenuhi kriteria desain yang berlaku. Keputusan akhir bergantung pada jenis barang, tinggi penyimpanan, tinggi plafon, tata letak rak, faktor K, dan tekanan desain, sehingga perencana proteksi kebakaran dan pihak yang berwenang harus menyetujui susunan tersebut.'
	},
	{
		question: 'Bagaimana faktor K memengaruhi pemilihan ESFR?',
		answer: 'Faktor K dan tekanan kerja menentukan air yang dialirkan oleh tiap kepala. Gunakan perhitungan hidrolik dan kriteria penyimpanan untuk memilih model ESFR; jangan memilih sprinkler hanya dari diameter nominal pipa.'
	},
	{
		question: 'Kelas suhu berapa yang dipakai kepala sprinkler ESFR?',
		answer: 'Produk ESFR dispesifikasikan dengan ampul kaca respons cepat 74°C (165°F). Konfirmasi kondisi lingkungan serta listing atau persetujuan yang disyaratkan untuk proyek tujuan sebelum melakukan pemesanan.'
	},
	{
		question: 'Apa yang seharusnya termasuk dalam paket sprinkler ESFR?',
		answer: 'Pemesanan umum dimulai dari daftar kepala sprinkler, lalu menambahkan sprinkler terpilih, katup alarm pipa basah, indikator aliran air, katup isolasi terpantau, dan aksesori sistem standar yang disyaratkan desain yang disetujui.'
	},
	{
		question: 'Bisakah Anda menawarkan harga BOM sistem sprinkler gudang secara lengkap?',
		answer: 'Bisa. Kirimkan daftar kepala sprinkler yang disetujui, informasi penyimpanan dan plafon, data desain hidrolik, serta daftar katup. Kami dapat menawarkan harga sprinkler terverifikasi dan komponen sistem sebagai satu paket proyek.'
	}
];

const products = [
	{
		slug: 'esfr-sprinkler-head',
		name: 'ESFR Early Suppression Fast Response Sprinkler',
		img: '/assets/products/esfr-sprinkler-head.webp',
		desc: 'ESFR-202 / ESFR-242 / ESFR-363, 74°C, menggantung dan tegak'
	},
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'Glass Bulb Fire Sprinkler (ZST Series)',
		img: '/assets/products/glass-bulb-fire-sprinkler-zst.webp',
		desc: 'DN15 / DN20, K=80 ±4 / K=115 ±9, menggantung / tegak / dinding'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Wet Alarm Check Valve ZSFZ 150',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'DN100 / DN150 / DN200, 1.6 MPa, gong alarm dan ruang tunda'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Vane Type Water Flow Indicator (ZSJZ Series)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'DN50–DN200, 1.2 / 1.6 MPa, tunda dapat disetel 2–60 s'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Signal Butterfly Valve (DN80 PN16)',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80-overlay.png',
		desc: 'DN50–DN300, PN16, posisi terbuka/tertutup terpantau'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'UL/FM Fire Protection Resilient Seated OS&Y Gate Valve',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: '2"–10", ujung beralur, batang naik, tercatat UL / FM'
	}
];
---

<Layout
	title="Kepala Sprinkler ESFR untuk Gudang Rak Tinggi | WLFE"
	description="Kepala sprinkler ESFR untuk sistem sprinkler gudang: bandingkan faktor K, tekanan kerja, alternatif rak, dan paket katup lengkap dari Wanlian."
	type="product"
	locale="id"
	productData={{
		name: 'Sistem Sprinkler ESFR',
		image: '/assets/products/esfr-sprinkler-head.webp',
		description: 'Kepala sprinkler ESFR dan komponen sistem proteksi kebakaran terverifikasi untuk penyimpanan rak tinggi, gudang, dan fasilitas industri.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Sprinkler ESFR' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/id/" class="hover:text-blue-600">Beranda</a>
			<span>/</span>
			<a href="/id/products/" class="hover:text-blue-600">Produk</a>
			<span>/</span>
			<span class="text-gray-600">Sprinkler ESFR</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Sistem Sprinkler Gudang — Langsung dari Pabrik</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Kepala Sprinkler ESFR untuk Perlindungan Gudang Rak Tinggi</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Kepala sprinkler ESFR dipilih ketika desain gudang membutuhkan semprotan plafon yang cepat dan berdebit tinggi untuk melindungi penyimpanan. Wanlian menyediakan sprinkler ESFR beserta katup terpantau, alarm, dan deteksi aliran di sekitarnya, sehingga desain yang disetujui dapat ditawarkan sebagai satu paket yang terkoordinasi.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Respons Cepat 74°C', 'Menggantung / Tegak', 'Perencanaan Faktor K', 'Dukungan Daftar Bahan Gudang'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Komponen Sprinkler ESFR dan Sistemnya</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{products.map(p => (
					<a href={`/id/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Pemilihan dan Spesifikasi ESFR</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Titik pemilihan</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Informasi produk terverifikasi</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">Kepala ESFR</td><td class="px-4 py-3 text-gray-700">ESFR-202 / ESFR-242 / ESFR-363 dan ZSTX-161; 74°C; menggantung PY atau tegak UY; NPT R1/2" atau R3/4".</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Perencanaan hidrolik</td><td class="px-4 py-3 text-gray-700">Gunakan desain penyimpanan yang disetujui untuk menetapkan faktor K, tekanan kerja, kebutuhan air, dan jarak antarsprinkler sebelum dilepas.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Opsi sprinkler standar</td><td class="px-4 py-3 text-gray-700">Kepala ampul kaca ZST: DN15 / DN20, K=80 ±4 atau K=115 ±9, dengan tipe menggantung, tegak, dan dinding.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Alarm dan aliran</td><td class="px-4 py-3 text-gray-700">Katup alarm basah ZSFZ: DN100 / DN150 / DN200 pada 1.6 MPa; indikator aliran ZSJZ: DN50–DN200 pada 1.2 / 1.6 MPa.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Isolasi dan pemantauan</td><td class="px-4 py-3 text-gray-700">Katup kupu-kupu bersinyal: DN50–DN300, PN16, dengan sakelar sinyal listrik terintegrasi; katup gerbang OS&Y: 2"–10", beralur, tercatat UL / FM.</td></tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Yang Perlu Masuk dalam Satu Pesanan ESFR</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2">
				<li><strong>Daftar kepala yang disetujui</strong> — jenis barang tersimpan, informasi rak dan plafon, model kepala, orientasi, ulir, dan kuantitas.</li>
				<li><strong>Dasar desain hidrolik</strong> — faktor K terpilih, tekanan desain, kebutuhan air, dan standar proyek atau catatan pihak berwenang.</li>
				<li><strong>Set kontrol sistem</strong> — katup alarm pipa basah, indikator aliran air, dan katup isolasi terpantau yang dispesifikasikan.</li>
				<li><strong>Dokumentasi dan pengemasan</strong> — data produk, sertifikat yang disyaratkan, kuantitas per kotak, dan penandaan pasar tujuan dikonfirmasi sebelum produksi.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Sumber Desain ESFR</h2>
			<p class="text-gray-700 leading-relaxed">Untuk keputusan desain, lihat <a href="/id/guides/commercial-building-sprinkler-system-bom-guide/" class="text-brand-blue font-semibold hover:underline">panduan daftar bahan sistem sprinkler</a>, <a href="/id/guides/fire-sprinkler-head-selection-guide/" class="text-brand-blue font-semibold hover:underline">panduan pemilihan kepala sprinkler</a> and <a href="/id/guides/fire-sprinkler-system-valves-guide/" class="text-brand-blue font-semibold hover:underline">panduan katup sistem sprinkler</a>.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Pertanyaan yang Sering Diajukan</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Butuh Paket Sprinkler ESFR untuk Gudang?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Kirimkan daftar kepala sprinkler dan dasar desain hidrolik — kami mengonfirmasi daftar komponen dan menjawab dengan penawaran terkoordinasi dalam 12 jam.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/id/contact/?product=Sistem%20Sprinkler%20ESFR" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Minta Penawaran</a>
						<a href="https://wa.me/8618684324501?text=Halo%2C%20saya%20butuh%20paket%20sprinkler%20ESFR%20untuk%20gudang" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat via WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
