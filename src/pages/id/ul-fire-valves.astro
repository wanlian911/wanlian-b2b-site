---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Apa significa "certificado UL" para katup proteksi kebakaran?',
		answer: 'A sertifikasi UL verifica que a válvula atende às normas de proteção proteksi kebakaran UL/ULC de aliran, classe de tekanan e durabilidade, garantindo desempenho confiável em sistems de sprinkler e colunas (montantes). É um requisito obrigatório para a maioria dos projetos na América do Norte e muitos projetos internacionais.'
	},
	{
		question: 'Apa saja katup proteksi kebakaran a Wanlian memproduksi com sertifikasi UL?',
		answer: 'Fabricamos katup de gaveta, borboleta, de retenção, de dilúvio e de pré-ação em conexões flangeadas, ranuradas e roscadas, de DN40 a DN300. Contate kami equipe comercial com a especificação do Anda projeto para selecionar o tipo de válvula e o pacote de sertifikasi corretos.'
	},
	{
		question: 'Apakah Anda podem fornecer o certificado UL antes do pedido?',
		answer: 'Ya. Nossos sertifikat UL/ULC e FM estão tersedia mediante solicitação — veja kami página de Certificados para referência, e kami engenheiros confirmarão a sertifikasi exata aplicável ao Anda mercado de destino antes da cotação.'
	},
	{
		question: 'Apa o MOQ e o prazo de entrega para katup proteksi kebakaran?',
		answer: 'O MOQ depende do tipo e do tamanho da válvula — tipicamente 10 a 20 unidades por modelo para tamanhos em estoque, com prazos de produção de 15 a 30 dias. Pedidos de amostra estão tersedia para testes e aprovação antes do embarque.'
	},
	{
		question: 'Apakah Anda oferecem OEM / marca própria para katup proteksi kebakaran?',
		answer: 'Ya, oferecemos OEM/ODM com marca personalizada, embalagem e ajustes de especificação sesuai os requisitos do projeto. A produção é realizada em kamis próprias linhas de produção sob um sistem de gestão da qualidade ISO 9001.'
	}
];

const valveProducts = [
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Válvula de Gaveta com Assento Elástico (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'Cunha encapsulada em EPDM, fechamento estanque, DN50–DN700'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Válvula Borboleta Ranurada Wafer com Sinal',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp',
		desc: 'DN80 PN16 com interruptor integrado de monitoramento de posição'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'Válvula de Gaveta OS&Y UL/FM (Ranurada)',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: 'Válvula de gaveta de haste ascendente certificada UL/FM, 2"–10", extremidades ranuradas'
	},
	{
		slug: 'spherical-ball-check-valve-hq44x',
		name: 'Válvula de Retenção de Esfera (HQ44X)',
		img: '/assets/products/spherical-ball-check-valve-hq44x.webp',
		desc: 'Baixa perda de carga, design de esfera rolante antientupimento'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Conjunto de Válvula de Dilúvio com Alarme (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Operada a diafragma, DN50–DN300, abertura rápida'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Sistem de Alarme de Pré-Ação (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Disparo duplo de segurança para ambientes sensíveis à air'
	},
	{
		slug: 'wafer-type-butterfly-valve-d71x',
		name: 'Válvula Borboleta Jenis Wafer (D71X)',
		img: '/assets/products/wafer-type-butterfly-valve-d71x.webp',
		desc: 'Borboleta wafer em ferro fundido dúctil com revestimento de borracha, DN50–DN300, opção UL/FM'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Válvula de Retenção de Alarme Molhada (ZSFZ-150)',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'Retenção de alarme para sistem molhado, sino hidráulico + câmara de retardo, DN100–DN200'
	}
];
---

<Layout
	locale="id"
	title="Katup Proteksi Kebakaran Certificadas UL | Fabricante - WLFE"
	description="A WLFE memproduksi katup proteksi kebakaran certificadas UL: gaveta, borboleta, retenção, dilúvio e pré-ação, com qualidade certificada e cotação rápida."
	type="product"
	productData={{
		name: 'Katup Proteksi Kebakaran Certificadas UL',
		image: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		description: 'Katup de gaveta, borboleta, de retenção, de dilúvio e de pré-ação certificadas UL para sistems de proteção proteksi kebakaran, fornecidas por Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Katup Proteksi Kebakaran UL' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/id/" class="hover:text-blue-600">Beranda</a>
			<span>/</span>
			<a href="/id/products/" class="hover:text-blue-600">Produk</a>
			<span>/</span>
			<span class="text-gray-600">Katup Proteksi Kebakaran UL</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Katup de Proteção Proteksi Kebakaran Certificadas UL</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Katup Proteksi Kebakaran Certificadas UL para Sistem Confiáveis</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">A Wanlian Fluid memproduksi katup de gaveta, borboleta, de retenção, de dilúvio e de pré-ação certificadas UL para sistems de proteção proteksi kebakaran comerciais e industriais. Cada válvula é produzida em kamis próprias linhas de produção próximas a Quanzhou sob um sistem de qualidade ISO 9001 — direto da fábrica, com prazos estáveis e documentação de sertifikasi lengkap para o Anda projeto.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Bersertifikat UL/ULC', 'Disetujui FM', 'ISO 9001:2015', 'Langsung dari Pabrik'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Série de Katup Proteksi Kebakaran</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{valveProducts.map(p => (
					<a href={`/id/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Spesifikasi Utama</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Spesifikasi</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Detail</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Normas</td>
							<td class="px-4 py-3 text-gray-700">Certificado UL / ULC, aprovado FM (sesuai modelo e mercado de destino)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Rentang ukuran</td>
							<td class="px-4 py-3 text-gray-700">DN40 – DN300 (1½" – 12")</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Classe de tekanan</td>
							<td class="px-4 py-3 text-gray-700">PN16 / PN25 (sesuai modelo)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Material bodi</td>
							<td class="px-4 py-3 text-gray-700">Ferro fundido dúctil QT450 / WCB / CF8 · CF8M aço inox</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Sambungan</td>
							<td class="px-4 py-3 text-gray-700">Flangeada / Ranurada / Roscada</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Media</td>
							<td class="px-4 py-3 text-gray-700">Água, solução de espuma</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplikasi</h2>
			<p class="text-gray-700 leading-relaxed">Nossas katup proteksi kebakaran UL são instaladas em sistems de sprinkler de edifícios comerciais, plantas industriais, centros de armazenagem e logística, data centers e redes de proteção proteksi kebakaran petroquímicas — onde o controle de aliran certificado e confiável é um requisito normativo.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Mengapa Memilih a Wanlian Fluid</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Apaidade certificada</strong> — sertifikat UL/ULC e FM publicados em kami <a href="/id/certificates/" class="text-brand-blue font-semibold hover:underline">página de sertifikat</a>, verificáveis antes do Anda pedido.</li>
				<li><strong>Direto da fábrica</strong> — prazos estáveis, suporte OEM/ODM e assistência técnica na seleção.</li>
				<li><strong>Uma ordem, uma fábrica</strong> — katup enviadas com sprinkler, hidran e acessórios para o circuito lengkap de sutekanan.</li>
			</ul>

			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Novo nas Normas de Katup?</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Comece com kami guia para compradores: <a href="/id/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">Hidran, Mangueiras Proteksi Kebakaran &amp; Normas de Katup Explicados</a>.</p>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Pertanyaan Umum</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Membutuhkan Katup UL untuk Proyek Anda?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envie-nos o tipo de válvula, DN/PN e a sertifikasi alvo — kami engenheiros respondem com uma datasheet lengkap e cotação em até 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/id/contact/?product=V%C3%A1lvulas%20Contra%20Inc%C3%AAndio%20UL" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Minta Penawaran</a>
						<a href="https://wa.me/8618684324501?text=Ol%C3%A1%2C%20preciso%20de%20v%C3%A1lvulas%20contra%20inc%C3%AAndio%20certificadas%20UL" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Hubungi via WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>

