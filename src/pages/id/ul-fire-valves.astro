---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Apa arti terdaftar UL bagi katup kebakaran?',
		answer: 'Sertifikasi UL menegaskan bahwa katup memenuhi standar proteksi kebakaran UL/ULC dalam hal debit, kelas tekanan, dan ketahanan, sehingga kinerjanya andal pada sistem sprinkler dan standpipe. Ini adalah syarat wajib bagi sebagian besar proyek di Amerika Utara dan banyak proyek internasional.'
	},
	{
		question: 'Katup kebakaran apa saja yang Wanlian produksi dengan sertifikasi UL?',
		answer: 'Kami memproduksi katup gerbang, katup kupu-kupu, katup searah, katup deluge, dan katup pre-action dengan sambungan flensa, alur, dan ulir, dari DN40 sampai DN300. Sampaikan spesifikasi proyek Anda kepada tim penjualan kami agar tipe katup dan paket sertifikasinya tepat.'
	},
	{
		question: 'Bisakah sertifikat UL diberikan sebelum pemesanan?',
		answer: 'Bisa. Sertifikat UL/ULC dan FM kami tersedia atas permintaan — lihat halaman Sertifikat kami sebagai acuan, dan tim insinyur kami akan memastikan sertifikasi yang berlaku untuk pasar tujuan Anda sebelum penawaran diberikan.'
	},
	{
		question: 'Berapa MOQ dan waktu produksi untuk katup kebakaran?',
		answer: 'MOQ bergantung pada tipe dan ukuran katup — umumnya 10–20 unit per model untuk ukuran siap kirim, dengan waktu produksi 15–30 hari. Pesanan contoh tersedia untuk pengujian dan persetujuan sebelum pengiriman.'
	},
	{
		question: 'Apakah Anda mendukung OEM/label pribadi untuk katup kebakaran?',
		answer: 'Ya, kami mendukung OEM/ODM dengan penyesuaian merek, kemasan, dan spesifikasi sesuai kebutuhan proyek. Produksi berjalan di jalur produksi kami sendiri di bawah sistem manajemen mutu ISO 9001.'
	}
];

const valveProducts = [
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Katup Gerbang Flensa Dudukan Karet dari Besi Ulet (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'Wedge berlapis EPDM, penutupan rapat kedap, DN50–DN700'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Katup Kupu-kupu Wafer Beralur dengan Sakelar Sinyal DN80 PN16',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp',
		desc: 'DN80 PN16 dengan sakelar pemantau status terpasang'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'Katup Gerbang OS&Y Dudukan Karet untuk Proteksi Kebakaran UL/FM',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: 'Katup gerbang batang naik terdaftar UL/FM, 2"–10", ujung beralur'
	},
	{
		slug: 'spherical-ball-check-valve-hq44x',
		name: 'Katup Searah Bola Bulat dari Besi Ulet (HQ44X-16)',
		img: '/assets/products/spherical-ball-check-valve-hq44x.webp',
		desc: 'Kehilangan tekanan rendah, rancangan bola menggulung yang tidak tersumbat'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Rakitan Katup Alarm Deluge Seri ZSFM',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Operasi diafragma, DN50–DN300, buka cepat'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Sistem Katup Alarm Pre-Action ZSFY',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Pengaman dua pemicu untuk ruang yang sensitif terhadap air'
	},
	{
		slug: 'wafer-type-butterfly-valve-d71x',
		name: 'Katup Kupu-kupu Wafer Besi Ulet Berlapis Karet (D71X)',
		img: '/assets/products/wafer-type-butterfly-valve-d71x.webp',
		desc: 'Katup kupu-kupu wafer berlapis karet, DN50–DN300, opsi UL/FM'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Katup Alarm Pipa Basah ZSFZ 150',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'Katup alarm searah sistem pipa basah, gong hidrolik + ruang penunda, DN100–DN200'
	}
];
---

<Layout
	locale="id"
	title="Katup Kebakaran Terdaftar UL | Produsen Katup UL - WLFE"
	description="Katup kebakaran terdaftar UL: gerbang, kupu-kupu, searah, deluge, dan pre-action. Diproduksi sendiri dengan mutu bersertifikat dan penawaran cepat."
	type="product"
	productData={{
		name: 'Katup Kebakaran Terdaftar UL',
		image: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		description: 'Katup gerbang, kupu-kupu, searah, deluge, dan pre-action terdaftar UL untuk sistem proteksi kebakaran, dipasok oleh Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Katup Proteksi Kebakaran UL' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/id/" class="hover:text-blue-600">Beranda</a>
			<span>/</span>
			<a href="/id/products/" class="hover:text-blue-600">Produk</a>
			<span>/</span>
			<span class="text-gray-600">Katup Proteksi Kebakaran UL</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Katup Proteksi Kebakaran Bersertifikat UL</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Katup Kebakaran Terdaftar UL untuk Sistem Proteksi yang Andal</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid memproduksi katup gerbang, katup kupu-kupu, katup searah, katup deluge, dan katup pre-action terdaftar UL untuk sistem proteksi kebakaran komersial dan industri. Setiap katup diproduksi di jalur produksi kami sendiri di sekitar Quanzhou dengan sistem mutu ISO 9001 — langsung dari pabrik, waktu produksi stabil, dan dokumen sertifikasi lengkap untuk proyek Anda.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Terdaftar UL/ULC', 'Disetujui FM', 'ISO 9001:2015', 'Langsung dari Pabrik'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Seri Katup Kebakaran</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{valveProducts.map(p => (
					<a href={`/id/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Spesifikasi Utama</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Spesifikasi</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Rincian</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Standar</td>
							<td class="px-4 py-3 text-gray-700">Terdaftar UL / ULC, Disetujui FM (per model dan pasar tujuan)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Rentang ukuran</td>
							<td class="px-4 py-3 text-gray-700">DN40 – DN300 (1½" – 12")</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Kelas tekanan</td>
							<td class="px-4 py-3 text-gray-700">PN16 / PN25 (per model)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Material bodi</td>
							<td class="px-4 py-3 text-gray-700">Besi ulet QT450 / WCB / baja tahan karat CF8 · CF8M</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Sambungan ujung</td>
							<td class="px-4 py-3 text-gray-700">Flensa / Alur / Ulir</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Media</td>
							<td class="px-4 py-3 text-gray-700">Air, larutan busa</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplikasi</h2>
			<p class="text-gray-700 leading-relaxed">Katup kebakaran UL kami terpasang pada sistem sprinkler gedung komersial, pabrik industri, gudang dan pusat distribusi, pusat data, serta pipa utama kebakaran petrokimia — karena di lokasi tersebut pengendalian aliran yang bersertifikat dan andal merupakan syarat ketentuan proyek.</p>

			<!-- Why WLFE -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Mengapa Memilih Wanlian Fluid</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Mutu bersertifikat</strong> — sertifikat UL/ULC dan FM dipublikasikan pada <a href="/id/certificates/" class="text-brand-blue font-semibold hover:underline">halaman sertifikat</a> kami, dapat diverifikasi sebelum Anda memesan.</li>
				<li><strong>Langsung dari pabrik</strong> — waktu produksi stabil, dukungan OEM/ODM, dan bantuan pemilihan teknis oleh tim insinyur.</li>
				<li><strong>Satu pesanan, satu pabrik</strong> — katup dikirim bersama kepala sprinkler, hidran, dan aksesori untuk seluruh loop pemadaman.</li>
			</ul>

			<!-- Related guide -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Baru Mengenal Standar Katup?</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Mulailah dari panduan pembeli kami: <a href="/id/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">Penjelasan Standar Hidran Kebakaran, Selang Pemadam, dan Katup</a>.</p>
			</div>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Pertanyaan yang Sering Diajukan</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Butuh Katup Kebakaran UL untuk Proyek Anda?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Kirimkan tipe katup, DN/PN, dan sertifikasi tujuan Anda — tim insinyur kami membalas dengan lembar data lengkap dan penawaran dalam waktu 12 jam.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/id/contact/?product=Katup%20Proteksi%20Kebakaran%20UL" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Minta Penawaran</a>
						<a href="https://wa.me/8618684324501?text=Halo%2C%20saya%20butuh%20katup%20kebakaran%20terdaftar%20UL" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat via WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
