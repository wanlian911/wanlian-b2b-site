      { label: 'Monitor Air Kebakaran', href: '/id/products/#category=Canh%C3%B5es%20Monitora%20de%20Inc%C3%AAndio' },
      { label: 'Hidrante de Coluna (SS100)', href: '/id/products/overground-fire-hydrant-ss100/' },
      { label: 'Hidrante Inteligente IoT (SS100ZN)', href: '/id/products/iot-smart-ground-fire-hydrant-ss100zn/' },
      { label: 'Hidrante Externo Anticolisão (SSFT100)', href: '/id/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100/' },
      { label: 'Mangueira contra Incêndio com Revestimento de Borracha PVC (8-65)', href: '/id/products/fire-hose-pvc-rubber-lining-8-65/' }
