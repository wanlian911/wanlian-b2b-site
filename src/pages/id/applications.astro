    points: ['Redes internas e externas de hidran kebakaran', 'Sistemas otomatis de sprinkler e dilúvio', 'Canhões monitora untuk espaços de besar vão', 'Carretes de selang e armários kebakaran'],
    links: [
      { label: 'Hidran Kebakaran', href: '/id/products/#category=Hidrantes%20e%20Conex%C3%B5es%20de%20Bomba' },
