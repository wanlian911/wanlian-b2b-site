---
import Layout from '../../layouts/Layout.astro';
import { guidesId } from '../../utils/guides.id';
import { tagsId } from '../../utils/tags.id';

const solutions = [
  { title: 'Sistem hidran kebakaran', description: 'Hidran dalam, luar, dan bawah tanah untuk jaringan kota, fasilitas industri, serta proyek perlindungan kebakaran.', href: '/id/fire-hydrant-systems/' },
  { title: 'Pencegahan aliran balik dan kendali hidraulik', description: 'Perangkat pencegah aliran balik, katup pengurang tekanan, dan katup kendali untuk air bersih serta keselamatan hidraulik.', href: '/id/backflow-prevention/' },
  { title: 'Aplikasi katup dan peralatan', description: 'Solusi untuk air kota, HVAC, irigasi, minyak dan gas, serta jaringan perpipaan industri.', href: '/id/applications/' },
  { title: 'Katup kebakaran UL dan sistem sprinkler', description: 'Katup perlindungan kebakaran, sistem sprinkler, dan monitor kebakaran dengan dukungan teknis.', href: '/id/ul-fire-valves/' },
  { title: 'Monitor air untuk pemadaman kebakaran', description: 'Monitor manual dan otomatis untuk kilang, gudang, bandara, dan area berisiko tinggi.', href: '/id/fire-water-cannon/' },
  { title: 'Sistem sprinkler kebakaran', description: 'Katup alarm basah, katup deluge, sistem pra-aksi, dan indikator aliran untuk perlindungan kebakaran.', href: '/id/fire-sprinkler-systems/' }
];
---
<Layout title="Blog dan Panduan Pengadaan | Wanlian Fluid Equipment" description="Panduan pengadaan teknis dan pengetahuan industri tentang perlindungan kebakaran, katup, dan kendali fluida." locale="id">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4"><span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Blog dan Panduan</span><h1 class="text-4xl font-black text-gray-900 tracking-tight">Panduan pengadaan dan pengetahuan industri</h1><p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">Pengetahuan praktis teknik dan pengadaan untuk proyek perlindungan kebakaran serta kendali fluida.</p></div>
    {guidesId.length > 0 && <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">{guidesId.map(article => <a href={article.href} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition p-8 flex flex-col"><div class="flex items-center gap-3 mb-4"><span class="px-2.5 py-1 bg-brand-blue/10 text-brand-blue text-[11px] font-black rounded-full uppercase tracking-wider">{article.category}</span><span class="text-xs text-gray-400">{article.date} · {article.readTime}</span></div><h2 class="text-lg font-black text-gray-900 group-hover:text-brand-blue transition leading-snug mb-3">{article.title}</h2><p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p><div class="flex flex-wrap gap-2 mt-4">{article.tags.map(tag => <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">#{tagsId[tag]?.name ?? 'Topik industri'}</span>)}</div><span class="mt-6 inline-flex items-center text-brand-red font-bold text-sm">Baca panduan →</span></a>)}</div>}
    <div class="mt-16 mb-8 flex items-center gap-4"><h2 class="text-2xl font-black text-gray-900 tracking-tight">Solusi produk</h2><div class="flex-1 h-px bg-gray-200"></div></div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">{solutions.map(article => <a href={article.href} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition p-8 flex flex-col"><span class="px-2.5 py-1 bg-brand-red/10 text-brand-red text-[11px] font-black rounded-full uppercase tracking-wider w-fit mb-4">Solusi</span><h2 class="text-lg font-black text-gray-900 group-hover:text-brand-red transition leading-snug mb-3">{article.title}</h2><p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p><span class="mt-6 inline-flex items-center text-brand-blue font-bold text-sm">Lihat solusi →</span></a>)}</div>
    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4"><h2 class="text-2xl font-black">Memerlukan konsultasi teknis?</h2><p class="text-gray-400 max-w-xl mx-auto">Insinyur kami membantu Anda memilih katup dan peralatan yang tepat untuk proyek Anda.</p><a href="/id/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-xl">Hubungi insinyur</a></div>
  </main>
</Layout>
