---
import Layout from '../../../layouts/Layout.astro';
const faq = [{ question: 'Berapa lama keseluruhan proses pengadaan?', answer: 'Untuk model yang tersedia, penentuan spesifikasi dan penawaran memerlukan beberapa hari, sampel biasanya 1–3 minggu, dan produksi 15–30 hari. Produk OEM/ODM dapat memerlukan waktu tambahan.' }, { question: 'Dokumen apa yang harus diminta?', answer: 'Mintalah faktur komersial, daftar pengepakan, sertifikat asal, catatan pengujian setiap unit, sertifikat material, dan sertifikat standar yang berlaku.' }];
const steps = [
 { n: '01', title: 'Susun spesifikasi', body: 'Tentukan standar, ukuran, tekanan nominal, material, jumlah, tujuan, dan Incoterm. Spesifikasi yang jelas mengurangi risiko perbedaan.', links: [{ label: 'Glosarium industri', href: '/id/glossary/' }, { label: 'Panduan standar', href: '/id/guides/fire-hydrant-valve-standards-guide/' }] },
 { n: '02', title: 'Kualifikasi dan verifikasi pemasok', body: 'Konfirmasikan badan hukum, sistem ISO 9001, kapasitas produksi, riwayat ekspor, dan sertifikat melalui portal lembaga penerbit.', links: [{ label: 'Daftar periksa pengadaan B2B', href: '/id/guides/b2b-valve-sourcing-checklist/' }, { label: 'Verifikasi pemasok Tiongkok', href: '/id/guides/how-to-verify-chinese-valve-supplier/' }] },
 { n: '03', title: 'Minta dan bandingkan penawaran terperinci', body: 'Bandingkan model, standar, material, jumlah, Incoterm, dan tujuan yang sama. Jangan hanya membandingkan harga satuan; nilai total biaya sampai tujuan.', links: [{ label: 'Kalkulator biaya', href: '/id/cost-calculator/' }] },
 { n: '04', title: 'Pesan sampel dan lakukan inspeksi', body: 'Mintalah satu unit untuk setiap model. Periksa pelat identitas, nomor seri, material, dan uji tekanan sebelum melakukan pemesanan dalam jumlah besar.', links: [{ label: 'Cara memilih hidran', href: '/id/guides/how-to-choose-a-fire-hydrant/' }] },
 { n: '05', title: 'Konfirmasikan produksi, mutu, dan dokumen', body: 'Mintalah jadwal produksi, catatan pengujian setiap unit, kemasan ekspor, dan dokumentasi sebelum pembayaran akhir.', links: [{ label: 'Wanlian Fluid — pabrik dan pengujian', href: '/id/about/' }] },
 { n: '06', title: 'Rencanakan logistik dan purnajual', body: 'Pilih EXW, FOB, CIF, atau DDP sesuai pembagian risiko. Simpan sertifikat dan catatan untuk penerimaan, pemeliharaan, dan suku cadang berikutnya.', links: [{ label: 'Minta penawaran', href: '/id/contact/' }] }
];
---
<Layout title="Panduan Pengadaan: Katup dan Hidran Kebakaran" description="Panduan B2B untuk membeli katup, hidran, dan peralatan kebakaran: spesifikasi, verifikasi, sampel, mutu, dan dokumentasi." type="website" locale="id" faq={faq} breadcrumbs={[{ name: 'Sumber daya' }, { name: 'Panduan pengadaan' }]}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/id/">Beranda</a><span>/</span><span class="text-gray-600">Panduan pengadaan</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Pusat pengadaan B2B</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Cara membeli katup, hidran, dan peralatan kebakaran</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Rangkaian enam tahap untuk membeli dari produsen Tiongkok, mulai dari spesifikasi tertulis hingga dukungan purnajual.</p><div class="bg-blue-50 border border-blue-100 rounded-xl p-5 my-6"><p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-blue">Mengapa mengikuti urutan ini:</strong> risiko utama sering muncul saat perpindahan antara spesifikasi, verifikasi, sampel, dan dokumentasi. Daftar berikut membantu mengidentifikasinya sebelum pembayaran.</p></div>{steps.map(s => <section class="mt-10"><h2 class="text-2xl font-black text-gray-900 mb-3 tracking-tight scroll-mt-24 flex items-center gap-3"><span class="text-brand-red text-2xl tabular-nums">{s.n}</span>{s.title}</h2><p class="text-gray-700 leading-relaxed mb-3">{s.body}</p><div class="flex flex-wrap gap-2">{s.links.map(l => <a href={l.href} class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 text-gray-700 text-xs font-bold rounded-full">{l.label} →</a>)}</div></section>)}<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6">Pertanyaan umum</h2><div class="space-y-4">{faq.map(item => <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>)}</div><div class="mt-12 text-center"><a href="/id/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-lg">Kirim spesifikasi Anda</a></div></article></main>
</Layout>
