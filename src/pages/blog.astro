---
import Layout from '../layouts/Layout.astro';

const articles = [
  {
    title: 'Fire Water Monitor Selection: Manual vs Auto-Tracking (ZDMS) Guide',
    description: 'Manual PS monitors vs auto-tracking ZDMS cannons — range, flow, detection, response time and cost comparison for industrial and large-space protection.',
    href: '/guides/fire-water-monitor-selection-guide/',
    date: '2026',
    category: 'Fire Protection',
    readTime: '6 min read'
  },
  {
    title: 'Fire Sprinkler System Valves: A Complete Guide (Wet, Deluge & Pre-action)',
    description: 'How ZSFZ wet alarm, ZSFM deluge, ZSFY pre-action valves and ZSJZ flow indicators work — and when to specify each for your sprinkler system.',
    href: '/guides/fire-sprinkler-system-valves-guide/',
    date: '2026',
    category: 'Fire Protection',
    readTime: '7 min read'
  },
  {
    title: 'B2B Valve Sourcing Checklist: How to Verify a Fire Equipment Manufacturer',
    description: '8-point diligence checklist for verifying valve manufacturers — certificates, batch test reports, factory audits, samples and red flags when sourcing from China.',
    href: '/guides/b2b-valve-sourcing-checklist/',
    date: '2026',
    category: 'Procurement',
    readTime: '6 min read'
  },
  {
    title: 'How to Choose UL Listed Fire Valves for Your Project (2026 Guide)',
    description: 'What UL listing really means, UL vs FM, which valve types are listed, how to verify genuine certificates and a procurement checklist for B2B buyers.',
    href: '/guides/how-to-choose-ul-listed-fire-valves/',
    date: '2026',
    category: 'Fire Protection',
    readTime: '7 min read'
  },
  {
    title: 'Fire Water Cannon Buying Guide: Fixed, Remote or Smart? (2026)',
    description: 'When you need a water cannon, fixed vs remote vs auto-tracking, sizing flow and range, control integration and a site-based procurement checklist.',
    href: '/guides/fire-water-cannon-buying-guide/',
    date: '2026',
    category: 'Fire Protection',
    readTime: '6 min read'
  },
  {
    title: 'Fire Sprinkler Systems: Wet, Dry or Pre-action? (2026 Guide)',
    description: 'A practical comparison of wet, dry and pre-action systems, how to select sprinkler heads (K-factor, temperature, response) and the components your BOM needs.',
    href: '/guides/fire-sprinkler-system-wet-dry-preaction/',
    date: '2026',
    category: 'Fire Protection',
    readTime: '7 min read'
  },
  {
    title: 'How to Choose a Fire Hydrant for Municipal & Industrial Projects (2026 Guide)',
    description: 'A step-by-step procurement guide covering hydrant types, pressure classes, connection standards, certification requirements and the factory checklist before you order.',
    href: '/guides/how-to-choose-a-fire-hydrant/',
    date: '2026',
    category: 'Fire Protection',
    readTime: '8 min read'
  }
];
---

<Layout
  title="Blog & Buying Guides | Wanlian Fluid Equipment"
  description="Technical buying guides and industry knowledge for fire protection equipment, industrial valves and fluid control systems from Quanzhou Wanlian Fluid."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Blog & Guides</span>
      <h1 class="text-4xl font-black text-gray-900 tracking-tight">Buying Guides &amp; Industry Knowledge</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
        Practical engineering and procurement knowledge for fire protection and fluid control projects.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {articles.map(article => (
        <a
          href={article.href}
          class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-8 flex flex-col"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2.5 py-1 bg-brand-blue/10 text-brand-blue text-[11px] font-black rounded-full uppercase tracking-wider">{article.category}</span>
            <span class="text-xs text-gray-400">{article.date} · {article.readTime}</span>
          </div>
          <h2 class="text-lg font-black text-gray-900 group-hover:text-brand-blue transition leading-snug mb-3">
            {article.title}
          </h2>
          <p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p>
          <span class="mt-6 inline-flex items-center text-brand-red font-bold text-sm group-hover:gap-2 transition-all">
            Read Guide
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4">
      <h2 class="text-2xl font-black">Need Product-Specific Technical Advice?</h2>
      <p class="text-gray-400 max-w-xl mx-auto">
        Our engineers help you select the right valves and fire protection equipment for your project.
      </p>
      <a href="/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-xl hover:opacity-90 transition">
        Ask an Engineer
      </a>
    </div>
  </main>
</Layout>
