---
import Layout from '../layouts/Layout.astro';
import { guides } from '../utils/guides';

// 系统/方案落地页(非指南文章,单独分组展示)
const solutions = [
  {
    title: 'Fire Hydrant Systems Product Solution',
    description: 'Indoor, outdoor, anti-collision and IoT smart fire hydrants for municipal networks, industrial yards and smart city grids.',
    href: '/fire-hydrant-systems/',
    date: '2026',
    category: 'Product Solutions',
    readTime: '5 min read'
  },
  {
    title: 'Backflow Prevention & Hydraulic Control Solution',
    description: 'Backflow preventers, pressure reducing valves, level control valves and solenoid control valves for potable water and hydraulic safety.',
    href: '/backflow-prevention/',
    date: '2026',
    category: 'Product Solutions',
    readTime: '5 min read'
  },
  {
    title: 'Applications: Fire Protection, Water Networks and Industrial Pipelines',
    description: 'Explore product selection by application, from municipal water supply and HVAC to petrochemical, warehousing and marine projects.',
    href: '/applications/',
    date: '2026',
    category: 'Applications',
    readTime: '5 min read'
  },
  {
    title: 'UL Listed Fire Valves, Sprinkler Systems and Water Cannons',
    description: 'Browse Wanlian solution pages for UL fire valves, fire sprinkler systems and fire water cannons, with technical guidance and RFQ links.',
    href: '/ul-fire-valves/',
    date: '2026',
    category: 'Product Solutions',
    readTime: '5 min read'
  },
  {
    title: 'Fire Water Cannon Product Solution',
    description: 'Review Wanlian manual and automatic fire water cannon options for petrochemical plants, warehouses, airports and other high-risk sites.',
    href: '/fire-water-cannon/',
    date: '2026',
    category: 'Product Solutions',
    readTime: '5 min read'
  },
  {
    title: 'Fire Sprinkler Systems Product Solution',
    description: 'Explore wet alarm, deluge, pre-action and flow-indicator components for commercial, industrial and warehouse sprinkler systems.',
    href: '/fire-sprinkler-systems/',
    date: '2026',
    category: 'Product Solutions',
    readTime: '5 min read'
  }
];
---

<Layout
  title="Blog & Buying Guides | Wanlian Fluid Equipment"
  description="Technical buying guides and industry knowledge for fire protection equipment, industrial valves and fluid control systems from Quanzhou Wanlian Fluid."
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Blog & Guides</span>
      <h1 class="text-4xl font-black text-gray-900 tracking-tight">Buying Guides &amp; Industry Knowledge</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
        Practical engineering and procurement knowledge for fire protection and fluid control projects.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {guides.map(article => (
        <a
          href={article.href}
          class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-8 flex flex-col"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2.5 py-1 bg-brand-blue/10 text-brand-blue text-[11px] font-black rounded-full uppercase tracking-wider">{article.category}</span>
            <span class="text-xs text-gray-400">{article.date} · {article.readTime}</span>
          </div>
          <h2 class="text-lg font-black text-gray-900 group-hover:text-brand-blue transition leading-snug mb-3">
            {article.title}
          </h2>
          <p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p>
          <div class="flex flex-wrap gap-2 mt-4">
            {article.tags.map(tag => (
              <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">#{tag.replace(/-/g, ' ')}</span>
            ))}
          </div>
          <span class="mt-6 inline-flex items-center text-brand-red font-bold text-sm group-hover:gap-2 transition-all">
            Read Guide
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-16 mb-8 flex items-center gap-4">
      <h2 class="text-2xl font-black text-gray-900 tracking-tight">Product Solutions</h2>
      <div class="flex-1 h-px bg-gray-200"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {solutions.map(article => (
        <a
          href={article.href}
          class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-red/30 transition p-8 flex flex-col"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2.5 py-1 bg-brand-red/10 text-brand-red text-[11px] font-black rounded-full uppercase tracking-wider">{article.category}</span>
            <span class="text-xs text-gray-400">{article.date} · {article.readTime}</span>
          </div>
          <h2 class="text-lg font-black text-gray-900 group-hover:text-brand-red transition leading-snug mb-3">
            {article.title}
          </h2>
          <p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p>
          <span class="mt-6 inline-flex items-center text-brand-blue font-bold text-sm group-hover:gap-2 transition-all">
            View Solution
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4">
      <h2 class="text-2xl font-black">Need Product-Specific Technical Advice?</h2>
      <p class="text-gray-400 max-w-xl mx-auto">
        Our engineers help you select the right valves and fire protection equipment for your project.
      </p>
      <a href="/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-xl hover:opacity-90 transition">
        Ask an Engineer
      </a>
    </div>
  </main>
</Layout>
