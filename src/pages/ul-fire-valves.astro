---
import Layout from '../layouts/Layout.astro';

const faq = [
	{
		question: 'What does UL listed mean for fire valves?',
		answer: 'UL listing verifies that a valve meets UL/ULC fire protection standards for flow, pressure rating and durability, ensuring reliable performance in sprinkler and standpipe systems. It is a mandatory requirement for most North American and many international projects.'
	},
	{
		question: 'Which fire valves does Wanlian supply with UL listing?',
		answer: 'We supply gate, butterfly, check, deluge and pre-action valves in flanged, grooved and threaded connections from DN40 to DN300. Contact our sales team with your project specification to match the correct valve type and certification package.'
	},
	{
		question: 'Can you provide the UL certificate before ordering?',
		answer: 'Yes. Our UL/ULC and FM certificates are available on request — see our Certificates page for reference, and our engineers will confirm the exact certification that applies to your destination market before quoting.'
	},
	{
		question: 'What is your MOQ and lead time for fire valves?',
		answer: 'MOQ depends on valve type and size — typically 10–20 units per model for stock sizes, with production lead times of 15–30 days. Sample orders are available for pre-shipment testing and approval.'
	},
	{
		question: 'Do you support OEM/private label for fire valves?',
		answer: 'Yes, we support OEM/ODM with custom branding, packaging and specification adjustments per project requirements. Our cooperative manufacturing bases follow the ISO 9001 quality management system.'
	}
];

const valveProducts = [
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Resilient Seat Gate Valve (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.jpg',
		desc: 'EPDM encapsulated wedge, bubble-tight shutoff, DN50–DN700'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Signal Grooved Wafer Butterfly Valve',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.jpg',
		desc: 'DN80 PN16 with integrated status monitoring switch'
	},
	{
		slug: 'sliding-ball-check-valve-hq41x',
		name: 'Sliding Ball Check Valve (HQ41X)',
		img: '/assets/products/spherical-ball-check-valve-hq44x.jpg',
		desc: 'Low head loss, non-clogging rolling ball design'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Deluge Alarm Valve Group (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.png',
		desc: 'Diaphragm-operated, DN50–DN300, fast opening'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Pre-action Alarm System (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Dual-trigger failsafe for water-sensitive rooms'
	}
];
---

<Layout
	title="UL Listed Fire Valves | UL Fire Valve Supplier - WLFE"
	description="WLFE supplies UL listed fire valves: gate, butterfly, check, deluge and pre-action types with certified quality and fast quotation. Request a quote."
	type="product"
	productData={{
		name: 'UL Listed Fire Valves',
		image: '/assets/products/resilient-seat-flanged-gate-valve-z41x.jpg',
		description: 'UL listed gate, butterfly, check, deluge and pre-action valves for fire protection systems, supplied by Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'UL Fire Valves' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/" class="hover:text-blue-600">Home</a>
			<span>/</span>
			<a href="/products/" class="hover:text-blue-600">Products</a>
			<span>/</span>
			<span class="text-gray-600">UL Fire Valves</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">UL Certified Fire Protection Valves</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">UL Listed Fire Valves for Dependable Fire Protection Systems</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid supplies UL listed gate, butterfly, check, deluge and pre-action valves for commercial and industrial fire protection systems. Every valve is manufactured under the ISO 9001 quality system, factory-direct with stable lead times and full certification documentation for your project.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['UL/ULC Listed', 'FM Approved', 'ISO 9001:2015', 'Factory Direct'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Fire Valve Series</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{valveProducts.map(p => (
					<a href={`/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Key Specifications</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Specification</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Details</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Standards</td>
							<td class="px-4 py-3 text-gray-700">UL / ULC Listed, FM Approved (per model and destination market)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Size range</td>
							<td class="px-4 py-3 text-gray-700">DN40 – DN300 (1½" – 12")</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Pressure rating</td>
							<td class="px-4 py-3 text-gray-700">PN16 / PN25 (per model)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Body material</td>
							<td class="px-4 py-3 text-gray-700">Ductile iron QT450 / WCB / CF8 · CF8M stainless steel</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">End connections</td>
							<td class="px-4 py-3 text-gray-700">Flanged / Grooved / Threaded</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Media</td>
							<td class="px-4 py-3 text-gray-700">Water, foam solution</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Applications</h2>
			<p class="text-gray-700 leading-relaxed">Our UL fire valves are installed in commercial building sprinkler systems, industrial plants, warehousing and logistics centres, data centres and petrochemical fire mains — wherever certified, reliable flow control is a code requirement.</p>

			<!-- Why WLFE -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Why Choose Wanlian Fluid</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Certified quality</strong> — UL/ULC and FM certificates published on our <a href="/certificates/" class="text-brand-blue font-semibold hover:underline">certificates page</a>, verifiable before you order.</li>
				<li><strong>Factory direct</strong> — stable lead times, OEM/ODM support and engineering selection assistance.</li>
				<li><strong>One-stop supply</strong> — valves supplied together with sprinkler heads, hydrants and accessories for the complete suppression loop.</li>
			</ul>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Frequently Asked Questions</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Need UL Fire Valves for Your Project?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Send us your valve type, DN/PN and target certification — our engineers reply with a full datasheet and quotation within 12 hours.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/contact/?product=UL%20Fire%20Valves" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Request a Quote</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20UL%20listed%20fire%20valves" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat on WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
