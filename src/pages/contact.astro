---
import Layout from '../layouts/Layout.astro';
import InquiryForm from '../components/inquiry/InquiryForm.astro';

const productName = Astro.url.searchParams.get('product') || "";
---

<Layout title="Contact Us | Instant B2B Inquiry | Quanzhou Wanlian Fluid">
  <main id="inquiry" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Contact & Inquiry</span>
      <h1 class="text-4xl font-black text-gray-900 tracking-tight">Request a Professional Quote</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
         Share your product requirements, standards, sizes, and target application. Our sales and engineering team will review the details and respond with the next steps.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div>
          <h3 class="text-xs font-bold text-gray-400 tracking-widest uppercase mb-2">Company Location</h3>
           <p class="text-lg font-bold text-gray-900">Quanzhou Wanlian Fluid Equipment Co., Ltd.</p>
           <p class="text-gray-500 mt-2 text-sm leading-relaxed">
             Quanzhou, Fujian Province, China
           </p>
        </div>

        <div>
          <h3 class="text-xs font-bold text-gray-400 tracking-widest uppercase mb-3">Direct Channels</h3>
          <ul class="space-y-3 text-sm text-gray-600">
            <li class="flex items-center">
              <span class="font-semibold text-gray-900 w-20">Sales Email:</span>
              <a href="mailto:dhuog77@gmail.com" class="text-blue-600 hover:underline">dhuog77@gmail.com</a>
            </li>
            <li class="flex items-center">
              <span class="font-semibold text-gray-900 w-20">Hotline:</span>
              <a href="tel:+8618684324501" class="text-blue-600 hover:underline">+86 186 8432 4501</a>
            </li>
            <li class="flex items-center">
              <span class="font-semibold text-gray-900 w-20">WhatsApp:</span>
              <a href="https://wa.me/8618684324501" target="_blank" rel="noopener noreferrer" class="text-green-600 font-bold hover:underline">+86 186 8432 4501</a>
            </li>
          </ul>
        </div>

        <div class="bg-blue-50/50 p-8 rounded-xl border border-blue-100/50 space-y-4">
          <h3 class="font-bold text-blue-900 text-base">Why Partner with Wanlian?</h3>
          <ul class="space-y-3 text-sm text-blue-700 font-medium">
              <li class="flex items-center gap-2">
               <span class="text-blue-500 font-bold">✓</span> Product selection support for fluid systems
             </li>
             <li class="flex items-center gap-2">
               <span class="text-blue-500 font-bold">✓</span> OEM/ODM requirements can be discussed
             </li>
             <li class="flex items-center gap-2">
               <span class="text-blue-500 font-bold">✓</span> Product specifications and documentation support
             </li>
             <li class="flex items-center gap-2">
               <span class="text-blue-500 font-bold">✓</span> Export packaging and shipping coordination
             </li>
          </ul>
        </div>
      </div>

      <!-- Form Area -->
      <div class="lg:col-span-2 bg-white p-10 rounded-2xl border border-gray-100 shadow-sm">
        <h2 class="text-xl font-bold text-gray-900 mb-6">Submit RFQ / Inquiry Form</h2>
        <InquiryForm productName={productName} />
      </div>
    </div>
  </main>
</Layout>
