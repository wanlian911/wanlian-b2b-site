---
// Staging comparison homepage: C0068-derived visual system applied to the real
// site data. Kept off the index (see astro.config.mjs NO_INDEXED) and out of
// src/pages/index.astro so the approved homepage is untouched.
import Layout from '../../../layouts/Layout.astro';
import InquiryForm from '../../../components/inquiry/InquiryForm.astro';
import { products } from '../../../utils/products';

type Clip = { src: string; poster: string; title: string; desc: string };

const clips: Clip[] = [
  { src: '/videos/factory/assembly.mp4', poster: '/videos/factory/assembly-poster.webp', title: 'Assembly', desc: 'Torque-checked bolting on hydraulic control valves' },
  { src: '/videos/factory/blue-valves.mp4', poster: '/videos/factory/blue-valves-poster.webp', title: 'Inspection', desc: 'Pressure-tested units lined up for dispatch' },
  { src: '/videos/factory/red-field.mp4', poster: '/videos/factory/red-field-poster.webp', title: 'Ready Stock', desc: 'Finished hydrants queued and awaiting shipment' },
  { src: '/videos/factory/loading-close.mp4', poster: '/videos/factory/loading-close-poster.webp', title: 'Packing & Loading', desc: 'Export order on the dock, boxed and banded' },
  { src: '/videos/factory/dispatch.mp4', poster: '/videos/factory/dispatch-poster.webp', title: 'Dispatch', desc: 'Full truckload leaving the plant for the port' },
];

const introClip: Clip = {
  src: '/videos/company-intro.mp4',
  poster: '/videos/company-intro-poster.webp',
  title: 'Inside the plant',
  desc: 'Showroom, production lines, OEM customisation and the test bench, in under a minute.',
};

const walkthroughClip: Clip = {
  src: '/assets/projects/project-walkthrough.mp4',
  poster: '/assets/projects/pump-room-wide.webp',
  title: 'Installed pump room',
  desc: 'Vertical walk-through of a completed installation.',
};

type Line = { name: string; href: string; count: number; image: string; firstName: string; firstSlug: string };

const lines: Line[] = [];
for (const p of products) {
  let group = lines.find((l) => l.name === p.category);
  if (!group) {
    group = {
      name: p.category,
      href: '/products/#category=' + encodeURIComponent(p.category),
      count: 0,
      image: p.image,
      firstName: p.name,
      firstSlug: p.slug,
    };
    lines.push(group);
  }
  group.count += 1;
}

const modelIndex = lines.map((l) => ({
  name: l.name,
  href: l.href,
  items: products.filter((p) => p.category === l.name).map((p) => ({ name: p.name, href: '/products/' + p.slug + '/' })),
}));

const stats = [
  { value: String(products.length), unit: '', label: 'Model numbers published in the catalogue' },
  { value: String(lines.length), unit: 'lines', label: 'Core product lines, valves to fire systems' },
  { value: '12', unit: 'hours', label: 'Standard turnaround on an itemized quotation' },
  { value: '100', unit: '%', label: 'Units pressure tested before dispatch' },
];

const capability = [
  { icon: 'valve', title: 'In-house production lines', body: 'Gate, check, butterfly, hydrant and alarm-valve families built on our own lines in Quanzhou, Fujian.' },
  { icon: 'gauge', title: 'Tested and documented', body: 'Shell and seat pressure testing on every batch, with the test record supplied alongside the shipment documents.' },
  { icon: 'cog', title: 'OEM and ODM', body: 'Non-standard sizes, materials and end connections; branding, export packaging and the documentation set on request.' },
  { icon: 'doc', title: 'Itemized quotation', body: 'Unit price, stock position and lead time per line item, answered seven days a week from one desk.' },
];

const processSteps = [
  { n: '01', title: 'Precision Weaving', body: 'Hose and lining stock woven to the order specification before it moves on to bonding.' },
  { n: '02', title: 'Lining Bonding', body: 'Liner and reinforcement bonded under controlled pressure and cure time.' },
  { n: '03', title: 'CNC Machining', body: 'Bodies, discs and stems machined on CNC centres to the drawing tolerance.' },
  { n: '04', title: 'Assembly', body: 'Seat, trim and stem assembled with torque control and a bench check.' },
  { n: '05', title: 'Safety Testing', body: 'Shell and seat pressure test on every unit before it is released for coating.' },
  { n: '06', title: 'Epoxy Coating', body: 'Internal and external epoxy coating, then export packing at the dock.' },
];

const industries = [
  { icon: 'flame', title: 'Fire Protection', body: 'Hydrants, sprinklers, alarm valves, hose systems and cabinets for new builds and retrofits.' },
  { icon: 'drop', title: 'Water Treatment', body: 'Gate, butterfly and hydraulic control valves across treatment and transmission duty.' },
  { icon: 'pipe', title: 'Oil & Gas', body: 'Flanged and grooved isolation for process, utility and firewater loops.' },
  { icon: 'building', title: 'HVAC & Industrial Piping', body: 'Balancing, check and control valves for plant rooms and industrial pipelines.' },
];

const shots = [
  { src: '/assets/projects/valve-train.webp', caption: 'Valve train' },
  { src: '/assets/projects/riser-grid.webp', caption: 'Riser grid' },
  { src: '/assets/projects/pump-skids.webp', caption: 'Pump skids' },
  { src: '/assets/projects/pump-aisle.webp', caption: 'Pump aisle' },
];

const factorySide = [
  { src: '/assets/factory/workshop.webp', caption: 'Workshop' },
];

const qualitySide = [
  { src: '/assets/factory/powder-coating.webp', caption: 'Coating line' },
  { src: '/assets/factory/fire-hose.webp', caption: 'Fire hose' },
];

const certs = ['ISO 9001', 'GB', 'ANSI', 'DIN', 'JIS'];

const svgOpen = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">';
const icons: Record<string, string> = {
  valve: svgOpen + '<path d="M4 16 12 9l8 7H4Z"/><path d="M12 9V4"/><path d="M8.5 4h7"/></svg>',
  gauge: svgOpen + '<circle cx="12" cy="10" r="6"/><path d="M12 10l3.2-2.6"/><path d="M6 20h12"/></svg>',
  cog: svgOpen + '<circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.4M12 18.6V21M3 12h2.4M18.6 12H21M5.6 5.6l1.7 1.7M16.7 16.7l1.7 1.7M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7"/></svg>',
  doc: svgOpen + '<path d="M7 3h7l4 4v14H7V3Z"/><path d="M14 3v4h4"/><path d="M10 12h6M10 16h6"/></svg>',
  flame: svgOpen + '<path d="M12 3c3 4 5 6 5 9a5 5 0 0 1-10 0c0-2.2 1.1-3.8 2.6-5.2"/></svg>',
  drop: svgOpen + '<path d="M12 3l5.4 7a6.4 6.4 0 1 1-10.8 0L12 3Z"/></svg>',
  pipe: svgOpen + '<path d="M3 8.5h7v7H3zM14 8.5h7v7h-7z"/><path d="M10 12h4"/><path d="M3 8.5v7M21 8.5v7"/></svg>',
  building: svgOpen + '<path d="M4 21V6l8-3v18"/><path d="M12 21h8V11l-8-3"/><path d="M7 9h2M7 13h2M16 14h2M16 17h2"/></svg>',
};
const tick = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9 17.5 20 6.5"/></svg>';
---

<Layout
  title="Home Variant B (C0068) - WLFE"
  description="Dark blue and bright red modular-card homepage variant for Wanlian Fluid, built from the existing catalog, factory photos and plant videos."
  noindex
  type="website"
  locale="en"
>
  <div class="c68">

    <section class="c68-hero">
      <div class="c68-wrap c68-hero-grid">
        <div class="c68-rv">
          <p class="c68-eyebrow"><span class="c68-dot"></span>Manufacturer &amp; Exporter &mdash; Valves &amp; Fire Protection</p>
          <h1>Valves &amp; fire protection equipment <em>for global projects.</em></h1>
          <p class="c68-rule" aria-hidden="true"></p>
          <p class="c68-lede">Industrial valves, hydrants, alarm valves and hose systems built on our own lines in Quanzhou. Send the specification &mdash; you get an itemized quotation, stock position and lead time inside 12 hours.</p>
          <div class="c68-cta">
            <a class="c68-btn c68-btn-red" href="#lines">Explore product lines</a>
            <a class="c68-btn c68-btn-ghost" href="/contact/">Request a quotation</a>
          </div>
        </div>
        <figure class="c68-frame c68-rv">
          <span class="c68-frame-tab"></span>
          <img src="/assets/factory/plant-exterior.webp" alt="Wanlian Fluid plant exterior in Quanzhou, Fujian" decoding="async" />
          <figcaption>OUR PLANT &mdash; QUANZHOU, FUJIAN</figcaption>
        </figure>
      </div>
      <div class="c68-stats">
        <div class="c68-wrap c68-stats-grid">
          {stats.map((s) => (
            <div class="c68-stat">
              <p class="c68-stat-num">{s.value}<span>{s.unit}</span></p>
              <p class="c68-stat-label">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="lines">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Browse by product line</p>
          <h2>{lines.length} product lines, <em>one specification desk.</em></h2>
          <p class="c68-head-sub">Every card opens the catalogue filtered to that line. Model counts are read from the catalogue at build time, not typed in by hand.</p>
        </header>
        <div class="c68-lines">
          {lines.map((l) => (
            <a class="c68-line c68-rv" href={l.href}>
              <span class="c68-line-media"><img src={l.image} alt={l.firstName} loading="lazy" decoding="async" /></span>
              <span class="c68-line-body">
                <span class="c68-line-count">{l.count} models</span>
                <span class="c68-line-name">{l.name}</span>
                <span class="c68-line-more">Open this line <i aria-hidden="true">&rarr;</i></span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band">
      <div class="c68-wrap">
        <div class="c68-cap-grid">
          {capability.map((c) => (
            <article class="c68-cap c68-rv">
              <span class="c68-ico" set:html={icons[c.icon]}></span>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="process">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Production workflow</p>
          <h2>From weaving to <em>coating and test.</em></h2>
        </header>
        <ol class="c68-steps">
          {processSteps.map((s) => (
            <li class="c68-step c68-rv">
              <span class="c68-step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="c68-band c68-dark" id="factory">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker c68-kicker-red">Factory live</p>
          <h2>Real footage from <em>the Quanzhou plant.</em></h2>
          <p class="c68-head-sub">No stock video and nothing staged. Press play on any frame; the clips are served from this site.</p>
        </header>
        <div class="c68-video-lead">
          <figure class="c68-vid c68-rv">
            <video src={introClip.src} poster={introClip.poster} controls playsinline preload="none"></video>
            <figcaption><strong>{introClip.title}</strong><span>{introClip.desc}</span></figcaption>
          </figure>
          <div class="c68-side">
            <ul class="c68-video-note">
              <li>Assembly, test bench, ready stock, packing and dispatch below.</li>
              <li>Live walk-through of the line during production on request.</li>
              <li>Pre-shipment third-party inspection arranged at your instruction.</li>
            </ul>
            <div class="c68-side-shots">
              {factorySide.map((s) => (
                <figure class="c68-sshot c68-rv">
                  <img src={s.src} alt={s.caption} loading="lazy" decoding="async" />
                  <figcaption>{s.caption}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        </div>
        <div class="c68-clips">
          {clips.map((c) => (
            <figure class="c68-clip c68-rv">
              <video src={c.src} poster={c.poster} controls playsinline preload="none"></video>
              <figcaption><strong>{c.title}</strong><span>{c.desc}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Where they are used</p>
          <h2>Built for <em>high-pressure duty.</em></h2>
        </header>
        <div class="c68-ind">
          {industries.map((i) => (
            <article class="c68-ind-card c68-rv">
              <span class="c68-ico" set:html={icons[i.icon]}></span>
              <h3>{i.title}</h3>
              <p>{i.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="quality">
      <div class="c68-wrap c68-quality-grid">
        <div class="c68-rv">
          <header class="c68-head">
            <p class="c68-kicker">Quality and scope</p>
            <h2>Tested every unit, <em>documented every lot.</em></h2>
          </header>
          <ul class="c68-ticks">
            <li set:html={tick + '<span>Shell and seat pressure test on every unit before dispatch</span>'}></li>
            <li set:html={tick + '<span>Material certificates and test records with the export set</span>'}></li>
            <li set:html={tick + '<span>Pre-shipment third-party inspection arranged at your instruction</span>'}></li>
            <li set:html={tick + '<span>OEM / ODM branding, export packaging and full documentation</span>'}></li>
          </ul>
          <p class="c68-scope">Listing and approval scope is granted per model. Where your specification names a listed item, we source it from the factory holding that listing and provide the holder&rsquo;s name and certificate copy before production.</p>
          <div class="c68-chips">
            {certs.map((c) => (<span class="c68-chip">{c}</span>))}
            <a class="c68-chip c68-chip-link" href="/certificates/">Certificates &amp; scope &rarr;</a>
          </div>
        </div>
        <div class="c68-shots">
          {qualitySide.map((s) => (
            <figure class="c68-shot c68-rv">
              <img src={s.src} alt={s.caption} loading="lazy" decoding="async" />
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band" id="projects">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Project cases</p>
          <h2>Our equipment, <em>on site.</em></h2>
          <p class="c68-head-sub">Photographed on completed installations. Client names and project references are available on request.</p>
        </header>
        <div class="c68-proj-grid">
          <figure class="c68-vid c68-vid-tall c68-rv">
            <video src={walkthroughClip.src} poster={walkthroughClip.poster} controls playsinline preload="none"></video>
            <figcaption><strong>{walkthroughClip.title}</strong><span>{walkthroughClip.desc}</span></figcaption>
          </figure>
          <div class="c68-proj-cards">
            {shots.map((s) => (
              <figure class="c68-pcard c68-rv">
                <img src={s.src} alt={s.caption} loading="lazy" decoding="async" />
                <figcaption>{s.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="index">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Full model index</p>
          <h2>Every published <em>model number.</em></h2>
        </header>
        <div class="c68-index">
          {modelIndex.map((g) => (
            <div class="c68-index-col c68-rv">
              <p class="c68-index-head"><a href={g.href}>{g.name}</a><span>{g.items.length}</span></p>
              <ul>
                {g.items.map((it) => (<li><a href={it.href}>{it.name}</a></li>))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-dark" id="inquiry">
      <div class="c68-wrap c68-rfq-grid">
        <div class="c68-rv">
          <p class="c68-kicker c68-kicker-red">Request a quotation</p>
          <h2>Send the spec.<br /><span class="c68-plate">Get an itemized quote in 12 hours.</span></h2>
          <p class="c68-head-sub">Model or standard, size, pressure class, material, quantity and destination &mdash; or simply a drawing or a photograph. Our engineers answer with unit prices, stock position and lead time, seven days a week.</p>
          <div class="c68-rfq-links">
            <a class="c68-btn c68-btn-red" href="/contact/">Open the contact page</a>
            <a class="c68-btn c68-btn-ghost" href="/products/">Browse the catalogue</a>
          </div>
          <p class="c68-fine">QUANZHOU WANLIAN FLUID EQUIPMENT CO., LTD. &middot; FOB &middot; CIF &middot; T/T</p>
        </div>
        <div class="c68-rv">
          <InquiryForm locale="en" />
        </div>
      </div>
    </section>

  </div>

  <script is:inline>
    const root = document.documentElement;
    const marks = Array.from(document.querySelectorAll('.c68-rv'));
    root.classList.add('c68-js');
    const showAll = () => marks.forEach((m) => m.classList.add('c68-in'));
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('c68-in'); io.unobserve(e.target); }
        }
      }, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });
      marks.forEach((m) => io.observe(m));
      setTimeout(showAll, 1500);
    } else {
      showAll();
    }
  </script>

  <style is:inline>
    .c68 { --navy: #004797; --navy-deep: #00306b; --navy-ink: #00204a; --red: #cc2128; --mist: #f1f3f7; --ink: #1c2735; --muted: #5c6879; --line: #dde2ea; }
    .c68-wrap { width: 100%; max-width: 1240px; margin: 0 auto; padding: 0 24px; }
    .c68-band { padding: 84px 0; background: #fff; }
    .c68-band-mist { background: var(--mist); }
    .c68-dark { background: var(--navy-ink); color: #fff; }
    .c68-head { max-width: 640px; margin-bottom: 40px; }
    .c68-kicker { font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: var(--red); font-weight: 700; margin: 0 0 12px; }
    .c68-kicker::before { content: ''; display: inline-block; width: 28px; height: 2px; background: var(--red); vertical-align: middle; margin-right: 12px; }
    .c68-head h2, .c68-rfq-grid h2 { font-size: clamp(28px, 4vw, 44px); line-height: 1.08; letter-spacing: -.01em; font-weight: 800; text-transform: uppercase; margin: 0; color: var(--navy-ink); }
    .c68-head h2 em, .c68-rfq-grid h2 em { font-style: normal; color: var(--red); }
    .c68-head-sub { font-size: 15px; line-height: 1.7; color: var(--muted); margin: 16px 0 0; }
    .c68-dark .c68-head h2 { color: #fff; }
    .c68-dark .c68-head-sub { color: #b9c6d8; }
    .c68-kicker-red { color: #ff8b90; }
    .c68-kicker-red::before { background: var(--red); }
    .c68-plate { color: #fff; background: var(--red); display: inline-block; padding: 0 10px 4px; }

    .c68-hero { background: linear-gradient(160deg, var(--navy) 0%, var(--navy-deep) 62%, var(--navy-ink) 100%); color: #fff; }
    .c68-hero-grid { display: grid; gap: 48px; align-items: center; padding-top: 84px; padding-bottom: 76px; }
    .c68-eyebrow { display: inline-block; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.18); padding: 8px 14px; margin: 0 0 26px; }
    .c68-dot { display: inline-block; width: 6px; height: 6px; background: var(--red); border-radius: 50%; margin-right: 10px; vertical-align: middle; }
    .c68-hero-grid h1 { font-size: clamp(32px, 5vw, 56px); line-height: 1.05; text-transform: uppercase; letter-spacing: -.015em; font-weight: 800; margin: 0; color: #fff; }
    .c68-hero-grid h1 em { font-style: normal; color: #fff; }
    .c68-rule { width: 64px; height: 4px; background: var(--red); margin: 22px 0 24px; }
    .c68-lede { font-size: 17px; line-height: 1.7; color: #d3ddea; max-width: 44ch; margin: 0 0 30px; }
    .c68-cta { display: flex; gap: 14px; flex-wrap: wrap; }
    .c68-btn { display: inline-block; font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; padding: 15px 24px; text-decoration: none; transition: transform .18s ease, background .18s ease; }
    .c68-btn:hover { transform: translateY(-2px); }
    .c68-btn-red { background: var(--red); color: #fff; }
    .c68-btn-red:hover { background: #b01b21; }
    .c68-btn-ghost { border: 1px solid rgba(255,255,255,.4); color: #fff; }
    .c68-btn-ghost:hover { border-color: #fff; background: rgba(255,255,255,.08); }
    .c68-frame { position: relative; margin: 0; padding: 14px; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.16); }
    .c68-frame-tab { position: absolute; top: -1px; left: -1px; width: 54px; height: 8px; background: var(--red); }
    .c68-frame img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
    .c68-frame figcaption { display: block; font-size: 11px; letter-spacing: .16em; color: #b9c6d8; padding-top: 12px; }

    .c68-stats { background: var(--red); }
    .c68-stats-grid { display: grid; gap: 1px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    .c68-stat { padding: 30px 24px; border-left: 1px solid rgba(255,255,255,.28); }
    .c68-stat:first-child { border-left: 0; padding-left: 0; }
    .c68-stat-num { font-size: 40px; font-weight: 800; line-height: 1; margin: 0 0 8px; }
    .c68-stat-num span { font-size: 15px; font-weight: 700; margin-left: 4px; }
    .c68-stat-label { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; line-height: 1.6; margin: 0; color: rgba(255,255,255,.9); }

    .c68-lines { display: grid; gap: 22px; grid-template-columns: repeat(auto-fit, minmax(268px, 1fr)); }
    .c68-line { display: block; background: #fff; border: 1px solid var(--line); text-decoration: none; color: inherit; transition: box-shadow .2s ease, transform .2s ease; }
    .c68-line:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(0,32,74,.12); }
    .c68-line-media { display: block; height: 190px; background: #fff; border-bottom: 1px solid var(--line); }
    .c68-line-media img { width: 100%; height: 100%; object-fit: contain; padding: 14px; }
    .c68-line-body { display: block; padding: 20px; }
