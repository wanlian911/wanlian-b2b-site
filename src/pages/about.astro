---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';

// Factory evidence assets are dropped into public/assets/factory/.
// The section only renders for files that actually exist, so the live site
// never shows a broken image or an empty placeholder before assets arrive.
const factoryDir = path.join(process.cwd(), 'public', 'assets', 'factory');
const hasFactoryAsset = (file) => fs.existsSync(path.join(factoryDir, file));

const plantPhotos = [
  { file: 'plant-exterior.webp', alt: 'Wanlian Fluid manufacturing plant exterior in Quanzhou, Fujian', caption: 'Our plant — Quanzhou, Fujian' },
  { file: 'workshop.webp', alt: 'Sheet-metal bending area with press brakes and overhead gantry crane in the Wanlian Fluid workshop', caption: 'Bending area — press brakes and gantry crane' },
  { file: 'powder-coating.webp', alt: 'Overhead powder-coating conveyor line at Wanlian Fluid', caption: 'Powder-coating line — from spray booth to curing' },
  { file: 'assembly.webp', alt: 'Assembly and finishing bay with fire hose reel cabinets at Wanlian Fluid', caption: 'Assembly and finishing bay' },
  { file: 'fire-hose.webp', alt: 'Finished fire hose reels and coiled fire hose staged for export at Wanlian Fluid', caption: 'Fire hose and reel production' },
  { file: 'qc-test-bench.webp', alt: 'Wanlian Fluid valve shell pressure and air-leakage test bench', caption: 'Shell pressure and air-leakage test bench' }
].filter((p) => hasFactoryAsset(p.file));

const verifiableItems = [
  'ISO 9001 quality-management system certificate, with the scope and issuing body',
  'Batch-level shell pressure and air-leakage test reports for the units on your PO',
  'Third-party inspection (SGS / BV style) arranged at pre-shipment, at your instruction',
  'A live video walk-through of the line and the test bench during your production run',
  'OEM/ODM branding, export packaging and the full export documentation set'
];

const hasBusinessLicense = hasFactoryAsset('business-license.webp');
const hasProductionVideo = hasFactoryAsset('production-line.mp4');
const hasFactoryEvidence = plantPhotos.length > 0 || hasBusinessLicense || hasProductionVideo;
const heroPhoto = hasFactoryAsset('plant-exterior.webp') ? '/assets/factory/plant-exterior.webp' : '/og-image.jpg';

const productionSteps = [
  { step: '01', name: 'Incoming Material Inspection', desc: 'Incoming inspection of ductile iron, castings, sealing materials and coatings against the order specification.' },
  { step: '02', name: 'CNC Machining', desc: 'Precision machining of valve bodies, discs and trim to the required dimensional tolerances.' },
  { step: '03', name: 'Assembly', desc: 'Assembly of internals, sealing elements and operating mechanisms under controlled workshop conditions.' },
  { step: '04', name: 'Pressure & Leakage Testing', desc: '100% shell pressure and seat air-leakage testing on every unit before finishing.' },
  { step: '05', name: 'Epoxy Coating', desc: 'Non-toxic epoxy resin coating applied for corrosion resistance and long service life.' },
  { step: '06', name: 'Export Packing', desc: 'Export-grade packing, marking and documentation prepared for international shipment.' }
];

const values = [
  { title: 'Innovation', desc: 'Continuous design optimization and research breakthroughs to create smarter and more efficient firefighting and fluid systems.' },
  { title: 'Quality', desc: 'Given the critical nature of firefighting and industrial pipelines, we strictly inspect every single valve to exceed international standards.' },
  { title: 'Responsibility', desc: 'As a socially responsible enterprise, we strive to improve public safety, and ensure fluid security across global networks.' },
  { title: 'Environment', desc: 'Incorporating green manufacturing standards and sustainable concepts into our production flow to promote ecological safety.' }
];
---

<Layout
  title="About Us | Quanzhou Wanlian Fluid Equipment"
  description="Quanzhou Wanlian Fluid Equipment Co., Ltd. manufactures and exports valves, fire-fighting and fluid-control equipment from its own production lines in Quanzhou, Fujian, with selected items produced by qualified manufacturing partners, for global B2B projects."
>
  <!-- Banner Header -->
  <section class="relative bg-gray-900 text-white overflow-hidden py-20">
    <div class="absolute inset-0 bg-cover bg-center opacity-20" style="background-image: url('/og-image.jpg');"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-500 uppercase">Who We Are</span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight">About Quanzhou Wanlian</h1>
      <p class="text-base sm:text-lg text-gray-400 max-w-2xl mx-auto">
        A manufacturer and exporter of valves and fire-protection equipment, with our own production lines in the heart of China's plumbing and valve industry.
      </p>
    </div>
  </section>

  <!-- Factory Profile -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-6">
          <div class="border-l-4 border-blue-600 pl-4">
            <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Company Profile</span>
            <h2 class="text-3xl font-black text-gray-900 tracking-tight mt-1">Deep Rooted in the Heart of Valve Industry Hub</h2>
          </div>
           <p class="text-base text-gray-600 leading-relaxed">
             Quanzhou Wanlian Fluid Equipment Co., Ltd. is located in Quanzhou, Fujian — the starting point of the Maritime Silk Road and the core cluster of China's plumbing and valve industry. We manufacture and export valves, fire-fighting equipment, fluid-control equipment and integrated solutions for industrial, municipal, fire-protection, water supply and drainage sectors, and our engineers support product selection and customization on every order.
           </p>
           <p class="text-base text-gray-600 leading-relaxed">
              Our own production lines in Quanzhou, Fujian combine a senior engineering team with in-house CNC machining, assembly and pressure testing — supported by qualified manufacturing partners for selected items. Valve bodies are CNC-machined in-house, every unit is shell pressure-tested and air-leakage tested before shipment, and production runs under an ISO 9001 quality management system together with the relevant national industrial standards, ensuring the stability, reliability and durability of each product.
           </p>
           <p class="text-base text-gray-600 leading-relaxed">
             Our catalogue is built around the specifications design engineers actually work from — pressure class, connection standard, body and trim material, and application — with inquiry-based quotations and technical support for water supply, industrial fluid control, and firefighting projects.
           </p>
           <div class="grid grid-cols-2 gap-6 pt-4 border-t border-gray-100">
             <div>
               <span class="block text-2xl font-black text-blue-600">Valves</span>
               <span class="block text-xs text-gray-400 font-bold tracking-wider uppercase mt-1">Fluid Control Systems</span>
             </div>
             <div>
               <span class="block text-2xl font-black text-blue-600">Fire Protection</span>
                <span class="block text-xs text-gray-400 font-bold tracking-wider uppercase mt-1">In-House Production Lines</span>
             </div>
           </div>
        </div>

        <div class="relative rounded-2xl overflow-hidden aspect-video shadow-lg border border-gray-100 bg-gray-50">
          <img 
            src={heroPhoto}
            alt="Wanlian Fluid manufacturing plant and valve production, Quanzhou, Fujian"
            loading="lazy"
            class="object-cover w-full h-full"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Manufacturing Evidence: plant photos, business license, production video -->
  {hasFactoryEvidence && (
  <section class="py-24 bg-gray-50 border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Factory Evidence</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Inside Our Production Lines in Quanzhou</h2>
        <p class="text-base text-gray-500">Documents and footage for your due diligence — the same records our own buyers verify. Ask us for the full certificate and test-report package matched to your PO.</p>
      </div>

      {plantPhotos.length > 0 && (
      <div class="columns-1 sm:columns-2 gap-6 mb-16">
        {plantPhotos.map((photo) => (
          <figure class="mb-6 break-inside-avoid bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-sm">
            <img src={`/assets/factory/${photo.file}`} alt={photo.alt} loading="lazy" class="w-full h-auto" />
            <figcaption class="px-5 py-4 text-sm font-semibold text-gray-700">{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
      )}

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
        {hasProductionVideo && (
        <div class="lg:col-span-1 bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
          <video
            class="w-full aspect-[9/16] bg-gray-900 object-cover"
            controls
            playsinline
            preload="metadata"
            poster={hasFactoryAsset('production-line-poster.webp') ? '/assets/factory/production-line-poster.webp' : undefined}
          >
            <source src="/assets/factory/production-line.mp4" type="video/mp4" />
            Your browser does not support embedded video.
          </video>
          <div class="px-6 py-5">
            <h3 class="font-bold text-lg text-gray-900">On the Production Floor</h3>
            <p class="mt-2 text-sm text-gray-500 leading-relaxed">Twenty-five seconds of unedited footage from our own production lines — sheet-metal bending, welding, the powder-coating line and fire-hose jacket weaving. No stock video.</p>
          </div>
        </div>
        )}

        <div class={hasProductionVideo ? 'lg:col-span-2 space-y-8' : 'lg:col-span-3 space-y-8'}>
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 sm:p-8">
            <h3 class="font-bold text-lg text-gray-900">What you can verify with us</h3>
            <p class="mt-2 text-sm text-gray-500 leading-relaxed">Verification is a normal part of doing business with a Chinese supplier. Here is what we will put in your hands before you commit — ask for all of it.</p>
            <ul class="mt-6 space-y-3">
              {verifiableItems.map((item) => (
                <li class="flex items-start gap-3 text-sm text-gray-600 leading-relaxed">
                  <span class="mt-1.5 w-1.5 h-1.5 bg-brand-red rounded-full flex-shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          {hasBusinessLicense && (
          <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
            <img src="/assets/factory/business-license.webp" alt="Quanzhou Wanlian Fluid Equipment Co., Ltd. business license, business scope covering manufacturing" loading="lazy" class="w-full object-contain bg-gray-50 max-h-[420px]" />
            <div class="px-6 py-5">
              <h3 class="font-bold text-lg text-gray-900">Business License</h3>
              <p class="mt-2 text-sm text-gray-500 leading-relaxed">Registered in Quanzhou, Fujian. The business scope covers manufacturing, processing and export of valves and fire-protection equipment — the entity that invoices your order is the entity that makes the product.</p>
            </div>
          </div>
          )}
        </div>
      </div>

      <p class="mt-10 text-center text-sm text-gray-500">
        Want a live video walk-through of the line and the test bench for your project? <a href="/contact/" class="text-brand-blue font-semibold hover:underline">Request a factory tour</a>.
      </p>
    </div>
  </section>
  )}

  <!-- Products & Services -->
  <section class="py-24 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Products & Services</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Complete Product Range & Diversified Services</h2>
        <p class="text-base text-gray-500">Realizing fluid transmission, regulation, shut-off and safety-protection functions across industries.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-gray-50 p-8 rounded-xl border border-gray-100">
          <h3 class="font-bold text-lg text-gray-900 mb-4">Main Products</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            {['Gate Valves', 'Butterfly Valves', 'Ball Valves', 'Balancing Valves', 'Globe Valves', 'Check Valves', 'Filters', 'Hydraulic Control Valves', 'Pipeline Accessories', 'Actuators'].map(item => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-brand-red rounded-full flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-gray-50 p-8 rounded-xl border border-gray-100">
          <h3 class="font-bold text-lg text-gray-900 mb-4">Fire-Fighting Equipment</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            {['Fire Cabinets', 'Fire Hydrants', 'Fire Extinguishers', 'Fire Hose Reels', 'Fire Hoses', 'Fire Nozzles', 'Fire Hose Couplings', 'Fire Sprinklers'].map(item => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-brand-blue rounded-full flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-gray-50 p-8 rounded-xl border border-gray-100">
          <h3 class="font-bold text-lg text-gray-900 mb-4">Applications & Services</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-6">Widely applied in petrochemical, electric power, metallurgy, municipal water supply &amp; drainage, building fire-protection, sewage treatment, HVAC and other industries.</p>
          <div class="flex flex-wrap gap-2">
            {['OEM', 'ODM', 'Non-Standard Customization'].map(tag => (
              <span class="px-3 py-1.5 bg-white border border-gray-200 text-xs font-black uppercase tracking-wider text-gray-700 rounded-full">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Production Process -->
  <section class="py-24 bg-gray-50 border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Quality Control</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Our Standard Production Process</h2>
          <p class="text-base text-gray-500">Every order follows the same controlled production sequence — from incoming material inspection through to export packing.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {productionSteps.map(step => (
          <div class="bg-white p-8 rounded-xl border border-gray-100 shadow-sm relative overflow-hidden group">
            <span class="absolute right-6 top-6 text-4xl font-black text-gray-100 group-hover:text-blue-50 transition duration-300">
              {step.step}
            </span>
            <div class="space-y-4">
              <h3 class="font-bold text-lg text-gray-900 pr-12">{step.name}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Core Beliefs</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Four Core Corporate Pillars</h2>
        <p class="text-base text-gray-500">Driving sustainable safety and industrial excellence worldwide.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {values.map(val => (
          <div class="flex gap-6 items-start">
            <div class="bg-blue-500/10 p-4 rounded-xl text-blue-600 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <div class="space-y-2">
              <h3 class="font-bold text-xl text-gray-900">{val.title}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">{val.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Business Philosophy & Vision -->
  <section class="py-24 bg-gray-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-500 uppercase">Our Commitment</span>
        <h2 class="text-3xl font-black tracking-tight">Business Philosophy</h2>
      </div>

      <blockquote class="text-center text-2xl sm:text-3xl font-black tracking-tight text-white mb-16">
        "Quality-oriented, Customer-first, Integrity for Win-win, <span class="text-brand-red">Innovation for Sustainable Development</span>"
      </blockquote>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        {[
          { title: 'Pre-Sales Consultation', desc: 'Professional product selection guidance and customized technical solutions for your project requirements.' },
          { title: 'In-Sales Support', desc: 'Technical guidance for installation and commissioning, with rapid response to customer demands.' },
          { title: 'After-Sales Service', desc: 'After-sales maintenance and practical problem-solving in fluid-system applications.' }
        ].map((item, idx) => (
          <div class="p-8 bg-white/5 border border-white/10 rounded-2xl text-center">
            <span class="block text-4xl font-black text-white/10 mb-4">{String(idx + 1).padStart(2, '0')}</span>
            <h3 class="font-bold text-lg mb-3">{item.title}</h3>
            <p class="text-xs text-gray-400 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center max-w-3xl mx-auto space-y-6">
        <p class="text-lg text-gray-300 leading-relaxed">
          Rooted in Quanzhou, covering nationwide markets and embracing global opportunities, we keep focusing on the fluid-equipment field — promoting product upgrading through technological innovation and building solid brand reputation with high-quality services.
        </p>
        <p class="text-gray-400 leading-relaxed">
          We aim to become a trusted manufacturer and export partner in domestic and international fluid-control sectors, delivering more efficient, safer and smarter fluid-system solutions for customers from all walks of life, and contributing to industrial development and infrastructure construction.
        </p>
        <a href="/contact/" class="inline-flex items-center gap-2 px-8 py-4 bg-brand-red hover:opacity-90 text-white font-bold rounded-lg transition">
          Start a Conversation <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
