---
import Layout from '../layouts/Layout.astro';

const productionSteps = [
  { step: '01', name: 'Raw Material Procurement', desc: 'Strictly selecting high-quality certified ductile iron, brass, and stainless steel raw materials.' },
  { step: '02', name: 'High-Precision Machining', desc: 'Multiple automated CNC machining processes to guarantee precise product tolerances.' },
  { step: '03', name: 'Manual Assembly', desc: 'Experienced technicians perform delicate manual assembly to guarantee solid jointing.' },
  { step: '04', name: 'Multi-Stage Testing', desc: 'Every single valve undergoes rigorous water pressure and gas-leakage tests prior to leaving the line.' },
  { step: '05', name: 'Surface Protection', desc: 'Inner and outer electro-static non-toxic epoxy resin powder coating to prevent corrosion.' },
  { step: '06', name: 'Packaging & Logistics', desc: 'Professional export-grade packaging with transparent tracking to ensure safe and timely global delivery.' }
];

const values = [
  { title: 'Innovation', desc: 'Continuous design optimization and research breakthroughs to create smarter and more efficient firefighting and fluid systems.' },
  { title: 'Quality', desc: 'Given the critical nature of firefighting and industrial pipelines, we strictly inspect every single valve to exceed international standards.' },
  { title: 'Responsibility', desc: 'As a socially responsible manufacturer, we strive to improve public safety, and ensure fluid security across global networks.' },
  { title: 'Environment', desc: 'Incorporating green manufacturing standards and sustainable concepts into our production flow to promote ecological safety.' }
];
---

<Layout title="About Us | Quanzhou Wanlian Fluid Equipment | Leading Manufacturer">
  <!-- Banner Header -->
  <section class="relative bg-gray-900 text-white overflow-hidden py-20">
    <div class="absolute inset-0 bg-cover bg-center opacity-20" style="background-image: url('https://images.unsplash.com/photo-1581092162384-8987c1794ed9?auto=format&fit=crop&q=80&w=1600');"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-500 uppercase">Who We Are</span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight">About Quanzhou Wanlian</h1>
      <p class="text-base sm:text-lg text-gray-400 max-w-2xl mx-auto">
        A professional fluid equipment manufacturer deep in China's industrial valve hub.
      </p>
    </div>
  </section>

  <!-- Factory Profile -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-6">
          <div class="border-l-4 border-blue-600 pl-4">
            <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Manufacturer Profile</span>
            <h2 class="text-3xl font-black text-gray-900 tracking-tight mt-1">Deep Rooted in the Heart of Valve Industry Hub</h2>
          </div>
          <p class="text-base text-gray-600 leading-relaxed">
            Located in Quanzhou, Fujian—the maritime silk road starting point and China's primary water heating and valves industry cluster—Quanzhou Wanlian Fluid Equipment Co., Ltd. is a comprehensive industrial manufacturer.
          </p>
          <p class="text-base text-gray-600 leading-relaxed">
            We are dedicated to designing, testing and producing high-performance fluid systems. Backed by local mature industrial chains and technical expert teams, we ensure that every single product meets the highest standards of stability, reliability and longevity.
          </p>
          <div class="grid grid-cols-2 gap-6 pt-4 border-t border-gray-100">
            <div>
              <span class="block text-2xl font-black text-blue-600">51 - 100</span>
              <span class="block text-xs text-gray-400 font-bold tracking-wider uppercase mt-1">Skilled Personnel</span>
            </div>
            <div>
              <span class="block text-2xl font-black text-blue-600">2,000+ ㎡</span>
              <span class="block text-xs text-gray-400 font-bold tracking-wider uppercase mt-1">Production Workshop</span>
            </div>
          </div>
        </div>

        <div class="relative rounded-2xl overflow-hidden aspect-video shadow-lg border border-gray-100 bg-gray-50">
          <img 
            src="https://images.unsplash.com/photo-1518152006812-edab29b069ac?auto=format&fit=crop&q=80&w=1200" 
            alt="Quanzhou Wanlian Factory Floor"
            class="object-cover w-full h-full"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Production Process -->
  <section class="py-24 bg-gray-50 border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Quality Control</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Our Standard Production Process</h2>
        <p class="text-base text-gray-500">Every single valve undergoes six strict stages of quality assurance before shipment.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {productionSteps.map(step => (
          <div class="bg-white p-8 rounded-xl border border-gray-100 shadow-sm relative overflow-hidden group">
            <span class="absolute right-6 top-6 text-4xl font-black text-gray-100 group-hover:text-blue-50 transition duration-300">
              {step.step}
            </span>
            <div class="space-y-4">
              <h3 class="font-bold text-lg text-gray-900 pr-12">{step.name}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Core Beliefs</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Four Core Corporate Pillars</h2>
        <p class="text-base text-gray-500">Driving sustainable safety and industrial excellence worldwide.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {values.map(val => (
          <div class="flex gap-6 items-start">
            <div class="bg-blue-500/10 p-4 rounded-xl text-blue-600 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <div class="space-y-2">
              <h3 class="font-bold text-xl text-gray-900">{val.title}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">{val.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
