---
import Layout from '../layouts/Layout.astro';

const productionSteps = [
  { step: '01', name: 'Raw Material Procurement', desc: 'Strictly selecting high-quality certified ductile iron, brass, and stainless steel raw materials.' },
  { step: '02', name: 'High-Precision Machining', desc: 'Multiple automated CNC machining processes to guarantee precise product tolerances.' },
  { step: '03', name: 'Manual Assembly', desc: 'Experienced technicians perform delicate manual assembly to guarantee solid jointing.' },
  { step: '04', name: 'Multi-Stage Testing', desc: 'Every single valve undergoes rigorous water pressure and gas-leakage tests prior to leaving the line.' },
  { step: '05', name: 'Surface Protection', desc: 'Inner and outer electro-static non-toxic epoxy resin powder coating to prevent corrosion.' },
  { step: '06', name: 'Packaging & Logistics', desc: 'Professional export-grade packaging with transparent tracking to ensure safe and timely global delivery.' }
];

const values = [
  { title: 'Innovation', desc: 'Continuous design optimization and research breakthroughs to create smarter and more efficient firefighting and fluid systems.' },
  { title: 'Quality', desc: 'Given the critical nature of firefighting and industrial pipelines, we strictly inspect every single valve to exceed international standards.' },
  { title: 'Responsibility', desc: 'As a socially responsible manufacturer, we strive to improve public safety, and ensure fluid security across global networks.' },
  { title: 'Environment', desc: 'Incorporating green manufacturing standards and sustainable concepts into our production flow to promote ecological safety.' }
];
---

<Layout
  title="About Us | Quanzhou Wanlian Fluid Equipment | Leading Manufacturer"
  description="Quanzhou Wanlian Fluid Equipment Co., Ltd. - professional fluid-equipment enterprise integrating R&D, sales and service, providing high-quality valves, fire-fighting equipment, fluid-control equipment and integrated solutions for industrial, municipal, fire-protection, water supply and drainage sectors."
>
  <!-- Banner Header -->
  <section class="relative bg-gray-900 text-white overflow-hidden py-20">
    <div class="absolute inset-0 bg-cover bg-center opacity-20" style="background-image: url('https://images.unsplash.com/photo-1581092162384-8987c1794ed9?auto=format&fit=crop&q=80&w=1600');"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-500 uppercase">Who We Are</span>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight">About Quanzhou Wanlian</h1>
      <p class="text-base sm:text-lg text-gray-400 max-w-2xl mx-auto">
        A professional fluid equipment manufacturer deep in China's industrial valve hub.
      </p>
    </div>
  </section>

  <!-- Factory Profile -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-6">
          <div class="border-l-4 border-blue-600 pl-4">
            <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Manufacturer Profile</span>
            <h2 class="text-3xl font-black text-gray-900 tracking-tight mt-1">Deep Rooted in the Heart of Valve Industry Hub</h2>
          </div>
          <p class="text-base text-gray-600 leading-relaxed">
            Quanzhou Wanlian Fluid Equipment Co., Ltd. is located in Quanzhou, Fujian — the starting point of the Maritime Silk Road and the core cluster of China's plumbing and valve industry. As a professional fluid-equipment enterprise integrating R&D, sales and service, we focus on providing high-quality valves, supporting fire-fighting equipment, fluid-control equipment and integrated solutions for industrial, municipal, fire-protection, water supply and drainage sectors.
          </p>
          <p class="text-base text-gray-600 leading-relaxed">
            With years of profound experience in the fluid equipment industry, we benefit from Quanzhou's mature industrial supporting facilities and technical accumulation. Our R&D and technical team consists of senior industry engineers who continuously devote efforts to product innovation and process optimization. Our cooperative manufacturing bases strictly control production procedures in accordance with the ISO9001 Quality Management System and relevant national industrial standards, ensuring the stability, reliability and durability of each product.
          </p>
          <div class="grid grid-cols-2 gap-6 pt-4 border-t border-gray-100">
            <div>
              <span class="block text-2xl font-black text-blue-600">51 - 100</span>
              <span class="block text-xs text-gray-400 font-bold tracking-wider uppercase mt-1">Skilled Personnel</span>
            </div>
            <div>
              <span class="block text-2xl font-black text-blue-600">2,000+ ㎡</span>
              <span class="block text-xs text-gray-400 font-bold tracking-wider uppercase mt-1">Production Workshop</span>
            </div>
          </div>
        </div>

        <div class="relative rounded-2xl overflow-hidden aspect-video shadow-lg border border-gray-100 bg-gray-50">
          <img 
            src="https://images.unsplash.com/photo-1518152006812-edab29b069ac?auto=format&fit=crop&q=80&w=1200" 
            alt="Quanzhou Wanlian Factory Floor"
            class="object-cover w-full h-full"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Products & Services -->
  <section class="py-24 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Products & Services</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Complete Product Range & Diversified Services</h2>
        <p class="text-base text-gray-500">Realizing fluid transmission, regulation, shut-off and safety-protection functions across industries.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-gray-50 p-8 rounded-xl border border-gray-100">
          <h3 class="font-bold text-lg text-gray-900 mb-4">Main Products</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            {['Gate Valves', 'Butterfly Valves', 'Ball Valves', 'Balancing Valves', 'Globe Valves', 'Check Valves', 'Filters', 'Hydraulic Control Valves', 'Pipeline Accessories', 'Actuators'].map(item => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-brand-red rounded-full flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-gray-50 p-8 rounded-xl border border-gray-100">
          <h3 class="font-bold text-lg text-gray-900 mb-4">Fire-Fighting Equipment</h3>
          <ul class="space-y-2 text-sm text-gray-600">
            {['Fire Cabinets', 'Fire Hydrants', 'Fire Extinguishers', 'Fire Hose Reels', 'Fire Hoses', 'Fire Nozzles', 'Fire Hose Couplings', 'Fire Sprinklers'].map(item => (
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-brand-blue rounded-full flex-shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-gray-50 p-8 rounded-xl border border-gray-100">
          <h3 class="font-bold text-lg text-gray-900 mb-4">Applications & Services</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-6">Widely applied in petrochemical, electric power, metallurgy, municipal water supply &amp; drainage, building fire-protection, sewage treatment, HVAC and other industries.</p>
          <div class="flex flex-wrap gap-2">
            {['OEM', 'ODM', 'Non-Standard Customization'].map(tag => (
              <span class="px-3 py-1.5 bg-white border border-gray-200 text-xs font-black uppercase tracking-wider text-gray-700 rounded-full">{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Production Process -->
  <section class="py-24 bg-gray-50 border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Quality Control</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Our Standard Production Process</h2>
        <p class="text-base text-gray-500">Every single valve undergoes six strict stages of quality assurance before shipment.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {productionSteps.map(step => (
          <div class="bg-white p-8 rounded-xl border border-gray-100 shadow-sm relative overflow-hidden group">
            <span class="absolute right-6 top-6 text-4xl font-black text-gray-100 group-hover:text-blue-50 transition duration-300">
              {step.step}
            </span>
            <div class="space-y-4">
              <h3 class="font-bold text-lg text-gray-900 pr-12">{step.name}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Core Beliefs</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Four Core Corporate Pillars</h2>
        <p class="text-base text-gray-500">Driving sustainable safety and industrial excellence worldwide.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {values.map(val => (
          <div class="flex gap-6 items-start">
            <div class="bg-blue-500/10 p-4 rounded-xl text-blue-600 flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <div class="space-y-2">
              <h3 class="font-bold text-xl text-gray-900">{val.title}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">{val.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Business Philosophy & Vision -->
  <section class="py-24 bg-gray-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-500 uppercase">Our Commitment</span>
        <h2 class="text-3xl font-black tracking-tight">Business Philosophy</h2>
      </div>

      <blockquote class="text-center text-2xl sm:text-3xl font-black tracking-tight text-white mb-16">
        "Quality-oriented, Customer-first, Integrity for Win-win, <span class="text-brand-red">Innovation for Sustainable Development</span>"
      </blockquote>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        {[
          { title: 'Pre-Sales Consultation', desc: 'Professional product selection guidance and customized technical solutions for your project requirements.' },
          { title: 'In-Sales Support', desc: 'Technical guidance for installation and commissioning, with rapid response to customer demands.' },
          { title: 'After-Sales Service', desc: 'After-sales maintenance and practical problem-solving in fluid-system applications.' }
        ].map((item, idx) => (
          <div class="p-8 bg-white/5 border border-white/10 rounded-2xl text-center">
            <span class="block text-4xl font-black text-white/10 mb-4">{String(idx + 1).padStart(2, '0')}</span>
            <h3 class="font-bold text-lg mb-3">{item.title}</h3>
            <p class="text-xs text-gray-400 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="text-center max-w-3xl mx-auto space-y-6">
        <p class="text-lg text-gray-300 leading-relaxed">
          Rooted in Quanzhou, covering nationwide markets and embracing global opportunities, we keep focusing on the fluid-equipment field — promoting product upgrading through technological innovation and building solid brand reputation with high-quality services.
        </p>
        <p class="text-gray-400 leading-relaxed">
          We aim to become a trusted professional supplier in domestic and international fluid-control sectors, delivering more efficient, safer and smarter fluid-system solutions for customers from all walks of life, and contributing to industrial development and infrastructure construction.
        </p>
        <a href="/contact/" class="inline-flex items-center gap-2 px-8 py-4 bg-brand-red hover:opacity-90 text-white font-bold rounded-lg transition">
          Start a Conversation <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
