---
import Layout from '../../../layouts/Layout.astro';
const faq = [{ question: 'Araç neden bir endeks gösteriyor?', answer: 'Wanlian Fluid teklif üzerine çalışır. Göreli endeks, miktar, Incoterm ve varış noktasını karşılaştırmaya yardımcı olur; fiyat listesi değildir.' }, { question: 'Endeks nihai teklif midir?', answer: 'Hayır. Gerçek fiyat model, ölçü, malzeme, standart, miktar ve varış noktasına bağlıdır ve ayrıntılı teklifle doğrulanır.' }];
---
<Layout title="Maliyet Hesaplayıcı: Yangın Vanaları ve Hidrantlar" description="Miktar, Incoterm ve varış noktasına göre göreli maliyet endeksi tahmin etmek için etkileşimli araç." type="website" locale="tr" faq={faq} breadcrumbs={[{ name: 'Kaynaklar' }, { name: 'Maliyet hesaplayıcı' }]}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/tr/">Ana sayfa</a><span>/</span><span class="text-gray-600">Maliyet hesaplayıcı</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Etkileşimli araç</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Yangın vanaları ve hidrantlar için maliyet hesaplayıcı</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Miktar, Incoterm ve varış noktasını ayarlayarak <strong>teslim edilmiş göreli maliyet endeksini</strong> tahmin edin. Baz 100 = bir yangın hidrantı, EXW, Doğu Asya varış noktası.</p><div class="bg-amber-50 border border-amber-200 rounded-xl p-4 my-6"><p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-red">Önemli:</strong> Endeks planlama içindir. Nihai teklif tam model, ölçü, malzeme, standart ve miktara bağlıdır.</p></div><div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 sm:p-8 my-6"><h2 class="text-lg font-black text-gray-900 mb-4">1 · Partiyi yapılandırın</h2><div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="line-items"><label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3"><span class="text-sm font-semibold text-gray-800">Yangın hidrantları (SS100)</span><input type="number" min="0" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="100"/></label><label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3"><span class="text-sm font-semibold text-gray-800">Sürgülü vanalar (Z41X)</span><input type="number" min="0" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="70"/></label><label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3"><span class="text-sm font-semibold text-gray-800">Kelebek vanalar</span><input type="number" min="0" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="55"/></label><label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3"><span class="text-sm font-semibold text-gray-800">Çekvalfler</span><input type="number" min="0" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="45"/></label></div><div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6"><label class="text-sm font-semibold text-gray-800">Incoterm<select id="incoterm" class="mt-2 w-full border border-gray-200 rounded-lg px-3 py-2 font-normal"><option value="1">EXW</option><option value="1.08">FOB (+8%)</option><option value="1.18">CIF (+18%)</option><option value="1.3">DDP (+30%)</option></select></label><label class="text-sm font-semibold text-gray-800">Varış bölgesi<select id="region" class="mt-2 w-full border border-gray-200 rounded-lg px-3 py-2 font-normal"><option value="1">Doğu Asya</option><option value="1.12">Avrupa</option><option value="1.18">Türkiye</option><option value="1.28">Amerika</option></select></label></div><button id="estimate" class="mt-6 px-8 py-4 bg-brand-red text-white font-bold rounded-lg">Endeksi hesaplayın</button></div><div id="result" class="hidden bg-blue-50 border border-blue-100 rounded-2xl p-6"><p class="text-sm text-gray-600">Tahmini göreli maliyet endeksi</p><p id="index-value" class="text-4xl font-black text-brand-blue mt-2">0</p><p class="text-sm text-gray-600 mt-3"><span id="units-label">0</span> birim · <span id="incoterm-label"></span> · <span id="region-label"></span></p><p id="drivers" class="text-sm text-gray-600 mt-3"></p></div><div class="mt-10 text-center"><a href="/tr/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-lg">Gerçek teklif isteyin</a></div></article></main>
</Layout>
<script>function estimate(){const inputs=[...document.querySelectorAll('.qty')];let base=0,units=0;for(const i of inputs){const q=Math.max(0,parseInt(i.value||'0',10));base+=q*parseFloat(i.dataset.index||'0');units+=q}const result=document.getElementById('result');result.classList.remove('hidden');const inc=document.getElementById('incoterm');const reg=document.getElementById('region');const mult=units<10?1:units<100?.9:units<1000?.82:.75;document.getElementById('index-value').textContent=String(Math.round(base*mult*parseFloat(inc.value)*parseFloat(reg.value)));document.getElementById('units-label').textContent=String(units);document.getElementById('incoterm-label').textContent=inc.options[inc.selectedIndex].text.split(' (')[0];document.getElementById('region-label').textContent=reg.options[reg.selectedIndex].text;document.getElementById('drivers').textContent=units?'Planlama için göreli endeks; gerçek fiyatı almak için şartnameyi gönderin.':'Endeksi hesaplamak için en az bir ürün ekleyin.'}document.getElementById('estimate').addEventListener('click',estimate)</script>
