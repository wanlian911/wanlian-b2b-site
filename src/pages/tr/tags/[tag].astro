---
import Layout from '../../../layouts/Layout.astro';
import { tags, type Tag } from '../../../utils/tags';
import { tagsTr } from '../../../utils/tags.tr';
import { guidesTr } from '../../../utils/guides.tr';
import { productsTr } from '../../../utils/products.tr';
export function getStaticPaths() { return tags.map(tag => ({ params: { tag: tag.slug }, props: { tag } })); }
const { tag } = Astro.props as { tag: Tag };
const tagTr = tagsTr[tag.slug] ?? { name: tag.name, seoTitle: tag.seoTitle, description: tag.description };
const tagGuides = guidesTr.filter(g => tag.guideHrefs.some(h => g.href === `/tr${h}` || g.href === h));
const tagProducts = productsTr.filter(p => tag.productSlugs.includes(p.slug));
const relatedTags = tags.filter(t => tag.relatedTags.includes(t.slug));
---
<Layout title={tagTr.seoTitle} description={tagTr.description} type="website" locale="tr" breadcrumbs={[{ name: 'Etiketler', href: '/tr/tags/' }, { name: tagTr.name }]}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-8 flex gap-2"><a href="/tr/">Ana sayfa</a><span>/</span><a href="/tr/tags/">Etiketler</a><span>/</span><span class="text-gray-600">{tagTr.name}</span></nav><div class="max-w-3xl mb-14 space-y-4"><span class="text-xs font-bold tracking-widest text-brand-red uppercase">Konu</span><h1 class="text-4xl font-black text-gray-900 tracking-tight">{tagTr.name}</h1><p class="text-lg text-gray-500 leading-relaxed">{tagTr.description}</p></div><div class="flex flex-wrap gap-2 mb-14"><span class="text-xs font-bold text-gray-400 uppercase tracking-wider self-center mr-1">İlgili:</span>{relatedTags.map(rel => <a href={`/tr/tags/${rel.slug}/`} class="px-3 py-1.5 bg-gray-100 text-gray-600 text-xs font-bold rounded-full">{tagsTr[rel.slug]?.name ?? rel.name}</a>)}</div>
    {tagGuides.length > 0 && <section class="mb-16"><h2 class="text-2xl font-black text-gray-900 mb-8">Kılavuzlar ve makaleler</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-6">{tagGuides.map(guide => <a href={guide.href} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition p-8"><span class="text-xs text-gray-400">{guide.date} · {guide.readTime}</span><h3 class="text-lg font-black text-gray-900 group-hover:text-brand-blue transition leading-snug my-3">{guide.title}</h3><p class="text-sm text-gray-500 leading-relaxed">{guide.description}</p><span class="mt-6 inline-flex text-brand-red font-bold text-sm">Kılavuzu okuyun →</span></a>)}</div></section>}
    {tagProducts.length > 0 && <section class="mb-16"><h2 class="text-2xl font-black text-gray-900 mb-8">İlgili ürünler</h2><div class="grid grid-cols-2 lg:grid-cols-4 gap-6">{tagProducts.map(product => <a href={`/tr/products/${product.slug}/`} class="group bg-white rounded-2xl border border-gray-100 shadow-sm p-6"><img src={product.image} alt={product.name} loading="lazy" class="w-full h-36 object-contain rounded-lg bg-gray-50 p-2 mb-4"/><span class="text-[10px] font-bold text-brand-blue uppercase tracking-wider">{product.category}</span><h3 class="text-sm font-bold text-gray-900 group-hover:text-brand-red transition leading-snug mt-2">{product.name}</h3></a>)}</div></section>}
    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4"><h2 class="text-2xl font-black">Bu konuda yardıma mı ihtiyacınız var?</h2><p class="text-gray-400 max-w-xl mx-auto">Mühendislerimiz projeniz için ürün seçimine yardımcı olur.</p><a href="/tr/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-xl">Mühendisle görüşün</a></div>
  </main>
</Layout>
