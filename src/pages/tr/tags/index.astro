---
import Layout from '../../../layouts/Layout.astro';
import { tags } from '../../../utils/tags';
import { tagsTr } from '../../../utils/tags.tr';
const plural = (n: number, one: string, many: string) => n === 1 ? one : many;
const tagStats = tags.map(tag => ({ ...tag, tr: tagsTr[tag.slug] ?? { name: tag.name, description: tag.description, seoTitle: tag.seoTitle }, guideCount: tag.guideHrefs.length, productCount: tag.productSlugs.length }));
---
<Layout title="Bilgi Merkezi: Yangın Koruması ve Vanalar" description="Yangın hidrantları, sprinkler sistemleri, yangın monitörleri, geri akış önleme ve B2B satın alma konularını keşfedin." locale="tr" breadcrumbs={[{ name: 'Etiketler' }]}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20"><div class="text-center mb-16 space-y-4"><span class="text-xs font-bold tracking-widest text-brand-red uppercase">Bilgi merkezi</span><h1 class="text-4xl font-black text-gray-900 tracking-tight">Konuya göre keşfedin</h1><p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">Hidrantlardan sprinkler sistemlerine, geri akış önlemeden B2B satın almaya kadar teknik kılavuzlar ve ürünler.</p></div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">{tagStats.map(tag => <a href={`/tr/tags/${tag.slug}/`} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition p-8 flex flex-col"><div class="flex items-center justify-between mb-4"><span class="px-2.5 py-1 bg-brand-blue/10 text-brand-blue text-[11px] font-black rounded-full uppercase tracking-wider">Konu</span><span class="text-xs text-gray-400">{tag.guideCount} {plural(tag.guideCount, 'kılavuz', 'kılavuz')} · {tag.productCount} {plural(tag.productCount, 'ürün', 'ürün')}</span></div><h2 class="text-xl font-black text-gray-900 group-hover:text-brand-blue transition leading-snug mb-3">{tag.tr.name}</h2><p class="text-sm text-gray-500 leading-relaxed flex-grow">{tag.tr.description}</p><div class="mt-6 flex flex-wrap gap-2">{tag.relatedTags.slice(0, 3).map(rel => <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">#{tagsTr[rel]?.name ?? rel.replace(/-/g, ' ')}</span>)}</div><span class="mt-4 inline-flex items-center text-brand-red font-bold text-sm">Konuyu keşfedin →</span></a>)}</div>
    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4"><h2 class="text-2xl font-black">Bir ürün ailesi mi arıyorsunuz?</h2><p class="text-gray-400 max-w-xl mx-auto">Eksiksiz kataloğu inceleyin veya mühendislerimizle görüşün.</p><div class="flex flex-col sm:flex-row justify-center gap-4"><a href="/tr/products/" class="px-8 py-4 bg-brand-red text-white font-bold rounded-xl">Eksiksiz katalog</a><a href="/tr/contact/" class="px-8 py-4 bg-white/10 border border-white/20 text-white font-bold rounded-xl">Mühendisle görüşün</a></div></div>
  </main>
</Layout>
