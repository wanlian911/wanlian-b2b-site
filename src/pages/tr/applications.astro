---
import Layout from '../../layouts/Layout.astro';
const faq = [{ question: 'Wanlian Fluid ürünleri hangi sektörlere hizmet verir?', answer: 'Belediye su şebekeleri, endüstriyel proses hatları, HVAC, petrokimya, depolama, veri merkezleri ve yangından korunma projelerine hizmet veririz.' }, { question: 'Uygulamam için doğru vanayı nasıl seçerim?', answer: 'Akışkan, ölçü, basınç sınıfı, standart ve işlevi belirleyin. Teknik ekibimiz, şartnamenizi aldıktan sonra 12 saat içinde model önerebilir.' }];
const applications = [
 { title: 'Yangından Korunma ve Güvenlik', icon: '🛡️', description: 'Ticari binalar, endüstriyel tesisler ve belediye şebekeleri için sertifikalı hidrantlar, alarm vanaları, sprinkler, monitörler ve hortum sistemleri.', points: ['İç ve dış yangın hidrantı şebekeleri', 'Otomatik sprinkler ve baskın sistemleri', 'Büyük hacimli alanlar için yangın monitörleri', 'Yangın hortum makaraları ve dolapları'], links: [{ label: 'Yangın Hidrantları', href: '/tr/products/#category=Yangın%20Hidrantları%20ve%20Pompa%20Bağlantıları' }, { label: 'Sprinkler ve Alarm Vanaları', href: '/tr/products/#category=Yangın%20Sprinkleri%20ve%20Alarm%20Vanaları' }, { label: 'Yangın Monitörleri', href: '/tr/products/manual-fire-water-cannon-ps/' }] },
 { title: 'Belediye Su Temini ve Drenaj', icon: '🏙️', description: 'Su dağıtım, kanalizasyon ve pompa istasyonları için uzun hizmet ömrü sunan akış kontrol ve izolasyon çözümleri.', points: ['Dağıtım şebekeleri için sürgülü ve kelebek vanalar', 'Kanalizasyon için küresel çekvalfler', 'Dijital şebekeler için akıllı hidrantlar', 'İçme suyu için geri akış önleme'], links: [{ label: 'Sürgülü Vanalar', href: '/tr/products/resilient-seat-flanged-gate-valve-z41x/' }, { label: 'Çekvalfler', href: '/tr/products/spherical-ball-check-valve-hq44x/' }, { label: 'Geri Akış Önleyiciler', href: '/tr/products/anti-pollution-backflow-preventer-hs41x/' }] },
 { title: 'Endüstriyel Proses Hatları', icon: '🏭', description: 'Petrokimya, enerji, metalurji ve gıda prosesleri için yüksek basınç vanaları ve filtreler.', points: ['Yüksek sıcaklık akışkanları için körüklü vanalar', 'Kritik ekipman koruması için Y tipi pislik tutucular', 'Kararlı işletim için basınç düşürücü vanalar', 'Debi ölçümü için elektromanyetik debimetreler'], links: [{ label: 'Metal Körüklü Sürgülü Vanalar', href: '/tr/products/flange-manual-bellows-gate-valve/' }, { label: 'Y Tipi Pislik Tutucular', href: '/tr/products/telescopic-y-strainer-sgl41h/' }] },
 { title: 'HVAC ve Bina Hizmetleri', icon: '🏢', description: 'Ticari ve konut binalarında ısıtma, havalandırma ve iklimlendirme sistemleri için kompakt, düşük bakım gerektiren vanalar.', points: ['Kompakt montaj için wafer tip kelebek vanalar', 'Genel kullanım için elastomer yataklı sürgülü vanalar', 'Depolar için seviye kontrol vanaları', 'Genleşme telafisi için teleskopik sürgülü vanalar'], links: [{ label: 'Kelebek Vanalar', href: '/tr/products/wafer-type-butterfly-valve-d71x/' }, { label: 'Seviye Kontrol Vanaları', href: '/tr/products/hydraulic-water-level-control-valve-f745x/' }] },
 { title: 'Petrol, Gaz ve Petrokimya', icon: '🛢️', description: 'Rafineriler, tank sahaları ve kimya tesisleri için yüksek performanslı akış kontrolü ve yangın güvenliği.', points: ['Manuel ve otomatik izlemeli yangın monitörleri', 'B sınıfı yangınlar için köpük dolapları', 'Gerektiğinde patlamaya dayanıklı seçenekler', 'Aşındırıcı akışkanlar için korozyon dirençli malzemeler'], links: [{ label: 'Yangın Monitörleri', href: '/tr/products/manual-fire-water-cannon-ps/' }, { label: 'Otomatik İzlemeli Monitörler', href: '/tr/products/auto-tracking-jet-suppression-cannon-zdms/' }] },
 { title: 'Lojistik, Depolama ve Veri Merkezleri', icon: '📦', description: 'Su hasarına duyarlı varlıkların bulunduğu büyük kapalı alanlar için hızlı ve güvenilir yangın güvenliği.', points: ['Hassas ekipmanlar için ön tepkili sistemler', 'Yüksek tavanlı depolar için otomatik monitörler', 'Standart depolar için ıslak alarm sistemleri', 'Bölge izleme için su akış anahtarları'], links: [{ label: 'Ön Tepkili Sistemler', href: '/tr/products/pre-action-alarm-system-zsfy/' }, { label: 'Alarm Vanaları', href: '/tr/products/wet-alarm-check-valve-zsfz-150/' }] }
];
---
<Layout locale="tr" title="Uygulamalar ve Sektörler | Wanlian Fluid" description="Wanlian Fluid endüstriyel vanaları ve yangın güvenliği ekipmanları: belediye suyu, proses hatları, HVAC, petrokimya ve depolama." faq={faq} breadcrumbs={[{ name: 'Uygulamalar' }]}>
<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20"><div class="text-center mb-16 space-y-4"><span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Uygulamalar</span><h1 class="text-4xl sm:text-5xl font-black text-gray-900">Zorlu <span class="text-brand-red">ortamlar için</span> tasarlandı</h1><p class="text-lg text-gray-500 max-w-3xl mx-auto">Wanlian akışkan kontrolü ve yangın güvenliği ürünleri, güvenilirlik ve emniyetin vazgeçilmez olduğu sektörlerde kullanılır.</p></div><div class="grid md:grid-cols-2 gap-8">{applications.map(app => <div class="bg-white p-8 rounded-2xl border shadow-sm"><div class="flex items-center gap-4 mb-4"><span class="text-4xl">{app.icon}</span><h2 class="text-xl font-black text-gray-900">{app.title}</h2></div><p class="text-gray-600 leading-relaxed mb-5">{app.description}</p><ul class="space-y-2 mb-6">{app.points.map(point => <li class="flex items-start text-sm text-gray-700"><span class="text-brand-blue mr-2">✓</span>{point}</li>)}</ul><div class="flex flex-wrap gap-3 border-t pt-4">{app.links.map(link => <a href={link.href} class="text-sm font-bold text-brand-red hover:underline">{link.label} →</a>)}</div></div>)}</div><div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center"><h2 class="text-2xl font-black">Projenize uygun ürünü seçemiyor musunuz?</h2><p class="text-gray-400 max-w-xl mx-auto mt-3">Uygulama ayrıntılarını gönderin; mühendislerimiz 12 saat içinde doğru çözümü önersin.</p><a href="/tr/contact/" class="inline-block mt-6 px-8 py-4 bg-brand-red rounded-xl font-bold">Mühendislik Desteği Alın</a></div></main>
</Layout>
