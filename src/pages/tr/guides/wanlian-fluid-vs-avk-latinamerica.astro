const toc = [
	{ id: 'avk-latinamerica-overview', label: '1. AVK Latinoamérica aslında kimdir?' },
	{ id: 'wanlian-fluid-overview', label: '2. Wanlian Fluid kimdir?' },
	{ id: 'side-by-side', label: '3. Yan yana karşılaştırma' },
