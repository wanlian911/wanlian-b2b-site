---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';
const uri = { EscapeDataString: encodeURIComponent };
const toc = [
	{ id: 'forede-overview', label: '1. Forede aslında nedir?' },
	{ id: 'wanlian-overview', label: '2. Wanlian Fluid aslında nedir?' },
	{ id: 'product-lines-compared', label: '3. Ürün hatları nasıl karşılaştırılır?' },
	{ id: 'monitors-deep-dive', label: '4. Yangın monitörleri: doğrudan karşılaştırma' },
