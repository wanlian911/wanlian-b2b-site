import TableOfContents from '../../../components/sections/TableOfContents.astro';
const uri = { EscapeDataString: encodeURIComponent };
const toc = [
	{ id: 'ca-fire-overview', label: '1. CA-FIRE aslında nedir?' },
	{ id: 'wanlian-fluid-overview', label: '2. Wanlian Fluid aslında nedir?' },
	{ id: 'product-lines-compared', label: '3. Ürün hatları nasıl karşılaştırılır?' },
	{ id: 'quality-and-certifications', label: '4. Kalite sistemleri ve sertifikalar' },
	{ id: 'where-each-wins', label: '5. Hangi üretici nerede öne çıkar?' },
	{ id: 'cost-and-lead-time', label: '6. Maliyet, fiyatlandırma ve teslim süresi' },
	{ id: 'which-should-you-choose', label: '7. Hangisini seçmelisiniz?' },
	{ id: 'faq', label: 'Sıkça Sorulan Sorular' },
	{ id: 'sources', label: 'Kaynaklar' }
];
const faq = [
	{ question: 'Wanlian Fluid ve CA-FIRE aynı veya bağlantılı şirketler midir?', answer: 'Hayır. İkisi de Fujian, Quanzhou’daki yangın ekipmanı kümelenmesinde bulunan bağımsız üreticilerdir. CA-FIRE Protection Industry Co., Ltd. 2012’de kurulmuş olup FM onaylı sprinkler başlıkları, alarm ve baskın vanaları, hidrantlar ve köpük tanklarına odaklanır. Wanlian Fluid ise yangın monitörleri, hidrantlar, alarm vanaları, hidrolik kontrol vanaları ve yangın aksesuarları sunar. Satın aldığınız gerçek fabrikadan belge isteyin; aynı bölgedeki adres tek başına üreticiyi kanıtlamaz.' },
	{ question: 'Wanlian Fluid FM onaylı sprinkler başlıkları üretiyor mu?', answer: 'Hayır. Wanlian Fluid GB/EN şartnamelerine göre cam ampullü, ESFR ve gizli sprinkler başlıkları üretir; ancak FM Approvals listesine sahip değildir. Projeniz Kuzey Amerika’da FM Global veya NFPA 13 kapsamındaysa FM listeli başlıklar için CA-FIRE ya da başka listeli bir üretici daha güvenli tercihtir. Siparişten önce model, liste etiketi ve sertifikayı mutlaka doğrulayın.' },
	{ question: 'İki şirketten hangisi yangın monitörlerinde daha güçlüdür?', answer: 'Wanlian Fluid yangın monitörlerini ana ürün hattı olarak sunar: alev algılama ve kendinden konumlandırma özellikli ZDMS otomatik takipli monitör ile manuel PS serisi. CA-FIRE dokuz ürün hattı arasında monitörlere de yer verir; ancak yayımlanmış ürün gamı ve referansları sprinkler ve alarm vanaları merkezlidir. Monitörün ana ekipman olduğu tank sahası ve açık alanlarda Wanlian daha doğrudan bir seçenektir.' },
	{ question: 'Kuzey Amerika projem FM onaylı sprinklere ihtiyaç duyuyor; Wanlian yine de kullanılabilir mi?', answer: 'Evet, listeli sprinkler başlıkları dışındaki kalemler için. Yaygın yaklaşım, FM listeli başlıkları CA-FIRE veya başka listeli üreticiden; alarm çekvalfleri, sürgülü vanalar, hidrantlar, yangın hortumu, nozullar ve söndürücü dolaplarını ise Wanlian’dan tek ihracat PO’su ile almaktır. Böylece şartname açısından kritik başlıklardan ödün vermeden listelenmemiş kalemlerde maliyet avantajı sağlanabilir.' },
	{ question: 'Wanlian tek sevkiyatta monitör, vana, hidrant, hortum ve dolap sağlayabilir mi?', answer: 'Evet. Bu tam kit yaklaşımı Wanlian’ın temel konumlandırmasıdır. Tek PO; ZDMS otomatik takipli monitörü, ZSFZ-150 ıslak alarm çekvalfini, SS100/65 yer üstü antifrizli hidrantı, 8-65 kauçuk astarlı yassı hortumu, Storz kaplinlerini ve yangın söndürücü kutularını kapsayabilir. Birim basınç testleri ve ihracat belgeleri sevkiyatla koordine edilir.' },
	{ question: 'Toplu siparişten önce iki fabrikanın kalitesi nasıl doğrulanır?', answer: 'Her iki taraftan ISO 9001 sertifikası ve kapsamını, standardınıza göre model bazlı test raporlarını, iddia edilen FM/CCCF etiketlerini, birim basınç ve sızdırmazlık kayıtlarını, SGS/BV/TÜV gibi üçüncü taraf denetim seçeneklerini ve bölgesel referansları isteyin. Ardından hacimli siparişten önce numune siparişi verin.' }
];
const productRows = [
	{ slug: 'auto-tracking-jet-suppression-cannon-zdms', name: 'Otomatik Takipli Jet Söndürme Yangın Monitörü (ZDMS Serisi)', img: '/assets/products/auto-tracking-jet-suppression-cannon-zdms.webp', desc: 'Tank sahaları ve açık alanlar için alev algılayan, kendinden takipli su monitörü' },
	{ slug: 'wet-alarm-check-valve-zsfz-150', name: 'Islak Alarm Çekvalfi ZSFZ 150', img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp', desc: 'Çan ve motorlu alarmlı ıslak borulu sistem kontrol vanası' },
	{ slug: 'overground-fire-hydrant-ss100', name: 'Yer Üstü Antifrizli Yangın Hidrantı (SS100/65)', img: '/assets/products/overground-fire-hydrant-ss100.webp', desc: 'Belediye yangın şebekeleri için kuru namlulu dış hidrant' }
];
---
<Layout title="Wanlian Fluid ve CA-FIRE: Yangın Üreticisi" description="Wanlian Fluid ve CA-FIRE karşılaştırması: FM sprinklerleri, yangın monitörleri, hidrantlar, alarm vanaları ve tam kitler için doğru Çinli üreticiyi seçin." type="article" locale="tr" faq={faq} breadcrumbs={[{ name: 'Kılavuzlar', href: '/tr/blog/' }, { name: 'Wanlian ve CA-FIRE' }]}>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/tr/" class="hover:text-blue-600">Ana sayfa</a><span>/</span><a href="/tr/blog/" class="hover:text-blue-600">Kılavuzlar</a><span>/</span><span class="text-gray-600">Tedarikçi karşılaştırması</span></nav>
		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Tedarikçi karşılaştırma kılavuzu</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Wanlian Fluid ve CA-FIRE: 2026 projeniz için doğru üretici</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Projeniz FM Global veya NFPA 13 kapsamındaysa ve FM listeli sprinkler başlıkları şartnamenin kritik kalemiyse CA-FIRE iki seçenek içinde daha güçlüdür. Kapsamınız yangın suyu monitörleri, tek PO altında tam ekipman kiti, hidrolik kontrol vanaları veya IoT hidrantları üzerine kuruluysa — özellikle Orta Doğu, Afrika, Güneydoğu Asya ya da Latin Amerika’da — Wanlian Fluid daha doğrudan bir iş ortağıdır. İki şirket de Quanzhou’daki aynı kümelenmede gerçek fabrikalardır; bu karşılaştırma, yayımlanmış ürün ve sertifikalara dayanarak güçlü ve sınırlı yönleri ayırır.</p>
			<div class="bg-blue-50 border border-blue-100 rounded-xl p-5 my-6"><p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-blue">Kanıt notu:</strong> Eylül 2026’da 30 gerçek satın alma sorusuyla yapılan yapay zekâ arama izleme çalışmasında NFPA, FM ve UL gibi standart kuruluşları en çok atıf alan kaynaklardı. Üreticiler arasında CA-FIRE iki yanıtta yer alarak en çok atıf alan Çin fabrikası oldu; Wanlian Fluid bir yanıtta yer aldı. Bu nedenle karşılaştırma sloganlara değil, doğrulanabilir özelliklere odaklanır.</p></div>
			<div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">{productRows.map(p => (<a href={`/tr/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition"><img src={p.img} alt={p.name} loading="lazy" class="w-full h-32 object-contain bg-white p-2" /><div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p><p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p></div></a>))}</div>
			<TableOfContents headings={toc} />
			<h2 id="ca-fire-overview" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. CA-FIRE aslında nedir?</h2>
			<p class="text-gray-700 leading-relaxed mb-4">CA-FIRE Protection Industry Co., Ltd. 2012’de Fujian, Quanzhou’da kurulmuş ve kendisini “ticaret şirketi değil”, doğrudan yangından korunma ekipmanı üreticisi olarak konumlandırmıştır. Yayımladığı verilere göre 50.814 m² tesis, 130’dan fazla çalışan, 2025’te 40’tan fazla ihracat pazarında 43 milyon ABD doları satış ve sektörde 13 yıldan fazla deneyim bildirmektedir.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Ürün gamı dokuz hattı kapsar: 18 tip sprinkler başlığı, DN50–DN200 ıslak alarm çekvalfi, DN50–DN350 diyaframlı baskın vanası, BS 750, NF EN 14384, GOST ve GB’ye göre hidrantlar, yangın monitörleri, sürgülü vanalar ve köpük bladder tankları. Markanın stratejik farkı, sprinkler başlıkları için FM 2030 kapsamında <strong>FM Approvals listesi</strong> yayımlamasıdır. Başlık ve alarm çekvalfleri için ANSI/UL 199 UL sertifikasının süreçte olduğu belirtilmektedir.</p>
			<p class="text-gray-700 leading-relaxed">Referans portföyü Beijing Daxing Havalimanı, Guangzhou Baiyun T2, Chengdu Tianfu Havalimanı, Tencent Cloud ve Huawei veri merkezleri, Beijing South Tren İstasyonu ve 100’den fazla büyük Çin projesini içerir. İhracat yaklaşımı Kuzey Amerika, Orta Doğu, Güneydoğu Asya, Avrupa ve Afrika’daki distribütör ve EPC şirketlerine yöneliktir.</p>
			<h2 id="wanlian-fluid-overview" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Wanlian Fluid aslında nedir?</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Quanzhou Wanlian Fluid Equipment Co., Ltd. (Wanlian Fluid), aynı Quanzhou, Fujian kümelenmesinde yer alan üretici ve ihracatçıdır. Kendi hatları, nitelikli üretim ortaklarının kapasitesiyle birlikte ISO 9001 kalite yönetim sistemi altında çalışır; bu “kendi hatları + nitelikli ortak” modelini açıkça belirtir. Her ürün sevk öncesinde %100 gövde basınç ve hava sızıntısı testinden geçirilir.</p>
			<p class="text-gray-700 leading-relaxed">Yayımlanmış ürün gamı altı hat ve 45 modeli kapsar: ana ürün olarak <strong>yangın suyu monitörleri</strong> — alev algılama ve kendinden konumlandırmalı <a href="/tr/products/auto-tracking-jet-suppression-cannon-zdms/" class="text-brand-blue font-semibold hover:underline">ZDMS otomatik takipli jet söndürme monitörü</a> ve manuel PS serisi; yangın hidrantları ve pompa bağlantıları; sprinkler ve alarm vanaları (<a href="/tr/products/wet-alarm-check-valve-zsfz-150/" class="text-brand-blue font-semibold hover:underline">ZSFZ-150 ıslak alarm çekvalfi</a>); endüstriyel vanalar; hidrolik kontrol vanaları ve yangın aksesuarları. Gamda <a href="/tr/products/fire-hose-pvc-rubber-lining-8-65/" class="text-brand-blue font-semibold hover:underline">8-65 kauçuk astarlı yangın hortumu</a>, nozullar, Storz kaplinleri, söndürücü kutuları ve ABC söndürücüler de bulunur. OEM/ODM ve 12 saatlik teklif yanıtı standart hizmettir.</p>
			<h2 id="product-lines-compared" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Ürün hatları nasıl karşılaştırılır?</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5"><table class="min-w-full divide-y divide-gray-200 text-sm"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Boyut</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">CA-FIRE</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Wanlian Fluid</th></tr></thead><tbody class="bg-white divide-y divide-gray-200">
				<tr><td class="px-4 py-3 font-bold text-gray-900">Şirket / merkez</td><td class="px-4 py-3 text-gray-700">2012, Quanzhou, Fujian; 50.814 m² tesis, 130+ çalışan, 2025’te 43 milyon ABD doları (şirket beyanı)</td><td class="px-4 py-3 text-gray-700">Quanzhou, Fujian; kendi hatları + nitelikli ortak kapasitesi, ISO 9001</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Ürün gamı</td><td class="px-4 py-3 text-gray-700">9 hat, sprinkler odaklı: 18 başlık tipi, alarm/baskın vanaları, hidrant, monitör, sürgülü vana, köpük tankı</td><td class="px-4 py-3 text-gray-700">6 hat, 45 model: ana hat monitörler, hidrantlar, sprinkler ve alarm vanaları, vanalar, hidrolik kontrol ve aksesuarlar</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Yangın suyu monitörleri</td><td class="px-4 py-3 text-gray-700">Evet; 9 hattan biri, ancak ana ürün değil</td><td class="px-4 py-3 text-gray-700">Evet; ana hat: alev algılamalı ZDMS otomatik takip + manuel PS serisi</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Sprinkler başlıkları</td><td class="px-4 py-3 text-gray-700">18 tip, FM Approved (FM 2030); UL süreci devam ediyor</td><td class="px-4 py-3 text-gray-700">GB/EN şartnamelerine göre ZST/ESFR/T-ZSTBS/ZSTDY; FM listesi yok</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Alarm / baskın vanaları</td><td class="px-4 py-3 text-gray-700">DN50–DN200 alarm çekvalfi, DN50–DN350 baskın vanası; flanşlı ve yivli</td><td class="px-4 py-3 text-gray-700">ZSFZ-150 ıslak, ZSFC kuru, ZSFM baskın, ZSFY ön tepkili</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Yangın hidrantları</td><td class="px-4 py-3 text-gray-700">BS 750, NF EN 14384, GOST ve GB gibi çoklu standartlar</td><td class="px-4 py-3 text-gray-700">Antifrizli SS100/65, çarpışma korumalı SSFT100/65, yer altı SA, iç saha SN65, IoT hidrant</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Hidrolik kontrol vanaları</td><td class="px-4 py-3 text-gray-700">Yayımlanmış ürün gamında yok</td><td class="px-4 py-3 text-gray-700">Var: 500X basınç düşürücü, 100X uzaktan şamandıra, F745X seviye kontrolü, HS41X geri akış önleyici</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Yangın aksesuarları</td><td class="px-4 py-3 text-gray-700">Yayımlanmış ürün gamında yok</td><td class="px-4 py-3 text-gray-700">Var: yassı hortum, Storz kaplin, söndürücü kutusu, hortum makarası ve ABC söndürücü</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">OEM / özel marka</td><td class="px-4 py-3 text-gray-700">Var; özel yüzey, özel etiket ve proje belgeleri</td><td class="px-4 py-3 text-gray-700">Var; standart OEM/ODM ve beş dilli marka materyali</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Referans projeler</td><td class="px-4 py-3 text-gray-700">100’den fazla yurt içi büyük proje</td><td class="px-4 py-3 text-gray-700">Uluslararası B2B ihracat projeleri; talep üzerine referans</td></tr>
			</tbody></table></div>
			<h2 id="quality-and-certifications" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Kalite sistemleri ve sertifikalar</h2>
			<p class="text-gray-700 leading-relaxed mb-4"><strong>CA-FIRE</strong>, sprinkler başlıkları için FM 2030 listesine; CCCF (GB 5135) ile ISO 9001/14001/45001 belgelerine ve PICC ürün sorumluluk sigortasına sahip olduğunu yayımlar. Başlık ve alarm çekvalfleri için UL sertifikasının devam ettiği belirtilir; bu nedenle UL durumu verilmiş değil, <em>beklemededir</em>.</p>
			<p class="text-gray-700 leading-relaxed mb-4"><strong>Wanlian Fluid</strong>, kendi hatları ve nitelikli ortak kapasitesinde ISO 9001 sistemiyle çalışır; tüm birimlerde gövde basınç ve hava sızıntısı testleri yapılır, sertifika ve muayene kayıtları sevkiyatla koordine edilir. FM veya UL listesi bulunduğunu iddia etmez; UL/FM şartnameli modellerde uygunluk teklif aşamasında model bazında doğrulanır.</p>
			<p class="text-gray-700 leading-relaxed"><strong>Pratik öneri:</strong> sertifikalar ürün ve varış yerine özgüdür. FM listeli sprinkler gerekiyorsa listeli üreticilere yönelin; diğer kalemlerde birim test kayıtlarını, standarda uygun raporları ve üçüncü taraf muayene seçeneklerini karşılaştırın. <a href="/tr/guides/how-to-verify-chinese-valve-supplier/" class="text-brand-blue font-semibold hover:underline">Çinli tedarikçi doğrulama kılavuzumuz</a> ve <a href="/tr/guides/detect-fake-valves-fire-equipment-counterfeits/" class="text-brand-blue font-semibold hover:underline">sahte sertifika tespit kılavuzumuz</a> ayrıntılı kontrol adımlarını sunar.</p>
			<h2 id="where-each-wins" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Hangi üretici nerede öne çıkar?</h2>
			<p class="text-gray-700 leading-relaxed mb-4"><strong>CA-FIRE şu durumlarda öne çıkar:</strong> şartnamenin kritik kalemi FM onaylı sprinkler başlığıysa; proje sprinkler odaklıysa; veya 13 yılı aşan geçmiş ve havalimanı, veri merkezi gibi büyük yurt içi referanslar isteniyorsa.</p>
			<p class="text-gray-700 leading-relaxed mb-4"><strong>Wanlian Fluid şu durumlarda öne çıkar:</strong> proje yangın suyu monitörlerine odaklanıyorsa; kapsam monitör, alarm vanası, hidrant, <a href="/tr/products/adjustable-pressure-reducing-valve-500x/" class="text-brand-blue font-semibold hover:underline">500X basınç düşürücü vana</a>, hortum, nozul ve söndürücü kutusundan oluşan tam kitse; CA-FIRE’nin yayımlamadığı hidrolik kontrol vanalarına veya IoT hidrantlara ihtiyaç varsa; ya da İspanyolca, Rusça, Fransızca veya Arapça marka materyali isteniyorsa.</p>
			<p class="text-gray-700 leading-relaxed"><strong>Birlikte de kullanılabilirler:</strong> uluslararası bir yüklenici FM listeli başlıkları CA-FIRE’den, malzemenin kalanını Wanlian’dan alabilir. En doğrudan rekabet alarm çekvalfleri, hidrantlar ve monitörlerdedir; sprinkler listeleri ile hidrolik kontrol ve aksesuarlar ise farklı ihtiyaç alanlarıdır.</p>
			<h2 id="cost-and-lead-time" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Maliyet, fiyatlandırma ve teslim süresi</h2>
			<p class="text-gray-700 leading-relaxed mb-4">İki fabrika da kamuya açık fiyat listesi olmadan talep üzerine teklif verir. CA-FIRE 24 saat, Wanlian Fluid 12 saat teklif dönüşü bildirir. FM listeli başlıklar liste primi taşırken vana, hidrant, monitör, hortum ve dolap gibi listelenmemiş ürünler aynı Quanzhou tedarik kümesinde fiyatlanır. Karma kitlerde belirleyici ölçüt çoğu zaman tek PO başına toplam teslim maliyetidir: kalem sayısı, tek sevkiyatta konsolidasyon, tek gümrük girişi ve tek kalite denetimi.</p>
			<h2 id="which-should-you-choose" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">7. Hangisini seçmelisiniz?</h2>
			<div class="bg-gray-50 rounded-xl border border-gray-200 p-6 my-5"><p class="font-bold text-gray-900 mb-3"><strong class="text-brand-blue">CA-FIRE’yi</strong> şu durumlarda seçin:</p><ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2"><li>Projeniz FM Global veya NFPA 13 kapsamındaysa ve FM listeli sprinkler başlığı gerekiyorsa.</li><li>Kapsam sprinkler başlıkları, ıslak alarm çekvalfleri ve baskın vanalarına odaklanıyorsa.</li><li>Havalimanı ve veri merkezi gibi büyük yurt içi referansları bulunan 13+ yıllık geçmişi önemsiyorsanız.</li></ul></div>
			<div class="bg-gray-50 rounded-xl border border-gray-200 p-6 my-5"><p class="font-bold text-gray-900 mb-3"><strong class="text-brand-red">Wanlian Fluid’i</strong> şu durumlarda seçin:</p><ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2"><li>Yangın monitörleri, özellikle tank sahaları ve açık alanlar için ZDMS otomatik takipli monitörler merkezdeyse.</li><li>Monitör, alarm vanası, hidrant, hidrolik kontrol vanası, hortum, nozul ve söndürücü dolabını tek PO’da istiyorsanız.</li><li>500X/100X/F745X hidrolik vanalara veya IoT akıllı hidrantlara ihtiyacınız varsa.</li><li>İspanyolca, Rusça, Fransızca veya Arapça pazarlarda yerelleştirilmiş marka materyali gerekiyorsa.</li></ul></div>
			<p class="text-gray-700 leading-relaxed mb-4">Karar için üç soruyu yanıtlayın: şartnamede FM listeli sprinkler var mı, kapsamda monitör veya hidrolik kontrol vanası var mı ve son kullanıcılar hangi dili kullanıyor? İlk soru CA-FIRE’yi; ikinci ve üçüncü sorular Wanlian Fluid’i destekler. Daha geniş değerlendirme için <a href="/tr/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">B2B vana tedarik kontrol listesine</a> bakın.</p>
