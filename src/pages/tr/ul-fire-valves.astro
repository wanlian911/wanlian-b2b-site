---
import Layout from '../../layouts/Layout.astro';
const products = [
 { slug: 'resilient-seat-flanged-gate-valve-z41x', name: 'Elastomer Yataklı Sürgülü Vana (Z41X)', desc: 'EPDM kaplı kama, kabarcık geçirmez kapama, DN50–DN700', img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp' },
 { slug: 'signal-grooved-wafer-butterfly-valve-dn80', name: 'Sinyal İzleme Anahtarlı Yivli Wafer Kelebek Vana', desc: 'Entegre durum izleme anahtarlı DN80 PN16', img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp' },
 { slug: 'ul-fm-resilient-seat-osy-gate-valve', name: 'UL/FM OS&Y Sürgülü Vana (Yivli)', desc: 'UL/FM listeli yükselen milli sürgülü vana, 2–10 inç', img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp' },
 { slug: 'spherical-ball-check-valve-hq44x', name: 'Küresel Çekvalf (HQ44X)', desc: 'Düşük basınç kaybı, tıkanmayan yuvarlanan küre tasarımı', img: '/assets/products/spherical-ball-check-valve-hq44x.webp' },
 { slug: 'deluge-alarm-valve-zsfm', name: 'Baskın Alarm Vana Grubu (ZSFM)', desc: 'Diyafram kumandalı, DN50–DN300, hızlı açılma', img: '/assets/products/deluge-alarm-valve-zsfm.webp' },
 { slug: 'pre-action-alarm-system-zsfy', name: 'Ön Tepkili Alarm Sistemi (ZSFY)', desc: 'Suya hassas odalar için çift tetiklemeli emniyet', img: '/assets/products/pre-action-alarm-system-zsfy.jpg' }
];
const faq = [
 { question: 'Yangın vanaları için UL listeli ne anlama gelir?', answer: 'UL listesi; vananın debi, basınç sınıfı ve dayanıklılık bakımından yangın koruma standartlarını karşıladığını doğrular. Sprinkler ve kolon sistemlerinde güvenilir performans sağlar.' },
 { question: 'Wanlian hangi yangın vanalarını UL listeli üretir?', answer: 'DN40–DN300 aralığında flanşlı, yivli ve dişli bağlantılı sürgülü, kelebek, çekvalf, baskın ve ön tepkili vanalar üretiyoruz. Proje spesifikasyonunu göndererek doğru sertifika paketini eşleştirebilirsiniz.' },
 { question: 'Sipariş öncesi UL sertifikası sağlanabilir mi?', answer: 'Evet. UL/ULC ve FM sertifikaları talep üzerine paylaşılır. Mühendislerimiz teklif öncesinde hedef pazarınız için geçerli sertifikayı doğrular.' }
];
---
<Layout locale="tr" title="UL Listeli Yangın Vanaları | UL Yangın Vana Üreticisi" description="Wanlian Fluid; sürgülü, kelebek, çekvalf, baskın ve ön tepkili UL listeli yangın vanalarını kendi üretim hatlarında üretir." type="product" productData={{ name: 'UL Listeli Yangın Vanaları', image: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp', description: 'Yangın koruma sistemleri için UL listeli sürgülü, kelebek, çekvalf, baskın ve ön tepkili vanalar.' }} faq={faq} breadcrumbs={[{ name: 'UL Yangın Vanaları' }]}>
<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/tr/">Ana Sayfa</a><span>/</span><a href="/tr/products/">Ürünler</a><span>/</span><span>UL Yangın Vanaları</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">UL Sertifikalı Yangın Koruma Vanaları</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight">Güvenilir Yangın Koruma Sistemleri için UL Listeli Yangın Vanaları</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid; ticari ve endüstriyel yangın koruma sistemleri için UL listeli sürgülü, kelebek, çekvalf, baskın ve ön tepkili vanalar üretir. Quanzhou yakınındaki kendi üretim hatlarımızda ISO 9001 kalite sistemi altında, fabrika teslimi ve tam sertifika dokümantasyonuyla çalışıyoruz.</p><div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">{['UL/ULC Listeli', 'FM Onaylı', 'ISO 9001:2015', 'Fabrikadan Doğrudan'].map(b => <div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue">{b}</span></div>)}</div><h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">Yangın Vana Serisi</h2><div class="grid grid-cols-2 lg:grid-cols-3 gap-4">{products.map(p => <a href={`/tr/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red transition"><img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2"/><div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red">{p.name}</p><p class="text-[10px] text-gray-400 mt-1">{p.desc}</p></div></a>)}</div><h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">Temel Teknik Özellikler</h2><div class="overflow-x-auto rounded-xl border border-gray-200"><table class="min-w-full text-sm divide-y divide-gray-200"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left">Özellik</th><th class="px-4 py-3 text-left">Ayrıntı</th></tr></thead><tbody class="divide-y divide-gray-200"><tr><td class="px-4 py-3 font-bold">Standartlar</td><td class="px-4 py-3">Model ve hedef pazara göre UL/ULC Listeli, FM Onaylı</td></tr><tr><td class="px-4 py-3 font-bold">Ölçü aralığı</td><td class="px-4 py-3">DN40–DN300 (1½–12 inç)</td></tr><tr><td class="px-4 py-3 font-bold">Basınç sınıfı</td><td class="px-4 py-3">PN16 / PN25</td></tr><tr><td class="px-4 py-3 font-bold">Gövde malzemesi</td><td class="px-4 py-3">Sfero döküm QT450 / WCB / CF8 ve CF8M paslanmaz çelik</td></tr><tr><td class="px-4 py-3 font-bold">Uç bağlantıları</td><td class="px-4 py-3">Flanşlı / yivli / dişli</td></tr></tbody></table></div><h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">Uygulamalar</h2><p class="text-gray-700 leading-relaxed">UL yangın vanalarımız bina sprinkler sistemlerinde, sanayi tesislerinde, lojistik merkezlerinde, veri merkezlerinde ve petrokimya yangın ana hatlarında kullanılır.</p><h2 class="text-2xl font-black text-gray-900 mt-12 mb-6">Sıkça Sorulan Sorular</h2><div class="space-y-4">{faq.map(item => <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5"><summary class="font-bold text-gray-800 cursor-pointer list-none">{item.question}</summary><p class="mt-3 text-gray-600 text-sm leading-relaxed">{item.answer}</p></details>)}</div><div class="mt-12 text-center bg-gradient-to-r from-brand-blue to-blue-800 px-6 py-10 rounded-2xl"><h2 class="text-2xl font-black text-white">Projeniz için UL yangın vanalarına mı ihtiyacınız var?</h2><a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Merhaba, UL listeli yangın vanaları hakkında bilgi istiyorum.')}`} class="inline-block mt-6 px-8 py-4 bg-white text-brand-blue font-bold rounded-lg">WhatsApp ile görüşün</a></div></article></main>
</Layout>
