---
import Layout from '../../../layouts/Layout.astro';
const groups = [{ title: 'Vanalar ve bileşenler', terms: [{ term: 'Sürgülü Vana', definition: 'Su ve yangın koruma şebekelerinde akışı kesmek için kamalı sürgü kullanan izolasyon vanası.' }, { term: 'Elastomer Yataklı Sürgülü Vana', definition: 'Sürgü üzerinde elastomer yatak kullanarak kapalı konumda sızdırmazlık sağlayan sürgülü vana.' }, { term: 'Kelebek Vana', definition: 'Boru hatlarında kontrol ve izolasyon için diskli, çeyrek turlu vana.' }, { term: 'Çekvalf / Geri Dönüşsüz Vana', definition: 'Akışa tek yönde izin veren ve akışkanın geri dönmesini engelleyen vana.' }, { term: 'Basınç Düşürücü Kontrol Vanası', definition: 'Giriş basıncını otomatik olarak kararlı bir çıkış basıncına düşüren vana.' }, { term: 'Geri Akış Önleyici', definition: 'Çapraz bağlantıda içme suyunun geri akışla kirlenmesini önleyen cihaz veya çift çekvalfli sistem.' }] }, { title: 'Hidrantlar ve bağlantılar', terms: [{ term: 'Yangın Hidrantı', definition: 'Yangın hortumlarını ve söndürme ekipmanlarını beslemek için su şebekesine bağlanan ekipman.' }, { term: 'Yangın Musluğu / İç Saha Hidrant Vanası', definition: 'Yangın tesisatında hortum bağlantısı ve su alımı için kullanılan hidrant başlığı.' }, { term: 'İtfaiye Bağlantı Ağzı (FDC)', definition: 'İtfaiyenin sprinkler sistemine veya yangın şebekesine su basmasını sağlayan bağlantı.' }, { term: 'Metal Körüklü Sürgülü Vana', definition: 'Mil sızdırmazlığını metal körükle sağlayan, emisyon kontrolü için kullanılan vana.' }] }, { title: 'Sprinkler ve söndürme', terms: [{ term: 'Yangın Sprinkler Başlığı', definition: 'Isı elemanı tetikleme sıcaklığına ulaştığında suyu otomatik olarak boşaltan cihaz.' }, { term: 'Islak Alarm Vana İstasyonu', definition: 'Islak sprinkler sisteminde su akışını algılayan ve alarmı başlatan vana istasyonu.' }, { term: 'Ön Tepkili (Pre-Action) Yangın Sistemi', definition: 'Suyu serbest bırakmadan önce bağımsız sinyaller gerektiren, boruları normalde kuru sistem.' }, { term: 'Baskın (Deluge) Alarm Vanası', definition: 'Açık sprinkler veya nozullara aynı anda su sağlayan hızlı açılan yangın vanası.' }, { term: 'Yangın Monitörü / Su Topu', definition: 'Yüksek debili su veya köpük akışını tehlikeli bölgelere yönlendiren sabit ya da taşınabilir ekipman.' }] }, { title: 'Test ve satın alma', terms: [{ term: 'Anma Basıncı', definition: 'Bir vananın belirtilen sıcaklık aralığında tasarlandığı referans basınç sınıfı.' }, { term: 'MOQ', definition: 'Üreticinin sipariş kabul ettiği minimum miktar; model ve ölçüye göre değişebilir.' }, { term: 'Incoterm', definition: 'Satıcı ve alıcının taşıma, teslim, sigorta ve risk sorumluluklarını tanımlayan uluslararası ticaret kuralı.' }] }];
---
<Layout title="Vanalar ve Yangın Koruma Sözlüğü" description="Vanalar, hidrantlar, sprinkler, sertifikalar, testler ve B2B satın alma terimleri için teknik sözlük." type="website" locale="tr" breadcrumbs={[{ name: 'Sözlük' }]}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/tr/">Ana sayfa</a><span>/</span><span class="text-gray-600">Sözlük</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Teknik referans</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Vanalar ve yangın koruma sözlüğü</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Yangın vanaları, hidrantlar, sprinkler ve ekipman şartnameleri, teknik föyleri ve B2B satın alma süreçleri için net tanımlar.</p><div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-8">{groups.map(g => <a href={`#${g.title.toLowerCase().replace(/[^a-z0-9çğıöşü]+/g, '-')}`} class="px-4 py-3 bg-gray-50 border border-gray-100 rounded-xl text-xs font-bold text-brand-blue text-center">{g.title}</a>)}</div>{groups.map(g => <section class="mt-12"><h2 id={g.title.toLowerCase().replace(/[^a-z0-9çğıöşü]+/g, '-')} class="text-2xl font-black text-gray-900 mb-5 tracking-tight">{g.title}</h2><div class="space-y-4">{g.terms.map(t => <div class="bg-gray-50 rounded-xl border border-gray-100 p-5"><h3 class="text-lg font-black text-gray-900">{t.term}</h3><p class="mt-2 text-gray-700 leading-relaxed text-sm">{t.definition}</p></div>)}</div></section>)}<div class="mt-12 bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center rounded-2xl"><h2 class="text-2xl font-black text-white">Şartnameye hazır mısınız?</h2><p class="mt-3 text-blue-100">Miktarınızı ve varış noktanızı göndererek ayrıntılı teklif alın.</p><a href="/tr/contact/" class="inline-block mt-6 px-8 py-4 bg-brand-red text-white font-bold rounded-lg">Teklif isteyin</a></div></article></main>
</Layout>
