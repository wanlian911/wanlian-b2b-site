---
import Layout from '../../layouts/Layout.astro';

const products = [
  { slug: 'anti-pollution-backflow-preventer-hs41x', name: 'Kirlilik Önleyici Geri Akış Önleyici (HS41X-16)', desc: 'Ara drenajlı çift çekvalf grubu, DN50–DN600', img: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp' },
  { slug: 'adjustable-pressure-reducing-valve-500x', name: 'Hidrolik Basınç Düşürücü Kontrol Vanası (500X)', desc: 'Kendi kendine çalışan pilot kontrol, 0,1–1,6 MPa ayar aralığı', img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp' },
  { slug: 'hydraulic-water-level-control-valve-f745x', name: 'Hidrolik Su Seviye Kontrol Vanası (F745X)', desc: 'Depo ve tanklar için şamandıralı pilot seviye kontrolü', img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp' },
  { slug: 'groove-solenoid-control-gate-valve-gkzf1', name: 'Solenoid Kontrollü Sürgülü Vana (GKZF-1)', desc: 'DC24V/AC220V pilot kontrollü yivli vana, 300 PSI', img: '/assets/products/groove-solenoid-control-gate-valve-gkzf1.jpg' },
  { slug: 'suction-vortex-preventer-en12845', name: 'Emiş Girdap Önleyici (EN12845)', desc: 'SS304/316, pompa kavitasyonunu önler, 100 mm drenaj derinliği', img: '/assets/02_valves_parts/valves_p21.webp' }
];
const faq = [
  { question: 'Geri akış önleyici ile çekvalf arasındaki fark nedir?', answer: 'Standart çekvalf ters akışı mekanik olarak önler; ancak ara drenajı ve yerinde test imkânı yoktur. HS41X iki bağımsız çekvalfi otomatik ara drenaj haznesiyle birleştirir ve içme suyu koruması için çapraz bağlantı kontrol gerekliliklerini karşılar.' },
  { question: 'Geri akış önleyici nereye monte edilmelidir?', answer: 'İçme suyu ana hattına bağlanan yangın servis hattında, yangın pompası emişinin veya sistem kolonunun öncesine monte edilmelidir. Test için erişilebilir olmalı, donmaya karşı korunmalı ve basınç kaybı hidrolik hesaplara dahil edilmelidir.' },
  { question: 'Hidrolik kontrol vanaları elektrik gerektirir mi?', answer: '500X, F745X ve HS41X gibi modeller boru hattı basıncıyla tamamen çalışır ve harici enerji gerektirmez. GKZF-1 gibi solenoid kontrollü modeller AC220V veya DC24V ile çalışır.' }
];
---
<Layout locale="tr" title="Geri Akış Önleyiciler ve Hidrolik Kontrol Vanaları | Wanlian Fluid" description="İçme suyu ve yangın şebekeleri için HS41X geri akış önleyici, 500X basınç düşürücü ve hidrolik kontrol vanaları. Fabrikadan doğrudan B2B tedarik." type="product" productData={{ name: 'Geri Akış Önleme ve Hidrolik Kontrol', image: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp', description: 'Wanlian Fluid tarafından üretilen içme suyu koruma, basınç yönetimi ve otomatik su şebekesi vanaları.' }} faq={faq} breadcrumbs={[{ name: 'Geri Akış Önleme' }]}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
    <nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/tr/" class="hover:text-blue-600">Ana Sayfa</a><span>/</span><a href="/tr/products/" class="hover:text-blue-600">Ürünler</a><span>/</span><span class="text-gray-600">Geri Akış Önleme</span></nav>
    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
      <p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">İçme Suyu Koruması ve Hidrolik Kontrol</p>
      <h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Geri Akış Önleyiciler ve Hidrolik Kontrol Vanaları</h1>
      <p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid; HS41X kirlilik önleyici geri akış önleyiciler, 500X basınç düşürücü kontrol vanaları, F745X seviye kontrol vanaları ve GKZF-1 solenoid kontrol vanaları üretir. Bu koordineli paket, içme suyu şebekelerini korur ve basınç ile seviye kontrolünü otomatikleştirir.</p>
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">{['Çift Çekvalf + Drenaj', 'PN10–PN25', 'GB/T17219 Hijyenik', 'Kendi Kendine Çalışan Pilot'].map(b => <div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span></div>)}</div>
      <h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Hidrolik Emniyet Vana Serisi</h2>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">{products.map(p => <a href={`/tr/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition"><img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" /><div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug">{p.name}</p><p class="text-[10px] text-gray-400 mt-1">{p.desc}</p></div></a>)}</div>
      <h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Temel Teknik Özellikler</h2>
      <div class="overflow-x-auto rounded-xl border border-gray-200"><table class="min-w-full divide-y divide-gray-200 text-sm"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left">Vana</th><th class="px-4 py-3 text-left">İşlev</th><th class="px-4 py-3 text-left">Ölçü aralığı</th><th class="px-4 py-3 text-left">Basınç sınıfı</th></tr></thead><tbody class="bg-white divide-y divide-gray-200"><tr><td class="px-4 py-3 font-bold">HS41X</td><td class="px-4 py-3">Kirlilik önleyici geri akış koruması</td><td class="px-4 py-3">DN50–DN600</td><td class="px-4 py-3">PN10 / PN16 / PN25</td></tr><tr><td class="px-4 py-3 font-bold">500X</td><td class="px-4 py-3">Basınç düşürme / sabitleme</td><td class="px-4 py-3">DN20–DN600</td><td class="px-4 py-3">PN10 / PN16 / PN25</td></tr><tr><td class="px-4 py-3 font-bold">F745X</td><td class="px-4 py-3">Su seviye kontrolü</td><td class="px-4 py-3">DN50–DN400</td><td class="px-4 py-3">PN10 / PN16</td></tr><tr><td class="px-4 py-3 font-bold">GKZF-1</td><td class="px-4 py-3">Solenoid açma-kapama kontrolü</td><td class="px-4 py-3">DN50–DN300</td><td class="px-4 py-3">300 PSI, AC220V/DC24V</td></tr></tbody></table></div>
      <h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Uygulamalar</h2><ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2"><li>İçme suyu çapraz bağlantı kontrolü</li><li>Su depoları ve çatı tanklarında seviye kontrolü</li><li>Belediye ve bina şebekelerinde basınç bölgesi yönetimi</li><li>Uzaktan vana kontrollü otomatik su şebekeleri</li><li>Depo ve tanklarda pompa emiş koruması</li></ul>
      <h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Sıkça Sorulan Sorular</h2><div class="space-y-4">{faq.map(item => <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5"><summary class="font-bold text-gray-800 cursor-pointer list-none">{item.question}</summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>)}</div>
      <div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white">Şebekeniz için hidrolik vana paketi mi gerekiyor?</h2><p class="mt-3 text-blue-100 text-sm">DN, basınç sınıfı ve bağlantı tipinizi gönderin; mühendislerimiz 12 saat içinde teknik teklif hazırlasın.</p><a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Merhaba, hidrolik kontrol vanalarının seçimi için yardım istiyorum.')}`} class="inline-block mt-6 px-8 py-4 bg-white text-brand-blue font-bold rounded-lg">WhatsApp ile görüşün</a></div></div>
    </article>
  </main>
</Layout>
