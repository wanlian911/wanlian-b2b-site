    /* Arabic cannot carry tracking: letter-spacing pulls joined letters apart and breaks the word
       shapes. This sheet is shared by all nine locales, so the exemption is scoped by writing
       direction rather than by a separate locale stylesheet - the eight Latin-script pages keep the
       approved values. .c68-fine is the English legal line and stays tracked. ASCII on purpose: the
       locale pages are generated from this block line by line and drop any CJK-bearing line. */
    html[dir="rtl"] .c68-kicker, html[dir="rtl"] .c68-eyebrow, html[dir="rtl"] .c68-btn,
    html[dir="rtl"] .c68-stat-label, html[dir="rtl"] .c68-line-count, html[dir="rtl"] .c68-line-more,
    html[dir="rtl"] .c68-chip, html[dir="rtl"] .c68-cert-code, html[dir="rtl"] .c68-step-n,
    html[dir="rtl"] .c68-guide-eyebrow, html[dir="rtl"] .c68-guide-more,
    html[dir="rtl"] .c68-frame figcaption, html[dir="rtl"] .c68-sshot figcaption,
    html[dir="rtl"] .c68-clip figcaption strong, html[dir="rtl"] .c68-pcard figcaption,
    html[dir="rtl"] .c68-shot figcaption, html[dir="rtl"] .c68-hero-grid h1,
    html[dir="rtl"] .c68-head h2 { letter-spacing: normal; }

    html.c68-js .c68-rv { opacity: 0; transform: translateY(16px); transition: opacity .6s ease, transform .6s ease; }
