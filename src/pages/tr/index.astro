---
import Layout from '../../layouts/Layout.astro';
import { productsTr as products } from '../../utils/products.tr';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';
import LeadCaptureSection from '../../components/inquiry/LeadCaptureSection.astro';

const faq = [
  { question: 'Wanlian Fluid hangi ürünleri üretir ve ihraç eder?', answer: 'Wanlian Fluid, Quanzhou merkezli bir üretici ve ihracatçı olarak endüstriyel vanalar, yangın hidrantları, sprinkler ve alarm vanaları, yangın hortumları ve hidrolik kontrol ekipmanları sunar.' },
  { question: 'Vana veya hidrant fiyatını nasıl alabilirim?', answer: 'Fiyatlandırma talep üzerine yapılır. Model veya standart, ölçü, basınç sınıfı, malzeme, miktar ve teslimat noktasını iletin; ekibimiz 12 saat içinde ayrıntılı teklif hazırlayacaktır.' },
  { question: 'Ürünler sevkiyattan önce test edilir mi?', answer: 'Evet. Her vana, hidrant ve hortum sevkiyattan önce gövde basıncı ve hava sızdırmazlığı açısından test edilir. Üretim, ISO 9001 kalite yönetim sistemi kapsamında yürütülür.' },
  { question: 'OEM veya özel marka siparişi kabul ediyor musunuz?', answer: 'Evet. OEM/ODM işaretleme, özel ürün ve ihracat ambalajı standart hizmetlerimizdir. AWWA, TS EN, UL veya FM gibi standartlara uygunluk model bazında teyit edilir.' }
];

// Category grid and the grouped catalog index are both derived from this locale's product
// module, so line names, counts and card photography cannot drift from the live catalog.
// is keyed by English category names, so it stays empty and each line uses its first photo.
const CATEGORY_LEAD: Record<string, string> = {};

const categoryNames: string[] = [...new Set(products.map(p => p.category))];

const categories = categoryNames.map(name => {
  const inCategory = products.filter(p => p.category === name);
  const lead = inCategory.find(p => p.slug === CATEGORY_LEAD[name]) ?? inCategory[0];
  return { name, count: inCategory.length, image: lead.image, leadName: lead.name, href: `/tr/products/#category=${encodeURIComponent(name)}` };
});

const catalogByCategory = categoryNames.map(name => ({
  name,
  href: `/tr/products/#category=${encodeURIComponent(name)}`,
  items: products.filter(p => p.category === name).map(p => ({ name: p.name, href: '/tr/products/' + p.slug + '/' }))
}));

const productionSteps = [{"step":"01","title":"Hassas Örgü","desc":"Dayanıklı yangın hortumu kılıfları için yüksek mukavemetli polyester örgü."},{"step":"02","title":"Kaplama Yapışması","desc":"Sızdırmaz kauçuk kaplama için gelişmiş vulkanizasyon prosesi."},{"step":"03","title":"CNC İşleme","desc":"Sfero dökme demir vana gövdeleri ve parçalarının hassas işlenmesi."},{"step":"04","title":"Güvenlik Testleri","desc":"Her birimde yüzde 100 gövde basıncı ve hava sızdırmazlık testi."},{"step":"05","title":"Epoksi Kaplama","desc":"Yüksek korozyon direnci için toksik olmayan epoksi reçine kaplama."}];



// Own-name assurance only. Third-party listings belong to the factory that holds them, so this
// strip must never imply that Wanlian itself holds UL, FM, CE or LPCB listings.
const certifications = [{"name":"Basınç testi","code":"her parti, %100"},{"name":"Malzeme belgeleri","code":"döküm, gövde, conta"},{"name":"Bağımsız muayene","code":"SGS / BV / Intertek"},{"name":"ISO 9001:2015","code":"Kalite Yönetimi"},{"name":"EN 12266-1","code":"GB/T 13927"},{"name":"GB Standardı","code":"GB 5135 / GB 4452"}];

const waCallbackHref = `https://wa.me/8618684324501?text=${encodeURIComponent('Merhaba, endüstriyel vanalarınız ve yangın koruma ekipmanlarınızla ilgileniyorum. Lütfen ürün kataloğu ve fiyat listesi gönderin.')}`;

const resources = [{"href":"/tr/guides/fire-sprinkler-system-valves-guide/","eyebrow":"Satın Alma Kılavuzu","title":"Sprinkler Sistemleri için Vana Kılavuzu","desc":"Islak alarm, baskın ve ön tepkili sistem vanalarını karşılaştırın."},{"href":"/tr/fire-water-cannon/","eyebrow":"Sistem Genel Bakışı","title":"Yangın Monitörleri ve Su Topları","desc":"Büyük hacimli alanlar için manuel PS ve otomatik izlemeli ZDMS monitörleri."},{"href":"/tr/guides/how-to-choose-a-fire-hydrant/","eyebrow":"Satın Alma Kılavuzu","title":"Yangın Hidrantı Nasıl Seçilir?","desc":"Hidrant tipi, basınç sınıfı, bağlantı standardı ve satın alma kontrol listesi."},{"href":"/tr/guides/how-to-choose-ul-listed-fire-valves/","eyebrow":"Satın Alma Kılavuzu","title":"UL Listeli Yangın Vanaları Nasıl Seçilir?","desc":"UL ve FM kapsamını, model doğrulamasını ve sertifika belgelerini inceleyin."},{"href":"/tr/guides/gate-valve-vs-butterfly-valve-fire-protection/","eyebrow":"Satın Alma Kılavuzu","title":"Sürgülü Vana ve Kelebek Vana Karşılaştırması","desc":"Yangın şebekeleri için debi, alan, maliyet ve uygulama karşılaştırması."},{"href":"/tr/guides/deluge-valve-selection-guide/","eyebrow":"Satın Alma Kılavuzu","title":"Delüj Vanası Boyutlandırma ve Seçim Kılavuzu","desc":"ZSFM delüj vanası çalışma prensibi, debi ve açılma süresi boyutlandırması, açtırma seçenekleri, açık başlık yerleşimi ve RFQ verileri."}];

// On-site project evidence: real fire pump room installation (photos + portrait walkthrough video)
const projectPhotos = [
  { src: '/assets/projects/pump-skids.webp', alt: 'Kurulu bir yangın pompa dairesinde OPEN ve CLOSE konum etiketleriyle sprinkler ve yangın pompa grupları', caption: 'OPEN/CLOSE etiketli pompa grupları' },
  { src: '/assets/projects/valve-train.webp', alt: 'Kurulu yangın pompa dairesinde kırmızı riser hatları üzerinde sürgülü vanalar ve manometreler', caption: 'Riser hatları ve sürgülü vana grubu' },
  { src: '/assets/projects/riser-grid.webp', alt: 'Kurulu yangın pompa dairesinde riser şebekesi, tavan üstü kanallar ve kablo tavaları', caption: 'Riser şebekesi ve tavan kanalları' },
  { src: '/assets/projects/pump-room-final.webp', alt: 'Kontrol ve teslime hazırlanmış, kurulu yangın pompa dairesi', caption: 'Teslime hazırlanan pompa dairesi' },
];

const projectScope = [
  'Beton kaide üzerine kurulu birden fazla sprinkler ve yangın pompa grubu',
  'Sürgülü vanalar, manometreler ve OPEN/CLOSE konum etiketleriyle eksiksiz riser hattı şebekesi',
  'Riser şebekesi boyunca yürütülen tavan üstü kanallar ve kablo tavaları',
  'Nihai kontrol ve teslime hazırlanan saha',
];

const industries = [{"name":"Petrol ve Gaz","desc":"Zorlu endüstriyel koşullarda güvenli akışkan taşınması.","icon":"pipe"},{"name":"Su Arıtma","desc":"Belediye su temini, drenaj ve filtrasyon şebekeleri.","icon":"drop"},{"name":"Yangından Korunma","desc":"Sertifikalı hidrantlar, sprinkler vanaları ve söndürme sistemleri.","icon":"flame"}];

type Clip = { src: string; poster: string; title: string; desc: string };

const clips = [{"src":"/videos/factory/assembly.mp4","poster":"/videos/factory/assembly-poster.webp","title":"Montaj","desc":"Hidrolik kontrol vanası gövde bağlantılarında tork kontrolü"},{"src":"/videos/factory/blue-valves.mp4","poster":"/videos/factory/blue-valves-poster.webp","title":"Basınç Testi","desc":"Basınç testi tamamlanan üniteler sevkiyata hazır"},{"src":"/videos/factory/red-field.mp4","poster":"/videos/factory/red-field-poster.webp","title":"Mamul Deposu","desc":"Üretimi tamamlanan yangın hidrantları sevk için sırada"},{"src":"/videos/factory/loading-close.mp4","poster":"/videos/factory/loading-close-poster.webp","title":"Paketleme ve Yükleme","desc":"Yükleme rampasında sandıklanmış ve paletlenmiş ihracat siparişi"},{"src":"/videos/factory/dispatch.mp4","poster":"/videos/factory/dispatch-poster.webp","title":"Sevkiyat","desc":"Tam yüklü tır fabrikamızdan limana doğru yola çıkıyor"}];

const walkthroughClip = {"src":"/assets/projects/project-walkthrough.mp4","poster":"/assets/projects/pump-room-wide.webp","title":"Saha Videosu"};

const stats = [
  { value: String(products.length), unit: '', label: "Katalogtaki Model" },
  { value: String(categories.length), unit: '', label: "Ürün Hattı" },
  { value: '%100', unit: '', label: "Basınç Testi" },
  { value: 'ISO 9001', unit: '', label: "Kalite Sistemi" }
];

const capability = [{"icon":"valve","title":"Kendi Üretim Hatlarımız","body":"Quanzhou tesisimizde CNC işleme, montaj, basınç testi ve kaplama süreçleri kontrol edilir."},{"icon":"gauge","title":"12 Saatte Teklif","body":"Çizim, teknik şartname veya ürün fotoğrafını gönderin; mühendislerimiz stok ve teslimat bilgisiyle yanıtlasın."},{"icon":"doc","title":"Test Edilmiş Kalite","body":"ISO 9001 kalite sistemi ve EN 12266-1 / GB/T 13927 gerekliliklerine göre model bazlı test ve belge desteği."}];

const svgOpen = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">';
const icons: Record<string, string> = {
  valve: svgOpen + '<path d="M4 16 12 9l8 7H4Z"/><path d="M12 9V4"/><path d="M8.5 4h7"/></svg>',
  gauge: svgOpen + '<circle cx="12" cy="10" r="6"/><path d="M12 10l3.2-2.6"/><path d="M6 20h12"/></svg>',
  cog: svgOpen + '<circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.4M12 18.6V21M3 12h2.4M18.6 12H21M5.6 5.6l1.7 1.7M16.7 16.7l1.7 1.7M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7"/></svg>',
  doc: svgOpen + '<path d="M7 3h7l4 4v14H7V3Z"/><path d="M14 3v4h4"/><path d="M10 12h6M10 16h6"/></svg>',
  flame: svgOpen + '<path d="M12 3c3 4 5 6 5 9a5 5 0 0 1-10 0c0-2.2 1.1-3.8 2.6-5.2"/></svg>',
  drop: svgOpen + '<path d="M12 3l5.4 7a6.4 6.4 0 1 1-10.8 0L12 3Z"/></svg>',
  pipe: svgOpen + '<path d="M3 8.5h7v7H3zM14 8.5h7v7h-7z"/><path d="M10 12h4"/><path d="M3 8.5v7M21 8.5v7"/></svg>',
  guide: svgOpen + '<path d="M4 5h7v15H4zM13 5h7v15h-7z"/><path d="M7 9h1M16 9h1"/></svg>',
  chat: svgOpen + '<path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9h8M8 12h5"/></svg>'
};
const tick = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9 17.5 20 6.5"/></svg>';
---

<Layout locale="tr" title="Wanlian Fluid | Endüstriyel Vanalar ve Yangın Güvenliği" description="Quanzhou, Çin merkezli endüstriyel vana ve yangın güvenliği ekipmanı üreticisi. ISO 9001, CNC işleme ve 12 saatte ayrıntılı teklif." faq={faq} video={{ name: '50 Saniyede Wanlian Fluid', description: 'Quanzhou tesisinde showroom, üretim, OEM özelleştirme ve kalite kontrol tanıtımı.', thumbnail: '/videos/company-intro-poster.webp', src: '/videos/company-intro.mp4', duration: 'PT49S', uploadDate: '2026-09-18' }}>
  <div class="c68">

    <section class="c68-hero">
      <div class="c68-wrap c68-hero-grid">
        <div class="c68-rv">
          <p class="c68-eyebrow"><span class="c68-dot"></span>Üretici ve İhracatçı — Vanalar ve Yangın Güvenliği</p>
          <h1>Küresel Projeler için <em>Vanalar ve Yangın Güvenliği.</em></h1>
          <p class="c68-rule" aria-hidden="true"></p>
          <p class="c68-lede">Endüstriyel vanalar, yangın hidrantları, sprinkler ve alarm vana sistemleri. Yüzde 100 basınç testi, ISO 9001 ve 12 saat içinde ayrıntılı teklif.</p>
          <div class="c68-cta">
            <a class="c68-btn c68-btn-red" href="/tr/products/">Kataloğu Görüntüle</a>
            <a class="c68-btn c68-btn-ghost" href="/tr/contact/#inquiry">Teklif İste</a>
          </div>
        </div>
        <figure class="c68-frame c68-rv">
          <span class="c68-frame-tab"></span>
          <img src="/assets/factory/plant-exterior.webp" alt="Quanzhou, Fujian’daki Wanlian Fluid fabrika binası" decoding="async" />
          <figcaption>Üretim Tesisimizden Gerçek Görüntüler</figcaption>
        </figure>
      </div>
      <div class="c68-stats">
        <div class="c68-wrap c68-stats-grid">
          {stats.map((s) => (
            <div class="c68-stat">
              <p class="c68-stat-num">{s.value}<span>{s.unit}</span></p>
              <p class="c68-stat-label">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="product-lines">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Başlıca Ürün Kategorileri</p>
          <h2>Dünya genelindeki yangın ve su şebekeleri için yüksek hassasiyetli mühendislik.</h2>
        </header>
        <div class="c68-lines">
          {categories.map((c) => (
            <a class="c68-line c68-rv" href={c.href}>
              <span class="c68-line-media"><img src={c.image} alt={c.leadName} loading="lazy" decoding="async" /></span>
              <span class="c68-line-body">
                <span class="c68-line-count">{c.count}</span>
                <span class="c68-line-name">{c.name}</span>
                <span class="c68-line-more">Seriyi Görüntüle <i aria-hidden="true">&rarr;</i></span>
              </span>
            </a>
          ))}
          <a class="c68-line c68-line-full c68-rv" href="/tr/products/">
            <span class="c68-line-body">
              <span class="c68-line-count">Tam Katalog →</span>
              <span class="c68-line-name c68-line-name-inv">{products.length}</span>
              <span class="c68-line-more c68-line-more-inv">Tüm ürünler ve filtreler →</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="c68-band">
      <div class="c68-wrap">
        <div class="c68-cap-grid">
          {capability.map((c) => (
            <article class="c68-cap c68-rv">
              <span class="c68-ico" set:html={icons[c.icon]}></span>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="about">
      <div class="c68-wrap c68-profile-grid">
        <div class="c68-rv">
          <header class="c68-head">
            <p class="c68-kicker">Şirket Profili</p>
            <h2>Küresel Projeler için <em>Akışkan Kontrol Çözümleri.</em></h2>
          </header>
          <p class="c68-body">Quanzhou Wanlian Fluid Equipment Co., Ltd., Çin'in vana ve boru endüstrisi merkezlerinden Quanzhou, Fujian'da endüstriyel vanalar, hidrolik kontrol ürünleri, hidrant bileşenleri ve yangın güvenliği ekipmanları üretir ve ihraç eder.</p>
          <p class="c68-profile-link"><a href="/tr/about/">Hakkımızda &rarr;</a><a href="/tr/applications/">Uygulamalar &rarr;</a></p>
        </div>
        <div class="c68-shots">
          <figure class="c68-shot c68-rv">
            <img src="/assets/factory/workshop.webp" alt="Quanzhou fabrikasındaki ana üretim alanı" loading="lazy" decoding="async" />
            <figcaption>Üretim Alanı</figcaption>
          </figure>
          <figure class="c68-shot c68-rv">
            <img src="/assets/factory/powder-coating.webp" alt="Quanzhou fabrikasındaki toz boya hattı" loading="lazy" decoding="async" />
            <figcaption>Toz Boya</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="c68-band" id="process">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Üretim Akışı</p>
          <h2>Standart Üretim Prosesimiz</h2>
        </header>
        <ol class="c68-steps">
          {productionSteps.map((s) => (
            <li class="c68-step c68-rv">
              <span class="c68-step-n">{s.step}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="c68-band c68-dark" id="factory">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker c68-kicker-red">Fabrikadan Canlı</p>
          <h2>Üretim Tesisimizden <em>Gerçek Görüntüler</em></h2>
          <p class="c68-head-sub">Stok video yok, kurgu yok — montajdan sevkiyata kadar Quanzhou tesisimiz iş başında.</p>
        </header>
        <div class="c68-video-lead">
          <figure class="c68-vid c68-rv">
            <video src="/videos/company-intro.mp4" poster="/videos/company-intro-poster.webp" controls playsinline preload="none"></video>
            <figcaption><strong>50 Saniyede Wanlian Fluid</strong><span>Quanzhou tesisimizde showroom, üretim hatları ve kalite denetimi — stok video içermeyen gerçek fabrika görüntüleri.</span></figcaption>
          </figure>
          <div class="c68-side">
            <ul class="c68-video-note">
              <li>Sevkiyattan önce bağımsız denetim, talebiniz üzerine.</li>
              <li>Kurumsal Videoyu Oynat</li>
              <li>Sertifikaları ve Teknik Belgeleri Görün</li>
            </ul>
            <div class="c68-side-shots">
              <figure class="c68-sshot c68-rv">
                <img src="/assets/factory/assembly.webp" alt="Assembly and finishing bay" loading="lazy" decoding="async" style="aspect-ratio: 5 / 2" />
                <figcaption>Montaj</figcaption>
              </figure>
              <figure class="c68-sshot c68-rv">
                <img src="/assets/factory/fire-hose.webp" alt="Mamul Deposu" loading="lazy" decoding="async" style="aspect-ratio: 5 / 2" />
                <figcaption>Mamul Deposu</figcaption>
              </figure>
            </div>
          </div>
        </div>
        <div class="c68-clips">
          {clips.map((c) => (
            <figure class="c68-clip c68-rv">
              <video src={c.src} poster={c.poster} controls playsinline preload="none"></video>
              <figcaption><strong>{c.title}</strong><span>{c.desc}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Sistem Çözümleri</p>
          <h2>Yüksek Basınçlı <em>Hizmet için Tasarlandı.</em></h2>
          <p class="c68-head-sub"><a class="c68-inlink" href="/tr/applications/">Uygulamalar &rarr;</a></p>
        </header>
        <div class="c68-ind">
          {industries.map((i) => (
            <a class="c68-ind-card c68-rv" href="/tr/applications/">
              <span class="c68-ico" set:html={icons[i.icon]}></span>
              <h3>{i.name}</h3>
              <p>{i.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band" id="quality">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Neden Wanlian Fluid?</p>
          <h2>Güvenilir <em>Tedarik Ortağı</em></h2>
        </header>
        <div class="c68-cert-grid">
          {certifications.map((c) => (
            <div class="c68-cert c68-rv">
              <p class="c68-cert-name">{c.name}</p>
              <p class="c68-cert-code">{c.code}</p>
            </div>
          ))}
        </div>
        <p class="c68-scope">Listeleme ve onay kapsamı model bazında geçerlidir. Sertifika kopyaları ve listelenen modeller, siparişten önce teknik şartnamenize göre teyit edilir.</p>
        <div class="c68-chips">
          <a class="c68-chip c68-chip-link" href="/tr/certificates/">Sertifikalar &rarr;</a>
          <a class="c68-chip c68-chip-link" href="/tr/faq/">Sıkça Sorulan Sorular (SSS) &rarr;</a>
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="resources">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Teknik Kaynaklar</p>
          <h2>Seçim Kılavuzları ve Sistem Bilgileri</h2>
          <p class="c68-head-sub">Belirleme yapan alıcılar için yazıldı. Her rehber, bir modele karar vermeden önce standardı, sistem tipini ve ödünleşimleri ele alır.</p>
        </header>
        <div class="c68-guides">
          {resources.map((r) => (
            <a class="c68-guide c68-rv" href={r.href}>
              <span class="c68-guide-eyebrow">{r.eyebrow}</span>
              <span class="c68-guide-title">{r.title}</span>
              <span class="c68-guide-desc">{r.desc}</span>
              <span class="c68-guide-more">Kaynağı okuyun → <i aria-hidden="true">&rarr;</i></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band" id="projects">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Proje Örnekleri</p>
          <h2>Projelerimiz, <em>sahada</em></h2>
          <p class="c68-head-sub">Yangın pompa dairesinden fotoğraflar ve video — gerçek montaj çalışması, teslime hazır.</p>
        </header>
        <div class="c68-proj-grid">
          <figure class="c68-vid c68-vid-tall c68-rv">
            <video src={walkthroughClip.src} poster={walkthroughClip.poster} controls playsinline preload="none"></video>
            <figcaption><strong>{walkthroughClip.title}</strong></figcaption>
          </figure>
          <div class="c68-proj-cards">
            {projectPhotos.map((s) => (
              <figure class="c68-pcard c68-rv">
                <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
                <figcaption>{s.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
        <ul class="c68-scope-list">
