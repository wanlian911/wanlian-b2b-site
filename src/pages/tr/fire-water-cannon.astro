---
import Layout from '../../layouts/Layout.astro';
const products = [
 { slug: 'auto-tracking-jet-suppression-cannon-zdms', name: 'Otomatik Takipli Jet Söndürme Monitörü (ZDMS)', desc: 'IR/UV otomatik algılama, 360° dönüş, 40–65 m yarıçap', img: '/assets/06_extinguishing_cannons/cannon_p45.webp' },
 { slug: 'manual-fire-water-cannon-ps', name: 'Manuel Yangın Su Topu (PS Serisi)', desc: '20–200 L/s, 110 m’ye kadar jet mesafesi, su veya köpük', img: '/assets/products/manual-fire-water-cannon-ps.webp' },
 { slug: 'foam-fire-hydrant-cabinet-psg30', name: 'Köpüklü Yangın Hidrant Dolabı (PSG30)', desc: 'Kimyasal ve petrol yangınları için %3 AFFF köpük ünitesi', img: '/assets/06_extinguishing_cannons/cannon_p42.webp' },
 { slug: 'fire-hose-reel-jpso8-19', name: 'Yangın Hortum Makarası Aksesuar Seti (JPS0.8-19)', desc: '20–30 m düz hortum, döner bağlantı, hızlı müdahale', img: '/assets/products/fire-hose-reel-jpso8-19.jpg' },
 { slug: 'adjustable-pistol-grip-fire-nozzle', name: 'Ayarlanabilir Tabanca Kabzalı Yangın Lans', desc: 'Düz jet / sis püskürtme, el hatları için pirinç kabza', img: '/assets/products/adjustable-pistol-grip-fire-nozzle.jpg' }
];
const faq = [
 { question: 'Yangın su topunun etkili menzili nedir?', answer: 'Menzil model ve giriş basıncına bağlıdır. PS serisinde nominal debide genellikle 50–110 metre, ZDMS otomatik takipli seride 40–65 metre izleme yarıçapı elde edilir. Saha planınızı gönderin, uygun modeli önerelim.' },
 { question: 'Su topu uzaktan çalıştırılabilir mi?', answer: 'Evet. ZDMS IR/UV alev algılamayla otonom çalışır ve PC, mobil uygulama veya merkezi kumanda panosundan manuel uzaktan müdahaleyi destekler. Sabit monitörler manuel kol kumandalı da sunulur.' },
 { question: 'Hangi debiler mevcuttur?', answer: 'Standart modeller 5–200 L/s aralığındadır. ZDMS 5, 10, 20 ve 30 L/s; PS manuel seri ise 20–200 L/s seçenekleri sunar. Projeye özel debiler mühendislik çalışmasıyla belirlenebilir.' }
];
---
<Layout locale="tr" title="Yangın Su Topları ve Akıllı Yangın Monitörleri | Wanlian Fluid" description="Petrokimya tesisleri, terminaller ve depolar için yüksek debili, uzun menzilli sabit, uzaktan kumandalı ve otomatik takipli yangın su topları." type="product" productData={{ name: 'Yangın Su Topları', image: '/assets/06_extinguishing_cannons/cannon_p45.webp', description: 'Endüstriyel yangın koruması için 5–200 L/s debili ve 110 metreye kadar menzilli yangın su topları.' }} faq={faq} breadcrumbs={[{ name: 'Yangın Su Topları' }]}>
<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/tr/">Ana Sayfa</a><span>/</span><a href="/tr/products/">Ürünler</a><span>/</span><span>Yangın Su Topları</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Yangın Su Topu Sistemleri</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight">Yüksek Riskli Endüstriyel Ortamlar için Yangın Su Topu Sistemleri</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid; petrokimya tesisleri, LNG terminalleri, depolar ve havaalanları için yüksek debili yangın su topları üretir. Sabit manuel monitörlerden uzaktan kumandalı ve tam otonom otomatik takipli modellere kadar komple çözüm sunar.</p><div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">{['200 L/s’ye kadar Debi', '110 m’ye kadar Menzil', '360° Dönüş', 'IR/UV Otomatik Algılama'].map(b => <div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue">{b}</span></div>)}</div><h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">Yangın Su Topu Serisi</h2><div class="grid grid-cols-2 lg:grid-cols-3 gap-4">{products.map(p => <a href={`/tr/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red transition"><img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2"/><div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red">{p.name}</p><p class="text-[10px] text-gray-400 mt-1">{p.desc}</p></div></a>)}</div><h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">Temel Teknik Özellikler</h2><div class="overflow-x-auto rounded-xl border border-gray-200"><table class="min-w-full text-sm divide-y divide-gray-200"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left">Özellik</th><th class="px-4 py-3 text-left">Ayrıntı</th></tr></thead><tbody class="divide-y divide-gray-200"><tr><td class="px-4 py-3 font-bold">Nominal debi</td><td class="px-4 py-3">Modele göre 5–200 L/s; ZDMS özel olarak 150 L/s’ye kadar</td></tr><tr><td class="px-4 py-3 font-bold">Jet menzili</td><td class="px-4 py-3">Model ve giriş basıncına göre 50–110 m</td></tr><tr><td class="px-4 py-3 font-bold">Dönüş</td><td class="px-4 py-3">Yatay 360°, dikey -90° ila +70°</td></tr><tr><td class="px-4 py-3 font-bold">Kumanda</td><td class="px-4 py-3">Manuel / uzaktan / alev algılamalı otomatik</td></tr><tr><td class="px-4 py-3 font-bold">Opsiyon</td><td class="px-4 py-3">Patlamaya karşı korumalı Exde II BT4 Gb, köpük dozajlama</td></tr></tbody></table></div><h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">Uygulamalar</h2><p class="text-gray-700 leading-relaxed">Yangın su topları petrokimya proses alanlarını, petrol ve LNG tank sahalarını, yükleme terminallerini, büyük depoları, havaalanı hangarlarını ve trafo merkezlerini korur.</p><h2 class="text-2xl font-black text-gray-900 mt-12 mb-6">Sıkça Sorulan Sorular</h2><div class="space-y-4">{faq.map(item => <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5"><summary class="font-bold text-gray-800 cursor-pointer list-none">{item.question}</summary><p class="mt-3 text-gray-600 text-sm leading-relaxed">{item.answer}</p></details>)}</div><div class="mt-12 text-center bg-gradient-to-r from-brand-blue to-blue-800 px-6 py-10 rounded-2xl"><h2 class="text-2xl font-black text-white">Sahanız için yangın su topu mu arıyorsunuz?</h2><a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Merhaba, yangın su topu seçimi için yardım istiyorum.')}`} class="inline-block mt-6 px-8 py-4 bg-white text-brand-blue font-bold rounded-lg">WhatsApp ile görüşün</a></div></article></main>
</Layout>
