---
import Layout from '../../../layouts/Layout.astro';
const faq = [{ question: 'Eksiksiz satın alma süreci ne kadar sürer?', answer: 'Stoktaki modellerde şartname ve teklif birkaç gün, numune genellikle 1–3 hafta, üretim ise 15–30 gün sürer. OEM/ODM ürünleri ek süre gerektirebilir.' }, { question: 'Hangi belgeleri talep etmeliyim?', answer: 'Ticari fatura, çeki listesi, menşe şahadetnamesi, ürün bazlı test kayıtları, malzeme sertifikaları ve modele uygulanabilir standart sertifikalarını isteyin.' }];
const steps = [
 { n: '01', title: 'Şartnameyi hazırlayın', body: 'Standart, ölçüler, anma basıncı, malzemeler, miktarlar, varış noktası ve Incoterm bilgilerini belirleyin. Açık bir şartname farklılık riskini azaltır.', links: [{ label: 'Endüstriyel sözlük', href: '/tr/glossary/' }, { label: 'Standartlar kılavuzu', href: '/tr/guides/fire-hydrant-valve-standards-guide/' }] },
 { n: '02', title: 'Tedarikçiyi nitelendirin ve doğrulayın', body: 'Tüzel kişiliği, ISO 9001 sistemini, üretim kapasitesini, ihracat geçmişini ve sertifikaları düzenleyici kuruluşun portalında doğrulayın.', links: [{ label: 'B2B satın alma kontrol listesi', href: '/tr/guides/b2b-valve-sourcing-checklist/' }, { label: 'Çinli tedarikçiyi doğrulama', href: '/tr/guides/how-to-verify-chinese-valve-supplier/' }] },
 { n: '03', title: 'Ayrıntılı teklifleri isteyin ve karşılaştırın', body: 'Aynı model, standart, malzeme, miktar, Incoterm ve varış noktasını karşılaştırın. Yalnızca birim fiyatı değil, teslim edilmiş toplam maliyeti değerlendirin.', links: [{ label: 'Maliyet hesaplayıcı', href: '/tr/cost-calculator/' }] },
 { n: '04', title: 'Numune isteyin ve inceleyin', body: 'Her modelden bir numune isteyin. Seri plakasını, seri numarasını, malzemeyi ve hacimli siparişten önce basınç testini kontrol edin.', links: [{ label: 'Yangın hidrantı seçme kılavuzu', href: '/tr/guides/how-to-choose-a-fire-hydrant/' }] },
 { n: '05', title: 'Üretimi, kaliteyi ve belgeleri onaylayın', body: 'Son ödeme öncesinde üretim planı, ürün bazlı test kayıtları, ihracat ambalajı ve belgeleri talep edin.', links: [{ label: 'Wanlian Fluid — fabrika ve testler', href: '/tr/about/' }] },
 { n: '06', title: 'Lojistik ve satış sonrasını planlayın', body: 'Risk dağılımına göre EXW, FOB, CIF veya DDP seçin. Kabul, bakım ve yedek parçalar için sertifikaları ve kayıtları saklayın.', links: [{ label: 'Teklif isteyin', href: '/tr/contact/' }] }
];
---
<Layout title="Satın Alma Kılavuzu: Yangın Vanaları ve Hidrantlar" description="Yangın vanaları, hidrantlar ve ekipmanları satın almak için şartname, doğrulama, numune, kalite ve belge adımları." type="website" locale="tr" faq={faq} breadcrumbs={[{ name: 'Kaynaklar' }, { name: 'Satın alma kılavuzu' }]}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/tr/">Ana sayfa</a><span>/</span><span class="text-gray-600">Satın alma kılavuzu</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">B2B satın alma merkezi</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Yangın vanaları, hidrantlar ve ekipmanlar nasıl satın alınır?</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Çinli bir üreticiden satın alma için yazılı şartnameden satış sonrasına uzanan altı adımlı yol haritası.</p><div class="bg-blue-50 border border-blue-100 rounded-xl p-5 my-6"><p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-blue">Neden sıralı ilerlemeli:</strong> Temel riskler şartname, doğrulama, numune ve belgeler arasındaki geçişlerde ortaya çıkar. Aşağıdaki liste ödeme öncesinde bunları belirlemenize yardımcı olur.</p></div>{steps.map(s => <section class="mt-10"><h2 class="text-2xl font-black text-gray-900 mb-3 tracking-tight flex items-center gap-3"><span class="text-brand-red text-2xl tabular-nums">{s.n}</span>{s.title}</h2><p class="text-gray-700 leading-relaxed mb-3">{s.body}</p><div class="flex flex-wrap gap-2">{s.links.map(l => <a href={l.href} class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 text-gray-700 text-xs font-bold rounded-full">{l.label} →</a>)}</div></section>)}<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6">Sık sorulan sorular</h2><div class="space-y-4">{faq.map(item => <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>)}</div><div class="mt-12 text-center"><a href="/tr/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-lg">Teklif isteyin</a></div></article></main>
</Layout>
