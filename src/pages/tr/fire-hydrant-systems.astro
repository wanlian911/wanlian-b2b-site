---
import Layout from '../../layouts/Layout.astro';
const products = [
  { slug: 'indoor-fire-hydrant-head-sn65', name: 'İç Saha Yangın Hidrant Vanası SN65', desc: 'Kolon tesisatları için PN16 sfero döküm iç saha hidrantı', img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg' },
  { slug: 'overground-fire-hydrant-ss100', name: 'Yer Üstü Donmaya Karşı Korumalı Hidrant (SS100/65)', desc: 'Soğuk iklim belediye şebekeleri için kuru gövdeli tasarım', img: '/assets/products/overground-fire-hydrant-ss100.webp' },
  { slug: 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100', name: 'Darbeye Dayanıklı Basınç Regüleli Hidrant (SSFT100/65)', desc: 'Trafik ve sanayi sahaları için kopabilir gövde ve basınç regülasyonu', img: '/assets/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100.webp' },
  { slug: 'iot-smart-ground-fire-hydrant-ss100zn', name: 'IoT Akıllı Yer Üstü Yangın Hidrantı (SS100/65-1.6ZN)', desc: 'Akıllı şebekeler için gerçek zamanlı basınç, eğim ve su hırsızlığı izleme', img: '/assets/products/overground-fire-hydrant-ss100.webp' },
  { slug: 'fire-hydrant-hose-coupling-adapter-hs', name: 'Alüminyum Hortum Kaplin Adaptörü (HS Serisi)', desc: 'Hidrant-hortum bağlantısı için BS336/NIST/KWS uyumlu kaplinler', img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg' }
];
const faq = [
 { question: 'İç saha ve dış saha yangın hidrantları arasındaki fark nedir?', answer: 'İç saha hidrantları bina kolon tesisatlarına bağlanır ve katlardaki hortum istasyonlarını besler. Yer üstü hidrantlar belediye veya sanayi ana hatlarından su alarak itfaiye araçlarını ve dış söndürmeyi besler.' },
 { question: 'İhracat hidrantları için hangi çıkış standartları mevcuttur?', answer: 'BS336, NIST, KWS ve esnek flanş seçenekleri sunulur. SS100/65 ve SSFT100/65 hidrantlar, hedef pazarınızın bağlantı standardına göre üretilebilir; uyumlu kaplin ve adaptörler aynı konteynerde sevk edilebilir.' },
 { question: 'Soğuk iklim için hangi hidrant seçilmelidir?', answer: 'SS100 yer üstü hidrant, donmayı ve gövde hasarını önleyen otomatik kuru gövde drenajına sahiptir. Trafiğe açık alanlar için SSFT100 darbeye dayanıklı model tercih edilir.' }
];
---
<Layout locale="tr" title="Yangın Hidrant Sistemleri ve Vanaları | Wanlian Fluid" description="SN65 iç saha, SS100 yer üstü, SSFT100 darbeye dayanıklı ve SS100ZN IoT akıllı yangın hidrantları. PN16, ihracat bağlantılarıyla fabrikadan doğrudan." type="product" productData={{ name: 'Yangın Hidrant Sistemleri', image: '/assets/products/overground-fire-hydrant-ss100.webp', description: 'Belediye şebekeleri, sanayi sahaları ve bina kolon tesisatları için iç ve dış saha yangın hidrant sistemleri.' }} faq={faq} breadcrumbs={[{ name: 'Yangın Hidrant Sistemleri' }]}>
 <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/tr/">Ana Sayfa</a><span>/</span><a href="/tr/products/">Ürünler</a><span>/</span><span>Yangın Hidrant Sistemleri</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Komple Yangın Hidrant Serisi — Tesis İçinde Üretim</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight">Belediye ve Sanayi Şebekeleri için Komple Yangın Hidrant Sistemleri</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid; iç saha SN65 hidrant vanaları, yer üstü SS100 hidrantlar, SSFT100 darbeye dayanıklı hidrantlar ve SS100ZN IoT akıllı hidrantlar üretir. BS336, NIST ve KWS bağlantıları ile uyumlu kaplinler, hidrant şebekenizin tamamı için kendi üretim hatlarımızda hazırlanır.</p><div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">{['PN16 / 2,4 MPa Test', 'BS336 / NIST / KWS', 'Donmaya Karşı Kuru Gövde', 'IoT / SCADA Uyumlu'].map(b => <div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue">{b}</span></div>)}</div><h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">Yangın Hidrant Sistemi Bileşenleri</h2><div class="grid grid-cols-2 lg:grid-cols-3 gap-4">{products.map(p => <a href={`/tr/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red transition"><img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2"/><div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red">{p.name}</p><p class="text-[10px] text-gray-400 mt-1">{p.desc}</p></div></a>)}</div><h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">Temel Teknik Özellikler</h2><div class="overflow-x-auto rounded-xl border border-gray-200"><table class="min-w-full text-sm divide-y divide-gray-200"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left">Model</th><th class="px-4 py-3 text-left">Tip</th><th class="px-4 py-3 text-left">Temel özellik</th><th class="px-4 py-3 text-left">Basınç</th></tr></thead><tbody class="divide-y divide-gray-200"><tr><td class="px-4 py-3 font-bold">SN65</td><td class="px-4 py-3">İç saha hidrantı</td><td class="px-4 py-3">Yivli/flanşlı giriş, duvar tipi dolap</td><td class="px-4 py-3">PN16</td></tr><tr><td class="px-4 py-3 font-bold">SS100/65</td><td class="px-4 py-3">Yer üstü hidrant</td><td class="px-4 py-3">Otomatik donma önleyici kuru gövde drenajı</td><td class="px-4 py-3">PN16</td></tr><tr><td class="px-4 py-3 font-bold">SSFT100/65</td><td class="px-4 py-3">Darbeye dayanıklı</td><td class="px-4 py-3">Kopabilir gövde, basınç regülasyonu, kendinden drenaj</td><td class="px-4 py-3">PN16</td></tr><tr><td class="px-4 py-3 font-bold">SS100ZN</td><td class="px-4 py-3">IoT akıllı hidrant</td><td class="px-4 py-3">NB-IoT/4G, basınç/eğim/kaçak izleme</td><td class="px-4 py-3">GB4452-2011</td></tr></tbody></table></div><h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">Uygulamalar</h2><ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2"><li>Belediye su temini ve yangın koruma ana hatları</li><li>Sanayi sahaları, tank çiftlikleri ve depolar</li><li>Bina kolon ve hortum sistemleri</li><li>Uzaktan izleme gerektiren akıllı şehir şebekeleri</li><li>Donmaya karşı koruma gereken soğuk iklim tesisleri</li></ul><h2 class="text-2xl font-black text-gray-900 mt-12 mb-6">Sıkça Sorulan Sorular</h2><div class="space-y-4">{faq.map(item => <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5"><summary class="font-bold text-gray-800 cursor-pointer list-none">{item.question}</summary><p class="mt-3 text-gray-600 text-sm leading-relaxed">{item.answer}</p></details>)}</div><div class="mt-12 text-center bg-gradient-to-r from-brand-blue to-blue-800 px-6 py-10 rounded-2xl"><h2 class="text-2xl font-black text-white">Projeniz için hidrant ağı mı belirliyorsunuz?</h2><a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Merhaba, yangın hidrant sistemi seçimi için yardım istiyorum.')}`} class="inline-block mt-6 px-8 py-4 bg-white text-brand-blue font-bold rounded-lg">WhatsApp ile görüşün</a></div></article></main>
</Layout>
