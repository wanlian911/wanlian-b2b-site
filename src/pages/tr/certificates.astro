---
import Layout from '../../layouts/Layout.astro';
const certifications = [
  { name: 'ISO 9001:2015', code: 'KENDİ ADIMIZA', desc: 'Wanlian Fluid Equipment Co., Ltd. kalite yönetim sisteminin kendi adımıza belgelendirilmiş standardı.', scope: 'Vana, yangın ekipmanı ve akışkan kontrol ürünlerinin tasarım, üretim ve satış süreçleri.', products: 'Tarafımızca tedarik edilen tüm vanalar ve yangın ekipmanları', verify: 'Sertifika numarası ve düzenleyen kuruluş, talep üzerine doğrulama için paylaşılır.' },
  { name: 'Parti deney kayıtları', code: 'KENDİ ADIMIZA', desc: 'Her teslim edilen parti için belgelenen gövde ve sızdırmazlık deneyleri.', scope: 'Her ünite ambalajlanmadan önce şartnamenizde belirtilen norma göre muayene edilir; deney kayıtları paketleme listesindeki seri numaralarıyla eşleştirilir.', products: 'Tarafımızca tedarik edilen tüm vanalar ve yangın ekipmanları', verify: 'Deney kayıtları ihracat belgeleriyle sunulur; SGS, BV veya Intertek gözetimli muayene talep üzerine yapılabilir.' },
  { name: 'EN 12266-1 / GB 5135', code: 'TASARIM VE TEST TEMELİ', desc: 'Projenizin şartnamesinde üçüncü taraf listesi bulunmadığında kullanılan üretim ve test temeli.', scope: 'Vanalar EN 12266-1 veya GB/T 13927 uyarınca; sprinkler bileşenleri, hidrantlar ve alarm vanaları GB 5135 serisi, GB 4452 ve GB 50974 uyarınca test edilir.', products: 'Sprinkler bileşenleri, yangın hidrantları, alarm vanaları ve genel vanalar', verify: 'Bu bir tasarım ve test temelidir, sertifika değildir; fabrika deney raporları teslimatla sunulur.' },
  { name: 'UL 262 / UL 1091', code: 'ÜRETİCİ FABRİKANIN ÜZERİNE KAYITLI', desc: 'Kuzey Amerika yangın güvenliği için sürgülü vanalar ve çekvalflerde kullanılan standartlar.', scope: 'UL listesi, listelenen modeli üreten üretici fabrikanın üzerine kayıtlıdır. Wanlian UL listelerine sahip değildir ve bunları kendi adına beyan etmez.', products: 'Gerektiğinde liste sahibi üretici fabrikadan tedarik edilen listeli modeller', verify: 'UL talebinde üretim öncesi yasal liste sahibi adı, model, ölçü ve sertifika kopyası doğrulanır.' },
  { name: 'FM Class 1120 / 1130', code: 'ÜRETİCİ FABRİKANIN ÜZERİNE KAYITLI', desc: 'OS&Y ve NRS tipi yangın kontrol vanaları için üretici fabrika onay temeli.', scope: 'FM onayları üretici ve ürün hattı bazında düzenlenir. Bir FM onayını Wanlian belgesi gibi sunmayız.', products: 'Talep üzerine listeli üretici fabrikanın OS&Y sürgülü vanaları ve yangın kontrol vanaları', verify: 'Siparişten önce onay sahibi, onaylı model ve sertifika kopyası tarafınıza sunulur.' },
  { name: 'LPCB RedBook', code: 'ÜRETİCİ FABRİKANIN ÜZERİNE KAYITLI', desc: 'Yangın güvenliği ürünleri ve hizmetleri için RedBook kaydı.', scope: 'RedBook kayıtları sertifikalı üretici fabrika için yayımlanır ve orada belirtilen ürünler için geçerlidir.', products: 'Tedarikçi üretici fabrikanın RedBook kaydında belirtilen listeli yangın güvenliği ürünleri', verify: 'Hedef ürün için RedBook kaydı ve sertifikalı üretici fabrika siparişten önce bildirilir.' }
];
const faq = [
  { question: 'Wanlian Fluid ISO 9001 sertifikasına sahip mi?', answer: 'Evet — üretim; vana, yangın ekipmanı ve akışkan kontrol ürünlerinin tasarım, üretim ve satışını kapsayan ISO 9001:2015 kalite sistemi altında yürütülür. Sertifika numarası ve düzenleyen kuruluş doğrulama için paylaşılır.' },
  { question: 'Yangın vanalarınız UL veya FM listeli mi?', answer: "Hayır — bu listeler, onları elinde tutan fabrikalara aittir, Wanlian'a değil. UL 262, UL 1091, FM Class 1120 veya FM Class 1130 talebiniz varsa liste sahibi üretici fabrikayı, modeli ve sertifika kopyasını üretim öncesi doğrularız." },
  { question: 'Wanlian UL ve FM belgelerini kendi adına beyan ediyor mu?', answer: 'Hayır. Wanlian UL listelerine sahip değildir ve bunları kendi adına beyan etmez. Bir FM onayını Wanlian belgesi gibi sunmayız; ilgili üretici fabrikanın kayıt bilgilerini ve model kapsamını açıklarız.' },
  { question: 'Sertifikaların gerçekliğini nasıl doğrularım?', answer: 'Sertifika sahibinin yasal adını ve tam model kapsamını paylaşırız; ardından ilgili düzenleyenin resmî portalında kendiniz kontrol edebilirsiniz. Üretici fabrika, model, ölçü ve sertifika kopyasını sipariş belgeleriyle karşılaştırın. İçeriği açıkça karşılaştırın.' },
  { question: 'Teslimatla birlikte deney raporları sunuyor musunuz?', answer: 'Evet — her üniteye eşleştirilen gövde ve sızdırmazlık deneyleri ile malzeme ve norm belgeleri ihracat dokümanlarıyla sunulur; ek muayene ve deney kayıtları talep üzerine hazırlanabilir.' }
];
---
<Layout locale="tr" title="Teknik Belgeler ve Sertifikalar | Wanlian Fluid" description="Wanlian Fluid vana ve yangın ekipmanları için teknik belgeler, test raporları, malzeme seçenekleri ve ihracat desteği." faq={faq} breadcrumbs={[{ name: 'Sertifikalar' }]}>
<section class="py-24 bg-gray-900 text-white"><div class="max-w-7xl mx-auto px-4"><h1 class="text-5xl font-black mb-8">Teknik <span class="text-brand-red">belgeler.</span></h1><p class="text-xl text-gray-400 max-w-2xl">Proje gereksinimlerinizi paylaşın; mevcut ürün bilgilerini, teknik şartnameleri ve değerlendirme belgelerini sunalım.</p></div></section>
<section class="py-24 bg-white"><div class="max-w-7xl mx-auto px-4"><div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">{certifications.map(cert => <div class="p-8 bg-gray-50 rounded-2xl border"><h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3><p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p><p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p><div class="space-y-3 text-sm text-gray-600"><p><b class="text-gray-900">Kapsam: </b>{cert.scope}</p><p><b class="text-gray-900">Kapsanan ürünler: </b>{cert.products}</p><p class="text-xs border-t pt-3">{cert.verify}</p></div></div>)}</div><div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center"><h2 class="text-3xl font-black">Sertifika veya teknik föy kopyasına mı ihtiyacınız var?</h2><p class="text-gray-400 max-w-2xl mx-auto mt-5">Talep üzerine sertifikalar, hidrostatik test raporları, teknik föyler, CAD çizimleri ve montaj kılavuzları sunulur.</p><a href="/tr/contact/?product=Teknik%20belge%20ve%20sertifika%20talebi" class="inline-block mt-6 px-10 py-5 bg-brand-red rounded-xl font-black">Sertifika ve Belge İsteyin</a></div></div></section>
<section class="py-24 bg-gray-50 border-t"><div class="max-w-4xl mx-auto px-4"><h2 class="text-3xl font-black text-center mb-12">Sık Sorulan Sorular</h2>{faq.map(item => <details class="group bg-white rounded-xl border p-6 mb-4"><summary class="font-bold cursor-pointer">{item.question}</summary><p class="mt-3 text-gray-600">{item.answer}</p></details>)}</div></section>
</Layout>
