---
import Layout from '../../layouts/Layout.astro';
const certifications = [
 { name: 'UL Listeli', code: 'UL 262 / UL 1091', desc: 'Yangın güvenliği hizmetindeki sürgülü vanalar ve çekvalfler için standart.', scope: 'Kuzey Amerika pazarına sunulan yangın güvenliği sürgülü vanaları ve çekvalfler.', products: 'Elastomer yataklı sürgülü vanalar, çekvalfler', verify: 'Sertifika kapsamı, sertifikada listelenen belirli modeller için geçerlidir. Model kapsamını teyit etmek için bize ulaşın.' },
 { name: 'FM Onaylı', code: 'Class 1120/1130', desc: 'OS&Y ve NRS tipi yangın servis kontrol vanaları için onay standardı.', scope: 'FM Class 1120/1130 kapsamında onaylı yangın servis kontrol vanaları.', products: 'OS&Y sürgülü vanalar ve yangın servis kontrol vanaları', verify: 'Onay, FM belgesinde listelenen modelleri kapsar. Proje dokümantasyonu için kopya talep edebilirsiniz.' },
 { name: 'CE İşareti', code: 'EN 12266-1', desc: 'Avrupa sağlık, güvenlik ve çevre koruma gerekliliklerine uygunluk.', scope: 'Uygulanabilir Avrupa direktiflerine ve EN 12266-1 test standardına göre test edilen basınçlı ekipman.', products: 'AB projelerine sunulan vanalar', verify: 'CE işareti ilgili direktiflerin kapsamı içinde uygulanır; projeniz için direktif ve kategori teyit edilmelidir.' },
 { name: 'ISO 9001:2015', code: 'Kalite Yönetimi', desc: 'Üretimde kalite yönetim sistemleri için uluslararası standart.', scope: 'Vanaların, yangın ekipmanlarının ve akışkan kontrol ürünlerinin tasarım, üretim ve satış süreçleri.', products: 'Tüm üretim hatları', verify: 'Akredite belgelendirme kuruluşu tarafından düzenlenen sistem sertifikası talep üzerine sunulur.' },
 { name: 'LPCB Sertifikası', code: 'Kayıp Önleme', desc: 'Yangın güvenliği ürün ve hizmetleri için RedBook listesi.', scope: 'Birleşik Krallık ve Commonwealth pazarları için LPCB RedBook kapsamında listelenen ürünler.', products: 'Listelenmiş yangın güvenliği ürünleri', verify: 'RedBook kaydı, belirtilen ürün ve standartları kapsar; ürün giriş numarası doğrulanmalıdır.' },
 { name: 'GB Standardı', code: 'GB 5135 / GB 4452', desc: 'Çin Ulusal Standartlarına göre yangın ekipmanı uygunluğu.', scope: 'Uygulanabilir GB 5135, GB 4452 ve GB 50974 serilerine göre üretilen ve test edilen ürünler.', products: 'Sprinkler, hidrant ve alarm vana bileşenleri', verify: 'Uygunluk, her model için geçerli GB standardına göre teyit edilir.' }
];
const faq = [{ question: 'Wanlian Fluid ISO 9001 sertifikasına sahip mi?', answer: 'Evet. Üretim; vana, yangın ekipmanı ve akışkan kontrol ürünlerinin tasarım, üretim ve satışını kapsayan ISO 9001:2015 kalite sistemi altında yürütülür.' }, { question: 'Yangın vanalarınız UL veya FM listeli mi?', answer: 'Belirli sürgülü ve çekvalf modelleri UL 262 / UL 1091 listelerine, belirli yangın kontrol vanaları FM Class 1120/1130 onayına sahiptir. Kapsam model bazında teyit edilir.' }, { question: 'Sertifikaların gerçekliğini nasıl doğrularım?', answer: 'Sertifika numarasını düzenleyen kuruluşun resmî portalında kontrol edin; model ve fabrika bilgileriyle karşılaştırın. İlgili kopyaları sipariş dokümanlarıyla sunabiliriz.' }];
---
<Layout locale="tr" title="Teknik Belgeler ve Sertifikalar | Wanlian Fluid" description="Wanlian Fluid vana ve yangın ekipmanları için teknik belgeler, test raporları, malzeme seçenekleri ve ihracat desteği." faq={faq} breadcrumbs={[{ name: 'Sertifikalar' }]}>
<section class="py-24 bg-gray-900 text-white"><div class="max-w-7xl mx-auto px-4"><h1 class="text-5xl font-black mb-8">Teknik <span class="text-brand-red">belgeler.</span></h1><p class="text-xl text-gray-400 max-w-2xl">Proje gereksinimlerinizi paylaşın; mevcut ürün bilgilerini, teknik şartnameleri ve değerlendirme belgelerini sunalım.</p></div></section>
<section class="py-24 bg-white"><div class="max-w-7xl mx-auto px-4"><div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">{certifications.map(cert => <div class="p-8 bg-gray-50 rounded-2xl border"><h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3><p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p><p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p><div class="space-y-3 text-sm text-gray-600"><p><b class="text-gray-900">Kapsam: </b>{cert.scope}</p><p><b class="text-gray-900">Kapsanan ürünler: </b>{cert.products}</p><p class="text-xs border-t pt-3">{cert.verify}</p></div></div>)}</div><div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center"><h2 class="text-3xl font-black">Sertifika veya teknik föy kopyasına mı ihtiyacınız var?</h2><p class="text-gray-400 max-w-2xl mx-auto mt-5">Talep üzerine sertifikalar, hidrostatik test raporları, teknik föyler, CAD çizimleri ve montaj kılavuzları sunulur.</p><a href="/tr/contact/?product=Teknik%20belge%20ve%20sertifika%20talebi" class="inline-block mt-6 px-10 py-5 bg-brand-red rounded-xl font-black">Sertifika ve Belge İsteyin</a></div></div></section>
<section class="py-24 bg-gray-50 border-t"><div class="max-w-4xl mx-auto px-4"><h2 class="text-3xl font-black text-center mb-12">Sık Sorulan Sorular</h2>{faq.map(item => <details class="group bg-white rounded-xl border p-6 mb-4"><summary class="font-bold cursor-pointer">{item.question}</summary><p class="mt-3 text-gray-600">{item.answer}</p></details>)}</div></section>
</Layout>
