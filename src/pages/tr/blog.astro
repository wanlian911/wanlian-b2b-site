---
import Layout from '../../layouts/Layout.astro';
import { guidesTr } from '../../utils/guides.tr';
import { tagsTr } from '../../utils/tags.tr';

const solutions = [
  { title: 'Yangın Hidrantları & Pompa Bağlantıları', description: 'Belediye, endüstriyel tesis ve yangın koruma projeleri için yer üstü, yer altı yangın hidrantları.', href: '/tr/fire-hydrant-systems/' },
  { title: 'Geri Akış Önleme ve Hidrolik Kontrol', description: 'İçme suyu ve hidrolik güvenlik için geri akış önleyiciler, basınç düşürücü kontrol vanaları ve kontrol çözümleri.', href: '/tr/backflow-prevention/' },
  { title: 'Yangın Sprinkleri ve Alarm Vanaları', description: 'Islak alarm vana istasyonları, baskın (deluge) vanaları, ön tepkili sistemler ve akış anahtarları.', href: '/tr/fire-sprinkler-systems/' },
  { title: 'Yangın Monitörleri & Su Topları', description: 'Rafineri, depo, havaalanı ve yüksek riskli alanlar için manuel ve otomatik yangın monitörleri.', href: '/tr/fire-water-cannon/' },
  { title: 'Yangın Vanaları ve UL Sistemleri', description: 'Yangın koruma vanaları, sprinkler sistemleri ve teknik proje desteği.', href: '/tr/ul-fire-valves/' },
  { title: 'Uygulama Çözümleri', description: 'Belediye suyu, HVAC, sulama, petrol ve gaz ile endüstriyel boru hatları için çözümler.', href: '/tr/applications/' }
];
---
<Layout title="Blog ve Teknik Kılavuzlar | Wanlian Fluid" description="Yangın vanaları, hidrantlar ve akışkan kontrolü hakkında teknik B2B tedarik kılavuzları." locale="tr">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4"><span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Blog ve kılavuzlar</span><h1 class="text-4xl font-black text-gray-900 tracking-tight">Tedarik ve endüstriyel bilgi kılavuzları</h1><p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">Yangın koruma ve akışkan kontrol projeleri için uygulamalı mühendislik ve satın alma bilgileri.</p></div>
    {guidesTr.length > 0 && <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">{guidesTr.map(article => <a href={article.href} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition p-8 flex flex-col"><div class="flex items-center gap-3 mb-4"><span class="px-2.5 py-1 bg-brand-blue/10 text-brand-blue text-[11px] font-black rounded-full uppercase tracking-wider">{article.category}</span><span class="text-xs text-gray-400">{article.date} · {article.readTime}</span></div><h2 class="text-lg font-black text-gray-900 group-hover:text-brand-blue transition leading-snug mb-3">{article.title}</h2><p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p><div class="flex flex-wrap gap-2 mt-4">{article.tags.map(tag => <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">#{tagsTr[tag]?.name ?? tag.replace(/-/g, ' ')}</span>)}</div><span class="mt-6 inline-flex items-center text-brand-red font-bold text-sm">Kılavuzu okuyun →</span></a>)}</div>}
    <div class="mt-16 mb-8 flex items-center gap-4"><h2 class="text-2xl font-black text-gray-900 tracking-tight">Ürün çözümleri</h2><div class="flex-1 h-px bg-gray-200"></div></div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">{solutions.map(article => <a href={article.href} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition p-8 flex flex-col"><span class="px-2.5 py-1 bg-brand-red/10 text-brand-red text-[11px] font-black rounded-full uppercase tracking-wider w-fit mb-4">Çözüm</span><h2 class="text-lg font-black text-gray-900 group-hover:text-brand-red transition leading-snug mb-3">{article.title}</h2><p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p><span class="mt-6 inline-flex items-center text-brand-blue font-bold text-sm">Çözümü görüntüleyin →</span></a>)}</div>
    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4"><h2 class="text-2xl font-black">Teknik danışmanlığa mı ihtiyacınız var?</h2><p class="text-gray-400 max-w-xl mx-auto">Mühendislerimiz projeniz için uygun vanaları ve ekipmanları seçmenize yardımcı olur.</p><a href="/tr/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-xl">Mühendisle görüşün</a></div>
  </main>
</Layout>
