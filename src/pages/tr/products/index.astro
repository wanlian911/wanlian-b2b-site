---
import Layout from '../../../layouts/Layout.astro';
import { productsTr } from '../../../utils/products.tr';

const categories = ['Tümü', ...new Set(productsTr.map(p => p.category))];
const faqs = [
  { question: 'Bu sayfadaki ürün yelpazesi komple kataloğunuz mudur?', answer: 'Bu sayfa vana, hidrant, sprinkler, hortum makarası, söndürücü ve su topu kategorilerinde 43’ten fazla stoklu modeli listeler. İhtiyacınız olan model, ölçü veya malzeme görünmüyorsa talebinizi gönderin; mühendislerimiz uygunluğu ve alternatifleri doğrulasın.' },
  { question: 'Vana ve yangın ekipmanları için minimum sipariş miktarı nedir?', answer: 'Stok ölçülerinde standart minimum sipariş miktarı genellikle model başına 20 adettir. Üretim süresi miktar ve özelleştirmeye bağlı olarak 15–30 gündür; sevkiyat öncesi test için numune siparişleri kabul edilir.' },
  { question: 'Ürünler ihracat standartlarına ve bağlantılarına göre özelleştirilebilir mi?', answer: 'Evet. Uygun modeller GB, ANSI, DIN, JIS, BS veya EN spesifikasyonlarına göre; flanşlı, yivli, wafer veya dişli bağlantılarla üretilebilir. Malzeme, kaplama ve sertifikalar proje şartlarınıza göre eşleştirilebilir.' },
  { question: 'Teklif nasıl istenir?', answer: 'İletişim formuna model, ölçü, basınç sınıfı, bağlantı tipi, miktar ve varış noktasını yazın. Satış ve mühendislik ekibimiz 12 saat içinde teknik özellik, fiyat ve teslim süresiyle yanıt verir.' }
];
const itemCatalog = [...productsTr].sort((a, b) => a.slug.localeCompare(b.slug)).map(p => ({ name: p.name, url: `https://wanlian911.com/tr/products/${p.slug}/` }));
const itemListJsonLd = { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Wanlian Fluid Türkçe Ürün Kataloğu', description: 'Wanlian Fluid tarafından üretilen endüstriyel vana ve yangın koruma ekipmanları kataloğu.', itemListElement: itemCatalog.map((item, i) => ({ '@type': 'ListItem', position: i + 1, ...item })) };
---
<Layout locale="tr" title="Ürün Kataloğu | Endüstriyel Vanalar ve Yangın Ekipmanları" description="Wanlian Fluid B2B ürün kataloğunu inceleyin: endüstriyel vanalar, yangın hidrantları, sprinkler, hortum makaraları ve hidrolik vanalar." faq={faqs}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 mb-20">
    <div class="text-center mb-8 space-y-3"><span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Ürün Merkezi</span><h1 class="text-4xl font-black text-gray-900 tracking-tight">Premium Akışkan Sistemleri Kataloğumuz</h1><p class="text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">Endüstriyel şebekelerde güvenilirlik, dayanıklılık ve emniyet için tasarlanmış yüksek performanslı bileşenler.</p></div>
    <div class="flex flex-wrap justify-center items-center gap-2 mb-6"><span class="text-[11px] font-black uppercase tracking-widest text-gray-400 mr-1">Sisteme göre inceleyin:</span><a href="/tr/fire-hydrant-systems/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600">Yangın Hidrant Sistemleri</a><a href="/tr/fire-sprinkler-systems/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600">Yangın Sprinkler Sistemleri</a><a href="/tr/fire-water-cannon/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600">Yangın Su Topları</a><a href="/tr/backflow-prevention/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600">Geri Akış Önleme</a><a href="/tr/ul-fire-valves/" class="px-4 py-1.5 rounded-full text-xs font-bold border border-gray-200 bg-white text-gray-600">UL Yangın Vanaları</a></div>
    <div class="flex flex-wrap justify-center items-center gap-2 mb-10" id="filter-container"><span class="text-[11px] font-black uppercase tracking-widest text-gray-400 mr-1">Kategoriye göre filtrele:</span>{categories.map(category => <button data-category={category} class="px-5 py-2.5 rounded-lg text-sm font-semibold border border-gray-200 text-gray-600 bg-white filter-btn">{category}</button>)}</div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="products-grid">{productsTr.map(product => <div data-product-category={product.category} class="group bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col product-card"><div class="aspect-square relative overflow-hidden bg-white"><img src={product.image} alt={product.name} loading="lazy" class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform"/><span class="absolute top-3 left-3 px-2.5 py-1 text-[10px] font-bold tracking-widest bg-gray-900/90 text-white rounded-md uppercase">{product.category}</span></div><div class="p-6 flex-grow flex flex-col space-y-3"><h2 class="text-lg font-bold text-gray-900 line-clamp-2">{product.name}</h2><p class="text-gray-500 text-xs line-clamp-3 leading-relaxed flex-grow">{product.description}</p><div class="pt-6 border-t border-gray-100 flex items-center justify-between gap-4"><a href={`/tr/products/${product.slug}/`} class="text-blue-600 text-sm font-bold">Teknik Özellikler</a><a href={`/tr/contact/?product=${encodeURIComponent(product.name)}`} class="px-4 py-2 bg-blue-600 text-white text-xs font-bold rounded-lg">Teklif İste</a></div></div></div>)}</div>
    <section class="mt-24 max-w-4xl mx-auto"><h2 class="text-3xl font-black text-gray-900 mb-8 text-center">Ürün Kataloğu SSS</h2><div class="space-y-4">{faqs.map(faq => <details class="group bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden"><summary class="flex items-center justify-between cursor-pointer px-6 py-5 font-bold text-gray-900 list-none"><span>{faq.question}</span><span>＋</span></summary><div class="px-6 pb-6 text-gray-600 leading-relaxed">{faq.answer}</div></details>)}</div></section>
  </main><script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} /><script is:inline>document.addEventListener('DOMContentLoaded',()=>{const b=document.querySelectorAll('.filter-btn'),c=document.querySelectorAll('.product-card');const f=x=>{b.forEach(i=>i.classList.toggle('active',i.dataset.category===x));c.forEach(i=>i.style.display=x==='Tümü'||i.dataset.productCategory===x?'flex':'none')};f('Tümü');b.forEach(i=>i.addEventListener('click',()=>f(i.dataset.category)))})</script>
</Layout>
