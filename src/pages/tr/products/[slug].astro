---
import Layout from '../../../layouts/Layout.astro';
import { productsTrBySlug, productsTr } from '../../../utils/products.tr';

export async function getStaticPaths() {
  return Object.values(productsTrBySlug).map(product => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
const relatedProducts = productsTr.filter(p => p.category === product.category && p.slug !== product.slug).slice(0, 4);
const faqs = product.faqs ?? [
  { question: 'Bu ürün hangi uygulamalar için uygundur?', answer: 'Ürün; teknik özellikleri doğrultusunda ilgili su temini, yangın koruma ve endüstriyel boru hattı uygulamalarında kullanılabilir. Proje standardı, akışkan, basınç ve sıcaklık bilgilerinizi paylaşarak mühendislerimizden doğrulama isteyin.' },
  { question: 'Ürün sevkiyat öncesinde test edilir mi?', answer: 'Evet. Uygulanabilir standarda göre gövde, yatak, basınç veya işlev testleri gerçekleştirilir. Talep üzerine test raporları ve üçüncü taraf denetimi düzenlenebilir.' },
  { question: 'Teklif ve teknik dokümantasyon nasıl alınır?', answer: 'İletişim formunda model, ölçü, basınç sınıfı, bağlantı tipi, miktar ve teslim noktasını belirtin. Teknik föy, çizimler, test raporları ve fiyat bilgisiyle yanıt veririz.' }
];
const catAnchor = encodeURIComponent(product.category);
---
<Layout locale="tr" title={product.seoTitle} description={product.seoDescription} productData={product} type="product" faq={faqs} breadcrumbs={[{ name: 'Ürünler', href: '/tr/products/' }, { name: product.category, href: `/tr/products/#category=${catAnchor}` }, { name: product.name }]}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 mb-20">
    <nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-8 flex gap-2"><a href="/tr/" class="hover:text-blue-600">Ana Sayfa</a><span>/</span><a href="/tr/products/" class="hover:text-blue-600">Ürünler</a><span>/</span><a href={`/tr/products/#category=${catAnchor}`} class="hover:text-blue-600">{product.category}</a><span>/</span><span class="text-gray-600">{product.name}</span></nav>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12"><div class="relative overflow-hidden bg-white p-4 rounded-2xl shadow-sm border border-gray-100"><img src={product.image} alt={product.name} class="w-full h-auto rounded-xl object-contain aspect-square"/><span aria-hidden="true" class="pointer-events-none select-none absolute inset-0 flex items-center justify-center overflow-hidden"><span class="text-7xl font-black tracking-[0.3em] text-brand-blue/[0.06] -rotate-[24deg] whitespace-nowrap">WANLIAN FLUID</span></span></div>
      <div class="space-y-6"><div><span class="text-blue-600 font-semibold uppercase tracking-wider text-sm">{product.category}</span><h1 class="text-4xl font-bold text-gray-900 mt-2">{product.name}</h1></div><p class="text-lg text-gray-600 leading-relaxed">{product.description}</p><div class="space-y-4"><h2 class="text-xl font-bold border-b pb-2">Temel Özellikler</h2><ul class="grid grid-cols-1 gap-2">{product.features.map(feature => <li class="flex items-start"><span class="text-green-500 mr-2">✓</span><span class="text-gray-700">{feature}</span></li>)}</ul></div><div class="bg-gray-100 p-6 rounded-xl space-y-4"><h2 class="text-xl font-bold">Teknik Özellikler</h2><dl class="grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2">{Object.entries(product.specs).map(([key, value]) => <div class="border-b border-gray-200 py-2"><dt class="text-sm font-medium text-gray-500">{key}</dt><dd class="mt-1 text-sm font-bold text-gray-900">{value}</dd></div>)}</dl></div>{product.materials && <div class="bg-gray-50 p-6 rounded-xl border border-gray-200/60 space-y-4"><h2 class="text-xl font-bold text-gray-900">Parça ve Malzeme Listesi</h2><dl class="grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2">{Object.entries(product.materials).map(([part, material]) => <div class="border-b border-gray-200/60 py-2"><dt class="font-medium text-gray-500">{part}</dt><dd class="font-bold text-gray-900">{material}</dd></div>)}</dl></div>}<div class="flex flex-col sm:flex-row gap-4 pt-6"><a href={`/tr/contact/?product=${encodeURIComponent(product.name)}`} class="flex-1 text-center py-4 bg-brand-red text-white font-bold rounded-xl">Teklif İste</a><a href={`https://wa.me/8618684324501?text=${encodeURIComponent(`${product.name} için teknik bilgi ve teklif talep ediyorum.`)}`} class="flex-1 text-center py-4 bg-white text-blue-600 font-bold border-2 border-blue-600 rounded-xl">WhatsApp ile görüşün</a></div></div>
    </div>
    <section class="mt-20 max-w-4xl"><h2 class="text-3xl font-black text-gray-900 mb-8">Sıkça Sorulan Sorular</h2><div class="space-y-4">{faqs.map(faq => <details class="group bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden"><summary class="flex items-center justify-between cursor-pointer px-6 py-5 font-bold text-gray-900 list-none"><span>{faq.question}</span><span>＋</span></summary><div class="px-6 pb-6 text-gray-600 leading-relaxed">{faq.answer}</div></details>)}</div></section>
    {relatedProducts.length > 0 && <section class="mt-20"><h2 class="text-3xl font-black text-gray-900 mb-8">İlgili Ürünler</h2><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">{relatedProducts.map(related => <a href={`/tr/products/${related.slug}/`} class="group bg-white rounded-2xl border border-gray-100 shadow-sm p-6"><img src={related.image} alt={related.name} class="w-full h-40 object-contain rounded-lg bg-gray-50 p-2 mb-4" loading="lazy"/><span class="text-xs font-bold text-blue-600 uppercase">{related.category}</span><h3 class="text-sm font-bold text-gray-900 mt-2">{related.name}</h3><span class="mt-4 inline-block text-brand-red font-bold text-xs">Ayrıntıları Gör</span></a>)}</div></section>}
  </main>
</Layout>
