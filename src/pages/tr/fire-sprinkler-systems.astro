---
import Layout from '../../layouts/Layout.astro';
const products = [
 { slug: 'glass-bulb-fire-sprinkler-zst', name: 'Cam Ampullü Yangın Sprinkler Başlığı (ZST Serisi)', desc: 'Sarkık/dik/yan duvar tipi, K=80/115, 57–141°C', img: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png' },
 { slug: 'wet-alarm-check-valve-zsfz-150', name: 'Islak Alarm Vana İstasyonu (ZSFZ 150)', desc: 'Hidrolik alarm zili, gecikme haznesi, DN100–DN200', img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp' },
 { slug: 'deluge-alarm-valve-zsfm', name: 'Baskın (Deluge) Alarm Vana Grubu (ZSFM)', desc: 'Diyafram kumandalı, baskın ve su püskürtme sistemleri için', img: '/assets/products/deluge-alarm-valve-zsfm.webp' },
 { slug: 'pre-action-alarm-system-zsfy', name: 'Ön Tepkili Alarm Sistemi (ZSFY)', desc: 'Arşiv, kütüphane ve veri merkezleri için çift tetiklemeli emniyet', img: '/assets/products/pre-action-alarm-system-zsfy.jpg' },
 { slug: 'water-flow-indicator-zsjz', name: 'Palet Tipi Su Akış Anahtarı (ZSJZ)', desc: 'Ayarlanabilir 2–60 saniye gecikme, DN50–DN200', img: '/assets/products/water-flow-indicator-zsjz.png' },
 { slug: 'telescopic-y-strainer-sgl41h', name: 'Teleskopik Y Tipi Pislik Tutucu (SGL41H)', desc: 'Vanaları partiküllerden korur, SS304/316 elek', img: '/assets/products/telescopic-y-strainer-sgl41h.webp' }
];
const faq = [
 { question: 'Sprinkler başlıklarınız UL listeli midir?', answer: 'Uygulanabilir model ve hedef pazara göre sprinkler başlıkları ve sistem bileşenleri UL/ULC listelidir. Teklif öncesinde mühendislerimiz projeniz için doğru sertifika paketini doğrular.' },
 { question: 'Islak ve kuru sprinkler sistemi arasındaki fark nedir?', answer: 'Islak sistemlerde borular derhal boşaltılacak suyla doludur. Kuru sistemlerde donma riski bulunan ısıtılmayan alanlar için basınçlı hava veya azot ve kuru boru vanası kullanılır. Ön tepkili sistemler suya hassas alanlar için her iki yaklaşımı birleştirir.' },
 { question: 'Komple sistem BOM teklifi sağlayabilir misiniz?', answer: 'Evet. Proje çizimlerinizi veya bileşen listenizi gönderin; sprinkler başlıkları, alarm vanaları, akış anahtarları, pislik tutucular ve aksesuarları tek fabrika paketi olarak fiyatlandıralım.' }
];
---
<Layout locale="tr" title="Yangın Sprinkler Sistemleri ve UL Sprinkler Başlıkları | Wanlian Fluid" description="Ticari ve endüstriyel binalar için UL listeli sprinkler başlıkları, esnek bağlantılar ve komple yangın sprinkler sistemi bileşenleri." type="product" productData={{ name: 'Yangın Sprinkler Sistemleri', image: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png', description: 'Islak, kuru ve ön tepkili yangın sprinkler sistemleri için UL listeli başlıklar, alarm vanaları ve sistem bileşenleri.' }} faq={faq} breadcrumbs={[{ name: 'Yangın Sprinkler Sistemleri' }]}>
<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/tr/">Ana Sayfa</a><span>/</span><a href="/tr/products/">Ürünler</a><span>/</span><span>Yangın Sprinkler Sistemleri</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Komple Sprinkler Sistemleri — Fabrikadan Doğrudan</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight">UL Listeli Bileşenlerle Komple Yangın Sprinkler Sistemleri</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid; ticari ve endüstriyel binalarda ıslak, kuru ve ön tepkili kurulumlar için UL listeli sprinkler başlıkları, esnek düşey bağlantılar, alarm vanaları ve sistem aksesuarları üretir ve ihraç eder.</p><div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">{['UL/ULC Listeli', 'K=80 / K=115', '57–141°C Sınıfları', 'Komple Sistem BOM'].map(b => <div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue">{b}</span></div>)}</div><h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">Sprinkler Sistemi Bileşenleri</h2><div class="grid grid-cols-2 lg:grid-cols-3 gap-4">{products.map(p => <a href={`/tr/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red transition"><img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2"/><div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red">{p.name}</p><p class="text-[10px] text-gray-400 mt-1">{p.desc}</p></div></a>)}</div><h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">Temel Teknik Özellikler</h2><div class="overflow-x-auto rounded-xl border border-gray-200"><table class="min-w-full text-sm divide-y divide-gray-200"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left">Özellik</th><th class="px-4 py-3 text-left">Ayrıntı</th></tr></thead><tbody class="divide-y divide-gray-200"><tr><td class="px-4 py-3 font-bold">Sertifikasyon</td><td class="px-4 py-3">Model ve hedef pazara göre UL/ULC Listeli</td></tr><tr><td class="px-4 py-3 font-bold">Sprinkler ölçüleri</td><td class="px-4 py-3">1/2 (DN15), 3/4 (DN20), 1 inç; sarkık, dik, yan duvar</td></tr><tr><td class="px-4 py-3 font-bold">Debi katsayısı</td><td class="px-4 py-3">K=80 ±4 / K=115 ±9</td></tr><tr><td class="px-4 py-3 font-bold">Sıcaklık sınıfları</td><td class="px-4 py-3">57°C / 68°C / 79°C / 93°C / 141°C</td></tr><tr><td class="px-4 py-3 font-bold">Sistem vanaları</td><td class="px-4 py-3">Islak alarm ZSFZ, baskın ZSFM, ön tepkili ZSFY, akış anahtarı ZSJZ</td></tr></tbody></table></div><h2 class="text-2xl font-black text-gray-900 mt-12 mb-4">Uygulamalar</h2><p class="text-gray-700 leading-relaxed">Bileşenlerimiz ofis, otel, hastane, okul, fabrika, depo, veri merkezi ve yer altı otoparklarını korur. Yanlış boşalmanın önlenmesi gereken arşiv, kütüphane ve bilgisayar odaları için ön tepkili sistemler önerilir.</p><h2 class="text-2xl font-black text-gray-900 mt-12 mb-6">Sıkça Sorulan Sorular</h2><div class="space-y-4">{faq.map(item => <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5"><summary class="font-bold text-gray-800 cursor-pointer list-none">{item.question}</summary><p class="mt-3 text-gray-600 text-sm leading-relaxed">{item.answer}</p></details>)}</div><div class="mt-12 text-center bg-gradient-to-r from-brand-blue to-blue-800 px-6 py-10 rounded-2xl"><h2 class="text-2xl font-black text-white">Sprinkler sistemi bileşenlerine mi ihtiyacınız var?</h2><a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Merhaba, yangın sprinkler sistemi bileşenleri hakkında bilgi istiyorum.')}`} class="inline-block mt-6 px-8 py-4 bg-white text-brand-blue font-bold rounded-lg">WhatsApp ile görüşün</a></div></article></main>
</Layout>
