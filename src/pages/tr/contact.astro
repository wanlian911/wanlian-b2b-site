---
import Layout from '../../layouts/Layout.astro';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';
const productName = Astro.url.searchParams.get('product') || '';
const whatsappText = encodeURIComponent('Merhaba, Wanlian Fluid ürünleri için B2B teklif talep ediyorum.');
---
<Layout locale="tr" title="İletişim ve B2B Teklif | Quanzhou Wanlian Fluid" description="Endüstriyel vanalar ve yangın güvenliği ekipmanları için B2B teklif isteyin. Şartname ve çizimleri gönderin; ekibimiz 12 saat içinde yanıtlasın.">
<main id="inquiry" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20"><div class="text-center mb-16 space-y-4"><span class="text-xs font-bold tracking-widest text-blue-600 uppercase">İletişim ve Teklif</span><h1 class="text-4xl font-black text-gray-900">Profesyonel Teklif İsteyin</h1><p class="text-lg text-gray-500 max-w-2xl mx-auto">Ürün gereksinimlerinizi, standartları, ölçüleri ve hedef uygulamayı paylaşın. Satış ve mühendislik ekibimiz sonraki adımlarla yanıt verecektir.</p></div><div class="grid lg:grid-cols-3 gap-16"><div class="space-y-8"><div><h3 class="text-xs font-bold text-gray-400 tracking-widest uppercase mb-2">Şirket Konumu</h3><p class="text-lg font-bold">Quanzhou Wanlian Fluid Equipment Co., Ltd.</p><p class="text-gray-500 mt-2 text-sm">Quanzhou, Fujian Eyaleti, Çin</p></div><div><h3 class="text-xs font-bold text-gray-400 tracking-widest uppercase mb-3">Doğrudan İletişim</h3><ul class="space-y-3 text-sm text-gray-600"><li><b>E-posta:</b> <a href="mailto:sales@wanlian911.com" class="text-blue-600 hover:underline">sales@wanlian911.com</a></li><li><b>Telefon:</b> <a href="tel:+8618684324501" class="text-blue-600 hover:underline">+86 186 8432 4501</a></li><li><b>WhatsApp:</b> <a href={`https://wa.me/8618684324501?text=${whatsappText}`} target="_blank" rel="noopener noreferrer" class="text-green-600 font-bold hover:underline">+86 186 8432 4501</a></li></ul></div><div class="bg-blue-50 p-8 rounded-xl border border-blue-100"><h3 class="font-bold text-blue-900">Wanlian Fluid ile neden çalışmalısınız?</h3><ul class="mt-4 space-y-3 text-sm text-blue-700"><li>✓ Akışkan sistemleri için ürün seçimi desteği</li><li>✓ OEM/ODM gereksinimleri</li><li>✓ Teknik şartname ve belge desteği</li><li>✓ İhracat ambalajı ve sevkiyat koordinasyonu</li></ul></div></div><div class="lg:col-span-2 bg-white p-10 rounded-2xl border shadow-sm"><h2 class="text-xl font-bold mb-6">RFQ / Teklif Formu Gönderin</h2><InquiryForm productName={productName} /></div></div></main>
</Layout>
