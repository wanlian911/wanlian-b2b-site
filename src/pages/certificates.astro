---
import Layout from '../layouts/Layout.astro';

// Three compliance tiers, printed on each card via the code line so a reader can never
// mistake a partner factory's listing for a Wanlian credential:
//   IN OUR OWN NAME        - credential held by Quanzhou Wanlian Fluid Equipment Co., Ltd
//   HELD BY PRODUCING FACTORY - third-party listing belongs to the factory that made the listed model
//   DESIGN & TEST BASIS    - what we manufacture and test to; a declaration, not a certification
const certifications = [
  {
    name: 'ISO 9001:2015',
    code: 'IN OUR OWN NAME',
    desc: 'Quality management system held by Quanzhou Wanlian Fluid Equipment Co., Ltd.',
    scope: 'Design, production and sales of valves, fire-fighting equipment and fluid-control products under a certified ISO 9001:2015 system.',
    products: 'Everything we sell — own production lines and partner-sourced items alike',
    verify: "The certificate number and issuing body are provided for verification. A copy travels with your order documentation.",
    icon: '⚙️'
  },
  {
    name: 'Per-Lot Test Records',
    code: 'IN OUR OWN NAME',
    desc: "100% shell pressure and seat leakage testing, documented lot by lot.",
    scope: "Every unit is shell-pressure and air-leakage tested before packing, to GB/T 13927 or EN 12266-1 as your specification names, and the records are reconciled to the serial numbers on your packing list.",
    products: 'All valves and fire-protection equipment we ship',
    verify: "Test records travel with the export documents. Third-party witnessed testing (SGS, BV, Intertek) can be arranged before shipment.",
    icon: '🧪'
  },
  {
    name: 'EN 12266-1 / GB 5135 series',
    code: 'DESIGN & TEST BASIS',
    desc: 'Manufacturing and test basis where no third-party listing applies to your specification.',
    scope: "Valves are manufactured and tested to EN 12266-1 or GB/T 13927 as your specification names; sprinkler components, fire hydrants and alarm valves follow the GB 5135 series, GB 4452 and GB 50974, and system design references EN 12845. CE marking, where it applies, is declared by the manufacturing facility holding that declaration.",
    products: 'Sprinkler system components, fire hydrants, alarm valves and general service valves',
    verify: "This is a declaration of manufacturing and test basis, not a certification, and we label it as such. Factory test reports are provided with the shipment.",
    icon: '🧱'
  },
  {
    name: 'UL 262 / UL 1091',
    code: 'HELD BY PRODUCING FACTORY',
    desc: 'Standards for gate valves and check valves used in fire-protection service (North America).',
    scope: "A UL listing is granted to the factory that manufactures the listed model. Wanlian does not hold UL listings and does not claim them in our own name.",
    products: 'Listed models can be sourced from the certificate-holding factory where your specification requires them',
    verify: "Where your tender names UL, we confirm in writing before production: the certificate holder's legal name, the listed model and size, and the certificate copy — then you verify it yourself at UL Product iQ.",
    icon: '🏆'
  },
  {
    name: 'FM Class 1120 / 1130',
    code: 'HELD BY PRODUCING FACTORY',
    desc: 'Approval standard for fire service control valves (OS&Y and NRS type).',
    scope: "FM Approvals are granted per manufacturer and product line. We supply approved models from the approved facility; we do not present an FM approval as a Wanlian credential.",
    products: 'OS&Y gate valves and fire service control valves, listed configurations on request',
    verify: "We name the approval holder and the approved model, provide the certificate copy, and you confirm the entry in the FM Approval Guide.",
    icon: '🛡️'
  },
  {
    name: 'LPCB RedBook',
    code: 'HELD BY PRODUCING FACTORY',
    desc: 'Loss Prevention Certification listing for fire protection products and services.',
    scope: "RedBook entries are published against the certified manufacturer. Relevant for UK and Commonwealth projects that require LPCB-listed equipment.",
    products: 'Listed fire protection products, per the RedBook entry for the supplying factory',
    verify: "We identify the RedBook entry and the certified manufacturer for your target product before you commit — the entry is free to check at redbooklive.com.",
    icon: '📜'
  }
];

const faq = [
  {
    question: 'Does Wanlian Fluid hold ISO 9001 certification?',
    answer: 'Yes — production runs under an ISO 9001:2015 quality management system covering design, production and sales of valves, fire-fighting equipment and fluid-control products. The certificate number and issuing body are provided for verification.'
  },
  {
    question: 'Are your fire valves UL or FM listed?',
    answer: "No — those listings belong to the factories that hold them, not to Wanlian. If your tender names UL 262, UL 1091, FM Class 1120 or FM Class 1130, we source the listed model from the certificate-holding factory and confirm it in writing before production: the holder's legal name, the listed model and size, and the certificate copy. If we cannot supply a genuinely listed unit, we tell you at quotation stage rather than after your order is committed."
  },
  {
    question: 'What does the CE marking cover for your valves?',
    answer: "CE marking is declared by the manufacturing facility that holds the applicable EU declaration, within the scope of the relevant directives, with valve testing following EN 12266-1. Tell us your project and destination and we identify that facility, the directive, the category and the documentation for the exact model before order."
  },
  {
    question: 'How can I verify that your certificates are genuine?',
    answer: "We give you the certificate holder's legal name and the certificate copy for the exact model, so you can check it yourself at UL Product iQ, the FM Approval Guide, LPCB RedBook or the issuing body's own portal. A supplier who will not name the certificate holder is the red flag — and that test applies to us as well."
  },
  {
    question: 'Do you provide test reports with the shipment?',
    answer: 'Yes — per-unit shell pressure and air-leakage test records reconciled to the serial numbers on the packing list travel with the export documents (invoice, packing list, certificate of origin), plus material certificates and standard-specific certificates on request.'
  }
];
---

<Layout 
  title="Compliance, Testing & Certification | Wanlian Fluid"
  description="What Wanlian holds in our own name, what the producing factory holds, and what we manufacture and test to — with the verification path for each."
  faq={faq}
  breadcrumbs={[{ name: 'Certificates' }]}
>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
         Compliance, <span class="text-brand-red">Certification.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
         Share your project requirements and we will provide the available product information, technical specifications, and documentation for review.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p>
            <div class="space-y-3 text-sm text-gray-600">
              <p><span class="font-bold text-gray-900">Scope: </span>{cert.scope}</p>
              <p><span class="font-bold text-gray-900">Covered products: </span>{cert.products}</p>
              <p class="text-xs text-gray-500 leading-relaxed border-t border-gray-200 pt-3">{cert.verify}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-6">
        <h2 class="text-3xl font-black">Need Certificate Copies or Technical Data Sheets?</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          We provide certificate copies, hydrostatic test reports, technical datasheets, CAD drawings and installation manuals for our product range upon request. Please specify the certification, product model and your target market so we can confirm the applicable scope.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a href="/contact/?product=Certificate%20%26%20Technical%20Documentation%20Request" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
            Request Certificate &amp; Docs
          </a>
          <a href="/products/" class="inline-block px-10 py-5 bg-white/10 border border-gray-600 text-white font-black rounded-xl hover:bg-white/20 transition">
            Browse Our Product Range
          </a>
        </div>
        <p class="text-xs text-gray-500 pt-2">
          Third-party listings are held by manufacturing facilities, not by traders. We name the holder for your exact model — or we tell you we cannot supply it. Before your order, not after.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 bg-gray-50 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">FAQ</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Frequently Asked Questions</h2>
      </div>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-white rounded-xl border border-gray-100 p-6 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
