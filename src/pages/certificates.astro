---
import Layout from '../layouts/Layout.astro';

const certifications = [
  { name: 'UL Listed', code: 'UL 262 / UL 1091', desc: 'Standard for Gate Valves and Check Valves for Fire-Protection Service.', icon: '🏆' },
  { name: 'FM Approved', code: 'Class 1120/1130', desc: 'Approval standard for Fire Service Control Valves (OS&Y and NRS Type).', icon: '🛡️' },
  { name: 'CE Certified', code: 'EN 12266-1', desc: 'Compliance with European health, safety, and environmental protection standards.', icon: '🇪🇺' },
  { name: 'ISO 9001:2015', code: 'Quality Management', desc: 'International standard for quality management systems in manufacturing.', icon: '⚙️' },
  { name: 'LPCB Certified', code: 'Loss Prevention', desc: 'RedBook Listing for fire protection products and services.', icon: '📜' },
  { name: 'GB Standard', code: 'GB 5135 / GB 4452', desc: 'Compliance with Chinese National Standards for fire protection equipment.', icon: '🇨🇳' }
];
---

<Layout 
  title="Certifications & Quality Standards | Wanlian Fluid"
  description="Explore Wanlian Fluid's international certifications including UL, FM, CE, and ISO 9001. We ensure the highest safety standards for fire protection and industrial fluid systems."
>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
        Quality <span class="text-brand-red">Guaranteed.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
        Wanlian Fluid products are tested and certified by the world's leading safety and quality organizations, ensuring reliability in the most demanding environments.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed">{cert.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-8">
        <h2 class="text-3xl font-black">Need Technical Data Sheets?</h2>
        <p class="text-gray-400 max-w-xl mx-auto">
          We provide detailed technical specifications, CAD drawings, and installation manuals for our entire product range upon request.
        </p>
        <a href="/contact/" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
          Request Technical Docs
        </a>
      </div>
    </div>
  </section>
</Layout>
