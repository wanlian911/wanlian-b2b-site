---
import Layout from '../layouts/Layout.astro';

const certifications = [
  { name: 'Technical Data Sheets', code: 'PRODUCT DOCUMENTATION', desc: 'Request specifications, dimensions, materials, and application information for selected products.', icon: 'DOC' },
  { name: 'Testing Requirements', code: 'PROJECT REVIEW', desc: 'Share required pressure, leakage, inspection, or documentation standards for order review.', icon: 'QA' },
  { name: 'Connection Standards', code: 'SELECTION SUPPORT', desc: 'Discuss DN size, flange, groove, threaded, and other connection requirements before quotation.', icon: 'STD' },
  { name: 'Material Options', code: 'CONFIGURATION', desc: 'Review body, sealing, stem, coating, and accessory options for the intended application.', icon: 'MAT' },
  { name: 'OEM / ODM Discussion', code: 'B2B COOPERATION', desc: 'Send drawings, labels, packaging, or configuration requirements for a feasibility review.', icon: 'OEM' },
  { name: 'Export Documentation', code: 'SHIPPING SUPPORT', desc: 'Confirm packing, product documentation, and shipping details for international orders.', icon: 'EXP' }
];
---

<Layout 
  title="Product Documentation & Technical Support | Wanlian Fluid"
  description="Request product documentation, testing requirements, material options, and export support for Wanlian Fluid valves and fire protection equipment."
>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
         Product <span class="text-brand-red">Documentation.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
         Share your project requirements and we will provide the available product information, technical specifications, and documentation for review.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed">{cert.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-8">
        <h2 class="text-3xl font-black">Need Technical Data Sheets?</h2>
        <p class="text-gray-400 max-w-xl mx-auto">
          We provide detailed technical specifications, CAD drawings, and installation manuals for our entire product range upon request.
        </p>
        <a href="/contact" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
          Request Technical Docs
        </a>
      </div>
    </div>
  </section>
</Layout>
