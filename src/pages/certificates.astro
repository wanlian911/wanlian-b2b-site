---
import Layout from '../layouts/Layout.astro';

const certifications = [
  {
    name: 'UL Listed',
    code: 'UL 262 / UL 1091',
    desc: 'Standard for Gate Valves and Check Valves for Fire-Protection Service.',
    scope: 'Gate valves and check valves for fire-protection service supplied to the North American market (UL 262 / UL 1091).',
    products: 'Resilient seat gate valves, check valves',
    verify: 'Certificate scope applies to the specific models listed in the UL certificate. Contact us to confirm model coverage and request a copy.',
    icon: '🏆'
  },
  {
    name: 'FM Approved',
    code: 'Class 1120/1130',
    desc: 'Approval standard for Fire Service Control Valves (OS&Y and NRS Type).',
    scope: 'Fire service control valves (OS&Y and NRS type) approved per FM Class 1120/1130.',
    products: 'OS&Y gate valves, fire service control valves',
    verify: 'Approval covers the models listed on the FM approval certificate. Copies provided on request for your project documentation.',
    icon: '🛡️'
  },
  {
    name: 'CE Certified',
    code: 'EN 12266-1',
    desc: 'Compliance with European health, safety, and environmental protection standards.',
    scope: 'Pressure equipment tested and marked in accordance with the applicable EU directives and EN 12266-1 test standard.',
    products: 'Valves supplied to EU projects (per applicable directive scope)',
    verify: 'CE marking applies within the scope of the relevant directives. Confirm the applicable directive and category for your project.',
    icon: '🇪🇺'
  },
  {
    name: 'ISO 9001:2015',
    code: 'Quality Management',
    desc: 'International standard for quality management systems in manufacturing.',
    scope: 'Design, production and sales of valves, fire-fighting equipment and fluid-control products under a certified ISO 9001:2015 quality management system.',
    products: 'All production lines',
    verify: 'System certificate issued by the accredited certification body; valid per the certificate period. Copy available on request.',
    icon: '⚙️'
  },
  {
    name: 'LPCB Certified',
    code: 'Loss Prevention',
    desc: 'RedBook Listing for fire protection products and services.',
    scope: 'Fire protection products listed under the LPCB RedBook scheme for the UK / Commonwealth markets.',
    products: 'Listed fire protection products (per RedBook entry)',
    verify: 'RedBook listing covers the specific products and standards shown in the listing entry. Verify the entry number for your target product.',
    icon: '📜'
  },
  {
    name: 'GB Standard',
    code: 'GB 5135 / GB 4452',
    desc: 'Compliance with Chinese National Standards for fire protection equipment.',
    scope: 'Manufactured and tested in accordance with the relevant Chinese National Standards (GB 5135 series, GB 4452, GB 50974).',
    products: 'Sprinkler system components, fire hydrants, alarm valves',
    verify: 'Compliance per the specific GB standard applicable to each product model. Test reports available on request.',
    icon: '🇨🇳'
  }
];
---

<Layout 
  title="Product Documentation & Technical Support | Wanlian Fluid"
  description="Request product documentation, testing requirements, material options, and export support for Wanlian Fluid valves and fire protection equipment."
>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
         Product <span class="text-brand-red">Documentation.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
         Share your project requirements and we will provide the available product information, technical specifications, and documentation for review.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p>
            <div class="space-y-3 text-sm text-gray-600">
              <p><span class="font-bold text-gray-900">Scope: </span>{cert.scope}</p>
              <p><span class="font-bold text-gray-900">Covered products: </span>{cert.products}</p>
              <p class="text-xs text-gray-500 leading-relaxed border-t border-gray-200 pt-3">{cert.verify}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-6">
        <h2 class="text-3xl font-black">Need Certificate Copies or Technical Data Sheets?</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          We provide certificate copies, hydrostatic test reports, technical datasheets, CAD drawings and installation manuals for our product range upon request. Please specify the certification, product model and your target market so we can confirm the applicable scope.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a href="/contact/?product=Certificate%20%26%20Technical%20Documentation%20Request" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
            Request Certificate &amp; Docs
          </a>
          <a href="/products/" class="inline-block px-10 py-5 bg-white/10 border border-gray-600 text-white font-black rounded-xl hover:bg-white/20 transition">
            Browse Certified Products
          </a>
        </div>
        <p class="text-xs text-gray-500 pt-2">
          Certification applies to the specific products, models and scope stated in each certificate. Our engineers will confirm model coverage before you order.
        </p>
      </div>
    </div>
  </section>
</Layout>
