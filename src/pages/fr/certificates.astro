---
import Layout from '../../layouts/Layout.astro';

const certifications = [
  {
    name: 'ISO 9001:2015',
    code: 'AU NOM DE WANLIAN',
    desc: 'Système de management de la qualité appliqué à la fabrication et au suivi des commandes.',
    scope: 'Le système ISO 9001:2015 couvre la conception, la production et la vente de vannes, d’équipements anti-incendie et de produits de contrôle hydraulique.',
    products: 'Toutes les lignes de production relevant du périmètre certifié',
    verify: 'Le certificat système et son organisme émetteur sont fournis pour vérification, avec la période de validité correspondante.',
    icon: '⚙️'
  },
  {
    name: 'Enregistrements d’essai par lot',
    code: 'AU NOM DE WANLIAN',
    desc: 'Traçabilité des contrôles réalisés sur les produits fabriqués et préparés pour l’expédition.',
    scope: 'Les rapports d’essai de pression du corps et d’étanchéité à l’air sont rapprochés du lot, du modèle et des numéros de série concernés.',
    products: 'Vannes, hydrants et équipements de protection incendie selon la commande',
    verify: 'Les rapports d’essai et certificats matière peuvent être fournis avec la documentation d’export sur demande.',
    icon: '📋'
  },
  {
    name: 'EN 12266-1 / GB 5135',
    code: 'BASE DE CONCEPTION ET D’ESSAI',
    desc: 'Référentiels techniques utilisés pour définir les exigences de conception et les essais applicables.',
    scope: 'Les vannes sont testées selon EN 12266-1 et les composants de protection incendie selon les parties pertinentes de la série GB 5135.',
    products: 'Vannes et composants de réseaux de protection incendie selon le modèle',
    verify: 'La norme et le rapport d’essai applicables sont confirmés pour le modèle et la spécification de votre projet.',
    icon: '🧪'
  },
  {
    name: 'UL 262 / UL 1091',
    code: 'DÉTENUE PAR L’USINE PRODUCTRICE',
    desc: 'Références UL applicables à certains modèles de vannes de protection incendie.',
    scope: 'La couverture est limitée aux modèles et à l’usine indiqués dans le listage UL correspondant.',
    products: 'Vannes à boisseau et clapets anti-retour selon le listage applicable',
    verify: 'Wanlian ne détient aucune liste UL et ne les revendique pas en son nom.',
    icon: '🏆'
  },
  {
    name: 'FM Class 1120 / 1130',
    code: 'DÉTENUE PAR L’USINE PRODUCTRICE',
    desc: 'Références FM applicables à certains modèles de vannes de contrôle de service incendie.',
    scope: 'La couverture est limitée aux modèles et à l’usine indiqués dans l’approbation FM correspondante.',
    products: 'Vannes de contrôle OS&Y et NRS selon l’approbation applicable',
    verify: 'Nous ne présentons pas une approbation FM comme une accréditation Wanlian.',
    icon: '🛡️'
  },
  {
    name: 'LPCB RedBook',
    code: 'DÉTENUE PAR L’USINE PRODUCTRICE',
    desc: 'Références LPCB RedBook applicables à certains produits de protection incendie.',
    scope: 'L’inscription couvre uniquement les produits et normes indiqués dans l’entrée RedBook de l’usine détentrice.',
    products: 'Produits de protection incendie selon l’entrée RedBook applicable',
    verify: 'Nous confirmons l’entrée, le périmètre et l’usine détentrice avant de fournir la documentation du projet.',
    icon: '📜'
  }
];

const faq = [
  {
    question: 'Wanlian Fluid est-elle certifiée ISO 9001 ?',
    answer: 'Oui — le système de management de la qualité ISO 9001:2015 couvre la conception, la production et la vente dans le périmètre certifié. Le certificat, son organisme émetteur et sa période de validité sont fournis pour vérification.'
  },
  {
    question: 'Wanlian détient-elle les listages UL ou les approbations FM ?',
    answer: 'Non — ces listages appartiennent aux usines qui les détiennent, pas à Wanlian. Nous confirmons le modèle, l’usine détentrice et le périmètre du document applicable avant commande.'
  },
  {
    question: 'Quelles normes servent de base à la conception et aux essais ?',
    answer: 'Les exigences applicables sont définies selon le modèle et le projet, notamment EN 12266-1 pour les essais de vannes et les parties pertinentes de la série GB 5135 pour les équipements de protection incendie.'
  },
  {
    question: 'Comment vérifier la portée d’un certificat ou d’un listage ?',
    answer: 'Vérifiez le numéro auprès de l’organisme émetteur et comparez le modèle, l’usine détentrice, la norme et la période de validité. Nous fournissons les documents pertinents pour la vérification de votre projet.'
  },
  {
    question: 'Fournissez-vous les enregistrements d’essai avec l’expédition ?',
    answer: 'Oui — les enregistrements d’essai de pression du corps et d’étanchéité à l’air, rapprochés du lot et des numéros de série concernés, peuvent accompagner les documents d’export et les certificats matière sur demande.'
  }
];
---

<Layout locale="fr"
  title="Documentation Produit & Support Technique | Wanlian Fluid"
  description="Demandez la documentation produit, les exigences d’essai, les options de matériaux et le support export pour les vannes et équipements de protection incendie Wanlian Fluid."
  faq={faq}
  breadcrumbs={[{ name: 'Certificats' }]}>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
        Documentation <span class="text-brand-red">Produit.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
        Partagez les exigences de votre projet et nous fournirons les informations produit disponibles, les spécifications techniques et la documentation pour examen.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p>
            <div class="space-y-3 text-sm text-gray-600">
              <p><span class="font-bold text-gray-900">Périmètre : </span>{cert.scope}</p>
              <p><span class="font-bold text-gray-900">Produits couverts : </span>{cert.products}</p>
              <p class="text-xs text-gray-500 leading-relaxed border-t border-gray-200 pt-3">{cert.verify}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-6">
        <h2 class="text-3xl font-black">Besoin de Copies de Certificats ou de Fiches Techniques ?</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          Nous fournissons sur demande des copies de certificats, des rapports d’essai hydrostatique, des fiches techniques, des plans CAD et des manuels d’installation pour notre gamme de produits. Veuillez préciser la certification, le modèle produit et votre marché cible afin que nous puissions confirmer le périmètre applicable.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a href="/fr/contact/?product=Demande%20de%20Certificats%20et%20Documentation%20Technique" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
            Demander Certificats &amp; Documents
          </a>
          <a href="/fr/products/" class="inline-block px-10 py-5 bg-white/10 border border-gray-600 text-white font-black rounded-xl hover:bg-white/20 transition">
            Parcourir les Produits Certifiés
          </a>
        </div>
        <p class="text-xs text-gray-500 pt-2">
          La certification s’applique aux produits, modèles et périmètres spécifiques indiqués dans chaque certificat. Nos ingénieurs confirmeront la couverture des modèles avant votre commande.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 bg-gray-50 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">FAQ</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Questions Fréquentes</h2>
      </div>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-white rounded-xl border border-gray-100 p-6 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
