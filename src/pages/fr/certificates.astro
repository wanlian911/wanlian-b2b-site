---
import Layout from '../../layouts/Layout.astro';

const certifications = [
  {
    name: 'Certifié UL',
    code: 'UL 262 / UL 1091',
    desc: 'Norme pour les vannes à boisseau et clapets anti-retour destinés au service de protection incendie.',
    scope: 'Vannes à boisseau et clapets anti-retour pour le service de protection incendie fournis au marché nord-américain (UL 262 / UL 1091).',
    products: 'Vannes à boisseau à siège élastomère, clapets anti-retour',
    verify: 'Le périmètre du certificat s’applique aux modèles spécifiques listés dans le certificat UL. Contactez-nous pour confirmer la couverture des modèles et demander une copie.',
    icon: '🏆'
  },
  {
    name: 'Approuvé FM',
    code: 'Class 1120/1130',
    desc: 'Norme d’approbation pour les vannes de contrôle de service incendie (types OS&Y et NRS).',
    scope: 'Vannes de contrôle de service incendie (types OS&Y et NRS) approuvées selon FM Class 1120/1130.',
    products: 'Vannes à boisseau OS&Y, vannes de contrôle de service incendie',
    verify: 'L’approbation couvre les modèles listés sur le certificat d’approbation FM. Copie fournie sur demande pour votre documentation de projet.',
    icon: '🛡️'
  },
  {
    name: 'Certifié CE',
    code: 'EN 12266-1',
    desc: 'Conformité aux normes européennes de santé, sécurité et protection de l’environnement.',
    scope: 'Équipements sous pression testés et marqués conformément aux directives UE applicables et à la norme d’essai EN 12266-1.',
    products: 'Vannes fournies aux projets UE (selon le périmètre de la directive applicable)',
    verify: 'Le marquage CE s’applique dans le périmètre des directives pertinentes. Confirmez la directive et la catégorie applicables à votre projet.',
    icon: '🇪🇺'
  },
  {
    name: 'ISO 9001:2015',
    code: 'Management de la Qualité',
    desc: 'Norme internationale des systèmes de management de la qualité dans la fabrication.',
    scope: 'Conception, production et vente de vannes, d’équipements anti-incendie et de produits de contrôle hydraulique sous un système de management de la qualité ISO 9001:2015 certifié.',
    products: 'Toutes les lignes de production',
    verify: 'Certificat système émis par l’organisme de certification accrédité ; valable selon la période du certificat. Copie disponible sur demande.',
    icon: '⚙️'
  },
  {
    name: 'Certifié LPCB',
    code: 'Prévention des Pertes',
    desc: 'Inscription au RedBook pour les produits et services de protection incendie.',
    scope: 'Produits de protection incendie inscrits au programme LPCB RedBook pour les marchés du Royaume-Uni / du Commonwealth.',
    products: 'Produits de protection incendie inscrits (selon l’entrée RedBook)',
    verify: 'L’inscription au RedBook couvre les produits et normes spécifiques figurant dans l’entrée d’inscription. Vérifiez le numéro d’entrée pour votre produit cible.',
    icon: '📜'
  },
  {
    name: 'Norme GB',
    code: 'GB 5135 / GB 4452',
    desc: 'Conformité aux normes chinoises nationales pour les équipements de protection incendie.',
    scope: 'Fabriqués et testés conformément aux normes chinoises nationales pertinentes (série GB 5135, GB 4452, GB 50974).',
    products: 'Composants de réseaux de gicleurs, hydrants, vannes d’alarme',
    verify: 'Conformité selon la norme GB spécifique applicable à chaque modèle produit. Rapports d’essai disponibles sur demande.',
    icon: '🇨🇳'
  }
];

const faq = [
  {
    question: 'Wanlian Fluid est-elle certifiée ISO 9001 ?',
    answer: 'Oui — la production s’effectue sous un système de management de la qualité ISO 9001:2015 couvrant la conception, la production et la vente de vannes, d’équipements anti-incendie et de produits de contrôle hydraulique. Le numéro de certificat et l’organisme émetteur sont fournis pour vérification.'
  },
  {
    question: 'Vos vannes incendie sont-elles inscrites UL ou approuvées FM ?',
    answer: 'Les vannes à boisseau et les clapets anti-retour de protection incendie sont inscrites selon UL 262 / UL 1091, et les vannes de contrôle de service incendie (types OS&Y et NRS) bénéficient de l’approbation FM Class 1120/1130. L’inscription est accordée par modèle — nous confirmons le modèle inscrit exact et la couverture du certificat pour votre spécification avant commande.'
  },
  {
    question: 'Que couvre le marquage CE pour vos vannes ?',
    answer: 'Le marquage CE est appliqué par modèle, dans le périmètre des directives UE pertinentes, avec des essais de vannes conformément à la norme d’essai EN 12266-1. Indiquez-nous votre projet et sa destination, et nous confirmerons la directive, la catégorie et la documentation applicables au modèle exact.'
  },
  {
    question: 'Comment vérifier que vos certificats sont authentiques ?',
    answer: 'Chaque numéro de certificat peut être vérifié sur le portail officiel de l’organisme émetteur, par rapport au modèle exact et à l’usine — un numéro qui ne renvoie aucun résultat est un signal d’alerte chez n’importe quel fournisseur. Nous fournissons des copies des certificats pertinents avec votre documentation de commande.'
  },
  {
    question: 'Fournissez-vous des rapports d’essai avec l’expédition ?',
    answer: 'Oui — les enregistrements d’essai de pression du corps et d’étanchéité à l’air par unité, rapprochés des numéros de série de la liste d’emballage, accompagnent les documents d’export (facture, liste d’emballage, certificat d’origine), ainsi que les certificats matière et les certificats spécifiques aux normes sur demande.'
  }
];
---

<Layout locale="fr"
  title="Documentation Produit & Support Technique | Wanlian Fluid"
  description="Demandez la documentation produit, les exigences d’essai, les options de matériaux et le support export pour les vannes et équipements de protection incendie Wanlian Fluid."
  faq={faq}
  breadcrumbs={[{ name: 'Certificats' }]}>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
        Documentation <span class="text-brand-red">Produit.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
        Partagez les exigences de votre projet et nous fournirons les informations produit disponibles, les spécifications techniques et la documentation pour examen.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p>
            <div class="space-y-3 text-sm text-gray-600">
              <p><span class="font-bold text-gray-900">Périmètre : </span>{cert.scope}</p>
              <p><span class="font-bold text-gray-900">Produits couverts : </span>{cert.products}</p>
              <p class="text-xs text-gray-500 leading-relaxed border-t border-gray-200 pt-3">{cert.verify}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-6">
        <h2 class="text-3xl font-black">Besoin de Copies de Certificats ou de Fiches Techniques ?</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          Nous fournissons sur demande des copies de certificats, des rapports d’essai hydrostatique, des fiches techniques, des plans CAD et des manuels d’installation pour notre gamme de produits. Veuillez préciser la certification, le modèle produit et votre marché cible afin que nous puissions confirmer le périmètre applicable.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a href="/fr/contact/?product=Demande%20de%20Certificats%20et%20Documentation%20Technique" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
            Demander Certificats &amp; Documents
          </a>
          <a href="/fr/products/" class="inline-block px-10 py-5 bg-white/10 border border-gray-600 text-white font-black rounded-xl hover:bg-white/20 transition">
            Parcourir les Produits Certifiés
          </a>
        </div>
        <p class="text-xs text-gray-500 pt-2">
          La certification s’applique aux produits, modèles et périmètres spécifiques indiqués dans chaque certificat. Nos ingénieurs confirmeront la couverture des modèles avant votre commande.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 bg-gray-50 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">FAQ</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Questions Fréquentes</h2>
      </div>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-white rounded-xl border border-gray-100 p-6 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
