---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Vos gicleurs sont-ils certifiés UL ?',
		answer: 'Oui. Nos gicleurs et composants de système sont certifiés UL/ULC lorsque applicable — les certificats sont disponibles sur notre page Certificats. Nos ingénieurs confirment le package de certification exact pour votre marché de destination avant devis.'
	},
	{
		question: 'Quelle est la différence entre les systèmes de gicleurs à mouillé et à sec ?',
		answer: 'Les systèmes à mouillé maintiennent de l’eau dans les canalisations pour un rejet immédiat lorsqu’un gicleur s’active. Les systèmes à sec utilisent de l’air ou de l’azote sous pression avec une vanne de pipeline sec, ce qui les rend adaptés aux espaces non chauffés où le gel des canalisations est un risque. Les systèmes à pré-action combinent les deux avantages pour les zones sensibles à l’eau.'
	},
	{
		question: 'Fournissez-vous des raccords flexibles de descente pour gicleurs ?',
		answer: 'Oui, nous fabriquons des raccords de descente flexibles en acier inoxydable tressé qui simplifient l’installation et permettent un repositionnement rapide des gicleurs pour s’adapter aux agencements des plafonds — réduisant le temps de main-d’œuvre par rapport à la tuyauterie rigide.'
	},
	{
		question: 'Pouvez-vous fournir un devis package BOM complet ?',
		answer: 'Oui. Envoyez-nous vos plans de projet ou une liste de composants et nous chiffrerons gicleurs, vannes d’alarme, signalisateurs de débit, filtres et accessoires en un seul package — une commande usine unique pour l’ensemble du circuit de gicleurs.'
	},
	{
		question: 'Quelles classes de température sont disponibles ?',
		answer: 'Les classes standard d’ampoule vitrée incluent 57°C, 68°C, 79°C, 93°C et 141°C avec ampoules colorées, en types à réponse standard (ampoule 5mm) et à réponse rapide (ampoule 3mm) selon la pratique NFPA.'
	}
];

const sprinklerProducts = [
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'Gicleur à Ampoule Vitrée (Série ZST)',
		img: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		desc: 'Pendentif/en hauteur/mural, K=80/115, 57–141°C'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Clapet Anti-Retour à Alarme à Mouillé (ZSFZ 150)',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'Cloche d’alarme hydraulique, chambre de retard, DN100–DN200'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Groupe de Vanne à Déluge et Alarme (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'À commande par membrane, pour systèmes de déluge et de projection d’eau'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Système à Alarme à Pré-action (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Double déclenchement de secours pour bibliothèques, archives, data centers'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Signalisateur de Débit d’Eau à Palette (ZSJZ)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'Retard réglable 2–60s, DN50–DN200, collier/bride'
	},
	{
		slug: 'telescopic-y-strainer-sgl41h',
		name: 'Filtre en Y Télescopique (SGL41H)',
		img: '/assets/products/telescopic-y-strainer-sgl41h.webp',
		desc: 'Protège les vannes contre les particules, tamis SS304/316'
	}
];
---

<Layout
	locale="fr"
	title="Systèmes de Gicleurs & Gicleurs Certifiés UL - WLFE"
	description="Gicleurs certifiés UL, raccords flexibles et composants complets de systèmes de gicleurs anti-incendie pour bâtiments commerciaux et industriels. Direct usine."
	type="product"
	productData={{
		name: 'Systèmes de Gicleurs',
		image: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		description: 'Gicleurs certifiés UL, vannes d’alarme, signalisateurs de débit et composants de système pour réseaux de gicleurs anti-incendie à mouillé, à sec et à pré-action dans les bâtiments commerciaux et industriels, fabriqués par Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Systèmes de Gicleurs' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/fr/" class="hover:text-blue-600">Accueil</a>
			<span>/</span>
			<a href="/fr/products/" class="hover:text-blue-600">Produits</a>
			<span>/</span>
			<span class="text-gray-600">Systèmes de Gicleurs</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Systèmes de Gicleurs Complets — Direct Usine</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Systèmes Complets de Gicleurs avec Composants Certifiés UL</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid fabrique et exporte des gicleurs certifiés UL, des raccords flexibles de descente, des vannes d’alarme et des accessoires de système pour les installations à mouillé, à sec et à pré-action dans les bâtiments commerciaux et industriels — une commande usine unique pour l’ensemble du circuit de gicleurs.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Certifié UL/ULC', 'K=80 / K=115', 'Classes 57–141°C', 'BOM Système Complet'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Composants des Systèmes de Gicleurs</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{sprinklerProducts.map(p => (
					<a href={`/fr/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Spécifications Clés</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Spécification</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Détails</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Certification</td>
							<td class="px-4 py-3 text-gray-700">Certifié UL/ULC (selon le modèle et le marché de destination)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Tailles de gicleurs</td>
							<td class="px-4 py-3 text-gray-700">1/2" (DN15), 3/4" (DN20), 1" — pendentif, en hauteur, mural</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Coefficient de débit</td>
							<td class="px-4 py-3 text-gray-700">K=80 ±4 / K=115 ±9 (autres coefficients K selon modèle)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Classes de température</td>
							<td class="px-4 py-3 text-gray-700">57°C / 68°C / 79°C / 93°C / 141°C, ampoules vitrées colorées</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Types de réponse</td>
							<td class="px-4 py-3 text-gray-700">Réponse standard (ampoule 5mm) / Réponse rapide (ampoule 3mm)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Vannes de système</td>
							<td class="px-4 py-3 text-gray-700">Alarme à mouillé (ZSFZ), déluge (ZSFM), pré-action (ZSFY), signalisateurs de débit (ZSJZ)</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Applications</h2>
			<p class="text-gray-700 leading-relaxed">Nos composants de systèmes de gicleurs protègent les immeubles de bureaux, hôtels, hôpitaux, écoles, usines, entrepôts, data centers et parkings souterrains — les systèmes à pré-action étant recommandés pour les bibliothèques, archives et salles informatiques où tout rejet accidentel doit être évité.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Pourquoi Choisir Wanlian Fluid</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Système complet, une commande</strong> — gicleurs, raccords, vannes d’alarme et accessoires chiffrés en un seul package issu d’une seule usine.</li>
				<li><strong>Composants certifiés</strong> — certifiés UL/ULC lorsque applicable ; certificats sur notre <a href="/fr/certificates/" class="text-brand-blue font-semibold hover:underline">page certificats</a>.</li>
				<li><strong>Aligné sur les normes du bâtiment</strong> — configurations conformes à la pratique NFPA pour l’acceptation des projets mondiaux.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Questions Fréquentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Besoin de Composants de Système de Gicleurs ?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envoyez-nous votre type de bâtiment et votre liste de composants — nous répondons avec un devis BOM complet sous 12 heures.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/fr/contact/?product=Syst%C3%A8mes%20de%20Gicleurs" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Demander un Devis</a>
						<a href="https://wa.me/8618684324501?text=Bonjour%2C%20j%27ai%20besoin%20de%20composants%20de%20syst%C3%A8me%20de%20gicleurs%20anti-incendie" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Discuter sur WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
