---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Fournissez-vous la pompe incendie elle-même ?',
		answer: 'Non. Wanlian fournit l’adaptateur, les vannes et les équipements de connexion autour du groupe pompant installé par autrui. Le fournisseur de la pompe assure la sélection de la pompe et la courbe certifiée ; nous utilisons ces données projet pour coordonner les composants environnants.'
	},
	{
		question: 'Qu’est-ce qu’un adaptateur de pompe incendie siamois ?',
		answer: 'L’adaptateur de pompe incendie SQD100-1.6 est un raccord d’apport des pompiers de type siamois avec deux entrées DN65 et une sortie bridée DN100, plus une vanne de commande intégrée, pour l’alimentation en eau par camion d’incendie dans le réseau de protection incendie.'
	},
	{
		question: 'Quelle vanne placer du côté aspiration de la pompe ?',
		answer: 'La disposition d’aspiration est fixée par la conception approuvée du local technique et par l’autorité compétente. L’isolement reste normalement grand ouvert pendant le fonctionnement de la pompe ; confirmez le type, le diamètre et le mode de connexion retenus avec le fournisseur de la pompe et le concepteur.'
	},
	{
		question: 'Où placer le clapet anti-retour au refoulement ?',
		answer: 'Le clapet anti-retour de refoulement se coordonne entre le groupe pompant installé par autrui et la vanne d’isolement de refoulement afin de limiter le retour d’eau. L’emplacement final, le diamètre et la classe de pression suivent la tuyauterie approuvée et les données du fournisseur de la pompe.'
	},
	{
		question: 'Un réducteur de pression peut-il remplacer les organes de commande de la pompe ?',
		answer: 'Non. Le 500X est un réducteur de pression hydraulique destiné à gérer la pression aval d’une canalisation ; il ne remplace pas le système de commande de la pompe, le dispositif de décharge de la pompe ni la conception certifiée du fournisseur de la pompe.'
	},
	{
		question: 'Quelles informations envoyer pour un devis d’ensemble de local technique ?',
		answer: 'Envoyez les données de débit et de hauteur du fournisseur de la pompe, les diamètres d’aspiration et de refoulement, les normes de connexion, le dispositif d’essai, la norme d’entrée des pompiers, les certifications requises et la nomenclature ou les plans des vannes.'
	}
];

const products = [
	{
		slug: 'sqd100-1-6-fire-pump-adapter',
		name: 'SQD100-1.6 Fire Pump Adapter (Siamese Connection)',
		img: '/assets/products/sqd100-1-6-fire-pump-adapter.webp',
		desc: '2 entrées DN65, sortie bridée DN100, 1.6 MPa'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'UL/FM Fire Protection Resilient Seated OS&Y Gate Valve',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: '2"–10", extrémités rainurées, tige montante, listé UL / FM'
	},
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Ductile Iron Resilient Seat Flanged Gate Valve (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'DN50–DN700, PN10 / PN16, fonte ductile, à brides'
	},
	{
		slug: 'spherical-ball-check-valve-hq44x',
		name: 'Spherical Cast Iron Ball Check Valve (HQ44X-16)',
		img: '/assets/products/spherical-ball-check-valve-hq44x.webp',
		desc: 'DN50–DN400, PN16, bille EPDM non colmatable'
	},
	{
		slug: 'adjustable-pressure-reducing-valve-500x',
		name: 'Hydraulic Adjustable Pressure Reducing Valve (500X)',
		img: '/assets/products/pressure-reducing-valve-500x-dn50.webp',
		desc: 'DN20–DN600, réglage 0.1–1.6 MPa, pilotage hydraulique'
	}
];
---

<Layout
	title="Adaptateur de pompe, raccord pompiers et vannes | WLFE"
	description="Adaptateur de pompe, raccord siamois et vannes de local technique pour l’aspiration, le refoulement et les essais d’un réseau de protection incendie."
	type="product"
	locale="fr"
	productData={{
		name: 'Connexions de pompe et vannes de local technique',
		image: '/assets/products/sqd100-1-6-fire-pump-adapter.webp',
		description: 'Raccords d’apport des pompiers, adaptateurs de pompe, vannes à tiroir, clapets anti-retour et organes de régulation de pression pour ensembles coordonnés de local technique.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Connexions de pompe' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/fr/" class="hover:text-blue-600">Accueil</a>
			<span>/</span>
			<a href="/fr/products/" class="hover:text-blue-600">Produits</a>
			<span>/</span>
			<span class="text-gray-600">Connexions de pompe</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Vannes de local technique et raccords d’apport des pompiers</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Adaptateur de pompe et ensembles de vannes de local technique</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Le local technique incendie ne se réduit pas à la pompe : c’est l’agencement d’aspiration, de refoulement, de clapet, d’isolement et d’essai qui permet au groupe pompant installé par autrui de fonctionner sûrement et aux pompiers d’apporter de l’eau par un raccord siamois compatible. Wanlian fournit les vannes et les connexions environnantes ; le groupe pompant est fourni par autrui.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Adaptateur siamois', 'Isolement à l’aspiration', 'Clapet au refoulement', 'Groupe pompant par autrui'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span></div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Composants de connexion de pompe</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{products.map(p => (
					<a href={`/fr/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p><p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p></div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Tableau de sélection du local technique</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Disposition</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Référence de sélection vérifiée</th></tr></thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">Raccord d’apport des pompiers</td><td class="px-4 py-3 text-gray-700">SQD100-1.6 : deux entrées DN65 avec bouchons SQS65 / KWS65, sortie bridée DN100, 1.6 MPa, vanne de commande intégrée.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Vannes d’isolement</td><td class="px-4 py-3 text-gray-700">Vanne à tiroir OS&amp;Y UL/FM : 2"–10", extrémités rainurées, tige montante ; vanne à tiroir à brides Z41X : DN50–DN700, PN10 / PN16.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Clapet au refoulement</td><td class="px-4 py-3 text-gray-700">Clapet anti-retour à bille HQ44X : DN50–DN400, 1.6 MPa (PN16), canal de flux non colmatable et étanchéité EPDM / NBR.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Gestion de la pression</td><td class="px-4 py-3 text-gray-700">Réducteur de pression hydraulique 500X : DN20–DN600 ; plage de réglage 0.1–1.6 MPa ; confirmez son rôle dans la conception aval approuvée.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Données pompe et essai</td><td class="px-4 py-3 text-gray-700">Fournissez les données de débit et de hauteur du fournisseur de la pompe, les diamètres de canalisation, le dispositif d’essai et les exigences d’agrément applicables avant le dimensionnement final des vannes.</td></tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Que comprendre dans une seule commande de local technique</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2">
				<li><strong>Point de connexion</strong> — norme d’entrée siamoise, bride de sortie, disposition des bouchons et interface des services d’incendie.</li>
				<li><strong>Ensemble aspiration et refoulement</strong> — vanne d’isolement, clapet anti-retour et tout organe de régulation de pression accordés à la nomenclature de vannes approuvée.</li>
				<li><strong>Détails d’essai et de mise en service</strong> — disposition de la collectrice ou de la sortie d’essai, instruments fournis par autrui le cas échéant, et courbe certifiée du fournisseur de la pompe.</li>
				<li><strong>Dossier de soumission</strong> — plans, données produit, certificats, dimensions de connexion, classe de pression et marquage du marché de destination.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Ressources de conception du local technique</h2>
			<p class="text-gray-700 leading-relaxed">Utilisez le <a href="/fr/guides/fire-pump-suction-water-tank-guide/" class="text-brand-blue font-semibold hover:underline">guide du réservoir d’aspiration de pompe incendie</a> pour la planification de l’aspiration, du refoulement et des essais, le <a href="/fr/guides/fire-department-connection-siamese-guide/" class="text-brand-blue font-semibold hover:underline">guide du raccord d’apport des pompiers siamois</a>, et le <a href="/fr/guides/check-valve-types-guide/" class="text-brand-blue font-semibold hover:underline">guide des types de clapets anti-retour</a> lors de la préparation de la nomenclature des vannes.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Questions Fréquentes</h2>
			<div class="space-y-4">{faq.map(item => (<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>))}</div>

			<div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white tracking-tight">Besoin d’un ensemble de connexions de pompe ?</h2><p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envoyez les données de débit et de hauteur du fournisseur de la pompe et votre nomenclature de vannes — nous coordonnons l’adaptateur vérifié et l’ensemble de vannes sous 12 heures.</p><div class="mt-6 flex flex-col sm:flex-row justify-center gap-4"><a href="/fr/contact/?product=Connexions%20de%20pompe" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Demander un Devis</a><a href="https://wa.me/8618684324501?text=Bonjour%2C%20j%27ai%20besoin%20de%20connexions%20de%20pompe%20incendie" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Discuter sur WhatsApp</a></div></div></div>
		</article>
	</main>
</Layout>
