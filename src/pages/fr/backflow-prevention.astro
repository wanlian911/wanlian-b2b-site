---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Quelle est la différence entre un dispositif anti-retour et un clapet anti-retour ?',
		answer: 'Un clapet anti-retour standard empêche mécaniquement le flux inverse mais n’est pas testé pour la fuite et ne possède pas de vidange intermédiaire. Un dispositif anti-retour tel que le HS41X combine deux clapets indépendants avec une chambre de vidange automatique intermédiaire, est testable sur place, et répond aux exigences de contrôle des connexions croisées pour la protection de l’eau potable. Les clapets anti-retour seuls ne sont pas acceptés aux connexions croisées de l’eau potable.'
	},
	{
		question: 'Où le dispositif anti-retour doit-il être installé sur une connexion de service incendie ?',
		answer: 'Sur la connexion de service incendie au réseau d’eau potable, en amont de l’aspiration de la pompe incendie ou de la montante du système. Il doit être accessible pour les essais, protégé contre le gel, et sa perte de charge doit être incluse dans le calcul hydraulique de la pompe incendie. Pour les systèmes en hauteur, confirmez que la classe de l’appareil correspond à la pression statique maximale de l’alimentation.'
	},
	{
		question: 'Les vannes de régulation hydraulique nécessitent-elles de l’électricité pour fonctionner ?',
		answer: 'La plupart des vannes de régulation hydraulique — le réducteur 500X, la vanne de niveau F745X et le dispositif anti-retour HS41X — sont entièrement autopilotées par la pression de la tuyauterie et ne nécessitent aucune alimentation externe. Les modèles à commande électromagnétique tels que le GKZF-1 utilisent AC220V ou DC24V pour l’automatisation à distance.'
	},
	{
		question: 'Quels matériaux sont utilisés pour les applications eau potable ?',
		answer: 'Pour les réseaux d’eau de boisson, le dispositif anti-retour HS41X utilise un corps en fonte ductile avec joints EPDM et des parties internes en acier inoxydable 304, conforme aux exigences sanitaires GB/T17219. Confirmez le certificat sanitaire pour votre marché — nos ingénieurs fournissent le package de documentation avec la commande.'
	},
	{
		question: 'Pouvez-vous fournir le package complet de vannes hydrauliques pour une salle de pompes ?',
		answer: 'Oui. Nous fabriquons des dispositifs anti-retour, des réducteurs de pression, des vannes de niveau, des vannes de régulation électromagnétiques, des dispositifs anti-vortex et des filtres en Y et les expédions comme un package coordonné — classes de pression, garnitures et rapports d’essai correspondants issus d’une seule usine.'
	}
];

const hydraulicProducts = [
	{
		slug: 'anti-pollution-backflow-preventer-hs41x',
		name: 'Dispositif Anti-Retour Anti-Pollution (HS41X-16)',
		img: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		desc: 'Ensemble à double clapet avec vidange intermédiaire, DN50–DN600'
	},
	{
		slug: 'adjustable-pressure-reducing-valve-500x',
		name: 'Réducteur de Pression Hydraulique (500X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'Commande pilote autopilotée, réglage 0,1–1.6 MPa'
	},
	{
		slug: 'hydraulic-water-level-control-valve-f745x',
		name: 'Vanne de Contrôle de Niveau d’Eau Hydraulique (F745X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'Régulation de niveau pilote à flotteur pour réservoirs et citernes'
	},
	{
		slug: 'groove-solenoid-control-gate-valve-gkzf1',
		name: 'Vanne à Boisseau de Régulation Électromagnétique (GKZF-1)',
		img: '/assets/products/groove-solenoid-control-gate-valve-gkzf1.jpg',
		desc: 'Vanne à gorge pilotée DC24V/AC220V, classe 300 PSI'
	},
	{
		slug: 'suction-vortex-preventer-en12845',
		name: 'Dispositif Anti-Vortex d’Aspiration (EN12845)',
		img: '/assets/02_valves_parts/valves_p21.webp',
		desc: 'SS304/316, élimine la cavitation de la pompe, profondeur de vidange 100mm'
	}
];

const trustBadges = ['Double Clapet + Vidange', 'PN10–PN25', 'Sanitaire GB/T17219', 'Pilotes Autopilotés'];
---

<Layout
	locale="fr"
	title="Dispositifs Anti-Retour & Vannes de Régulation Hydraulique - WLFE"
	description="Dispositifs anti-retour (HS41X), réducteurs (500X), régulation de niveau (F745X) et vannes électromagnétiques pour eau potable et réseaux incendie. DN50-DN600 direct usine."
	type="product"
	productData={{
		name: 'Prévention du Reflux & Contrôle Hydraulique',
		image: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		description: 'Dispositifs anti-retour et vannes de régulation hydraulique pour la protection de l’eau potable, la gestion de la pression et les réseaux d’eau automatisés, fabriqués par Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Prévention du Reflux' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/fr/" class="hover:text-blue-600">Accueil</a>
			<span>/</span>
			<a href="/fr/products/" class="hover:text-blue-600">Produits</a>
			<span>/</span>
			<span class="text-gray-600">Prévention du Reflux</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Protection de l’Eau Potable &amp; Contrôle Hydraulique</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Dispositifs Anti-Retour &amp; Vannes de Régulation Hydraulique</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid fabrique la gamme complète de sécurité hydraulique — dispositifs anti-retour anti-pollution HS41X, réducteurs de pression 500X, vannes de niveau F745X et vannes de régulation électromagnétiques GKZF-1 — protégeant les réseaux d’eau potable et automatisant le contrôle de la pression et du niveau dans un seul package coordonné.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Gamme de Vannes de Sécurité Hydraulique</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydraulicProducts.map(p => (
					<a href={`/fr/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Spécifications Clés</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Vanne</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Fonction</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Gamme de taille</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Classe</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">HS41X</td>
							<td class="px-4 py-3 text-gray-700">Prévention du reflux anti-pollution</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">500X</td>
							<td class="px-4 py-3 text-gray-700">Réduction / maintien de pression</td>
							<td class="px-4 py-3 text-gray-700">DN20 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">F745X</td>
							<td class="px-4 py-3 text-gray-700">Contrôle du niveau d’eau</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN400</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">GKZF-1</td>
							<td class="px-4 py-3 text-gray-700">Contrôle d’ouverture/fermeture par électrovanne</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN300</td>
							<td class="px-4 py-3 text-gray-700">300 PSI, AC220V/DC24V</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Dispositif anti-vortex</td>
							<td class="px-4 py-3 text-gray-700">Protection de l’aspiration de la pompe</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN1000</td>
							<td class="px-4 py-3 text-gray-700">EN12845 / GB50974</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Applications</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Contrôle des connexions croisées de l’eau potable (conduites incendie, irrigation, chaudières)</li>
				<li>Contrôle du niveau des réservoirs et citernes de toiture</li>
				<li>Gestion des zones de pression dans les réseaux municipaux et des bâtiments</li>
				<li>Réseaux d’eau automatisés avec contrôle à distance des vannes</li>
				<li>Protection de l’aspiration des pompes dans les réservoirs et citernes</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Questions Fréquentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Besoin d’un Package de Vannes Hydrauliques pour Votre Réseau ?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envoyez-nous votre DN, votre classe de pression et votre type de raccordement — nos ingénieurs répondent avec les courbes de perte de charge, les fiches techniques et un devis package sous 12 heures.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/fr/contact/?product=Pr%C3%A9vention%20du%20Reflux%20%26%20Contr%C3%B4le%20Hydraulique" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Demander un Devis</a>
						<a href="https://wa.me/8618684324501?text=Bonjour%2C%20j%27ai%20besoin%20d%27aide%20pour%20choisir%20des%20vannes%20de%20r%C3%A9gulation%20hydraulique" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Discuter sur WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
