---
import Layout from '../../layouts/Layout.astro';
import { productsFr } from '../../utils/products.fr';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';

const featuredProducts = productsFr.filter(p => [
  'resilient-seat-flanged-gate-valve-z41x',
  'indoor-fire-hydrant-head-sn65',
  'wet-alarm-check-valve-zsfz-150',
  'signal-grooved-wafer-butterfly-valve-dn80',
  'sliding-ball-check-valve-hq41x',
  'hydraulic-water-level-control-valve-f745x',
  'telescopic-y-strainer-sgl41h',
  'anti-collision-pressure-regulating-outdoor-hydrant-ssft100'
].includes(p.slug));

const categories = [
  { name: 'Vannes et Pièces', count: '150+', image: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp' },
  { name: 'Hydrants et Connexions de Pompe', count: '80+', image: '/assets/products/indoor-fire-hydrant-head-sn65.jpg' },
  { name: "Gicleurs et Vannes d'Alarme", count: '120+', image: '/assets/products/wet-alarm-check-valve-zsfz-150.webp' },
  { name: 'Sécurité Hydraulique', count: '60+', image: '/assets/products/adjustable-pressure-reducing-valve-500x.webp' },
  { name: "Canons d'Incendie", count: '40+', image: '/assets/products/manual-fire-water-cannon-ps.webp' },
  { name: "Armoires d'Incendie et Interfaces", count: '90+', image: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg' }
];

const productionSteps = [
  { step: '01', title: 'Tissage de Précision', desc: 'Tissage en polyester haute résistance pour des gaines de flexibles durables.', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
  { step: '02', title: 'Adhérence du Doublage', desc: 'Procédé de vulcanisation avancé pour un doublage caoutchouc étanche.', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { step: '03', title: 'Usinage CNC', desc: 'Usinage de précision des corps de vanne en fonte ductile et composants.', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
  { step: '04', title: 'Tests de Sécurité', desc: 'Essai de pression du corps et d’étanchéité à l’air à 100 % sur chaque unité.', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { step: '05', title: 'Revêtement Époxy', desc: 'Revêtement époxy non toxique pour une résistance anticorrosion supérieure.', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' }
];

const resources = [
  { href: '/fr/guides/fire-sprinkler-system-valves-guide/', eyebrow: 'Guide d’Achat', title: 'Guide des Vannes pour Réseaux de Gicleurs', desc: 'Groupes de vannes à mouillé, à déluge et à pré-action expliqués pour les acheteurs de réseaux de gicleurs.' },
  { href: '/fr/guides/fire-sprinkler-system-wet-dry-preaction/', eyebrow: 'Guide d’Achat', title: 'Systèmes de Gicleurs : à Mouillé, à Sec ou à Pré-action', desc: 'Comparez les types de systèmes et choisissez la bonne configuration selon le profil de risque de votre bâtiment.' },
  { href: '/fr/fire-water-cannon/', eyebrow: 'Aperçu du Système', title: 'Canons et Moniteurs d’Eau Anti-Incendie', desc: 'Moniteurs manuels PS et canons à suivi automatique ZDMS pour l’extinction dans les grands espaces.' },
  { href: '/fr/guides/how-to-choose-a-fire-hydrant/', eyebrow: 'Guide d’Achat', title: 'Comment Choisir un Hydrant', desc: 'Types d’hydrants, classes de pression, normes de raccordement et liste de commande usine.' },
  { href: '/fr/guides/how-to-choose-ul-listed-fire-valves/', eyebrow: 'Guide d’Achat', title: 'Comment Choisir des Vannes Incendie Certifiées UL', desc: 'Ce que signifie vraiment la certification UL, UL vs FM, et comment vérifier des certificats authentiques.' },
  { href: '/fr/guides/gate-valve-vs-butterfly-valve-fire-protection/', eyebrow: 'Guide d’Achat', title: 'Vanne à Boisseau vs Vanne à Papillon', desc: 'Comparaison du débit, de l’espace, du coût et du service pour les réseaux anti-incendie et les lignes de gicleurs.' }
];

const industries = [
  { name: 'Pétrole & Gaz', desc: 'Transport de fluides sécurisé dans des conditions industrielles extrêmes.', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { name: 'Traitement de l’Eau', desc: 'Réseaux municipaux d’approvisionnement, drainage et filtration.', icon: 'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3' },
  { name: 'Protection Incendie', desc: 'Hydrants certifiés, vannes de gicleurs et systèmes de suppression.', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' }
];
---

<Layout locale="fr" title="Wanlian Fluid | Fabricant de Vannes & Protection Incendie en Chine" description="Wanlian Fluid est un fabricant et exportateur de vannes industrielles et équipements de protection incendie basé à Quanzhou, pour projets B2B mondiaux. Lignes de production propres, usinage CNC, ISO 9001, devis sur demande.">
  <section class="relative bg-gray-900 text-white min-h-[85vh] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-r from-gray-900 via-gray-900/80 to-transparent z-10"></div>
      <img src="/og-image.jpg" alt="Wanlian Fluid produits de vanne industriels" class="w-full h-full object-cover object-center opacity-40" />
    </div>

    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="max-w-3xl space-y-8">
        <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full border border-white/20">
          <span class="flex h-2 w-2 rounded-full bg-brand-red animate-pulse"></span>
          <span class="text-sm font-bold tracking-widest uppercase">Fabricant &amp; Exportateur — Vannes &amp; Protection Incendie</span>
        </div>

        <h1 class="text-5xl sm:text-7xl font-black tracking-tight leading-[1.1]">
          Précision du Flux <br/>
          <span class="text-brand-red italic">Sécurité à l’Échelle Mondiale.</span>
        </h1>

        <p class="text-lg sm:text-xl text-gray-300 max-w-2xl leading-relaxed">
          Quanzhou Wanlian Fluid Equipment Co., Ltd. est située à Quanzhou, Fujian — point de départ de la Route de la Soie maritime et pôle central de l’industrie du plombage et des vannes en Chine. En tant qu’entreprise professionnelle d’équipements fluides intégrant R&amp;D, ventes et services, nous nous concentrons sur la fourniture de vannes de haute qualité, d’équipements anti-incendie, d’équipements de contrôle hydraulique et de solutions intégrées pour les secteurs industriel, municipal, protection incendie, approvisionnement en eau et assainissement.
        </p>

        <div class="flex flex-wrap gap-4 pt-4">
          <a href="/fr/products/" class="px-8 py-4 bg-brand-red hover:opacity-90 text-white font-bold rounded-lg transition shadow-xl shadow-brand-red/20 transform hover:-translate-y-1">
            Voir le Catalogue
          </a>
          <a href="/fr/contact/#inquiry" class="px-8 py-4 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white font-bold rounded-lg border border-white/30 transition">
            Demander un Devis
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="bg-gray-100 py-8 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-50 grayscale hover:grayscale-0 transition duration-500">
        <span class="text-gray-900 font-black text-xl tracking-tighter">DONNÉES TECHNIQUES</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">DESSINS DE PRODUIT</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">OPTIONS DE MATÉRIAUX</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">CLASSES DE PRESSION</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">OEM / ODM</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">SUPPORT EXPORT</span>
      </div>
    </div>
  </div>

  <section class="py-24 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="flex-1 space-y-8">
          <div class="space-y-4">
            <h2 class="text-sm font-black tracking-[0.3em] text-brand-red uppercase flex items-center gap-2">
              <span class="w-8 h-[2px] bg-brand-red"></span>
              Profil de l’Entreprise
            </h2>
            <h3 class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight leading-tight">
              Solutions de Contrôle Hydraulique <br/><span class="text-brand-blue">Pour les Projets Mondiaux.</span>
            </h3>
          </div>

          <div class="space-y-6 text-gray-600 text-lg leading-relaxed">
            <p>
              Basée à Quanzhou, Fujian — pôle central de l’industrie du plombage et des vannes en Chine — Quanzhou Wanlian Fluid Equipment Co., Ltd. fabrique et exporte des vannes industrielles, des produits de régulation hydraulique, des composants d’hydrants et des équipements de protection incendie pour des projets B2B internationaux. La fabrication s’effectue sur nos propres lignes de production à Quanzhou, certains articles étant fabriqués par des partenaires qualifiés ; les corps de vanne sont usinés par CNC et chaque unité passe un essai de pression du corps et d’étanchéité à l’air avant expédition, dans le cadre d’un système de management de la qualité ISO 9001.
            </p>
            <p>
              Nous construisons chaque page produit autour des spécifications que les acheteurs utilisent réellement — classe de pression, norme de raccordement, matériau du corps et de la garniture, application — avec des devis sur demande et un support technique pour l’approvisionnement en eau, le contrôle hydraulique industriel et les systèmes anti-incendie.
            </p>
          </div>

          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 pt-4">
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-red tabular-nums">{productsFr.length}+</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Modèles en Stock</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-blue tabular-nums">{categories.length}</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Lignes de Produits</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-red tabular-nums">100%</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Testés en Pression</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-blue tabular-nums">ISO 9001</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Système Qualité</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-3 pt-2">
            <span class="px-4 py-2 bg-brand-red/5 border border-brand-red/20 text-brand-red text-xs font-black uppercase tracking-widest rounded-full">R&amp;D · Ventes · Services</span>
            <span class="px-4 py-2 bg-brand-blue/5 border border-brand-blue/20 text-brand-blue text-xs font-black uppercase tracking-widest rounded-full">Certifié ISO 9001</span>
            <span class="px-4 py-2 bg-gray-100 border border-gray-200 text-gray-700 text-xs font-black uppercase tracking-widest rounded-full">OEM · ODM · Sur Mesure</span>
          </div>

          <a href="/fr/about/" class="inline-flex items-center gap-2 font-bold text-brand-blue hover:underline pt-2">
            Lire le Profil Complet <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="flex-1 relative">
          <div class="absolute -top-10 -left-10 w-40 h-40 bg-blue-100 rounded-full blur-3xl opacity-50 z-0"></div>
          <div class="relative z-10 rounded-2xl overflow-hidden shadow-2xl shadow-gray-200">
            <img src="/og-image.jpg" alt="Wanlian Fluid produits de vanne industriels" loading="lazy" class="w-full h-auto object-cover" />
            <div class="absolute bottom-0 left-0 right-0 p-8 bg-gradient-to-t from-black/80 to-transparent text-white">
              <p class="text-sm font-bold tracking-wide">Excellence Industrielle Professionnelle | Solutions Fluides B2B</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-gray-50 border-y border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <h2 class="text-4xl font-black text-gray-900 tracking-tight uppercase">Catégories de Produits Clés</h2>
        <div class="h-1.5 w-20 bg-brand-red mx-auto"></div>
        <p class="text-gray-500 font-medium italic">Ingénierie de haute précision pour les réseaux anti-incendie et d’eau mondiaux.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {categories.map(cat => (
          <a href={`/fr/products/#category=${encodeURIComponent(cat.name)}`} class="group relative bg-white rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-200">
            <div class="aspect-[4/3] overflow-hidden bg-gray-50 p-6 flex items-center justify-center">
              <img src={cat.image} alt={cat.name} loading="lazy" class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-6 bg-white/95 backdrop-blur-sm flex justify-between items-center group-hover:bg-brand-red group-hover:text-white transition-colors">
              <div>
                <h4 class="font-black text-lg">{cat.name}</h4>
                <p class="text-[10px] font-black uppercase tracking-widest opacity-60">Parcourir la gamme</p>
              </div>
              <span class="text-2xl font-light">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-4">
        <div class="space-y-4">
          <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Flux de Production</h2>
          <h3 class="text-4xl font-black text-gray-900 tracking-tight">Notre Processus de Fabrication</h3>
        </div>
        <p class="text-gray-500 max-w-md text-right hidden md:block">Chaque unité suit la même séquence contrôlée — de la coulée et l’usinage CNC aux essais de pression à 100 % et au revêtement époxy.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
        {productionSteps.map((step, idx) => (
          <div class="relative group">
            <div class="bg-gray-50 p-8 rounded-2xl border border-gray-100 space-y-4 h-full group-hover:bg-blue-50 transition-colors">
              <div class="text-4xl font-black text-gray-200 group-hover:text-brand-blue/20 transition-colors">{step.step}</div>
              <h4 class="font-bold text-gray-900">{step.title}</h4>
              <p class="text-sm text-gray-500 leading-relaxed">{step.desc}</p>
            </div>
            {idx < productionSteps.length - 1 && (
              <div class="hidden lg:block absolute top-1/2 -right-4 transform -translate-y-1/2 z-10">
                <svg class="w-8 h-8 text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-gray-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-16">
        <h2 class="text-4xl font-black text-gray-900 tracking-tight">Meilleures Ventes <span class="text-brand-red">Mondiales</span></h2>
        <a href="/fr/products/" class="text-brand-blue font-bold hover:underline">Catalogue Complet →</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {featuredProducts.map(product => (
          <div class="group bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300">
            <div class="aspect-square relative overflow-hidden bg-gray-50 p-6">
              <img src={product.image} alt={product.name} loading="lazy" class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute top-4 left-4 flex gap-2">
                <span class="px-2 py-1 bg-gray-900/80 text-white text-[10px] font-black uppercase tracking-widest rounded">
                  {product.category}
                </span>
              </div>
            </div>
            <div class="p-6 space-y-4">
              <h4 class="font-bold text-gray-900 line-clamp-2 min-h-[3rem] group-hover:text-brand-red transition-colors tracking-tight">{product.name}</h4>
              <div class="pt-4 border-t border-gray-100 flex gap-2">
                <a href={`/fr/products/${product.slug}/`} class="flex-1 py-2 text-center text-xs font-black border border-gray-200 rounded hover:bg-gray-50 transition">DÉTAILS</a>
                <a href={`/fr/contact/?product=${encodeURIComponent(product.name)}`} class="flex-1 py-2 text-center text-xs font-black bg-brand-red text-white rounded hover:opacity-90 transition">CONSULTER</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-12 gap-4">
        <h2 class="text-4xl font-black text-gray-900 tracking-tight">Gamme <span class="text-brand-blue">Complète</span></h2>
        <a href="/fr/products/" class="text-brand-red font-bold hover:underline shrink-0">Tous les Produits →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-1">
        {productsFr.map(product => (
          <a href={`/fr/products/${product.slug}/`} class="group flex items-center justify-between py-3 border-b border-gray-100 hover:border-brand-red transition-colors">
            <span class="text-sm font-semibold text-gray-700 group-hover:text-brand-red transition-colors line-clamp-1 pr-3">{product.name}</span>
            <span class="text-brand-blue opacity-0 group-hover:opacity-100 transition-opacity shrink-0">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-gray-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
        <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Ressources Techniques</h2>
        <h3 class="text-4xl font-black text-gray-900 tracking-tight">Guides de Sélection &amp; Aperçus de Systèmes</h3>
        <div class="h-1.5 w-20 bg-brand-red mx-auto"></div>
        <p class="text-gray-500 font-medium">Les fiches techniques sont utiles — le contexte technique est meilleur. Lisez avant de spécifier.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {resources.map(item => (
          <a href={item.href} class="group flex flex-col justify-between bg-white rounded-xl border border-gray-200 p-7 hover:border-brand-red hover:shadow-lg transition-all duration-300">
            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-brand-blue">{item.eyebrow}</span>
              <h4 class="mt-3 text-lg font-black text-gray-900 leading-snug group-hover:text-brand-red transition-colors">{item.title}</h4>
              <p class="mt-2 text-sm text-gray-500 leading-relaxed">{item.desc}</p>
            </div>
            <span class="mt-5 inline-flex items-center gap-1 text-brand-red font-bold text-xs group-hover:gap-2 transition-all">
              Lire la Ressource
              <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-gray-900 text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16 items-center">
        <div class="space-y-6">
          <h2 class="text-4xl font-black tracking-tight leading-tight">Conçu pour le <br/><span class="text-brand-blue">Service Haute Pression.</span></h2>
          <p class="text-gray-400">Notre ingénierie se concentre sur la durabilité et la fiabilité dans les infrastructures à risque et critiques.</p>
          <div class="pt-4">
            <a href="/fr/certificates/" class="inline-flex items-center gap-2 px-6 py-3 bg-white/5 border border-white/10 rounded-lg font-bold hover:bg-white/10 transition">
              Voir les Certifications &amp; Spécifications
            </a>
          </div>
        </div>
        <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-6">
          {industries.map(ind => (
            <div class="p-8 bg-white/5 border border-white/10 rounded-2xl hover:border-brand-blue/50 transition-colors">
               <div class="w-12 h-12 bg-brand-blue/20 rounded-lg flex items-center justify-center text-brand-blue mb-6">
                 <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={ind.icon}/></svg>
               </div>
               <h4 class="font-bold mb-2 uppercase tracking-wide">{ind.name}</h4>
               <p class="text-xs text-gray-400 leading-relaxed">{ind.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="inquiry" class="py-24 bg-white scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="space-y-8">
          <div class="space-y-4">
             <h2 class="text-4xl font-black text-gray-900 tracking-tight uppercase">Obtenez un Devis Professionnel</h2>
             <div class="h-1.5 w-20 bg-brand-red"></div>
          </div>
          <p class="text-lg text-gray-600 leading-relaxed">
            Soumettez vos plans techniques ou exigences produit. Nous examinerons les détails et vous recontacterons avec les informations produit et les étapes de devis appropriées.
          </p>
          <ul class="space-y-4">
            {['Devis sur demande', 'Support de sélection et application', 'Coordination de l’emballage export', 'Support documentation produit'].map(item => (
              <li class="flex items-center gap-3 text-gray-700 font-bold">
                <svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <InquiryForm />
      </div>
    </div>
  </section>

  <section class="py-24 bg-brand-red text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
      <h2 class="text-4xl sm:text-6xl font-black tracking-tight leading-tight">Prêt à Assurer la Sécurité à l’Échelle Mondiale ?</h2>
      <p class="text-xl text-white/80 max-w-2xl mx-auto">Contactez notre équipe pour la sélection de produits, la documentation technique et les devis sur demande.</p>
      <div class="flex justify-center gap-4">
        <a href="/fr/contact/#inquiry" class="px-10 py-5 bg-white text-brand-red font-black rounded-xl shadow-2xl hover:bg-gray-50 transition-transform hover:scale-105">
          Soumettre un Devis
        </a>
      </div>
    </div>
  </section>
</Layout>
