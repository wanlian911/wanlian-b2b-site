---
import Layout from '../../layouts/Layout.astro';
import { productsFr as products } from '../../utils/products.fr';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';
import LeadCaptureSection from '../../components/inquiry/LeadCaptureSection.astro';

const faq = [
  {
    question: 'Que fabrique et exporte Wanlian Fluid ?',
    answer: 'Wanlian Fluid est un fabricant et exportateur basé à Quanzhou, spécialisé dans les vannes industrielles et les équipements de protection incendie : vannes à siège élastique et à siège métallique, vannes papillon et soupapes anti-retour, hydrants et raccords, vannes d’alarme et gicleurs, flexibles d’incendie revêtus de caoutchouc — six gammes de produits et plus de 43 modèles disponibles.'
  },
  {
    question: 'Comment obtenir un prix pour une vanne ou un hydrant ?',
    answer: 'Le prix s’établit sur demande. Envoyez vos spécifications — modèle ou norme, diamètre, classe de pression, matériau, quantité et destination — et notre équipe vous répond par un devis détaillé sous 12 heures.'
  },
  {
    question: 'Chaque appareil est-il testé avant l’expédition ?',
    answer: 'Oui. Chaque vanne, hydrant et flexible est soumis à une épreuve de pression du corps et à un essai d’étanchéité à l’air avant expédition, avec enregistrement unitaire. La production est régie par un système de management de la qualité ISO 9001.'
  },
  {
    question: 'Proposez-vous la fabrication OEM ou sous marque privée ?',
    answer: 'Oui. L’OEM/ODM, la personnalisation de la marque et l’emballage export sont des services standards. La conformité à une norme précise (par exemple AWWA C502, listing UL ou approbation FM) est confirmée modèle par modèle, rapports d’essais et certificats à l’appui, avant toute commande.'
  }
];

// Category grid and the grouped catalog index are both derived from this locale's product
// module, so line names, counts and card photography cannot drift from the live catalog.
// is keyed by English category names, so it stays empty and each line uses its first photo.
const CATEGORY_LEAD: Record<string, string> = {};

const categoryNames: string[] = [...new Set(products.map(p => p.category))];

const categories = categoryNames.map(name => {
  const inCategory = products.filter(p => p.category === name);
  const lead = inCategory.find(p => p.slug === CATEGORY_LEAD[name]) ?? inCategory[0];
  return { name, count: inCategory.length, image: lead.image, leadName: lead.name, href: `/fr/products/#category=${encodeURIComponent(name)}` };
});

const catalogByCategory = categoryNames.map(name => ({
  name,
  href: `/fr/products/#category=${encodeURIComponent(name)}`,
  items: products.filter(p => p.category === name).map(p => ({ name: p.name, href: '/fr/products/' + p.slug + '/' }))
}));

const productionSteps = [{"step":"01","title":"Tissage de Précision","desc":"Tissage en polyester haute résistance pour des gaines de flexibles durables.","icon":"M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"},{"step":"02","title":"Adhérence du Doublage","desc":"Procédé de vulcanisation avancé pour un doublage caoutchouc étanche.","icon":"M13 10V3L4 14h7v7l9-11h-7z"},{"step":"03","title":"Usinage CNC","desc":"Usinage de précision des corps de vanne en fonte ductile et composants.","icon":"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"},{"step":"04","title":"Tests de Sécurité","desc":"Essai de pression du corps et d’étanchéité à l’air à 100 % sur chaque unité.","icon":"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"},{"step":"05","title":"Revêtement Époxy","desc":"Revêtement époxy non toxique pour une résistance anticorrosion supérieure.","icon":"M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"}];



// Own-name assurance only. Third-party listings belong to the factory that holds them, so this
// strip must never imply that Wanlian itself holds UL, FM, CE or LPCB listings.
const certifications = [{"name":"DONNÉES TECHNIQUES"},{"name":"DESSINS DE PRODUIT"},{"name":"OPTIONS DE MATÉRIAUX"},{"name":"CLASSES DE PRESSION"},{"name":"OEM / ODM"},{"name":"SUPPORT EXPORT"}];

const waCallbackHref = `https://wa.me/8618684324501?text=${encodeURIComponent('Bonjour, je suis intéressé par vos vannes et votre équipement de protection incendie.')}`;

const resources = [{"href":"/fr/guides/fire-sprinkler-system-valves-guide/","eyebrow":"Guide d’Achat","title":"Guide des Vannes pour Réseaux de Gicleurs","desc":"Groupes de vannes à mouillé, à déluge et à pré-action expliqués pour les acheteurs de réseaux de gicleurs."},{"href":"/fr/guides/fire-sprinkler-system-wet-dry-preaction/","eyebrow":"Guide d’Achat","title":"Systèmes de Gicleurs : à Mouillé, à Sec ou à Pré-action","desc":"Comparez les types de systèmes et choisissez la bonne configuration selon le profil de risque de votre bâtiment."},{"href":"/fr/fire-water-cannon/","eyebrow":"Aperçu du Système","title":"Canons et Moniteurs d’Eau Anti-Incendie","desc":"Moniteurs manuels PS et canons à suivi automatique ZDMS pour l’extinction dans les grands espaces."},{"href":"/fr/guides/how-to-choose-a-fire-hydrant/","eyebrow":"Guide d’Achat","title":"Comment Choisir un Hydrant","desc":"Types d’hydrants, classes de pression, normes de raccordement et liste de commande usine."},{"href":"/fr/guides/how-to-choose-ul-listed-fire-valves/","eyebrow":"Guide d’Achat","title":"Comment Choisir des Vannes Incendie Certifiées UL","desc":"Ce que signifie vraiment la certification UL, UL vs FM, et comment vérifier des certificats authentiques."},{"href":"/fr/guides/gate-valve-vs-butterfly-valve-fire-protection/","eyebrow":"Guide d’Achat","title":"Vanne à Boisseau vs Vanne à Papillon","desc":"Comparaison du débit, de l’espace, du coût et du service pour les réseaux anti-incendie et les lignes de gicleurs."}];

// On-site project evidence: real fire pump room installation (photos + portrait walkthrough video)
const projectPhotos = [
  { src: '/assets/projects/pump-skids.webp', alt: 'Rangée de groupes de pompes d’arroseur incendie avec étiquettes OPEN et CLOSE dans un local de pompes installé', caption: 'Groupes de pompes avec étiquettes OPEN/CLOSE' },
  { src: '/assets/projects/valve-train.webp', alt: 'Ligne de vannes à boisseau et manomètres sur montants rouges du local de pompes installé', caption: 'Montants et ligne de vannes à boisseau' },
  { src: '/assets/projects/riser-grid.webp', alt: 'Grille de montants avec gaines aérifères et chemins de câbles dans le local de pompes installé', caption: 'Grille de montants et gaines aérifères' },
  { src: '/assets/projects/pump-room-final.webp', alt: 'Local de pompes incendie installé, prêt pour la réception et la remise des clés', caption: 'Local de pompes avant remise des clés' },
];

const projectScope = [
  'Plusieurs groupes de pompes incendie et d’arroseur posés sur socles en béton',
  'Grille complète de montants avec vannes à boisseau, manomètres et étiquettes OPEN/CLOSE',
  'Gaines et chemins de câbles le long de la grille de montants',
  'Site prêt pour la réception finale et la remise des clés',
];

const industries = [{"name":"Pétrole & Gaz","desc":"Transport de fluides sécurisé dans des conditions industrielles extrêmes.","icon":"pipe"},{"name":"Traitement de l’Eau","desc":"Réseaux municipaux d’approvisionnement, drainage et filtration.","icon":"drop"},{"name":"Protection Incendie","desc":"Hydrants certifiés, vannes de gicleurs et systèmes de suppression.","icon":"flame"}];

type Clip = { src: string; poster: string; title: string; desc: string };

const clips = [{"src":"/videos/factory/assembly.mp4","poster":"/videos/factory/assembly-poster.webp","title":"Assemblage","desc":"Boulonnage contrôlé en couple sur vannes de contrôle hydraulique"},{"src":"/videos/factory/blue-valves.mp4","poster":"/videos/factory/blue-valves-poster.webp","title":"Inspection","desc":"Éprouvettes pressurisées alignées avant expédition"},{"src":"/videos/factory/red-field.mp4","poster":"/videos/factory/red-field-poster.webp","title":"Stock Disponible","desc":"Hydrants terminés mis en file avant expédition"},{"src":"/videos/factory/loading-close.mp4","poster":"/videos/factory/loading-close-poster.webp","title":"Conditionnement et Chargement","desc":"Commande export sur la barge, en boîte et cerclée"},{"src":"/videos/factory/dispatch.mp4","poster":"/videos/factory/dispatch-poster.webp","title":"Expédition","desc":"Camion entièrement chargé vers le port"}];

const walkthroughClip = {"src":"/assets/projects/project-walkthrough.mp4","poster":"/assets/projects/pump-room-wide.webp","title":"Vidéo sur Site"};

const stats = [
  { value: String(products.length), unit: '', label: "Modèles en Stock" },
  { value: String(categories.length), unit: '', label: "Lignes de Produits" },
  { value: '100', unit: '%', label: "Testés en Pression" },
  { value: 'ISO 9001', unit: '', label: "Système Qualité" }
];

const capability = [{"icon":"valve","title":"Lignes de Production Propres","body":"Usinage CNC, assemblage, essais de pression et revêtement sont réalisés sur nos propres lignes de l'usine de Quanzhou, avec une capacité partenaire qualifiée pour les pics de demande."},{"icon":"gauge","title":"Devis Détaillé en 12 Heures","body":"Envoyez des plans, des spécifications ou simplement une photo — nos ingénieurs répondent avec un devis détaillé, le stock et les délais en 12 heures, 7 jours sur 7."},{"icon":"doc","title":"Certifié, Testé Lot par Lot","body":"Chaque unité suit la même séquence contrôlée — de la coulée et l’usinage CNC aux essais de pression à 100 % et au revêtement époxy."}];

const svgOpen = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">';
const icons: Record<string, string> = {
  valve: svgOpen + '<path d="M4 16 12 9l8 7H4Z"/><path d="M12 9V4"/><path d="M8.5 4h7"/></svg>',
  gauge: svgOpen + '<circle cx="12" cy="10" r="6"/><path d="M12 10l3.2-2.6"/><path d="M6 20h12"/></svg>',
  cog: svgOpen + '<circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.4M12 18.6V21M3 12h2.4M18.6 12H21M5.6 5.6l1.7 1.7M16.7 16.7l1.7 1.7M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7"/></svg>',
  doc: svgOpen + '<path d="M7 3h7l4 4v14H7V3Z"/><path d="M14 3v4h4"/><path d="M10 12h6M10 16h6"/></svg>',
  flame: svgOpen + '<path d="M12 3c3 4 5 6 5 9a5 5 0 0 1-10 0c0-2.2 1.1-3.8 2.6-5.2"/></svg>',
  drop: svgOpen + '<path d="M12 3l5.4 7a6.4 6.4 0 1 1-10.8 0L12 3Z"/></svg>',
  pipe: svgOpen + '<path d="M3 8.5h7v7H3zM14 8.5h7v7h-7z"/><path d="M10 12h4"/><path d="M3 8.5v7M21 8.5v7"/></svg>',
  guide: svgOpen + '<path d="M4 5h7v15H4zM13 5h7v15h-7z"/><path d="M7 9h1M16 9h1"/></svg>',
  chat: svgOpen + '<path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9h8M8 12h5"/></svg>'
};
const tick = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9 17.5 20 6.5"/></svg>';
---

<Layout locale="fr" faq={faq} title="Wanlian Fluid | Fabricant de Vannes & Protection Incendie en Chine" description="Wanlian Fluid est un fabricant et exportateur de vannes industrielles et équipements de protection incendie basé à Quanzhou, pour projets B2B mondiaux. Lignes de production propres, usinage CNC, ISO 9001, devis sur demande." video={{ name: 'Wanlian Fluid en 50 Secondes', description: "Vidéo de présentation de l'entreprise : salle d'exposition, lignes de production, personnalisation OEM et contrôle qualité dans l'usine de Quanzhou.", thumbnail: '/videos/company-intro-poster.webp', src: '/videos/company-intro.mp4', duration: 'PT49S', uploadDate: '2026-09-18' }}>
  <div class="c68">

    <section class="c68-hero">
      <div class="c68-wrap c68-hero-grid">
        <div class="c68-rv">
          <p class="c68-eyebrow"><span class="c68-dot"></span>Fabricant &amp; Exportateur — Vannes &amp; Protection Incendie</p>
          <h1>Vannes &amp; Équipement de <em>Protection Incendie pour Projets Mondiaux.</em></h1>
          <p class="c68-rule" aria-hidden="true"></p>
          <p class="c68-lede">Vannes industrielles, bornes incendie et groupes de vannes d’alarme et d’arrosage : essai de pression à 100 %, ISO 9001, devis détaillé sous 12 heures.</p>
          <div class="c68-cta">
            <a class="c68-btn c68-btn-red" href="/fr/products/">Catalogue Complet</a>
            <a class="c68-btn c68-btn-ghost" href="/fr/contact/#inquiry">Demander un Devis</a>
          </div>
        </div>
        <figure class="c68-frame c68-rv">
          <span class="c68-frame-tab"></span>
          <img src="/assets/factory/plant-exterior.webp" alt="Wanlian Fluid plant exterior in Quanzhou, Fujian" decoding="async" />
          <figcaption>Images Réelles de Notre Usine</figcaption>
        </figure>
      </div>
      <div class="c68-stats">
        <div class="c68-wrap c68-stats-grid">
          {stats.map((s) => (
            <div class="c68-stat">
              <p class="c68-stat-num">{s.value}<span>{s.unit}</span></p>
              <p class="c68-stat-label">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="product-lines">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Catégories de Produits Clés</p>
          <h2>Ingénierie de haute précision pour les réseaux anti-incendie et d’eau mondiaux.</h2>
        </header>
        <div class="c68-lines">
          {categories.map((c) => (
            <a class="c68-line c68-rv" href={c.href}>
              <span class="c68-line-media"><img src={c.image} alt={c.leadName} loading="lazy" decoding="async" /></span>
              <span class="c68-line-body">
                <span class="c68-line-count">{c.count}</span>
                <span class="c68-line-name">{c.name}</span>
                <span class="c68-line-more">Parcourir la gamme <i aria-hidden="true">&rarr;</i></span>
              </span>
            </a>
          ))}
          <a class="c68-line c68-line-full c68-rv" href="/fr/products/">
            <span class="c68-line-body">
              <span class="c68-line-count">Tous les Produits</span>
              <span class="c68-line-name c68-line-name-inv">{products.length}</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="c68-band">
      <div class="c68-wrap">
        <div class="c68-cap-grid">
          {capability.map((c) => (
            <article class="c68-cap c68-rv">
              <span class="c68-ico" set:html={icons[c.icon]}></span>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="about">
      <div class="c68-wrap c68-profile-grid">
        <div class="c68-rv">
          <header class="c68-head">
            <p class="c68-kicker">Profil de l’Entreprise</p>
            <h2>Solutions de Contrôle Hydraulique <em>Pour les Projets Mondiaux.</em></h2>
          </header>
          <p class="c68-body">Basée à Quanzhou, Fujian — pôle central de l’industrie du plombage et des vannes en Chine — Quanzhou Wanlian Fluid Equipment Co., Ltd. fabrique et exporte des vannes industrielles, des produits de régulation hydraulique, des composants d’hydrants et des équipements de protection incendie pour des projets B2B internationaux. La fabrication s’effectue sur nos propres lignes de production à Quanzhou, certains articles étant fabriqués par des partenaires qualifiés ; les corps de vanne sont usinés par CNC et chaque unité passe un essai de pression du corps et d’étanchéité à l’air avant expédition, dans le cadre d’un système de management de la qualité ISO 9001.</p>
          <p class="c68-profile-link"><a href="/fr/about/">Accueil &rarr;</a><a href="/fr/applications/">Accueil &rarr;</a></p>
        </div>
        <div class="c68-shots">
          <figure class="c68-shot c68-rv">
            <img src="/assets/factory/workshop.webp" alt="Main workshop at the Quanzhou plant" loading="lazy" decoding="async" />
          </figure>
          <figure class="c68-shot c68-rv">
            <img src="/assets/factory/powder-coating.webp" alt="Powder coating line at the Quanzhou plant" loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class="c68-band" id="process">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Flux de Production</p>
          <h2>Notre Processus de Fabrication</h2>
        </header>
        <ol class="c68-steps">
          {productionSteps.map((s) => (
            <li class="c68-step c68-rv">
              <span class="c68-step-n">{s.step}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="c68-band c68-dark" id="factory">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker c68-kicker-red">Usine en Direct</p>
          <h2>Images Réelles de <em>Notre Usine</em></h2>
          <p class="c68-head-sub">Sans vidéo de stock, rien de simulé : le site de Quanzhou en action, de l'assemblage à l'expédition.</p>
        </header>
        <div class="c68-video-lead">
          <figure class="c68-vid c68-rv">
            <video src="/videos/company-intro.mp4" poster="/videos/company-intro-poster.webp" controls playsinline preload="none"></video>
            <figcaption><strong>Wanlian Fluid en 50 Secondes</strong><span>Salle d'exposition, lignes de production et contrôle qualité dans notre usine de Quanzhou — images réelles, sans vidéo de stock.</span></figcaption>
          </figure>
          <div class="c68-side">
            <ul class="c68-video-note">
              <li>Lire la vidéo de l'entreprise</li>
              <li>Voir les Certifications &amp; Spécifications</li>
            </ul>
            <div class="c68-side-shots">
              <figure class="c68-sshot c68-rv">
                <img src="/assets/factory/assembly.webp" alt="Assembly and finishing bay" loading="lazy" decoding="async" style="aspect-ratio: 5 / 2" />
                <figcaption>Assemblage</figcaption>
              </figure>
              <figure class="c68-sshot c68-rv">
                <img src="/assets/factory/fire-hose.webp" alt="Stock Disponible" loading="lazy" decoding="async" style="aspect-ratio: 5 / 2" />
                <figcaption>Stock Disponible</figcaption>
              </figure>
            </div>
          </div>
        </div>
        <div class="c68-clips">
          {clips.map((c) => (
            <figure class="c68-clip c68-rv">
              <video src={c.src} poster={c.poster} controls playsinline preload="none"></video>
              <figcaption><strong>{c.title}</strong><span>{c.desc}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Solutions Produit</p>
          <h2>Conçu pour le <em>Service Haute Pression.</em></h2>
          <p class="c68-head-sub"><a class="c68-inlink" href="/fr/applications/">Accueil &rarr;</a></p>
        </header>
        <div class="c68-ind">
          {industries.map((i) => (
            <a class="c68-ind-card c68-rv" href="/fr/applications/">
              <span class="c68-ico" set:html={icons[i.icon]}></span>
              <h3>{i.name}</h3>
              <p>{i.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band" id="quality">
      <div class="c68-wrap">
        <header class="c68-head">
          <h2>Tests de Sécurité</h2>
        </header>
        <div class="c68-cert-grid">
          {certifications.map((c) => (
            <div class="c68-cert c68-rv">
              <p class="c68-cert-name">{c.name}</p>
            </div>
          ))}
        </div>
        <div class="c68-chips">
          <a class="c68-chip c68-chip-link" href="/fr/certificates/">Certificats &rarr;</a>
          <a class="c68-chip c68-chip-link" href="/fr/faq/">Questions Fréquentes &rarr;</a>
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="resources">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Ressources Techniques</p>
          <h2>Guides de Sélection &amp; Aperçus de Systèmes</h2>
          <p class="c68-head-sub">Les fiches techniques sont utiles — le contexte technique est meilleur. Lisez avant de spécifier.</p>
        </header>
        <div class="c68-guides">
          {resources.map((r) => (
            <a class="c68-guide c68-rv" href={r.href}>
              <span class="c68-guide-eyebrow">{r.eyebrow}</span>
              <span class="c68-guide-title">{r.title}</span>
              <span class="c68-guide-desc">{r.desc}</span>
              <span class="c68-guide-more">Lire la Ressource <i aria-hidden="true">&rarr;</i></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band" id="projects">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Cas de Projets</p>
          <h2>Nos Projets <em>sur le Terrain</em></h2>
          <p class="c68-head-sub">Photos et vidéo d’un projet de local de pompes incendie — un vrai montage, prêt pour la réception.</p>
        </header>
        <div class="c68-proj-grid">
          <figure class="c68-vid c68-vid-tall c68-rv">
            <video src={walkthroughClip.src} poster={walkthroughClip.poster} controls playsinline preload="none"></video>
            <figcaption><strong>{walkthroughClip.title}</strong></figcaption>
          </figure>
          <div class="c68-proj-cards">
            {projectPhotos.map((s) => (
              <figure class="c68-pcard c68-rv">
