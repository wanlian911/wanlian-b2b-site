---
import Layout from '../../../layouts/Layout.astro';

const faq = [
  {
    question: "Combien de temps prend le processus d\'approvisionnement complet, de la spécification à l\'expédition ?",
    answer: "Pour les modèles en stock, il prend généralement quelques semaines : spécification et devis en quelques jours, commande d\'échantillon de 1 à 3 semaines, inspection par un tiers avant la série de production, puis fabrication et chargement du conteneur. Les articles OEM ou à marque personnalisée ajoutent un temps d\'outillage et de marquage. Wanlian Fluid répond à une spécification complète sous 12 heures, ce qui tient les premières étapes dans un planning serré."
  },
  {
    question: "Quels documents un fabricant chinois de vannes et d\'équipement incendie doit-il fournir avec l\'expédition ?",
    answer: "A minima : facture commerciale, bordereau de colisage, connaissement, certificat d\'origine, et les enregistrements d\'essai de pression de corps et d\'étanchéité à l\'air par lot / par unité qui concordent avec les numéros de série du bordereau de colisage. Ajoutez les certificats de matière (MTC) et les certificats normatifs spécifiques demandés. Un dossier complet et concordant est en soi un signal de qualité."
  },
  {
    question: "Dois-je commander un échantillon avant une commande de volume ?",
    answer: "Pour un équipement de sécurité incendie, oui. Un échantillon d\'une unité par modèle vous permet de vérifier la plaque signalétique, le numéro de série, la matière et une vidéo d\'essai de pression contre votre spécification avant d\'engager le volume. C\'est l\'assurance la moins chère contre les contrefaçons et le risque de spécification."
  },
  {
    question: "Comment comparer les devis d\'un fabricant chinois à ceux d\'un distributeur local ?",
    answer: "Comparez à base équivalente : même modèle, même norme, même matière, même quantité et même Incoterm. Utilisez d\'abord un outil de planification relatif pour dimensionner les leviers de coût (volume, Incoterm, destination), puis demandez des devis détaillés aux deux. Tenez compte du coût total rendu et du risque de coordonner vannes, hydrants et flexibles auprès de plusieurs fournisseurs."
  }
];

const steps = [
  {
    n: '01',
    title: "Rédiger la spécification à l\'écrit",
    body: "Fixez la norme (AWWA, ISO 5208, NFPA, NOM ou l\'exigence de l\'appel d\'offres), les tailles, les classes de pression, les matières, les quantités et la destination. L\'ambiguïté ici est le défaut le plus coûteux par la suite. Commencez par le vocabulaire commun du glossaire de l\'industrie pour que votre spécification, l\'appel d\'offres et le fournisseur signifient la même chose.",
    links: [
      { label: "Glossaire de l\'industrie", href: "/fr/glossary/" },
      { label: "Guide des normes hydrants, flexibles et vannes", href: "/fr/guides/fire-hydrant-valve-standards-guide/" }
    ]
  },
  {
    n: '02',
    title: "Qualifier et vérifier le fournisseur",
    body: "Confirmez l\'entité légale, le périmètre ISO 9001, l\'historique d\'exportation et la capacité de l\'usine. Menez un processus de détection pour écarter le risque de contrefaçon : demandez les enregistrements d\'essai par unité, vérifiez tout certificat auprès de l\'organisme émetteur et réclamez un échantillon. Un fournisseur qui résiste à la vérification a déjà répondu à la question.",
    links: [
      { label: "Checklist d\'approvisionnement B2B", href: "/fr/guides/b2b-valve-sourcing-checklist/" },
      { label: "Vérifier un fournisseur chinois de vannes", href: "/fr/guides/how-to-verify-chinese-valve-supplier/" },
      { label: "Détecter les vannes falsifiées et certificats falsifiés", href: "/fr/guides/detect-fake-valves-fire-equipment-counterfeits/" }
    ]
  },
  {
    n: '03',
    title: "Demander et comparer des devis détaillés",
    body: "Demandez un devis détaillé par modèle — pas un chiffre unique regroupé — et comparez à base équivalente selon la norme, la matière, la quantité et l\'Incoterm. Utilisez l\'estimateur de coûts relatif pour dimensionner l\'impact du volume, de la condition commerciale et de la destination avant de présenter le budget à votre équipe.",
    links: [
      { label: "Estimateur de coûts (indice relatif)", href: "/fr/cost-calculator/" },
      { label: "Exigences de certification des vannes incendie", href: "/fr/guides/latinamerica-certification-requirements-fire-valves/" }
    ]
  },
  {
    n: '04',
    title: "Commander un échantillon et l\'inspecter",
    body: "Achetez une unité de chaque modèle. Contrôlez la plaque signalétique, le numéro de série, la nuance de matière et une vidéo d\'essai de pression avec numéro de série contre votre spécification. Pour les commandes de volume, mandatez une agence tierce (SGS, Bureau Veritas, Intertek) pour assister aux essais et examiner les enregistrements dans l\'usine avant l\'expédition.",
    links: [
      { label: "Choisir un hydrant incendie", href: "/fr/guides/how-to-choose-a-fire-hydrant/" }
    ]
  },
  {
    n: '05',
    title: "Production, contrôle qualité et documentation",
    body: "Confirmez le planning de production, puis exigez le dossier documentaire avant le paiement final : facture commerciale, bordereau de colisage, certificat d\'origine et enregistrements d\'essai de pression de corps et d\'étanchéité à l\'air par unité rapprochés des numéros de série du bordereau. Le marquage OEM/ODM et l\'emballage d\'exportation sont appliqués à cette étape.",
    links: [
      { label: "Wanlian Fluid — usine et essais", href: "/fr/about/" }
    ]
  },
  {
    n: '06',
    title: "Logistique, Incoterms et après-vente",
    body: "Choisissez l\'Incoterm qui correspond à votre répartition des risques et des coûts (EXW, FOB, CIF, DDP), convenez du chargement du conteneur et conservez les enregistrements d\'essai et les certificats pour l\'acceptation et la maintenance future. Établissez un canal clair pour la garantie, les pièces de rechange et les commandes récurrentes.",
    links: [
      { label: "Demander un devis", href: "/fr/contact/" }
    ]
  }
];
---

<Layout
  title="Guide d'Approvisionnement : Vannes et Hydrants Incendie"
  description="Parcours d'achat B2B chez un fabricant chinois : spécification, vérification, échantillon, contrôle qualité et documentation — six étapes claires pour sécuriser votre commande."
  type="website"
  locale="fr"
  faq={faq}
  breadcrumbs={[{ name: 'Ressources' }, { name: "Guide d'Approvisionnement" }]}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
    <nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
      <a href="/fr/" class="hover:text-blue-600">Accueil</a>
      <span>/</span>
      <span class="text-gray-600">Guide d'Approvisionnement</span>
    </nav>

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
      <p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Pôle Approvisionnement</p>
      <h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Approvisionner des Vannes, Hydrants et Équipements Incendie : le Parcours Complet</h1>
      <p class="mt-5 text-gray-600 leading-relaxed text-lg">Une feuille de route d'achat B2B étape par étape pour acheter des vannes, hydrants et flexibles incendie chez un fabricant chinois — de la spécification écrite à l'après-vente. Chaque étape renvoie vers les guides, les outils et les documents dont vous avez besoin pour sécuriser la décision. Utilisez-la comme checklist et comme référence partagée avec vos équipes d'ingénierie et d'achat.</p>

      <div class="bg-blue-50 border border-blue-100 rounded-xl p-5 my-6">
        <p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-blue">Pourquoi une seule feuille de route :</strong> l'approvisionnement en équipement incendie échoue le plus souvent aux coutures — entre spécification, vérification, échantillonnage et documentation — et non à une seule étape. Parcourir les six étapes ci-dessous, dans l'ordre, avec les guides liés, détecte le risque avant que l'argent ne bouge.</p>
      </div>

      {steps.map(s => (
        <section class="mt-10">
          <h2 id={`step-${s.n}`} class="text-2xl font-black text-gray-900 mb-3 tracking-tight scroll-mt-24 flex items-center gap-3">
            <span class="text-brand-red text-2xl tabular-nums">{s.n}</span>{s.title}
          </h2>
          <p class="text-gray-700 leading-relaxed mb-3">{s.body}</p>
          <div class="flex flex-wrap gap-2">
            {s.links.map(l => (
              <a href={l.href} class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 hover:bg-brand-blue/10 text-gray-700 hover:text-brand-blue text-xs font-bold rounded-full transition">{l.label} →</a>
            ))}
          </div>
        </section>
      ))}

      <h2 id="documentation" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">Documentation à Exiger à Chaque Étape</h2>
      <div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Étape</th>
              <th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Demander</th>
              <th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Pourquoi c'est important</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <tr><td class="px-4 py-3 font-bold text-gray-900">Spécification</td><td class="px-4 py-3 text-gray-700">Norme écrite, tailles, classes, quantités, destination</td><td class="px-4 py-3 text-gray-700">Rend la conformité contractuelle, pas demandée</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">Vérification</td><td class="px-4 py-3 text-gray-700">Licence commerciale, périmètre ISO 9001, vidéo d'usine, numéros de certificats</td><td class="px-4 py-3 text-gray-700">Écarte les bureaux de négoce et les certificats falsifiés</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">Échantillonnage</td><td class="px-4 py-3 text-gray-700">Enregistrements d'essai par unité, MTC, vidéo d'essai de pression avec numéro de série</td><td class="px-4 py-3 text-gray-700">Confirme le produit réel avant le volume</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">Production</td><td class="px-4 py-3 text-gray-700">Planning, enregistrements d'essai par lot, échantillons de marquage OEM</td><td class="px-4 py-3 text-gray-700">Verrouille le planning et la marque avant chargement</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">Expédition</td><td class="px-4 py-3 text-gray-700">Facture, bordereau de colisage, connaissement, certificat d'origine, numéros de série concordants</td><td class="px-4 py-3 text-gray-700">Permet la douane, l'acceptation et la traçabilité</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">Après-vente</td><td class="px-4 py-3 text-gray-700">Conditions de garantie, canal pièces de rechange, prix de recommande</td><td class="px-4 py-3 text-gray-700">Maintient le projet accompagné sur sa durée de vie</td></tr>
          </tbody>
        </table>
      </div>

      <h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Questions Fréquentes</h2>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>

      <div class="mt-12 rounded-2xl overflow-hidden">
        <div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
          <h2 class="text-2xl font-black text-white tracking-tight">Démarrez votre Approvisionnement avec un Devis sous 12 Heures</h2>
          <p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envoyez votre spécification et votre destination — nous répondons avec un devis détaillé, l'approche d'essai par modèle et les options logistiques sous 12 heures.</p>
          <div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
            <a href="/fr/contact/?product=Projet%20d'Approvisionnement" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Demander un Devis</a>
            <a href="https://wa.me/8618684324501?text=Bonjour%2C%20j'approvisionne%20des%20vannes%2C%20des%20hydrants%20et%20des%20flexibles%20contre%20incendie%20et%20je%20souhaiterais%20un%20devis" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Discuter sur WhatsApp</a>
          </div>
        </div>
      </div>
    </article>
  </main>
</Layout>
