							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">HQ41X Bille Glissante</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">HQ44X Bille Sphérique</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Élément de fermeture</td>
							<td class="px-4 py-3 text-gray-700">Disque à charnière</td>
							<td class="px-4 py-3 text-gray-700">Bille recouverte de caoutchouc sur guides internes</td>
							<td class="px-4 py-3 text-gray-700">Sphère roulante recouverte de caoutchouc</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Perte de charge</td>
							<td class="px-4 py-3 text-gray-700">Référence</td>
							<td class="px-4 py-3 text-gray-700">Port plein, ~50 % de moins que le battant</td>
							<td class="px-4 py-3 text-gray-700">Canal à passage plein anti-obstruction</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Comportement de fermeture</td>
							<td class="px-4 py-3 text-gray-700">Le disque peut claquer à l’inversion rapide</td>
							<td class="px-4 py-3 text-gray-700">Fermeture silencieuse, sans coup de bélier</td>
							<td class="px-4 py-3 text-gray-700">Silencieux sans choc, faible débit de démarrage</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Résistance aux engorgements</td>
							<td class="px-4 py-3 text-gray-700">La charnière peut se gripper dans les fluides chargés</td>
							<td class="px-4 py-3 text-gray-700">La bille empêche les engorgements</td>
							<td class="px-4 py-3 text-gray-700">Passage plein anti-obstruction</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Installation</td>
							<td class="px-4 py-3 text-gray-700">Généralement horizontal</td>
