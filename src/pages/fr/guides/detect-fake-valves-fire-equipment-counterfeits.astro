const productRows = [
	{ slug: 'resilient-seat-flanged-gate-valve-z41x', name: 'Vanne à Boisseau à Joint Élastique, à Bride (Z41X)', img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp', desc: 'Vanne à boisseau pleine lumière pour réseaux incendie et conduites d’eau' },
