const products = [
	{ slug: 'suction-vortex-preventer-en12845', name: 'Dispositif Anti-Vortex d’Aspiration (EN12845)', img: '/assets/products/suction-vortex-preventer-en12845.webp', desc: 'SS304/316, DN50-DN1000, EN12845 & GB50974-2014' },
	{ slug: 'storz-coupling-2-5inch-aluminum', name: 'Raccord Storz 2,5\" en Aluminium', img: '/assets/products/storz-coupling-2-5inch-aluminum.webp', desc: 'Raccordement rapide de norme allemande, DN50-DN150, 1,6 MPa' },
	{ slug: 'abc-dry-powder-fire-extinguisher-5kg', name: 'Extincteur à Poudre Sèche ABC (5kg)', img: '/assets/products/abc-dry-powder-fire-extinguisher-5kg.webp', desc: 'Unité portable ISO 7165 pour feux de classe A/B/C/E' },
	{ slug: 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100', name: 'Hydrant Extérieur Anti-Collision (SSFT100)', img: '/assets/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100.webp', desc: 'À régulation de pression, sorties KWS65, PN16 fonte ductile' }
