const productRows = [
	{ slug: 'overground-fire-hydrant-ss100', name: 'Hydrant de rue antigel (SS100/65)', img: '/assets/products/overground-fire-hydrant-ss100.webp', desc: 'Hydrant à canon sec au modèle AWWA, 1,6 MPa, essai 2,4 MPa' },
