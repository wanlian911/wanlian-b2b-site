	{ slug: 'wet-alarm-check-valve-zsfz-150', name: 'Clapet de groupe d’alarme ZSFZ-150', img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp', desc: 'Groupe d’alarme sprinkler : gong + retard + détecteur' }
