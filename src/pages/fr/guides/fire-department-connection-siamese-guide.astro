	{ slug: 'sqd100-1-6-fire-pump-adapter', name: 'Adaptateur de Pompe Incendie SQD100-1.6 (Siamois)', img: '/assets/products/sqd100-1-6-fire-pump-adapter.webp', desc: '2 entrées DN65, sortie à bride DN100, 1,6 MPa' },
	{ slug: 'storz-coupling-2-5inch-aluminum', name: 'Raccord Storz 2,5\" (Norme Allemande)', img: '/assets/products/storz-coupling-2-5inch-aluminum.webp', desc: 'DN50-DN150, 1,6 MPa, aluminium auto-étanche' },
	{ slug: 'fire-hydrant-hose-coupling-adapter-hs', name: 'Adaptateur de Raccord HS', img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg', desc: 'DN50/DN65, GB12514, aluminium anodisé' },
