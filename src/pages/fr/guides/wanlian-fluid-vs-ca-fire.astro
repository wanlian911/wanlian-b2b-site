---
import Layout from '../../../layouts/Layout.astro'
import TableOfContents from '../../../components/sections/TableOfContents.astro'

const toc = [
	{ id: 'ca-fire-overview', label: '1. CA-FIRE : ce qu’ils sont réellement' },
	{ id: 'wanlian-fluid-overview', label: '2. Wanlian Fluid : ce qu’ils sont réellement' },
	{ id: 'product-lines-compared', label: '3. Comment leurs gammes produit se comparent-elles ?' },
