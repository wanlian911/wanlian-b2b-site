						<tr><td class="px-4 py-3 font-bold text-gray-900">Vannes d’alarme / déluge</td><td class="px-4 py-3 text-gray-700">Oui — alarme à eau DN50–DN200, déluge DN50–DN350, à brides &amp; cramponnées</td><td class="px-4 py-3 text-gray-700">Oui — ZSFZ-150 à eau, ZSFC à sec, ZSFM déluge, ZSFY pré-action</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Hydrants incendie</td><td class="px-4 py-3 text-gray-700">Multi-standards : BS 750, NF EN 14384, GOST, GB</td><td class="px-4 py-3 text-gray-700">Antigel SS100/65, anti-choc SSFT100/65, SA enterré, SN65 intérieur, hydrant intelligent IoT</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Vannes de commande hydraulique (500X / 100X / F745X)</td><td class="px-4 py-3 text-gray-700">Hors gamme publiée</td><td class="px-4 py-3 text-gray-700">Oui — PRV, flotteur distant, contrôle de niveau d’eau, anti-retour, anti-vortex</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Accessoires incendie (tuyaux, armoires, buses, extincteurs)</td><td class="px-4 py-3 text-gray-700">Hors gamme publiée</td><td class="px-4 py-3 text-gray-700">Oui — tuyau plat, colliers Storz, armoires extincteurs, enrouleurs, extincteurs ABC</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Systèmes à mousse</td><td class="px-4 py-3 text-gray-700">Cuves à vessie à mousse (ligne dédiée)</td><td class="px-4 py-3 text-gray-700">Armoire hydrant mousse (PSG30) ; proportion de mousse par projet</td></tr>
