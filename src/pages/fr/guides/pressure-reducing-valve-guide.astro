---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: "Comment un réducteur de pression hydraulique fonctionne-t-il sans électricité ?",
		answer: "Un réducteur de pression hydraulique autopiloté utilise une vanne pilote et la pression de la ligne elle-même comme force motrice. Le pilote détecte la pression aval : lorsqu'elle dépasse le point de consigne, le pilote se ferme légèrement, la pression monte dans la chambre à membrane et la vanne principale réduit ; lorsqu'elle baisse, le pilote décharge la chambre et la vanne principale s'ouvre davantage. Aucune source d'énergie externe n'est nécessaire."
	},
	{
		question: "Quelle plage de pression aval le réducteur de pression 500X peut-il maintenir ?",
		answer: "Le réducteur de pression hydraulique réglable 500X Wanlian couvre DN20-DN600 (3/4\" à 24\") avec une pression aval réglable de 0,1 MPa à 1,6 MPa. Le corps de vanne est classé à 1,0 MPa, 1,6 MPa ou 2,5 MPa de pression nominale, indiquez donc votre pression d'entrée et la pression de consigne requise lors de la demande de devis."
	},
	{
		question: "Quelle est la différence entre un réducteur de pression 500X et une vanne de régulation de niveau F745X ?",
		answer: "Le réducteur de pression 500X maintient une pression aval constante quel que soient les fluctuations de débit. La vanne de contrôle de niveau hydraulique F745X maintient à la place un niveau d'eau prédéfini dans un réservoir, une cuve ou un château d'eau, en utilisant un pilote à flotteur pour ouvrir et fermer la vanne principale lorsque le niveau varie. Les deux sont des vannes de contrôle hydraulique autopilotées sans énergie externe."
	},
	{
		question: "Quand choisir la F745X plutôt que la vanne à flotteur 100X-16P à commande à distance ?",
		answer: "La F745X (DN50-DN400, 1,0/1,6 MPa, fonte ductile QT450-10) est le choix standard pour les grands réservoirs et châteaux d'eau. La vanne à flotteur à commande à distance 100X-16P (DN40-DN300, 0-1,0 MPa) a un corps en acier inoxydable fondu CF8, ce qui convient aux fluides corrosifs, aux exigences d'hygiène élevées ou aux installations proches de l'eau de mer, et peut être commandée à distance avec un pilote à flotteur."
	},
	{
		question: "Pourquoi un filtre en Y est-il recommandé en amont des vannes de contrôle hydrauliques ?",
		answer: "Les vannes de contrôle hydraulique sont pilotées par un pilote, et leurs orifices de pilote et vannes à aiguille sont sensibles aux particules. Le filtre en Y télescopique SGL41H est installé à l'entrée de la vanne pour filtrer les impuretés, avec des tamis en acier inoxydable 304/316 (18-30 mailles pour l'eau). Son joint de dilatation intégré télescopique permet de retirer la vanne pour maintenance sans couper la canalisation."
	},
	{
		question: "Les vannes hydrauliques à fermeture lente aident-elles à prévenir le coup de bélier ?",
		answer: "Oui. Le 500X et le F745X sont conçus avec une action de fermeture en douceur et lente, de sorte que la vanne ne se referme pas brutalement à l'arrêt du flux, ce qui évite les surpressions destructrices et le coup de bélier dans le réseau. Pour les lignes d'aspiration de pompes, ajoutez un dispositif anti-vortex d'aspiration EN12845 pour stopper l'entraînement d'air qui peut causer la cavitation et les pics de pression."
	}
];

const toc = [
	{ id: 'what-is-hydraulic-prv', label: '1. Qu’est-ce qu’un réducteur de pression hydraulique ?' },
	{ id: 'how-pilot-prv-works', label: '2. Comment fonctionne le réducteur 500X autopiloté' },
	{ id: 'hydraulic-control-valve-comparison', label: '3. Réducteur vs contrôle de niveau vs vanne à flotteur' },
	{ id: 'typical-applications', label: '4. Où chaque vanne a sa place' },
	{ id: 'installation-and-protection', label: '5. Installation et protection' },
	{ id: 'specification-checklist', label: "6. Checklist de spécification B2B" },
	{ id: 'faq', label: 'Questions Fréquentes' }
];

const products = [
	{ slug: 'adjustable-pressure-reducing-valve-500x', name: 'Réducteur de Pression Hydraulique 500X', img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp', desc: 'DN20-DN600, réglable 0,1-1,6 MPa' },
	{ slug: 'hydraulic-water-level-control-valve-f745x', name: 'Vanne de Contrôle de Niveau Hydraulique F745X', img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp', desc: 'Pilote à flotteur DN50-DN400, contrôle de niveau de cuve' },
	{ slug: 'remote-control-float-valve-100x', name: 'Vanne à Flotteur 100X-16P à Commande à Distance (CF8)', img: '/assets/products/remote-control-float-valve-100x.webp', desc: 'Acier inoxydable, DN40-DN300, 0-1,0 MPa' },
	{ slug: 'groove-solenoid-control-gate-valve-gkzf1', name: 'Vanne à Boisseau de Régulation Électromagnétique GKZF-1', img: '/assets/products/groove-solenoid-control-gate-valve-gkzf1.jpg', desc: 'DN50-DN300, AC220V/DC24V, 300 PSI' }
