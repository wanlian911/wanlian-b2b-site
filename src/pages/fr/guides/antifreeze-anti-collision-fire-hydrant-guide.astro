];

// 关联产品(slug 与 products.ts 一致)
const products = [
	{ slug: 'overground-fire-hydrant-ss100', name: 'Hydrant Antigel (SS100/65)', img: '/assets/products/overground-fire-hydrant-ss100.webp', desc: 'DN100, 1,6 MPa, drainage antigel auto, 2x65 + 1x100' },
	{ slug: 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100', name: 'Hydrant Anti-Collision (SSFT100/65)', img: '/assets/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100.webp', desc: 'Coupure par boulons de cisaillement, régulation de pression, auto-vidange' },
	{ slug: 'iot-smart-ground-fire-hydrant-ss100zn', name: 'Hydrant Intelligent IoT (SS100/65-1.6ZN)', img: '/assets/products/iot-smart-ground-fire-hydrant-ss100zn.webp', desc: 'NB-IoT/4G, capteurs d’inclinaison & de pression, batterie 5 ans' },
	{ slug: 'fire-hydrant-hose-coupling-adapter-hs', name: 'Adaptateur de Raccord d’Hydrant (Série HS)', img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg', desc: 'DN50/DN65, 1,6 MPa, aluminium auto-étanche' }
