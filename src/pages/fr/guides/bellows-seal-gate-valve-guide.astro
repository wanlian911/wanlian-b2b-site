const faq = [
	{
		question: "Quelle est la différence entre une vanne à boisseau à joint membrane et une vanne à boisseau standard ?",
		answer: "Une vanne à boisseau standard s'appuie uniquement sur la garniture de tige pour étancher autour de la tige mobile. Une vanne à boisseau à joint membrane ajoute un joint membrane métallique soudé entre la tige et le bonnet, créant une deuxième barrière sans fuite. Si le joint membrane venait à céder, la garniture tient toujours — c'est pourquoi on la décrit comme une conception à double étanchéité avec zéro fuite fugitive."
	},
	{
		question: "Quels fluides nécessitent des vannes à boisseau à joint membrane ?",
		answer: "Les vannes à boisseau à joint membrane sont typiquement spécifiées pour l'huile thermique, la vapeur et l'eau à haute température, où la fuite de tige est un problème de sécurité et d'efficacité. Elles sont aussi couramment choisies pour les fluides toxiques, inflammables ou dangereux où les émissions fugitives doivent être minimisées et pour les systèmes soumis à une réglementation environnementale stricte."
	},
	{
		question: "Quelles tailles et classes de pression sont disponibles pour les vannes membrane Wanlian ?",
		answer: "Notre vanne à boisseau à joint membrane manuelle à bride couvre DN15-DN300 (1/2\" à 12\") à des pressions de travail de 1,6 à 4,0 MPa (Classe 150/300), avec une plage de température de travail de -29°C à 425°C. Les corps sont en acier forgé (A105) ou acier fondu (WCB), et le joint membrane est en acier inoxydable 304 ou 316Ti."
	},
	{
		question: "Les vannes à boisseau à joint membrane sont-elles conformes aux normes internationales ?",
		answer: "Les vannes à boisseau à joint membrane Wanlian sont fabriquées pour se conformer aux normes GB, ANSI, DIN et JIS, avec des classes de pression exprimées à la fois en termes métriques (MPa) et en classes ANSI. Confirmez la norme dimensionnelle et de pression exacte exigée par votre projet avant de commander."
	},
	{
		question: "Comment vérifier la qualité d'une vanne à joint membrane avant de commander ?",
		answer: "Demandez les rapports d'essai de pression du corps et du siège pour le lot réel, les certificats de matière pour le corps et le joint membrane, et confirmez le matériau du joint membrane (304/316Ti) et la norme de soudage dans le devis. Une inspection par un tiers avant expédition peut être organisée."
	}
];

const toc = [
	{ id: 'what-is-bellows-gate-valve', label: "1. Qu'est-ce qu'une vanne à boisseau à joint membrane ?" },
	{ id: 'how-bellows-seal-works', label: '2. Comment fonctionne la double étanchéité' },
	{ id: 'where-bellows-valves-are-specified', label: '3. Où les vannes membrane sont spécifiées' },
	{ id: 'standards-and-pressure-classes', label: '4. Normes et classes de pression' },
	{ id: 'bellows-vs-standard-gate-valve', label: '5. Vanne membrane vs vanne à boisseau standard' },
	{ id: 'specification-checklist', label: "6. Checklist de spécification B2B" },
	{ id: 'faq', label: 'Questions Fréquentes' }
];

const products = [
	{ slug: 'flange-manual-bellows-gate-valve', name: 'Vanne à Boisseau à Bride Manuelle avec Joint à Membrane', img: '/assets/products/flange-manual-bellows-gate-valve.webp', desc: 'Acier forgé/fondu, DN15-DN300, Classe 150/300' },
	{ slug: 'z85x-stainless-steel-grooved-gate-valve', name: 'Vanne à Boisseau à Gorge en Acier Inoxydable Z85X', img: '/assets/products/z85x-stainless-steel-grooved-gate-valve.webp', desc: 'Vanne à boisseau en fonte 316 (CF8M) pour services corrosifs' },
	{ slug: 'brass-gate-valve-z15w-16t', name: 'Vanne à Boisseau en Laiton Forgé ANSI (Z15W-16T)', img: '/assets/products/brass-gate-valve-z15w-16t.webp', desc: 'Vanne à boisseau filetée NPT pour lignes d’huile et d’eau' }
