---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'step-1-verify-company', label: '1. Vérifier l’entreprise, pas la brochure' },
	{ id: 'step-2-match-standard', label: '2. Corriger le produit à la norme de votre bon de commande' },
	{ id: 'step-3-demand-testing', label: '3. Exiger des essais par unité et par un tiers' },
	{ id: 'step-4-counterfeit-red-flags', label: '4. Connaître les signaux d’alerte contrefaçon' },
	{ id: 'step-5-documentation', label: '5. Verrouiller la documentation avant de payer' },
	{ id: 'wanlian-verification', label: "6. Comment Wanlian Fluid gère la vérification" },
	{ id: 'faq', label: 'Questions Fréquentes' },
	{ id: 'sources', label: 'Sources' }
];

const faq = [
	{
		question: 'Un certificat ISO 9001 suffit-il pour faire confiance à un fournisseur chinois ?',
		answer: 'Non — c’est un point de départ. Vérifiez que le certificat est à jour et dans le périmètre avec l’organisme émetteur, puis combinez-le avec un audit d’usine en direct et une inspection par un tiers. L’ISO 9001 certifie un système de management de la qualité, pas la conformité d’un produit unique.'
	},
	{
		question: 'Quels essais les hydrants doivent-ils passer avant l’expédition d’export ?',
		answer: 'Au minimum, l’essai de pression du corps et l’essai de siège/étanchéité selon la norme spécifiée (par exemple AWWA C502 ou EN 14384). Demandez les enregistrements d’essai par unité et, pour les projets critiques, des essais témoin par un tiers avant expédition.'
	},
	{
		question: 'Ai-je besoin d’une approbation UL ou FM pour importer de l’équipement incendie de Chine ?',
		answer: 'Uniquement si votre marché de destination ou votre contrat l’exige — typiquement pour les composants de systèmes de protection incendie aux États-Unis/au Canada. La plupart des projets municipaux et industriels internationaux fonctionnent plutôt sur des spécifications AWWA, EN, BS ou ISO.'
	},
	{
		question: 'Comment vérifier que le certificat d’un fabricant chinois est authentique ?',
		answer: 'Demandez le numéro de certificat et vérifiez-le directement auprès de l’organisme émetteur ou de la base de données d’accréditation nationale. Traitez les images de certificats jointes aux e-mails comme non vérifiées jusqu’à ce que vous les confirmiez de façon indépendante.'
	},
	{
		question: 'Combien coûte une inspection par un tiers ?',
		answer: 'Typiquement une petite fraction de la valeur du conteneur, selon l’agence, le périmètre et le lieu. Pour les premières commandes d’équipement de sécurité incendie, c’est l’assurance la moins chère disponible.'
	},
	{
		question: 'Puis-je commander des échantillons ou un premier petit lot avant de m’engager ?',
		answer: 'Oui — les fabricants réputés, y compris Wanlian Fluid, prennent en charge les commandes d’échantillon et les premières commandes sur demande. Utilisez le tour d’échantillon pour passer votre propre checklist d’inspection avant d’augmenter le volume.'
	}
];

const productRows = [
	{ slug: 'overground-fire-hydrant-ss100', name: 'Hydrant Extérieur Antigel (SS100/65)', img: '/assets/products/overground-fire-hydrant-ss100.webp', desc: 'Hydrant extérieur à barillet sec antigel pour réseaux incendie municipaux' },
	{ slug: 'resilient-seat-flanged-gate-valve-z41x', name: 'Vanne à Boisseau à Bride en Fonte Ductile, Siège Élastomère (Z41X)', img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp', desc: 'Vanne d’isolement à passage plein pour conduites d’eau et lignes incendie' },
	{ slug: 'fire-hose-pvc-rubber-lining-8-65', name: 'Flexible Anti-Incendie Plat à Doublure PVC (Modèle 8-65)', img: '/assets/products/fire-hose-pvc-rubber-lining-8-65.jpg', desc: 'Flexible plat à doublure caoutchouc pour la lutte incendie et le transfert d’eau' }
