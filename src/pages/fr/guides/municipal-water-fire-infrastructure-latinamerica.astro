							<td class="px-4 py-3 text-gray-700">Gaine polyester, doublure caoutchouc vulcanisé, plat</td>
							<td class="px-4 py-3 text-gray-700"><a href="/fr/products/fire-hose-pvc-rubber-lining-8-65/" class="text-brand-blue font-semibold hover:underline">Flexible Anti-Incendie Plat à Doublure Caoutchouc PVC (Modèle 8-65)</a></td>
							<td class="px-4 py-3 text-gray-700">Cadrage NFPA 1961 ; type de raccord spécifié</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Raccords</td>
							<td class="px-4 py-3 text-gray-700">Storz (norme allemande), 2,5&quot;</td>
							<td class="px-4 py-3 text-gray-700"><a href="/fr/products/storz-coupling-2-5inch-aluminum/" class="text-brand-blue font-semibold hover:underline">Raccord Storz 2,5&quot; en Aluminium (Norme Allemande)</a></td>
