---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'project-scope', label: '1. Ce Que Contient Vraiment un Périmètre Eau & Incendie Municipal' },
	{ id: 'standards-regimes', label: '2. Régimes de Normes de la Région : Ce Que l’Appel d’Offres Peut Exiger' },
	{ id: 'one-purchase-order', label: '3. Comment un Seul Bon de Commande Réduit le Risque de Coordination' },
	{ id: 'selection-matrix', label: '4. Matrice de Sélection : Composant, Spécification Typique, Modèle Recommandé' },
	{ id: 'specification-documentation', label: '5. Spécification & Documentation à Demander' },
	{ id: 'procurement-checklist', label: '6. Checklist d’Approvisionnement Municipal' },
	{ id: 'faq', label: 'Questions Fréquentes' },
	{ id: 'sources', label: 'Sources' }
];

const faq = [
	{
		question: 'Un seul fournisseur peut-il vraiment couvrir hydrants, vannes, flexibles et anti-retour pour un projet municipal ?',
		answer: 'Oui. Wanlian Fluid exploite ses propres lignes de production à Quanzhou, avec des articles sélectionnés fabriqués par des partenaires de fabrication qualifiés, et consolide hydrants, vannes à boisseau et de contrôle, flexibles anti-incendie, raccords et dispositifs anti-retour sous un seul bon de commande. Cela signifie une traçabilité documentaire unique, un point d’inspection unique et un fabricant responsable unique pour tout l’ensemble.'
	},
	{
		question: 'Quelles normes mon appel d’offres LatAm nommera-t-il réellement ?',
		answer: 'Cela dépend du pays et de savoir si le périmètre suit une référence américaine, européenne ou nationale. Les appels d’offres mexicains citent fréquemment les NOM ; le Brésil cite les ABNT ; les travaux de spécification US ou de ré-exportation peuvent citer AWWA, NFPA ou UL/FM ; beaucoup de projets référencent EN ou ISO. Lisez toujours d’abord la norme nommée dans la spécification — la conformité à une norme spécifique doit être confirmée par modèle, avec rapports d’essai et certificats, avant la commande.'
	},
	{
		question: 'Wanlian Fluid détient-il la certification AWWA, NOM ou ABNT ?',
		answer: 'Wanlian Fluid fonctionne selon un système de management de la qualité ISO 9001 et effectue un essai de pression de chaque unité avant expédition. La qualification par norme spécifique est traitée par modèle : envoyez la norme de votre spécification et l’équipe confirmera la conformité, avec rapports d’essai et certificats assortis, pour les modèles exacts que vous commandez avant votre engagement.'
	},
	{
		question: 'Que signifie « essai par unité » concrètement pour ma commande ?',
		answer: 'Cela signifie que la coque de chaque unité individuelle est soumise à un essai de pression puis à un essai d’étanchéité à l’air avant d’être conditionnée — et non un échantillon prélevé sur le lot. Pour un équipement incendie critique pour la sécurité, c’est le socle responsable, et il est documenté par unité afin que votre inspecteur puisse le retracer.'
	},
	{
		question: 'Combien de temps avant d’avoir un devis pour un ensemble complet ?',
		answer: 'Envoyez votre spécification et votre destination. Wanlian Fluid s’engage à répondre avec un devis détaillé dans les 12 heures, en détaillant chaque composant, taille, classe de pression et référence de norme, afin que vous puissiez comparer ligne par ligne avec votre appel d’offres.'
	}
];

const productRows = [
	{ slug: 'overground-fire-hydrant-ss100', name: 'Hydrant Extérieur Antigel (SS100/65)', img: '/assets/products/overground-fire-hydrant-ss100.webp', desc: 'Hydrant extérieur pour réseaux municipaux d’eau et d’incendie' },
	{ slug: 'resilient-seat-flanged-gate-valve-z41x', name: 'Vanne à Boisseau à Siège Élastomère à Bride (Z41X)', img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp', desc: 'Vanne d’isolement à passage plein pour conduites principales et lignes incendie' },
	{ slug: 'fire-hose-pvc-rubber-lining-8-65', name: 'Flexible Anti-Incendie Plat à Doublure Caoutchouc PVC (Modèle 8-65)', img: '/assets/products/fire-hose-pvc-rubber-lining-8-65.jpg', desc: 'Flexible plat à doublure caoutchouc pour la lutte incendie et le transfert d’eau' }
