---
import Layout from '../../layouts/Layout.astro';
import { guidesFr } from '../../utils/guides.fr';

// Pages système / solutions (pas des articles-guides, affichées en groupe séparé)
const solutions = [
  {
    title: 'Solution : systèmes d’hydrants',
    description: 'Hydrants intérieurs, extérieurs, anti-collision et intelligents IoT pour les réseaux municipaux, les sites industriels et les villes intelligentes.',
    href: '/fr/fire-hydrant-systems/',
    date: '2026',
    category: 'Solution produit',
    readTime: '5 min de lecture'
  },
  {
    title: 'Solution : prévention du reflux et contrôle hydraulique',
    description: 'Dispositifs anti-retour, vannes de réduction de pression, vannes de contrôle de niveau et vannes électromagnétiques pour l’eau potable et la sécurité hydraulique.',
    href: '/fr/backflow-prevention/',
    date: '2026',
    category: 'Solution produit',
    readTime: '5 min de lecture'
  },
  {
    title: 'Applications : protection incendie, réseaux d’eau et canalisations industrielles',
    description: 'Sélection de produits par application : de l’eau municipale et du CVC aux projets pétroliers, de stockage et maritimes.',
    href: '/fr/applications/',
    date: '2026',
    category: 'Applications',
    readTime: '5 min de lecture'
  },
  {
    title: 'Vannes incendie UL, systèmes de gicleurs et moniteurs d’eau',
    description: 'Les divisions de solutions Wanlian : vannes incendie UL, systèmes de gicleurs et moniteurs d’eau — avec guide technique et lien pour devis.',
    href: '/fr/ul-fire-valves/',
    date: '2026',
    category: 'Solution produit',
    readTime: '5 min de lecture'
  },
  {
    title: 'Solution : canons d’eau anti-incendie',
    description: 'Canons d’eau manuels et automatiques pour raffineries, entrepôts, aéroports et autres sites à haut risque.',
    href: '/fr/fire-water-cannon/',
    date: '2026',
    category: 'Solution produit',
    readTime: '5 min de lecture'
  },
  {
    title: 'Solution : systèmes de gicleurs',
    description: 'Vannes d’alarme à mouillé, vannes à déluge, systèmes à pré-action et signalisateurs de débit pour les gicleurs de bâtiments commerciaux, industriels et de stockage.',
    href: '/fr/fire-sprinkler-systems/',
    date: '2026',
    category: 'Solution produit',
    readTime: '5 min de lecture'
  }
];
---

<Layout
  title="Blog et Guides d’Approvisionnement | Wanlian Fluid Equipment"
  description="Guides techniques d’approvisionnement et connaissances sectorielles : équipements de protection incendie, vannes industrielles et systèmes de contrôle des fluides de Wanlian Fluid."
  locale="fr"
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Blog et Guides</span>
      <h1 class="text-4xl font-black text-gray-900 tracking-tight">Guides d’approvisionnement &amp; connaissances sectorielles</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
        Des connaissances ingénierie et approvisionnement pratiques pour les projets de protection incendie et de contrôle des fluides.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {guidesFr.map(article => (
        <a
          href={article.href}
          class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-8 flex flex-col"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2.5 py-1 bg-brand-blue/10 text-brand-blue text-[11px] font-black rounded-full uppercase tracking-wider">{article.category}</span>
            <span class="text-xs text-gray-400">{article.date} · {article.readTime}</span>
          </div>
          <h2 class="text-lg font-black text-gray-900 group-hover:text-brand-blue transition leading-snug mb-3">
            {article.title}
          </h2>
           <p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p>
           {article.tocPreview && article.tocPreview.length > 0 && (
             <div class="mt-4 rounded-lg border border-gray-100 bg-gray-50 px-4 py-3">
               <p class="mb-2 text-[10px] font-black uppercase tracking-widest text-brand-red">Dans Ce Guide</p>
               <ol class="space-y-1">
                 {article.tocPreview.map((item, i) => (
                   <li class="flex items-baseline gap-2 text-xs leading-snug text-gray-500">
                     <span class="shrink-0 font-black tabular-nums text-gray-300">{String(i + 1).padStart(2, '0')}</span>
                     <span class="font-medium">{item}</span>
                   </li>
                 ))}
               </ol>
             </div>
           )}
           <div class="flex flex-wrap gap-2 mt-4">
            {article.tags.map(tag => (
              <a href={`/fr/tags/${tag}/`} class="text-[10px] font-bold text-gray-400 uppercase tracking-wider hover:text-brand-blue transition">#{tag.replace(/-/g, ' ')}</a>
            ))}
          </div>
          <span class="mt-6 inline-flex items-center text-brand-red font-bold text-sm group-hover:gap-2 transition-all">
            Lire le guide
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-16 mb-8 flex items-center gap-4">
      <h2 class="text-2xl font-black text-gray-900 tracking-tight">Solutions Produits</h2>
      <div class="flex-1 h-px bg-gray-200"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {solutions.map(article => (
        <a
          href={article.href}
          class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-red/30 transition p-8 flex flex-col"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2.5 py-1 bg-brand-red/10 text-brand-red text-[11px] font-black rounded-full uppercase tracking-wider">{article.category}</span>
            <span class="text-xs text-gray-400">{article.date} · {article.readTime}</span>
          </div>
          <h2 class="text-lg font-black text-gray-900 group-hover:text-brand-red transition leading-snug mb-3">
            {article.title}
          </h2>
          <p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p>
          <span class="mt-6 inline-flex items-center text-brand-blue font-bold text-sm group-hover:gap-2 transition-all">
            Voir la solution
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4">
      <h2 class="text-2xl font-black">Besoin d’une consultation technique précise ?</h2>
      <p class="text-gray-400 max-w-xl mx-auto">
        Nos ingénieurs vous aident à choisir les vannes et les équipements de protection incendie adaptés à votre projet.
      </p>
      <a href="/fr/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-xl hover:opacity-90 transition">
        Poser une question à un ingénieur
      </a>
    </div>
  </main>
</Layout>
