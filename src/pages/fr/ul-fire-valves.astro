---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Que signifie « certifié UL » pour les vannes anti-incendie ?',
		answer: 'La certification UL vérifie qu’une vanne respecte les normes de protection incendie UL/ULC en matière de débit, de classe de pression et de durabilité, garantissant un fonctionnement fiable dans les systèmes de gicleurs et de colonnes d’eau. C’est une exigence obligatoire pour la plupart des projets nord-américains et de nombreux projets internationaux.'
	},
	{
		question: 'Quelles vannes anti-incendie Wanlian fabrique-t-il avec certification UL ?',
		answer: 'Nous fabriquons des vannes à boisseau, à papillon, anti-retour, à déluge et à pré-action en raccordements à bride, à gorge et filetés de DN40 à DN300. Contactez notre équipe commerciale avec la spécification de votre projet pour sélectionner le bon type de vanne et le package de certification.'
	},
	{
		question: 'Pouvez-vous fournir le certificat UL avant la commande ?',
		answer: 'Oui. Nos certificats UL/ULC et FM sont disponibles sur demande — voir notre page Certificats pour référence, et nos ingénieurs confirmeront la certification exacte applicable à votre marché de destination avant devis.'
	},
	{
		question: 'Quel est votre MOQ et délai de livraison pour les vannes anti-incendie ?',
		answer: 'Le MOQ dépend du type et de la taille de vanne — généralement 10 à 20 unités par modèle pour les tailles en stock, avec des délais de production de 15 à 30 jours. Des commandes d’échantillon sont disponibles pour les tests et approbations avant expédition.'
	},
	{
		question: 'Proposez-vous de l’OEM / marque propre pour les vannes anti-incendie ?',
		answer: 'Oui, nous proposons l’OEM/ODM avec marquage, emballage et ajustements de spécification personnalisés selon les exigences du projet. La production s’effectue sur nos propres lignes de production sous un système de management de la qualité ISO 9001.'
	}
];

const valveProducts = [
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Vanne à Boisseau à Siège Élastomère (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'Clapet encapsulé EPDM, fermeture étanche, DN50–DN700'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Vanne à Papillon à Gorge Wafer avec Signal',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp',
		desc: 'DN80 PN16 avec interrupteur de surveillance d’état intégré'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'Vanne à Boisseau OS&Y UL/FM (À Gorge)',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: 'Vanne à boisseau à tige montante certifiée UL/FM, 2"–10", extrémités à gorge'
	},
	{
		slug: 'sliding-ball-check-valve-hq41x',
		name: 'Clapet Anti-Retour à Bille Glissante (HQ41X)',
		img: '/assets/products/spherical-ball-check-valve-hq44x.webp',
		desc: 'Faible perte de charge, conception à bille roulante anti-obstruction'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Groupe de Vanne à Déluge et Alarme (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'À commande par membrane, DN50–DN300, ouverture rapide'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Système à Alarme à Pré-action (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Double déclenchement de secours pour les pièces sensibles à l’eau'
	}
];
---

<Layout
	locale="fr"
	title="Vannes Anti-Incendie Certifiées UL | Fabricant de Vannes Incendie UL - WLFE"
	description="WLFE fabrique des vannes anti-incendie certifiées UL : types à boisseau, papillon, anti-retour, déluge et pré-action, produites sur nos propres lignes avec qualité certifiée et devis rapide."
	type="product"
	productData={{
		name: 'Vannes Anti-Incendie Certifiées UL',
		image: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		description: 'Vannes à boisseau, à papillon, anti-retour, à déluge et à pré-action certifiées UL pour les systèmes de protection incendie, fournies par Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Vannes Incendie UL' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/fr/" class="hover:text-blue-600">Accueil</a>
			<span>/</span>
			<a href="/fr/products/" class="hover:text-blue-600">Produits</a>
			<span>/</span>
			<span class="text-gray-600">Vannes Incendie UL</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Vannes de Protection Incendie Certifiées UL</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Vannes Anti-Incendie Certifiées UL pour des Systèmes Fiables</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid fabrique des vannes à boisseau, à papillon, anti-retour, à déluge et à pré-action certifiées UL pour les systèmes de protection incendie commerciaux et industriels. Chaque vanne est produite sur nos propres lignes de production près de Quanzhou sous un système qualité ISO 9001 — direct usine, avec des délais stables et une documentation de certification complète pour votre projet.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Certifié UL/ULC', 'Approuvé FM', 'ISO 9001:2015', 'Direct Usine'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Série de Vannes Incendie</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{valveProducts.map(p => (
					<a href={`/fr/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Spécifications Clés</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Spécification</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Détails</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Normes</td>
							<td class="px-4 py-3 text-gray-700">Certifié UL / ULC, approuvé FM (selon le modèle et le marché de destination)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Gamme de taille</td>
							<td class="px-4 py-3 text-gray-700">DN40 – DN300 (1½" – 12")</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Classe de pression</td>
							<td class="px-4 py-3 text-gray-700">PN16 / PN25 (selon modèle)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Matériau du corps</td>
							<td class="px-4 py-3 text-gray-700">Fonte ductile QT450 / WCB / CF8 · CF8M acier inoxydable</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Raccordements</td>
							<td class="px-4 py-3 text-gray-700">À bride / À gorge / Fileté</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Fluide</td>
							<td class="px-4 py-3 text-gray-700">Eau, solution de mousse</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Applications</h2>
			<p class="text-gray-700 leading-relaxed">Nos vannes anti-incendie UL sont installées dans les réseaux de gicleurs des bâtiments commerciaux, usines industrielles, centres d’entrepôt et de logistique, data centers et conduites de protection incendie pétrochimiques — partout où un contrôle de débit certifié et fiable est une exigence réglementaire.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Pourquoi Choisir Wanlian Fluid</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Qualité certifiée</strong> — certificats UL/ULC et FM publiés sur notre <a href="/fr/certificates/" class="text-brand-blue font-semibold hover:underline">page certificats</a>, vérifiables avant votre commande.</li>
				<li><strong>Direct usine</strong> — délais stables, support OEM/ODM et assistance technique à la sélection.</li>
				<li><strong>Une commande, une usine</strong> — vannes expédiées avec gicleurs, hydrants et accessoires pour le circuit d’extinction complet.</li>
			</ul>

			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Nouveau aux Normes de Vannes ?</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Commencez par notre guide acheteur : <a href="/fr/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">Hydrants, Flexibles Anti-Incendie & Normes de Vannes Expliqués</a>.</p>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Questions Fréquentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Besoin de Vannes Incendie UL pour Votre Projet ?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envoyez-nous votre type de vanne, DN/PN et la certification cible — nos ingénieurs répondent avec une fiche technique complète et un devis sous 12 heures.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/fr/contact/?product=Vannes%20Incendie%20UL" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Demander un Devis</a>
						<a href="https://wa.me/8618684324501?text=Bonjour%2C%20j%27ai%20besoin%20de%20vannes%20anti-incendie%20certifi%C3%A9es%20UL" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Discuter sur WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
