---
import Layout from '../../layouts/Layout.astro';
import { tags } from '../../utils/tags';
import { guides } from '../../utils/guides';
import { products } from '../../utils/products';

const tagStats = tags.map(tag => ({
  ...tag,
  guideCount: tag.guideHrefs.length,
  productCount: tag.productSlugs.length
}));
---

<Layout
  title="Knowledge Hub: Fire Protection & Valve Topics"
  description="Fire protection and industrial valve topics: hydrants, sprinklers, water cannons, backflow prevention, certification and B2B sourcing guides from Wanlian Fluid."
  breadcrumbs={[{ name: 'Topics' }]}
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-brand-red uppercase">Knowledge Hub</span>
      <h1 class="text-4xl font-black text-gray-900 tracking-tight">Browse by Topic</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
        Technical guides and products grouped by theme — from fire hydrants and sprinkler systems to backflow prevention and B2B sourcing.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {tagStats.map(tag => (
        <a
          href={`/tags/${tag.slug}/`}
          class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-8 flex flex-col"
        >
          <div class="flex items-center justify-between mb-4">
            <span class="px-2.5 py-1 bg-brand-blue/10 text-brand-blue text-[11px] font-black rounded-full uppercase tracking-wider">Topic</span>
            <span class="text-xs text-gray-400">
              {tag.guideCount} guide{tag.guideCount !== 1 ? 's' : ''} · {tag.productCount} product{tag.productCount !== 1 ? 's' : ''}
            </span>
          </div>
          <h2 class="text-xl font-black text-gray-900 group-hover:text-brand-blue transition leading-snug mb-3">
            {tag.name}
          </h2>
          <p class="text-sm text-gray-500 leading-relaxed flex-grow">{tag.description}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {tag.relatedTags.slice(0, 3).map(rel => (
              <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">#{rel.replace(/-/g, ' ')}</span>
            ))}
          </div>
          <span class="mt-4 inline-flex items-center text-brand-red font-bold text-sm group-hover:gap-2 transition-all">
            Explore Topic
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4">
      <h2 class="text-2xl font-black">Looking for a Specific Product Family?</h2>
      <p class="text-gray-400 max-w-xl mx-auto">
        Browse the full catalog or ask our engineers to match the right valve for your project.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/products/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-xl hover:opacity-90 transition">Full Catalog</a>
        <a href="/contact/" class="inline-block px-8 py-4 bg-white/10 border border-white/20 text-white font-bold rounded-xl hover:bg-white/20 transition">Ask an Engineer</a>
      </div>
    </div>
  </main>
</Layout>
