---
import Layout from '../layouts/Layout.astro';
import { products } from '../utils/products';
import InquiryForm from '../components/inquiry/InquiryForm.astro';

// Featured products for the homepage (Real Wanlian Products)
const featuredProducts = products.filter(p => [
  'resilient-seat-flanged-gate-valve-z41x',
  'indoor-fire-hydrant-head-sn65',
  'wet-alarm-check-valve-zsfz-150',
  'signal-grooved-wafer-butterfly-valve-dn80',
  'sliding-ball-check-valve-hq41x',
  'hydraulic-water-level-control-valve-f745x',
  'telescopic-y-strainer-sgl41h',
  'anti-collision-pressure-regulating-outdoor-hydrant-ssft100'
].includes(p.slug));

const categories = [
  { name: 'Valves & Parts', count: '150+', image: '/assets/products/resilient-seat-flanged-gate-valve-z41x.jpg' },
  { name: 'Hydrants & Pump Connections', count: '80+', image: '/assets/products/indoor-fire-hydrant-head-sn65.jpg' },
  { name: 'Sprinklers & Alarm Valves', count: '120+', image: '/assets/products/wet-alarm-check-valve-zsfz-150.png' },
  { name: 'Hydraulic Safety', count: '60+', image: '/assets/products/adjustable-pressure-reducing-valve-500x.jpg' },
  { name: 'Extinguishing Water Cannons', count: '40+', image: '/assets/products/fire-hose-reel-jpso8-19.jpg' },
  { name: 'Fire Cabinets & Interfaces', count: '90+', image: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg' }
];

const productionSteps = [
  { step: '01', title: 'Precision Weaving', desc: 'High-strength polyester weaving for durable fire hose jackets.', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
  { step: '02', title: 'Lining Bonding', desc: 'Advanced vulcanization process for bubble-tight rubber lining.', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { step: '03', title: 'CNC Machining', desc: 'Precision machining for ductile iron valve bodies and components.', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
  { step: '04', title: 'Safety Testing', desc: '100% shell pressure and air leakage testing for every unit.', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { step: '05', title: 'Epoxy Coating', desc: 'Non-toxic epoxy resin coating for superior corrosion resistance.', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' }
];

const industries = [
  { name: 'Oil & Gas', desc: 'Secure fluid transport under extreme industrial conditions.', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { name: 'Water Treatment', desc: 'Municipal water supply, drainage, and filtration systems.', icon: 'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3' },
  { name: 'Fire Protection', desc: 'Certified hydrants, sprinkler valves, and suppression systems.', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' }
];
---

<Layout title="Wanlian Fluid | Premium B2B Valve & Fire Protection Supplier">
  <!-- Hero Section with Diagonal Aesthetic -->
  <section class="relative bg-gray-900 text-white min-h-[85vh] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-r from-gray-900 via-gray-900/80 to-transparent z-10"></div>
      <img 
        src="/og-image.jpg"
        alt="Wanlian Fluid industrial valve products"
        class="w-full h-full object-cover object-center opacity-40"
      />
    </div>
    
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="max-w-3xl space-y-8">
        <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full border border-white/20">
          <span class="flex h-2 w-2 rounded-full bg-brand-red animate-pulse"></span>
          <span class="text-sm font-bold tracking-widest uppercase">Professional B2B Fluid Equipment Enterprise</span>
        </div>
        
        <h1 class="text-5xl sm:text-7xl font-black tracking-tight leading-[1.1]">
          Precision Flow <br/>
          <span class="text-brand-red italic">Link Global Safety.</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-gray-300 max-w-2xl leading-relaxed">
          Quanzhou Wanlian Fluid Equipment Co., Ltd. is a professional fluid equipment enterprise integrating R&D, sales and service, providing high-quality valves, supporting fire-fighting equipment and fluid control solutions for industrial, municipal, fire protection, water supply and drainage sectors.
        </p>
        
        <div class="flex flex-wrap gap-4 pt-4">
          <a href="/products/" class="px-8 py-4 bg-brand-red hover:opacity-90 text-white font-bold rounded-lg transition shadow-xl shadow-brand-red/20 transform hover:-translate-y-1">
            Explore Catalog
          </a>
          <a href="/contact/#inquiry" class="px-8 py-4 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white font-bold rounded-lg border border-white/30 transition">
            Request RFQ
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Certification Wall -->
  <div class="bg-gray-100 py-8 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-50 grayscale hover:grayscale-0 transition duration-500">
        <span class="text-gray-900 font-black text-xl tracking-tighter">TECHNICAL DATA</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">PRODUCT DRAWINGS</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">MATERIAL OPTIONS</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">PRESSURE RATINGS</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">OEM / ODM</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">EXPORT SUPPORT</span>
      </div>
    </div>
  </div>

  <!-- About Section: Factory Strength -->
  <section class="py-24 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="flex-1 space-y-8">
          <div class="space-y-4">
            <h2 class="text-sm font-black tracking-[0.3em] text-brand-red uppercase flex items-center gap-2">
              <span class="w-8 h-[2px] bg-brand-red"></span>
              Company Profile
            </h2>
            <h3 class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight leading-tight">
              Fluid Control Solutions <br/><span class="text-brand-blue">For Global Projects.</span>
            </h3>
          </div>
          
          <div class="space-y-6 text-gray-600 text-lg leading-relaxed">
            <p>
              Based in Quanzhou, Fujian — the core cluster of China's plumbing and valve industry — Quanzhou Wanlian Fluid Equipment Co., Ltd. supplies industrial valves, hydraulic control products, hydrant components, and fire protection equipment for international B2B projects, with production carried out at partner bases under the ISO 9001 quality management system.
            </p>
            <p>
              We organize product information around clear specifications, application details, and inquiry-based cooperation for water supply, industrial fluid control, and firefighting systems.
            </p>
          </div>

          <!-- Metric Cards: 数字大字报(数据均为站内可查的真实数据) -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 pt-4">
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-red tabular-nums">{products.length}+</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">In-Stock Models</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-blue tabular-nums">{categories.length}</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Product Lines</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-red tabular-nums">100%</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Pressure Tested</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-blue tabular-nums">ISO 9001</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Quality System</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-3 pt-2">
            <span class="px-4 py-2 bg-brand-red/5 border border-brand-red/20 text-brand-red text-xs font-black uppercase tracking-widest rounded-full">R&D · Sales · Service</span>
            <span class="px-4 py-2 bg-brand-blue/5 border border-brand-blue/20 text-brand-blue text-xs font-black uppercase tracking-widest rounded-full">ISO 9001 Certified</span>
            <span class="px-4 py-2 bg-gray-100 border border-gray-200 text-gray-700 text-xs font-black uppercase tracking-widest rounded-full">OEM · ODM · Custom</span>
          </div>

          <a href="/about/" class="inline-flex items-center gap-2 font-bold text-brand-blue hover:underline pt-2">
            Read Full Company Profile <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="flex-1 relative">
          <div class="absolute -top-10 -left-10 w-40 h-40 bg-blue-100 rounded-full blur-3xl opacity-50 z-0"></div>
          <div class="relative z-10 rounded-2xl overflow-hidden shadow-2xl shadow-gray-200">
            <img 
              src="/og-image.jpg"
              alt="Wanlian Fluid industrial valve products"
              loading="lazy"
              class="w-full h-auto object-cover"
            />
            <div class="absolute bottom-0 left-0 right-0 p-8 bg-gradient-to-t from-black/80 to-transparent text-white">
              <p class="text-sm font-bold tracking-wide">Professional Industrial Excellence | B2B Fluid Solutions</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Classification Grid -->
  <section class="py-24 bg-gray-50 border-y border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <h2 class="text-4xl font-black text-gray-900 tracking-tight uppercase">Core Product Categories</h2>
        <div class="h-1.5 w-20 bg-brand-red mx-auto"></div>
        <p class="text-gray-500 font-medium italic">High-precision engineering for global fire and water networks.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {categories.map(cat => (
          <a href={`/products/#category=${encodeURIComponent(cat.name)}`} class="group relative bg-white rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-200">
            <div class="aspect-[4/3] overflow-hidden bg-gray-50 p-6 flex items-center justify-center">
              <img src={cat.image} alt={cat.name} loading="lazy" class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-6 bg-white/95 backdrop-blur-sm flex justify-between items-center group-hover:bg-brand-red group-hover:text-white transition-colors">
              <div>
                <h4 class="font-black text-lg">{cat.name}</h4>
                <p class="text-[10px] font-black uppercase tracking-widest opacity-60">Browse product range</p>
              </div>
              <span class="text-2xl font-light">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Production Excellence -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-4">
        <div class="space-y-4">
          <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Quality Control Workflow</h2>
          <h3 class="text-4xl font-black text-gray-900 tracking-tight">How We Review Product Requirements</h3>
        </div>
        <p class="text-gray-500 max-w-md text-right hidden md:block">A structured review helps align product selection, specifications, testing expectations, and export preparation.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
        {productionSteps.map((step, idx) => (
          <div class="relative group">
            <div class="bg-gray-50 p-8 rounded-2xl border border-gray-100 space-y-4 h-full group-hover:bg-blue-50 transition-colors">
              <div class="text-4xl font-black text-gray-200 group-hover:text-brand-blue/20 transition-colors">{step.step}</div>
              <h4 class="font-bold text-gray-900">{step.title}</h4>
              <p class="text-sm text-gray-500 leading-relaxed">{step.desc}</p>
            </div>
            {idx < productionSteps.length - 1 && (
              <div class="hidden lg:block absolute top-1/2 -right-4 transform -translate-y-1/2 z-10">
                <svg class="w-8 h-8 text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-24 bg-gray-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-16">
        <h2 class="text-4xl font-black text-gray-900 tracking-tight">Global <span class="text-brand-red">Best Sellers</span></h2>
        <a href="/products/" class="text-brand-blue font-bold hover:underline">Full Catalog →</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {featuredProducts.map(product => (
          <div class="group bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300">
            <div class="aspect-square relative overflow-hidden bg-gray-50 p-6">
              <img src={product.image} alt={product.name} loading="lazy" class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute top-4 left-4 flex gap-2">
                <span class="px-2 py-1 bg-gray-900/80 text-white text-[10px] font-black uppercase tracking-widest rounded">
                  {product.category}
                </span>
  
              </div>
            </div>
            <div class="p-6 space-y-4">
              <h4 class="font-bold text-gray-900 line-clamp-2 min-h-[3rem] group-hover:text-brand-red transition-colors tracking-tight">{product.name}</h4>
              <div class="pt-4 border-t border-gray-100 flex gap-2">
                <a href={`/products/${product.slug}/`} class="flex-1 py-2 text-center text-xs font-black border border-gray-200 rounded hover:bg-gray-50 transition">DETAILS</a>
                <a href={`/contact/?product=${encodeURIComponent(product.name)}`} class="flex-1 py-2 text-center text-xs font-black bg-brand-red text-white rounded hover:opacity-90 transition">INQUIRE</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Complete Product Line: 全量产品内链，向所有产品页传递权重 -->
  <section class="py-24 bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-12 gap-4">
        <h2 class="text-4xl font-black text-gray-900 tracking-tight">Complete <span class="text-brand-blue">Product Line</span></h2>
        <a href="/products/" class="text-brand-red font-bold hover:underline shrink-0">All Products →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-1">
        {products.map(product => (
          <a href={`/products/${product.slug}/`} class="group flex items-center justify-between py-3 border-b border-gray-100 hover:border-brand-red transition-colors">
            <span class="text-sm font-semibold text-gray-700 group-hover:text-brand-red transition-colors line-clamp-1 pr-3">{product.name}</span>
            <span class="text-brand-blue opacity-0 group-hover:opacity-100 transition-opacity shrink-0">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Industry Scenarios -->
  <section class="py-24 bg-gray-900 text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16 items-center">
        <div class="space-y-6">
          <h2 class="text-4xl font-black tracking-tight leading-tight">Built for <br/><span class="text-brand-blue">High-Pressure Duty.</span></h2>
          <p class="text-gray-400">Our engineering focuses on durability and reliability in hazardous and critical infrastructures.</p>
          <div class="pt-4">
            <a href="/certificates/" class="inline-flex items-center gap-2 px-6 py-3 bg-white/5 border border-white/10 rounded-lg font-bold hover:bg-white/10 transition">
              View Certifications & Specs
            </a>
          </div>
        </div>
        <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-6">
          {industries.map(ind => (
            <div class="p-8 bg-white/5 border border-white/10 rounded-2xl hover:border-brand-blue/50 transition-colors">
               <div class="w-12 h-12 bg-brand-blue/20 rounded-lg flex items-center justify-center text-brand-blue mb-6">
                 <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={ind.icon}/></svg>
               </div>
               <h4 class="font-bold mb-2 uppercase tracking-wide">{ind.name}</h4>
               <p class="text-xs text-gray-400 leading-relaxed">{ind.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Inquiry Section -->
  <section id="inquiry" class="py-24 bg-white scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="space-y-8">
          <div class="space-y-4">
             <h2 class="text-4xl font-black text-gray-900 tracking-tight uppercase">Get a Professional Quote</h2>
             <div class="h-1.5 w-20 bg-brand-red"></div>
          </div>
          <p class="text-lg text-gray-600 leading-relaxed">
            Submit your technical drawings or product requirements. We will review the details and follow up with suitable product information and quotation steps.
          </p>
          <ul class="space-y-4">
            {['Inquiry-based quotation', 'Application and selection support', 'Export packaging coordination', 'Product documentation support'].map(item => (
              <li class="flex items-center gap-3 text-gray-700 font-bold">
                <svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <InquiryForm />
      </div>
    </div>
  </section>
  
  <!-- Final CTA -->
  <section class="py-24 bg-brand-red text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-8">
      <h2 class="text-4xl sm:text-6xl font-black tracking-tight leading-tight">Ready to Link Global Safety?</h2>
      <p class="text-xl text-white/80 max-w-2xl mx-auto">Contact our team for product selection, technical documents, and inquiry-based quotations.</p>
      <div class="flex justify-center gap-4">
        <a href="/contact/#inquiry" class="px-10 py-5 bg-white text-brand-red font-black rounded-xl shadow-2xl hover:bg-gray-50 transition-transform hover:scale-105">
          Submit RFQ Now
        </a>
      </div>
    </div>
  </section>
</Layout>
