---
import Layout from '../layouts/Layout.astro';
import { products } from '../utils/products';
import InquiryForm from '../components/inquiry/InquiryForm.astro';

const faq = [
  {
    question: 'What does Wanlian Fluid manufacture and export?',
    answer: 'Wanlian Fluid is a Quanzhou-based manufacturer and exporter of industrial valves and fire protection equipment: resilient and metal-seated gate valves, butterfly and check valves, fire hydrants and hydrant components, sprinkler and alarm valves, and rubber-lined fire hose — the full range being documented model by model against pressure class, connection standard, body and trim material, and application.'
  },
  {
    question: 'How do I get a price for a valve or hydrant?',
    answer: 'Pricing is by inquiry. Send your specification — model or standard, size, pressure class, material, quantity and destination — and our team replies with an itemized quote within 12 hours.'
  },
  {
    question: 'Does every unit get tested before shipment?',
    answer: 'Yes. Every valve, hydrant and hose is shell pressure-tested and air-leakage tested before shipment, with per-unit records. Production runs under an ISO 9001 quality-management system.'
  },
  {
    question: 'Do you support OEM or private-label orders?',
    answer: 'Yes. OEM/ODM, custom branding and export packaging are standard services. Compliance with a specific standard (for example AWWA C502, UL listing or FM approval) is confirmed per model with test reports and certificates before ordering.'
  }
];

// Category grid and the grouped catalog index are both derived from products.ts, so the set of
// product lines, their counts and their card photography cannot drift from the live catalog.
// CATEGORY_LEAD only chooses which existing product photo represents a line.
const CATEGORY_LEAD: Record<string, string> = {
  'Valves & Parts': 'resilient-seat-flanged-gate-valve-z41x',
  'Hydrants & Pump Connections': 'indoor-fire-hydrant-head-sn65',
  'Sprinklers & Alarm Valves': 'wet-alarm-check-valve-zsfz-150',
  'Hydraulic Safety': 'hydraulic-water-level-control-valve-f745x',
  'Extinguishing Water Cannons': 'manual-fire-water-cannon-ps',
  'Fire Cabinets & Interfaces': 'foam-fire-hydrant-cabinet-psg30',
  'Fire Hose & Reels': 'pvc-fire-hose'
};

const categoryNames: string[] = [...new Set(products.map(p => p.category))];

const categories = categoryNames.map(name => {
  const inCategory = products.filter(p => p.category === name);
  const lead = inCategory.find(p => p.slug === CATEGORY_LEAD[name]) ?? inCategory[0];
  return { name, count: inCategory.length, image: lead.image, leadName: lead.name, href: `/products/#category=${encodeURIComponent(name)}` };
});

const catalogByCategory = categoryNames.map(name => ({
  name,
  href: `/products/#category=${encodeURIComponent(name)}`,
  items: products.filter(p => p.category === name).map(p => ({ name: p.name, href: '/products/' + p.slug + '/' }))
}));

const productionSteps = [
  { step: '01', title: 'Precision Weaving', desc: 'High-strength polyester weaving for durable fire hose jackets.' },
  { step: '02', title: 'Lining Bonding', desc: 'Advanced vulcanization process for bubble-tight rubber lining.' },
  { step: '03', title: 'CNC Machining', desc: 'Precision machining for ductile iron valve bodies and components.' },
  { step: '04', title: 'Safety Testing', desc: '100% shell pressure and air leakage testing for every unit.' },
  { step: '05', title: 'Epoxy Coating', desc: 'Non-toxic epoxy resin coating for superior corrosion resistance.' }
];

// Hose jacketing and valve/hydrant machining are separate processes that converge on shared
// testing and finishing, so each step states which line it belongs to.
const stepLines: Record<string, string> = {
  '01': 'Fire hose',
  '02': 'Fire hose',
  '03': 'Valves & hydrants',
  '04': 'All lines',
  '05': 'Valves & hydrants'
};

// Own-name assurance only. Third-party listings belong to the factory that holds them, so this
// strip must never imply that Wanlian itself holds UL, FM, CE or LPCB listings.
const certifications = [
  { name: '100% Shell & Seat', code: 'Tested per lot' },
  { name: 'Material Certificates', code: 'Body, trim, elastomer' },
  { name: 'Third-Party Inspection', code: 'SGS / BV / Intertek' },
  { name: 'ISO 9001:2015', code: 'Quality Management' },
  { name: 'Per-Lot Test Records', code: 'Shipped with goods' },
  { name: 'Tested To', code: 'GB/T 13927 / EN 12266-1' }
];

const waCallbackHref = `https://wa.me/8618684324501?text=${encodeURIComponent('Hi, I would like a callback about valves or fire protection equipment from wanlian911.com.')}`;

// 指南与系统页资源入口(首页权重导向内容页)
const resources = [
  { href: '/guides/fire-sprinkler-system-valves-guide/', eyebrow: 'Buying Guide', title: 'Fire Sprinkler System Valves Guide', desc: 'Wet alarm, deluge and pre-action valve groups explained for sprinkler system buyers.' },
  { href: '/guides/fire-sprinkler-system-wet-dry-preaction/', eyebrow: 'Buying Guide', title: 'Wet, Dry or Pre-action Sprinkler Systems', desc: 'Compare system types and match the right configuration to your building risk profile.' },
  { href: '/fire-water-cannon/', eyebrow: 'System Overview', title: 'Fire Water Cannons & Monitors', desc: 'Manual PS monitors and auto-tracking ZDMS cannons for large-space fire suppression.' },
  { href: '/guides/how-to-choose-a-fire-hydrant/', eyebrow: 'Buying Guide', title: 'How to Choose a Fire Hydrant', desc: 'Hydrant types, pressure classes, connection standards and a factory procurement checklist.' },
  { href: '/guides/how-to-choose-ul-listed-fire-valves/', eyebrow: 'Buying Guide', title: 'How to Choose UL Listed Fire Valves', desc: 'What UL listing really means, UL vs FM, and how to verify genuine certificates.' },
  { href: '/guides/gate-valve-vs-butterfly-valve-fire-protection/', eyebrow: 'Buying Guide', title: 'Gate Valve vs Butterfly Valve', desc: 'Flow, space, cost and duty comparison for fire mains and sprinkler branch lines.' }
];

// On-site project evidence: real fire pump room installation (photos + portrait walkthrough video)
const projectPhotos = [
  { src: '/assets/projects/pump-skids.webp', alt: 'Row of sprinkler fire pump sets with OPEN and CLOSE position tags at an installed fire pump room', caption: 'Pump skids with OPEN/CLOSE position tags' },
  { src: '/assets/projects/valve-train.webp', alt: 'Gate valve train and gauges on red riser mains at the installed fire pump room', caption: 'Riser mains and gate valve train' },
  { src: '/assets/projects/riser-grid.webp', alt: 'Riser main grid with overhead ductwork and cable trays at the installed fire pump room', caption: 'Riser grid and overhead ductwork' },
  { src: '/assets/projects/pump-room-final.webp', alt: 'Installed fire pump room staged for inspection and handover', caption: 'Pump room staged for handover' }
];

const projectScope = [
  'Multiple sprinkler and fire pump sets installed on concrete plinths',
  'Full riser main grid with gate valves, gauges and OPEN/CLOSE position tags',
  'Overhead ductwork and cable trays routed alongside the riser grid',
  'Site staged for final inspection and handover',
];

const industries = [
  { name: 'Oil & Gas', desc: 'Secure fluid transport under extreme industrial conditions.', icon: 'pipe' },
  { name: 'Water Treatment', desc: 'Municipal water supply, drainage, and filtration systems.', icon: 'drop' },
  { name: 'Fire Protection', desc: 'Certified hydrants, sprinkler valves, and suppression systems.', icon: 'flame' }
];

type Clip = { src: string; poster: string; title: string; desc: string };

const clips: Clip[] = [
  { src: '/videos/factory/assembly.mp4', poster: '/videos/factory/assembly-poster.webp', title: 'Assembly', desc: 'Assembly and bolting at the bench' },
  { src: '/videos/factory/blue-valves.mp4', poster: '/videos/factory/blue-valves-poster.webp', title: 'Inspection', desc: 'Finished valves queued for inspection' },
  { src: '/videos/factory/red-field.mp4', poster: '/videos/factory/red-field-poster.webp', title: 'Ready Stock', desc: 'Hydrants and red-body stock' },
  { src: '/videos/factory/loading-close.mp4', poster: '/videos/factory/loading-close-poster.webp', title: 'Packing & Loading', desc: 'Export cartons closed and strapped' },
  { src: '/videos/factory/dispatch.mp4', poster: '/videos/factory/dispatch-poster.webp', title: 'Dispatch', desc: 'Loaded and sealed for dispatch' }
];

const walkthroughClip: Clip = {
  src: '/assets/projects/project-walkthrough.mp4',
  poster: '/assets/projects/pump-room-wide.webp',
  title: 'Installed pump room',
  desc: 'Vertical walk-through of the completed installation.',
};

const stats = [
  { value: String(products.length), unit: '', label: 'Catalogued models' },
  { value: String(categories.length), unit: 'lines', label: 'Product lines' },
  { value: '12', unit: 'hours', label: 'Itemized quotation' },
  { value: '100', unit: '%', label: 'Units pressure tested' }
];

const capability = [
  { icon: 'valve', title: 'Own production lines', body: 'Gate, check, butterfly, hydrant and alarm-valve families, with selected items produced by qualified manufacturing partners.' },
  { icon: 'gauge', title: 'Tested and documented', body: 'Shell pressure and air-leakage testing on every unit, with per-lot test records shipped alongside the goods.' },
  { icon: 'cog', title: 'OEM and ODM', body: 'Non-standard sizes, materials and end connections; custom branding, export packaging and the documentation set on request.' },
  { icon: 'doc', title: 'Specification desk', body: 'Unit price, stock position and lead time per line item, answered seven days a week from one desk.' }
];

const svgOpen = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">';
const icons: Record<string, string> = {
  valve: svgOpen + '<path d="M4 16 12 9l8 7H4Z"/><path d="M12 9V4"/><path d="M8.5 4h7"/></svg>',
  gauge: svgOpen + '<circle cx="12" cy="10" r="6"/><path d="M12 10l3.2-2.6"/><path d="M6 20h12"/></svg>',
  cog: svgOpen + '<circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.4M12 18.6V21M3 12h2.4M18.6 12H21M5.6 5.6l1.7 1.7M16.7 16.7l1.7 1.7M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7"/></svg>',
  doc: svgOpen + '<path d="M7 3h7l4 4v14H7V3Z"/><path d="M14 3v4h4"/><path d="M10 12h6M10 16h6"/></svg>',
  flame: svgOpen + '<path d="M12 3c3 4 5 6 5 9a5 5 0 0 1-10 0c0-2.2 1.1-3.8 2.6-5.2"/></svg>',
  drop: svgOpen + '<path d="M12 3l5.4 7a6.4 6.4 0 1 1-10.8 0L12 3Z"/></svg>',
  pipe: svgOpen + '<path d="M3 8.5h7v7H3zM14 8.5h7v7h-7z"/><path d="M10 12h4"/><path d="M3 8.5v7M21 8.5v7"/></svg>',
  guide: svgOpen + '<path d="M4 5h7v15H4zM13 5h7v15h-7z"/><path d="M7 9h1M16 9h1"/></svg>',
  chat: svgOpen + '<path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9h8M8 12h5"/></svg>'
};
const tick = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9 17.5 20 6.5"/></svg>';
---

<Layout title="Wanlian Fluid | Valve &amp; Fire Protection Manufacturer in China" description="Wanlian Fluid is a Quanzhou-based manufacturer and exporter of industrial valves and fire protection equipment for global B2B projects. Own production lines, CNC machining, ISO 9001, inquiry-based quotation." faq={faq} video={{ name: 'Inside Wanlian Fluid in 50 Seconds', description: 'Company introduction video: showroom, production lines, OEM customization and quality inspection at the Quanzhou plant.', thumbnail: '/videos/company-intro-poster.webp', src: '/videos/company-intro.mp4', duration: 'PT49S', uploadDate: '2026-09-18' }}>
  <div class="c68">

    <section class="c68-hero">
      <div class="c68-wrap c68-hero-grid">
        <div class="c68-rv">
          <p class="c68-eyebrow"><span class="c68-dot"></span>Manufacturer &amp; Exporter — Valves &amp; Fire Protection</p>
          <h1>Valves &amp; fire protection equipment <em>for global projects.</em></h1>
          <p class="c68-rule" aria-hidden="true"></p>
          <p class="c68-lede">Industrial valves, hydrants, alarm valves and hose systems from our own lines in Quanzhou, Fujian. Send the specification — you get an itemized quotation, stock position and lead time inside 12 hours.</p>
          <div class="c68-cta">
            <a class="c68-btn c68-btn-red" href="#product-lines">Browse product lines</a>
            <a class="c68-btn c68-btn-ghost" href="/contact/#inquiry">Request a quotation</a>
          </div>
        </div>
        <figure class="c68-frame c68-rv">
          <span class="c68-frame-tab"></span>
          <img src="/assets/factory/plant-exterior.webp" alt="Wanlian Fluid plant exterior in Quanzhou, Fujian" decoding="async" />
          <figcaption>OUR PLANT — QUANZHOU, FUJIAN</figcaption>
        </figure>
      </div>
      <div class="c68-stats">
        <div class="c68-wrap c68-stats-grid">
          {stats.map((s) => (
            <div class="c68-stat">
              <p class="c68-stat-num">{s.value}<span>{s.unit}</span></p>
              <p class="c68-stat-label">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="product-lines">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Browse by product line</p>
          <h2>{categories.length} product lines, <em>one specification desk.</em></h2>
          <p class="c68-head-sub">Every card opens the catalogue filtered to that line. Line names, model counts and card photography are read from the live catalogue at build time.</p>
        </header>
        <div class="c68-lines">
          {categories.map((c) => (
            <a class="c68-line c68-rv" href={c.href}>
              <span class="c68-line-media"><img src={c.image} alt={c.leadName} loading="lazy" decoding="async" /></span>
              <span class="c68-line-body">
                <span class="c68-line-count">{c.count} models</span>
                <span class="c68-line-name">{c.name}</span>
                <span class="c68-line-more">Open this line <i aria-hidden="true">&rarr;</i></span>
              </span>
            </a>
          ))}
          <a class="c68-line c68-line-full c68-rv" href="/products/">
            <span class="c68-line-body">
              <span class="c68-line-count">Full catalogue</span>
              <span class="c68-line-name c68-line-name-inv">{products.length} models</span>
              <span class="c68-line-more c68-line-more-inv">Filter by line, size and pressure class — or send us a drawing.</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="c68-band">
      <div class="c68-wrap">
        <div class="c68-cap-grid">
          {capability.map((c) => (
            <article class="c68-cap c68-rv">
              <span class="c68-ico" set:html={icons[c.icon]}></span>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="about">
      <div class="c68-wrap c68-profile-grid">
        <div class="c68-rv">
          <header class="c68-head">
            <p class="c68-kicker">Company profile</p>
            <h2>Fluid control solutions <em>for global projects.</em></h2>
          </header>
          <p class="c68-body">Based in Quanzhou, Fujian — the core cluster of China's plumbing and valve industry — Quanzhou Wanlian Fluid Equipment Co., Ltd. manufactures and exports industrial valves, hydraulic control products, hydrant components, and fire protection equipment for international B2B projects. Manufacturing runs on our own production lines in Quanzhou, with selected items produced by qualified manufacturing partners; valve bodies are CNC-machined and every unit is shell pressure and air-leakage tested before shipment, under an ISO 9001 quality management system.</p>
          <p class="c68-profile-link"><a href="/about/">Company overview &rarr;</a><a href="/applications/">Application guide &rarr;</a></p>
        </div>
        <div class="c68-shots">
          <figure class="c68-shot c68-rv">
            <img src="/assets/factory/workshop.webp" alt="Main workshop at the Quanzhou plant" loading="lazy" decoding="async" />
            <figcaption>Workshop</figcaption>
          </figure>
          <figure class="c68-shot c68-rv">
            <img src="/assets/factory/powder-coating.webp" alt="Powder coating line at the Quanzhou plant" loading="lazy" decoding="async" />
            <figcaption>Powder coating</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="c68-band" id="process">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Production workflow</p>
          <h2>From weaving to <em>coating and test.</em></h2>
        </header>
        <ol class="c68-steps">
          {productionSteps.map((s) => (
            <li class="c68-step c68-rv">
              <span class="c68-step-n">{s.step}</span>
              <span class="c68-step-line">{stepLines[s.step]}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="c68-band c68-dark" id="factory">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker c68-kicker-red">Factory live</p>
          <h2>Real footage from <em>the Quanzhou plant.</em></h2>
          <p class="c68-head-sub">No stock video and nothing staged. Press play on any frame; the clips are served from this site.</p>
        </header>
        <div class="c68-video-lead">
          <figure class="c68-vid c68-rv">
            <video src="/videos/company-intro.mp4" poster="/videos/company-intro-poster.webp" controls playsinline preload="none"></video>
            <figcaption><strong>Inside the plant</strong><span>Showroom, production lines, OEM customization and quality inspection, in under a minute.</span></figcaption>
          </figure>
          <div class="c68-side">
            <ul class="c68-video-note">
              <li>Assembly, inspection, ready stock, packing and dispatch below.</li>
              <li>Live walk-through of the line during production on request.</li>
              <li>Pre-shipment third-party inspection arranged at your instruction.</li>
            </ul>
            <div class="c68-side-shots">
              <figure class="c68-sshot c68-rv">
                <img src="/assets/factory/assembly.webp" alt="Assembly and finishing bay" loading="lazy" decoding="async" />
                <figcaption>Assembly</figcaption>
              </figure>
            </div>
          </div>
        </div>
        <div class="c68-clips">
          {clips.map((c) => (
            <figure class="c68-clip c68-rv">
              <video src={c.src} poster={c.poster} controls playsinline preload="none"></video>
              <figcaption><strong>{c.title}</strong><span>{c.desc}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Where they are used</p>
          <h2>Built for <em>high-pressure duty.</em></h2>
          <p class="c68-head-sub"><a class="c68-inlink" href="/applications/">Application guide &rarr;</a></p>
        </header>
        <div class="c68-ind">
          {industries.map((i) => (
            <a class="c68-ind-card c68-rv" href="/applications/">
              <span class="c68-ico" set:html={icons[i.icon]}></span>
              <h3>{i.name}</h3>
              <p>{i.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band" id="quality">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Quality and scope</p>
          <h2>Tested every unit, <em>documented every lot.</em></h2>
        </header>
        <div class="c68-cert-grid">
          {certifications.map((c) => (
            <div class="c68-cert c68-rv">
              <p class="c68-cert-name">{c.name}</p>
              <p class="c68-cert-code">{c.code}</p>
            </div>
          ))}
        </div>
        <p class="c68-scope">Listing and approval scope is granted per model. Where your specification names a listed item, we source it from the factory holding that listing and provide the holder&rsquo;s name and certificate copy before production.</p>
        <div class="c68-chips">
          <a class="c68-chip c68-chip-link" href="/certificates/">Certificates &amp; register &rarr;</a>
          <a class="c68-chip c68-chip-link" href="/faq/">FAQ &amp; policies &rarr;</a>
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="resources">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Technical resources</p>
          <h2>Selection guides, <em>before the order.</em></h2>
          <p class="c68-head-sub">Written for buyers who specify. Each guide walks the standard, the system type and the trade-offs before you commit to a model.</p>
        </header>
        <div class="c68-guides">
          {resources.map((r) => (
            <a class="c68-guide c68-rv" href={r.href}>
              <span class="c68-guide-eyebrow">{r.eyebrow}</span>
              <span class="c68-guide-title">{r.title}</span>
              <span class="c68-guide-desc">{r.desc}</span>
              <span class="c68-guide-more">Read the guide <i aria-hidden="true">&rarr;</i></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band" id="projects">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Project cases</p>
          <h2>Our equipment, <em>on site.</em></h2>
          <p class="c68-head-sub">Photographed on a completed fire pump room installation. Client names and project references are available on request.</p>
        </header>
        <div class="c68-proj-grid">
          <figure class="c68-vid c68-vid-tall c68-rv">
            <video src={walkthroughClip.src} poster={walkthroughClip.poster} controls playsinline preload="none"></video>
            <figcaption><strong>{walkthroughClip.title}</strong><span>{walkthroughClip.desc}</span></figcaption>
          </figure>
          <div class="c68-proj-cards">
            {projectPhotos.map((s) => (
              <figure class="c68-pcard c68-rv">
                <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
                <figcaption>{s.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
        <ul class="c68-scope-list">
          {projectScope.map((s) => (<li set:html={tick + '<span>' + s + '</span>'}></li>))}
        </ul>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="model-index">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Full model index</p>
          <h2>Every published <em>model number.</em></h2>
        </header>
        <div class="c68-index">
          {catalogByCategory.map((g) => (
            <div class="c68-index-col c68-rv">
              <p class="c68-index-head"><a href={g.href}>{g.name}</a><span>{g.items.length}</span></p>
              <ul>
                {g.items.map((it) => (<li><a href={it.href}>{it.name}</a></li>))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-dark" id="inquiry">
      <div class="c68-wrap c68-rfq-grid">
        <div class="c68-rv">
          <p class="c68-kicker c68-kicker-red">Request a quotation</p>
          <h2>Send the spec.<br /><span class="c68-plate">Get an itemized quote in 12 hours.</span></h2>
          <p class="c68-head-sub">Model or standard, size, pressure class, material, quantity and destination — or simply a drawing or a photograph. Our engineers answer with unit prices, stock position and lead time, seven days a week.</p>
          <div class="c68-rfq-links">
            <a class="c68-btn c68-btn-red" href="/contact/">Open the contact page</a>
            <a class="c68-btn c68-btn-ghost" href={waCallbackHref}>WhatsApp callback</a>
          </div>
          <p class="c68-fine">QUANZHOU WANLIAN FLUID EQUIPMENT CO., LTD. · FOB · CIF · T/T</p>
        </div>
        <div class="c68-rv">
