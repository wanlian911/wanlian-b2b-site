---
import Layout from '../layouts/Layout.astro';
import { products } from '../utils/products';
import InquiryForm from '../components/inquiry/InquiryForm.astro';
import CompanyIntroVideo from '../components/sections/CompanyIntroVideo.astro';
import VideoCarousel from '../components/sections/VideoCarousel.astro';

const faq = [
  {
    question: 'What does Wanlian Fluid manufacture and export?',
    answer: 'Wanlian Fluid is a Quanzhou-based manufacturer and exporter of industrial valves and fire protection equipment: resilient and metal-seated gate valves, butterfly and check valves, fire hydrants and hydrant components, sprinkler and alarm valves, and rubber-lined fire hose — the full range being documented model by model against pressure class, connection standard, body and trim material, and application.'
  },
  {
    question: 'How do I get a price for a valve or hydrant?',
    answer: 'Pricing is by inquiry. Send your specification — model or standard, size, pressure class, material, quantity and destination — and our team replies with an itemized quote within 12 hours.'
  },
  {
    question: 'Does every unit get tested before shipment?',
    answer: 'Yes. Every valve, hydrant and hose is shell pressure-tested and air-leakage tested before shipment, with per-unit records. Production runs under an ISO 9001 quality-management system.'
  },
  {
    question: 'Do you support OEM or private-label orders?',
    answer: 'Yes. OEM/ODM, custom branding and export packaging are standard services. Compliance with a specific standard (for example AWWA C502, UL listing or FM approval) is confirmed per model with test reports and certificates before ordering.'
  }
];

// Featured products for the homepage (Real Wanlian Products)
const featuredProducts = products.filter(p => [
  'resilient-seat-flanged-gate-valve-z41x',
  'indoor-fire-hydrant-head-sn65',
  'wet-alarm-check-valve-zsfz-150',
  'signal-grooved-wafer-butterfly-valve-dn80',
  'spherical-ball-check-valve-hq44x',
  'hydraulic-water-level-control-valve-f745x',
  'telescopic-y-strainer-sgl41h',
  'anti-collision-pressure-regulating-outdoor-hydrant-ssft100'
].includes(p.slug));

// Category grid and the grouped catalog index are both derived from products.ts, so the set of
// product lines, their counts and their card photography cannot drift from the live catalog.
// CATEGORY_LEAD only chooses which existing product photo represents a line.
const CATEGORY_LEAD: Record<string, string> = {
  'Valves & Parts': 'resilient-seat-flanged-gate-valve-z41x',
  'Hydrants & Pump Connections': 'indoor-fire-hydrant-head-sn65',
  'Sprinklers & Alarm Valves': 'wet-alarm-check-valve-zsfz-150',
  'Hydraulic Safety': 'hydraulic-water-level-control-valve-f745x',
  'Extinguishing Water Cannons': 'manual-fire-water-cannon-ps',
  'Fire Cabinets & Interfaces': 'foam-fire-hydrant-cabinet-psg30',
  'Fire Hose & Reels': 'pvc-fire-hose'
};

const categoryNames: string[] = [...new Set(products.map(p => p.category))];

const categories = categoryNames.map(name => {
  const inCategory = products.filter(p => p.category === name);
  const lead = inCategory.find(p => p.slug === CATEGORY_LEAD[name]) ?? inCategory[0];
  return { name, count: inCategory.length, image: lead.image };
});

const catalogByCategory = categories.map(cat => ({
  name: cat.name,
  items: products.filter(p => p.category === cat.name)
}));

const productionSteps = [
  { step: '01', title: 'Precision Weaving', desc: 'High-strength polyester weaving for durable fire hose jackets.', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
  { step: '02', title: 'Lining Bonding', desc: 'Advanced vulcanization process for bubble-tight rubber lining.', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { step: '03', title: 'CNC Machining', desc: 'Precision machining for ductile iron valve bodies and components.', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
  { step: '04', title: 'Safety Testing', desc: '100% shell pressure and air leakage testing for every unit.', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { step: '05', title: 'Epoxy Coating', desc: 'Non-toxic epoxy resin coating for superior corrosion resistance.', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' }
];

// Hose jacketing and valve/hydrant machining are separate processes that converge on shared
// testing and finishing, so each step states which line it belongs to.
const stepLines: Record<string, string> = {
  '01': 'Fire hose',
  '02': 'Fire hose',
  '03': 'Valves & hydrants',
  '04': 'All lines',
  '05': 'Valves & hydrants'
};

// Marks mirror /certificates/ one-for-one. Scope there is stated per model, so the strip must
// not read as an unconditional claim to every standard.
const certifications = [
  { name: 'UL Listed', code: 'UL 262 / UL 1091' },
  { name: 'FM Approved', code: 'Class 1120 / 1130' },
  { name: 'CE Certified', code: 'EN 12266-1' },
  { name: 'ISO 9001:2015', code: 'Quality Management' },
  { name: 'LPCB', code: 'RedBook Listing' },
  { name: 'GB Standard', code: 'GB 5135 / GB 4452' }
];

const waCallbackHref = `https://wa.me/8618684324501?text=${encodeURIComponent('Hi, I would like a callback about valves or fire protection equipment from wanlian911.com.')}`;

// 指南与系统页资源入口(首页权重导向内容页)
const resources = [
  { href: '/guides/fire-sprinkler-system-valves-guide/', eyebrow: 'Buying Guide', title: 'Fire Sprinkler System Valves Guide', desc: 'Wet alarm, deluge and pre-action valve groups explained for sprinkler system buyers.' },
  { href: '/guides/fire-sprinkler-system-wet-dry-preaction/', eyebrow: 'Buying Guide', title: 'Wet, Dry or Pre-action Sprinkler Systems', desc: 'Compare system types and match the right configuration to your building risk profile.' },
  { href: '/fire-water-cannon/', eyebrow: 'System Overview', title: 'Fire Water Cannons & Monitors', desc: 'Manual PS monitors and auto-tracking ZDMS cannons for large-space fire suppression.' },
  { href: '/guides/how-to-choose-a-fire-hydrant/', eyebrow: 'Buying Guide', title: 'How to Choose a Fire Hydrant', desc: 'Hydrant types, pressure classes, connection standards and a factory procurement checklist.' },
  { href: '/guides/how-to-choose-ul-listed-fire-valves/', eyebrow: 'Buying Guide', title: 'How to Choose UL Listed Fire Valves', desc: 'What UL listing really means, UL vs FM, and how to verify genuine certificates.' },
  { href: '/guides/gate-valve-vs-butterfly-valve-fire-protection/', eyebrow: 'Buying Guide', title: 'Gate Valve vs Butterfly Valve', desc: 'Flow, space, cost and duty comparison for fire mains and sprinkler branch lines.' }
];

// On-site project evidence: real fire pump room installation (photos + portrait walkthrough video)
const projectPhotos = [
  { src: '/assets/projects/pump-skids.webp', alt: 'Row of sprinkler fire pump sets with OPEN and CLOSE position tags at an installed fire pump room', caption: 'Pump skids with OPEN/CLOSE position tags' },
  { src: '/assets/projects/valve-train.webp', alt: 'Gate valve train and gauges on red riser mains at the installed fire pump room', caption: 'Riser mains and gate valve train' },
  { src: '/assets/projects/riser-grid.webp', alt: 'Riser main grid with overhead ductwork and cable trays at the installed fire pump room', caption: 'Riser grid and overhead ductwork' },
  { src: '/assets/projects/pump-room-final.webp', alt: 'Installed fire pump room staged for inspection and handover', caption: 'Pump room staged for handover' },
];

const projectScope = [
  'Multiple sprinkler and fire pump sets installed on concrete plinths',
  'Full riser main grid with gate valves, gauges and OPEN/CLOSE position tags',
  'Overhead ductwork and cable trays routed alongside the riser grid',
  'Site staged for final inspection and handover',
];

const industries = [
  { name: 'Oil & Gas', desc: 'Secure fluid transport under extreme industrial conditions.', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { name: 'Water Treatment', desc: 'Municipal water supply, drainage, and filtration systems.', icon: 'M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3' },
  { name: 'Fire Protection', desc: 'Certified hydrants, sprinkler valves, and suppression systems.', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' }
];
---

<Layout title="Wanlian Fluid | Valve &amp; Fire Protection Manufacturer in China" description="Wanlian Fluid is a Quanzhou-based manufacturer and exporter of industrial valves and fire protection equipment for global B2B projects. Own production lines, CNC machining, ISO 9001, inquiry-based quotation." faq={faq} video={{ name: 'Inside Wanlian Fluid in 50 Seconds', description: 'Company introduction video: showroom, production lines, OEM customization and quality inspection at the Quanzhou plant.', thumbnail: '/videos/company-intro-poster.webp', src: '/videos/company-intro.mp4', duration: 'PT49S', uploadDate: '2026-09-18' }}>
  <!-- Hero Section with Diagonal Aesthetic -->
  <section class="relative bg-gray-900 text-white min-h-[85vh] flex items-center overflow-hidden">
    <!-- Cinematic product backdrop with slow Ken Burns; gradients keep copy legible and the baked wordmark subdued -->
    <div class="absolute inset-0 z-0" aria-hidden="true">
      <img src="/og-image.jpg" alt="" fetchpriority="high" class="w-full h-full object-cover object-center opacity-90 hero-kenburns" />
      <div class="absolute inset-0 bg-gradient-to-r from-gray-950 via-gray-950/75 to-gray-950/15"></div>
      <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-gray-950 to-transparent"></div>
    </div>
    
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-24">
      <div class="max-w-3xl space-y-6 sm:space-y-8">
        <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full border border-white/20">
          <span class="flex h-2 w-2 rounded-full bg-brand-red animate-pulse"></span>
          <span class="text-sm font-bold tracking-widest uppercase">Manufacturer &amp; Exporter — Valves &amp; Fire Protection</span>
        </div>
        
        <h1 class="text-4xl sm:text-6xl font-black tracking-tight leading-[1.15]">
          Valves &amp; Fire Protection <br/>
          <span class="text-brand-red">Equipment for Global Projects.</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-gray-300 max-w-2xl leading-relaxed">
          Industrial valves, fire hydrants and sprinkler &amp; alarm valve systems — 100% pressure tested, ISO 9001, itemized quote within 12 hours.
        </p>
        
        <div class="flex flex-wrap gap-4 pt-4">
          <a href="/products/" class="px-8 py-4 bg-brand-red hover:opacity-90 text-white font-bold rounded-lg transition shadow-xl shadow-brand-red/20 transform hover:-translate-y-1">
            Explore Catalog
          </a>
          <a href="/contact/#inquiry" class="px-8 py-4 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white font-bold rounded-lg border border-white/30 transition">
            Request RFQ
          </a>
        </div>
      </div>
    </div>
  </section>

  <VideoCarousel locale="en" />

  <!-- Certification strip: the six marks documented on /certificates/, stated with the
       per-model scope qualifier the certificates page itself uses -->
  <section class="py-10 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-px bg-gray-200 border border-gray-200 rounded-xl overflow-hidden">
        {certifications.map(cert => (
          <div class="bg-white px-4 py-5 text-center">
            <p class="text-sm font-black text-gray-900 tracking-tight leading-tight">{cert.name}</p>
            <p class="mt-1 text-[11px] font-bold text-brand-blue uppercase tracking-widest">{cert.code}</p>
          </div>
        ))}
      </div>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <p class="text-xs text-gray-500 leading-relaxed max-w-2xl">
          Listing and approval scope is granted per model. Certificate copies and the exact listed model are confirmed against your specification before order.
        </p>
        <a href="/certificates/" class="inline-flex items-center gap-2 text-sm font-bold text-brand-blue hover:underline shrink-0">
          Certificates &amp; scope <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Product Classification Grid: 首页第一层分流。分类集合与数量取自 products.ts,
       卡片图取自该分类下真实产品的 image 字段,不新增未核实的路径 -->
  <section id="categories" class="py-20 bg-gray-50 border-b border-gray-200 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:justify-between md:items-end gap-4 mb-12">
        <div class="space-y-4">
          <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Browse by Product Line</h2>
          <h3 class="text-4xl font-black text-gray-900 tracking-tight">Core Product <span class="text-brand-red">Categories</span></h3>
        </div>
        <p class="text-gray-500 max-w-md hidden md:block">Each card opens a live filter on the catalog. Counts are the models currently documented on this site.</p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {categories.map(cat => (
          <a href={`/products/#category=${encodeURIComponent(cat.name)}`} class="group bg-white rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-200 flex flex-col">
            <div class="aspect-[4/3] overflow-hidden bg-white p-5 flex items-center justify-center">
              <img src={cat.image} alt={cat.name} loading="lazy" class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="px-5 py-4 border-t border-gray-100 flex items-center justify-between gap-2">
              <div class="min-w-0">
                <h4 class="font-black text-sm leading-tight text-gray-900 group-hover:text-brand-red transition-colors">{cat.name}</h4>
                <p class="mt-1 text-[11px] font-bold uppercase tracking-widest text-gray-400 tabular-nums">{cat.count} models</p>
              </div>
              <span class="text-brand-blue opacity-0 group-hover:opacity-100 transition-opacity shrink-0">→</span>
            </div>
          </a>
        ))}
        <a href="/products/" class="group bg-brand-blue rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden p-5 flex flex-col justify-between text-white">
          <div>
            <p class="text-[11px] font-black uppercase tracking-widest text-white/70">Full catalog</p>
            <p class="mt-3 text-2xl font-black leading-tight tabular-nums">{products.length} models</p>
            <p class="mt-2 text-sm text-white/80 leading-relaxed">Filter by line, size and pressure class — or send us a drawing.</p>
          </div>
          <span class="mt-6 inline-flex items-center gap-2 text-sm font-bold">Open catalog <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Industry Scenarios: 由页尾前移,作为按应用分流;详情指向 /applications/ -->
  <section class="py-16 bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-center">
        <div class="space-y-4">
          <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Where They Are Used</h2>
          <h3 class="text-3xl font-black text-gray-900 tracking-tight leading-tight">Built for High-Pressure Duty.</h3>
          <div>
            <a href="/applications/" class="inline-flex items-center gap-2 text-sm font-bold text-brand-red hover:underline">Application guide <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-4">
          {industries.map(ind => (
            <a href="/applications/" class="group p-6 bg-gray-50 border border-gray-200 rounded-xl hover:border-brand-blue transition-colors">
              <div class="w-10 h-10 rounded-lg bg-brand-blue/10 flex items-center justify-center text-brand-blue mb-4">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={ind.icon}/></svg>
              </div>
              <h4 class="font-black text-gray-900 uppercase tracking-wide">{ind.name}</h4>
              <p class="mt-2 text-xs text-gray-500 leading-relaxed">{ind.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- About Section: Factory Strength -->
  <section class="py-24 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="flex-1 space-y-8">
          <div class="space-y-4">
            <h2 class="text-sm font-black tracking-[0.3em] text-brand-red uppercase flex items-center gap-2">
              <span class="w-8 h-[2px] bg-brand-red"></span>
              Company Profile
            </h2>
            <h3 class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight leading-tight">
              Fluid Control Solutions <br/><span class="text-brand-blue">For Global Projects.</span>
            </h3>
          </div>
          
          <div class="space-y-6 text-gray-600 text-lg leading-relaxed">
            <p>
              Based in Quanzhou, Fujian — the core cluster of China's plumbing and valve industry — Quanzhou Wanlian Fluid Equipment Co., Ltd. manufactures and exports industrial valves, hydraulic control products, hydrant components, and fire protection equipment for international B2B projects. Manufacturing runs on our own production lines in Quanzhou, with selected items produced by qualified manufacturing partners; valve bodies are CNC-machined and every unit is shell pressure and air-leakage tested before shipment, under an ISO 9001 quality management system.
            </p>
            <p>
              We build every product page around the specifications buyers actually specify from — pressure class, connection standard, body and trim material, and application — with inquiry-based quotations and engineering support for water supply, industrial fluid control, and firefighting systems.
            </p>
          </div>

          <!-- Metric Cards: 数字大字报(数据均为站内可查的真实数据) -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 pt-4">
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-red tabular-nums">{products.length}</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Catalogued Models</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-blue tabular-nums">{categories.length}</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Product Lines</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-red tabular-nums">100%</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Pressure Tested</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-blue tabular-nums">ISO 9001</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Quality System</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-3 pt-2">
            <span class="px-4 py-2 bg-brand-red/5 border border-brand-red/20 text-brand-red text-xs font-black uppercase tracking-widest rounded-full">R&D · Sales · Service</span>
            <span class="px-4 py-2 bg-brand-blue/5 border border-brand-blue/20 text-brand-blue text-xs font-black uppercase tracking-widest rounded-full">ISO 9001 Certified</span>
            <span class="px-4 py-2 bg-gray-100 border border-gray-200 text-gray-700 text-xs font-black uppercase tracking-widest rounded-full">OEM · ODM · Custom</span>
          </div>

          <a href="/about/" class="inline-flex items-center gap-2 font-bold text-brand-blue hover:underline pt-2">
            Read Full Company Profile <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="flex-1 relative">
          <div class="absolute -top-10 -left-10 w-40 h-40 bg-blue-100 rounded-full blur-3xl opacity-50 z-0"></div>
          <CompanyIntroVideo locale="en" />
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us: 三点式优势（每条声明均可在站内核实：工艺流程段/认证墙/FAQ 12h 承诺） -->
  <section class="py-24 bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
        <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Why Choose Us</h2>
        <h3 class="text-4xl font-black text-gray-900 tracking-tight">Why Choose <span class="text-brand-red">Wanlian</span></h3>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-8 rounded-2xl border border-gray-200 bg-gray-50 hover:shadow-lg transition-shadow duration-300">
          <div class="w-12 h-12 rounded-lg bg-brand-red/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h4 class="text-lg font-black text-gray-900 mb-2">In-House Production Lines</h4>
          <p class="text-gray-600 text-sm leading-relaxed">CNC machining, assembly, pressure testing and coating run on our own lines at the Quanzhou plant, with qualified partner capacity for peak orders.</p>
        </div>
        <div class="p-8 rounded-2xl border border-gray-200 bg-gray-50 hover:shadow-lg transition-shadow duration-300">
          <div class="w-12 h-12 rounded-lg bg-brand-red/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h4 class="text-lg font-black text-gray-900 mb-2">Certified, Tested Every Batch</h4>
          <p class="text-gray-600 text-sm leading-relaxed">ISO 9001:2015 quality system with 100% shell and seat pressure testing per GB/T13927 / EN 12266-1 before packing. UL 262 / UL 1091 listing and FM Class 1120/1130 approval apply per listed model — coverage is confirmed against the certificate before order.</p>
        </div>
        <div class="p-8 rounded-2xl border border-gray-200 bg-gray-50 hover:shadow-lg transition-shadow duration-300">
          <div class="w-12 h-12 rounded-lg bg-brand-red/10 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h4 class="text-lg font-black text-gray-900 mb-2">12-Hour Itemized Quotes</h4>
          <p class="text-gray-600 text-sm leading-relaxed">Send drawings, specs or just a photo — our engineers reply with an itemized quote, stock status and lead time within 12 hours, 7 days a week.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Production Excellence: 每个工序标注所属产线;step.icon 此前只存在于数据中、从未被渲染 -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-4">
        <div class="space-y-4">
          <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Production Workflow</h2>
          <h3 class="text-4xl font-black text-gray-900 tracking-tight">Our Manufacturing Process</h3>
        </div>
        <p class="text-gray-500 max-w-md text-right hidden md:block">Two lines, one finishing discipline: hose jackets are woven and lined in-house, valve and hydrant bodies are CNC-machined, and every unit is pressure tested before coating and packing.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {productionSteps.map((step, idx) => (
          <div class="relative group">
            <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 space-y-4 h-full group-hover:bg-blue-50 transition-colors">
              <div class="flex items-center justify-between gap-2">
                <div class="w-10 h-10 rounded-lg bg-brand-blue/10 text-brand-blue flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={step.icon}/></svg>
                </div>
                <span class="text-3xl font-black text-gray-200 group-hover:text-brand-blue/20 transition-colors tabular-nums">{step.step}</span>
              </div>
              <h4 class="font-bold text-gray-900 leading-tight">{step.title}</h4>
              <p class="text-sm text-gray-500 leading-relaxed">{step.desc}</p>
              <p class="pt-3 border-t border-gray-200 text-[10px] font-black uppercase tracking-widest text-gray-400">{stepLines[step.step]}</p>
            </div>
            {idx < productionSteps.length - 1 && (
              <div class="hidden lg:block absolute top-1/2 -right-3 transform -translate-y-1/2 z-10">
                <svg class="w-6 h-6 text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Project Cases: real on-site installation evidence (photos + portrait walkthrough video) -->
  <section class="py-24 bg-gray-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-end mb-14 gap-4">
        <div class="space-y-4">
          <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Project Cases</h2>
          <h3 class="text-4xl font-black text-gray-900 tracking-tight">Our Projects, <span class="text-brand-red">On Site</span></h3>
        </div>
        <p class="text-gray-500 max-w-md text-right hidden md:block">Photos and video from a fire pump room project — real installation work, ready for handover.</p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
        {projectPhotos.map(photo => (
          <figure class="group bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300">
            <div class="aspect-[4/3] overflow-hidden bg-gray-100">
              <img src={photo.src} alt={photo.alt} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <figcaption class="px-4 py-3 text-xs font-bold text-gray-600 leading-snug">{photo.caption}</figcaption>
          </figure>
        ))}
      </div>

      <div class="mt-10 grid md:grid-cols-3 gap-6 items-center">
        <div class="flex justify-center">
          <div class="relative rounded-xl overflow-hidden bg-gray-900 shadow-xl">
            <video class="h-[420px] w-auto object-cover" src="/assets/projects/project-walkthrough.mp4" poster="/assets/projects/pump-room-wide.webp" muted loop autoplay playsinline preload="metadata" controls></video>
            <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-brand-red text-white text-[10px] font-black uppercase tracking-wider pointer-events-none">On-Site Video</span>
          </div>
        </div>
        <div class="md:col-span-2">
          <h4 class="text-xl font-black text-gray-900 mb-5">What Was Installed on This Site</h4>
          <ul class="space-y-3 mb-8">
            {projectScope.map(item => (
              <li class="flex items-start gap-3">
                <span class="mt-1 w-2 h-2 rounded-full bg-brand-red shrink-0"></span>
                <span class="text-gray-600 text-sm leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
          <a href="/contact/" class="inline-flex items-center gap-2 px-8 py-4 bg-brand-red hover:opacity-90 text-white font-bold rounded-lg transition shadow-lg shadow-brand-red/20 transform hover:-translate-y-0.5">
            Discuss Your Project <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-24 bg-gray-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-16">
        <h2 class="text-4xl font-black text-gray-900 tracking-tight">Global <span class="text-brand-red">Best Sellers</span></h2>
        <a href="/products/" class="text-brand-blue font-bold hover:underline">Full Catalog →</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {featuredProducts.map(product => (
          <div class="group bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300">
            <div class="aspect-square relative overflow-hidden bg-gray-50 p-6">
              <img src={product.image} alt={product.name} loading="lazy" class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute top-4 left-4 flex gap-2">
                <span class="px-2 py-1 bg-gray-900/80 text-white text-[10px] font-black uppercase tracking-widest rounded">
                  {product.category}
                </span>
  
              </div>
            </div>
            <div class="p-6 space-y-4">
              <h4 class="font-bold text-gray-900 line-clamp-2 min-h-[3rem] group-hover:text-brand-red transition-colors tracking-tight">{product.name}</h4>
              <div class="pt-4 border-t border-gray-100 flex gap-2">
                <a href={`/products/${product.slug}/`} class="flex-1 py-2 text-center text-xs font-black border border-gray-200 rounded hover:bg-gray-50 transition">DETAILS</a>
                <a href={`/contact/?product=${encodeURIComponent(product.name)}`} class="flex-1 py-2 text-center text-xs font-black bg-brand-red text-white rounded hover:opacity-90 transition">INQUIRE</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Complete Product Line: 全量产品内链改为按产品线分组。52 条产品页链接一条不减,
       但去掉 line-clamp-1 造成的品名截断,避免锚文本在页面上被省略号切断 -->
  <section class="py-24 bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:justify-between md:items-end gap-4 mb-12">
        <div class="space-y-4">
          <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Full Model Index</h2>
          <h3 class="text-4xl font-black text-gray-900 tracking-tight">Complete <span class="text-brand-red">Product Line</span></h3>
        </div>
        <a href="/products/" class="text-brand-red font-bold hover:underline shrink-0">All products &amp; filters →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-10 gap-y-12">
        {catalogByCategory.map(group => (
          <div>
            <div class="flex items-baseline justify-between gap-3 pb-3 mb-1 border-b-2 border-brand-blue/30">
              <a href={`/products/#category=${encodeURIComponent(group.name)}`} class="font-black text-gray-900 hover:text-brand-red transition-colors leading-tight">{group.name}</a>
              <span class="text-[11px] font-bold text-gray-400 uppercase tracking-widest tabular-nums shrink-0">{group.items.length}</span>
            </div>
            <ul>
              {group.items.map(product => (
                <li>
                  <a href={`/products/${product.slug}/`} class="group flex items-start justify-between gap-3 py-2 border-b border-gray-100 hover:border-brand-red transition-colors">
                    <span class="text-sm font-semibold text-gray-700 group-hover:text-brand-red transition-colors leading-snug">{product.name}</span>
                    <span class="text-brand-blue opacity-0 group-hover:opacity-100 transition-opacity shrink-0">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Selection Guides & Resources: 指南/系统页关键词入口 -->
  <section class="py-24 bg-gray-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
        <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Technical Resources</h2>
        <h3 class="text-4xl font-black text-gray-900 tracking-tight">Selection Guides &amp; System Overviews</h3>
        <div class="h-1.5 w-20 bg-brand-red mx-auto"></div>
        <p class="text-gray-500 font-medium">Spec sheets are useful — engineering context is better. Read before you specify.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {resources.map(item => (
          <a href={item.href} class="group flex flex-col justify-between bg-white rounded-xl border border-gray-200 p-7 hover:border-brand-red hover:shadow-lg transition-all duration-300">
            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-brand-blue">{item.eyebrow}</span>
              <h4 class="mt-3 text-lg font-black text-gray-900 leading-snug group-hover:text-brand-red transition-colors">{item.title}</h4>
              <p class="mt-2 text-sm text-gray-500 leading-relaxed">{item.desc}</p>
            </div>
            <span class="mt-5 inline-flex items-center gap-1 text-brand-red font-bold text-xs group-hover:gap-2 transition-all">
              Read Resource
              <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Quick Inquiry Section -->
  <section id="inquiry" class="py-24 bg-white scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="space-y-8">
          <div class="space-y-4">
             <h2 class="text-4xl font-black text-gray-900 tracking-tight uppercase">Get a Professional Quote</h2>
             <div class="h-1.5 w-20 bg-brand-red"></div>
          </div>
          <p class="text-lg text-gray-600 leading-relaxed">
            Submit your technical drawings or product requirements. We will review the details and follow up with suitable product information and quotation steps.
          </p>
          <ul class="space-y-4">
            {['Inquiry-based quotation', 'Application and selection support', 'Export packaging coordination', 'Product documentation support'].map(item => (
              <li class="flex items-center gap-3 text-gray-700 font-bold">
                <svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <InquiryForm />
      </div>
    </div>
  </section>
  
  <!-- 轻量留资:完整询盘表单已在上方,轻量表单复用 Layout 中全站渲染的悬浮留资弹窗
       (leadSource=Floating Lead Button),首页结尾不再连续堆叠两个表单 -->
  <section class="py-16 bg-gray-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white border border-gray-200 rounded-2xl p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="max-w-xl">
          <h3 class="text-xl font-black text-gray-900 tracking-tight">Not ready to send a full inquiry?</h3>
          <p class="mt-2 text-sm text-gray-600 leading-relaxed">Leave a name and a phone number or e-mail, and our sales team follows up with product information, documentation and a quotation. Reply within 12 hours, 7 days a week — your details are used only for this follow-up.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <button type="button" data-open-lead-form class="px-6 py-3 bg-brand-red hover:opacity-90 text-white font-bold rounded-lg transition text-center">Leave My Contact Info</button>
          <a href={waCallbackHref} target="_blank" rel="noopener noreferrer" class="px-6 py-3 border border-gray-300 text-gray-800 font-bold rounded-lg hover:border-brand-blue hover:text-brand-blue transition text-center">Chat on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    // 打开 Layout 中的全站悬浮留资弹窗;若该组件未渲染则退回联系页表单,不留死按钮
    document.querySelectorAll('[data-open-lead-form]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const floatBtn = document.getElementById('floatingLeadBtn');
        if (floatBtn) {
          floatBtn.click();
          return;
        }
        window.location.href = '/contact/#inquiry';
      });
    });
  </script>

  <style is:global>
    @keyframes hero-kenburns { from { transform: scale(1); } to { transform: scale(1.07); } }
    .hero-kenburns { animation: hero-kenburns 26s ease-in-out infinite alternate; will-change: transform; }
    @media (prefers-reduced-motion: reduce) { .hero-kenburns { animation: none; } }
  </style>
</Layout>
