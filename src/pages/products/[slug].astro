---
import Layout from '../../layouts/Layout.astro';
import WhatsAppButton from '../../components/shared/WhatsAppButton.astro';
import ProductGallery from '../../components/shared/ProductGallery.astro';
import { products } from '../../utils/products';
import { PRODUCT_FAMILY_RELATED } from '../../utils/product-families';
import { guides as guidesEn } from '../../utils/guides';

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

// 按分类生成通用采购 FAQ（数据来源：产品规格与常见询盘问题）
const faqByCategory: Record<string, { question: string; answer: string }[]> = {
  'Fire Hose & Reels': [
    { question: 'Which fire hose coupling patterns can Wanlian supply?', answer: 'Hoses can be fitted with GOST, Storz, instantaneous or NPT couplings in aluminum alloy or brass. GOST couplings are machined to GOST 22695 / GOST 25813 in DN50 (RK-50) and DN65 (RK-70) at 1.0 MPa or 1.6 MPa, as head, tail, adapter or coupling. Tell us the pattern your hydrants use and we will match it.' },
    { question: 'Should I choose a PVC lined or a rubber lined fire hose?', answer: 'PVC lined hoses are lightweight and cost-effective, offered in DN25 to DN65 at 0.8 or 1.0 MPa with a service range of 0°C to +50°C, which suits residential, commercial and light industrial use. Rubber lined hoses add a natural rubber lining under an abrasion resistant, UV stabilized polyester jacket, extend to DN80 and 1.3 MPa, and stay usable from -20°C to +60°C, so they are the usual choice for high-pressure and cold climate duty.' },
    { question: 'How is a fixed fire hose reel specified?', answer: 'A reel is configured by hose diameter (DN19 or DN25), length (20m, 25m or 30m), working pressure (0.8 or 1.0 MPa) and inlet connection (1 inch BSP, NPT or GOST). Each set ships complete with hose, adjustable spray or jet nozzle and mounting bracket, with a swivel joint for 360 degree deployment and a choice of manual or automatic swing-out frames.' },
    { question: 'Can I order hose, reels and couplings as one package?', answer: 'Yes. We already supply complete indoor fire hydrant sets including valve, coupling, hose and nozzle to GOST standards. Send the nominal diameter, hose length, working pressure and coupling pattern for each line and our engineers will confirm a compatible combination, together with the type-test and certification documents for your project.' }
  ],
  'Valves & Parts': [
    { question: 'What standards and connection types are available for Wanlian valves?', answer: 'Wanlian valves are manufactured to GB, ANSI, DIN and JIS standards on request. Flanged, grooved, wafer and threaded connections are available depending on the model. Tell our engineers your DN/PN and connection type in the inquiry and we will confirm the matching configuration.' },
    { question: 'What materials are used for the valve body and sealing?', answer: 'Bodies are typically ductile iron (QT450), cast iron or cast/forged steel depending on the model. Sealing elements use EPDM or NBR rubber, and stems are stainless steel (2Cr13/304). Material options can be customized for specific media and temperature ranges.' },
    { question: 'What is the MOQ and lead time?', answer: 'Standard MOQ is typically 20 units per model for stock sizes, with production lead times of 15-30 days depending on quantity and customization. Sample orders are available for pre-shipment testing.' },
    { question: 'How are the valves tested before shipment?', answer: 'Every valve undergoes 100% shell and seat pressure testing in accordance with the applicable standard (e.g. GB/T13927, EN 12266-1). Test reports and third-party inspection can be arranged on request.' }
  ],
  'Hydrants & Pump Connections': [
    { question: 'What outlet connection standards are available for export fire hydrants?', answer: 'Common outlet connections include BS336 (UK/Commonwealth), NIST (Middle East), KWS (Germany) and flexible flange options. We can supply hydrants with the connection type specified for your market.' },
    { question: 'What pressure rating should a municipal fire hydrant have?', answer: 'Standard municipal hydrants are rated at PN16 (1.6 MPa), which covers most urban and industrial water supply networks. High-rise or high-demand industrial zones may require PN25 hydrants.' },
    { question: 'Are Wanlian hydrants available with UL or FM certification?', answer: 'Yes, depending on the model and destination market. Contact our sales team with your project specification and target region so we can match the correct certification package.' },
    { question: 'Do outdoor hydrants have antifreeze protection?', answer: 'Models such as the SS100 overground hydrant feature an automatic frost-drainage mechanism for cold climates. Anti-collision (SSFT100) and IoT smart (SS100ZN) variants are also available.' }
  ],
  'Sprinklers & Alarm Valves': [
    { question: 'What is the difference between a wet alarm valve and a deluge valve?', answer: 'A wet alarm valve (ZSFZ) keeps the sprinkler piping filled with water and triggers the alarm on water flow. A deluge valve (ZSFM) stays closed under air or water pressure and floods the system only when a fire detection signal opens it - used for high-hazard areas requiring immediate large water discharge.' },
    { question: 'What standards do the sprinkler system components comply with?', answer: 'Components are manufactured and tested in accordance with GB 5135 series and, on request, other international standards. Confirm the applicable standard for your project with our engineers.' },
    { question: 'What is the working pressure of the alarm valves?', answer: 'Standard working pressure is 1.6 MPa with a testing pressure of 3.2 MPa. Size ranges typically cover DN50 to DN300 depending on the model.' },
    { question: 'Can the alarm valve groups be integrated with existing fire detection systems?', answer: 'Yes. Deluge and pre-action valves support mechanical, pneumatic or electrical (DC24V solenoid) remote triggers and can be integrated with most fire alarm control panels.' }
  ],
  'Hydraulic Safety': [
    { question: 'Do hydraulic control valves require electrical power?', answer: 'Most hydraulic control valves (e.g. F745X level control, 500X pressure reducing) are fully self-operated by pipeline pressure and require no external power. Solenoid-controlled models such as GKZF-1 use AC220V or DC24V.' },
    { question: 'What is the pressure adjustment range of the 500X valve?', answer: 'The 500X pressure reducing valve adjusts downstream pressure from 0.1 MPa to 1.6 MPa and works with inlet pressures up to the nominal rating (PN10/PN16/PN25).' },
    { question: 'What materials are used for potable water applications?', answer: 'For drinking water networks, models such as the HS41X backflow preventer use ductile iron bodies with EPDM seals and stainless steel internals, compliant with GB/T17219 sanitary requirements.' },
    { question: 'How is water hammer prevented in hydraulic valves?', answer: 'Pilot-controlled valves close smoothly and slowly, which avoids sudden pressure surges. Needle valves allow adjustment of the closing speed to match the specific pipeline conditions.' }
  ],
  'Extinguishing Water Cannons': [
    { question: 'What flow rates and jet ranges are available for fire water cannons?', answer: 'Manual cannons (PS series) cover 20-200 L/s with jet distances of 50-110 meters. Auto-tracking cannons (ZDMS series) offer 5-30 L/s (customizable up to 150 L/s) with a 40-65m monitoring radius.' },
    { question: 'How does the auto-tracking fire cannon detect fires?', answer: 'The ZDMS cannon combines infrared and ultraviolet sensors to detect and track flames, then automatically aims and discharges water. It supports manual remote override via PC/mobile APP or a central cabinet.' },
    { question: 'Are explosion-proof versions available?', answer: 'Yes, explosion-proof options (e.g. Exde II BT4 Gb) are available for petrochemical and hazardous environments.' },
    { question: 'What is the working pressure for the cannons?', answer: 'Manual cannons work at 0.8-1.2 MPa, and auto-tracking cannons at 0.6-0.8 MPa. Confirm the inlet flange size (DN100/DN150/DN200) for your system.' }
  ],
  'Fire Cabinets & Interfaces': [
    { question: 'What is included in a fire hose reel set?', answer: 'The JPS series set includes a carbon steel swivel-mount reel, flexible layflat PVC hose (20/25/30m), and a brass/alloy spray nozzle supporting straight jet and fog modes.' },
    { question: 'Are foam fire cabinets available for chemical fires?', answer: 'Yes. The PSG30 foam cabinet packages a foam concentrate tank, proportioner, hose reel and foam nozzle in one wall-mounted unit - effective against fuel, chemical and solvent (Class B) fires.' },
    { question: 'What connection standards do the hose coupling adapters support?', answer: 'HS series adapters are available in DN50/DN65 with internal threads compatible with international firefighting couplings, manufactured to GB12514 or factory standards.' },
    { question: 'What materials are used for the cabinets and reels?', answer: 'Cabinets and reels use cold-rolled carbon steel with anti-corrosion red powder coating. Nozzles and proportioners are brass or anodized aluminum alloy.' }
  ]
};

// 按分类映射应用场景与测试标准
const categoryInfo: Record<string, { applications: string[]; testing: string }> = {
  'Fire Hose & Reels': {
    applications: ['Indoor fire protection in commercial buildings, hotels, offices and factories', 'Residential, commercial and light industrial hose lines', 'High-pressure fire fighting applications', 'GOST fire hydrant and hose networks for Russian and CIS market projects'],
    testing: 'Hose assemblies are rated to a burst pressure of 3x the working pressure. Reels follow EN 671 / GB 14561 and GOST couplings follow GOST 22695 / GOST 25813. Type-test and certification documents are available on request.'
  },
  'Valves & Parts': {
    applications: ['Water supply & distribution', 'Wastewater and sewage networks', 'Industrial process pipelines', 'HVAC systems'],
    testing: '100% shell and seat pressure testing per GB/T13927 or EN 12266-1; epoxy resin coating tested for corrosion resistance.'
  },
  'Hydrants & Pump Connections': {
    applications: ['Municipal fire protection networks', 'Industrial and warehouse yards', 'Indoor standpipe systems', 'Cold-climate outdoor installations'],
    testing: 'Hydrostatic pressure testing (2.4 MPa typical) and flow testing per GB 4452 or applicable export standards.'
  },
  'Sprinklers & Alarm Valves': {
    applications: ['Automatic sprinkler systems', 'Commercial and residential buildings', 'Industrial warehouses', 'High-hazard deluge and pre-action systems'],
    testing: 'Pressure and leakage testing per GB 5135 series; alarm sensitivity verified with flow switches and alarm gongs.'
  },
  'Hydraulic Safety': {
    applications: ['Water reservoir level control', 'Pressure management in water networks', 'Drinking water backflow protection', 'Pump suction protection'],
    testing: 'Function and pressure tests per applicable standards; diaphragm and seal assemblies tested for durability.'
  },
  'Extinguishing Water Cannons': {
    applications: ['Petrochemical plants and tank farms', 'Airports and exhibition centers', 'Large warehouses', 'Fire trucks and marine firefighting'],
    testing: 'Flow, jet range and rotation tests; explosion-proof models verified per Ex standards (optional).'
  },
  'Fire Cabinets & Interfaces': {
    applications: ['Indoor firefighting stations', 'Chemical and fuel storage areas', 'Building fire hose systems', 'Marine and offshore installations'],
    testing: 'Pressure and function testing of reels, nozzles and proportioners; foam expansion ratio verified per model.'
  }
};

// 产品级 FAQ 优先，其次按分类生成通用采购 FAQ
const faqs = product.faqs ?? faqByCategory[product.category] ?? [];
const info = categoryInfo[product.category];

// 首屏关键参数：数据里同一物理量存在多套键名（如 Size Range / Nominal Diameter / Size），
// 因此按“物理量”排序而不是按字面键名排序；标签仍显示产品原始键名，不改写任何数值。
const SPEC_PRIORITY_GROUPS: string[][] = [
  ['Nominal Diameter', 'Size Range', 'Size', 'Bore'],
  ['Nominal Pressure', 'Working Pressure', 'Pressure Rating', 'Pressure'],
  ['Connection', 'End Connection'],
  ['Standard'],
  ['Body Material', 'Material', 'Valve Body', 'Hydrant Body', 'Main Valve Body', 'Body'],
  ['Working Temperature', 'Temperature Rating', 'Temperature'],
  ['Certification', 'Compliance Standard'],
  ['Media', 'Applicable Medium'],
  ['Operation'],
  ['Structure', 'Type'],
  ['Model'],
  ['Application'],
  ['Coating'],
  ['Customization'],
];
const specEntries = Object.entries(product.specs ?? {}) as [string, string][];
const usedSpecKeys = new Set<string>();
const keySpecs: [string, string][] = [];
for (const group of SPEC_PRIORITY_GROUPS) {
  if (keySpecs.length >= 6) break;
  for (const k of group) {
    if (usedSpecKeys.has(k)) continue;
    const hit = specEntries.find(([sk, sv]) => sk === k && Boolean(sv));
    if (hit) { keySpecs.push(hit); usedSpecKeys.add(k); break; }
  }
}
// 规格键名极不规范的型号：补齐到 3 项，避免首屏参数面板空缺
if (keySpecs.length < 3) {
  for (const [k, v] of specEntries) {
    if (keySpecs.length >= 3) break;
    if (!usedSpecKeys.has(k) && Boolean(v)) { keySpecs.push([k, v]); usedSpecKeys.add(k); }
  }
}

// 产品视频教程(可选):数据源配置 product.video 后自动渲染并输出 VideoObject JSON-LD
const videoData = product.video
  ? {
      name: `${product.name} — Video Overview`,
      description: product.video.description ?? `Video overview of the ${product.name}: construction, key dimensions and installation points.`,
      thumbnail: product.video.poster ?? product.image,
      src: product.video.src,
      duration: product.video.duration ?? 'PT2M0S',
      uploadDate: product.video.uploadDate ?? '2026-09-21'
    }
  : undefined;
// 批次 C：Related 模块按产品族闭环（10 族，同族 3–4 条），与 product_families.json 的 related_links 逐页对齐；
// 未归族产品回退到分类互链，避免空模块。
const bySlug = new Map(products.map(p => [p.slug, p]));
const familySlugs = PRODUCT_FAMILY_RELATED[product.slug] ?? [];
const relatedProducts = familySlugs.length
  ? familySlugs.map(s => bySlug.get(s)).filter((p): p is typeof products[number] => Boolean(p))
  : products.filter(p => p.category === product.category && p.slug !== product.slug).slice(0, 4);

// 相关指南(GEO 内容)按产品 slug 映射,用于消防/阀门产品页回链
const hydrantGuideSlugs = ['overground-fire-hydrant-ss100', 'indoor-fire-hydrant-head-sn65', 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100', 'iot-smart-ground-fire-hydrant-ss100zn'];
const valveGuideSlugs = ['resilient-seat-flanged-gate-valve-z41x', 'telescopic-resilient-seat-gate-valve-z41x-t', 'ul-fm-resilient-seat-osy-gate-valve', 'd381x-16q-grooved-butterfly-valve', 'signal-grooved-wafer-butterfly-valve-dn80', 'spherical-ball-check-valve-hq44x'];
const hoseGuideSlugs = ['fire-hose-pvc-rubber-lining-8-65', 'storz-coupling-2-5inch-aluminum', 'fire-hydrant-hose-coupling-adapter-hs'];
const standardsGuide = { href: '/guides/fire-hydrant-valve-standards-guide/', title: 'Fire Hydrant, Fire Hose & Valve Standards Explained', description: 'AWWA C502, NFPA 1961, EN 14384, ISO 5208 — what each standard means and how to verify compliance in Chinese factories.' };
const avkGuide = { href: '/guides/wanlian-fluid-vs-american-avk/', title: 'Wanlian Fluid vs American AVK', description: 'Which fire hydrant & valve supplier fits your 2026 project? Scope, geography and standards compared side by side.' };

// 按分类默认回链 2 篇指南：确保每个产品页都有到指南的站内链接
const guidesByHref: Record<string, { title: string; description: string; cardTitle?: string; cardDescription?: string }> = {};
for (const g of guidesEn) guidesByHref[g.href] = g;
const guideCard = (href: string) => {
  const g = guidesByHref[href];
  if (!g) throw new Error('related-guide href missing from guides data: ' + href);
  return { href: href, title: g.cardTitle ?? g.title, description: g.cardDescription ?? g.description };
};
const guideByCategory: Record<string, { href: string; title: string; description: string }[]> = {
  'Fire Hose & Reels': [guideCard('/guides/fire-hose-buying-guide/'), guideCard('/guides/fire-hose-reel-cabinet-guide/')],
  'Valves & Parts': [guideCard('/guides/gate-valve-vs-butterfly-valve-fire-protection/'), guideCard('/guides/check-valve-types-guide/')],
  'Hydrants & Pump Connections': [guideCard('/guides/how-to-choose-a-fire-hydrant/'), guideCard('/guides/fire-hydrant-valve-standards-guide/')],
  'Sprinklers & Alarm Valves': [guideCard('/guides/fire-sprinkler-control-valve-types/'), guideCard('/guides/fire-sprinkler-system-wet-dry-preaction/')],
  'Hydraulic Safety': [guideCard('/guides/water-level-control-valve-guide/'), guideCard('/guides/pressure-reducing-valve-guide/'), guideCard('/guides/backflow-prevention-guide/')],
  'Extinguishing Water Cannons': [guideCard('/guides/fire-water-monitor-selection-guide/'), guideCard('/guides/fire-water-cannon-buying-guide/')],
  'Fire Cabinets & Interfaces': [guideCard('/guides/fire-hose-reel-cabinet-guide/'), guideCard('/guides/fire-extinguisher-selection-guide/')]
};

// 显式 slug 命中优先；未命中的产品按分类回链指南，去重后最多 3 篇
const explicitGuides = hydrantGuideSlugs.includes(product.slug)
  ? [standardsGuide, avkGuide]
  : valveGuideSlugs.includes(product.slug) || hoseGuideSlugs.includes(product.slug)
    ? [standardsGuide]
    : [];
const seenHrefs = new Set(explicitGuides.map(g => g.href));
const relatedGuides = [...explicitGuides, ...(guideByCategory[product.category] ?? []).filter(g => !seenHrefs.has(g.href))].slice(0, 3);
---

<Layout 
  title={product.seoTitle} 
  description={product.seoDescription}
  productData={product}
  type="product"
  faq={faqs}
  video={videoData}
  breadcrumbs={[{ name: 'Products', href: '/products/' }, { name: product.category, href: `/products/#category=${encodeURIComponent(product.category)}` }, { name: product.name }]}
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 mb-16 lg:mb-24">
    <!-- Breadcrumbs -->
    <nav class="text-[11px] text-gray-400 font-semibold uppercase tracking-widest mb-6 flex flex-wrap gap-x-2 gap-y-1">
      <a href="/" class="hover:text-brand-blue">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/products/" class="hover:text-brand-blue">Products</a>
      <span aria-hidden="true">/</span>
      <a href={`/products/#category=${encodeURIComponent(product.category)}`} class="hover:text-brand-blue">{product.category}</a>
      <span aria-hidden="true">/</span>
      <span class="text-gray-600 normal-case tracking-normal font-medium">{product.name}</span>
    </nav>

    <!-- Technical masthead: 阀门/消防行业首屏是型号与关键参数，不是营销头图 -->
    <header class="border border-gray-200 border-t-2 border-t-brand-blue bg-white">
      <div class="flex flex-col gap-6 p-5 sm:p-7 lg:flex-row lg:items-start lg:justify-between lg:gap-10">
        <div class="min-w-0 lg:flex-1">
          <p class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-[0.18em] text-brand-red">
            <span class="inline-block h-2 w-2 bg-brand-red" aria-hidden="true"></span>
            <span>{product.category}</span>
          </p>
          <h1 class="mt-2.5 text-2xl sm:text-3xl lg:text-4xl font-black text-gray-900 tracking-tight leading-tight">{product.name}</h1>
          <div class="mt-4 max-w-3xl space-y-3 text-[15px] text-gray-600 leading-relaxed">
            {product.description.split('\n\n').map(paragraph => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
        <dl class="grid grid-cols-2 gap-px bg-gray-200 border border-gray-200 shrink-0 lg:w-80">
          {keySpecs.slice(0, 4).map(([k, v]) => (
            <div class="bg-white px-3.5 py-3">
              <dt class="text-[10px] font-semibold uppercase tracking-[0.1em] text-gray-500">{k}</dt>
              <dd class="mt-1 font-mono text-[13px] font-bold text-gray-900 leading-snug">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </header>

    <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      <div class="lg:col-span-7 space-y-4">
        <!-- Product Image Gallery -->
        <ProductGallery 
          mainImage={product.image} 
          gallery={product.gallery} 
          alt={product.name} 
        />

        <!-- Product Video (renders only when product.video is configured) -->
        {product.video && (
          <div class="overflow-hidden shadow-sm border border-gray-200 bg-gray-900">
            <video class="w-full h-auto" controls playsinline preload="metadata" poster={product.video.poster}>
              <source src={product.video.src} type="video/mp4" />
              Your browser does not support embedded video.
            </video>
          </div>
        )}
      </div>

      <!-- 询价栏：全量技术表 + 常驻 CTA（阀门/消防买家按参数发询盘） -->
      <aside class="lg:col-span-5 lg:sticky lg:top-24 space-y-4">
        <section class="border border-gray-200 bg-white">
          <h2 class="flex items-baseline justify-between gap-3 border-b border-gray-200 bg-gray-50 px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.14em] text-gray-700">
            <span>Technical Specifications</span>
          </h2>
          <dl class="divide-y divide-gray-100">
            {Object.entries(product.specs).map(([key, value]) => (
              <div class="flex items-baseline justify-between gap-4 px-4 py-2">
                <dt class="shrink-0 text-[11px] font-semibold uppercase tracking-[0.06em] text-gray-500">{key}</dt>
                <dd class="text-right font-mono text-[12.5px] font-bold text-gray-900 leading-snug">{value}</dd>
              </div>
            ))}
          </dl>
          <div class="border-t border-gray-200 p-4 space-y-3">
            <p class="text-[11px] text-gray-500 leading-relaxed">Full datasheet, test reports and drawings available with your inquiry.</p>
            <a
              href={`/contact/?product=${encodeURIComponent(product.name)}`}
              class="block w-full text-center py-3 bg-brand-red text-white text-sm font-bold uppercase tracking-[0.08em] hover:bg-red-700 transition">Request quotation</a>
            <a
              href="/contact/?product=Request%20Catalog%20PDF"
              class="block w-full text-center py-3 bg-white text-brand-blue text-sm font-bold uppercase tracking-[0.08em] border-2 border-brand-blue hover:bg-blue-50 transition">Request documentation</a>
          </div>
        </section>

      </aside>
    </div>


    <!-- 技术文档区：编号章节按行业阅读顺序排列（构造 → 材质 → 尺寸 → 工况 → 检测） -->
    <div class="spec-sheet mt-10 lg:mt-12 space-y-8">
      <section class="border border-gray-200 bg-white">
        <h2 class="sheet-title">Key Features</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-2.5 p-5 sm:p-6">
          {product.features.map(feature => (
            <li class="flex items-start gap-2.5 text-sm text-gray-700 leading-relaxed">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-brand-red" aria-hidden="true"></span>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      </section>

      {product.materials && (
        <section class="border border-gray-200 bg-white">
          <h2 class="sheet-title">Parts &amp; Materials List</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr>
                  <th class="w-[38%] bg-gray-50 px-4 py-2 text-left text-[10px] font-bold uppercase tracking-[0.12em] text-gray-500 border-b border-gray-200">Component</th>
                  <th class="bg-gray-50 px-4 py-2 text-left text-[10px] font-bold uppercase tracking-[0.12em] text-gray-500 border-b border-gray-200">Material</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {Object.entries(product.materials).map(([part, material]) => (
                  <tr>
                    <td class="px-4 py-2 font-semibold text-gray-600">{part}</td>
                    <td class="px-4 py-2 font-mono text-gray-900">{material}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {product.dimensions && (
        <section class="border border-gray-200 bg-white">
          <h2 class="sheet-title">Standard Dimensions</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr>
                  {product.dimensions.headers.map(header => (
                    <th class="bg-gray-50 px-4 py-2 text-left text-[10px] font-bold uppercase tracking-[0.12em] text-gray-500 border-b border-gray-200 whitespace-nowrap">{header}</th>
                  ))}
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {product.dimensions.rows.map(row => (
                  <tr class="hover:bg-gray-50">
                    {row.map(cell => (
                      <td class="px-4 py-2 font-mono text-gray-800 whitespace-nowrap">{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {info && (
        <section class="border border-gray-200 bg-white">
          <h2 class="sheet-title">Applications</h2>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-2.5 p-5 sm:p-6">
            {info.applications.map(app => (
              <li class="flex items-start gap-2.5 text-sm text-gray-700 leading-relaxed">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-brand-blue" aria-hidden="true"></span>
                <span>{app}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {info && (
        <section class="border border-gray-200 bg-white">
          <h2 class="sheet-title">Quality &amp; Testing</h2>
          <p class="p-5 sm:p-6 text-sm text-gray-700 leading-relaxed">{info.testing}</p>
        </section>
      )}
    </div>

    <!-- How-it-works infographic (per-product, only when provided) -->
    {product.infographic && (
      <figure class="mt-12 border border-gray-200 bg-white p-3 sm:p-5">
        <img
          src={product.infographic}
          alt={`${product.name} — how it works`}
          class="w-full h-auto"
          loading="lazy"
        />
      </figure>
    )}

    <div class="mt-12 border-t-2 border-brand-blue pt-6 flex flex-col sm:flex-row gap-3 sm:gap-4">
      <a
        href={`/contact/?product=${encodeURIComponent(product.name)}`}
        class="flex-1 text-center py-4 bg-brand-red text-white font-bold uppercase tracking-[0.08em] hover:bg-red-700 transition shadow-lg shadow-red-600/20">Request quotation</a>
      <a
        href="/contact/?product=Request%20Catalog%20PDF"
        class="flex-1 text-center py-4 bg-white text-brand-blue font-bold uppercase tracking-[0.08em] border-2 border-brand-blue hover:bg-blue-50 transition">Request product documentation</a>
    </div>



    <!-- FAQ Section -->
    {faqs.length > 0 && (
      <section class="mt-14 max-w-4xl border border-gray-200 bg-white">
        <h2 class="section-title">Frequently Asked Questions</h2>
        <div class="p-4 sm:p-6 space-y-2.5">
          {faqs.map((faq, index) => (
            <details class="group bg-white border border-gray-200 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer px-6 py-5 font-bold text-gray-900 hover:bg-gray-50 transition list-none">
                <span>{faq.question}</span>
                <svg class="w-5 h-5 text-gray-400 group-open:rotate-45 transition-transform flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
              </summary>
              <div class="px-6 pb-6 text-gray-600 leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Guides (GEO content backlinks) -->
    {relatedGuides.length > 0 && (
      <section class="mt-14">
        <h2 class="section-title border border-gray-200">Related Buying Guides</h2>
        <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-4">
          {relatedGuides.map(guide => (
            <a href={guide.href} class="group bg-white border border-gray-200 hover:border-brand-blue hover:shadow-md transition p-5 flex flex-col">
              <span class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-2">Buying Guide</span>
              <h3 class="text-sm font-bold text-gray-900 group-hover:text-brand-blue transition leading-snug">{guide.title}</h3>
              <p class="text-xs text-gray-500 leading-relaxed mt-2 flex-grow">{guide.description}</p>
              <span class="mt-4 inline-flex items-center text-brand-red font-bold text-xs group-hover:gap-1 transition-all">
                Read Guide
                <svg class="w-3.5 h-3.5 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <section class="mt-14">
        <h2 class="section-title border border-gray-200">Related Products</h2>
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {relatedProducts.map(related => (
            <a href={`/products/${related.slug}/`} class="group bg-white border border-gray-200 hover:border-brand-blue hover:shadow-md transition p-5 flex flex-col">
              <img src={related.image} alt={related.name} class="w-full h-40 object-contain rounded-lg bg-gray-50 p-2 mb-4" loading="lazy" />
              <span class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-2">{related.category}</span>
              <h3 class="text-sm font-bold text-gray-900 group-hover:text-brand-blue transition leading-snug">{related.name}</h3>
              <span class="mt-4 inline-flex items-center text-brand-red font-bold text-xs group-hover:gap-1 transition-all">
                View Details
                <svg class="w-3.5 h-3.5 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <style>
      .spec-sheet { counter-reset: sheet-section; }
      .spec-sheet > section { counter-increment: sheet-section; }
      .sheet-title, .section-title {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        margin: 0;
        padding: 0.625rem 1rem;
        border-bottom: 1px solid #e5e7eb;
        background: #f9fafb;
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #374151;
      }
      .sheet-title::before {
        content: counter(sheet-section) ".";
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        color: #cc2128;
      }
      .section-title::before { content: none; }
      @media print {
        .no-print { display: none !important; }
        main { max-width: none !important; padding-left: 0 !important; padding-right: 0 !important; }
        aside { position: static !important; }
        .spec-sheet > section { break-inside: avoid; }
      }
    </style>
  </main>
</Layout>
