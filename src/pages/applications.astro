---
import Layout from '../layouts/Layout.astro';

const applications = [
  {
    title: 'Fire Protection & Life Safety',
    icon: '🚒',
    description: 'Complete fire protection infrastructure for commercial buildings, industrial plants and municipal networks: certified hydrants, alarm valves, sprinklers, suppression cannons and fire hose systems.',
    points: ['Indoor & outdoor fire hydrant networks', 'Automatic sprinkler and deluge systems', 'Fire water cannons for high-bay spaces', 'Fire hose reels and cabinets'],
    links: [
      { label: 'Fire Hydrants', href: '/products/#category=Hydrants%20%26%20Pump%20Connections' },
      { label: 'Sprinklers & Alarm Valves', href: '/products/#category=Sprinklers%20%26%20Alarm%20Valves' },
      { label: 'Water Cannons', href: '/products/#category=Extinguishing%20Water%20Cannons' }
    ]
  },
  {
    title: 'Municipal Water Supply & Drainage',
    icon: '🏙️',
    description: 'Durable flow control and shut-off solutions for city water mains, sewage networks and pumping stations, built to withstand decades of continuous operation.',
    points: ['Gate and butterfly valves for distribution mains', 'Sliding ball and check valves for sewage', 'Smart IoT hydrants for digital grids', 'Backflow prevention for potable water'],
    links: [
      { label: 'Gate Valves', href: '/products/resilient-seat-flanged-gate-valve-z41x/' },
      { label: 'Check Valves', href: '/products/sliding-ball-check-valve-hq41x/' },
      { label: 'Backflow Preventers', href: '/products/anti-pollution-backflow-preventer-hs41x/' }
    ]
  },
  {
    title: 'Industrial Process Pipelines',
    icon: '🏭',
    description: 'High-pressure valves and strainers for process industries including petrochemical, power generation, metallurgy and food processing.',
    points: ['Bellows seal valves for high-temperature media', 'Y-strainers for protection of critical equipment', 'Pressure reducing valves for stable operation', 'Electromagnetic flow meters for metering'],
    links: [
      { label: 'Bellows Seal Valves', href: '/products/flange-manual-bellows-gate-valve/' },
      { label: 'Y-Strainers', href: '/products/telescopic-y-strainer-sgl41h/' },
      { label: 'Flow Meters', href: '/products/smart-electromagnetic-flow-meter/' }
    ]
  },
  {
    title: 'HVAC & Building Services',
    icon: '🏢',
    description: 'Compact, low-maintenance valves for heating, ventilation and air-conditioning systems in commercial and residential buildings.',
    points: ['Wafer butterfly valves for space-saving installation', 'Resilient seat gate valves for general duty', 'Water level control valves for roof tanks', 'Telescopic gate valves for expansion compensation'],
    links: [
      { label: 'Butterfly Valves', href: '/products/wafer-type-butterfly-valve-d71x/' },
      { label: 'Level Control Valves', href: '/products/hydraulic-water-level-control-valve-f745x/' }
    ]
  },
  {
    title: 'Oil, Gas & Petrochemical',
    icon: '🛢️',
    description: 'Heavy-duty fire protection and flow control for refineries, tank farms and chemical plants, with explosion-proof options where required.',
    points: ['Manual and auto-tracking fire water cannons', 'Foam fire cabinets for Class B fires', 'Explosion-proof equipment options', 'Corrosion-resistant materials for aggressive media'],
    links: [
      { label: 'Fire Water Cannons', href: '/products/manual-fire-water-cannon-ps/' },
      { label: 'Foam Cabinets', href: '/products/foam-fire-hydrant-cabinet-psg30/' },
      { label: 'Auto-Tracking Cannons', href: '/products/auto-tracking-jet-suppression-cannon-zdms/' }
    ]
  },
  {
    title: 'Logistics, Warehousing & Data Centers',
    icon: '📦',
    description: 'Life-safety systems for large enclosed spaces where fire suppression must be fast, reliable and water-damage-conscious.',
    points: ['Pre-action systems to protect sensitive assets', 'High-ceiling auto-tracking cannons', 'Wet alarm systems for standard warehouses', 'Flow indicators for zone monitoring'],
    links: [
      { label: 'Pre-Action Systems', href: '/products/pre-action-alarm-system-zsfy/' },
      { label: 'Alarm Valves', href: '/products/wet-alarm-check-valve-zsfz-150/' },
      { label: 'Flow Indicators', href: '/products/water-flow-indicator-zsjz/' }
    ]
  },
  {
    title: 'Marine & Offshore',
    icon: '🚢',
    description: 'Corrosion-resistant fluid control and firefighting equipment for ships, ports and offshore platforms operating in severe marine environments.',
    points: ['Marine-grade aluminum and bronze components', 'Vortex preventers for pump suction safety', 'Fire hydrant and hose systems for decks', 'Non-toxic coatings for water systems'],
    links: [
      { label: 'Vortex Preventers', href: '/products/suction-vortex-preventer-en12845/' },
      { label: 'Hose Couplings', href: '/products/fire-hydrant-hose-coupling-adapter-hs/' }
    ]
  }
];
---

<Layout
  title="Applications & Industries | Wanlian Fluid Equipment"
  description="See how Wanlian Fluid valves and fire protection equipment serve fire protection, municipal water, industrial pipelines, HVAC, petrochemical, warehousing and marine applications."
  breadcrumbs={[{ name: 'Applications' }]}
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Applications</span>
      <h1 class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight">Engineered for <span class="text-brand-red">Demanding Environments</span></h1>
      <p class="mt-4 text-lg text-gray-500 max-w-3xl mx-auto leading-relaxed">
        Wanlian fluid-control and fire protection products are deployed across industries where reliability and safety are non-negotiable.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {applications.map(app => (
        <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition-all">
          <div class="flex items-center gap-4 mb-4">
            <span class="text-4xl">{app.icon}</span>
            <h2 class="text-xl font-black text-gray-900">{app.title}</h2>
          </div>
          <p class="text-gray-600 leading-relaxed mb-5">{app.description}</p>
          <ul class="space-y-2 mb-6">
            {app.points.map(point => (
              <li class="flex items-start text-sm text-gray-700">
                <svg class="h-5 w-5 text-brand-blue mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {point}
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-3 border-t border-gray-100 pt-4">
            {app.links.map(link => (
              <a href={link.href} class="text-sm font-bold text-brand-red hover:underline">
                {link.label} →
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4">
      <h2 class="text-2xl font-black">Not Sure Which Product Fits Your Project?</h2>
      <p class="text-gray-400 max-w-xl mx-auto">
        Send us your application details and our engineers will recommend the right solution within 12 hours.
      </p>
      <a href="/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-xl hover:opacity-90 transition">
        Get Engineering Advice
      </a>
    </div>
  </main>
</Layout>
