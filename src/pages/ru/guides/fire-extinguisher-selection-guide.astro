---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'Какие классы пожаров покрывает порошковый огнетушитель ABC?',
		answer: 'Порошковый огнетушитель ABC покрывает пожары класса A (дерево, бумага, ткани), класса B (горючие жидкости), класса C (горючие газы) и класса E (электротехническое оборудование) — поэтому он является стандартным переносным огнетушителем для коммерческих и промышленных зданий. Он не подходит для пожаров класса F — горящих кухонных масел (нужно влажное химикат) — и класса D — горящих металлов (нужен специальный металлический порошок).'
	},
	{
		question: 'Что означает сертификация ISO 7165 на огнетушителе?',
		answer: 'ISO 7165 — международный стандарт переносных огнетушителей, охватывающий характеристики, конструкцию, маркировку и испытания. Наша порошковая модель ABC 5 кг изготовлена по ISO 7165 и дополнительно имеет CCCF. Обратите внимание: CCCF — обязательная сертификация пожарных изделий в Китае; она подтверждает допуск огнетушителя к китайскому рынку, но сама по себе не является экспортным сертификатом. Для экспорта запросите сертификат на конкретную модель и рынок назначения.'
	},
	{
		question: 'В каких размерах доступны порошковые огнетушители ABC?',
		answer: 'Порошковый огнетушитель ABC Wanlian доступен с зарядом 3, 4 и 5 кг, временем разряда примерно 8–15 секунд и манометром с цветовой шкалой на корпусе из углеродистой стали. Огнетушитель 5 кг — распространённая спецификация для офисов, складов и коммерческих объектов; при запросе коммерческого предложения уточните класс опасности и площадь покрытия.'
	},
	{
		question: 'Можно ли заказать огнетушители с собственным брендом и этикеткой (OEM)?',
		answer: 'Да. Мы поддерживаем изготовление по требованиям заказчика (OEM) по цвету корпуса, этикетке, логотипу и языку; язык этикетки можно подогнать под ваш рынок назначения. MOQ, согласование макета и срок производства подтверждаются в коммерческом предложении — направьте целевой объём и рынок, чтобы мы рассчитали корректную конфигурацию.'
	},
	{
		question: 'Нужна ли особая упаковка огнетушителей с порошковым зарядом для экспортной перевозки?',
		answer: 'Поскольку корпус находится под давлением, подтвердите у вашего фрейтагента классификацию опасных грузов (номер UN) и требования к транспортной упаковке для конкретной модели. Для отгрузок из Китая, классифицированных как опасные грузы, экспортёр обязан предоставить сертификат на упаковку при перевозке опасных грузов; практика таможенных проверок показывает, что отгрузки без этого документа задерживаются и штрафуются. Мы согласуем с вами требования к упаковке и документации до начала производства.'
	},
	{
		question: 'Когда выбирать CO2 вместо порошкового ABC?',
		answer: 'CO2 — там, где остатки порошка дорого обходятся при уборке: диспетчерские, серверные, лаборатории, помещения с электрощитами. Порошковый ABC — лучшая универсальная ценность для общих коммерческих, складских и промышленных зон со смешанными опасностями классов A/B. Если в проекте есть и те, и другие зоны, типовой пакет сочетает порошковые огнетушители для открытых зон и CO2-огнетушители для помещений с чувствительным оборудованием.'
	}
];

const toc = [
	{ id: 'why-fire-extinguishers', label: '1. Почему огнетушители — лидирующая позиция в закупках' },
	{ id: 'fire-classes-agents', label: '2. Классы пожаров и огнетушащие вещества' },
	{ id: 'abc-specifications', label: '3. Спецификация порошковых огнетушителей ABC' },
	{ id: 'certification-compliance', label: '4. Сертификация и соответствие для экспорта' },
	{ id: 'applications-scenarios', label: '5. Где устанавливают огнетушители' },
	{ id: 'factory-buying-checklist', label: '6. Чек-лист закупки на заводе: OEM, MOQ и упаковка' },
	{ id: 'faq', label: 'Часто задаваемые вопросы' }
];

const products = [
	{ slug: 'abc-dry-powder-fire-extinguisher-5kg', name: 'Порошковый огнетушитель ABC (5 кг)', img: '/assets/products/abc-dry-powder-fire-extinguisher-5kg.webp', desc: 'Переносной огнетушитель ISO 7165, пожары классов A/B/C/E' },
	{ slug: 'stainless-steel-fire-extinguisher-box', name: 'Пожарный шкаф из нержавеющей стали', img: '/assets/products/stainless-steel-fire-extinguisher-box.jpg', desc: 'Шкаф SS304/201 для хранения огнетушителя или рукавного барабана' },
	{ slug: 'metal-fire-extinguisher-box-red', name: 'Металлический пожарный шкаф (красный)', img: '/assets/products/metal-fire-extinguisher-box-red.jpg', desc: 'Шкаф с порошковым покрытием и панелью инструкций, OEM-габариты' }
];
---

<Layout
	title="Руководство по огнетушителям: порошковые ABC для B2B и экспорта"
	description="Как выбрать переносной огнетушитель: порошковый ABC, классы пожаров, сертификация ISO 7165 и CCCF, размеры, OEM-поставка и упаковка для экспорта."
	type="article"
	locale="ru"
	faq={faq}
	breadcrumbs={[{ name: 'Руководства', href: '/ru/blog/' }, { name: 'Выбор огнетушителя' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/blog/" class="hover:text-blue-600">Руководства</a>
			<span>/</span>
			<span class="text-gray-600">Выбор огнетушителя</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Руководство по оборудованию пожаротушения</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Руководство по подбору огнетушителей: порошковые ABC для B2B и экспортных проектов</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Переносные огнетушители — самая массовая точка входа в закупки противопожарного оборудования, но порошковые ABC, CO2, пенные и водные огнетушители не взаимозаменяемы. Это руководство помогает импортёрам, дистрибьюторам и проектным покупателям соотнести классы пожаров с огнетушащими веществами, проверить действительно важные параметры и правильно оформить сертификацию и документацию на опасные грузы до отгрузки заказа.</p>

			<TableOfContents headings={toc} />

			<!-- Product strip -->
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 id="why-fire-extinguishers" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Почему огнетушители — лидирующая позиция в закупках</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Данные поиска на отраслевой платформе за август 2026 г. показывают, что <strong>огнетушитель</strong> — самая востребованная категория в выборке по пожаротушению: примерно 19 800 запросов, около трети всех поисков по ключевым категориям; ещё несколько тысяч добавляют родственные переносные форматы — аэрозольные и шарообразные огнетушители. Относительный индекс поискового интереса Google по запросу «огнетушитель» составил 80/100 в августе 2026 г. после пика 100 ранее в году, при этом максимальный относительный интерес — в Катаре, ОАЭ, на Филиппинах, в США и Великобритании.</p>
			<p class="text-gray-700 leading-relaxed">Что это значит для поставщика: спрос приходит сразу из трёх моделей закупок — дистрибьюторы пополняют стандартные SKU, подрядчики оснащают здания по спецификации, технические директора заменяют просроченные огнетушители. Общее позиционирование «пожарное оборудование» смешивает розничных и инженерных покупателей в один неопределённый запрос. Чёткое указание огнетушащего вещества, заряда, покрытия классов пожаров и сертификации на входе позволяет каждому покупателю самостоятельно выбрать нужную продуктовую линейку.</p>

			<h2 id="fire-classes-agents" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Классы пожаров и огнетушащие вещества</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Каждый переносной огнетушитель сертифицируется по классам пожаров, и вещество должно соответствовать опасности. Порошок ABC — универсальный стандарт; другие вещества выигрывают там, где на картину влияют остатки, риск повторного возгорания или особые горючие материалы.</p>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Класс пожара</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Типичные горючие материалы</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Наиболее эффективные вещества</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Подходит ли порошок ABC</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Класс A</td>
							<td class="px-4 py-3 text-gray-700">Дерево, бумага, ткани, пластики</td>
							<td class="px-4 py-3 text-gray-700">Вода, пена, порошок ABC</td>
							<td class="px-4 py-3 text-gray-700">Стандартный выбор</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Класс B</td>
							<td class="px-4 py-3 text-gray-700">Бензин, масла, растворители, ЛКМ</td>
							<td class="px-4 py-3 text-gray-700">Порошок ABC, пена, CO2</td>
							<td class="px-4 py-3 text-gray-700">Стандартный выбор</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Класс C</td>
							<td class="px-4 py-3 text-gray-700">Пропан, бутан, метан, СПГ</td>
							<td class="px-4 py-3 text-gray-700">Порошок ABC (сначала перекройте подачу)</td>
							<td class="px-4 py-3 text-gray-700">Подходящий</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Класс E</td>
							<td class="px-4 py-3 text-gray-700">Электротехническое оборудование под напряжением</td>
							<td class="px-4 py-3 text-gray-700">CO2, порошок ABC (непроводящий)</td>
							<td class="px-4 py-3 text-gray-700">Подходящий — учитывайте остатки порошка</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Класс F</td>
							<td class="px-4 py-3 text-gray-700">Масла и жиры для приготовления пищи</td>
							<td class="px-4 py-3 text-gray-700">Влажное химикат</td>
							<td class="px-4 py-3 text-gray-700">Не рекомендуется</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Класс D</td>
							<td class="px-4 py-3 text-gray-700">Горючие металлы (Mg, Na)</td>
							<td class="px-4 py-3 text-gray-700">Специальный металлический порошок</td>
							<td class="px-4 py-3 text-gray-700">Не подходит</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Для смешанных объектов, которые обслуживает большинство B2B-покупателей — офисы, склады, цеха, розница — одна линейка порошковых огнетушителей ABC покрывает обычно 80% переносных огнетушителей в спецификации; CO2 резервируется для электрощитовых, пена или влажное химикат — для особых опасностей.</p>

			<h2 id="abc-specifications" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Спецификация порошковых огнетушителей ABC</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Когда приходит коммерческое предложение, проверьте эти пять параметров, прежде чем сравнивать цены разных поставщиков:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Вещество и заряд.</strong> Порошок ABC на основе фосфата аммония — универсальный стандарт; нетто-масса заряда (3 / 4 / 5 кг в нашей линейке) определяет и зону покрытия, и стоимость фрахта.</li>
				<li><strong>Массовая доля активного вещества.</strong> Наш порошок ABC указан с 90% активной составляющей, что влияет на огнетушащую способность на килограмм.</li>
				<li><strong>Характеристики разряда.</strong> Для 5-кг огнетушителя ожидайте примерно 8–15 секунд эффективного разряда; в листе спецификаций это должно быть указано явно, а не подразумеваться.</li>
				<li><strong>Система постоянного давления и манометр.</strong> Сжатый газ и порошок находятся под давлением в одном цилиндре; манометр с цветовой шкалой показывает, что огнетушитель исправен, поэтому его конструкция важна для инспекций при обслуживании.</li>
				<li><strong>Качество корпуса и вентильного узла.</strong> Корпус из углеродистой стали с коррозионно-стойким красным покрытием, латунный вентильный узел, шланг разряда с насадком.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed mb-4">Наш <a href="/ru/products/abc-dry-powder-fire-extinguisher-5kg/" class="text-brand-blue font-semibold hover:underline">порошковый огнетушитель ABC 5 кг</a> изготовлен по ISO 7165 с маркировкой CCCF, покрывает пожары классов A/B/C/E и доступен с зарядом 3 / 4 / 5 кг и годовой гарантией. Шланг разряда, манометр и латунный вентиль входят в стандартную комплектацию.</p>
			<p class="text-gray-700 leading-relaxed">Честная оговорка, которую стоит передать вашим клиентам: порошок оставляет осадок, который дёшево удаляется с пола и оборудования, но повреждает электронику — именно поэтому строка класса E в таблице выше дана с оговоркой.</p>

			<h2 id="certification-compliance" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Сертификация и соответствие для экспорта</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Сертификация — то, чем закупка переносных огнетушителей отличается от закупки серийных стандартных товаров, потому что маркировка должна соответствовать конкретной модели, а не бренду или серии.</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>ISO 7165</strong> — международный стандарт переносных огнетушителей, охватывающий конструкцию, характеристики и испытания. Это ориентир для большинства экспортных рынков; указан на нашей модели 5 кг.</li>
				<li><strong>CCCF</strong> — обязательная сертификация пожарных изделий в Китае (China Compulsory Certification). Она подтверждает допуск огнетушителя к рынку Китая и <strong>не является</strong> экспортным сертификатом; это различие важно, когда покупатель планирует перепродажу вне Китая.</li>
				<li><strong>Сертификация рынка назначения.</strong> Для ЕС проверьте маркировку CE по применимому стандарту для конкретной модели; для отдельных рынков Северной Америки требуются огнетушители со списком UL или ULC. Всегда запрашивайте у производителя сертификат, покрывающий конкретную модель и вентильный узел, которые вы планируете импортировать, и отклоняйте общие формулировки «по всей серии».</li>
				<li><strong>Маркировка и язык.</strong> Пиктограммы эксплуатации, метки классов и язык инструкции следует согласовать для страны назначения до массового производства, поскольку перенанесение маркировки после прибытия обходится дорого.</li>
				<li><strong>Протоколы испытаний по партиям.</strong> Запрашивайте протокол испытаний для реальной производственной партии, а не шаблон по другой модели. Наша страница <a href="/ru/certificates/" class="text-brand-blue font-semibold hover:underline">сертификатов и соответствия</a> показывает, как оформляется сертификационная документация на нашу линейку противопожарного оборудования.</li>
			</ul>

			<h2 id="applications-scenarios" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Где устанавливают огнетушители: коммерческие, складские и транспортные объекты</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Один и тот же 5-кг огнетушитель ABC обслуживает совсем разных конечных пользователей, и спецификация меняется в зависимости от объекта:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Коммерческие здания и офисы.</strong> Настенные огнетушители ABC 4–5 кг у выходов и в общих зонах, CO2 в электрощитовых. Настенные шкафы защищают огнетушитель и упрощают инспекцию.</li>
				<li><strong>Склады и промышленные цеха.</strong> Порошок ABC для смешанных опасностей классов A/B; на больших открытых площадях огнетушители обычно комбинируются с рукавными барабанами, а при очень высоких потолках — со стационарными системами пожаротушения. Стационарную часть той же комплектации смотрите в нашем <a href="/ru/guides/fire-hose-reel-cabinet-guide/" class="text-brand-blue font-semibold hover:underline">руководстве по пожарным рукавным барабанам и шкафам</a>.</li>
				<li><strong>Транспорт и мобильные установки.</strong> Компактные огнетушители для грузовиков, погрузчиков и машинных помещений; наша модификация 3 кг подходит для этих пространств и может поставляться с крепёжными элементами.</li>
				<li><strong>Наружные и коррозионные среды.</strong> <a href="/ru/products/stainless-steel-fire-extinguisher-box/" class="text-brand-blue font-semibold hover:underline">Пожарный шкаф из нержавеющей стали</a> (SS304/201 со смотровым окном) защищает огнетушители на аэродромах, прибрежных объектах и химических предприятиях, а <a href="/ru/products/metal-fire-extinguisher-box-red/" class="text-brand-blue font-semibold hover:underline">красный металлический пожарный шкаф</a> с напечатанной инструкцией — экономичный стандарт для помещений.</li>
			</ul>

			<h2 id="factory-buying-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Чек-лист закупки на заводе: OEM, MOQ и упаковка опасных грузов</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Закупка огнетушителей на китайском заводе — это работа с документацией не меньше, чем с продуктом. Пройдите этот чек-лист до фиксации заказа:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Охват OEM.</strong> Цвет корпуса, этикетка, логотип и язык этикетки изготавливаются по требованиям заказчика; согласуйте макет и сроки одобрения в графике заказа.</li>
				<li><strong>MOQ и срок производства.</strong> Оба параметра зависят от модели, объёма и конфигурации этикетки, поэтому подтверждаются в коммерческом предложении; укажите целевой рынок и годовой объём, чтобы получить реалистичные цифры.</li>
				<li><strong>Классификация опасных грузов.</strong> Цилиндр под давлением может классифицироваться как опасный груз для транспортировки. Перед бронированием места подтвердите у вашего фрейтагента классификацию по UN и требования к упаковке для конкретной модели.</li>
				<li><strong>Экспортная документация Китая.</strong> Когда груз классифицируется как опасный, китайский экспортёр обязан предоставить сертификат на упаковку при перевозке опасных грузов; практика таможенных проверок показывает, что отгрузки без этого документа задерживаются и штрафуются. Запросите у поставщика подтверждение, что документ оформлен.</li>
				<li><strong>Соберите пакет.</strong> Заказ огнетушителей вместе со шкафами, рукавными барабанами и клапанами у одного производителя упрощает сертификационные досье и фрахт. Наш <a href="/ru/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">чек-лист B2B-закупки арматуры</a> покрывает сторону проверки завода в той же проверке поставщика.</li>
			</ul>

