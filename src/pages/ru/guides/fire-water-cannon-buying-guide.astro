---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'do-you-need-a-water-cannon', label: '1. Нужен ли вам лафетный ствол?' },
	{ id: 'fixed-remote-or-auto-tracking', label: '2. Стационарный, дистанционный или автоматический следящий?' },
	{ id: 'sizing-flow-and-range', label: '3. Подбор расхода и дальности струи' },
	{ id: 'control-and-integration', label: '4. Управление и интеграция' },
	{ id: 'procurement-checklist', label: '5. Чек-лист закупки' },
	{ id: 'faq', label: 'Частые вопросы' }
];

const faq = [
	{
		question: 'Когда нужен пожарный лафетный ствол, а не обычные спринклеры?',
		answer: 'Лафетные стволы подходят для крупных открытых и высотных пространств, где орошение спринклерами непрактично: участки технологических процессов нефтехимии, парки резервуаров для нефти и СПГ, наливные терминалы, самолётные ангары и крупные склады. Они подают концентрированную струю большого расхода на дистанцию 50–110 м — с ручным, дистанционным или автоматическим управлением.'
	},
	{
		question: 'Какой расход и дальность мне нужны?',
		answer: 'Расход определяется характером угрозы: 5–30 л/с — для защиты складов и атриумов, 30–200 л/с — для парков резервуаров и технологических установок. Дальность зависит от давления на входе — обычно 50–110 м при номинальном расходе. Пришлите компоновку вашего объекта, и наши инженеры подберут модель.'
	},
	{
		question: 'Дистанционно управляемый или автоматический следящий ствол — что выбрать?',
		answer: 'Если оператор может находиться на месте, модели с дистанционным управлением обеспечивают гибкое ручное вмешательство с безопасной дистанции. Для необслуживаемых зон и объектов с круглосуточным риском автоматические следящие стволы с ИК/УФ-детекцией обнаруживают пламя, целятся и подают струю за 30 секунд без участия человека.'
	},
	{
		question: 'Можно ли применять лафетные стволы с пеной?',
		answer: 'Да. Наша серия PS поддерживает и воду, и пену, а дозирование пены интегрируется для угроз класса B (жидкое топливо). Пенный шкаф PSG30 — готовое упаковочное решение для небольших топливных и химических угроз.'
	},
	{
		question: 'Поставляете ли вы ствол с полной системой — клапаны, соединения, насосы?',
		answer: 'Да. Мы производим ствол на собственных производственных линиях и отправляем его вместе с подобранными клапанами, соединительными головками, гидрантами и аксессуарами для полного контура пожаротушения — ваш заказ приходит как пакет с одного завода.'
	}
];

const cannonProducts = [
	{
		slug: 'auto-tracking-jet-suppression-cannon-zdms',
		name: 'Автоматический следящий лафетный ствол (ZDMS)',
		img: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		desc: 'Детекция ИК/УФ, 5–150 л/с'
	},
	{
		slug: 'manual-fire-water-cannon-ps',
		name: 'Ручной пожарный лафетный ствол (PS)',
		img: '/assets/products/manual-fire-water-cannon-ps.webp',
		desc: '20–200 л/с, до 110 м'
	},
	{
		slug: 'foam-fire-hydrant-cabinet-psg30',
		name: 'Пенный пожарный шкаф (PSG30)',
		img: '/assets/06_extinguishing_cannons/cannon_p42.webp',
		desc: 'AFFF 3% для пожаров нефтепродуктов и химии'
	}
];
---

<Layout
	title="Пожарный лафетный ствол: гид по выбору 2026"
	description="Как выбрать пожарный лафетный ствол: стационарный, дистанционный или автоматический следящий. Расход, дальность струи, управление, пена, чек-лист закупки."
	type="article"
	locale="ru"
	faq={faq}
	breadcrumbs={[{ name: 'Блог', href: '/ru/blog/' }, { name: 'Гид по выбору лафетного ствола' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Хлебные крошки -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/blog/" class="hover:text-blue-600">Блог</a>
			<span>/</span>
			<span class="text-gray-600">Гид по выбору лафетного ствола</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Руководство по промышленному пожаротушению</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Гид по выбору пожарного лафетного ствола: стационарный, дистанционный или интеллектуальный? (2026)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Пожарный лафетный ствол — это монитор большого расхода, который бьёт концентрированной струёй на 50–110 м. Это основной инструмент пожаротушения для нефтехимических заводов, парков резервуаров, терминалов и крупных складов, куда спринклеры не дотянутся. Решение о закупке сводится к четырём вопросам: стационарный или управляемый, какой расход, какая дальность и нужно ли автономное решение. Разбираем каждый.</p>

			<!-- Лента продукции -->
			<div class="mt-8 grid grid-cols-2 lg:grid-cols-3 gap-4">
				{cannonProducts.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			
			<TableOfContents headings={toc} />

			<h2 id="do-you-need-a-water-cannon" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Нужен ли вам лафетный ствол?</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Лафетные стволы окупаются в трёх ситуациях: <strong>крупные открытые площади</strong> (склады, атриумы, ангары), где стационарным спринклерам потребовалась бы непрактичная плотность орошения; <strong>угрозы на открытом воздухе</strong> (парки резервуаров, наливные эстакады, технологические установки), где нет потолка для установки спринклеров; и <strong>высокоценные риски</strong>, где быстрое концентрированное тушение эффективнее повсеместного затопления. Если ваш объект — закрытое здание со стандартным назначением, скорее всего, правильнее система спринклеров — см. нашу <a href="/ru/fire-sprinkler-systems/" class="text-brand-blue font-semibold hover:underline">страницу о системах спринклеров</a>.</p>

			<h2 id="fixed-remote-or-auto-tracking" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Стационарный, дистанционный или автоматический следящий?</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Тип</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Способ работы</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Лучше всего подходит</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Стационарный монитор</td>
							<td class="px-4 py-3 text-gray-700">Наведение рычагом вручную; самофиксирующая передача удерживает положение</td>
							<td class="px-4 py-3 text-gray-700">Объекты с операторами на смене; экономичная базовая опция</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">С дистанционным управлением</td>
							<td class="px-4 py-3 text-gray-700">Кабельное/беспроводное управление с безопасной дистанции, вращение 360°</td>
							<td class="px-4 py-3 text-gray-700">Угрозы, слишком близкие для ручного управления</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Автоматический следящий</td>
							<td class="px-4 py-3 text-gray-700">Детекция пламени ИК/УФ, автономное наведение и подача струи за ~30 с</td>
							<td class="px-4 py-3 text-gray-700">Необслуживаемые зоны, риск 24/7, требование быстрой реакции</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed mb-4"><a href="/ru/products/auto-tracking-jet-suppression-cannon-zdms/" class="text-brand-blue font-semibold hover:underline">Автоматический следящий ствол ZDMS</a> комбинирует инфракрасные и ультрафиолетовые датчики, чтобы подтвердить настоящее пламя перед срабатыванием — это снижает ложные срабатывания — и поддерживает ручное переключение с ПК, мобильного приложения или центрального шкафа. <a href="/ru/products/manual-fire-water-cannon-ps/" class="text-brand-blue font-semibold hover:underline">Ручная серия PS</a> остаётся надёжным бюджетным рабочим решением там, где есть операторы.</p>

			<h2 id="sizing-flow-and-range" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Подбор расхода и дальности струи</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Способность ствола определяют две цифры: <strong>расход</strong> (л/с) и <strong>дальность струи</strong> (м). Расход задаётся характером угрозы и расчётом потребности в противопожарной воде; дальность — давлением на входе и конструкцией сопла.</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Склады и атриумы</strong>: стволы 5–30 л/с, радиус обзора 40–65 м — оптимальная ниша ZDMS.</li>
				<li><strong>Парки резервуаров и технологические установки</strong>: 30–200 л/с с дальностью струи до 110 м — диапазон серии PS.</li>
				<li><strong>Пенные угрозы</strong>: укажите дозирование пены или готовый узел, например <a href="/ru/products/foam-fire-hydrant-cabinet-psg30/" class="text-brand-blue font-semibold hover:underline">пенный шкаф PSG30</a>, для рисков класса B.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Правило: если вы не уверены в расходе, отправьте компоновку объекта и потребность в противопожарной воде поставщику — правильная модель выводится из характера угрозы, а не из страницы каталога.</p>

			<h2 id="control-and-integration" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Управление и интеграция</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Автоматические следящие стволы столь же полезны, сколь хороша их интеграция: их нужно подключить к панели пожарной сигнализации, а путь ручного управления (местный шкаф или удалённая станция) протестировать с вашими операторами. Проверьте интерфейс связи, взрывозащищённость, если ствол устанавливается в классифицированную зону (доступно исполнение Exde II BT4 Gb), и степень защиты IP для уличного размещения.</p>

			<h2 id="procurement-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Чек-лист закупки</h2>
			<ol class="list-decimal pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Определите характер угрозы и потребность в противопожарной воде; согласуйте с поставщиком расход и дальность ствола.</li>
				<li>Выберите режим управления: стационарный, дистанционный или автоматический следящий — в зависимости от персонала и времени реакции.</li>
				<li>Подтвердите совместимость с огнетушащими средами (только вода или дозирование пены).</li>
				<li>Проверьте взрывозащищённость и степень защиты IP для условий монтажа.</li>
				<li>Закажите полный контур: ствол, клапаны, соединительные головки, гидранты — один BOM, один завод.</li>
				<li>Уточните MOQ, срок поставки, поддержку монтажа и запасные части в коммерческом предложении.</li>
			</ol>

			<!-- Перекрёстная ссылка на страницу раздела -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Смотрите нашу линейку пожарных лафетных стволов</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Сравните стационарные, дистанционные и интеллектуальные модели с полными характеристиками на <a href="/ru/fire-water-cannon/" class="text-brand-blue font-semibold hover:underline">странице пожарных лафетных стволов</a>.</p>
			</div>

			<!-- Связанное руководство -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Связанное руководство: ручной против автоматического следящего</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Нужно техническое сравнение ручных (PS) и автоматических следящих (ZDMS) мониторов? Смотрите <a href="/ru/guides/fire-water-monitor-selection-guide/" class="text-brand-blue font-semibold hover:underline">гид по выбору пожарных мониторов</a>.</p>
			</div>

			<!-- Частые вопросы -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Частые вопросы</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- Призыв к действию -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Нужен лафетный ствол для вашего объекта?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Пришлите нам компоновку объекта, требуемую дальность и расход — наши инженеры подберут правильную модель, и мы ответим полным коммерческим предложением в течение 12 часов.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ru/contact/?product=Fire%20Water%20Cannon" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Запросить цену</a>
						<a href="https://wa.me/8618684324501?text=%D0%9F%D1%80%D0%B8%D0%B2%D0%B5%D1%82%2C%20%D0%BD%D1%83%D0%B6%D0%B5%D0%BD%20%D0%BF%D0%BE%D0%B6%D0%B0%D1%80%D0%BD%D1%8B%D0%B9%20%D0%BB%D0%B0%D1%84%D0%B5%D1%82%D0%BD%D1%8B%D0%B9%20%D1%81%D1%82%D0%B2%D0%BE%D0%BB" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Написать в WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
