---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'how-they-work', label: '1. Как они работают: краткое сравнение' },
	{ id: 'head-to-head-gate-vs-butterfly', label: '2. Сравнение: задвижка против дискового затвора' },
	{ id: 'where-each-valve-belongs', label: '3. Где какой клапан уместен в системах пожаротушения' },
	{ id: 'signal-valves-dn80', label: '4. Сигнальные клапаны: специалисты Ду80' },
	{ id: 'purchasing-considerations', label: '5. На что обратить внимание при закупке (B2B)' },
	{ id: 'recommendation-summary', label: '6. Сводка рекомендаций' },
	{ id: 'faq', label: 'Часто задаваемые вопросы' }
];

const faq = [
	{
		question: 'Какой клапан поставить на пожарную магистраль — задвижку или дисковый затвор?',
		answer: 'Для пожарных магистралей, где требуется полный свободный поток при минимальной потере давления, традиционный выбор для отсечной функции — задвижка с эластичным седлом (например, Z41X). Дисковые затворы (например, D71X) предпочтительны там, где место ограничено, нужен четвертьоборотный привод или важен вес, — например в коллекторных группах и на ветвевых линиях спринклерных систем. Многие проекты используют и то и другое: задвижки для отсечки на магистрали, дисковые затворы для управления ветвями.'
	},
	{
		question: 'Что дешевле — задвижка или дисковый затвор?',
		answer: 'При одинаковом номинальном диаметре и классе давления межфланцевые дисковые затворы как правило на 20–40% дешевле фланцевых задвижек: они легче, требуют меньше материала и имеют более простой корпус. Однако итоговая стоимость установки зависит ещё и от фланцев, приводов и занимаемого места. Для больших диаметров (DN200 и выше) ценовое преимущество дисковых затворов становится ещё значительнее.'
	},
	{
		question: 'Каково назначение сигнального дискового затвора в спринклерной системе?',
		answer: 'Сигнальный клапан (например, межфланцевый дисковый затвор с канавочным присоединением DN80) оснащается выключателем положения, который при закрытом или частично закрытом клапане подаёт электрический сигнал на панель пожарной сигнализации. Это гарантирует, что спринклерная система не останется отсечённой случайно, — обязательное требование безопасности при установке по NFPA-13.'
	},
	{
		question: 'Чем отличается класс давления у клапанов Z41X и D71X?',
		answer: 'Задвижка Z41X из высокопрочного чугуна с эластичным седлом и межфланцевый дисковый затвор D71X как правило поставляются с классом PN16 (1,6 МПа), доступны варианты PN10. Для противопожарного применения PN16 покрывает типовые муниципальные и промышленные системы. Всегда проверяйте максимальное статическое давление вашей сети и указывайте PN25, если это необходимо.'
	}
];

const valveProducts = [
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Фланцевая задвижка с эластичным седлом из высокопрочного чугуна (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'Отсечной клапан полного прохода с «пузырьковой» герметичностью для пожарных магистралей'
	},
	{
		slug: 'wafer-type-butterfly-valve-d71x',
		name: 'Межфланцевый дисковый затвор из высокопрочного чугуна с резиновым покрытием (D71X)',
		img: '/assets/products/wafer-type-butterfly-valve-d71x.webp',
		desc: 'Компактный четвертьоборотный затвор для стеснённых условий и ветвевых линий'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Сигнальный дисковый затвор с канавочным присоединением (DN80-PN16)',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp',
		desc: 'Сигнальный клапан с канавочным присоединением и выключателем положения для спринклерных систем'
	}
];
---

<Layout
	title="Задвижка против дискового затвора в системах пожаротушения"
	description="Задвижка против дискового затвора для пожаротушения: расход, потеря давления, стоимость. Z41X, D71X, сигнальный DN80 — руководство по выбору для B2B-закупщиков."
	type="article"
	locale="ru"
	faq={faq}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Хлебные крошки -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/blog/" class="hover:text-blue-600">Руководства</a>
			<span>/</span>
			<span class="text-gray-600">Сравнение арматуры</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Руководство по промышленной арматуре</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Задвижка против дискового затвора: какой клапан выбрать для систем пожаротушения?</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Один из самых частых вопросов в закупках для пожаротушения: задвижка или дисковый затвор? Честный ответ — они не взаимозаменяемы, а дополняют друг друга. У каждого есть зона, где он является однозначным выбором, и в правильно спроектированных системах пожаротушения используются оба. В этом руководстве — подход к выбору по расходу, габаритам, скорости операции и стоимости, со ссылками на реальные конфигурации арматуры, применяемые в пожарных магистралях и спринклерных системах.</p>

			<!-- Полоса продукции -->
			<div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
				{valveProducts.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-32 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="how-they-work" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Как они работают: краткое сравнение</h2>
			<p class="text-gray-700 leading-relaxed mb-4"><strong>Задвижка</strong> использует клин затвора, который перемещается перпендикулярно направлению потока. В полностью открытом положении клин находится полностью вне проточного канала, остаётся проход полного диаметра — поэтому потеря давления на задвижке пренебрежимо мала. <strong>Дисковый затвор</strong> использует диск, вращающийся на центральной оси. Диск остаётся в проточном канале даже в открытом положении, создавая небольшой, но измеримый перепад давления, зато клапан управляется простым поворотом на 90°.</p>
			<p class="text-gray-700 leading-relaxed">Это единственное механическое отличие определяет почти все практические различия между двумя типами.</p>

			<h2 id="head-to-head-gate-vs-butterfly" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Сравнение: задвижка против дискового затвора</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Критерий</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Задвижка (Z41X)</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Дисковый затвор (D71X)</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Характеристики потока</td>
							<td class="px-4 py-3 text-gray-700">Полный проход, практически нулевая потеря давления</td>
							<td class="px-4 py-3 text-gray-700">Диск в потоке, небольшая потеря давления</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Скорость операции</td>
							<td class="px-4 py-3 text-gray-700">Многоборотная (медленнее, особенно в больших Ду)</td>
							<td class="px-4 py-3 text-gray-700">Четвертьоборот (быстро, легко приводится в действие)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Габариты и вес</td>
							<td class="px-4 py-3 text-gray-700">Большое межфланцевое расстояние, тяжёлый в больших Ду</td>
							<td class="px-4 py-3 text-gray-700">Компактный межфланцевый корпус, до 70% легче</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Стоимость (при одном Ду/Ру)</td>
							<td class="px-4 py-3 text-gray-700">Выше стоимость материала и механической обработки</td>
							<td class="px-4 py-3 text-gray-700">Обычно на 20–40% ниже</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Герметичность</td>
							<td class="px-4 py-3 text-gray-700">«Пузырьковая» при эластичном седле</td>
							<td class="px-4 py-3 text-gray-700">С резиновым покрытием, герметичен при номинальном давлении</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Лучшее применение</td>
							<td class="px-4 py-3 text-gray-700">Отсечка на магистрали, полный поток (открыто/закрыто)</td>
							<td class="px-4 py-3 text-gray-700">Управление ветвями, дросселирование, стеснённые условия</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 id="where-each-valve-belongs" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Где какой клапан уместен в системах пожаротушения</h2>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Задвижки для отсечки на магистралях</h3>
			<p class="text-gray-700 leading-relaxed mb-4">В пожарных магистралях и на напорных линиях насосов приоритет — максимальный расход при минимальных потерях на трение. <a href="/ru/products/resilient-seat-flanged-gate-valve-z41x/" class="text-brand-blue font-semibold hover:underline">Задвижка Z41X из высокопрочного чугуна с эластичным седлом</a> — стандартный отсечной клапан здесь: проход полного диаметра, «пузырьковая» герметичность при закрытии и ровный, свободный от препятствий проточный канал в открытом положении. Поскольку такие клапаны эксплуатируются редко (только открыто/закрыто), более медленная многоборотная операция — не практический недостаток.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Дисковые затворы для ветвей и стеснённых условий</h3>
			<p class="text-gray-700 leading-relaxed mb-4">Там, где клапаны плотно собраны в помещениях пожарных стояков, машинных залах или коллекторных группах, пространство критично. <a href="/ru/products/wafer-type-butterfly-valve-d71x/" class="text-brand-blue font-semibold hover:underline">Межфланцевый дисковый затвор D71X</a> устанавливается между двумя фланцами с межфланцевым размером и весом в несколько раз меньшими, чем у задвижки, а четвертьоборотная рукоятка или червячный редуктор упрощают управление и монтаж привода. Это делает его выбором по умолчанию для управления ветвями спринклерных систем и отсечки участков.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Полный разбор арматуры спринклерных систем — мокрый сигнальный, дренчерный и преакшн-клапаны — в нашем <a href="/ru/guides/fire-sprinkler-system-valves-guide/" class="text-brand-blue font-semibold hover:underline">руководстве по арматуре спринклерных систем</a>.</p>

			<h2 id="signal-valves-dn80" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Сигнальные клапаны: специалисты Ду80</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Спринклерные системы по нормам типа NFPA-13 требуют контролируемый отсечной клапан: если кто-то закроет подающий клапан, панель пожарной сигнализации должна узнать об этом немедленно. <a href="/ru/products/signal-grooved-wafer-butterfly-valve-dn80/" class="text-brand-blue font-semibold hover:underline">Сигнальный дисковый затвор DN80 с канавочным присоединением</a> объединяет выключатель положения с канавочным соединением: он крепится к трубопроводу хомутовыми муфтами, сообщает состояние «открыто/закрыто» на панель и при этом сохраняет преимущество дисковой конструкции по месту и стоимости. Именно этот клапан указывается, когда на чертеже написано «контролируемая задвижка OS&amp;Y или дисковый затвор».</p>
			<p class="text-gray-700 leading-relaxed mb-4">По-прежнему выбираете между мокрой, сухой или преакшн-системой? Наше <a href="/ru/guides/fire-sprinkler-system-wet-dry-preaction/" class="text-brand-blue font-semibold hover:underline">сравнение мокрой, сухой и преакшн-спринклерных систем</a> объясняет, какая система подходит под какой профиль риска здания.</p>

			<h2 id="purchasing-considerations" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. На что обратить внимание при закупке (B2B)</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Укажите материал корпуса и покрытие</strong> — высокопрочный чугун QT450 с эпоксидным покрытием устойчив к коррозии в мокрых системах пожаротушения; требуйте спецификацию покрытия в коммерческом предложении.</li>
				<li><strong>Совместите класс давления с вашей сетью</strong> — PN16 стандарт; проверьте статическое давление перед заказом, PN25 для районов с высотными зданиями.</li>
				<li><strong>Тип присоединения имеет значение</strong> — фланцевое для задвижек, межфланцевое или канавочное для дисковых затворов; сверяйтесь с вашей спецификацией трубопроводов (канавочные муфты экономят время монтажа).</li>
				<li><strong>Для сигнальных клапанов укажите спецификацию выключателя</strong> — запросите тип ограничительного выключателя и класс защиты IP для сопряжения с вашей панелью сигнализации.</li>
				<li><strong>Запросите отчёты об испытаниях</strong> — сертификаты гидростатических испытаний и испытаний седла на утечку для конкретной партии, а не общий шаблон.</li>
				<li><strong>Консолидируйте заказ</strong> — заказ задвижек, дисковых затворов и сигнальных клапанов у одного сертифицированного производителя упрощает документацию по сертификации и управление запасными частями. Пройдите наш <a href="/ru/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">чек-лист закупки арматуры для B2B</a> перед тем, как определиться с поставщиком.</li>
			</ul>

			<h2 id="recommendation-summary" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Сводка рекомендаций</h2>
			<div class="bg-gray-50 rounded-xl border border-gray-200 p-6 my-5">
				<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2">
					<li><strong>Пожарные магистрали / напорные линии насосов → задвижка (Z41X)</strong>: полный поток, минимальные потери, надёжная отсечка.</li>
					<li><strong>Ветвевые линии / помещения стояков / коллекторы → дисковый затвор (D71X)</strong>: компактный, лёгкий, быстрая операция.</li>
					<li><strong>Контролируемая отсечка в спринклерных системах → сигнальный клапан (DN80)</strong>: выключатель положения в комплекте, канавочное присоединение для быстрого монтажа.</li>
					<li>Если сомневаетесь, — подтвердите выбор у проектировщика системы: большинству проектов нужны все три типа.</li>
				</ul>
			</div>

			<!-- Раздел FAQ -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Часто задаваемые вопросы</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Формируете пакет арматуры для системы пожаротушения?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Сообщите нам спецификацию трубопроводов и класс давления — мы рассчитаем задвижки, дисковые затворы и сигнальные клапаны в едином сертифицированном пакете в течение 12 часов.</p>
