---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

// FAQ: 6 реальных закупочных вопросов (генерируют FAQPage JSON-LD)
const faq = [
	{
		question: 'Что такое сиамское соединение и зачем нужны два входа?',
		answer: 'Патрубок для пожарных машин (FDC) — это точка, через которую прибывшие пожарные автоцистерны подают воду в противопожарную систему здания — в пожарный стояк или магистраль спринклерной системы. Сиамское соединение имеет два входа, объединённых в один выход, поэтому две машины могут одновременно подавать воду в один стояк, удваивая доступный расход. Модель SQD100-1.6 принимает два входа DN65 (2,5") и подаёт воду в магистраль здания через единый фланцевый выход DN100 (4").'
	},
	{
		question: 'Какой стандарт соединительных головок входов следует указать для FDC?',
		answer: 'Входы должны соответствовать тем головкам, которыми реально работает местное пожарное подразделение, — именно они соединяются под давлением в три часа ночи. SQD100-1.6 поставляется с двумя входами DN65 и заглушками в исполнении SQS65 / KWS65. Если в проекте применяются соединения Storz по немецкому стандарту, наши алюминиевые головки Storz 2,5" покрывают DN50–DN150 с самозакрывающимся уплотнением, а переходники серии HS (DN50/DN65, 1,6 МПа, GB12514) позволяют переходить между типами резьб — укажите нужную головку в запросе.'
	},
	{
		question: 'Включает ли SQD100 управляющий клапан?',
		answer: 'Да. В SQD100-1.6 интегрирован управляющий клапан с маховиком, поэтому расход через соединение регулируется, а не просто перекрывается или открывается. Оба входа укомплектованы заглушками, удерживаемыми плетёными стальными страховочными тросами: при снятии заглушек во время подачи воды они остаются на месте и не теряются.'
	},
	{
		question: 'Какие размеры, давление и материалы у SQD100-1.6?',
		answer: 'Входы: 2 × DN65 (2,5") с заглушками. Выход: DN100 (4"), фланцевый. Номинальное давление: 1,6 МПа. Общая длина: 120 мм. Корпус: высокопрочный/серый чугун с коррозионно-стойким порошковым покрытием красного цвета; шпиндель маховика — латунь или нержавеющая сталь. Компактная длина корпуса подходит для установки в тесных насосных и в точках противопожарного водоснабжения аэропортов и муниципальных объектов.'
	},
	{
		question: 'Как следует проверять патрубок для пожарных машин?',
		answer: 'Проверьте, что обе заглушки на месте, их прокладки целы, страховочные тросы исправны, фланцевый выход без утечек и коррозии, маховик вращается свободно, а соединение видимое, обозначено знаком и никогда не загораживается припаркованным транспортом, озеленением или хранящимися грузами. В регионах с заморозками убедитесь, что соединение после использования корректно опорожняется, чтобы вода не застаивалась в корпусе.'
	},
	{
		question: 'Чем FDC отличается от пожарного гидранта?',
		answer: 'Они работают в противоположных направлениях. Пожарный гидрант — это точка забора воды из коммунальной магистрали: к нему подключаются машины и забирают воду. Патрубок для пожарных машин — это вход на стороне здания: через него машины подают воду в пожарный стояк или спринклерную систему здания. На многих объектах нужны оба устройства — оба рассматриваются в нашем руководстве по выбору пожарного гидранта.'
	}
];

// TOC: id совпадают с заголовками H2 в тексте
const toc = [
	{ id: 'what-is-fdc', label: '1. Что такое патрубок для пожарных машин (FDC)?' },
	{ id: 'how-siamese-works', label: '2. Два входа, один выход' },
	{ id: 'coupling-standards', label: '3. Стандарты головок входов и переходники' },
	{ id: 'where-fdc-installed', label: '4. Где устанавливаются FDC' },
	{ id: 'fdc-comparison', label: '5. Сиамский корпус, головка Storz или переходник?' },
	{ id: 'fdc-spec-checklist', label: '6. Чек-лист спецификации и монтажа' },
	{ id: 'faq', label: 'Часто задаваемые вопросы' }
];

// Связанные продукты (slug соответствуют products.ts)
const products = [
	{ slug: 'sqd100-1-6-fire-pump-adapter', name: 'Переходник пожарного насоса SQD100-1.6 (сиамский)', img: '/assets/products/sqd100-1-6-fire-pump-adapter.webp', desc: '2 × DN65 входы, фланцевый выход DN100, 1,6 МПа' },
	{ slug: 'storz-coupling-2-5inch-aluminum', name: 'Головка Storz 2,5" (немецкий стандарт)', img: '/assets/products/storz-coupling-2-5inch-aluminum.webp', desc: 'DN50–DN150, 1,6 МПа, самозакрывающаяся, алюминий' },
	{ slug: 'fire-hydrant-hose-coupling-adapter-hs', name: 'Переходник соединительных головок HS', img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg', desc: 'DN50/DN65, GB12514, анодированный алюминий' },
	{ slug: 'indoor-fire-hydrant-head-sn65', name: 'Головка внутреннего пожарного крана SN65', img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg', desc: 'Головка внутреннего гидранта DN65 для выходов пожарного стояка' }
];
---

<Layout
	title="Руководство по патрубкам FDC: сиамские входы и соединительные головки"
	description="Руководство по патрубкам FDC: сдвоенные входы DN65, фланцевый выход DN100, варианты головок SQS65/KWS65 и Storz, управляющий клапан, монтаж и чек-лист закупки."
	type="article"
	locale="ru"
	faq={faq}
	breadcrumbs={[{ name: 'Руководства', href: '/ru/blog/' }, { name: 'Руководство по FDC' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/blog/" class="hover:text-blue-600">Руководства</a>
			<span>/</span>
			<span class="text-gray-600">Руководство по FDC</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Руководство по противопожарной защите</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Руководство по патрубкам FDC: сиамские входы и соединительные головки</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Кратко: патрубок для пожарных машин (FDC) — это вход, через который прибывшие пожарные машины подают воду в пожарный стояк здания или спринклерную систему. Сиамская версия имеет два входа, объединённых в один выход, поэтому две машины могут одновременно питать один стояк, и её входы должны совпадать с головками рукавов, которыми работает местная пожарная служба. В этом руководстве — сиамское соединение SQD100-1.6, варианты головок вокруг него и что проверить перед заказом.</p>

			<TableOfContents headings={toc} />

			<!-- Product strip -->
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Section 1 -->
			<h2 id="what-is-fdc" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Что такое патрубок для пожарных машин (FDC)?</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Патрубок для пожарных машин — это интерфейс на стороне здания для пожарных подразделений. Когда собственного водоснабжения здания не хватает — или когда спринклерная система отключена, — прибывшие автоцистерны подключают рукава к FDC и подают воду в стояк или магистраль спринклеров. Таким образом, соединение является точкой ввода под давлением в здание, а не источником воды.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Поскольку соединение используется в аварийных условиях, FDC оценивается тремя практическими вопросами: сможет ли пожарное подразделение быстро подключиться к нему своими головками, удастся ли через него подать достаточно воды и доступен ли он, когда здание заполнено дымом и к нему подходят машины. Всё в этом руководстве вытекает из этих трёх вопросов.</p>
			<p class="text-gray-700 leading-relaxed">Сдвоенное (сиамское) соединение отвечает на вопрос о расходе двумя входами. При необходимости систему может питать одна машина; когда прибывает вторая, используются оба входа и расход в стояк примерно удваивается, ни один насос не работает в невыгодной точке своей характеристики.</p>

			<!-- Section 2 -->
			<h2 id="how-siamese-works" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Два входа, один выход</h2>
			<p class="text-gray-700 leading-relaxed mb-4"><a href="/ru/products/sqd100-1-6-fire-pump-adapter/" class="text-brand-blue font-semibold hover:underline">Переходник пожарного насоса SQD100-1.6</a> — компактный сиамский корпус: с одной стороны два входа DN65 (2,5") с заглушками, с другой — единый фланцевый выход DN100 (4"), который болтами крепится к магистрали здания. Рабочее давление 1,6 МПа, длина корпуса всего 120 мм — это важно в насосных и подвальных камерах с ограниченным пространством.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Для закупки стоит отметить два конструктивных решения. Первое: в корпусе интегрирован управляющий клапан с маховиком, поэтому расход через соединение регулируется, а не просто перекрывается или открывается. Второе: заглушки входов удерживаются плетёными стальными страховочными тросами — небольшая деталь, исключающая самую частую картину на реальном пожаре, когда снятые во время подачи воды заглушки теряются.</p>
			<p class="text-gray-700 leading-relaxed">Конструкция: высокопрочный/серый чугун с коррозионно-стойким порошковым покрытием красного цвета, шпиндель маховика — латунь или нержавеющая сталь. Именно компоновка «два входа — один выход» отличает сиамское соединение от одиночного, которое ограничивает систему одной пожарной машиной.</p>

			<!-- Section 3 -->
			<h2 id="coupling-standards" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Стандарты головок входов и переходники</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Это пункт спецификации, который определяет, пригоден ли FDC в день пожарной тревоги. Головки пожарных рукавов — региональные: соединение, совместимое с оснащением одной пожарной бригады, может оказаться бесполезным для другой. SQD100-1.6 поставляется с двумя входами DN65 и заглушками в исполнении <strong>SQS65 / KWS65</strong>; тип головок следует подтвердить с местным пожарным подразделением до размещения заказа.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Если в проекте применяются соединения по немецкому стандарту, <a href="/ru/products/storz-coupling-2-5inch-aluminum/" class="text-brand-blue font-semibold hover:underline">алюминиевая головка Storz 2,5"</a> покрывает DN50–DN150 с самозакрывающимся уплотнением и геометрией быстрого соединения Storz; базовый материал — алюминий, доступны латунное и хромированное исполнение, класс давления 1,6 МПа — подходит для чистой воды и пеносмеси.</p>
			<p class="text-gray-700 leading-relaxed">Для перехода «резьба — головка» на объекте <a href="/ru/products/fire-hydrant-hose-coupling-adapter-hs/" class="text-brand-blue font-semibold hover:underline">переходник головок серии HS</a> (DN50 / DN65, 1,6 МПа / 232 PSI) выполнен из анодированного алюминиевого сплава с стандартными внутренней и наружной резьбой по GB12514 или заводскому стандарту, поэтому рукава можно соединить с выходами гидрантов или FDC без утечек. Если система соединений задаётся стандартом проекта, в нашем <a href="/ru/guides/ce-en12845-fire-protection-compliance/" class="text-brand-blue font-semibold hover:underline">руководстве по соответствию CE и EN 12845</a> объяснено, как Storz, KWS и резьбовые системы трактуются в европейских спецификациях.</p>

			<!-- Section 4 -->
			<h2 id="where-fdc-installed" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Где устанавливаются FDC</h2>
			<p class="text-gray-700 leading-relaxed mb-4">FDC монтируется на наружной плоскости защищаемого здания в точке, куда пожарные могут дотянуться рукавами с улицы или твёрдого покрытия — вне дуги открывания дверей, озеленения, знаков и любых мест, которые в будущем могут стать парковкой. Обычно соединение сочетается с табличкой, указывающей обслуживаемую систему, чтобы расчёт, прибывший на крупный объект, понимал, какой стояк он наполняет.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Со стороны здания соединение питает сеть стояков: систему пожарного стояка с кранами на лестничных клетках и головками <a href="/ru/products/indoor-fire-hydrant-head-sn65/" class="text-brand-blue font-semibold hover:underline">внутренних пожарных кранов</a> и/или магистраль спринклеров. Именно поэтому FDC следует рассматривать в спецификации вместе с оборудованием гидрантов и стояков здания, а не как самостоятельную покупку.</p>
			<p class="text-gray-700 leading-relaxed">Две привычки при монтаже предотвращают большинство сбоев: обеспечите сток воды с фланца выхода и из корпуса, чтобы в морозную погоду вода не застаивалась в соединении, и следите, чтобы соединение никогда не загораживалось — FDC, скрытый за припаркованным грузовиком, функционально отсутствует; это самый частый дефект, выявляемый при осмотре объектов.</p>

			<!-- Section 5 -->
			<h2 id="fdc-comparison" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Сиамский корпус, головка Storz или переходник?</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Компонент</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Функция</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Размер и класс</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Материал / примечания</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Сиамский корпус SQD100-1.6</td>
							<td class="px-4 py-3 text-gray-700">Две машины подают воду в одну магистраль здания</td>
							<td class="px-4 py-3 text-gray-700">2 × DN65 входы, фланцевый выход DN100, 1,6 МПа</td>
							<td class="px-4 py-3 text-gray-700">Высокопрочный чугун, красное порошковое покрытие, длина 120 мм, интегрированный управляющий клапан, входы с заглушками и страховочными тросами</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Головка Storz 2,5"</td>
							<td class="px-4 py-3 text-gray-700">Быстрое соединение «рукав—рукав» / «рукав—вход»</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN150, 1,6 МПа</td>
							<td class="px-4 py-3 text-gray-700">Алюминий (латунь / хром), немецкий стандарт Storz, самозакрывающееся уплотнение, вода и пена</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Переходник головок HS</td>
							<td class="px-4 py-3 text-gray-700">Подгонка типов резьб к головкам рукавов на объекте</td>
							<td class="px-4 py-3 text-gray-700">DN50 / DN65, 1,6 МПа (232 PSI)</td>
							<td class="px-4 py-3 text-gray-700">Анодированный алюминиевый сплав, GB12514 / заводской стандарт, внутренняя и наружная резьба</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Три позиции решают разные задачи: сиамский корпус — это сам FDC, головка Storz — система соединений там, где проект задаёт немецкий стандарт, переходник — полевое решение, позволяющее несовпадающим резьбам и головкам работать вместе. Хорошо специфицированный проект обычно требует корпус и одну систему головок — переходники должны быть исключением, а не планом.</p>

			<!-- Section 6 -->
			<h2 id="fdc-spec-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Чек-лист спецификации и монтажа</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Согласуйте головки с пожарной службой</strong> — до размещения заказа сверьте тип входов с головками, которыми реально работают местные машины (как поставлено SQS65 / KWS65 или Storz, если это задано в проекте).</li>
				<li><strong>Проверьте путь потока</strong> — 2 × DN65 входы в фланцевый выход DN100 при рабочем давлении 1,6 МПа; убедитесь, что фланец выхода соответствует соединению стояка на чертежах производства работ.</li>
				<li><strong>Закрепите детали клапана и заглушек</strong> — в SQD100-1.6 интегрирован управляющий клапан с маховиком и заглушки входов с плетёными стальными страховочными тросами.</li>
				<li><strong>Спланируйте расположение</strong> — наружная плоскость, доступ рукавами с улицы, обозначено знаком, видно, защищено от будущих парковочных мест и озеленения; укажите корпус с возможностью слива, чтобы вода не застаивалась в мороз.</li>
				<li><strong>Укажите покрытие и материалы</strong> — корпус из высокопрочного/серого чугуна с красным порошковым покрытием, шпиндель маховика — латунь или нержавеющая сталь, компактная длина корпуса 120 мм для стеснённых установок.</li>
				<li><strong>Запросите документацию</strong> — протоколы испытаний корпуса давлением по партии и сертификаты на материалы для сборки; перед выбором поставщика пройдите наш <a href="/ru/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">чек-лист закупки арматуры B2B</a>. По стороне снабжения того же проекта — <a href="/ru/guides/how-to-choose-a-fire-hydrant/" class="text-brand-blue font-semibold hover:underline">как выбрать пожарный гидрант</a>.</li>
			</ul>

