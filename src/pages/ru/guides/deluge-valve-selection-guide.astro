---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'В чём главное различие между дренчерным клапаном и клапаном системы предварительного действия?',
		answer: 'В дренчерной системе используются открытые оросители или насадки, поэтому открытие дренчерного клапана подаёт воду сразу к каждой точке выпуска. В системе предварительного действия обычно установлены закрытые оросители, а обнаружение пожара открывает управляющий клапан до выпуска воды оросителем. Дренчерная система выбирается для быстрого одновременного орошения, а система предварительного действия — когда случайный сброс воды необходимо ограничить. Требуемую блокировку и последовательность по нормам подтверждают по действующей редакции стандарта.'
	},
	{
		question: 'Какой тип срабатывания выбрать для дренчерного клапана: электрический или гидравлический?',
		answer: 'Способ срабатывания выбирают по проекту обнаружения, требованиям взрывоопасной зоны, доступному электропитанию и требуемой отказобезопасной последовательности. Электрическое срабатывание удобно, когда уже предусмотрены пожарная панель и контролируемая цепь электромагнитного клапана. Гидравлическое или пневматическое срабатывание подходит для объектов, где предпочтительны отдельная напорная линия или пневматический извещатель. Wanlian поставляет группу клапана и совместимые аксессуары; последовательность панели обнаружения подтверждает проектировщик системы.'
	},
	{
		question: 'Как защитить дренчерную систему в холодном климате?',
		answer: 'По возможности размещайте группу дренчерного клапана и обвязку в отапливаемом доступном помещении и не оставляйте заполненные водой наружные трубопроводы там, где возможно замерзание. Предусмотрите сбор и отвод конденсата из обвязки обнаружения, изолируйте уязвимые участки и применяйте утверждённую сухую или пневматическую схему, если этого требует проект. Не добавляйте антифриз и не изменяйте обвязку без согласования с уполномоченным органом. Способ защиты от замерзания подтверждают по действующей редакции стандарта.'
	},
	{
		question: 'Как защитить линию обнаружения от случайного срабатывания?',
		answer: 'Отделите линию обнаружения от обычных органов управления, контролируйте её давление или состояние цепи, защитите открытые устройства от ударов и применяйте последовательность панели пуска, предусмотренную для данной опасности. Ручной пуск должен быть защищён, но доступен, а испытательные соединения — чётко обозначены и восстановлены после проверки. Для гидравлического, пневматического и электрического обнаружения нужны собственные функции контроля тревоги и неисправности. Итоговую матрицу причин и действий утверждают до ввода в эксплуатацию.'
	},
	{
		question: 'Какие сведения включить в запрос цены на дренчерный клапан?',
		answer: 'Укажите описание опасности, защищаемую площадь, расчётный расход и давление, условный проход и концевое присоединение клапана, схему открытых оросителей или лафетных стволов, способ обнаружения, требуемую последовательность срабатывания, температуру окружающей среды, устройство дренажа и применимую редакцию стандарта. Также запросите чертежи обвязки, данные о материалах, протоколы испытаний давлением, сведения о запасных частях и руководство по эксплуатации. Если требуется листинг или одобрение, укажите это явно и попросите поставщика подтвердить актуальность документов.'
	},
	{
		question: 'Поставляет ли Wanlian панель управления обнаружением дренчерной системы?',
		answer: 'Wanlian поставляет группы дренчерных клапанов, связанные клапаны и аксессуары контроля, включая группу ZSFM и подходящие отсечные или управляющие компоненты. Панель управления обнаружением не включается в стандартный пакет клапана, если её поставляет другая сторона. Панель пуска, извещатели и программирование матрицы причин и действий следует специфицировать с подрядчиком по пожарной сигнализации или специализированной системой обнаружения, а затем сверить с обвязкой клапана и объектовой последовательностью.'
	}
];

const toc = [
	{ id: 'when-deluge', label: '1. Когда системе нужна дренчерная защита' },
	{ id: 'how-it-works', label: '2. Как работает группа дренчерного клапана ZSFM' },
	{ id: 'actuation', label: '3. Выбор способа срабатывания' },
	{ id: 'sizing', label: '4. Подбор клапана по расходу и времени срабатывания' },
	{ id: 'discharge', label: '5. Открытые оросители, лафетные стволы и схема выпуска' },
	{ id: 'testing', label: '6. Ввод в эксплуатацию и периодические испытания' },
	{ id: 'rfq-checklist', label: '7. Чек-лист запроса цены на дренчерный клапан' },
	{ id: 'faq', label: 'Часто задаваемые вопросы' }
];

const products = [
	{ slug: 'deluge-alarm-valve-zsfm', name: 'Группа дренчерного сигнального клапана (серия ZSFM)', img: '/assets/products/deluge-alarm-valve-zsfm.webp', desc: 'Группа дренчерного клапана с нижней мембраной для систем с открытыми оросителями и лафетными стволами' },
	{ slug: 'pre-action-alarm-system-zsfy', name: 'Сигнальная система предварительного действия (серия ZSFY)', img: '/assets/products/pre-action-alarm-system-zsfy.jpg', desc: 'Сборки предварительного действия с одинарной и двойной блокировкой' },
	{ slug: 'manual-fire-water-cannon-ps', name: 'Ручной пожарный лафетный ствол (серия PS)', img: '/assets/products/manual-fire-water-cannon-ps.webp', desc: 'Стационарный лафетный ствол для дренчерного и мониторного выпуска' },
	{ slug: 'ul-fm-resilient-seat-osy-gate-valve', name: 'Задвижка OS&amp;Y с эластичным седлом UL/FM', img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp', desc: '2"–10", канавочные концы, выдвижной шпиндель, листинг UL/FM' }
];
---

<Layout
	title="Подбор дренчерного клапана: руководство 2026"
	description="Группа ZSFM: принцип работы, подбор по расходу и времени срабатывания, способы пуска, открытые оросители, испытания и данные для запроса цены."
	type="article"
	locale="ru"
	faq={faq}
	breadcrumbs={[{ name: 'Руководства', href: '/ru/blog/' }, { name: 'Подбор дренчерного клапана' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/blog/" class="hover:text-blue-600">Руководства</a>
			<span>/</span>
			<span class="text-gray-600">Подбор дренчерного клапана</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Руководство по дренчерным клапанам</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Подбор дренчерного клапана: открытые оросители и лафетные системы</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Коротко: дренчерный клапан — управляемая граница между напорным источником воды и сетью открытых оросителей, насадок или лафетных стволов. Сначала срабатывает линия обнаружения, затем клапан одновременно подаёт воду ко всем открытым точкам выпуска. Корректный подбор начинается с опасности и расчётного расхода, после чего проверяют пропускную способность Kv или Cv, потери давления, время срабатывания, способ пуска, дренаж и доступ к испытаниям. В руководстве разобраны группа ZSFM, отличие от мокрых, сухих систем и систем предварительного действия, а также данные, которые закупщик должен включить в запрос цены.</p>

			<TableOfContents headings={toc} />

			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 id="when-deluge" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Когда системе нужна дренчерная защита</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Дренчерная защита нужна там, где пожар может быстро развиваться, всю опасную зону необходимо орошать одновременно или направленный лафетный ствол должен получить воду сразу после обнаружения. Типичные объекты — сценические декорации и колосниковые пространства театров, авиационные ангары, трансформаторы, конвейерные ленты, зоны для транспортных средств и системы предварительного действия «пена–вода». Определяющая особенность — открытые оросители или насадки. Вода не ждёт срабатывания отдельной стеклянной колбы: одна последовательность пуска подаёт её по всей открытой сети.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Компромисс — высокий расчётный расход воды. Проектировщик дренчерной системы учитывает все открытые точки выпуска, способные работать одновременно, доступное давление на входе клапана, трение в трубах и давление, требуемое у гидравлически наиболее удалённого выпуска. EN 12845 и NFPA 13 требуют, чтобы дренчерный клапан быстро подавал воду ко всем открытым точкам после обнаружения, обычно ориентируясь примерно на 60 секунд, но точную основу расчёта определяют действующая редакция и опасность объекта. Всегда подтверждайте требование по актуальной редакции стандарта.</p>
			<p class="text-gray-700 leading-relaxed">Речь идёт не просто о выборе «самого большого клапана». Мокрый сигнальный обратный клапан, например <a href="/ru/products/wet-alarm-check-valve-zsfz-150/" class="text-brand-blue font-semibold hover:underline">ZSFZ</a>, предназначен для другой схемы с нормально закрытыми оросителями. Для системы с открытыми оросителями исходной точкой является <a href="/ru/products/deluge-alarm-valve-zsfm/" class="text-brand-blue font-semibold hover:underline">группа дренчерного сигнального клапана ZSFM</a> с учётом гидравлического расчёта и требований к одобрению.</p>

			<h2 id="how-it-works" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Как работает группа дренчерного клапана ZSFM</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Дренчерный клапан удерживается в закрытом положении системой заливки, а сторона подачи остаётся под давлением. Независимый контур обнаружения распознаёт опасность и запускает обвязку через гидравлическую, пневматическую или электрическую последовательность. После снятия удерживающего давления или срабатывания устройства пуска основная мембрана или заслонка перемещается, и вода из источника поступает в дренчерный трубопровод. Затем вода достигает всех открытых оросителей, насадок или лафетных стволов, не дожидаясь теплового срабатывания каждого выпуска.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Группу ZSFM следует проверять как сборку, а не только как корпус. В запросе цены указывают размер клапана, входное и выходное присоединения, заливочную обвязку, дренаж и испытательную схему, сигнальный выход, реле давления и ручной аварийный пуск. Сигнальный тракт может приводить в действие водяной сигнализатор или передавать давление на контролируемую панель — в зависимости от указанной обвязки. Контролируемый отсечной клапан перед группой и управляемая испытательная схема после неё позволяют обслуживать узел без скрытого закрытия клапана.</p>
			<p class="text-gray-700 leading-relaxed">Wanlian поставляет группы дренчерных клапанов, связанные клапаны и аксессуары контроля. Панель обнаружения, извещатели и запрограммированная логика причин и действий не включаются без оговорки, если их поставляет другой специализированный подрядчик. Эта граница должна быть отражена в ведомости оборудования, чтобы монтажник понимал, кто отвечает за цепь пуска, передачу тревоги и последовательность сброса и восстановления.</p>

			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Тип системы</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Условие выпуска</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Типовая логика выбора</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Дренчерная</td>
							<td class="px-4 py-3 text-gray-700">После срабатывания клапана вода идёт ко всем открытым точкам</td>
							<td class="px-4 py-3 text-gray-700">Быстрое одновременное орошение зоны высокой опасности</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Мокрая</td>
							<td class="px-4 py-3 text-gray-700">Срабатывают только оросители, активированные теплом</td>
							<td class="px-4 py-3 text-gray-700">Отапливаемые помещения с закрытыми оросителями</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Сухая</td>
							<td class="px-4 py-3 text-gray-700">Перед поступлением воды в сухую сеть выпускается воздух</td>
							<td class="px-4 py-3 text-gray-700">Зоны, где замерзание исключает мокрую систему</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Предварительного действия</td>
							<td class="px-4 py-3 text-gray-700">Обнаружение открывает клапан, но закрытые оросители ограничивают выпуск</td>
							<td class="px-4 py-3 text-gray-700">Чувствительные к воде помещения с дополнительным условием пуска</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 id="actuation" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Выбор способа срабатывания</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Линия обнаружения отделена от водораспределительного трубопровода и действует до дренчерного клапана. Заполненная жидкостью гидравлическая линия обнаружения может запускать клапан через пилотное устройство; пневматическая линия использует давление воздуха и сухую пилотную схему; электрический пуск — контролируемый электромагнитный клапан и панель пуска. Выбор зависит от условий объекта, доступных инженерных сетей, прокладки кабелей, философии контроля и требуемой последовательности ручного пуска, тревоги и восстановления.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Электрический пуск удобен там, где уже есть извещатели, пожарная панель и удалённые точки контроля состояния. Гидравлический или пневматический пуск предпочтителен при локальной логике управления или когда линия обнаружения должна оставаться независимой от длинной электрической цепи. <a href="/ru/products/groove-solenoid-control-gate-valve-gkzf1/" class="text-brand-blue font-semibold hover:underline">Канавочный электромагнитный управляющий клапан GKZF1</a> может применяться в электрически управляемой схеме, но выход панели пуска, напряжение, контроль цепи и способ сброса всё равно подтверждает проектировщик системы.</p>
			<p class="text-gray-700 leading-relaxed">В качестве варианта предварительного действия полезно сравнить <a href="/ru/products/pre-action-alarm-system-zsfy/" class="text-brand-blue font-semibold hover:underline">сигнальную систему ZSFY</a>: одинарная и двойная блокировка задают разные условия пуска. Не выбирайте систему только по слову «электрическая»: зафиксируйте действия при потере питания, потере пилотного давления, тревоге извещателя, ручном пуске, сигнале потока воды и восстановлении. Итоговую матрицу проверяют как рабочую последовательность, а не только как электрическую схему.</p>

			<h2 id="sizing" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Подбор клапана по расходу и времени срабатывания</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Подбирайте клапан по расчётной потребности, а не только по диаметру ответвления. Определите расчётный расход по всем открытым оросителям, лафетным стволам или насадкам, которые должны работать для данной опасности, затем проверьте доступное давление на входе и давление у удалённого выпуска. Выбранный клапан должен пропускать требуемый расход с приемлемыми потерями, пока обвязка и сигнальный тракт работают в допустимом диапазоне. Kv или Cv — полезные значения для сравнения, но их нужно рассматривать при соответствующем перепаде давления, а не переносить из несопоставимого условия испытаний.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Время срабатывания — результат работы всей системы. Оно включает реакцию обнаружения, падение давления в пилотной линии или электрический пуск, открытие клапана, реакцию обвязки, заполнение труб и поступление воды к удалённым выпускам. EN 12845 и NFPA 13 задают ожидание быстрой подачи для дренчерных систем — часто около 60 секунд до подачи воды к открытым точкам после обнаружения. Точное требование подтверждают по действующей редакции и проверяют по самой длинной и гидравлически неблагоприятной ветви, а не по короткому испытательному соединению.</p>
			<p class="text-gray-700 leading-relaxed">Линия обнаружения требует отдельного расчёта. Её наиболее длинный или удалённый пилотный участок может определять падение давления, объём воздуха, вытеснение воды или электрический контроль. Учитывайте отметки, фасонные детали, точки конденсации и фактическое устройство пуска. Если холод или влажность могут вызвать конденсацию, установите сборник конденсата и дренаж в подходящей нижней точке. Эти детали легко исключить из предложения только на клапан и именно они часто объясняют, почему испытание с пуском на объекте не совпадает с чертежом.</p>

			<h2 id="discharge" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Открытые оросители, лафетные стволы и схема выпуска</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Открытые оросители и насадки располагают для группового орошения опасной зоны. Диаметр отверстия, угол распыления, шаг и отметка влияют на гидравлическую потребность, а препятствия и ветер — на фактическое покрытие. Схема с лафетным стволом добавляет требования к дальности струи, наведению и реактивному усилию; стационарный <a href="/ru/products/manual-fire-water-cannon-ps/" class="text-brand-blue font-semibold hover:underline">ручной пожарный лафетный ствол PS</a> может входить в дренчерную схему, но подачу воды проверяют для расхода ствола вместе со всеми одновременно работающими открытыми оросителями.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Отсечную арматуру после клапана устанавливайте только там, где это допускает утверждённый проект, и контролируйте любой клапан, способный отключить часть опасной зоны. Дренаж и испытательное соединение дренчерной системы должны безопасно отводить воду, не затапливая помещение клапанов и не направляя загрязнённую воду в неподходящую канализацию. Сигнальный выход держите видимым и доступным, а ручной пуск обозначьте так, чтобы оператор в аварии не перепутал его с испытательным или дренажным клапаном.</p>
			<p class="text-gray-700 leading-relaxed">Для системного контекста сопоставьте гидравлические допущения с <a href="/ru/guides/esfr-sprinkler-system-guide/" class="text-brand-blue font-semibold hover:underline">руководством по спринклерной системе ESFR</a> и <a href="/ru/guides/fire-sprinkler-system-wet-dry-preaction/" class="text-brand-blue font-semibold hover:underline">руководством по мокрым, сухим системам и системам предварительного действия</a>. Если добавляется пена, изучите <a href="/ru/guides/fire-sprinkler-system-valves-guide/" class="text-brand-blue font-semibold hover:underline">руководство по клапанам спринклерных систем</a>, чтобы дренчерный клапан, оборудование для концентрата и устройства выпуска рассматривались как единая гидравлическая и управляющая последовательность.</p>

			<h2 id="testing" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Ввод в эксплуатацию и периодические испытания</h2>
			<p class="text-gray-700 leading-relaxed mb-4">При вводе в эксплуатацию нужно подтвердить и водяной, и пусковой тракт. Проверьте, что входной отсечной клапан и отсечные клапаны обвязки занимают предусмотренные положения, заливочное давление стабильно, дренаж свободен, а сигнальный выход подключён. Если утверждённая процедура допускает, отдельно выполните ручной пуск и штатную последовательность обнаружения, затем запишите время от пуска до работы клапана, сигнала тревоги и поступления воды к условному удалённому выпуску.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Испытайте байпас и дренаж, не оставляя скрытый открытый путь. Проверьте водяной сигнализатор или реле давления, передачу тревоги, контакты контроля состояния и сброс. Сигнализатор потока или индикатор после клапана может поддерживать контроль состояния; <a href="/ru/guides/water-flow-indicator-guide/" class="text-brand-blue font-semibold hover:underline">руководство по сигнализаторам потока воды</a> содержит дополнительный контекст по выбору и контролю этого сигнала. До сезона дождей или другого периода повышенного риска выполните плановое испытание с пуском совместно с владельцем, подрядчиком по сигнализации и с учётом требований надзорного органа.</p>
			<p class="text-gray-700 leading-relaxed">Периодическое обслуживание выполняйте по NFPA 25 или применимому местному регламенту и инструкции изготовителя клапана. Осматривайте обвязку на коррозию, проверяйте, что дренажи и сборники конденсата не забиты, и записывайте показания давления, а не полагайтесь на память. Испытание должно проходить под контролем: зона выпуска безопасна, а система быстро восстановлена. Если действующая редакция меняет интервал, критерий приёмки или требования к документированию, сверяйтесь с ней, а не используйте старый чек-лист.</p>

			<h2 id="rfq-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">7. Чек-лист запроса цены на дренчерный клапан</h2>
			<ul class="list-disc pl-6 space-y-2 text-gray-700 leading-relaxed mb-4">
				<li><strong>Опишите опасность.</strong> Укажите помещение или технологический процесс, пожарную нагрузку, защищаемую площадь и тип выпуска: открытые оросители, насадки, лафетные стволы или пенные устройства.</li>
				<li><strong>Дайте гидравлические данные.</strong> Укажите расчётный расход, требуемое давление у удалённого выпуска, доступное давление источника, размер труб, отметки и допущения расчёта.</li>
				<li><strong>Определите группу клапана.</strong> Укажите условный проход, концевое присоединение, материалы корпуса и обвязки, размер дренажа, сигнальный выход, испытательную схему и контролируемый отсечной клапан.</li>
				<li><strong>Задайте пуск.</strong> Опишите гидравлическое, пневматическое или электрическое обнаружение, длину пилотной линии, ручной пуск, параметры электромагнитного клапана, интерфейс панели и последовательность срабатывания.</li>
				<li><strong>Учтите среду.</strong> Укажите минимальную и максимальную температуру, размещение внутри или снаружи, риск конденсации, маршрут дренажа и коррозионное воздействие.</li>
				<li><strong>Запросите документы.</strong> Попросите сборочный чертёж, схему обвязки, инструкции по монтажу и обслуживанию, протокол испытаний давлением, сведения о материалах и действующие документы об одобрении или листинге, если этого требует проект.</li>
				<li><strong>Задайте приёмочное испытание.</strong> Определите целевое время срабатывания, сигналы тревоги, наблюдение за удалённым выпуском, процедуру восстановления и записи, требуемые после испытания с пуском.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Для общей закупочной рамки используйте <a href="/ru/fire-sprinkler-systems/" class="text-brand-blue font-semibold hover:underline">обзор спринклерных противопожарных систем</a> вместе со связанными руководствами. Полный запрос цены позволяет Wanlian подтвердить конфигурацию группы клапана, не выдавая себя за проектировщика схемы обнаружения или всей панели пожарной сигнализации. В результате понятнее границы поставки, надёжнее гидравлическая проверка и меньше изменений при вводе в эксплуатацию.</p>

