---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'Какой материал бака и защиту от коррозии следует задать?',
		answer: 'Материал бака, внутреннюю облицовку, покрытие и требования к качеству воды следует согласовать с изготовителем бака и проектировщиком. Для стальных, секционных стальных и бетонных резервуаров действуют разные решения по защите от коррозии, а правильный выбор зависит от хранимой воды, климата и местных требований. Запросите данные о покрытии, доступе для осмотра и обслуживании, не считая универсальную облицовку подходящей для противопожарной воды.'
	},
	{
		question: 'Нужна ли сертификация для противопожарной службы у противовихревого устройства?',
		answer: 'Необходимость листинга, одобрения или специального согласования зависит от применимой редакции норматива, требований надзорного органа и всей конструкции бака. Противовихревая пластина — это гидравлический защитный компонент, а не автоматически сертифицированный пожарный клапан. Подтвердите требуемые документы для проекта и представьте материал, размеры и монтажную схему вместе с документацией на бак.'
	},
	{
		question: 'Что произойдёт, если глубина погружения в баке слишком мала?',
		answer: 'Всасывающая линия может захватить воздух, образовать видимый вихрь или начать работать шумно и нестабильно. У насоса возможны колебания давления на всасе, падение расхода, вибрация или признаки, похожие на кавитацию. До изменения насоса проверьте уровень воды, геометрию входа, подходящий поток и защиту от вихря по применимой редакции норматива и данным изготовителя насоса.'
	},
	{
		question: 'Может ли один бак обслуживать бытовую и противопожарную функции?',
		answer: 'Это возможно только при сохранении требуемого противопожарного запаса, необходимого разделения или уровня отбора и согласовании с надзорным органом. Бытовой отбор или настройка контроля уровня не должны позволять обычному потреблению использовать защищённый противопожарный объём. Согласуйте гидравлическую схему, контроль и подпитку с применимым нормативом.'
	},
	{
		question: 'Почему на всасывании насоса обычно предпочитают задвижку?',
		answer: 'Полностью открытая задвижка даёт полнопроходной канал с малым возмущением рядом со входом в насос и может быть зафиксирована или поставлена под надзор в открытом положении. Отсечной клапан всасывающей линии не является регулирующим устройством. В некоторых проектах допускается сертифицированная альтернатива, но выбор до выпуска следует подтвердить у поставщика насоса, проектировщика и надзорного органа.'
	},
	{
		question: 'Как защитить всасывающий бак в холодном климате?',
		answer: 'Бак, всасывающую трубу, клапаны и оборудование контроля уровня нужно держать выше зоны риска замерзания проекта либо предусмотреть расчётную теплоизоляцию, электрообогрев и дренаж. Точный метод зависит от климата, конструкции бака и применимой редакции норматива. Защитить только корпус бака недостаточно, если открытый клапан, импульсная линия или нижняя точка могут замёрзнуть и прервать подачу противопожарной воды.'
	}
];

const toc = [
	{ id: 'water-source', label: '1. Откуда берётся противопожарный запас воды' },
	{ id: 'tank-sizing', label: '2. Расчёт противопожарного запаса воды' },
	{ id: 'two-suction', label: '3. Правило двух всасывающих линий и проходки бака' },
	{ id: 'vortex', label: '4. Защита от вихря и прокладка всасывающей трубы' },
	{ id: 'level-control', label: '5. Как держать бак полным: контроль уровня' },
	{ id: 'priming-testing', label: '6. Вакуумирование, приборы и испытания' },
	{ id: 'checklist', label: '7. Чек-лист всасывающей схемы' },
	{ id: 'faq', label: 'Часто задаваемые вопросы' }
];

const products = [
	{ slug: 'suction-vortex-preventer-en12845', name: 'Противовихревое устройство на всасе (EN 12845)', img: '/assets/products/suction-vortex-preventer-en12845.webp', desc: 'Аустенитная нержавеющая сталь, противовихревая пластина в сборе' },
	{ slug: 'hydraulic-water-level-control-valve-f745x', name: 'Гидравлический клапан контроля уровня воды (F745X)', img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp', desc: 'Пилотное поддержание уровня, плавное закрытие' },
	{ slug: 'remote-control-float-valve-100x', name: 'Поплавковый клапан дистанционного управления (100X-16P)', img: '/assets/products/remote-control-float-valve-100x.webp', desc: 'Нержавеющий поплавковый пилот для подпитки бака' },
	{ slug: 'telescopic-y-strainer-sgl41h', name: 'Телескопический Y-фильтр (SGL41H)', img: '/assets/products/telescopic-y-strainer-sgl41h.webp', desc: 'Защита всасывающей линии от мусора, очистка без демонтажа' }
];
---

<Layout
	title="Всасывающая линия пожарного насоса и бак воды"
	description="Расчёт бака противопожарного запаса воды, две всасывающие линии, противовихревые устройства, заполнение и контроль уровня для пожарного насоса."
	type="article"
	locale="ru"
	faq={faq}
	breadcrumbs={[{ name: 'Руководства', href: '/ru/blog/' }, { name: 'Руководство по всасыванию пожарного насоса' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/blog/" class="hover:text-blue-600">Руководства</a>
			<span>/</span>
			<span class="text-gray-600">Руководство по всасыванию пожарного насоса</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Бак противопожарного запаса воды</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Всасывающая линия пожарного насоса и бак воды</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Коротко: пожарный насос выдаёт сертифицированную характеристику только тогда, когда бак обеспечивает правильный запас, всасывающие входы остаются погружёнными, поступление воздуха и образование вихря контролируются, а оборудование подпитки не расходует защищённый объём. В руководстве разобраны источник воды, расчёт бака, схемы с двумя всасывающими линиями, противовихревые решения, контроль уровня, заполнение и сведения, которые нужно внести в ведомость всасывающей стороны.</p>

			<TableOfContents headings={toc} />

			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 id="water-source" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Откуда берётся противопожарный запас воды</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Всасывающая схема начинается с источника воды, а не с каталога клапанов. Пожарный насос может забирать воду из открытого атмосферного бака, отдельного секционного бака, бетонного резервуара, напорного сосуда или муниципального водопровода. Каждый источник меняет доступный напор на всасе, способ вакуумирования насоса, необходимую защиту входа и документы, требуемые при приёмке. Насос и контроллер поставляет изготовитель насоса по NFPA 20 или местному нормативу; Wanlian поставляет клапаны и принадлежности всасывающей стороны вокруг этого комплекта, но не сам пожарный насос.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Открытый бак противопожарного запаса воды обычно является наиболее предсказуемым источником: его рабочий уровень виден, а давление равно атмосферному. Проектировщик насоса всё равно должен учесть минимальный пригодный уровень, отметку входа, потери в трубопроводе и требования изготовителя насоса к всасыванию. У закрытого напорного бака другое соотношение давления и объёма, а муниципальное подключение зависит от надёжности общего водопровода и ограничений водоканала. Нельзя переносить схему бака на прямое подключение без нового расчёта условий на всасе.</p>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Источник</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Что это значит для всасывания</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Вопрос проектирования</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Открытый бак противопожарной воды</td>
							<td class="px-4 py-3 text-gray-700">Статический уровень воды, погружённый вход, противовихревое устройство и дренируемый трубопровод</td>
							<td class="px-4 py-3 text-gray-700">Достаточен ли минимальный рабочий уровень для входа насоса?</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Закрытый напорный бак</td>
							<td class="px-4 py-3 text-gray-700">Давление в баке, полезный объём, отсечение и безопасное обслуживание</td>
							<td class="px-4 py-3 text-gray-700">Сохраняется ли давление в течение требуемого режима?</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Прямое муниципальное подключение</td>
							<td class="px-4 py-3 text-gray-700">Давление в общем водопроводе, надёжность расхода, защита от обратного потока и согласование</td>
							<td class="px-4 py-3 text-gray-700">Обеспечивает ли водопровод требуемое условие на всасе всегда?</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Более широкий разбор последовательности клапанов в насосной см. в <a href="/ru/guides/fire-pump-room-valves-guide/" class="text-brand-blue font-semibold hover:underline">руководстве по арматуре насосной</a>. До фиксации проходок бака полезно согласовать характеристику насоса и принцип отсечения.</p>

			<h2 id="tank-sizing" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Расчёт противопожарного запаса воды</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Противопожарный запас определяется классом опасности объекта, расчётным расходом и требуемой продолжительностью работы по применимому проектному нормативу. Ответственно назвать универсальный объём бака для копирования из одного здания в другое невозможно. Гидравлический расчёт устанавливает потребность, а редакция применимого норматива — время, в течение которого запас должен поддерживать защищаемые системы. Зафиксируйте основание расчёта, требуемый полезный объём и отметку нижнего уровня в ведомостях бака и насоса.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Разделяйте полный объём и полезный противопожарный объём. Геометрия бака, настройки верхнего и нижнего уровня, запас на осадок, перелив и положение каждого отвода определяют, сколько воды насос действительно сможет забрать. Если бак общий с бытовой системой, её отбор нужно устроить так, чтобы обычное потребление не использовало защищённый противопожарный запас. Клапан подпитки должен поддерживать нормальный уровень без резкого закрытия, а контролируемый сигнал низкого уровня должен поступать на пожарную сигнализацию или в систему управления зданием согласно требованиям.</p>
			<p class="text-gray-700 leading-relaxed">Для нормативного контекста сопоставьте расчёты проектной команды с <a href="/ru/guides/nfpa-fire-protection-standards-guide/" class="text-brand-blue font-semibold hover:underline">руководством по нормам противопожарной защиты NFPA</a>. Используйте обзор для формирования вопросов, затем подтвердите каждый объём, срок и требование к уровню по применимой редакции норматива и у надзорного органа.</p>

			<h2 id="two-suction" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Правило двух всасывающих линий и проходки бака</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Крупным бакам противопожарной воды нужна не одна точка зависимости. Положения NFPA 20 для больших запасов требуют более одного всасывающего отвода или магистрали и ограничивают зависимость от одной всасывающей линии, однако точный порог и схема зависят от применимой редакции норматива. До вычерчивания стенки бака подтвердите редакцию и покажите, есть ли у каждого насоса независимый маршрут, как маршруты изолируются и как выполнить обслуживание без уменьшения требуемой противопожарной ёмкости.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Проходка бака — это системный узел, а не просто отверстие с фланцем. Согласуйте положение гильзы, усиление, материал прокладки, наружное отсечение, внутренние противовихревые пластины и доступ для осмотра. Клапан держите снаружи бака, где его можно обслуживать и приводить в действие, а катушку сделайте дренируемой или съёмной без нарушения работы второго всаса. <a href="/ru/products/ul-fm-resilient-seat-osy-gate-valve/" class="text-brand-blue font-semibold hover:underline">Задвижка UL/FM OS&amp;Y с эластичным седлом</a> часто рассматривается там, где нужна сертифицированная полнопроходная отсечная задвижка с видимым открытым положением; выбор остаётся предметом спецификации проекта.</p>
			<p class="text-gray-700 leading-relaxed">Две всасывающие линии не означают две декоративные ветви, сразу сведённые в одно узкое место. Проследите каждый маршрут до схемы насоса, проверьте доступную площадь прохода и укажите клапаны, которые должны оставаться запертыми или контролируемо открытыми. При наличии второго насоса или отсека проектировщик должен показать, что отказ одного компонента не убирает требуемую всасывающую способность.</p>

			<h2 id="vortex" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Защита от вихря и прокладка всасывающей трубы</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Вход в бак должен оставаться погружённым на минимальную глубину, установленную применимым нормативом и схемой насоса. Если уровень воды опускается слишком близко к отверстию, вихрь может затянуть воздух во всасывание, хотя в баке ещё видна вода. Поступление воздуха снижает расход, вызывает нестабильное давление на всасе и может повредить рабочее колесо. Противовихревая пластина или <a href="/ru/products/suction-vortex-preventer-en12845/" class="text-brand-blue font-semibold hover:underline">противовихревое устройство на всасе EN 12845</a> помогает разрушить вращательное течение, но не заменяет требуемую глубину погружения и правильный расчёт трубы.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Сделайте подход к насосу настолько простым, насколько позволяет помещение. Применяйте размер всасывающей трубы и длину прямого участка по данным изготовителя насоса, избегайте лишних отводов рядом со всасывающим фланцем и устанавливайте эксцентрический переход плоской стороной вверх, чтобы воздух не скапливался на входе насоса. Поддерживайте трубу независимо, чтобы её вес и температурные перемещения не нагружали корпус насоса. Клапан на всасе предназначен для отсечения, а не для дросселирования.</p>
			<p class="text-gray-700 leading-relaxed">Если возможен мусор, очищаемый <a href="/ru/products/telescopic-y-strainer-sgl41h/" class="text-brand-blue font-semibold hover:underline">телескопический Y-фильтр SGL41H</a> может защитить всасывающую линию там, где это разрешено утверждённой схемой, однако любая сетка добавляет потери и требует обслуживания. До монтажа подтвердите ячейку, доступ, перепад давления и приёмку для противопожарной службы. Забитый фильтр может выглядеть как недостаточный объём бака, хотя реальный признак — падение показания манометра на всасе.</p>

			<h2 id="level-control" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Как держать бак полным: контроль уровня</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Бак, полный при сдаче объекта, не обязательно является надёжным источником противопожарной воды. Оборудование подпитки должно поддерживать нормальный уровень, плавно закрываться, выдерживать доступное входное давление и давать чёткий сигнал при снижении уровня. Задача схемы — не допустить, чтобы бытовой расход, испарение, испытания и небольшие утечки использовали защищённый запас, и одновременно не допустить переполнения бака из-за неконтролируемой подпитки.</p>
			<p class="text-gray-700 leading-relaxed mb-4"><a href="/ru/products/hydraulic-water-level-control-valve-f745x/" class="text-brand-blue font-semibold hover:underline">Гидравлический клапан контроля уровня F745X</a> использует пилотную схему для поддержания уровня и плавного закрытия. Если проект предусматривает дистанционную поплавковую схему, <a href="/ru/products/remote-control-float-valve-100x/" class="text-brand-blue font-semibold hover:underline">поплавковый клапан дистанционного управления 100X-16P</a> обеспечивает нержавеющий поплавковый пилот для подпитки бака. Ни один из этих продуктов сам по себе не задаёт противопожарный запас: уставки, байпасы, давление до клапана и сигналы должны соответствовать утверждённому гидравлическому расчёту.</p>
			<p class="text-gray-700 leading-relaxed">Покажите верхний, нормальный, нижний и аварийный уровни на схеме управления. Предусмотрите доступную наружную отсечную задвижку, дренаж или точку испытания при необходимости и способ проверить работу пилота или поплавка без опорожнения бака. Если бак общий, свяжите сигнал уровня с бытовыми органами управления, чтобы отказ клапана подпитки не мог незаметно уменьшить противопожарный запас.</p>

			<h2 id="priming-testing" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Вакуумирование, приборы и испытания</h2>
			<p class="text-gray-700 leading-relaxed mb-4">До работы центробежного пожарного насоса его корпус и всасывающую линию необходимо правильно заполнить, а всасывающая сторона должна оставаться затопленной по проекту. Окончательная схема зависит от типа насоса и отметки источника, поэтому следуйте инструкции поставщика по заполнению, не добавляя самовольно донный клапан или дополнительный обратный клапан. Манакометр на фланце всасывания показывает, действительно ли источник доступен; при приёмке сопоставьте его с манакрометром нагнетания и сертифицированной характеристикой насоса.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Предусмотрите точки отсечения и дренажа, позволяющие осмотреть всасывающую катушку, клапан и приборы без опорожнения всего бака. Защитите приборы от случайного удара и подберите диапазоны для ожидаемых статических и рабочих условий. При пусконаладке проверьте положение клапанов, сигнал низкого уровня, работу подпитки, монтаж противовихревого устройства, опоры труб и отсутствие подсоса воздуха до записи характеристики насоса.</p>
			<p class="text-gray-700 leading-relaxed">Испытания должны подтвердить и гидравлическую производительность, и заложенный безопасный отказ. Если разрешено, имитируйте низкий уровень, приведите в действие клапан подпитки, осмотрите проходку бака и подтвердите доступность требуемого всаса при запланированном положении отсечения. Для наружного подключения и интерфейса напорной стороны <a href="/ru/guides/fire-department-connection-siamese-guide/" class="text-brand-blue font-semibold hover:underline">руководство по сиамскому подключению пожарной службы</a> объясняет, как согласовать подключение пожарной машины с остальной насосной.</p>

			<h2 id="checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">7. Чек-лист всасывающей схемы</h2>
			<ul class="list-disc pl-6 space-y-2 text-gray-700 leading-relaxed mb-4">
				<li><strong>Определите источник.</strong> Укажите открытый бак, напорный бак или муниципальное подключение, минимальный рабочий уровень, доступное давление и требуемое поставщику насоса условие на всасе.</li>
				<li><strong>Задокументируйте запас.</strong> Покажите расчётный противопожарный объём и продолжительность, все отметки уровней и защищённый объём, общий с бытовым потреблением.</li>
				<li><strong>Согласуйте отводы.</strong> Подтвердите применимую редакцию NFPA 20, требование двух всасывающих линий для данного размера бака и независимость каждого маршрута.</li>
				<li><strong>Исключите поступление воздуха.</strong> Проверьте погружение, геометрию против вихря, ориентацию эксцентрического перехода, длину прямого участка и независимые опоры труб.</li>
				<li><strong>Защитите воду.</strong> Задайте наружную отсечную задвижку, очищаемый фильтр только при согласовании, манакрометры, дренажи и доступ для обслуживания.</li>
				<li><strong>Контролируйте уровень.</strong> Подберите пилотное оборудование F745X или 100X по входному давлению, задайте нормальный и нижний уровни и подключите требуемые сигналы.</li>
				<li><strong>Спланируйте приёмку.</strong> Включите инструкции по заполнению, манакрометры всаса и нагнетания, испытание подпитки, имитацию низкого уровня и записи по материалам, испытаниям давления и эксплуатации.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Для полной ведомости клапанов свяжите эту работу с <a href="/ru/guides/municipal-fire-water-main-upgrade-guide/" class="text-brand-blue font-semibold hover:underline">руководством по модернизации муниципального противопожарного водопровода</a> и подтвердите условия местного водоканала. Wanlian может до расчёта поставки всасывающих клапанов и принадлежностей проверить чертёж отводов бака, характеристику насоса, размеры труб и требуемую редакцию норматива.</p>

