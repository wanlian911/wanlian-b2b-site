---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'understand-your-requirement', label: '1. Сначала определите требования к гидранту' },
	{ id: 'hydrant-types-explained', label: '2. Типы пожарных гидрантов' },
	{ id: 'key-specifications', label: '3. Ключевые характеристики для сравнения' },
	{ id: 'certification-compliance', label: '4. Сертификация и соответствие нормам' },
	{ id: 'common-mistakes', label: '5. Типичные ошибки при выборе гидранта' },
	{ id: 'factory-checklist', label: '6. Чек-лист перед заказом у производителя' },
	{ id: 'faq', label: 'Часто задаваемые вопросы' }
];

const faq = [
	{
		question: 'Какова разница между внутренними и наружными пожарными гидрантами?',
		answer: 'Внутренние пожарные краны (например, узел SN65) подключаются к внутренним системам пожарных стояков и рукавов в зданиях и подают воду к рукавам на установленных узлах каждого этажа. Наружные гидранты (например, наземный SS100) устанавливаются на муниципальных или промышленных водопроводных магистралях и подают воду пожарным автомобилям для наружных работ по пожаротушению. Это разные точки распределения, и они не взаимозаменяемы.'
	},
	{
		question: 'Какой класс давления должен быть у муниципального пожарного гидранта?',
		answer: 'Стандартные муниципальные гидранты имеют класс PN16 (1,6 МПа), что покрывает большинство городских и промышленных сетей водоснабжения. Районы с высотными зданиями или промышленные зоны с высоким водопотреблением могут требовать гидрантов PN25 с подтверждённой пропускной способностью. Всегда проверяйте статическое и остаточное давление вашей сети до выбора класса давления.'
	},
	{
		question: 'Доступны ли гидранты Wanlian с сертификацией UL или FM?',
		answer: 'Да. Wanlian Fluid предлагает гидранты и арматуру с сертификацией UL, FM, CE, ISO 9001 и LPCB в зависимости от модели и целевого рынка. Свяжитесь с нашим отделом продаж, указав спецификацию проекта и целевой регион, — мы подберём правильный пакет сертификатов.'
	},
	{
		question: 'Каков стандартный тип присоединения для экспортных пожарных гидрантов?',
		answer: 'Типовые соединения выходов: мгновенное соединение BS336 (Великобритания/страны Содружества), резьба NIST (Ближний Восток), KWS (Германия), а также фланцевые варианты. Wanlian поставляет гидранты SS100/65 и SSFT100/65 с типом присоединения, указанным для вашего рынка; фитинги могут быть отгружены в той же партии.'
	},
	{
		question: 'Каковы MOQ и сроки поставки для оптовых заказов гидрантов?',
		answer: 'Типовой минимальный заказ (MOQ) — 20 шт. на модель для размеров, имеющихся на складе; срок производства 15–30 дней в зависимости от объёма и кастомизации. Образцовые заказы доступны для предотгрузочных испытаний и утверждения. Инженер по продажам укажет точный срок под ваш объём заказа.'
	}
];

const hydrantProducts = [
	{
		slug: 'indoor-fire-hydrant-head-sn65',
		name: 'Узел внутреннего пожарного крана SN65',
		img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg',
		desc: 'Внутренний пожарный кран из высокопрочного чугуна PN16 для систем пожарных стояков'
	},
	{
		slug: 'overground-fire-hydrant-ss100',
		name: 'Наружный гидрант с защитой от замерзания (SS100/65)',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'Наружный гидрант с защитой от замерзания для муниципальных сетей в холодном климате'
	},
	{
		slug: 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100',
		name: 'Антивандальный гидрант с регулировкой давления (SSFT100/65)',
		img: '/assets/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100.webp',
		desc: 'Разрывной корпус с регулировкой давления для зон с интенсивным движением'
	},
	{
		slug: 'iot-smart-ground-fire-hydrant-ss100zn',
		name: 'Умный наземный IoT-гидрант (SS100/65-1.6ZN)',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'Мониторинг давления, наклона и незаконного отбора воды в реальном времени для умных муниципальных сетей'
	}
];
---

<Layout
	title="Как выбрать пожарный гидрант для муниципалитетов и промышленности"
	description="Гид по выбору пожарного гидранта: внутренний и наружный, Ду/Ру, тип присоединения (BS336/NIST), сертификация (UL/FM/CE), чек-лист для B2B-закупок."
	type="article"
	locale="ru"
	faq={faq}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Хлебные крошки -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/blog/" class="hover:text-blue-600">Руководства</a>
			<span>/</span>
			<span class="text-gray-600">Выбор пожарного гидранта</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Руководство по оборудованию пожаротушения</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Как выбрать пожарный гидрант для муниципальных и промышленных проектов (руководство 2026)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Пожарный гидрант — это стационарное оборудование, которое будет служить в вашей сети 10–20 лет, — и полезен он только в тот день, когда от него требуется работа. Неправильно выбранный тип, класс давления или стандарт присоединения означает замену заложенного в землю компонента в аварийных условиях, а то и хуже — гидрант, который не даст воду при прибытии пожарных. В этом руководстве мы разбираем шесть решений, которые должно принять каждое закупочное подразделение, с опорой на реально доступные сегодня конфигурации продукции.</p>

			<!-- Полоса продукции -->
			<div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
				{hydrantProducts.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="understand-your-requirement" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Сначала определите требования к гидранту</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Прежде чем сравнивать модели, ответьте на четыре вопроса вместе с вашей пожарной службой или инженерным консультантом:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Где будет установлен гидрант?</strong> Система внутреннего пожарного стояка, наружный городской трубопровод или промышленная площадка — в каждом случае нужен свой тип.</li>
				<li><strong>Какова проектная пропускная способность и давление?</strong> Потребность в воде при пожаротушении обычно начинается от 15–30 л/с на гидрант; уточните остаточное давление, которое выдерживает ваша сеть.</li>
				<li><strong>Какой стандарт регулирует ваш проект?</strong> NFPA 24/291, BS 750, GB 4452 или местные муниципальные нормы определяют размер выходов, дистанции между гидрантами и правила испытаний.</li>
				<li><strong>Каков климат?</strong> Зимы с морозами требуют гидрантов с защитой от замерзания или сухотрубного исполнения.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Правильные ответы на эти четыре вопроса исключают большинство ошибок, описанных ниже, ещё до того, как вы откроете каталог.</p>

			<h2 id="hydrant-types-explained" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Типы пожарных гидрантов</h2>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Внутренние пожарные краны (системы стояков)</h3>
			<p class="text-gray-700 leading-relaxed mb-4">Узлы внутренних пожарных кранов подключаются к вертикальным пожарным стоякам и подают воду к рукавным узам на каждом этаже. <a href="/ru/products/indoor-fire-hydrant-head-sn65/" class="text-brand-blue font-semibold hover:underline">Узел внутреннего пожарного крана SN65</a> — стандартное решение: корпус из высокопрочного чугуна с классом PN16, канавочное или фланцевое присоединение на вводе и выход 65&nbsp;мм для подключения рукава. Для высотных и промышленных зданий он обычно комплектуется пожарными рукавными барабанами и насосными установками.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Наружные наземные гидранты (муниципальные и промышленные)</h3>
			<p class="text-gray-700 leading-relaxed mb-4">Наружные гидранты забирают воду из магистральных трубопроводов и подают её пожарным автомобилям. Две основные конфигурации: <a href="/ru/products/overground-fire-hydrant-ss100/" class="text-brand-blue font-semibold hover:underline">наземный гидрант SS100/65</a> для типовых муниципальных и промышленных площадок, а также антивандальное исполнение. Если ваш гидрант устанавливается на проезжей части или в проходе склада, где движутся транспортные средства, <a href="/ru/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100/" class="text-brand-blue font-semibold hover:underline">гидрант SSFT100 с антивандальной защитой и регулировкой давления</a> добавляет два механизма безопасности: разрывной корпус, который чистко отделяется при ударе (подземная труба остаётся целой), и регулировку давления, защищающую рукава по ходу потока от превышения давления.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Умные гидранты для цифровизированных сетей</h3>
			<p class="text-gray-700 leading-relaxed mb-4">Для муниципальных операторов, цифровизирующих водоснабжение, <a href="/ru/products/iot-smart-ground-fire-hydrant-ss100zn/" class="text-brand-blue font-semibold hover:underline">умный IoT-гидрант SS100ZN</a> оснащён датчиками давления, наклона и обнаружения незаконного отбора воды в реальном времени с передачей данных на SCADA-платформу. Это тот же гидрант в механическом исполнении плюс слой мониторинга — удобно, если ваш тендер требует удалённого контроля состояния.</p>

			<h2 id="key-specifications" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Ключевые характеристики для сравнения</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Характеристика</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Что проверять</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Типично для экспортных гидрантов</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Номинальный диаметр (Ду)</td>
							<td class="px-4 py-3 text-gray-700">Диаметры входа и выхода соответствуют вашему трубопроводу и рукавам</td>
							<td class="px-4 py-3 text-gray-700">DN100/65 (SS100) или DN65 (SN65)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Номинальное давление (Ру)</td>
							<td class="px-4 py-3 text-gray-700">Должно превышать максимальное статическое давление сети</td>
							<td class="px-4 py-3 text-gray-700">PN16 (1,6 МПа) — стандарт; PN25 для зон повышенного давления</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Материал корпуса</td>
							<td class="px-4 py-3 text-gray-700">Высокопрочный чугун выдерживает удар; проверьте покрытие против коррозии</td>
							<td class="px-4 py-3 text-gray-700">QT450 (ВЧШГ) с эпоксидным/порошковым покрытием</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Тип присоединения</td>
							<td class="px-4 py-3 text-gray-700">Должен соответствовать соединительным головкам вашей пожарной бригады</td>
							<td class="px-4 py-3 text-gray-700">BS336, NIST, KWS, канавочное или фланцевое</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Особые характеристики</td>
							<td class="px-4 py-3 text-gray-700">Защита от замерзания, разрывной, с регулировкой давления, IoT</td>
							<td class="px-4 py-3 text-gray-700">По требованиям проекта</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 id="certification-compliance" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Сертификация и соответствие нормам</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Гидранты — оборудование жизнеобеспечения: в большинстве рынков сертификация не является опцией. Требуйте от поставщика сертификат, соответствующий стране назначения: <strong>UL / FM</strong> для Северной Америки, <strong>CE</strong> для Европы, <strong>LPCB</strong> для проектов в Великобритании и странах Содружества, а <strong>ISO 9001</strong> — как базовая система качества. Изучайте реальные сертификаты, а не только логотипы в буклете. Пакет сертификатов Wanlian опубликован на <a href="/ru/certificates/" class="text-brand-blue font-semibold hover:underline">странице сертификатов</a>, а наши инженеры подтвердят, какой стандарт применим к вашему тендеру, до подготовки коммерческого предложения.</p>

			<h2 id="common-mistakes" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Типичные ошибки при выборе гидранта</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Несовпадение стандарта присоединения</strong> — гидрант, к которому нельзя подключить головки местной пожарной бригады, хуже, чем никакой. Уточните стандарт головок до оформления заказа.</li>
				<li><strong>Игнорирование остаточного давления</strong> — статическое давление ничего не говорит о том, что отдаст гидрант при одновременном открытии трёх выходов.</li>
				<li><strong>Установка гидрантов без защиты от замерзания в морозном климате</strong> — повреждение камеры гидранта льдом — одна из главных причин выхода гидрантов из строя в холодных регионах.</li>
				<li><strong>Выбор стандартного гидранта для зон удара</strong> — столкновения с грузовыми автомобилями изгибают подземные штоки; разрывные конструкции защищают сеть.</li>
				<li><strong>Обход вопроса о запчастях</strong> — наличие ремонтных комплектов (уплотнения, штоки, головки) должно быть подтверждено вместе с вашим заказом, а не после ввода в эксплуатацию.</li>
			</ul>

			<h2 id="factory-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Чек-лист перед заказом у производителя</h2>
			<ol class="list-decimal pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Запросите копии сертификатов (UL/FM/CE/ISO), соответствующие вашему рынку, — не просто собирайте их, а проверяйте.</li>
				<li>Запросите отчёт об испытании гидростатическим давлением конкретной партии, а не общий сертификат испытаний.</li>
				<li>Подтвердите стандарт соединительных головок вместе с вашей пожарной службой <em>до</em> подписания заказа (PO).</li>
				<li>Для умных гидрантов запросите спецификацию интерфейса передачи данных (modbus/SCADA) и образец устройства для интеграционных испытаний.</li>
				<li>Уточните минимальный заказ (MOQ), срок производства, упаковку для морской перевозки и наличие запчастей в одном коммерческом предложении.</li>
				<li>Оставьте один образец до отгрузки для собственных испытаний и сохраните фотоматериалы испытаний.</li>
			</ol>
			<p class="text-gray-700 leading-relaxed">Надёжный поставщик должен письменно ответить на все шесть пунктов в течение одного рабочего дня. Если коммерческое предложение расплывчато по части сертификации или отчётов об испытаниях — воспринимайте это как тревожный сигнал.</p>

			<!-- Смежное руководство -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Смежное руководство: Wanlian Fluid vs American AVK</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Вас затрудняет выбор между устоявшимся американским брендом и китайским производителем? Прочитайте наше сравнение: <a href="/ru/guides/wanlian-fluid-vs-american-avk/" class="text-brand-blue font-semibold hover:underline">Wanlian Fluid vs American AVK: какой поставщик гидрантов и арматуры подходит для вашего проекта в 2026 году?</a></p>
			</div>

			<!-- Раздел FAQ -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Часто задаваемые вопросы</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

