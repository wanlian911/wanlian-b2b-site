---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

// FAQ: 4-6 реальных вопросов закупки (генерирует FAQPage JSON-LD)
const faq = [
	{
		question: 'Чем задвижка с сильфонным уплотнением отличается от стандартной задвижки?',
		answer: 'Стандартная задвижка герметизирует зону движущегося шпинделя только сальником. В задвижке с сильфонным уплотнением между шпинделем и крышкой приварен металлический сильфон, который создаёт второй, герметичный барьер. Если сильфон выйдет из строя, сальник продолжит держать — именно поэтому конструкция описывается как двойное уплотнение с нулевой утечкой.'
	},
	{
		question: 'Для каких сред применяются задвижки с сильфонным уплотнением?',
		answer: 'Задвижки с сильфонным уплотнением обычно специфицируются для теплоносителя (термального масла), пара и высокотемпературной воды, где утечка по шпинделю — это вопрос безопасности и эффективности. Они также часто выбираются для токсичных, горючих или опасных сред, где утечки должны быть сведены к минимуму, и для систем, подчинённых строгим экологическим нормам.'
	},
	{
		question: 'Какие размеры и классы давления доступны у задвижек Wanlian с сильфонным уплотнением?',
		answer: 'Наша фланцевая задвижка с сильфонным уплотнением и ручным управлением покрывает DN15-DN300 (1/2"–12") при рабочих давлениях 1,6–4,0 МПа (Class 150/300), рабочий диапазон температур — от -29°C до 425°C. Корпуса — из кованой стали (A105) или литой стали (WCB), сильфон — из нержавеющей стали 304 или 316Ti.'
	},
	{
		question: 'Соответствуют ли задвижки с сильфонным уплотнением международным стандартам?',
		answer: 'Задвижки с сильфонным уплотнением Wanlian изготавливаются по стандартам GB, ANSI, DIN и JIS; номинальные давления указываются как в метрических величинах (МПа), так и в ANSI Class. Перед заказом подтвердите точный стандарт по размерам и давлению, требуемый вашим проектом.'
	},
	{
		question: 'Как проверить качество задвижки с сильфонным уплотнением перед заказом?',
		answer: 'Запросите протоколы испытаний корпуса и седла давлением для фактической партии, сертификаты на материалы корпуса и сильфона, а в коммерческом предложении подтвердите материал сильфона (304/316Ti) и стандарт сварки. По запросу возможна независимая инспекция перед отгрузкой.'
	}
];

// TOC: соответствует id H2 в тексте
const toc = [
	{ id: 'what-is-bellows-gate-valve', label: '1. Что такое задвижка с сильфонным уплотнением' },
	{ id: 'how-bellows-seal-works', label: '2. Как работает двойное уплотнение' },
	{ id: 'where-bellows-valves-are-specified', label: '3. Где специфицируются задвижки с сильфоном' },
	{ id: 'standards-and-pressure-classes', label: '4. Стандарты и классы давления' },
	{ id: 'bellows-vs-standard-gate-valve', label: '5. Сильфонная задвижка vs стандартная' },
	{ id: 'specification-checklist', label: '6. Чек-лист спецификации B2B' },
	{ id: 'faq', label: 'Часто задаваемые вопросы' }
];

// Связанные продукты (slug совпадает с products.ts)
const products = [
	{ slug: 'flange-manual-bellows-gate-valve', name: 'Фланцевая задвижка с сильфонным уплотнением (ручная)', img: '/assets/products/flange-manual-bellows-gate-valve.webp', desc: 'Кованая/литая сталь, DN15-DN300, Class 150/300' },
	{ slug: 'z85x-stainless-steel-grooved-gate-valve', name: 'Задвижка Z85X с канавчатым присоединением (нерж. сталь)', img: '/assets/products/z85x-stainless-steel-grooved-gate-valve.webp', desc: 'Литая задвижка из 316 (CF8M) для коррозионных сред' },
	{ slug: 'brass-gate-valve-z15w-16t', name: 'Фланцевая задвижка из латуни ANSI (Z15W-16T)', img: '/assets/products/brass-gate-valve-z15w-16t.webp', desc: 'Резьбовая задвижка NPT для нефтепродуктов и воды' }
];
---

<Layout
	title="Задвижки с сильфонным уплотнением: фланцевые ANSI для пара и масла"
	description="Задвижки с сильфонным уплотнением: принцип двойного уплотнения, стандарты ANSI/GB/DIN, размеры Ду15-Ду300, классы 150/300 и чек-лист спецификации B2B."
	type="article"
	locale="ru"
	faq={faq}
	breadcrumbs={[{ name: 'Руководства', href: '/ru/blog/' }, { name: 'Руководство по задвижкам с сильфонным уплотнением' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- хлебные крошки -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/blog/" class="hover:text-blue-600">Руководства</a>
			<span>/</span>
			<span class="text-gray-600">Руководство по задвижкам с сильфонным уплотнением</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Руководство по промышленной арматуре</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Руководство по задвижкам с сильфонным уплотнением: фланцевые типы ANSI для пара и термального масла</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Коротко: задвижка с сильфонным уплотнением — это задвижка, в которой за сальником шпинделя работает второй герметизирующий барьер — приварной металлический сильфон, — что обеспечивает нулевую утечку по шпинделю. Это именно тот тип, который следует специфицировать для термального масла, пара и высокотемпературной воды — и для любого режима, где утечка по шпинделю недопустима. В руководстве рассмотрено устройство, область применения и правила спецификации.</p>

			<TableOfContents headings={toc} />

			<!-- продуктовая полоса -->
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- раздел 1 -->
			<h2 id="what-is-bellows-gate-valve" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Что такое задвижка с сильфонным уплотнением</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Задвижка с сильфонным уплотнением — задвижка с выдвижным шпинделем, в которой шпиндель полностью заключён в приварной металлический сильфон. Сильфон расширяется и сжимается вместе с перемещением шпинделя, полностью отделяя его от рабочей среды, — а традиционная сальниковая набивка сверху служит вторым рубежом защиты. Результат — система двойного уплотнения: даже если сильфон подвергнется усталостному повреждению, сальник продолжит предотвращать утечку в атмосферу.</p>
			<p class="text-gray-700 leading-relaxed">Именно эта конструкция делает задвижку с сильфоном стандартным ответом на запросы <a href="/ru/products/flange-manual-bellows-gate-valve/" class="text-brand-blue font-semibold hover:underline">фланцевых задвижек с сильфонным уплотнением и ручным управлением</a> для требовательных тепловых режимов.</p>

			<!-- раздел 2 -->
			<h2 id="how-bellows-seal-works" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Как работает двойное уплотнение</h2>
			<p class="text-gray-700 leading-relaxed mb-4">В стандартной задвижке единственный барьер между рабочей средой и атмосферой — сальник шпинделя. Сальник — это компрессионное уплотнение: оно работает, но со временем может деградировать, пересыхать или ослабевать, особенно при термических циклах. Сильфонное уплотнение устраняет проблему у источника: приварной металлический сильфон (как правило, из нержавеющей стали 304 или 316Ti) соединён со шпинделем и крышкой, так что рабочая среда физически не может достигать зоны сальника.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Сальник над сильфоном при этом сохраняется — он защищает внутреннюю полость крышки от пыли и служит резервом на случай повреждения сильфона. Сервисные бригады получают и раннее предупреждение: если сильфон выходит из строя, клапан начинает подкапывать у сальника, а не отказывает без предупреждения.</p>
			<p class="text-gray-700 leading-relaxed">Поскольку сильфон — это сварной металлический компонент, именно его материал, качество сварки и ресурс циклов — реальные отличия качества между поставщиками. Стоит спрашивать об этом в каждом коммерческом предложении.</p>

			<!-- раздел 3 -->
			<h2 id="where-bellows-valves-are-specified" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Где специфицируются задвижки с сильфоном</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Классический режим для задвижки с сильфонным уплотнением — <strong>термальное масло и пар</strong>. Системы теплоносителя работают горячо (до 425°C в нашем стандартном диапазоне) и в условиях повторяющихся термических циклов; подтекающая сальниковая набивка означает потери тепла, грязное оборудование и опасность. Системы высокотемпературной воды имеют ту же проблему в иной форме.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Помимо тепловых режимов, задвижки с сильфоном специфицируются там, где <strong>необходимо контролировать утечки</strong> — токсичные, горючие или пахучие среды, а также предприятия, подчинённые экологическому регулированию. Приварной сильфон выступает эффективным барьером против утечек, особенно в применениях с большими термическими расширениями и сжатиями.</p>
			<p class="text-gray-700 leading-relaxed">Коротко: если линия проносит что-то горячее, опасное или и то и другое, — стоит проверить, не следует ли в спецификации заменить стандартную задвижку с одним сальником на задвижку с сильфонным уплотнением.</p>

			<!-- раздел 4 -->
			<h2 id="standards-and-pressure-classes" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Стандарты и классы давления</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Задвижки с сильфонным уплотнением изготавливаются по тем же размерным и конструктивным основам, что и другие стальные задвижки. Задвижки Wanlian с сильфонным уплотнением соответствуют стандартам GB, ANSI, DIN и JIS, а номинальные давления указываются как в метрических величинах (1,6–4,0 МПа), так и в ANSI Class (Class 150/300).</p>
			<p class="text-gray-700 leading-relaxed mb-4">Для фланцевых стальных задвижек в международных проектах действуют семейства стандартов ASME/ANSI: ASME B16.34 регулирует давление-температурные характеристики фланцевых клапанов, а серия API 600/603 покрывает конструкцию стальных и коррозионно-стойких задвижек. Если проект предъявляет особые требования к герметичности, клапаны обычно специфицируются под испытания на утечку, например по ISO 15848 или TA-Luft.</p>
			<p class="text-gray-700 leading-relaxed">Всегда подтвердите, какой стандарт действует в вашем проекте (GB, ANSI или DIN), до сравнения коммерческих предложений — межцентровые размеры и центровка фланцев могут отличаться.</p>

			<!-- раздел 5 -->
			<h2 id="bellows-vs-standard-gate-valve" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Сильфонная задвижка vs стандартная</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Сравнение</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Стандартная задвижка</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Задвижка с сильфонным уплотнением</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Герметизация шпинделя</td>
							<td class="px-4 py-3 text-gray-700">Только сальник</td>
							<td class="px-4 py-3 text-gray-700">Приварной металлический сильфон + сальник</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Утечка по шпинделю</td>
							<td class="px-4 py-3 text-gray-700">Зависит от состояния сальника</td>
							<td class="px-4 py-3 text-gray-700">Нулевая за счёт сильфона; сальник — резерв</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Устойчивость к термическим циклам</td>
							<td class="px-4 py-3 text-gray-700">Сальник может ослабевать по циклам</td>
							<td class="px-4 py-3 text-gray-700">Сильфон компенсирует движение шпинделя</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Типичный режим</td>
							<td class="px-4 py-3 text-gray-700">Вода, воздух, общие среды</td>
							<td class="px-4 py-3 text-gray-700">Пар, термальное масло, опасные среды</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Первоначальная стоимость</td>
							<td class="px-4 py-3 text-gray-700">Ниже</td>
							<td class="px-4 py-3 text-gray-700">Выше — оправдана герметичной эксплуатацией</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Для обычных водяных и воздушных линий стандартная задвижка остаётся экономичным выбором — о том, как задвижки применяются в пожарных и водяных магистралях, читайте в <a href="/ru/guides/gate-valve-vs-butterfly-valve-fire-protection/" class="text-brand-blue font-semibold hover:underline">сравнении задвижки и дискового затвора</a>, а шире о продукции — в <a href="/ru/tags/industrial-valves/" class="text-brand-blue font-semibold hover:underline">разделе промышленной арматуры</a>.</p>

			<!-- раздел 6 -->
			<h2 id="specification-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Чек-лист спецификации B2B</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Укажите среду и температуру</strong> — термальное масло, пар или высокотемпературная вода: укажите максимальную рабочую температуру, чтобы подтвердить материал сильфона и класс корпуса.</li>
				<li><strong>Зафиксируйте класс давления и стандарт</strong> — Class 150/300 (PN16-PN40) с расточкой фланцев по GB, ANSI или DIN; укажите, какой стандарт действует в проекте.</li>
				<li><strong>Специфицируйте материалы корпуса и сильфона</strong> — корпус из кованой стали A105 или литой стали WCB со сильфоном из нержавеющей стали 304/316Ti — стандартная исходная точка.</li>
				<li><strong>Уточните конструкцию сильфона</strong> — приварной сильфон, технология сварки и испытания на ресурс циклов, выполненные производителем.</li>
				<li><strong>Требуйте протоколы испытаний по партии</strong> — сертификаты на испытание корпуса и седла давлением для фактической партии, плюс сертификаты на материалы по запросу.</li>
				<li><strong>Сначала проверьте поставщика</strong> — качество сильфона не видно на фотографиях. Пройдитесь по нашему <a href="/ru/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">чек-листу закупки арматуры B2B</a> перед тем, как привязаться к производителю.</li>
			</ul>

			<!-- раздел FAQ -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Часто задаваемые вопросы</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- двойной CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Нужны задвижки с сильфонным уплотнением для тепловой или паровой линии?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Сообщите среду, температуру, DN и стандарт фланцев — наши инженеры подтвердят конструкцию сильфона и пришлют коммерческое предложение в течение 12 часов.</p>
