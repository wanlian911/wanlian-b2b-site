---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'Поставляет ли Wanlian противопожарную продукцию с сертификатом CE?',
		answer: 'Сертификация всегда зависит от конкретной модели и рынка назначения. Мы предоставляем сертификаты, декларации и протоколы испытаний по партии, действующие именно для заказанной вами модели и конфигурации клапана/рукава, и не заявляем сертификацию «для всей серии» целиком. Сообщите продукт и страну назначения — мы подтвердим применимый пакет документации до начала производства.'
	},
	{
		question: 'Что такое EN 12845 и как он связан с вашей продукцией?',
		answer: 'EN 12845 — европейский стандарт проектирования и монтажа стационарных спринклерных систем пожаротушения. Он задаёт требования ко всей схеме водоснабжения, включая предотвращение образования вихря на всасе насоса. Наш гаситель вихря на всасе насоса производится по EN 12845 и GB50974-2014: он устанавливается на всасе насоса внутри резервуара, останавливает захват воздуха и кавитацию и позволяет безопасно опускать уровень воды в резервуаре до очень низких значений.'
	},
	{
		question: 'В чём разница между ISO 7165, маркировкой CE и CCCF на огнетушителе?',
		answer: 'ISO 7165 — международный стандарт характеристик переносных огнетушителей, охватывающий конструкцию, испытания и маркировку. Маркировка CE — знак соответствия ЕС для продукции, поставляемой на европейский рынок; его требования зависят от применимых для данного продукта директив. CCCF — обязательная сертификация Китая для противопожарной продукции, действительная только для рынка КНР; это не экспортный сертификат. Всегда запрашивайте сертификат, действующий для вашего рынка назначения и конкретной модели.'
	},
	{
		question: 'Какие стандарты соединительных головок и присоединений используются в европейских противопожарных системах?',
		answer: 'Быстродействующие головки Storz — самая распространённая система в Европе и значительной части Азии; немецкие выходные штуцеры KWS встречаются на гидрантах и стояках, рынок Великобритании и Содружества использует резьбы BS336. Наша алюминиевая головка Storz 2,5" (DN50–DN150, 1,6 МПа) покрывает немецкую стандартную семью присоединений, а наружные гидранты, такие как SSFT100, поставляются с выходами KWS65. Укажите в запросе систему резьб, принятую на вашем рынке, чтобы присоединения рукавов, гидрантов и стволов совпадали.'
	},
	{
		question: 'Можно ли получить протоколы испытаний клапанов по EN 12266-1 по партии?',
		answer: 'Да. Клапаны нашего ассортимента испытываются на давление корпуса и седла по GB/T13927 или EN 12266-1 по запросу, гидранты испытываются гидростатически (типовое значение 2,4 МПа) с испытаниями расхода по применимому стандарту. Просите протокол, охватывающий фактический производственный выпуск, а не общий шаблон.'
	},
	{
		question: 'Можно ли оформить продукцию с маркировкой и документацией для конкретных стран ЕС?',
		answer: 'Да. Язык надписей, пиктограммы, язык инструкций и сопроводительная документация могут быть адаптированы под страну назначения в рамках OEM. Поскольку повторная маркировка после прибытия обходится дорого, подтвердите язык маркировки и формат документации до серийного производства.'
	}
];

const toc = [
	{ id: 'european-market', label: '1. Почему европейское соответствие важно для противопожарного оборудования' },
	{ id: 'ce-marking-basics', label: '2. Основы маркировки CE: уровень модели, никогда не уровня серии' },
	{ id: 'en12845-pump-suction', label: '3. EN 12845 и пакет всаса пожарного насоса' },
	{ id: 'testing-standards', label: '4. Доказательства испытаний: EN 12266-1 и протоколы по партиям' },
	{ id: 'connections-regional', label: '5. Головки, интерфейсы и переносное оборудование' },
	{ id: 'european-checklist', label: '6. Чек-лист спецификации для европейских покупателей' },
	{ id: 'faq', label: 'Часто задаваемые вопросы' }
];

const products = [
	{ slug: 'suction-vortex-preventer-en12845', name: 'Гаситель вихря на всасе насоса (EN12845)', img: '/assets/products/suction-vortex-preventer-en12845.webp', desc: 'SS304/316, DN50–DN1000, EN12845 и GB50974-2014' },
	{ slug: 'storz-coupling-2-5inch-aluminum', name: 'Алюминиевая головка Storz 2,5"', img: '/assets/products/storz-coupling-2-5inch-aluminum.webp', desc: 'Быстродействующее присоединение по немецкому стандарту, DN50–DN150, 1,6 МПа' },
	{ slug: 'abc-dry-powder-fire-extinguisher-5kg', name: 'Огнетушитель порошковый ABC (5 кг)', img: '/assets/products/abc-dry-powder-fire-extinguisher-5kg.webp', desc: 'Переносной огнетушитель ISO 7165 для пожаров классов A/B/C/E' },
	{ slug: 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100', name: 'Антивандальный наружный гидрант (SSFT100)', img: '/assets/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100.webp', desc: 'Регулирующий давление, выходы KWS65, ВЧШГ PN16' }
];
---

<Layout
	title="CE и EN 12845: соответствие для противопожарного экспорта"
	description="EN 12845 и маркировка CE для противопожарного экспорта: гаситель вихря на всасе насоса, испытания клапанов EN 12266-1, головки Storz, огнетушители ISO 7165."
	type="article"
	locale="ru"
	faq={faq}
	breadcrumbs={[{ name: 'Руководства', href: '/ru/blog/' }, { name: 'CE и EN 12845: соответствие' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/blog/" class="hover:text-blue-600">Руководства</a>
			<span>/</span>
			<span class="text-gray-600">CE и EN 12845: соответствие</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Руководство по сертификации</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Руководство по соответствию CE и EN 12845: противопожарное оборудование для европейского рынка</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Поставка противопожарного оборудования в Европу — прежде всего документальная работа, а не продуктовая. EN 12845 определяет, как должны быть построены спринклерные водоснабжения, EN 12266-1 — как испытываются клапаны, ISO 7165 — характеристики переносных огнетушителей, а маркировка CE (когда она применима) должна прослеживаться до конкретной модели, никогда не до всей серии. Это руководство разъясняет рамки и доказательства, которые европейский покупатель должен требовать от китайского поставщика.</p>

			<TableOfContents headings={toc} />

			<!-- Product strip -->
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 id="european-market" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Почему европейское соответствие важно для противопожарного оборудования</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Европа — не ниша для поставщиков противопожарной защиты. В выборке покупателей промышленной платформы, на которой основан рыночный анализ этого руководства (август 2026), Европа была крупнейшим покупательским регионом в категории противопожарной защиты — 20,05%, а Европа и Юго-Восточная Азия вместе — около 39%. В той же выборке CE была самым распространённым сертификационным атрибутом в карточках огнетушителей (42,35%), что показывает: европейские покупатели сначала фильтруют по задокументированному соответствию, и лишь затем — по цене.</p>
			<p class="text-gray-700 leading-relaxed">Что на самом деле проверяют европейские инженерные покупатели — это бумажный след: по какому стандарту изготовлен продукт, по какому стандарту испытаний испытана партия, какой сертификат покрывает конкретную модель и к какой системе головок и резьб подключается оборудование. Всё, что изложено ниже, отвечает на один из этих четырёх вопросов.</p>

			<h2 id="ce-marking-basics" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Основы маркировки CE: уровень модели, никогда не уровня серии</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Маркировка CE — знак соответствия для продукции, поставляемой на европейский рынок. Его правовая основа различается по продуктам — применимые директивы и гармонизированные стандарты зависят от того, что это за продукт, — и именно поэтому ответственный поставщик никогда не даёт обобщающих заявлений.</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Маркировка принадлежит модели</strong> — CE и сопутствующая декларация соответствия покрывают определённый продукт с определёнными характеристиками. Если меняется размер клапана, материал или конфигурация — меняется и оценка соответствия.</li>
				<li><strong>Отклоняйте заявления на уровне серии</strong> — сертификат, называющий бренд или весь модельный ряд без идентификаторов моделей, — красный флаг в европейских закупках. Требуйте документ, в котором названы точная модель и спецификация, которую вы приобретаете.</li>
				<li><strong>Ожидайте техническую документацию</strong> — производитель должен уметь предъявить протоколы испытаний и техническую документацию, лежащие в основе декларации. Наша страница «<a href="/ru/certificates/" class="text-brand-blue font-semibold hover:underline">сертификаты и соответствие</a>» объясняет, как эта документация ведётся для нашей противопожарной линейки.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Если на вопрос «есть ли сертификат CE?» в коммерческом предложении отвечает «да, вся серия», правильный следующий вопрос: какая директива, какой стандарт, какая модель и можно ли увидеть декларацию соответствия?</p>

			<h2 id="en12845-pump-suction" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. EN 12845 и пакет всаса пожарного насоса</h2>
			<p class="text-gray-700 leading-relaxed mb-4">EN 12845 — европейский стандарт стационарных спринклерных систем пожаротушения — проектирование и монтаж. Он управляет всей цепочкой водоснабжения: резервуары хранения, всас насосов, насосы, клапаны и распределение. Одно из его повторяющихся требований — всас насосов, забирающих воду из резервуаров, должен предотвращать образование вихря, поскольку вихрь затягивает в насос воздух, вызывает кавитацию и может лишить спринклерную систему полного потока ровно тогда, когда он нужен.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Именно для этого в нашей линейке предназначен <a href="/ru/products/suction-vortex-preventer-en12845/" class="text-brand-blue font-semibold hover:underline">гаситель вихря на всасе насоса</a>: панельная сборка из аустенитной нержавеющей стали (SS304/316), устанавливаемая на всасе насоса внутри резервуара, производится по EN 12845 и GB50974-2014, от DN50 до DN1000. Он устраняет вихрь, позволяет опускать уровень воды в резервуаре до очень низких значений (около 100 мм) и не содержит движущихся частей, требующих обслуживания.</p>
			<p class="text-gray-700 leading-relaxed">Остальное оборудование всаса и нагнетания следует той же логике: задвижки или дисковые затворы для отсечки, обратные клапаны на нагнетании насоса, сигнальные клапаны на стояке. Полную картину компонентов спринклерной схемы в духе EN 12845 смотрите в нашем <a href="/ru/guides/fire-sprinkler-system-valves-guide/" class="text-brand-blue font-semibold hover:underline">руководстве по клапанам спринклерных систем пожаротушения</a>.</p>

			<h2 id="testing-standards" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Доказательства испытаний: EN 12266-1 и протоколы по партиям</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Европейские покупатели редко принимают обобщённое заявление «испытано по стандарту»; они хотят, чтобы был назван стандарт испытаний и идентифицирована партия. Устойчивые правила испытаний на нашем производстве:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Клапаны</strong> — 100% испытание давлением корпуса и седла по GB/T13927 или <strong>EN 12266-1</strong> (европейский стандарт испытаний промышленной арматуры) по запросу.</li>
				<li><strong>Гидранты</strong> — гидростатическое испытание давлением (типовое значение 2,4 МПа) и испытание расхода по GB 4452 или применимому экспортному стандарту.</li>
				<li><strong>Огнетушители</strong> — характеристики, конструкция и маркировка по ISO 7165, с маркировкой модели на баллоне.</li>
				<li><strong>Доказательство по партии</strong> — протоколы испытаний должны охватывать фактический производственный выпуск, который вы получаете, а не шаблон с другой модели или другого производственного цикла.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Укажите стандарт испытаний в запросе и в заказе. Поставщик, который фиксирует стандарт письменно, — поставщик, который способен предоставить протокол.</p>

			<h2 id="connections-regional" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Головки, интерфейсы и переносное оборудование</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Соответствие не ограничивается сертификатами — присоединения и переносное оборудование имеют собственные региональные правила. В Европе и значительной части Азии доминирующей системой пожарных рукавов являются <strong>быстродействующие головки Storz</strong>. Наша <a href="/ru/products/storz-coupling-2-5inch-aluminum/" class="text-brand-blue font-semibold hover:underline">алюминиевая головка Storz 2,5"</a> изготовлена по немецкому стандарту с самозапирающимся уплотнением, рассчитана на 1,6 МПа и подходит для чистой воды и пенной смеси. Рынки Великобритании и Содружества используют резьбы BS336, а немецкие выходные штуцеры KWS встречаются на гидрантах и стояках — наш <a href="/ru/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100/" class="text-brand-blue font-semibold hover:underline">антивандальный наружный гидрант SSFT100</a> поставляется по стандарту с 2 выходами KWS65 плюс выход DN100.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Для переносных огнетушителей, направляемых в Европу, чётко определите границы сертификата: наш <a href="/ru/products/abc-dry-powder-fire-extinguisher-5kg/" class="text-brand-blue font-semibold hover:underline">5-килограммовый порошковый огнетушитель ABC</a> произведён по ISO 7165 и имеет CCCF. ISO 7165 покрывает международные характеристики переносных огнетушителей; маркировка CE для рынка ЕС зависит от применимых к модели директив; CCCF — специфичен для Китая и не переносится на европейские продажи. Язык маркировки, пиктограммы и язык инструкций следует подтвердить для страны назначения до производства.</p>
			<p class="text-gray-700 leading-relaxed">Вывод для покупателя: называйте систему головок и стандарт огнетушителей в той же фразе, что и запрос на сертификат — в спецификации они идут вместе.</p>

			<h2 id="european-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Чек-лист спецификации для европейских покупателей</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Назовите стандарт компонента</strong> — EN 12845 для схемы спринклерного водоснабжения, EN 12266-1 для испытаний клапанов, ISO 7165 для переносных огнетушителей, плюс применимые стандарты для гидрантов и головок.</li>
				<li><strong>Требуйте сертификаты на уровне модели</strong> — декларация соответствия CE (где применима) и сертификат, называющий точную модель, размер и конфигурацию вашего заказа.</li>
				<li><strong>Подтвердите систему интерфейсов</strong> — Storz, BS336, KWS или другие резьбы для присоединений рукавов, гидрантов и стволов; зафиксируйте письменно.</li>
				<li><strong>Зафиксируйте язык документации</strong> — язык маркировки и инструкций для страны назначения в рамках OEM.</li>
				<li><strong>Запросите протоколы испытаний по партиям</strong> — записи испытаний того производственного выпуска, который вы фактически получаете, а не общий файл.</li>
				<li><strong>Объедините документальный след</strong> — заказ клапанов, гидрантов и огнетушителей у одного производителя держит сертификаты и логистику в одном файле. Пройдите наш <a href="/ru/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">чек-лист B2B-закупки арматуры</a> перед тем, как определиться с поставщиком.</li>
			</ul>

			<!-- FAQ Section -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Часто задаваемые вопросы</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
