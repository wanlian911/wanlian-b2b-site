---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'В чём разница между NFPA 13, 14, 20 и 25?',
		answer: 'NFPA 13 регулирует проектирование и монтаж спринклерных систем, NFPA 14 — пожарные стояки и рукавные системы, NFPA 20 — стационарные пожарные насосы, NFPA 25 — осмотр, испытания и обслуживание систем противопожарного водоснабжения. Принятая редакция и местный норматив определяют, как именно каждый документ применяется на конкретном объекте.'
	},
	{
		question: 'Распространяется ли NFPA 24 на любой пожарный гидрант?',
		answer: 'NFPA 24 регулирует собственные (частные) противопожарные водоводы и их арматуру, включая подающую трубу и схемы частных гидрантов в границах действия документа. Муниципальный гидрант сети питьевого водоснабжения или элемент со стороны здания также может подпадать под местные требования. Границу применения согласуйте с проектировщиком и надзорным органом.'
	},
	{
		question: 'NFPA 25 подсказывает, как спроектировать новую спринклерную систему?',
		answer: 'Нет. NFPA 25 — документ по осмотру, испытаниям и обслуживанию систем противопожарного водоснабжения. Он поддерживает готовность системы после монтажа и не заменяет требования по проектированию и монтажу, которые применяются к новой системе.'
	},
	{
		question: 'Как EN 12845 соотносится с документами NFPA?',
		answer: 'EN 12845 — самостоятельная европейская рамка проектирования и монтажа спринклерных систем. В ней могут отличаться терминология, допущения и документы приёмки. Проект должен определить одну руководящую базу проектирования, а затем уточнить местные поправки, требования страховой компании и надзорного органа, вместо того чтобы смешивать пункты из разных нормативных режимов.'
	},
	{
		question: 'Можно ли автоматически принять изделие, на котором указано NFPA?',
		answer: 'Нет. Описание изделия не является согласованием для любого проекта. Закупщик должен сверить конкретную модель, размер, присоединение, класс давления, требование листинга или сертификата и условие работы с принятой спецификацией. О приёмке решает надзорный орган.'
	},
	{
		question: 'Что поставщик должен задокументировать для проекта по NFPA?',
		answer: 'Запрашивайте паспорт именно той модели, габаритные чертежи, материалы, данные по давлению, присоединения, инструкции по монтажу и обслуживанию, протоколы испытаний и требуемый проектом листинг третьей стороны или сертификат. Требуйте документы, в которых указано поставляемое изделие, а не семейство продукции вообще.'
	}
];

const toc = [
	{ id: 'standard-set-purchases', label: '1. Почему набор стандартов решает, что вы покупаете' },
	{ id: 'six-documents-scope', label: '2. Шесть документов и что регулирует каждый' },
	{ id: 'project-interaction', label: '3. Как документы взаимодействуют в одном проекте' },
	{ id: 'nfpa-en-gb-local', label: '4. NFPA, EN 12845, GB и местное принятие' },
	{ id: 'supplier-documentation', label: '5. Что обязан задокументировать поставщик' },
	{ id: 'read-spec-package', label: '6. Как читать комплект спецификации' },
	{ id: 'faq', label: 'Часто задаваемые вопросы' }
];

const products = [
	{ slug: 'wet-alarm-check-valve-zsfz-150', name: 'Сигнальный обратный клапан ZSFZ-150', img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp', desc: 'Сигнальный клапан мокрой системы с камерой задержки и прессостатом' },
	{ slug: 'ul-fm-resilient-seat-osy-gate-valve', name: 'Задвижка OS&Y с упругим уплотнением UL/FM', img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp', desc: 'Задвижка groove OS&Y с видимым выдвижением шпинделя' },
	{ slug: 'overground-fire-hydrant-ss100', name: 'Надземный пожарный гидрант SS100/65', img: '/assets/products/overground-fire-hydrant-ssf100-65-1-6.webp', desc: 'Надземный гидрант из высокопрочного чугуна для сети противопожарной воды' },
	{ slug: 'sqd100-1-6-fire-pump-adapter', name: 'Адаптер пожарного насоса SQD100-1.6', img: '/assets/products/sqd100-1-6-fire-pump-adapter.webp', desc: 'Два входа DN65 и фланцевый выход DN100' }
];
---

<Layout
	title="Стандарты NFPA 13, 14, 20, 25: руководство для закупщика"
	description="Карта для закупщика по NFPA 13, 14, 20, 24 и 25: что регулирует каждый документ, как соотносить его с EN 12845 и GB и что требовать от поставщика."
	type="article"
	locale="ru"
	faq={faq}
	breadcrumbs={[{ name: 'Руководства', href: '/ru/blog/' }, { name: 'Руководство по стандартам NFPA' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/blog/" class="hover:text-blue-600">Руководства</a>
			<span>/</span>
			<span class="text-gray-600">Руководство по стандартам NFPA</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Руководство по стандартам пожарозащиты</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">NFPA 13 против 14 против 20 против 25: руководство закупщика</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Коротко: документы NFPA выполняют разную работу. NFPA 13 — это база проектирования и монтажа спринклерных систем; NFPA 14 покрывает пожарные стояки и рукавные системы; NFPA 20 — стационарные пожарные насосы; NFPA 24 — собственные противопожарные водоводы; NFPA 25 — осмотр, испытания и обслуживание. Берите редакцию, принятую надзорным органом, и согласовывайте её с местными нормами, требованиями EN 12845 или GB.</p>

			<TableOfContents headings={toc} />

			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 id="standard-set-purchases" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Почему набор стандартов решает, что вы покупаете</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Комплект противопожарного водоснабжения не покупают по одному универсальному перечню. Руководящий документ определяет, какая граница системы проектируется, какие компоненты нужно согласовать и какие документы обязан поставить поставщик. Спринклерный стояк, пожарный стояк, насосная и собственный водовод могут находиться на одном объекте при этом регулироваться разными частями набора стандартов.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Для инженера по закупкам первый вопрос не «какой клапан дешевле», а «какая база проектирования и какое решение о принятии отражены в спецификации». <a href="/ru/products/wet-alarm-check-valve-zsfz-150/" class="text-brand-blue font-semibold hover:underline">Сигнальный обратный клапан ZSFZ</a> может относиться к мокрому спринклерному стояку, а <a href="/ru/products/ul-fm-resilient-seat-osy-gate-valve/" class="text-brand-blue font-semibold hover:underline">задвижка OS&amp;Y</a> применяться для контролируемого отсечения. Их приём зависит от чертежа системы и требований проекта, а не от одного названия изделия.</p>
			<p class="text-gray-700 leading-relaxed">Поэтому коммерческое предложение с формулировкой «соответствует NFPA» неполно. Закупщику нужны область документа, принятая редакция, местные поправки, статус рассмотрения надзорным органом, конкретная модель и требуемые подтверждения. <a href="/ru/guides/fire-sprinkler-control-valve-types/" class="text-brand-blue font-semibold hover:underline">Руководство по типам управляющих клапанов спринклерных систем</a> полезно для различения железа, но контролирующим источником остаётся комплект спецификации проекта.</p>

			<h2 id="six-documents-scope" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Шесть документов и что регулирует каждый</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Ядро решений о закупке — карта областей применения простым языком. NFPA 13, 14, 20, 24 и 25 — это пять документов NFPA; шестая строка ниже — EN 12845, включена потому, что зарубежные проекты часто с ней сверяются. Они связаны, но не взаимозаменяемы.</p>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Документ</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Область простыми словами</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Влияние на закупку</th></tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">NFPA 13</td><td class="px-4 py-3 text-gray-700">Проектирование и монтаж спринклерных систем</td><td class="px-4 py-3 text-gray-700">Оросители, узлы стояков, клапаны, трубопроводы и интерфейсы системы должны соответствовать утверждённому спринклерному проекту</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">NFPA 14</td><td class="px-4 py-3 text-gray-700">Пожарные стояки и рукавные системы</td><td class="px-4 py-3 text-gray-700">Клапаны стояков, рукавные соединения, шкафы, схемы давления и связанные присоединения подачи</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">NFPA 20</td><td class="px-4 py-3 text-gray-700">Стационарные пожарные насосы</td><td class="px-4 py-3 text-gray-700">Оборудование насосной, присоединения подачи, приводы, шкафы управления и связанные документы приёмки</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">NFPA 24</td><td class="px-4 py-3 text-gray-700">Собственные противопожарные водоводы и их арматура</td><td class="px-4 py-3 text-gray-700">Частные подземные или площадочные сети противопожарной воды, клапаны, гидранты и присоединения в границах проекта</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">NFPA 25</td><td class="px-4 py-3 text-gray-700">Осмотр, испытания и обслуживание систем водяного пожаротушения</td><td class="px-4 py-3 text-gray-700">Доступ, соединения для испытаний, записи, периодические проверки и ремонтопригодность после передачи</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">EN 12845</td><td class="px-4 py-3 text-gray-700">Самостоятельная европейская рамка проектирования и монтажа автоматических спринклерных систем</td><td class="px-4 py-3 text-gray-700">Терминология, расчёты, компоненты и приёмка европейского проекта должны сверяться с его принятой базой</td></tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Таблица — это карта, а не замена чтению проектной спецификации. Она намеренно не содержит номеров разделов и числовых требований, привязанных к редакции. Там, где важна цифра или пункт, берите редакцию, принятую надзорным органом.</p>

			<h2 id="project-interaction" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Как документы взаимодействуют в одном проекте</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Рассмотрите склад со спринклерами, внутренним пожарным стояком, насосной и собственным площадным водоводом. NFPA 13 даёт базу проектирования и монтажа спринклеров. NFPA 14 относится к стояку и рукавной системе. NFPA 20 — к стационарному пожарному насосу, питающему системы водяного пожаротушения. NFPA 24 применяется к собственному противопожарному водоводу и гидрантам, через которые подключается площадной источник. NFPA 25 после монтажа регулирует программу осмотра, испытаний и обслуживания.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Границы должны быть согласованы. Насос, выбранный без учёта потребности спринклеров и стояка, может оказаться не тем насосом для проекта. Собственный водовод с неподходящим клапаном или присоединением гидранта способен помешать пожарным использовать подачу. Стояк, спроектированный без доступных контрольных точек, может быть трудно проверить, даже если монтаж выглядит завершённым.</p>
			<p class="text-gray-700 leading-relaxed">Поэтому спецификация оборудования должна указывать, куда относится каждая позиция и какой документ или утверждённый чертёж её регулирует. <a href="/ru/products/overground-fire-hydrant-ss100/" class="text-brand-blue font-semibold hover:underline">Надземный пожарный гидрант SS100/65</a> — элемент площадки наружной сети, а <a href="/ru/products/sqd100-1-6-fire-pump-adapter/" class="text-brand-blue font-semibold hover:underline">адаптер пожарного насоса SQD100-1.6</a> — присоединение подачи с двумя входами DN65, фланцевым выходом DN100 и давлением 1,6 МПа по файлу изделия. Его роль подтверждайте по чертежам проекта, а не назначайте стандарту по названию.</p>

			<h2 id="nfpa-en-gb-local" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">4. NFPA, EN 12845, GB и местное принятие</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Документы NFPA, EN 12845 и GB — разные нормативные семейства. Они могут рассматривать похожее оборудование, но похожий предмет не делает их требования взаимозаменяемыми. Терминология, допущения проектирования, документы приёмки и подтверждения по изделию могут различаться.</p>
			<p class="text-gray-700 leading-relaxed mb-4">В международном тендере сначала определите руководящее семейство, а затем орган, который его принимает или изменяет. В США и других рынках влияния NFPA надзорный орган может применять принятую редакцию вместе с местными строительными и пожарными нормами. В Европе EN 12845 может применяться наряду с национальными правилами, требованиями страховой и проектными согласованиями. В Китае применимую базу могут определять требования GB и местная приёмка пожарного надзора. Правильный ответ зависит от проекта.</p>
			<p class="text-gray-700 leading-relaxed">Не соединяйте требование проектирования NFPA с допущением приёмки EN только потому, что у клапана подходящий условный размер. Если тендер допускает альтернативы, попросите консультанта указать метод эквивалентности и документальное подтверждение. Наше <a href="/ru/guides/ce-en12845-fire-protection-compliance/" class="text-brand-blue font-semibold hover:underline">руководство по соответствию CE и EN 12845</a> покрывает европейскую сторону; <a href="/ru/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">руководство по стандартам гидрантов и клапанов</a> даёт более широкий контекст по присоединениям и стандартам.</p>

			<h2 id="supplier-documentation" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Что обязан задокументировать поставщик</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Добросовестный поставщик должен уметь назвать именно то изделие, которое предлагает, и связать его с условием работы из спецификации. Запрашивайте паспорт, габаритный чертёж, материалы, тип присоединения, данные по давлению, указания по эксплуатации и обслуживанию. Для изделия с листингом или сертификацией запрашивайте область именно этой модели и действующие доказательства листинга или сертификат, требуемые проектом.</p>
			<ul class="list-disc pl-6 space-y-2 text-gray-700 leading-relaxed mb-4">
				<li><strong>Идентичность:</strong> производитель, модель, размер, присоединение, ревизия и прослезируемая маркировка изделия.</li>
				<li><strong>Конструкция:</strong> корпус, внутренние детали, уплотнения, покрытия и любые заявления по материалам, важные для тендера.</li>
				<li><strong>Показатели:</strong> опубликованные давление, температура, расход или рабочие данные, относящиеся именно к этой модели.</li>
				<li><strong>Доказательства:</strong> протоколы заводских испытаний, записи контроля, листинг третьей стороны или сертификаты, когда это требуется.</li>
				<li><strong>Жизненный цикл:</strong> сведения по монтажу, испытаниям, обслуживанию, запчастям и замене, которые нужны владельцу.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed"><a href="/ru/guides/how-to-choose-ul-listed-fire-valves/" class="text-brand-blue font-semibold hover:underline">Руководство по выбору пожарных клапанов с листингом UL</a> объясняет, почему одного логотипа недостаточно. Для контролей закупки клапанов и пожарного оборудования используйте <a href="/ru/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">чек-лист закупки клапанов B2B</a> и требуйте от поставщика письменного ответа по каждой строке.</p>

			<h2 id="read-spec-package" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">6. Как читать комплект спецификации</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Начинайте с примечаний по нормам и согласованиям, а не с ведомости оборудования. Отметьте надзорный орган, принятую им редакцию, местные поправки, требования страховой и любые утверждённые альтернативные базы. После этого проследите каждую позицию оборудования к плану, схеме стояка, гидравлическому расчёту, спецификации насоса и требованию пусконаладки.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Дальше отделите обязательные требования от предпочтительных описаний. «OS&amp;Y» может описывать привод и видимое положение клапана; «UL/FM» может быть требованием листинга; «groove» может описывать присоединение. На каждое такое утверждение нужно ответить конкретной предложенной моделью и доказательствами. Если в строке написано «соответствует NFPA» без указания условия работы, запрашивайте уточнение до сравнения цен.</p>
			<p class="text-gray-700 leading-relaxed">И наконец, формируйте перечень передаваемой документации ещё на этапе закупки: утверждённые чертежи, протоколы испытаний, сертификаты, данные по эксплуатации и обслуживанию, рекомендации по запчастям, адресные таблички и обязанности по обучению персонала. Так взгляд на обслуживание из NFPA 25 влияет на закупку: доступность, возможность испытаний и записи нужно закладывать в комплект, а не обнаруживать после передачи.</p>
			<p class="text-gray-700 leading-relaxed">При зарубежной закупке просите поставщика держать ссылку на проект на каждом чертеже и протоколе испытаний. Каталожное семейство может включать несколько размеров или исполнений присоединений, а сертификат, в котором указано только семейство, трудно сопоставить при приёмке. Конкретные модель, размер, присоединение и ревизия должны оставаться видимыми от коммерческого предложения до поставки.</p>
			<p class="text-gray-700 leading-relaxed">Дистрибьюторам стоит сохранять ту же прослеживаемость в досье перепродажи. Если подрядчик позже попросит замену клапана, гидранта или адаптера насоса, исходная база спецификации и утверждённая модель полезнее, чем общее обещание «подберём замену». Такая дисциплина защищает монтажника, надзорный орган и конечного владельца.</p>

