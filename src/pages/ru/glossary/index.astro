---
import Layout from '../../../layouts/Layout.astro';
import { glossaryTerms, GLOSSARY_CATEGORIES, type GlossaryTerm } from '../../../utils/glossary';

const categoryLabel: Record<GlossaryTerm['category'], string> = {
  'Valves': 'Клапаны',
  'Fire Hydrants': 'Пожарные гидранты',
  'Sprinklers': 'Спринклерные оросители',
  'Fire Hose': 'Пожарные рукава',
  'Certification & Standards': 'Сертификация и стандарты',
  'Testing & Procurement': 'Испытания и закупки'
};

const ruTerms: Record<string, { term: string; definition: string }> = {
  'resilient-seated-gate-valve': {
    term: 'Задвижка с эластичным седлом (RSGV)',
    definition:
      'Задвижка с эластичным седлом полного проходного сечения, клин которой заключён в гибкий эластомер (обычно EPDM), садящийся на металлический корпус; обеспечивает герметичное перекрытие без просачивания при низком моменте на маховике и без повторной набивки. RSGV — основной тип арматуры для перекрытия в водопроводах, канализации и пожарных магистралях; специфицируется по AWWA C515 (США), ISO 5208 и EN 1074.'
  },
  'awwa-c515': {
    term: 'AWWA C515',
    definition:
      'Стандарт Американской ассоциации водоснабжения (AWWA) на задвижки с эластичным седлом из высокопрочного чугуна. Определяет материалы, размеры, момент на маховике, требования к давлению и пропускной способности, а также обязательные испытания корпуса и седла задвижек для водоснабжения и водоотведения в спецификациях Северной Америки.'
  },
  'dry-barrel-fire-hydrant': {
    term: 'Пожарный гидрант сухотрубный',
    definition:
      'Подземный пожарный гидрант, остающийся пустым ниже уровня земли; колонка заполняется водой только при открытии устья, что в холодном климате не допускает попадания воды в колонку и её замерзания. Гидранты сухотрубного типа — стандарт для муниципальных сетей с защитой от промерзания; специфицируются по AWWA C502 (США) и EN 14384 (Европа).'
  },
  'awwa-c502': {
    term: 'AWWA C502',
    definition:
      'Стандарт AWWA на пожарные гидранты сухотрубного типа. Определяет конструкцию, материалы, рабочее давление (обычно 125–250 psi), пропускную способность и обязательные испытания на прочность и герметичность гидрантов, применяемых в муниципальных сетях водоснабжения и пожаротушения Северной Америки.'
  },
  'ul-listing': {
    term: 'Внесение в список UL',
    definition:
      'Сертификат безопасности, выдаваемый Underwriters Laboratories (UL) после испытаний изделия по конкретному стандарту и оценки производства. Клапан или ороситель, внесённый в список UL, допускается к применению в зданиях, где этого требует норматив или страховщик; включение в список распространяется на конкретное изделие и модель, а не на всю компанию.'
  },
  'fm-approval': {
    term: 'Одобрение FM',
    definition:
      'Одобрение FM Global, выдаваемое на основании испытаний на работоспособность и долговечность, выходящих за рамки минимальных требований норм. Одобрение FM часто требуется крупными страховыми компаниями и для промышленных проектов; как и UL, оно выдаётся на конкретное изделие и конкретную модель.'
  },
  'k-factor': {
    term: 'Коэффициент K (спринклерный)',
    definition:
      'Число, описывающее расход спринклерного оросителя при заданном давлении и выражаемое как коэффициент расхода. Расход (gpm) равен K, умноженному на квадратный корень из давления (psi); типовые значения — K=5.6, K=80 и K=115. Коэффициент K вместе с классом пожарной опасности по NFPA 13 определяет шаг установки и раскладку оросителей.'
  },
  'quick-response': {
    term: 'Быстрая и стандартная реакция',
    definition:
      'Классификация спринклерных оросителей по скорости срабатывания термочувствительного элемента. Оросители быстрой реакции (RTI < 51 °C·s^½) обнаруживают развивающийся пожар раньше и, как правило, обязательны в зонах повышенной опасности и помещениях с присутствием людей; оросители стандартной реакции подходят для большинства коммерческих систем с обычной пожарной нагрузкой.'
  },
  'preaction': {
    term: 'Система предварительного действия (преакшн)',
    definition:
      'Сухая спринклерная система, в которой трубопровод держится сухим и для подачи воды в трассу требуются два независимых сигнала — как правило, срабатывание пожарной сигнализации плюс отдельное срабатывание оросителя. Защищает помещения, где главный риск — повреждения водой при случайной утечке, например серверные и архивы.'
  },
  'deluge': {
    term: 'Система затопления (дренчерная)',
    definition:
      'Сухая система с открытыми оросителями, питаемая через дренчерный клапан, который открывается по сигналу устройств обнаружения, вследствие чего все открытые оросители сбрасывают воду одновременно. Дренчерные системы применяются для технологических процессов с высокими рисками и вспышками горения и комплектуются группой дренчерного сигнального клапана.'
  },
  'backflow-prevention': {
    term: 'Предотвращение обратного потока (двойная защита)',
    definition:
      'Устройства, устанавливаемые там, где питьевая вода может быть загрязнена обратным потоком из перекрёстного соединения. Самый распространённый тип — узел двойной защиты из двух независимых обратных клапанов с контрольным отводом; обязателен на рукавных присоединениях, в системах орошения и в большинстве промышленных перекрёстных соединений.'
  },
  'pressure-reducing-valve': {
    term: 'Клапан-регулятор давления (PRV)',
    definition:
      'Клапан, автоматически снижающий высокое давление на входе до заданного постоянного давления на выходе. Самодействующие гидравлические PRV (например, 500X) защищают пожарные магистрали и стояки зданий от повышенного давления и гидравлического удара, удерживая стабильную уставку на выходе.'
  },
  'osy': {
    term: 'OS&Y (выдвижной шпиндель с наружной резьбой)',
    definition:
      'Конструктивное исполнение крышки, при котором шпиндель выведен наружу из трубопровода, а коромысло поднимает шпиндель при открытии, делая положение затвора видимым. Задвижки OS&Y — классическая тяжёлая арматура для перекрытия в пожарных системах и магистралях; уплотнение шпинделя расположено вне зоны потока.'
  },
  'pn-ansi-flange': {
    term: 'Классы фланцев PN и ANSI',
    definition:
      'Две системы классов фланцев: PN (номинальное давление, метрическая система, например PN10/PN16) следует EN/DIN, а классы ANSI/ASME (Class 150/300) — США и большей части Америки. Плоскость фланца клапана должна соответствовать стандарту и классу системы — смешивание плоскостей PN и ANSI в одной трассе — типичная ошибка спецификации.'
  },
  'nps': {
    term: 'Номинальный диаметр (DN / NPS)',
    definition:
      'Обозначение диаметра, не равное физическому диаметру трубы. DN (номинальный диаметр) — метрическое обозначение (DN80, DN100); NPS (номинальный диаметр трубы) — обозначение США (3", 4"). Диаметры DN и NPS соотносятся при подборе, но габариты фланцев различаются в зависимости от стандарта.'
  },
  'fire-department-connection': {
    term: 'Пожарное присоединение (FDC / сямское)',
    definition:
      'Присоединение на здании или системе, позволяющее пожарной охране подавать воду через её рукава. Сямское (двойное) присоединение FDC обычно имеет два устья DN65 (2.5") и фланцевый выпуск DN100 и служит точкой подачи для дренчерных и спринклерных систем.'
  },
  'storz-coupling': {
    term: 'Соединительная головка Шторц',
    definition:
      'Универсальная пожарная головка штырькового типа под диаметр рукава (Storz 2, 3, 4, 5): устанавливается без инструмента и автоматически герметизируется поворотом. Является доминирующим международным стандартом соединительных головок наряду с NIST (США) и BS336 (Великобритания).'
  },
  'nfpa-1961': {
    term: 'NFPA 1961 (пожарные рукава)',
    definition:
      'Стандарт NFPA на пожарные рукава. Определяет конструкцию (оболочка, подкладка, головка), рабочее испытательное давление (обычно 150 или 250 psi) и обязательные заводские и периодические испытания. Соответствующий напорный рукав сочетает оболочку из высокопрочной ткани с вулканизированной резиновой подкладкой.'
  },
  'nfpa-13': {
    term: 'NFPA 13 (спринклерные системы)',
    definition:
      'Стандарт NFPA на монтаж автоматических спринклерных систем. Устанавливает классы пожарной опасности, правила шага установки оросителей и коэффициента K, требуемые трубопроводы и клапаны, а также типы систем (мокрые, сухие, дренчерные, предварительного действия) для коммерческих и промышленных зданий.'
  },
  'nom-mexico': {
    term: 'NOM / NR (Мексика)',
    definition:
      'Официальные мексиканские стандарты (NOM) и система NR (пожарной опасности) регулируют противопожарную продукцию на мексиканском рынке; сертификация проводится уполномоченными органами. Тендер в Мексике может требовать подтверждения соответствия NOM для гидрантов и противопожарного оборудования; соответствие подтверждается по каждой модели.'
  },
  'shell-pressure-test': {
    term: 'Испытание на прочность корпуса и герметичность воздухом',
    definition:
      'Два испытания каждой единицы арматуры или гидранта перед отгрузкой: гидростатическое испытание корпуса, проверяющее корпус на отсутствие утечек и деформаций при избыточном давлении, и испытание герметичности сжатым воздухом, подтверждающее полную герметичность клапана в рабочем положении. Записи по серийному номеру — главное доказательство подлинного производителя.'
  }
};

const grouped = GLOSSARY_CATEGORIES.map(cat => ({
  cat,
  label: categoryLabel[cat],
  terms: glossaryTerms.filter(t => t.category === cat)
})).filter(g => g.terms.length > 0);
---

<Layout
  title="Глоссарий арматуры и противопожарной техники | Wanlian Fluid"
  description="Определения ключевых терминов арматуры и противопожарной техники: RSGV, AWWA C502/C515, UL, FM, коэффициент K, прерывистое действие, обратный поток и Storz."
  type="website"
  locale="ru"
  breadcrumbs={[{ name: 'Глоссарий' }]}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
    <nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
      <a href="/ru/" class="hover:text-blue-600">Главная</a>
      <span>/</span>
      <span class="text-gray-600">Глоссарий</span>
    </nav>

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
      <p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Справочник</p>
      <h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Глоссарий арматуры и противопожарной техники</h1>
      <p class="mt-5 text-gray-600 leading-relaxed text-lg">Чёткие определения по стандартам терминов, встречающихся в спецификациях, тендерах и паспортах на арматуру, пожарные гидранты, спринклерные оросители и пожарные рукава. Используйте их как общее профессиональное словари при составлении спецификаций, чтении документации производителя и проверке соответствия — каждая запись ведёт к нашему подробному руководству по теме.</p>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-8">
        {grouped.map(g => (
          <a href={`#${g.cat.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="px-4 py-3 bg-gray-50 border border-gray-100 rounded-xl text-xs font-bold text-brand-blue hover:bg-brand-blue/10 transition text-center">{g.label}</a>
        ))}
      </div>

      {grouped.map(g => (
        <section class="mt-12">
          <h2 id={g.cat.toLowerCase().replace(/[^a-z0-9]+/g, '-')} class="text-2xl font-black text-gray-900 mb-5 tracking-tight scroll-mt-24">{g.label}</h2>
          <div class="space-y-4">
            {g.terms.map(t => (
              <div class="bg-gray-50 rounded-xl border border-gray-100 p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="text-lg font-black text-gray-900">{ruTerms[t.id]?.term ?? t.term}</h3>
                  <a href={`/ru${t.href}`} class="text-xs font-bold text-brand-red hover:underline">Читать руководство →</a>
                </div>
                <p class="mt-2 text-gray-700 leading-relaxed text-sm">{ruTerms[t.id]?.definition ?? t.definition}</p>
              </div>
            ))}
          </div>
        </section>
      ))}

      <div class="mt-12 rounded-2xl overflow-hidden">
        <div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
          <h2 class="text-2xl font-black text-white tracking-tight">Готовы специфицировать или заказывать эти компоненты?</h2>
          <p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Пришлите нам спецификацию, количество и место доставки — ответим детальным коммерческим предложением в течение 12 часов.</p>
          <div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
            <a href="/ru/contact/?product=%D0%93%D0%BB%D0%BE%D1%81%D1%81%D0%B0%D1%80%D0%B8%D0%B9%20%D0%B8%20%D1%81%D0%BF%D0%B5%D1%86%D0%B8%D1%84%D0%B8%D0%BA%D0%B0%D1%86%D0%B8%D1%8F" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Запросить цену</a>
            <a href="https://wa.me/8618684324501?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5%2C%20%D1%83%20%D0%BC%D0%B5%D0%BD%D1%8F%20%D0%B5%D1%81%D1%82%D1%8C%20%D1%81%D0%BF%D0%B5%D1%86%D0%B8%D1%84%D0%B8%D0%BA%D0%B0%D1%86%D0%B8%D1%8F%2C%20%D0%BF%D1%80%D0%B8%D1%88%D0%BB%D0%B8%D1%82%D0%B5%2C%20%D0%BF%D0%BE%D0%B6%D0%B0%D0%BB%D1%83%D0%B9%D1%81%D1%82%D0%B0%2C%20%D0%BA%D0%BE%D0%BC%D0%BC%D0%B5%D1%80%D1%87%D0%B5%D1%81%D0%BA%D0%BE%D0%B5%20%D0%BF%D1%80%D0%B5%D0%B4%D0%BB%D0%BE%D0%B6%D0%B5%D0%BD%D0%B8%D0%B5%20%D0%BF%D0%BE%20%D0%BA%D0%BB%D0%B0%D0%BF%D0%B0%D0%BD%D0%B0%D0%BC%20%2F%20%D0%B3%D0%B8%D0%B4%D1%80%D0%B0%D0%BD%D1%82%D0%B0%D0%BC" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Чат в WhatsApp</a>
          </div>
        </div>
      </div>
    </article>
  </main>
</Layout>
