---
import Layout from '../../layouts/Layout.astro';
import { productsRu as products } from '../../utils/products.ru';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';
import LeadCaptureSection from '../../components/inquiry/LeadCaptureSection.astro';

const ruFaq = [
  {
    question: 'Что производит и экспортирует Wanlian Fluid?',
    answer: 'Wanlian Fluid — производитель и экспортёр промышленной арматуры и противопожарного оборудования из Цюаньчжоу: задвижки с эластичным и металлическим уплотнением, поворотные и обратные клапаны, пожарные гидранты и комплектующие, спринклерные и сигнальные клапаны, пожарные рукава. 6 линеек, более 43 моделей на складе.'
  },
  {
    question: 'Как получить цену на задвижку или гидрант?',
    answer: 'Цены предоставляются по запросу. Отправьте спецификацию — модель, диаметр, класс давления, материал, количество и порт назначения — и наши инженеры в течение 12 часов пришлют детализированное коммерческое предложение с указанием наличия и сроков поставки.'
  },
  {
    question: 'Проходит ли каждое изделие испытания перед отгрузкой?',
    answer: 'Да. Каждая задвижка, гидрант и рукав перед упаковкой проходят испытание корпуса на прочность и герметичность, а также проверку на воздухонепроницаемость. Производство работает по системе менеджмента качества ISO 9001:2015.'
  },
  {
    question: 'Поддерживаете ли вы OEM и производство под нашим брендом?',
    answer: 'Да. OEM/ODM, индивидуальная упаковка и нанесение логотипа — стандартные услуги. Соответствие конкретным стандартам (AWWA C502, UL, FM) подтверждается протоколами испытаний и сертификатами по каждой модели.'
  }
];

// Category grid and the grouped catalog index are both derived from this locale's product
// module, so line names, counts and card photography cannot drift from the live catalog.
// is keyed by English category names, so it stays empty and each line uses its first photo.
const CATEGORY_LEAD: Record<string, string> = {};

const categoryNames: string[] = [...new Set(products.map(p => p.category))];

const categories = categoryNames.map(name => {
  const inCategory = products.filter(p => p.category === name);
  const lead = inCategory.find(p => p.slug === CATEGORY_LEAD[name]) ?? inCategory[0];
  return { name, count: inCategory.length, image: lead.image, leadName: lead.name, href: `/ru/products/#category=${encodeURIComponent(name)}` };
});

const catalogByCategory = categoryNames.map(name => ({
  name,
  href: `/ru/products/#category=${encodeURIComponent(name)}`,
  items: products.filter(p => p.category === name).map(p => ({ name: p.name, href: '/ru/products/' + p.slug + '/' }))
}));

const productionSteps = [{"step":"01","title":"Точное ткачество","desc":"Ткачество высокопрочной полиэстеровой основы для долговечных оболочек пожарных рукавов."},{"step":"02","title":"Нанесение покрытия","desc":"Современный процесс вулканизации для герметичного резинового покрытия."},{"step":"03","title":"Обработка на ЧПУ","desc":"Точная обработка корпусов и деталей клапанов из высокопрочного чугуна."},{"step":"04","title":"Испытания безопасности","desc":"100% испытание корпуса давлением и проверка на герметичность воздухом каждой единицы."},{"step":"05","title":"Эпоксидное покрытие","desc":"Безопасное эпоксидное покрытие для превосходной коррозионной стойкости."}];



// Own-name assurance only. Third-party listings belong to the factory that holds them, so this
// strip must never imply that Wanlian itself holds UL, FM, CE or LPCB listings.
const certifications = [{"name":"ТЕХНИЧЕСКИЕ ДАННЫЕ"},{"name":"ЧЕРТЁЖИ ПРОДУКЦИИ"},{"name":"МАТЕРИАЛЫ ИСПОЛНЕНИЯ"},{"name":"КЛАССЫ ДАВЛЕНИЯ"},{"name":"OEM / ODM"},{"name":"ПОДДЕРЖКА ЭКСПОРТА"}];

const waCallbackHref = `https://wa.me/8618684324501?text=${encodeURIComponent('Здравствуйте! Меня интересуют ваши клапаны и противопожарное оборудование.')}`;

const resources = [{"href":"/ru/guides/how-to-choose-a-fire-hydrant/","eyebrow":"Гид по выбору","title":"Как выбрать пожарный гидрант","desc":"Типы, классы давления, стандарты присоединения и проверка на заводе перед оформлением заказа."},{"href":"/ru/guides/fire-sprinkler-system-valves-guide/","eyebrow":"Гид по выбору","title":"Клапаны для систем спринклерного пожаротушения","desc":"Как работают сигнальные клапаны ZSFZ, дренчерные ZSFM и преакшн-клапаны ZSFY."},{"href":"/ru/guides/b2b-valve-sourcing-checklist/","eyebrow":"Закупки B2B","title":"Чек-лист проверки производителя","desc":"8 пунктов проверки контрагента: сертификаты, отчёты по партиям, аудит производства и образцы."},{"href":"/ru/fire-hydrant-systems/","eyebrow":"Описание системы","title":"Системы пожарных гидрантов","desc":"Внутренние и наружные гидранты, соединения и нормативы для муниципальных и промышленных сетей."},{"href":"/ru/fire-water-cannon/","eyebrow":"Описание системы","title":"Пожарные лафетные стволы и мониторы","desc":"Ручные мониторы PS и автоматические следящие лафеты ZDMS для тушения в больших пространствах."},{"href":"/ru/backflow-prevention/","eyebrow":"Описание системы","title":"Предотвращение обратного потока и гидравлический контроль","desc":"Устройства предотвращения обратного потока и регулирующие клапаны для защиты сетей водоснабжения."}];

// On-site project evidence: real fire pump room installation (photos + portrait walkthrough video)
const projectPhotos = [
  { src: '/assets/projects/pump-skids.webp', alt: 'Ряд пожарных насосов спринклерных систем с бирками OPEN и CLOSE в смонтированном помещении насосов', caption: 'Насосные блоки с бирками OPEN/CLOSE' },
  { src: '/assets/projects/valve-train.webp', alt: 'Линия шиберных клапанов и манометры на красных вертикальных стояках смонтированного помещения насосов', caption: 'Стояки и линия шиберных клапанов' },
  { src: '/assets/projects/riser-grid.webp', alt: 'Сеть вертикальных стояков с воздуховодами и кабельными лотками в смонтированном помещении насосов', caption: 'Сеть стояков и воздуховоды' },
  { src: '/assets/projects/pump-room-final.webp', alt: 'Смонтированное помещение пожарных насосов, подготовленное к приёмке и сдаче', caption: 'Помещение насосов перед сдачей' },
];

const projectScope = [
  'Несколько пожарных насосов спринклерных систем на бетонных опорах',
  'Полная сеть вертикальных стояков с шиберными клапанами, манометрами и бирками OPEN/CLOSE',
  'Воздуховоды и кабельные лотки вдоль сети стояков',
  'Объект подготовлен к финальной приёмке и сдаче',
];

const industries = [{"name":"Нефть и газ","desc":"Надёжный транспорт жидкостей в экстремальных промышленных условиях.","icon":"pipe"},{"name":"Очистка воды","desc":"Муниципальные системы водоснабжения, водоотведения и фильтрации.","icon":"drop"},{"name":"Противопожарная защита","desc":"Сертифицированные гидранты, клапаны спринклеров и системы пожаротушения.","icon":"flame"}];

type Clip = { src: string; poster: string; title: string; desc: string };

const clips = [{"src":"/videos/factory/assembly.mp4","poster":"/videos/factory/assembly-poster.webp","title":"Сборка","desc":"Болтовое соединение с проверкой момента затяжки"},{"src":"/videos/factory/blue-valves.mp4","poster":"/videos/factory/blue-valves-poster.webp","title":"Контроль","desc":"Единичные приборы после гидравлического испытания"},{"src":"/videos/factory/red-field.mp4","poster":"/videos/factory/red-field-poster.webp","title":"Готовая Продукция","desc":"Готовые гидранты ожидают отгрузки"},{"src":"/videos/factory/loading-close.mp4","poster":"/videos/factory/loading-close-poster.webp","title":"Упаковка и Погрузка","desc":"Экспортный заказ на доке, в коробах и стрейч-плёнке"},{"src":"/videos/factory/dispatch.mp4","poster":"/videos/factory/dispatch-poster.webp","title":"Отгрузка","desc":"Полностью загруженный грузовик едет в порт"}];

const walkthroughClip = {"src":"/assets/projects/project-walkthrough.mp4","poster":"/assets/projects/pump-room-wide.webp","title":"Видео с Объекта"};

const stats = [
  { value: String(products.length), unit: '', label: "Модели на складе" },
  { value: String(categories.length), unit: '', label: "Линии продукции" },
  { value: '100', unit: '%', label: "Испытаны под давлением" },
  { value: 'ISO 9001', unit: '', label: "Система качества" }
];

const capability = [{"icon":"valve","title":"Собственные Линии Производства","body":"Токарно-фрезерная обработка, сборка, испытания на прочность и окраска выполняются на наших собственных линиях завода в Цюаньчжоу, с квалифицированной партнёрской мощностью для пиковых заказов."},{"icon":"gauge","title":"Детальная Цитата за 12 Часов","body":"Пришлите чертежи, спецификацию или просто фото — наши инженеры ответят детальной цитатой, наличием на складе и сроком поставки за 12 часов, 7 дней в неделю."},{"icon":"doc","title":"Сертификация и 100% Испытания","body":"Каждая единица проходит один и тот же контролируемый цикл — от обработки на ЧПУ до 100% испытания давлением и нанесения эпоксидного покрытия."}];

const svgOpen = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">';
const icons: Record<string, string> = {
  valve: svgOpen + '<path d="M4 16 12 9l8 7H4Z"/><path d="M12 9V4"/><path d="M8.5 4h7"/></svg>',
  gauge: svgOpen + '<circle cx="12" cy="10" r="6"/><path d="M12 10l3.2-2.6"/><path d="M6 20h12"/></svg>',
  cog: svgOpen + '<circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.4M12 18.6V21M3 12h2.4M18.6 12H21M5.6 5.6l1.7 1.7M16.7 16.7l1.7 1.7M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7"/></svg>',
  doc: svgOpen + '<path d="M7 3h7l4 4v14H7V3Z"/><path d="M14 3v4h4"/><path d="M10 12h6M10 16h6"/></svg>',
  flame: svgOpen + '<path d="M12 3c3 4 5 6 5 9a5 5 0 0 1-10 0c0-2.2 1.1-3.8 2.6-5.2"/></svg>',
  drop: svgOpen + '<path d="M12 3l5.4 7a6.4 6.4 0 1 1-10.8 0L12 3Z"/></svg>',
  pipe: svgOpen + '<path d="M3 8.5h7v7H3zM14 8.5h7v7h-7z"/><path d="M10 12h4"/><path d="M3 8.5v7M21 8.5v7"/></svg>',
  guide: svgOpen + '<path d="M4 5h7v15H4zM13 5h7v15h-7z"/><path d="M7 9h1M16 9h1"/></svg>',
  chat: svgOpen + '<path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9h8M8 12h5"/></svg>'
};
const tick = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9 17.5 20 6.5"/></svg>';
---

<Layout
  locale="ru"
  title="Wanlian Fluid | Производство арматуры и пожарного оборудования"
  description="Quanzhou Wanlian Fluid — производитель и экспортёр промышленной арматуры и оборудования пожаротушения: собственные линии, ISO 9001, цена по запросу."
  faq={ruFaq}
  video={{ name: 'Wanlian Fluid за 50 секунд', description: 'Видео о компании: выставочный зал, производственные линии, OEM-изготовление и контроль качества на заводе в Цюаньчжоу.', thumbnail: '/videos/company-intro-poster.webp', src: '/videos/company-intro.mp4', duration: 'PT49S', uploadDate: '2026-09-18' }}
>
  <div class="c68">

    <section class="c68-hero">
      <div class="c68-wrap c68-hero-grid">
        <div class="c68-rv">
          <p class="c68-eyebrow"><span class="c68-dot"></span>Производитель и экспортёр — арматура и пожаротушение</p>
          <h1>Арматура и пожарное <em>оборудование для глобальных проектов.</em></h1>
          <p class="c68-rule" aria-hidden="true"></p>
          <p class="c68-lede">Промышленные клапаны, гидранты и группы клапанов сигнализации и дренчеров: 100% опрессовка, ISO 9001, детальный коммерческий ответ в течение 12 часов.</p>
          <div class="c68-cta">
            <a class="c68-btn c68-btn-red" href="/ru/products/">Полный каталог</a>
            <a class="c68-btn c68-btn-ghost" href="/ru/contact/#inquiry">Запросить цену</a>
          </div>
        </div>
        <figure class="c68-frame c68-rv">
          <span class="c68-frame-tab"></span>
          <img src="/assets/factory/plant-exterior.webp" alt="Wanlian Fluid plant exterior in Quanzhou, Fujian" decoding="async" />
          <figcaption>Реальные Съёмки С Нашего Завода</figcaption>
        </figure>
      </div>
      <div class="c68-stats">
        <div class="c68-wrap c68-stats-grid">
          {stats.map((s) => (
            <div class="c68-stat">
              <p class="c68-stat-num">{s.value}<span>{s.unit}</span></p>
              <p class="c68-stat-label">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="product-lines">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Основные категории продукции</p>
          <h2>Точная инженерия для мировых систем пожаротушения и водоснабжения.</h2>
        </header>
        <div class="c68-lines">
          {categories.map((c) => (
            <a class="c68-line c68-rv" href={c.href}>
              <span class="c68-line-media"><img src={c.image} alt={c.leadName} loading="lazy" decoding="async" /></span>
              <span class="c68-line-body">
                <span class="c68-line-count">{c.count}</span>
                <span class="c68-line-name">{c.name}</span>
                <span class="c68-line-more">Каталог доступен по запросу <i aria-hidden="true">&rarr;</i></span>
              </span>
            </a>
          ))}
          <a class="c68-line c68-line-full c68-rv" href="/ru/products/">
            <span class="c68-line-body">
              <span class="c68-line-count">Вся продукция</span>
              <span class="c68-line-name c68-line-name-inv">{products.length}</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="c68-band">
      <div class="c68-wrap">
        <div class="c68-cap-grid">
          {capability.map((c) => (
            <article class="c68-cap c68-rv">
              <span class="c68-ico" set:html={icons[c.icon]}></span>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="about">
      <div class="c68-wrap c68-profile-grid">
        <div class="c68-rv">
          <header class="c68-head">
            <p class="c68-kicker"><span class="w-8 h-[2px] bg-brand-red"></span>
                          О компании</p>
            <h2>Решения по управлению потоком <br/><span <em>class="text-brand-blue">для мировых проектов.</span></em></h2>
          </header>
          <p class="c68-body">Компания Quanzhou Wanlian Fluid Equipment Co., Ltd., базирующаяся в Чжоушане провинции Фуцзянь — ядре китайской индустрии трубопроводов и арматуры, — производит и экспортирует промышленные клапаны, гидравлическое оборудование, компоненты гидрантов и средства противопожарной защиты для международных B2B-проектов. Производство ведётся на собственных линиях в Чжоушане, отдельные позиции выпускают квалифицированные производственные партнёры; корпуса клапанов обрабатываются на станках с ЧПУ, каждая единица проходит испытание корпуса давлением и проверку на герметичность воздухом перед отгрузкой, в рамках системы менеджмента качества ISO 9001.</p>
          <p class="c68-profile-link"><a href="/ru/about/">О компании &rarr;</a><a href="/ru/applications/">Применение &rarr;</a></p>
        </div>
        <div class="c68-shots">
          <figure class="c68-shot c68-rv">
            <img src="/assets/factory/workshop.webp" alt="Main workshop at the Quanzhou plant" loading="lazy" decoding="async" />
          </figure>
          <figure class="c68-shot c68-rv">
            <img src="/assets/factory/powder-coating.webp" alt="Powder coating line at the Quanzhou plant" loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class="c68-band" id="process">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Производственный процесс</p>
          <h2>Наш <em>производственный цикл</em></h2>
        </header>
        <ol class="c68-steps">
          {productionSteps.map((s) => (
            <li class="c68-step c68-rv">
              <span class="c68-step-n">{s.step}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="c68-band c68-dark" id="factory">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker c68-kicker-red">Завод в кадре</p>
          <h2>Реальные Съёмки С <em>Нашего Завода</em></h2>
          <p class="c68-head-sub">Без стокового видео, без постановки: площадка в Цюаньчжоу в работе — от сборки до отгрузки.</p>
        </header>
        <div class="c68-video-lead">
          <figure class="c68-vid c68-rv">
            <video src="/videos/company-intro.mp4" poster="/videos/company-intro-poster.webp" controls playsinline preload="none"></video>
            <figcaption><strong>Wanlian Fluid за 50 Секунд</strong><span>Выставочный зал, производственные линии и контроль качества на нашем заводе в Цюаньчжоу — реальные съёмки, без стокового видео.</span></figcaption>
          </figure>
          <div class="c68-side">
            <ul class="c68-video-note">
              <li>Смотреть видео о компании</li>
              <li>Сертификаты и характеристики</li>
            </ul>
            <div class="c68-side-shots">
              <figure class="c68-sshot c68-rv">
                <img src="/assets/factory/assembly.webp" alt="Assembly and finishing bay" loading="lazy" decoding="async" style="aspect-ratio: 5 / 2" />
                <figcaption>Сборка</figcaption>
              </figure>
              <figure class="c68-sshot c68-rv">
                <img src="/assets/factory/fire-hose.webp" alt="Готовая Продукция" loading="lazy" decoding="async" style="aspect-ratio: 5 / 2" />
                <figcaption>Готовая Продукция</figcaption>
              </figure>
            </div>
          </div>
        </div>
        <div class="c68-clips">
          {clips.map((c) => (
            <figure class="c68-clip c68-rv">
              <video src={c.src} poster={c.poster} controls playsinline preload="none"></video>
              <figcaption><strong>{c.title}</strong><span>{c.desc}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Решения по продукции</p>
          <h2>Созданы для <br/><span <em>class="text-brand-blue">работы под высоким давлением.</span></em></h2>
          <p class="c68-head-sub"><a class="c68-inlink" href="/ru/applications/">Применение &rarr;</a></p>
        </header>
        <div class="c68-ind">
          {industries.map((i) => (
            <a class="c68-ind-card c68-rv" href="/ru/applications/">
              <span class="c68-ico" set:html={icons[i.icon]}></span>
              <h3>{i.name}</h3>
              <p>{i.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band" id="quality">
      <div class="c68-wrap">
        <header class="c68-head">
          <h2>Сертифицированные UL противопожарные клапаны</h2>
        </header>
        <div class="c68-cert-grid">
