---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Поставляете ли вы сам пожарный насос?',
		answer: 'Нет. Wanlian поставляет адаптер, клапаны и связанное соединительное оборудование вокруг насосной установки, которую поставляет другой производитель. Поставщик насоса даёт подбор насоса и сертифицированную характеристику; мы используем эти исходные данные проекта, чтобы согласовать окружающие компоненты.'
	},
	{
		question: 'Что такое сиамский адаптер пожарного насоса?',
		answer: 'SQD100-1.6 — это сиамское подключение пожарной машины с двумя входами DN65 и одним фланцевым выходом DN100, со встроенным регулирующим клапаном, для подачи воды от пожарного автомобиля в сеть пожаротушения.'
	},
	{
		question: 'Какой клапан ставится на всасывающей линии насоса?',
		answer: 'Схему всаса определяют утверждённый проект насосной и надзорный орган. Отсечной клапан на всасе обычно держат полностью открытым во время работы насоса; выбранные тип, размер и присоединение клапана согласуйте с поставщиком насоса и проектировщиком.'
	},
	{
		question: 'Куда ставится обратный клапан на нагнетании?',
		answer: 'Обратный клапан на напорной линии согласуется между насосной установкой стороннего производителя и отсечным клапаном нагнетания, чтобы ограничить обратный ток. Окончательное место, размер и класс давления следуют утверждённой трассировке и данным поставщика насоса.'
	},
	{
		question: 'Может ли редукционный клапан заменить автоматику насоса?',
		answer: 'Нет. 500X — это гидравлический редукционный клапан для управления давлением ниже по потоку в водяной линии; он не заменяет шкаф управления пожарным насосом, схему разгрузки насоса или сертифицированный проект системы от поставщика насоса.'
	},
	{
		question: 'Какие данные прислать для расчёта комплекта насосной?',
		answer: 'Пришлите данные поставщика насоса по расходу и напору, диаметры всаса и нагнетания, стандарты присоединения, схему испытаний, стандарт входа пожарной машины, требуемые сертификаты и спецификацию или чертежи клапанов.'
	}
];

const products = [
	{
		slug: 'sqd100-1-6-fire-pump-adapter',
		name: 'SQD100-1.6 Fire Pump Adapter (Siamese Connection)',
		img: '/assets/products/sqd100-1-6-fire-pump-adapter.webp',
		desc: '2 входа DN65, фланцевый выход DN100, 1,6 МПа'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'UL/FM Fire Protection Resilient Seated OS&Y Gate Valve',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: '2"–10", соединение groove, выдвижной шпиндель, одобрение UL / FM'
	},
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Ductile Iron Resilient Seat Flanged Gate Valve (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'DN50–DN700, PN10 / PN16, высокопрочный чугун, фланцевый'
	},
	{
		slug: 'spherical-ball-check-valve-hq44x',
		name: 'Spherical Cast Iron Ball Check Valve (HQ44X-16)',
		img: '/assets/products/spherical-ball-check-valve-hq44x.webp',
		desc: 'DN50–DN400, PN16, незапирающий шар из EPDM'
	},
	{
		slug: 'adjustable-pressure-reducing-valve-500x',
		name: 'Hydraulic Adjustable Pressure Reducing Valve (500X)',
		img: '/assets/products/pressure-reducing-valve-500x-dn50.webp',
		desc: 'DN20–DN600, регулировка 0,1–1,6 МПа, гидравлический пилот'
	}
];
---

<Layout
	title="Сиамское подключение и клапаны насосной станции | WLFE"
	description="Сиамский адаптер, подключение пожарной машины и клапаны насосной для схем всаса, нагнетания и испытаний вокруг насосной установки стороннего производителя."
	type="product"
	locale="ru"
	productData={{
		name: 'Подключения пожарного насоса и клапаны насосной',
		image: '/assets/products/sqd100-1-6-fire-pump-adapter.webp',
		description: 'Подключения для пожарной машины, адаптеры насоса, задвижки, обратные клапаны и компоненты управления давлением для согласованных комплектов насосной станции.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Подключения насоса' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/products/" class="hover:text-blue-600">Продукция</a>
			<span>/</span>
			<span class="text-gray-600">Подключения насоса</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Клапаны насосной и подключения пожарной машины</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Комплекты сиамского адаптера и клапанов насосной</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Пожарная насосная — это не только насос: это схема всаса, нагнетания, обратного клапана, отсечения и испытаний, которая позволяет насосной установке поставщика работать безопасно и даёт пожарной охране возможность добавить воду через совместимое сиамское подключение. Wanlian поставляет окружающие клапаны и соединения; насосную установку поставляет другой производитель.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Сиамский адаптер', 'Отсечение на всасе', 'Обратный клапан на напоре', 'Насос — другой поставщик'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span></div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Компоненты подключения пожарного насоса</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{products.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p><p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p></div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Таблица подбора для насосной</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Схема</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Проверенные данные для подбора</th></tr></thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">Подключение пожарной машины</td><td class="px-4 py-3 text-gray-700">SQD100-1.6: два входа DN65 с крышками SQS65 / KWS65, фланцевый выход DN100, 1,6 МПа, встроенный регулирующий клапан.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Отсечные клапаны</td><td class="px-4 py-3 text-gray-700">Задвижка OS&Y UL/FM: 2"–10", соединение groove, выдвижной шпиндель; фланцевая задвижка Z41X: DN50–DN700, PN10 / PN16.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Обратный клапан на напоре</td><td class="px-4 py-3 text-gray-700">Шаровой обратный клапан HQ44X: DN50–DN400, 1,6 МПа (PN16), незапирающий проточный канал и уплотнение EPDM / NBR.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Управление давлением</td><td class="px-4 py-3 text-gray-700">Гидравлический редукционный клапан 500X: DN20–DN600; диапазон регулировки 0,1–1,6 МПа; подтвердите его роль в утверждённом проекте ниже по потоку.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Данные насоса и испытаний</td><td class="px-4 py-3 text-gray-700">Перед окончательным подбором клапанов передайте данные поставщика насоса по расходу/напору, диаметры труб, схему испытаний и применимые требования по согласованию.</td></tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Что включить в один заказ насосной</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2">
				<li><strong>Точка подключения</strong> — стандарт сиамского входа, фланец выхода, схема крышек и интерфейс с пожарной охраной.</li>
				<li><strong>Комплект всаса и нагнетания</strong> — отсечной клапан, обратный клапан и все элементы управления давлением, согласованные с утверждённой спецификацией трубопроводов.</li>
				<li><strong>Испытания и пусконаладка</strong> — испытательный коллектор или вывод, приборы сторонних поставщиков где применимо и сертифицированная характеристика насоса.</li>
				<li><strong>Комплект материалов для согласования</strong> — чертежи, данные по изделию, сертификаты, присоединительные размеры, класс давления и маркировка для рынка назначения.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Материалы по проектированию насосной</h2>
			<p class="text-gray-700 leading-relaxed">Для схем всаса, нагнетания и испытаний используйте <a href="/ru/guides/fire-pump-room-valves-guide/" class="text-brand-blue font-semibold hover:underline">руководство по арматуре обвязки пожарного насоса</a>, <a href="/ru/guides/fire-department-connection-siamese-guide/" class="text-brand-blue font-semibold hover:underline">руководство по сиамскому подключению пожарной машины</a> и <a href="/ru/guides/check-valve-types-guide/" class="text-brand-blue font-semibold hover:underline">руководство по типам обратных клапанов</a> при подготовке спецификации клапанов.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Часто задаваемые вопросы</h2><div class="space-y-4">{faq.map(item => (<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>))}</div>

			<div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white tracking-tight">Нужен комплект подключения пожарного насоса?</h2><p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Пришлите данные поставщика насоса по расходу/напору и вашу спецификацию клапанов — мы согласуем проверенный адаптер и комплект клапанов в течение 12 часов.</p><div class="mt-6 flex flex-col sm:flex-row justify-center gap-4"><a href="/ru/contact/?product=%D0%9F%D0%BE%D0%B4%D0%BA%D0%BB%D1%8E%D1%87%D0%B5%D0%BD%D0%B8%D1%8F%20%D0%BF%D0%BE%D0%B6%D0%B0%D1%80%D0%BD%D0%BE%D0%B3%D0%BE%20%D0%BD%D0%B0%D1%81%D0%BE%D1%81%D0%B0" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Запросить цену</a><a href="https://wa.me/8618684324501?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5%2C%20%D0%BD%D1%83%D0%B6%D0%BD%D1%8B%20%D0%BF%D0%BE%D0%B4%D0%BA%D0%BB%D1%8E%D1%87%D0%B5%D0%BD%D0%B8%D1%8F%20%D0%B4%D0%BB%D1%8F%20%D0%BF%D0%BE%D0%B6%D0%B0%D1%80%D0%BD%D0%BE%D0%B3%D0%BE%20%D0%BD%D0%B0%D1%81%D0%BE%D1%81%D0%B0" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Чат по WhatsApp</a></div></div></div>
		</article>
	</main>
</Layout>
