---
import Layout from '../../layouts/Layout.astro';

const certifications = [
  {
    name: 'Сертификация UL',
    code: 'UL 262 / UL 1091',
    desc: 'Стандарт для задвижек и обратных клапанов противопожарного применения.',
    scope: 'Задвижки и обратные клапаны противопожарного применения, поставляемые на североамериканский рынок (UL 262 / UL 1091).',
    products: 'Задвижки с эластичным седлом, обратные клапаны',
    verify: 'Область действия сертификата распространяется на конкретные модели, перечисленные в сертификате UL. Свяжитесь с нами, чтобы подтвердить покрытие моделей и запросить копию.',
    icon: '🏆'
  },
  {
    name: 'Одобрение FM',
    code: 'Class 1120/1130',
    desc: 'Стандарт одобрения запорно-регулирующих клапанов противопожарного назначения (типов OS&Y и NRS).',
    scope: 'Запорно-регулирующие клапаны противопожарного назначения (типов OS&Y и NRS), одобренные по FM Class 1120/1130.',
    products: 'Задвижки с выдвижным шпинделем (OS&Y), запорно-регулирующие клапаны противопожарного назначения',
    verify: 'Одобрение распространяется на модели, перечисленные в сертификате FM. Копии предоставляются по запросу для документации вашего проекта.',
    icon: '🛡️'
  },
  {
    name: 'Маркировка CE',
    code: 'EN 12266-1',
    desc: 'Соответствие европейским требованиям по здоровью, безопасности и защите окружающей среды.',
    scope: 'Оборудование под давлением, прошедшее испытания и маркированное в соответствии с применимыми директивами ЕС и стандартом испытаний EN 12266-1.',
    products: 'Клапаны для проектов в ЕС (в соответствии с областью применимой директивы)',
    verify: 'Маркировка CE действует в пределах применимых директив. Подтвердите применимую директиву и категорию для вашего проекта.',
    icon: '🇪🇺'
  },
  {
    name: 'Сертификация ISO 9001:2015',
    code: 'Система Менеджмента Качества',
    desc: 'Международный стандарт систем менеджмента качества на производстве.',
    scope: 'Проектирование, производство и продажа клапанов, противопожарного оборудования и продукции для управления жидкостью в сертифицированной системе менеджмента качества ISO 9001:2015.',
    products: 'Все производственные линии',
    verify: 'Сертификат системы, выданный аккредитованным органом по сертификации; действителен в пределах срока действия сертификата. Копия предоставляется по запросу.',
    icon: '⚙️'
  },
  {
    name: 'Сертификат LPCB',
    code: 'Профилактика Убытков',
    desc: 'Включение в реестр RedBook для противопожарной продукции и услуг.',
    scope: 'Противопожарная продукция, включённая в реестр LPCB RedBook для рынков Великобритании и Содружества.',
    products: 'Противопожарная продукция, включённая в реестр (согласно записи RedBook)',
    verify: 'Запись RedBook охватывает конкретную продукцию и стандарты, указанные в записи реестра. Проверьте номер записи для вашей целевой продукции.',
    icon: '📜'
  },
  {
    name: 'Национальный стандарт GB',
    code: 'GB 5135 / GB 4452',
    desc: 'Соответствие национальным стандартам Китая по противопожарному оборудованию.',
    scope: 'Производство и испытания в соответствии с применимыми национальными стандартами Китая (серия GB 5135, GB 4452, GB 50974).',
    products: 'Компоненты спринклерных систем, пожарные гидранты, сигнальные клапаны',
    verify: 'Соответствие по конкретному стандарту GB, применимому к каждой модели продукции. Протоколы испытаний предоставляются по запросу.',
    icon: '🇨🇳'
  }
];

const faq = [
  {
    question: 'Имеет ли Wanlian Fluid сертификацию ISO 9001?',
    answer: 'Да — производство ведётся в сертифицированной системе менеджмента качества ISO 9001:2015, охватывающей проектирование, производство и продажу клапанов, противопожарного оборудования и продукции для управления жидкостью. Номер сертификата и орган по сертификации предоставляются для проверки.'
  },
  {
    question: 'Ваши пожарные клапаны сертифицированы UL или одобрены FM?',
    answer: 'Задвижки и обратные клапаны противопожарного применения сертифицированы по UL 262 / UL 1091, а запорно-регулирующие клапаны противопожарного назначения (типов OS&Y и NRS) имеют одобрение FM Class 1120/1130. Сертификация выдаётся по моделям — перед оформлением заказа мы подтверждаем точную сертифицированную модель и область действия сертификата для вашей спецификации.'
  },
  {
    question: 'На что распространяется маркировка CE для ваших клапанов?',
    answer: 'Маркировка CE применяется по моделям в пределах применимых директив ЕС, испытания клапанов выполняются по стандарту EN 12266-1. Сообщите о вашем проекте и стране поставки — и мы подтвердим применимую директиву, категорию и документацию для точной модели.'
  },
  {
    question: 'Как проверить, что ваши сертификаты подлинные?',
    answer: 'Каждый номер сертификата можно проверить на официальном портале органа по сертификации по точной модели и заводу — номер, который не удаётся найти, является поводом для настороженности при работе с любым поставщиком. Копии соответствующих сертификатов предоставляются вместе с документацией по вашему заказу.'
  },
  {
    question: 'Предоставляете ли вы протоколы испытаний вместе с отгрузкой?',
    answer: 'Да — записи испытаний корпуса на прочность и на герметичность по каждой единице, сверенные с серийными номерами в упаковочном листе, прилагаются к экспортным документам (счёт, упаковочный лист, сертификат о происхождении), а по запросу — сертификаты на материалы и сертификаты по конкретным стандартам.'
  }
];
---

<Layout 
  locale="ru"
  title="Сертификаты продукции и техническая документация | Wanlian Fluid"
  description="Сертификаты UL, FM, CE, LPCB и ISO 9001 на клапаны и противопожарное оборудование Wanlian Fluid. Копии, протоколы испытаний и CAD-чертежи — по запросу."
  faq={faq}
  breadcrumbs={[{ name: 'Сертификаты' }]}
>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
         Документация <span class="text-brand-red">Продукции.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
         Пришлите требования вашего проекта — и мы предоставим доступную информацию о продукции, технические характеристики и документацию для проверки.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p>
            <div class="space-y-3 text-sm text-gray-600">
              <p><span class="font-bold text-gray-900">Область действия: </span>{cert.scope}</p>
              <p><span class="font-bold text-gray-900">Охваченная продукция: </span>{cert.products}</p>
              <p class="text-xs text-gray-500 leading-relaxed border-t border-gray-200 pt-3">{cert.verify}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-6">
        <h2 class="text-3xl font-black">Нужны копии сертификатов или технические паспорта?</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          Мы предоставляем копии сертификатов, протоколы гидростатических испытаний, технические паспорта, CAD-чертежи и руководства по установке на весь ассортимент продукции по запросу. Укажите требуемую сертификацию, модель продукции и целевой рынок — и мы подтвердим применимую область действия.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a href="/ru/contact/?product=Certificate%20%26%20Technical%20Documentation%20Request" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
            Запросить Сертификаты и Документы
          </a>
          <a href="/ru/products/" class="inline-block px-10 py-5 bg-white/10 border border-gray-600 text-white font-black rounded-xl hover:bg-white/20 transition">
            Смотреть Сертифицированную Продукцию
          </a>
        </div>
        <p class="text-xs text-gray-500 pt-2">
          Сертификация распространяется на конкретную продукцию, модели и область действия, указанные в каждом сертификате. Наши инженеры подтвердят покрытие моделей до оформления вашего заказа.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 bg-gray-50 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">FAQ</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Часто задаваемые вопросы</h2>
      </div>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-white rounded-xl border border-gray-100 p-6 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
