---
import Layout from '../../layouts/Layout.astro';

const certifications = [
  {
    name: 'ISO 9001:2015',
    code: 'НА НАШЕ ИМЯ',
    desc: 'Система менеджмента качества Quanzhou Wanlian Fluid Equipment Co., Ltd.',
    scope: 'Проектирование, производство и продажа клапанов, противопожарного оборудования и продукции для управления жидкостью в сертифицированной системе менеджмента качества ISO 9001:2015.',
    products: 'Весь ассортимент: собственные производственные линии и продукция заводов-партнёров',
    verify: 'Номер сертификата и орган по сертификации предоставляются для проверки. Копия включается в документацию к вашему заказу.',
    icon: '⚙️'
  },
  {
    name: 'Протоколы испытаний по партиям',
    code: 'НА НАШЕ ИМЯ',
    desc: 'Документированные испытания корпуса на прочность и седла на герметичность для каждой партии.',
    scope: 'Каждая единица проходит испытания корпуса на прочность и на герметичность воздухом перед упаковкой по GB/T 13927 или EN 12266-1 согласно вашей спецификации; записи сверяются с серийными номерами в упаковочном листе.',
    products: 'Все клапаны и противопожарное оборудование, которые мы отгружаем',
    verify: 'Протоколы испытаний прилагаются к экспортным документам. По запросу до отгрузки можно организовать испытания в присутствии третьей стороны (SGS, BV, Intertek).',
    icon: '🧪'
  },
  {
    name: 'EN 12266-1 / серия GB 5135',
    code: 'ОСНОВА РАЗРАБОТКИ И ИСПЫТАНИЙ',
    desc: 'Основа изготовления и испытаний, если к вашей спецификации не применяется регистрация третьей стороны.',
    scope: 'Клапаны изготавливаются и испытываются по EN 12266-1 или GB/T 13927 согласно вашей спецификации; компоненты спринклерных систем, пожарные гидранты и сигнальные клапаны соответствуют серии GB 5135, GB 4452 и GB 50974, а при проектировании системы используется EN 12845. Маркировку CE, если она применима, заявляет завод-изготовитель, владеющий соответствующей декларацией.',
    products: 'Компоненты спринклерных систем, пожарные гидранты, сигнальные клапаны и клапаны общего назначения',
    verify: 'Это заявление об основе изготовления и испытаний, а не сертификат; мы обозначаем его именно так. Протоколы заводских испытаний предоставляются при отгрузке.',
    icon: '🧱'
  },
  {
    name: 'UL 262 / UL 1091',
    code: 'ПРИНАДЛЕЖИТ ЗАВОДУ-ИЗГОТОВИТЕЛЮ',
    desc: 'Стандарты для задвижек и обратных клапанов противопожарного применения в Северной Америке.',
    scope: 'Регистрация UL предоставляется заводу, изготовившему зарегистрированную модель. Wanlian не имеет сертификатов UL и не заявляет их как собственные.',
    products: 'Зарегистрированные модели можно приобрести у завода — держателя сертификата, если этого требует ваша спецификация',
    verify: 'Если в тендере указан UL, до начала производства мы письменно подтверждаем юридическое название держателя сертификата, зарегистрированные модель и размер, а также предоставляем копию сертификата; затем вы самостоятельно проверяете запись в UL Product iQ.',
    icon: '🏆'
  },
  {
    name: 'FM Class 1120 / 1130',
    code: 'ПРИНАДЛЕЖИТ ЗАВОДУ-ИЗГОТОВИТЕЛЮ',
    desc: 'Стандарт одобрения клапанов управления противопожарной службой типов OS&Y и NRS.',
    scope: 'Одобрения FM выдаются для конкретного изготовителя и линейки продукции. Мы поставляем одобренные модели с одобренного завода. Мы не представляем одобрение FM как собственную аккредитацию Wanlian.',
    products: 'Задвижки OS&Y и клапаны управления противопожарной службой в зарегистрированных конфигурациях по запросу',
    verify: 'Мы указываем держателя одобрения и одобренную модель, предоставляем копию сертификата, а вы подтверждаете запись в FM Approval Guide.',
    icon: '🛡️'
  },
  {
    name: 'LPCB RedBook',
    code: 'ПРИНАДЛЕЖИТ ЗАВОДУ-ИЗГОТОВИТЕЛЮ',
    desc: 'Регистрация противопожарной продукции и услуг в системе Loss Prevention Certification.',
    scope: 'Записи RedBook публикуются для сертифицированного изготовителя. Это актуально для проектов Великобритании и Содружества, где требуется продукция с регистрацией LPCB.',
    products: 'Зарегистрированная противопожарная продукция согласно записи RedBook завода-поставщика',
    verify: 'До принятия решения мы указываем запись RedBook и сертифицированного изготовителя для нужной продукции; запись можно бесплатно проверить на redbooklive.com.',
    icon: '📜'
  }
];

const faq = [
  {
    question: 'Имеет ли Wanlian Fluid сертификат ISO 9001?',
    answer: 'Да — производство ведётся в системе менеджмента качества ISO 9001:2015, охватывающей проектирование, производство и продажу клапанов, противопожарного оборудования и продукции для управления жидкостью. Номер сертификата и орган по сертификации предоставляются для проверки.'
  },
  {
    question: 'Имеют ли ваши противопожарные клапаны регистрацию UL или одобрение FM?',
    answer: 'Нет — эти регистрации принадлежат заводам-держателям, а не Wanlian. Если в вашем тендере указаны UL 262, UL 1091, FM Class 1120 или FM Class 1130, мы получаем зарегистрированную модель у завода — держателя сертификата и письменно подтверждаем до начала производства юридическое название держателя, модель и размер, а также копию сертификата. Если мы не можем поставить действительно зарегистрированную единицу, мы сообщаем об этом на этапе предложения, до принятия заказа.'
  },
  {
    question: 'Что означает маркировка CE для ваших клапанов?',
    answer: 'Маркировку CE заявляет завод-изготовитель, владеющий применимой декларацией ЕС, в пределах соответствующих директив; испытания клапанов выполняются по EN 12266-1. Сообщите о проекте и стране назначения, и мы укажем завод, директиву, категорию и документацию для точной модели до оформления заказа.'
  },
  {
    question: 'Как проверить подлинность сертификатов?',
    answer: 'Мы указываем юридическое название держателя сертификата и предоставляем копию для точной модели, чтобы вы могли самостоятельно проверить её в UL Product iQ, FM Approval Guide, LPCB RedBook или на портале органа по сертификации. Поставщик, который не называет держателя сертификата, вызывает сомнения; это правило относится и к нам.'
  },
  {
    question: 'Предоставляете ли вы протоколы испытаний при отгрузке?',
    answer: 'Да — протоколы испытаний корпуса на прочность и на герметичность воздухом для каждой единицы, сверенные с серийными номерами в упаковочном листе, прилагаются к экспортным документам (счёт, упаковочный лист, сертификат о происхождении), а сертификаты на материалы и по конкретным стандартам предоставляются по запросу.'
  }
];
---

<Layout 
  locale="ru"
  title="Соответствие, испытания и сертификация | Wanlian Fluid"
  description="Что Wanlian подтверждает от своего имени, что принадлежит заводу-изготовителю и на какой основе мы изготавливаем и испытываем продукцию — с проверкой каждого случая."
  faq={faq}
  breadcrumbs={[{ name: 'Сертификаты' }]}
>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
         Документация <span class="text-brand-red">Продукции.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
         Пришлите требования вашего проекта — и мы предоставим доступную информацию о продукции, технические характеристики и документацию для проверки.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p>
            <div class="space-y-3 text-sm text-gray-600">
              <p><span class="font-bold text-gray-900">Область действия: </span>{cert.scope}</p>
              <p><span class="font-bold text-gray-900">Охваченная продукция: </span>{cert.products}</p>
              <p class="text-xs text-gray-500 leading-relaxed border-t border-gray-200 pt-3">{cert.verify}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-6">
        <h2 class="text-3xl font-black">Нужны копии сертификатов или технические паспорта?</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          Мы предоставляем копии сертификатов, протоколы гидростатических испытаний, технические паспорта, CAD-чертежи и руководства по установке на весь ассортимент продукции по запросу. Укажите требуемую сертификацию, модель продукции и целевой рынок — и мы подтвердим применимую область действия.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a href="/ru/contact/?product=Certificate%20%26%20Technical%20Documentation%20Request" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
            Запросить Сертификаты и Документы
          </a>
          <a href="/ru/products/" class="inline-block px-10 py-5 bg-white/10 border border-gray-600 text-white font-black rounded-xl hover:bg-white/20 transition">
            Смотреть Сертифицированную Продукцию
          </a>
        </div>
        <p class="text-xs text-gray-500 pt-2">
          Сертификация распространяется на конкретную продукцию, модели и область действия, указанные в каждом сертификате. Наши инженеры подтвердят покрытие моделей до оформления вашего заказа.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 bg-gray-50 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">FAQ</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Часто задаваемые вопросы</h2>
      </div>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-white rounded-xl border border-gray-100 p-6 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
