---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'В чём разница между устройством предотвращения обратного потока и обратным клапаном?',
		answer: 'Стандартный обратный клапан механически предотвращает обратный поток, но не испытывается на герметичность и не имеет промежуточной дренажной камеры. Устройство предотвращения обратного потока HS41X сочетает два независимых обратных клапана с автоматической промежуточной дренажной камерой, подлежит испытаниям на месте и отвечает требованиям контроля перекрёстных соединений для защиты питьевой воды. Обратные клапаны сами по себе не принимаются в перекрёстных соединениях питьевых водопроводов.'
	},
	{
		question: 'Где должно устанавливаться устройство предотвращения обратного потока в пожарном вводе?',
		answer: 'На пожарном вводе от магистральной сети питьевой воды, выше по потоку по отношению к всасыванию пожарного насоса или стояку системы. Устройство должно быть доступно для испытаний, защищено от замерзания, а его потери напора — учтены в гидравлическом расчёте пожарного насоса. Для высотных систем убедитесь, что класс устройства соответствует максимальному статическому давлению питания.'
	},
	{
		question: 'Нужна ли электрическая энергия для работы гидравлических регулирующих клапанов?',
		answer: 'Большинство гидравлических регулирующих клапанов — редукционный 500X, клапан регулирования уровня F745X и устройство предотвращения обратного потока HS41X — полностью самодействующие за счёт давления в трубопроводе и не требуют внешнего питания. Модели с электромагнитным управлением, такие как GKZF-1, используют AC220V или DC24V для дистанционной автоматизации.'
	},
	{
		question: 'Какие материалы применяются в системах питьевой воды?',
		answer: 'Для сетей питьевой воды устройство предотвращения обратного потока HS41X изготовлено из корпуса высокопрочного чугуна с уплотнениями из EPDM и внутренними деталями из нержавеющей стали 304, в соответствии с санитарными требованиями стандарта GB/T17219. Подтвердите санитарный сертификат для вашего рынка — наши инженеры предоставляют пакет документации вместе с заказом.'
	},
	{
		question: 'Можно ли заказать полный пакет гидравлических клапанов для насосной?',
		answer: 'Да. Мы производим устройства предотвращения обратного потока, редукционные клапаны, клапаны регулирования уровня, клапаны с электромагнитным управлением, устройства защиты от вихреобразования и Y-образные фильтры и отправляем их согласованным пакетом — с одинаковыми классами давления, внутренними комплектующими и протоколами испытаний с одной фабрики.'
	}
];

const hydraulicProducts = [
	{
		slug: 'anti-pollution-backflow-preventer-hs41x',
		name: 'Устройство предотвращения обратного потока (HS41X-16)',
		img: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		desc: 'Двойное клапанное исполнение с дренажем, DN50–DN600'
	},
	{
		slug: 'adjustable-pressure-reducing-valve-500x',
		name: 'Гидравлический редукционный клапан (500X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'Самодействующий пилотный контур, регулировка 0,1–1,6 МПа'
	},
	{
		slug: 'hydraulic-water-level-control-valve-f745x',
		name: 'Клапан регулирования уровня воды (F745X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'Поплавковый пилотный контроль уровня для резервуаров и баков'
	},
	{
		slug: 'groove-solenoid-control-gate-valve-gkzf1',
		name: 'Задвижка с электромагнитным управлением (GKZF-1)',
		img: '/assets/products/groove-solenoid-control-gate-valve-gkzf1.jpg',
		desc: 'Канавочная пилотная задвижка DC24V/AC220V, класс 300 PSI'
	},
	{
		slug: 'suction-vortex-preventer-en12845',
		name: 'Устройство защиты от вихреобразования (EN12845)',
		img: '/assets/02_valves_parts/valves_p21.webp',
		desc: 'SS304/316, устранение кавитации насоса, дренаж 100 мм'
	}
];

const trustBadges = ['Двойной клапан + дренаж', 'PN10–PN25', 'Санитарный GB/T17219', 'Самодействующие пилоты'];
---

<Layout
	title="Устройства предотвращения обратного потока и гидравлические клапаны"
	description="Устройства предотвращения обратного потока HS41X, редукционные 500X, клапаны уровня F745X и соленоидные GKZF-1 для питьевых и пожарных сетей. DN50–DN600."
	type="product"
	locale="ru"
	productData={{
		name: 'Предотвращение обратного потока и гидравлический контроль',
		image: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		description: 'Устройства предотвращения обратного потока и гидравлические регулирующие клапаны для защиты питьевой воды, управления давлением и автоматизированных водных сетей, производство Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Предотвращение обратного потока' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/products/" class="hover:text-blue-600">Продукция</a>
			<span>/</span>
			<span class="text-gray-600">Предотвращение обратного потока</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Защита питьевой воды &amp; гидравлический контроль</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Устройства предотвращения обратного потока и гидравлические регулирующие клапаны</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid выпускает полный спектр гидравлической безопасности — устройства предотвращения обратного потока HS41X, редукционные клапаны 500X, клапаны регулирования уровня F745X и клапаны с электромагнитным управлением GKZF-1 — защищая сети питьевой воды и автоматизируя контроль давления и уровня в едином согласованном пакете.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Серия гидравлических запорно-регулирующих клапанов</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydraulicProducts.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Ключевые характеристики</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Клапан</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Функция</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Диапазон диаметров</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Класс</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">HS41X</td>
							<td class="px-4 py-3 text-gray-700">Предотвращение обратного потока</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">500X</td>
							<td class="px-4 py-3 text-gray-700">Снижение и поддержание давления</td>
							<td class="px-4 py-3 text-gray-700">DN20 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">F745X</td>
							<td class="px-4 py-3 text-gray-700">Регулирование уровня воды</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN400</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">GKZF-1</td>
							<td class="px-4 py-3 text-gray-700">Управление открытием/закрытием соленоидом</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN300</td>
							<td class="px-4 py-3 text-gray-700">300 PSI, AC220V/DC24V</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Устройство от вихреобразования</td>
							<td class="px-4 py-3 text-gray-700">Защита всасывания насоса</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN1000</td>
							<td class="px-4 py-3 text-gray-700">EN12845 / GB50974</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Область применения</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Контроль перекрёстных соединений в питьевых водопроводах (пожарные магистрали, орошение, котлы)</li>
				<li>Регулирование уровня в водонапорных резервуарах и крышных баках</li>
				<li>Управление зонами давления в городских и внутридомовых сетях</li>
				<li>Автоматизированные водные сети с дистанционным управлением клапанами</li>
				<li>Защита всасывания насосов в резервуарах и баках</li>
			</ul>

			<!-- FAQ Section -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Часто задаваемые вопросы</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Нужен пакет гидравлических клапанов для вашей сети?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Отправьте нам ваш DN, класс давления и тип присоединения — наши инженеры ответят с кривыми потерь напора, техническими паспортами и коммерческим предложением на пакет в течение 12 часов.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ru/contact/?product=Backflow%20Prevention%20%26%20Hydraulic%20Control" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Запросить цену</a>
						<a href="https://wa.me/8618684324501?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5%2C%20%D0%BC%D0%BD%D0%B5%20%D0%BD%D1%83%D0%B6%D0%BD%D0%B0%20%D0%BF%D0%BE%D0%BC%D0%BE%D1%89%D1%8C%20%D0%B2%20%D0%B2%D1%8B%D0%B1%D0%BE%D1%80%D0%B5%20%D0%B3%D0%B8%D0%B4%D1%80%D0%B0%D0%B2%D0%BB%D0%B8%D1%87%D0%B5%D1%81%D0%BA%D0%B8%D1%85%20%D1%80%D0%B5%D0%B3%D1%83%D0%BB%D0%B8%D1%80%D1%83%D1%8E%D1%89%D0%B8%D1%85%20%D0%BA%D0%BB%D0%B0%D0%BF%D0%B0%D0%BD%D0%BE%D0%B2" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Написать в WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
