---
import Layout from '../../layouts/Layout.astro';
import { guidesRu } from '../../utils/guides.ru';

// Системные/решенческие страницы (не статьи-руководства, выводятся отдельной группой)
const solutions = [
  {
    title: 'Решение: системы пожарных гидрантов',
    description: 'Внутренние, наружные, антивандальные и интеллектуальные IoT-гидранты для муниципальных сетей, промышленных площадок и сетей умного города.',
    href: '/ru/fire-hydrant-systems/',
    date: '2026',
    category: 'Продуктовые решения',
    readTime: '5 мин чтения'
  },
  {
    title: 'Решение: предотвращение обратного потока и гидравлический контроль',
    description: 'Устройства предотвращения обратного потока, клапаны-регуляторы давления, клапаны регулирования уровня воды и электромагнитные клапаны управления для питьевой воды и гидравлической безопасности.',
    href: '/ru/backflow-prevention/',
    date: '2026',
    category: 'Продуктовые решения',
    readTime: '5 мин чтения'
  },
  {
    title: 'Применения: пожаротушение, водораспределительные сети и промышленные трубопроводы',
    description: 'Подбор продукции по применению: от муниципального водоснабжения и HVAC до нефтегазовых, складских и морских проектов.',
    href: '/ru/applications/',
    date: '2026',
    category: 'Приложения',
    readTime: '5 мин чтения'
  },
  {
    title: 'Пожарные клапаны UL, спринклерные системы и лафетные стволы',
    description: 'Раздел решений Wanlian: пожарные клапаны UL, спринклерные системы и лафетные стволы — с техническим руководством и ссылками для запроса цены.',
    href: '/ru/ul-fire-valves/',
    date: '2026',
    category: 'Продуктовые решения',
    readTime: '5 мин чтения'
  },
  {
    title: 'Решение: пожарные лафетные стволы',
    description: 'Ручные и автоматические лафетные стволы для нефтегазовых заводов, складов, аэропортов и других объектов повышенного риска.',
    href: '/ru/fire-water-cannon/',
    date: '2026',
    category: 'Продуктовые решения',
    readTime: '5 мин чтения'
  },
  {
    title: 'Решение: спринклерные системы',
    description: 'Сигнальные клапаны мокрого типа, дренчерные и клапаны систем предварительного действия, сигнализаторы потока — для спринклерных систем торговых, промышленных и складских зданий.',
    href: '/ru/fire-sprinkler-systems/',
    date: '2026',
    category: 'Продуктовые решения',
    readTime: '5 мин чтения'
  }
];
---

<Layout
  title="Блог и руководства по закупкам | Wanlian Fluid Equipment"
  description="Технические руководства по закупкам и отраслевые знания: противопожарное оборудование, промышленные клапаны и системы управления жидкостью от Wanlian Fluid."
  locale="ru"
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Блог и руководства</span>
      <h1 class="text-4xl font-black text-gray-900 tracking-tight">Руководства по закупкам и отраслевые знания</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
        Практические инженерные и закупочные знания для проектов противопожарной защиты и управления жидкостью.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {guidesRu.map(article => (
        <a
          href={article.href}
          class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-8 flex flex-col"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2.5 py-1 bg-brand-blue/10 text-brand-blue text-[11px] font-black rounded-full uppercase tracking-wider">{article.category}</span>
            <span class="text-xs text-gray-400">{article.date} · {article.readTime}</span>
          </div>
          <h2 class="text-lg font-black text-gray-900 group-hover:text-brand-blue transition leading-snug mb-3">
            {article.title}
          </h2>
          <p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p>
          <div class="flex flex-wrap gap-2 mt-4">
            {article.tags.map(tag => (
              <a href={`/ru/tags/${tag}/`} class="text-[10px] font-bold text-gray-400 uppercase tracking-wider hover:text-brand-blue transition">#{tag.replace(/-/g, ' ')}</a>
            ))}
          </div>
          <span class="mt-6 inline-flex items-center text-brand-red font-bold text-sm group-hover:gap-2 transition-all">
            Читать руководство
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-16 mb-8 flex items-center gap-4">
      <h2 class="text-2xl font-black text-gray-900 tracking-tight">Продуктовые решения</h2>
      <div class="flex-1 h-px bg-gray-200"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {solutions.map(article => (
        <a
          href={article.href}
          class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-red/30 transition p-8 flex flex-col"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2.5 py-1 bg-brand-red/10 text-brand-red text-[11px] font-black rounded-full uppercase tracking-wider">{article.category}</span>
            <span class="text-xs text-gray-400">{article.date} · {article.readTime}</span>
          </div>
          <h2 class="text-lg font-black text-gray-900 group-hover:text-brand-red transition leading-snug mb-3">
            {article.title}
          </h2>
          <p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p>
          <span class="mt-6 inline-flex items-center text-brand-blue font-bold text-sm group-hover:gap-2 transition-all">
            Смотреть решение
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4">
      <h2 class="text-2xl font-black">Нужна конкретная техническая консультация?</h2>
      <p class="text-gray-400 max-w-xl mx-auto">
        Наши инженеры помогут подобрать подходящие клапаны и противопожарное оборудование для вашего проекта.
      </p>
      <a href="/ru/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-xl hover:opacity-90 transition">
        Спросить инженера
      </a>
    </div>
  </main>
</Layout>
