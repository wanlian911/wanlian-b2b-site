---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Какова эффективная дальность вашего пожарного лафетного ствола?',
		answer: 'Дальность зависит от модели и давления на входе — как правило, от 50 до 110 м при номинальном расходе для нашей серии PS, с радиусом слежения 40–65 м для серии ZDMS с автоматическим сопровождением. Сообщите нам компоновку вашего объекта, и мы порекомендуем подходящую модель.'
	},
	{
		question: 'Можно ли управлять лафетным стволом дистанционно?',
		answer: 'Да. Наш автоматический следящий ствол ZDMS работает полностью автономно с ИК/УФ-детекцией пламени и поддерживает ручное дистанционное управление через ПК, мобильное приложение или центральный шкаф управления. Также доступны стационарные мониторы с ручным рычажным управлением.'
	},
	{
		question: 'Какие расходы доступны?',
		answer: 'Стандартные модели — от 5 до 200 л/с. Серия ZDMS доступна в исполнениях 5, 10, 20 и 30 л/с (с изготовлением по требованиям заказчика до 150 л/с), а ручная серия PS охватывает 20–200 л/с. Расход можно спроектировать под конкретный проект.'
	},
	{
		question: 'Интегрируется ли интеллектуальная модель с системами пожарной сигнализации?',
		answer: 'Да. Интеллектуальные стволы ZDMS используют многоспектральные инфракрасные и ультрафиолетовые датчики для автоматического обнаружения пожара, наводки и подачи струи менее чем за 30 секунд и могут подключаться к приборам приёмно-контрольной пожарной сигнализации. Взрывозащищённые исполнения доступны как опция.'
	},
	{
		question: 'Поставляете ли вы полную систему, включая клапаны и трубопроводы?',
		answer: 'Да. Мы производим ствол и отправляем его вместе с согласованными клапанами, соединительными головками, гидрантами и аксессуарами для полного контура пожаротушения — это упрощает закупки и обеспечивает совместимость системы.'
	}
];

const cannonProducts = [
	{
		slug: 'auto-tracking-jet-suppression-cannon-zdms',
		name: 'Автоматический следящий лафетный ствол (ZDMS)',
		img: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		desc: 'Автоматическое обнаружение ИК/УФ, поворот 360°, радиус 40–65 м'
	},
	{
		slug: 'manual-fire-water-cannon-ps',
		name: 'Ручной пожарный лафетный ствол (серия PS)',
		img: '/assets/products/manual-fire-water-cannon-ps.webp',
		desc: '20–200 л/с, дальность струи до 110 м, вода или пена'
	},
	{
		slug: 'foam-fire-hydrant-cabinet-psg30',
		name: 'Пенный пожарный шкаф (PSG30)',
		img: '/assets/06_extinguishing_cannons/cannon_p42.webp',
		desc: 'Узел пены AFFF 3% для химических и нефтепродуктовых пожаров'
	},
	{
		slug: 'fire-hose-reel-jpso8-19',
		name: 'Комплект пожарного рукавного барабана (JPS0.8-19)',
		img: '/assets/products/fire-hose-reel-jpso8-19.jpg',
		desc: 'Плоский рукав 20–30 м, поворотный кронштейн, быстрый развёртывающийся отклик'
	}
];
---

<Layout
	title="Пожарные лафетные стволы | Автоматический следящий контроль"
	description="Пожарные лафетные стволы WLFE: расход 5–200 л/с, дальность струи до 110 м. Стационарные, дистанционные и автоматические следящие модели для промышленности."
	type="product"
	locale="ru"
	productData={{
		name: 'Пожарные лафетные стволы',
		image: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		description: 'Стационарные, дистанционные и интеллектуальные пожарные лафетные стволы с расходом 5–200 л/с и дальностью до 110 м для промышленной противопожарной защиты, производство Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Пожарные лафетные стволы' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/products/" class="hover:text-blue-600">Продукция</a>
			<span>/</span>
			<span class="text-gray-600">Пожарные лафетные стволы</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Системы пожарных лафетных стволов</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Системы пожарных лафетных стволов для промышленных объектов с повышенным риском</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid выпускает пожарные лафетные стволы с высоким расходом для нефтехимических заводов, СПГ-терминалов, складов и аэропортов — от стационарных ручных мониторов до полностью автономных автоматических следящих стволов с дистанционным и интеллектуальным управлением.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Расход до 200 л/с', 'Дальность до 110 м', 'Поворот 360°', 'Автообнаружение ИК/УФ'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Серии лафетных стволов</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{cannonProducts.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Core tech -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Основные технические характеристики</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Характеристика</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Значение</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Номинальный расход</td>
							<td class="px-4 py-3 text-gray-700">5 – 200 л/с в зависимости от модели (настраивается до 150 л/с для ZDMS)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Дальность струи</td>
							<td class="px-4 py-3 text-gray-700">50 – 110 м в зависимости от модели и давления на входе</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Поворот</td>
							<td class="px-4 py-3 text-gray-700">Горизонтальный 360°, вертикальный от -90° до +70°</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Режимы управления</td>
							<td class="px-4 py-3 text-gray-700">Ручной / Дистанционный (ПК, мобильное приложение, центральный шкаф) / Автоматический (детекция пламени)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Материал корпуса</td>
							<td class="px-4 py-3 text-gray-700">Твёрдоанодированный сплав алюминия T6 / бронза, водный канал из SS304</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Опции</td>
							<td class="px-4 py-3 text-gray-700">Взрывозащищённое исполнение (Exde II BT4 Gb), пеноподготовка</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Область применения</h2>
			<p class="text-gray-700 leading-relaxed">Пожарные лафетные стволы защищают технологические зоны нефтехимических производств, резервуарные парки хранения нефти и СПГ, погрузочные терминалы, крупные склады, аэропортовые ангары и подстанции — объекты с высокими потолками или на открытых площадках, где стационарное пожаротушение должно покрывать большие расстояния в условиях высоких температур.</p>

			<!-- Why WLFE -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Почему выбирают Wanlian Fluid</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Один заказ, одна фабрика</strong> — лафетные стволы отправляются вместе с согласованными клапанами, соединительными головками и гидрантами для полного контура пожаротушения.</li>
				<li><strong>Инженерное проектирование</strong> — рекомендуем дальность, расход и конфигурацию управления исходя из компоновки вашего объекта.</li>
				<li><strong>Сертифицированное качество</strong> — системы качества UL/ULC, FM и ISO 9001; см. нашу <a href="/ru/certificates/" class="text-brand-blue font-semibold hover:underline">страницу сертификатов</a>.</li>
			</ul>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Часто задаваемые вопросы</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Нужен лафетный ствол для вашего объекта?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Отправьте нам компоновку объекта, требуемую дальность и расход — наши инженеры порекомендуют подходящую модель и ответят полным коммерческим предложением в течение 12 часов.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ru/contact/?product=Fire%20Water%20Cannon" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Запросить цену</a>
						<a href="https://wa.me/8618684324501?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5%2C%20%D0%BC%D0%BD%D0%B5%20%D0%BD%D1%83%D0%B6%D0%B5%D0%BD%20%D0%BF%D0%BE%D0%B6%D0%B0%D1%80%D0%BD%D1%8B%D0%B9%20%D0%BB%D0%B0%D1%84%D0%B5%D1%82%D0%BD%D1%8B%D0%B9%20%D1%81%D1%82%D0%B2%D0%BE%D0%BB" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Написать в WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
