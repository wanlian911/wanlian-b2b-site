---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Взаимозаменяемы ли все соединительные головки рукавов DN65 (2,5 дюйма)?',
		answer: 'Нет. Номинальный размер 2,5 дюйма или 65 мм не определяет тип затвора или резьбы. Storz, National, John Morris, Nakajima и головки мгновенного действия требуют ответной части того же типа либо проверенный переходник.'
	},
	{
		question: 'Что такое соединительная головка Storz?',
		answer: 'Storz — это симметричное быстроразъёмное соединение. Проверенное изделие Storz — это алюминиевая головка 2,5 дюйма по немецкому стандарту с автоматически уплотняющейся кромкой, соединением на четверть оборота и ёршиком под напорный рукав.'
	},
	{
		question: 'Когда нужен адаптер к гидрантному соединению?',
		answer: 'Применяйте адаптер там, где стандарт выходного патрубка гидранта отличается от стандарта рукава или ствола. Подтвердите обе присоединяемые части, номинальный размер, уплотнительное кольцо и рабочее давление: адаптер должен устранять конкретное рассогласование на границе, а не скрывать неопределённую спецификацию рукавной линии.'
	},
	{
		question: 'Какое рабочее давление указывать?',
		answer: 'Классифицируйте линию целиком: гидрант, соединительная головка, рукав, ствол и любой адаптер. Проверенные головки Storz и адаптеры серии HS указаны на 1,6 МПа; точные требования по давлению для сборки в целом подтвердите до заказа.'
	},
	{
		question: 'Выбирать алюминий или латунь?',
		answer: 'Алюминий лёгкий и применяется в изделиях Storz и HS этой серии. В заказе должны быть указаны требуемый материал, покрытие, уплотнительное кольцо и условия эксплуатации; любой вариант из латуни или требование по совместимости подтвердите при запросе цены.'
	},
	{
		question: 'Что должно войти в один заказ соединительных головок?',
		answer: 'Укажите стандарт по названию, номинальный размер, ответную часть, присоединение под рукав или резьбу, материал, уплотнение, рабочее давление, длину рукава и присоединение ствола. Образец или габаритный чертёж полезен, когда стандарт местной пожарной охраны не очевиден.'
	}
];

const products = [
	{
		slug: 'storz-coupling-2-5inch-aluminum',
		name: 'Aluminum Storz Fire Coupling (2.5" · German Standard)',
		img: '/assets/products/storz-coupling-2-5inch-aluminum-overlay.png',
		desc: 'Storz по немецкому стандарту, алюминий, 1,6 МПа, авторежим уплотнения, ёршик'
	},
	{
		slug: 'fire-hydrant-hose-coupling-adapter-hs',
		name: 'Aluminum Firefighting Hydrant Hose Coupling Adapter (HS Series)',
		img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg',
		desc: 'DN50 / DN65, внутренняя резьба 2,5 дюйма, 1,6 МПа'
	},
	{
		slug: 'fire-hose-pvc-rubber-lining-8-65',
		name: 'PVC Rubber Lining Layflat Fire Hose (Model 8-65)',
		img: '/assets/products/fire-hose-pvc-rubber-lining-8-65.jpg',
		desc: 'Внутренний диаметр 19–400 мм, стандартный размер головки 65 мм'
	},
	{
		slug: 'adjustable-pistol-grip-fire-nozzle',
		name: 'Adjustable Pistol Grip Firefighting Nozzle',
		img: '/assets/products/adjustable-pistol-grip-fire-nozzle.jpg',
		desc: 'Вход 1,5" / 2" / 2,5", 150–500 л/мин, от струи до распылённой воды'
	}
];
---

<Layout
	title="Соединения Storz и адаптеры пожарных гидрантов | WLFE"
	description="Соединения Storz, рукавные соединительные головки и адаптеры гидрантов: стандарты, материалы, рабочее давление и присоединения стволов для B2B-заказа."
	type="product"
	locale="ru"
	productData={{
		name: 'Рукавные соединительные головки и адаптеры гидрантов',
		image: '/assets/products/storz-coupling-2-5inch-aluminum-overlay.png',
		description: 'Рукавные соединительные головки, соединения Storz, адаптеры к гидрантам, напорные рукава и регулириуемые стволы для сборок пожарных линий.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Рукавные соединения' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/ru/" class="hover:text-blue-600">Главная</a><span>/</span><a href="/ru/products/" class="hover:text-blue-600">Продукция</a><span>/</span><span class="text-gray-600">Рукавные соединения</span></nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Рукавные интерфейсы пожаротушения — напрямую с завода</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Выбор соединительной головки Storz и рукавного соединения</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Рукавное соединительное оборудование корректно только тогда, когда его стандарт, ответная часть, уплотнение, материал и давление согласованы с остальной линией. Wanlian поставляет соединения Storz, адаптеры к гидрантам, напорные рукава и интерфейсы стволов для проектных закупок полного комплекта соединений.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">{['Быстроразъёмное Storz', 'Адаптеры к гидрантам', 'Рукав 19–400 мм', 'Ствол 150–500 л/мин'].map(b => (<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span></div>))}</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Изделия: рукавные соединительные головки</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">{products.map(p => (<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition"><img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" /><div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p><p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p></div></a>))}</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Стандарты соединительных головок и таблица подбора</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5"><table class="min-w-full divide-y divide-gray-200 text-sm"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Точка выбора</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Что подтвердить</th></tr></thead><tbody class="bg-white divide-y divide-gray-200">
				<tr><td class="px-4 py-3 font-bold text-gray-900">Storz</td><td class="px-4 py-3 text-gray-700">Быстроразъёмное соединение Storz по немецкому стандарту; проверенное изделие — 2,5 дюйма, корпус из алюминия, автоматически уплотняющаяся кромка, ёршик и давление 1,6 МПа.</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">National / John Morris / Nakajima / мгновенного действия</td><td class="px-4 py-3 text-gray-700">Считайте каждое из них отдельным интерфейсом. Подтвердите тип, принятый у местной пожарной охраны, и применяйте проверенную ответную головку или адаптер, а не полагайтесь на номинальный размер.</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Адаптер к гидранту</td><td class="px-4 py-3 text-gray-700">Серия HS: размеры DN50 / DN65, внутренняя резьба 2,5 дюйма, анодированный алюминиевый сплав и рабочее давление 1,6 МПа.</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Рукав</td><td class="px-4 py-3 text-gray-700">Модель 8-65 с прорезиненной гидроизоляцией ПВХ: внутренний диаметр 19–400 мм, стандартный размер соединительной головки 65 мм; подтвердите длину, диаметр и присоединения.</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Ствол</td><td class="px-4 py-3 text-gray-700">Ствол с рукояткой пистолетного типа и регулировкой: вход 1,5", 2" или 2,5", алюениевый сплав, 150–500 л/мин и режимы от струи до распылённой воды.</td></tr>
			</tbody></table></div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Что включить в один заказ соединительных головок</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2"><li><strong>Стандарт и ответная часть</strong> — Storz, National, John Morris, Nakajima или мгновенного действия, названные явно для обоих концов.</li><li><strong>Размер и конфигурация присоединения</strong> — номинальный диаметр рукава, размер головки, резьба или ёршик, а также поставляется ли головка отдельно или напрессованной на заводе.</li><li><strong>Материал и уплотнение</strong> — алюминий или иной указанный материал, покрытие, уплотнительное кольцо и рабочая среда, например чистая вода или раствор пенообразователя.</li><li><strong>Согласование линии в целом</strong> — рукав, адаптер, ствол, рабочее давление, длина и интерфейс пожарной охраны рынка назначения.</li></ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Материалы по рукавным соединениям</h2>
			<p class="text-gray-700 leading-relaxed">Перед выпуском спецификации соединительных головок прочитайте раздел о <a href="/ru/products/storz-coupling-2-5inch-aluminum/" class="text-brand-blue font-semibold hover:underline">соединениях Storz этой серии</a>, <a href="/ru/guides/fire-hose-buying-guide/" class="text-brand-blue font-semibold hover:underline">руководство по выбору пожарных рукавов</a> и <a href="/ru/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">руководство по стандартам клапанов гидрантов</a>.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Часто задаваемые вопросы</h2><div class="space-y-4">{faq.map(item => (<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>))}</div>

			<div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white tracking-tight">Нужен согласованный комплект рукавных соединений?</h2><p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Пришлите стандарт соединительных головок, принятый локально, размер рукава и интерфейс ствола — мы подтвердим совместимый комплект и ответим предложением в течение 12 часов.</p><div class="mt-6 flex flex-col sm:flex-row justify-center gap-4"><a href="/ru/contact/?product=%D0%A0%D1%83%D0%BA%D0%B0%D0%B2%D0%BD%D1%8B%D0%B5%20%D1%81%D0%BE%D0%B5%D0%B4%D0%B8%D0%BD%D0%B8%D1%82%D0%B5%D0%BB%D1%8C%D0%BD%D1%8B%D0%B5%20%D0%B3%D0%BE%D0%BB%D0%BE%D0%B2%D0%BA%D0%B8" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Запросить цену</a><a href="https://wa.me/8618684324501?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5%2C%20%D0%BD%D1%83%D0%B6%D0%BD%D1%8B%20%D1%80%D1%83%D0%BA%D0%B0%D0%B2%D0%BD%D1%8B%D0%B5%20%D1%81%D0%BE%D0%B5%D0%B4%D0%B8%D0%BD%D0%B8%D1%82%D0%B5%D0%BB%D1%8C%D0%BD%D1%8B%D0%B5%20%D0%B3%D0%BE%D0%BB%D0%BE%D0%B2%D0%BA%D0%B8" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Чат по WhatsApp</a></div></div></div>
		</article>
	</main>
</Layout>
