---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Что означает листинг UL для пожарных клапанов?',
		answer: 'Листинг UL подтверждает, что клапан соответствует стандартам UL/ULC по противопожарной защите: расход, класс давления и долговечность. Это обеспечивает надёжную работу в системах спринклерного пожаротушения и пожарных стояков. Листинг UL является обязательным требованием для большинства проектов в Северной Америке и многих международных проектов.'
	},
	{
		question: 'Какие пожарные клапаны с листингом UL производит Wanlian?',
		answer: 'Мы производим задвижки, дисковые затворы, обратные клапаны, дренчерные и преакшн-клапаны с фланцевым, канавочным и резьбовым присоединением от DN40 до DN300. Свяжитесь с нашим отделом продаж со спецификацией проекта, чтобы подобрать тип клапана и пакет сертификации.'
	},
	{
		question: 'Можно ли получить сертификат UL до оформления заказа?',
		answer: 'Да. Сертификаты UL/ULC и FM предоставляются по запросу — см. нашу страницу сертификатов; наши инженеры подтвердят точную сертификацию, применимую к вашему рынку поставок, перед расчётом цены.'
	},
	{
		question: 'Какой минимальный заказ (MOQ) и срок производства для пожарных клапанов?',
		answer: 'MOQ зависит от типа и размера клапана — обычно 10–20 единиц на модель стандартных размеров, срок производства 15–30 дней. Принимаются образцовые заказы для испытаний и подтверждения перед отгрузкой.'
	},
	{
		question: 'Поддерживаете ли вы OEM/свой бренд для пожарных клапанов?',
		answer: 'Да, мы поддерживаем OEM/ODM с индивидуальной маркировкой, упаковкой и корректировкой спецификации под требования проекта. Производство выполняется на собственных линиях по системе менеджмента качества ISO 9001.'
	}
];

const valveProducts = [
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Resilient Seat Gate Valve (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'Клин с EPDM-оболокой, герметичное перекрытие, DN50–DN700'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Signal Grooved Wafer Butterfly Valve',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp',
		desc: 'DN80 PN16 с интегрированным выключателем контроля состояния'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'UL/FM OS&Y Gate Valve (Grooved)',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: 'Задвижка UL/FM с выдвижным шпинделем, 2"–10", канавочные концы'
	},
	{
		slug: 'sliding-ball-check-valve-hq41x',
		name: 'Sliding Ball Check Valve (HQ41X)',
		img: '/assets/products/spherical-ball-check-valve-hq44x.webp',
		desc: 'Низкое гидравлическое сопротивление, конструкция с качающимся шаром без засоров'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Deluge Alarm Valve Group (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Мембранный привод, DN50–DN300, быстрое открытие'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Pre-action Alarm System (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Двойной сигнал срабатывания с защитой от отказов для помещений, чувствительных к воде'
	}
];
---

<Layout
	locale="ru"
	title="Пожарные клапаны UL | Производитель WLFE"
	description="Китайский производитель клапанов, сертифицированных UL: задвижки, дисковые затворы, обратные, дренчерные и преакшн-клапаны. Собственные линии, расчёт цены."
	type="product"
	productData={{
		name: 'Пожарные клапаны UL',
		image: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		description: 'Задвижки, дисковые затворы, обратные, дренчерные и преакшн-клапаны, сертифицированные UL для систем противопожарной защиты, от Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Пожарные клапаны UL' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/products/" class="hover:text-blue-600">Продукция</a>
			<span>/</span>
			<span class="text-gray-600">Пожарные клапаны UL</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Клапаны противопожарной защиты, сертифицированные UL</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Пожарные клапаны UL для надёжных систем противопожарной защиты</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid производит задвижки, дисковые затворы, обратные, дренчерные и преакшн-клапаны, сертифицированные UL, для коммерческих и промышленных систем противопожарной защиты. Каждый клапан выпускается на собственных производственных линиях близ Кванджоу по системе качества ISO 9001 — напрямую с завода, со стабильными сроками поставки и полным пакетом сертификационной документации для вашего проекта.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Сертифицирован UL/ULC', 'Одобрен FM', 'ISO 9001:2015', 'Напрямую с завода'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Серии пожарных клапанов</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{valveProducts.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Ключевые характеристики</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Характеристика</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Детали</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Стандарты</td>
							<td class="px-4 py-3 text-gray-700">Сертификация UL/ULC, одобрение FM (зависит от модели и рынка поставок)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Диапазон диаметров</td>
							<td class="px-4 py-3 text-gray-700">DN40 – DN300 (1½" – 12")</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Номинальное давление</td>
							<td class="px-4 py-3 text-gray-700">PN16 / PN25 (зависит от модели)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Материал корпуса</td>
							<td class="px-4 py-3 text-gray-700">Высокопрочный чугун QT450 / WCB / нержавеющая сталь CF8 · CF8M</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Присоединение</td>
							<td class="px-4 py-3 text-gray-700">Фланцевое / с канавками / резьбовое</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Среда</td>
							<td class="px-4 py-3 text-gray-700">Вода, раствор пенообразователя</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Области применения</h2>
			<p class="text-gray-700 leading-relaxed">Наши пожарные клапаны UL устанавливаются в спринклерных системах коммерческих зданий, на промышленных предприятиях, в складах и логистических центрах, центрах обработки данных и противопожарных сетях нефтехимических объектов — везде, где сертифицированное надёжное управление потоком является нормативным требованием.</p>

			<!-- Why WLFE -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Почему выбирают Wanlian Fluid?</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Сертифицированное качество</strong> — сертификаты UL/ULC и FM опубликованы на нашей <a href="/ru/certificates/" class="text-brand-blue font-semibold hover:underline">странице сертификатов</a>, доступна проверка сертификатов перед оформлением заказа.</li>
				<li><strong>Напрямую с завода</strong> — стабильные сроки поставки, поддержка OEM/ODM и инженерная помощь в подборе.</li>
				<li><strong>Один заказ — один завод</strong> — клапаны отгружаются вместе со спринклерными оросителями, гидрантами и аксессуарами для полного контура пожаротушения.</li>
			</ul>

			<!-- Related guide -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Новичок в стандартах арматуры?</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Начните с нашего руководства покупателя: <a href="/ru/" class="text-brand-blue font-semibold hover:underline">Стандарты клапанов, рукавов и гидрантов: полное объяснение</a>.</p>
			</div>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Часто задаваемые вопросы</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Нужны пожарные клапаны UL для вашего проекта?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Пришлите нам тип клапана, DN/PN и целевую сертификацию — наши инженеры ответят полным техническим паспортом и коммерческим предложением в течение 12 часов.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ru/contact/?product=UL%20Fire%20Valves" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Запросить цену</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20UL%20listed%20fire%20valves" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Чат в WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
