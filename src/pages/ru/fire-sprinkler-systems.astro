---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Сертифицированы ли ваши спринклерные оросители UL?',
		answer: 'Да. Наши спринклерные оросители и компоненты систем сертифицированы UL/ULC, где это требуется — сертификаты доступны на нашей странице Certificates. Наши инженеры подтверждают точный пакет сертификации для вашего рынка сбыта до оформления коммерческого предложения.'
	},
	{
		question: 'В чём разница между системами мокрого и сухого спринклерного пожаротушения?',
		answer: 'В системах мокрого типа вода постоянно находится в трубах, поэтому при срабатывании оросителя подача начинается немедленно. Системы сухого типа используют сжатый воздух или азот с сухотрубным клапаном, что делает их подходящими для неотапливаемых помещений с риском замерзания труб. Системы предварительного действия (преакшн) сочетают преимущества обоих типов для помещений, чувствительных к воде.'
	},
	{
		question: 'Поставляете ли вы гибкие подвесные соединения для спринклеров?',
		answer: 'Да, мы производим гибкие подвесные соединения в стальной нержавеющей оплётке, которые упрощают монтаж и позволяют быстро перемещать спринклерные оросители с учётом планировки потолка, сокращая трудозатраты по сравнению с жёсткой трубопроводной разводкой.'
	},
	{
		question: 'Можете ли вы составить коммерческое предложение по полной BOM-спецификации системы?',
		answer: 'Да. Пришлите нам чертежи проекта или перечень компонентов — мы оценим оросители, сигнальные клапаны, сигнализаторы потока, фильтры и аксессуары единым пакетом: один заводской заказ на весь контур спринклерной системы.'
	},
	{
		question: 'Какие классификации по температуре доступны?',
		answer: 'Стандартные классификации стеклянных колб: 57 °C, 68 °C, 79 °C, 93 °C и 141 °C с цветовым кодированием колб, в исполнениях стандартного (колба 5 мм) и быстрой (колба 3 мм) реакции согласно практике NFPA.'
	}
];

const sprinklerProducts = [
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'Glass Bulb Fire Sprinkler (ZST Series)',
		img: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		desc: 'Подвесной/напольный/настенный, K=80/115, 57–141 °C'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Wet Alarm Check Valve (ZSFZ 150)',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'Гидравлический сигнал, камера задержки, DN100–DN200'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Deluge Alarm Valve Group (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Мембранный привод, для дренчерных систем и систем водяного распыления'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Pre-action Alarm System (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Двойное срабатывание с защитой от отказов: библиотеки, архивы, дата-центры'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Vane Type Water Flow Indicator (ZSJZ)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'Регулируемая задержка 2–60 с, DN50–DN200, седельный или фланцевый монтаж'
	},
	{
		slug: 'telescopic-y-strainer-sgl41h',
		name: 'Telescopic Y-Strainer (SGL41H)',
		img: '/assets/products/telescopic-y-strainer-sgl41h.webp',
		desc: 'Защита клапанов от частиц, сетка SS304/316'
	}
];
---

<Layout
	title="Системы спринклерного пожаротушения и UL оросители - WLFE"
	description="Спринклерные оросители UL, гибкие соединения и полные компоненты систем спринклерного пожаротушения для коммерческих и промышленных зданий. Заводские цены."
	type="product"
	locale="ru"
	productData={{
		name: 'Системы спринклерного пожаротушения',
		image: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		description: 'Сертифицированные UL спринклерные оросители, сигнальные клапаны, сигнализаторы потока и компоненты систем мокрого, сухого и предварительного действия (преакшн) для коммерческих и промышленных зданий, производство — Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Системы спринклерного пожаротушения' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/products/" class="hover:text-blue-600">Продукция</a>
			<span>/</span>
			<span class="text-gray-600">Системы спринклерного пожаротушения</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Полные системы спринклеров — напрямую с завода</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Полные системы спринклерного пожаротушения с компонентами, сертифицированными UL</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid производит и экспортирует сертифицированные UL спринклерные оросители, гибкие подвесные соединения, сигнальные клапаны и аксессуары систем для установок мокрого, сухого и предварительного действия (преакшн) в коммерческих и промышленных зданиях — один заводской заказ на весь контур спринклерной системы.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Сертификаты UL/ULC', 'K=80 / K=115', 'Классы 57–141 °C', 'Полная BOM системы'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Компоненты систем спринклеров</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{sprinklerProducts.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Основные характеристики</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Параметр</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Значение</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Сертификация</td>
							<td class="px-4 py-3 text-gray-700">UL/ULC (по модели и рынку сбыта)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Размеры оросителей</td>
							<td class="px-4 py-3 text-gray-700">1/2" (DN15), 3/4" (DN20), 1" — подвесные, напольные, настенные</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Коэффициент расхода</td>
							<td class="px-4 py-3 text-gray-700">K=80 ±4 / K=115 ±9 (другие коэффициенты K по моделям)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Классификации по температуре</td>
							<td class="px-4 py-3 text-gray-700">57 °C / 68 °C / 79 °C / 93 °C / 141 °C, стеклянные колбы с цветовым кодированием</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Типы реакции</td>
							<td class="px-4 py-3 text-gray-700">Стандартная реакция (колба 5 мм) / быстрая реакция (колба 3 мм)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Клапаны системы</td>
							<td class="px-4 py-3 text-gray-700">Мокрый сигнальный обратный (ZSFZ), дренчерный (ZSFM), преакшн (ZSFY), сигнализаторы потока (ZSJZ)</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Применение</h2>
			<p class="text-gray-700 leading-relaxed">Компоненты наших спринклерных систем защищают коммерческие офисные здания, отели, больницы, школы, заводы, склады, дата-центры и подземные парковки. Системы предварительного действия (преакшн) рекомендуются для библиотек, архивов и машинных залов, где необходимо избежать случайного сброса воды.</p>

			<!-- Why WLFE -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Почему выбирают Wanlian Fluid?</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Полная система — один заказ</strong> — оросители, соединения, сигнальные клапаны и аксессуары оцениваются единым пакетом с одного завода.</li>
				<li><strong>Сертифицированные компоненты</strong> — сертификация UL/ULC, где это требуется; сертификаты на нашей <a href="/ru/certificates/" class="text-brand-blue font-semibold hover:underline">странице Certificates</a>.</li>
				<li><strong>Ориентация на строительные нормативы</strong> — конфигурации в соответствии с практикой NFPA для приёмки проектов по всему миру.</li>
			</ul>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Часто задаваемые вопросы</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Нужны компоненты спринклерной системы?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Пришлите тип здания и перечень компонентов: мы ответим полным коммерческим предложением по BOM в течение 12 часов.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ru/contact/?product=Fire%20Sprinkler%20Systems" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Запросить цену</a>
						<a href="https://wa.me/8618684324501?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5%2C%20%D0%BC%D0%BD%D0%B5%20%D0%BD%D1%83%D0%B6%D0%BD%D1%8B%20%D0%BA%D0%BE%D0%BC%D0%BF%D0%BE%D0%BD%D0%B5%D0%BD%D1%82%D1%8B%20%D1%81%D0%B8%D1%81%D1%82%D0%B5%D0%BC%20%D1%81%D0%BF%D1%80%D0%B8%D0%BD%D0%BA%D0%BB%D0%B5%D1%80%D0%BD%D0%BE%D0%B3%D0%BE%20%D0%BF%D0%BE%D0%B6%D0%B0%D1%80%D0%BE%D1%82%D1%83%D1%88%D0%B5%D0%BD%D0%B8%D1%8F" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Чат по WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
