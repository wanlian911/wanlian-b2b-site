---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'В чём разница между внутренними и наружными пожарными гидрантами?',
		answer: 'Внутренние гидранты (головка SN65) подключаются к системам пожарных стояков здания и подают воду к пожарным кранам на каждом этаже. Наружные гидранты (колонка SS100) берут воду из городских или промышленных сетей и подают её пожарным машинам и наружному тушению. Оба варианта обслуживают разные точки распределения и нормируются по различным стандартам.'
	},
	{
		question: 'Какие стандарты присоединения выводов доступны для экспортных гидрантов?',
		answer: 'Наиболее распространённые типы присоединения выводов: BS336 (Великобритания/страны Содружества), NIST (Ближний Восток), KWS (Германия) и фланцевые варианты. Wanlian производит гидранты SS100/65 и SSFT100/65 с типом присоединения, указанным для вашего рынка, и может отправить соответствующие муфты и переходники в том же контейнере.'
	},
	{
		question: 'Доступны ли гидранты Wanlian с сертификацией UL или FM?',
		answer: 'Да, в зависимости от модели и рынка сбыта. Свяжитесь с нашим отделом продаж с указанием спецификации проекта и целевого региона — мы подберём нужный пакет сертификации: UL/FM для Северной Америки, CE для Европы, LPCB для проектов Великобритании и стран Содружества.'
	},
	{
		question: 'Какой гидрант выбрать для города с холодным климатом?',
		answer: 'Наружный гидрант SS100 оснащён автоматическим сливным механизмом сухой колонки после закрытия, что исключает замерзание и разрыв колонки: стандартный выбор для городских сетей в холодных регионах. Для мест, подверженных воздействию транспорта, антивандальная модификация SSFT100 добавляет разрывной корпус и регулирование давления.'
	},
	{
		question: 'Можно ли интегрировать умные гидранты с нашей системой SCADA?',
		answer: 'Да. IoT-гидрант SS100ZN передаёт данные о давлении, наклоне и состоянии клапана по каналам NB-IoT/LTE-M/GPRS и интегрируется со стандартными платформами SCADA. Запросите спецификацию интерфейса данных и образцовое устройство для испытаний на интеграцию перед оформлением заказа.'
	}
];

const hydrantProducts = [
	{
		slug: 'indoor-fire-hydrant-head-sn65',
		name: 'Indoor Fire Hydrant Head SN65',
		img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg',
		desc: 'Внутренний гидрант из ВЧШГ PN16 для систем пожарных стояков'
	},
	{
		slug: 'overground-fire-hydrant-ss100',
		name: 'Overground Antifreeze Fire Hydrant (SS100/65)',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'Сухая колонка с антифризной защитой для городских сетей в холодном климате'
	},
	{
		slug: 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100',
		name: 'Anti-Collision Pressure-Regulating Hydrant (SSFT100/65)',
		img: '/assets/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100.webp',
		desc: 'Разрывной корпус + регулирование давления для промышленных площадок и зон движения'
	},
	{
		slug: 'iot-smart-ground-fire-hydrant-ss100zn',
		name: 'IoT Smart Ground Fire Hydrant (SS100/65-1.6ZN)',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'Мониторинг давления, наклона и утечек в реальном времени для «умных» сетей'
	},
	{
		slug: 'fire-hydrant-hose-coupling-adapter-hs',
		name: 'Aluminum Hose Coupling Adapter (HS Series)',
		img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg',
		desc: 'Муфты, совместимые с BS336/NIST/KWS, для соединения гидранта с рукавом'
	}
];

const trustBadges = ['Испытано PN16 / 2,4 МПа', 'BS336 / NIST / KWS', 'Сухая колонка, антифризная защита', 'Готово для IoT / SCADA'];
---

<Layout
	title="Системы пожарных гидрантов и муниципальные гидранты - WLFE"
	description="Системы пожарных гидрантов: внутренние головки SN65, наружные SS100, антивандальные SSFT100 и умные IoT SS100ZN. PN16, заводские цены, экспортные соединения."
	type="product"
	locale="ru"
	productData={{
		name: 'Системы пожарных гидрантов',
		image: '/assets/products/overground-fire-hydrant-ss100.webp',
		description: 'Внутренние и наружные пожарные гидранты и умные гидрантовые системы для городских сетей, промышленных площадок и пожарных стояков зданий, производство — Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Системы пожарных гидрантов' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/ru/" class="hover:text-blue-600">Главная</a>
			<span>/</span>
			<a href="/ru/products/" class="hover:text-blue-600">Продукция</a>
			<span>/</span>
			<span class="text-gray-600">Системы пожарных гидрантов</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Полный ассортимент гидрантов — собственное производство</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Полные системы пожарных гидрантов для городских и промышленных сетей</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid производит полный ассортимент пожарных гидрантов — внутренние головки SN65, наружные гидранты SS100, антивандальные гидранты SSFT100 и умные IoT-гидранты SS100ZN — с экспортными стандартами присоединения (BS336, NIST, KWS) и соответствующими муфтами; всё производится на собственных линиях для всей сети гидрантов.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Компоненты систем пожарных гидрантов</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydrantProducts.map(p => (
					<a href={`/ru/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Основные характеристики</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Модель</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Тип</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Ключевая особенность</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Классификация</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SN65</td>
							<td class="px-4 py-3 text-gray-700">Внутренняя головка гидранта</td>
							<td class="px-4 py-3 text-gray-700">Вход с канавками или фланцевый, монтаж в настенном шкафу</td>
							<td class="px-4 py-3 text-gray-700">PN16 (испытано при 2,4 МПа)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SS100/65</td>
							<td class="px-4 py-3 text-gray-700">Наружный гидрант</td>
							<td class="px-4 py-3 text-gray-700">Автоматический антифризный слив сухой колонки</td>
							<td class="px-4 py-3 text-gray-700">PN16, выводы 2×65 мм + 1×100 мм</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SSFT100/65</td>
							<td class="px-4 py-3 text-gray-700">Антивандальный гидрант</td>
							<td class="px-4 py-3 text-gray-700">Разрывной корпус + регулирование давления + автослив</td>
							<td class="px-4 py-3 text-gray-700">PN16, калиброванные срезные болты</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SS100ZN</td>
							<td class="px-4 py-3 text-gray-700">Умный IoT-гидрант</td>
							<td class="px-4 py-3 text-gray-700">NB-IoT/4G, мониторинг давления, наклона и утечек</td>
							<td class="px-4 py-3 text-gray-700">GB4452-2011, батарея на 5 лет</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Применение</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Городские сети водоснабжения и противопожарные магистрали</li>
				<li>Промышленные площадки, хранилища резервуаров и пожаротушение складов</li>
				<li>Пожарные стояки и рукавные системы зданий (внутренние головки гидрантов)</li>
				<li>«Умные» городские сети с требованиями к удалённому мониторингу</li>
				<li>Объекты в холодном климате, требующие защиты от замерзания</li>
			</ul>

			<!-- FAQ Section -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Часто задаваемые вопросы</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Нужна сеть гидрантов, рассчитанная под ваш проект?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Пришлите ваши Ду/Ру, стандарт присоединения и целевую сертификацию: наши инженеры ответят полным техническим паспортом и коммерческим предложением в течение 12 часов.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/ru/contact/?product=Fire%20Hydrant%20System" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Запросить цену</a>
						<a href="https://wa.me/8618684324501?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5%2C%20%D0%BC%D0%BD%D0%B5%20%D0%BD%D1%83%D0%B6%D0%BD%D0%B0%20%D0%BF%D0%BE%D0%BC%D0%BE%D1%89%D1%8C%20%D0%B2%20%D0%B2%D1%8B%D0%B1%D0%BE%D1%80%D0%B5%20%D1%81%D0%B8%D1%81%D1%82%D0%B5%D0%BC%D1%8B%20%D0%BF%D0%BE%D0%B6%D0%B0%D1%80%D0%BD%D1%8B%D1%85%20%D0%B3%D0%B8%D0%B4%D1%80%D0%B0%D0%BD%D1%82%D0%BE%D0%B2" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Чат по WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
