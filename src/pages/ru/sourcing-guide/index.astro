---
import Layout from '../../../layouts/Layout.astro';

const faq = [
  {
    question: 'Сколько длится весь процесс закупки — от спецификации до отгрузки?',
    answer: 'Для моделей на складе обычно это несколько недель: спецификация и цена в течение нескольких дней, образец — 1–3 недели, независимая инспекция перед производством, затем производство и погрузка контейнера. Позиции OEM или с индивидуальной маркировкой добавляют время на оснастку и маркировку. Wanlian Fluid отвечает на полную спецификацию в течение 12 часов, что держит начальные этапы на плотном графике.'
  },
  {
    question: 'Какие документы должен приложить к отгрузке китайский поставщик арматуры и пожарного оборудования?',
    answer: 'Минимальный набор: коммерческий счёт, упаковочный лист, коносамент (B/L), сертификат происхождения и записи испытаний корпуса давлением и герметичности воздухом по лотам/единицам, которые совпадают с серийными номерами в упаковочном листе. Добавьте сертификаты на материал (милл-сертификаты) и любые требуемые сертификаты по стандартам. Полный и согласованный пакет документов сам по себе — индикатор качества.'
  },
  {
    question: 'Стоит ли заказать образец до крупного партии?',
    answer: 'Для противопожарного оборудования, критичного для безопасности, — да. Одна образцовая единица каждой модели позволяет проверить табличку, серийный номер, материал и видео испытания давлением с серийным номером против вашей спецификации до решения о партии. Это самая дешёвая страховка от подделок и рисков спецификации.'
  },
  {
    question: 'Как сравнить цену от китайского производителя с ценой местного дистрибьютора?',
    answer: 'Сравнивайте в сопоставимой базе: одна и та же модель, стандарт, материал, количество и инкотерм. Сначала используйте инструмент относительного планирования, чтобы оценить факторы стоимости (объём, инкотерм, место назначения), затем запросите детальные цены у обоих. Учитывайте полную стоимость на месте и риск координации арматуры, гидрантов и рукавов от нескольких поставщиков.'
  }
];

const steps = [
  {
    n: '01',
    title: 'Зафиксируйте спецификацию письменно',
    body: 'Укажите стандарт (AWWA, ISO 5208, NFPA, NOM или требование тендера), размеры, классы давления, материалы, количества и место назначения. Неопределённость на этом этапе — самый дорогой дефект дальше. Начните с общего словаря в отраслевом глоссарии, чтобы ваша спецификация, тендер и поставщик имели в виду одно и то же.',
    links: [
      { label: 'Отраслевой глоссарий', href: '/ru/glossary/' },
      { label: 'Руководство по стандартам гидрантов, рукавов и арматуры', href: '/ru/guides/fire-hydrant-valve-standards-guide/' }
    ]
  },
  {
    n: '02',
    title: 'Оцените и проверьте поставщика',
    body: 'Подтвердите юридическое лицо, область применения ISO 9001, экспортную историю и производственные мощности завода. Проведите процесс проверки, чтобы исключить риск подделок: запросите записи испытаний по каждой единице, сверьте сертификаты в выдающем органе и попросите образец. Поставщик, который сопротивляется проверке, уже ответил на вопрос.',
    links: [
      { label: 'Чек-лист B2B-закупок арматуры', href: '/ru/guides/b2b-valve-sourcing-checklist/' },
      { label: 'Как проверить китайского поставщика арматуры', href: '/ru/guides/how-to-verify-chinese-valve-supplier/' },
      { label: 'Как выявить поддельные клапаны и поддельные сертификаты', href: '/ru/guides/detect-fake-valves-fire-equipment-counterfeits/' }
    ]
  },
  {
    n: '03',
    title: 'Запросите и сравните детальные цены',
    body: 'Запросите детальную цену по каждой модели — а не одну смешанную сумму — и сравнивайте в сопоставимой базе по стандарту, материалу, количеству и инкотерму. Используйте калькулятор относительных затрат, чтобы оценить влияние объёма, торгового условия и места назначения, прежде чем выносить бюджет на согласование в команде.',
    links: [
      { label: 'Калькулятор затрат (относительный индекс)', href: '/ru/cost-calculator/' },
      { label: 'Требования к сертификации пожарной арматуры', href: '/ru/guides/latinamerica-certification-requirements-fire-valves/' }
    ]
  },
  {
    n: '04',
    title: 'Закажите образец и проведите инспекцию',
    body: 'Купите по одной единице каждой модели. Проверьте табличку, серийный номер, марку материала и видео испытания давлением с серийным номером против вашей спецификации. Для заказов партиями назначьте независимую организацию (SGS, Bureau Veritas, Intertek), чтобы присутствовать при испытаниях и проверить записи на заводе до отгрузки.',
    links: [
      { label: 'Как выбрать пожарный гидрант', href: '/ru/guides/how-to-choose-a-fire-hydrant/' }
    ]
  },
  {
    n: '05',
    title: 'Производство, контроль качества и документация',
    body: 'Согласуйте производственный график, затем потребуйте пакет документов до финальной оплаты: коммерческий счёт, упаковочный лист, сертификат происхождения и записи испытаний корпуса давлением и герметичности по каждой единице, согласованные с серийными номерами в упаковочном листе. Маркировка OEM/ODM и экспортная упаковка выполняются на этом этапе.',
    links: [
      { label: 'Wanlian Fluid — завод и испытания', href: '/ru/about/' }
    ]
  },
  {
    n: '06',
    title: 'Логистика, инкотермы и послепродажное обслуживание',
    body: 'Выберите инкотерм, соответствующий вашему распределению рисков и затрат (EXW, FOB, CIF, DDP), согласуйте погрузку контейнера и храните записи испытаний и сертификаты для приёмки и будущего обслуживания. Настройте чёткий канал по гарантии, запчастям и повторным заказам.',
    links: [
      { label: 'Запросить цену', href: '/ru/contact/' }
    ]
  }
];
---

<Layout
  title="Гид по закупке пожарной арматуры и гидрантов | Wanlian Fluid"
  description="Полный путь B2B-закупок пожарной арматуры, гидрантов и рукавов: спецификация, проверка поставщика, образцы, контроль качества, документы и логистика."
  type="website"
  locale="ru"
  faq={faq}
  breadcrumbs={[{ name: 'Ресурсы' }, { name: 'Гид по закупкам' }]}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
    <nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
      <a href="/ru/" class="hover:text-blue-600">Главная</a>
      <span>/</span>
      <span class="text-gray-600">Гид по закупкам</span>
    </nav>

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
      <p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Центр закупок</p>
      <h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Закупка пожарной арматуры, гидрантов и пожарного оборудования: весь путь</h1>
      <p class="mt-5 text-gray-600 leading-relaxed text-lg">Пошаговый B2B-маршрут закупок пожарной арматуры, гидрантов и рукавов у китайского производителя — от письменной спецификации до послепродажного обслуживания. Каждый этап связан с руководствами, инструментами и документами, которые помогают снизить риски решения. Используйте как чек-лист и как общий справочник с инженерной и закупочной командами.</p>

      <div class="bg-blue-50 border border-blue-100 rounded-xl p-5 my-6">
        <p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-blue">Зачем единый маршрут:</strong> закупка пожарного оборудования чаще всего терпит неудачу на стыках — между спецификацией, проверкой, образцами и документацией, — а не на каком-то одном шаге. Прохождение шести этапов ниже по порядку, со связанными руководствами, ловит риск до движения денег.</p>
      </div>

      {steps.map(s => (
        <section class="mt-10">
          <h2 id={`step-${s.n}`} class="text-2xl font-black text-gray-900 mb-3 tracking-tight scroll-mt-24 flex items-center gap-3">
            <span class="text-brand-red text-2xl tabular-nums">{s.n}</span>{s.title}
          </h2>
          <p class="text-gray-700 leading-relaxed mb-3">{s.body}</p>
          <div class="flex flex-wrap gap-2">
            {s.links.map(l => (
              <a href={l.href} class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 hover:bg-brand-blue/10 text-gray-700 hover:text-brand-blue text-xs font-bold rounded-full transition">{l.label} →</a>
            ))}
          </div>
        </section>
      ))}

      <h2 id="documentation" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">Документы для запроса на каждом этапе</h2>
      <div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Этап</th>
              <th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Запросить</th>
              <th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Почему это важно</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <tr><td class="px-4 py-3 font-bold text-gray-900">Спецификация</td><td class="px-4 py-3 text-gray-700">Стандарт письменно, размеры, классы, количества, место назначения</td><td class="px-4 py-3 text-gray-700">Делает соответствие договорным, а не просительным</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">Проверка</td><td class="px-4 py-3 text-gray-700">Лицензия на деятельность, область ISO 9001, видео завода, номера сертификатов</td><td class="px-4 py-3 text-gray-700">Исключает торговых посредников и поддельные сертификаты</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">Образец</td><td class="px-4 py-3 text-gray-700">Записи испытаний по единице, MTC, видео испытания давления с серийным номером</td><td class="px-4 py-3 text-gray-700">Подтверждает реальное изделие до партии</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">Производство</td><td class="px-4 py-3 text-gray-700">График, записи испытаний по лоту, образцы маркировки OEM</td><td class="px-4 py-3 text-gray-700">Фиксирует график и бренд до погрузки</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">Отгрузка</td><td class="px-4 py-3 text-gray-700">Счёт, упаковочный лист, B/L, сертификат происхождения, сверенные серийные номера</td><td class="px-4 py-3 text-gray-700">Обеспечивает таможню, приёмку и прослеживаемость</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">После продажи</td><td class="px-4 py-3 text-gray-700">Условия гарантии, канал запчастей, цены на повторные заказы</td><td class="px-4 py-3 text-gray-700">Держит проект на поддержке весь срок эксплуатации</td></tr>
          </tbody>
        </table>
      </div>

      <h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Частые вопросы</h2>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>

      <div class="mt-12 rounded-2xl overflow-hidden">
        <div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
          <h2 class="text-2xl font-black text-white tracking-tight">Начните закупку с ценой в течение 12 часов</h2>
          <p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Пришлите спецификацию и место назначения — ответим детальной ценой, подходом к испытаниям по модели и вариантами логистики в течение 12 часов.</p>
          <div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
            <a href="/ru/contact/?product=%D0%97%D0%B0%D0%BA%D1%83%D0%BF%D0%BE%D1%87%D0%BD%D1%8B%D0%B9%20%D0%BF%D1%80%D0%BE%D0%B5%D0%BA%D1%82" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Запросить цену</a>
            <a href="https://wa.me/8618684324501?text=%D0%97%D0%B4%D1%80%D0%B0%D0%B2%D1%81%D1%82%D0%B2%D1%83%D0%B9%D1%82%D0%B5%2C%20%D1%8F%20%D0%B7%D0%B0%D0%BA%D1%83%D0%BF%D0%B0%D1%8E%20%D0%BF%D0%BE%D0%B6%D0%B0%D1%80%D0%BD%D1%8B%D0%B5%20%D0%BA%D0%BB%D0%B0%D0%BF%D0%B0%D0%BD%D1%8B%2C%20%D0%B3%D0%B8%D0%B4%D1%80%D0%B0%D0%BD%D1%82%D1%8B%20%D0%B8%20%D1%80%D1%83%D0%BA%D0%B0%D0%B2%D0%B0%2C%20%D0%BF%D1%80%D0%B8%D1%88%D0%BB%D0%B8%D1%82%D0%B5%2C%20%D0%BF%D0%BE%D0%B6%D0%B0%D0%BB%D1%83%D0%B9%D1%81%D1%82%D0%B0%2C%20%D0%BA%D0%BE%D0%BC%D0%BC%D0%B5%D1%80%D1%87%D0%B5%D1%81%D0%BA%D0%BE%D0%B5%20%D0%BF%D1%80%D0%B5%D0%B4%D0%BB%D0%BE%D0%B6%D0%B5%D0%BD%D0%B8%D0%B5" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Чат в WhatsApp</a>
          </div>
        </div>
      </div>
    </article>
  </main>
</Layout>
