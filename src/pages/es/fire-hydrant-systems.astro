---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: '¿Cuál es la diferencia entre los hidrantes contra incendios interiores y exteriores?',
		answer: 'Los hidrantes interiores (cabezal SN65) se conectan al sistema de montantes del edificio y alimentan las estaciones de manguera de cada planta. Los hidrantes exteriores (SS100 de columna) toman agua de las redes municipales o industriales y abastecen a los camiones de bomberos y a la extinción exterior. Ambos sirven puntos de distribución distintos y se especifican según normativas diferentes.'
	},
	{
		question: '¿Qué estándares de conexión de salida están disponibles para hidrantes de exportación?',
		answer: 'Las conexiones de salida más comunes incluyen BS336 (Reino Unido/Commonwealth), NIST (Medio Oriente), KWS (Alemania) y opciones de brida flexible. Wanlian suministra hidrantes SS100/65 y SSFT100/65 con el tipo de conexión especificado para su mercado, y puede despachar acoples y adaptadores compatibles en el mismo contenedor.'
	},
	{
		question: '¿Los hidrantes Wanlian están disponibles con certificación UL o FM?',
		answer: 'Sí, según el modelo y el mercado de destino. Contacte a nuestro equipo de ventas con la especificación de su proyecto y la región objetivo para asignarle el paquete de certificación correcto: UL/FM para Norteamérica, CE para Europa y LPCB para proyectos del Reino Unido/Commonwealth.'
	},
	{
		question: '¿Qué hidrante debo elegir para una ciudad de clima frío?',
		answer: 'El hidrante exterior SS100 incorpora un mecanismo automático de drenaje de columna seca tras el cierre que evita la congelación y el estallido de la columna: la opción estándar para redes municipales en regiones frías. Para ubicaciones expuestas al tráfico, la variante anticolisión SSFT100 añade un cuerpo rompible y regulación de presión.'
	},
	{
		question: '¿Los hidrantes inteligentes pueden integrarse con nuestro sistema SCADA?',
		answer: 'Sí. El hidrante IoT SS100ZN transmite datos de presión, inclinación y estado de la válvula mediante NB-IoT/LTE-M/GPRS y se integra con plataformas SCADA estándar. Solicite la especificación de la interfaz de datos y una unidad de muestra para realizar pruebas de integración antes de ordenar.'
	}
];

const hydrantProducts = [
	{
		slug: 'indoor-fire-hydrant-head-sn65',
		name: 'Indoor Fire Hydrant Head SN65',
		img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg',
		desc: 'Hidrante interior de hierro dúctil PN16 para sistemas de montantes'
	},
	{
		slug: 'overground-fire-hydrant-ss100',
		name: 'Overground Antifreeze Fire Hydrant (SS100/65)',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'Diseño de columna seca anticongelante para redes municipales de clima frío'
	},
	{
		slug: 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100',
		name: 'Anti-Collision Pressure-Regulating Hydrant (SSFT100/65)',
		img: '/assets/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100.webp',
		desc: 'Cuerpo rompible + regulación de presión para patios industriales y zonas de tráfico'
	},
	{
		slug: 'iot-smart-ground-fire-hydrant-ss100zn',
		name: 'IoT Smart Ground Fire Hydrant (SS100/65-1.6ZN)',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'Monitoreo en tiempo real de presión, inclinación y hurto de agua para redes inteligentes'
	},
	{
		slug: 'fire-hydrant-hose-coupling-adapter-hs',
		name: 'Aluminum Hose Coupling Adapter (HS Series)',
		img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg',
		desc: 'Acoples compatibles BS336/NIST/KWS para la conexión hidrante-manguera'
	}
];

const trustBadges = ['Probado PN16 / 2.4 MPa', 'BS336 / NIST / KWS', 'Columna seca anticongelante', 'Listo para IoT / SCADA'];
---

<Layout
	title="Sistemas de Hidrantes Contra Incendios - WLFE"
	description="Sistemas de hidrantes contra incendios: cabezales interiores SN65, exteriores SS100, anticolisión SSFT100 e IoT SS100ZN. PN16, precio de fábrica y conexiones de exportación."
	type="product"
	locale="es"
	productData={{
		name: 'Sistemas de Hidrantes Contra Incendios',
		image: '/assets/products/overground-fire-hydrant-ss100.webp',
		description: 'Válvulas de hidrantes contra incendios interiores y exteriores y sistemas de hidrantes inteligentes para redes municipales, patios industriales y sistemas de montantes de edificios, fabricados por Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Sistemas de Hidrantes Contra Incendios' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/es/" class="hover:text-blue-600">Inicio</a>
			<span>/</span>
			<a href="/es/products/" class="hover:text-blue-600">Productos</a>
			<span>/</span>
			<span class="text-gray-600">Sistemas de Hidrantes Contra Incendios</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Suministro Completo de Hidrantes Contra Incendios</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Sistemas completos de hidrantes contra incendios para redes municipales e industriales</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid suministra la gama completa de hidrantes contra incendios — cabezales de hidrante interior SN65, hidrantes exteriores SS100, hidrantes anticolisión SSFT100 e hidrantes inteligentes IoT SS100ZN — con estándares de conexión de exportación (BS336, NIST, KWS) y acoples compatibles: un solo proveedor para toda la red de hidrantes.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Componentes de Sistemas de Hidrantes</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydrantProducts.map(p => (
					<a href={`/es/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Especificaciones Clave</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Modelo</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Tipo</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Característica clave</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Clasificación</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SN65</td>
							<td class="px-4 py-3 text-gray-700">Cabezal de hidrante interior</td>
							<td class="px-4 py-3 text-gray-700">Entrada ranurada o con brida, montaje en gabinete de pared</td>
							<td class="px-4 py-3 text-gray-700">PN16 (probado a 2.4 MPa)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SS100/65</td>
							<td class="px-4 py-3 text-gray-700">Hidrante exterior</td>
							<td class="px-4 py-3 text-gray-700">Drenaje automático de columna seca anticongelante</td>
							<td class="px-4 py-3 text-gray-700">PN16, salidas 2×65 mm + 1×100 mm</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SSFT100/65</td>
							<td class="px-4 py-3 text-gray-700">Hidrante anticolisión</td>
							<td class="px-4 py-3 text-gray-700">Cuerpo rompible + regulación de presión + autodrenaje</td>
							<td class="px-4 py-3 text-gray-700">PN16, pernos de corte calibrados</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SS100ZN</td>
							<td class="px-4 py-3 text-gray-700">Hidrante inteligente IoT</td>
							<td class="px-4 py-3 text-gray-700">NB-IoT/4G, monitoreo de presión, inclinación y hurto</td>
							<td class="px-4 py-3 text-gray-700">GB4452-2011, batería de 5 años</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplicaciones</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Redes municipales de suministro de agua y tuberías principales de protección contra incendios</li>
				<li>Patios industriales, parques de tanques y extinción de incendios en almacenes</li>
				<li>Sistemas de montantes y mangueras en edificios (cabezales de hidrante interior)</li>
				<li>Redes de ciudades inteligentes con requisitos de monitoreo remoto</li>
				<li>Instalaciones en climas fríos que requieren protección anticongelante</li>
			</ul>

			<!-- FAQ Section -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Preguntas Frecuentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">¿Necesita una red de hidrantes especificada para su proyecto?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envíenos su DN/PN, estándar de conexión y certificación objetivo: nuestros ingenieros le responderán con una ficha técnica completa y una cotización en un plazo de 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/es/contact/?product=Fire%20Hydrant%20System" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotización</a>
						<a href="https://wa.me/8618684324501?text=Hola%2C%20necesito%20ayuda%20para%20seleccionar%20un%20sistema%20de%20hidrantes%20contra%20incendios" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chatear por WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
