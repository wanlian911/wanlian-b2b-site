---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: '¿Suministran la bomba contraincendios en sí?',
		answer: 'No. Wanlian suministra el adaptador, las válvulas y los equipos de conexión relacionados alrededor del conjunto de bombeo suministrado por terceros. El proveedor de la bomba aporta la selección y la curva certificada; nosotros usamos esas entradas de proyecto para coordinar los componentes del entorno.'
	},
	{
		question: '¿Qué es un adaptador siamés de bomba contraincendios?',
		answer: 'El adaptador de bomba SQD100-1.6 es una conexión siamesa para el cuerpo de bomberos con dos tomas DN65 y una salida bridada DN100, más una válvula de control integrada, para inyectar agua del camión de bomberos a la red de protección contra incendios.'
	},
	{
		question: '¿Qué válvula va en el lado de aspiración de la bomba?',
		answer: 'La disposición de aspiración la fijan el diseño aprobado de la sala de bombas y la autoridad competente. El aislamiento se mantiene normalmente totalmente abierto durante la operación de la bomba; confirme el tipo, tamaño y conexión de la válvula seleccionada con el proveedor de la bomba y el diseñador.'
	},
	{
		question: '¿Dónde va la válvula de retención de impulsión?',
		answer: 'La retención de impulsión se coordina entre el conjunto de bombeo de terceros y la válvula de aislamiento de impulsión para limitar el reflujo. La ubicación final, el tamaño y la clase de presión siguen la distribución de tuberías aprobada y los datos del proveedor de la bomba.'
	},
	{
		question: '¿Puede una válvula reductora de presión sustituir los controles de la bomba?',
		answer: 'No. La 500X es una válvula hidráulica reductora de presión para gestionar la presión aguas abajo en una línea de agua; no sustituye el controlador de la bomba contraincendios, la disposición de alivio de la bomba ni el diseño certificado del proveedor de la bomba.'
	},
	{
		question: '¿Qué información debo enviar para cotizar un paquete de sala de bombas?',
		answer: 'Envíe los datos de caudal y altura manométrica del proveedor de la bomba, los diámetros de aspiración e impulsión, las normas de conexión, la disposición de prueba, la norma de toma de los bomberos, las certificaciones requeridas y la tabla o los planos de válvulas.'
	}
];

const products = [
	{
		slug: 'sqd100-1-6-fire-pump-adapter',
		name: 'SQD100-1.6 Fire Pump Adapter (Siamese Connection)',
		img: '/assets/products/sqd100-1-6-fire-pump-adapter.webp',
		desc: '2 tomas DN65, salida bridada DN100, 1,6 MPa'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'UL/FM Fire Protection Resilient Seated OS&Y Gate Valve',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: '2"–10", extremos ranurados, vástago ascendente, listado UL / FM'
	},
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Ductile Iron Resilient Seat Flanged Gate Valve (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'DN50–DN700, PN10 / PN16, hierro dúctil, bridada'
	},
	{
		slug: 'spherical-ball-check-valve-hq44x',
		name: 'Spherical Cast Iron Ball Check Valve (HQ44X-16)',
		img: '/assets/products/spherical-ball-check-valve-hq44x.webp',
		desc: 'DN50–DN400, PN16, bola EPDM antibloqueo'
	},
	{
		slug: 'adjustable-pressure-reducing-valve-500x',
		name: 'Hydraulic Adjustable Pressure Reducing Valve (500X)',
		img: '/assets/products/pressure-reducing-valve-500x-dn50.webp',
		desc: 'DN20–DN600, ajuste de 0,1–1,6 MPa, piloto hidráulico'
	}
];
---

<Layout
	title="Conexión de Bombas, Adaptador Siamés y Válvulas | WLFE"
	description="Adaptador siamés, conexión para el cuerpo de bomberos y válvulas de sala de bombas para aspiración, impulsión y prueba alrededor del conjunto de bombeo."
	type="product"
	locale="es"
	productData={{
		name: 'Conexiones de Bomba y Válvulas de Sala de Bombas',
		image: '/assets/products/sqd100-1-6-fire-pump-adapter.webp',
		description: 'Conexiones para el cuerpo de bomberos, adaptadores de bomba, compuertas, retenciones y componentes de control de presión para paquetes coordinados de sala de bombas.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Conexiones de Bomba' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/es/" class="hover:text-blue-600">Inicio</a>
			<span>/</span>
			<a href="/es/products/" class="hover:text-blue-600">Productos</a>
			<span>/</span>
			<span class="text-gray-600">Conexiones de Bomba</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Válvulas de Sala de Bombas y Conexiones para el Cuerpo de Bomberos</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Paquetes de Adaptador de Bomba y Válvulas de Sala de Bombas</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">La sala de bombas es más que la bomba: es la disposición de aspiración, impulsión, retención, aislamiento y prueba que permite al conjunto de bombeo del proveedor de bombas operar con seguridad, y que permite al cuerpo de bomberos añadir agua a través de una conexión siamesa compatible. Wanlian suministra las válvulas y conexiones del entorno; el conjunto de bombeo lo aporta otro proveedor.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Adaptador Siamés', 'Aislamiento de Aspiración', 'Retención de Impulsión', 'Bomba de Terceros'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span></div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Componentes de Conexión de la Bomba Contraincendios</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{products.map(p => (
					<a href={`/es/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p><p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p></div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Tabla de Selección de Sala de Bombas</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Disposición</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Referencia de selección verificada</th></tr></thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">Conexión para bomberos</td><td class="px-4 py-3 text-gray-700">SQD100-1.6: dos tomas DN65 con tapas SQS65 / KWS65, salida bridada DN100, 1,6 MPa, válvula de control integrada.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Válvulas de aislamiento</td><td class="px-4 py-3 text-gray-700">Compuerta OS&Y UL/FM: 2"–10", extremos ranurados, vástago ascendente; compuerta bridada Z41X: DN50–DN700, PN10 / PN16.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Retención de impulsión</td><td class="px-4 py-3 text-gray-700">Retención de bola HQ44X: DN50–DN400, 1,6 MPa (PN16), canal de flujo no obstrutivo y sellado EPDM / NBR.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Gestión de presión</td><td class="px-4 py-3 text-gray-700">Válvula reductora hidráulica 500X: DN20–DN600; rango de ajuste 0,1–1,6 MPa; confirme su función en el diseño aguas abajo aprobado.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Datos de bomba y prueba</td><td class="px-4 py-3 text-gray-700">Aporte los datos de caudal/altura del proveedor de la bomba, diámetros de tubería, disposición de prueba y requisitos de aprobación aplicables antes del dimensionamiento final de válvulas.</td></tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Qué Incluir en un Solo Pedido de Sala de Bombas</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2">
				<li><strong>Punto de conexión</strong> — norma de toma siamesa, brida de salida, disposición de tapas e interfaz con el cuerpo de bomberos.</li>
				<li><strong>Juego de aspiración e impulsión</strong> — válvula de aislamiento, retención y cualquier elemento de control de presión casado con la tabla de tuberías aprobada.</li>
				<li><strong>Detalles de prueba y puesta en marcha</strong> — colector o salida de prueba, instrumentos de terceros cuando aplique y la curva certificada del proveedor de la bomba.</li>
				<li><strong>Paquete de submittal</strong> — planos, datos de producto, certificados, dimensiones de conexión, clase de presión y marcado del mercado de destino.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Recursos de Diseño de Sala de Bombas</h2>
			<p class="text-gray-700 leading-relaxed">Use la <a href="/es/guides/fire-pump-room-valves-guide/" class="text-brand-blue font-semibold hover:underline">guía de válvulas de sala de bombas</a> para la planificación de aspiración, impulsión y prueba, la <a href="/es/guides/fire-department-connection-siamese-guide/" class="text-brand-blue font-semibold hover:underline">guía de la conexión siamesa para bomberos</a> y la <a href="/es/guides/check-valve-types-guide/" class="text-brand-blue font-semibold hover:underline">guía de tipos de válvulas de retención</a> al preparar la tabla de válvulas.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Preguntas Frecuentes</h2>
			<div class="space-y-4">{faq.map(item => (<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>))}</div>

			<div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white tracking-tight">¿Necesita un Paquete de Conexión de Bomba?</h2><p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envíe los datos de caudal/altura del proveedor de la bomba y su tabla de válvulas; coordinamos el adaptador verificado y el paquete de válvulas en 12 horas.</p><div class="mt-6 flex flex-col sm:flex-row justify-center gap-4"><a href="/es/contact/?product=Conexiones%20de%20Bomba%20Contraincendios" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotización</a><a href="https://wa.me/8618684324501?text=Hola%2C%20necesito%20conexiones%20para%20la%20bomba%20contraincendios" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chatear por WhatsApp</a></div></div></div>
		</article>
	</main>
</Layout>
