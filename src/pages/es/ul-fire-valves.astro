---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: '¿Qué significa la certificación UL en válvulas contra incendios?',
		answer: 'La certificación UL verifica que una válvula cumple las normas de protección contra incendios UL/ULC en caudal, clase de presión y durabilidad, lo que garantiza un rendimiento confiable en sistemas de rociadores y columnas secas (montantes). Es un requisito obligatorio en la mayoría de los proyectos de Norteamérica y en muchos proyectos internacionales.'
	},
	{
		question: '¿Qué válvulas contra incendios con certificación UL fabrica Wanlian?',
		answer: 'Suministramos válvulas de compuerta, mariposa, retención, diluvio y preacción con conexiones bridadas, ranuradas y roscadas, de DN40 a DN300. Cuando su especificación exige un listado, el modelo listado puede adquirirse a la fábrica que lo ostenta y indicamos la razón social del titular antes de la producción. Envíenos la especificación de su proyecto y seleccionaremos el tipo de válvula y la documentación adecuados.'
	},
	{
		question: '¿Pueden proporcionar el certificado UL antes de realizar el pedido?',
		answer: 'Sí. El listado se concede a la fábrica que fabrica el modelo listado: le facilitamos la razón social del titular y una copia del certificado para el modelo concreto, y usted puede verificarla ante el organismo emisor. Nuestros ingenieros confirmarán además la certificación aplicable a su mercado de destino antes de cotizar.'
	},
	{
		question: '¿Cuál es su MOQ y plazo de entrega para válvulas contra incendios?',
		answer: 'El MOQ depende del tipo y tamaño de la válvula — normalmente de 10 a 20 unidades por modelo en medidas estándar, con plazos de producción de 15 a 30 días. Se aceptan pedidos de muestra para pruebas y aprobación previas al envío.'
	},
	{
		question: '¿Soportan OEM/marca privada para válvulas contra incendios?',
		answer: 'Sí, soportamos OEM/ODM con marca personalizada, empaque y ajustes de especificación según los requisitos de cada proyecto. La producción se realiza en nuestras propias líneas de producción bajo un sistema de gestión de calidad ISO 9001.'
	}
];

const valveProducts = [
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Resilient Seat Gate Valve (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'Cuña encapsulada en EPDM, cierre hermético, DN50–DN700'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Signal Grooved Wafer Butterfly Valve',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp',
		desc: 'DN80 PN16 con interruptor integrado de monitoreo de estado'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'OS&Y Gate Valve (Grooved)',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: 'Válvula de compuerta de vástago ascendente, 2"–10", extremos ranurados'
	},
	{
		slug: 'spherical-ball-check-valve-hq44x',
		name: 'Válvula de Retención de Bola Esférica (HQ44X)',
		img: '/assets/products/spherical-ball-check-valve-hq44x.webp',
		desc: 'Baja pérdida de carga, diseño de bola rodante sin obstrucciones'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Deluge Alarm Valve Group (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Accionada por diafragma, DN50–DN300, apertura rápida'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Pre-action Alarm System (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Doble disparo a prueba de fallos para salas sensibles al agua'
	}
];
---

<Layout
	locale="es"
	title="Válvulas contra incendios con listado UL y FM - WLFE"
	description="Lo que cubre un listado UL o FM, qué modelos pueden adquirirse a la fábrica titular y cómo informamos del titular antes de su pedido."
	type="product"
	productData={{
		name: 'Válvulas contra incendios con listado UL y FM',
		image: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		description: 'Válvulas de compuerta, mariposa, retención, diluvio y preacción para sistemas de protección contra incendios; los modelos listados pueden adquirirse a la fábrica titular del certificado.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Válvulas UL Contra Incendios' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/es/" class="hover:text-blue-600">Inicio</a>
			<span>/</span>
			<a href="/es/products/" class="hover:text-blue-600">Productos</a>
			<span>/</span>
			<span class="text-gray-600">Válvulas UL Contra Incendios</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Válvulas de Protección Contra Incendios</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Válvulas con listado UL y FM: lo que podemos suministrar</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian suministra válvulas de compuerta, mariposa, retención, diluvio y preacción para sistemas comerciales e industriales de protección contra incendios. Cuando su especificación exige un listado, el modelo listado puede adquirirse a la fábrica que lo ostenta y le facilitamos la razón social del titular y una copia del certificado antes de la producción. Lo que Wanlian posee en nombre propio es el sistema de gestión de calidad ISO 9001:2015 y los ensayos documentados de presión de carcasa y estanqueidad del asiento en cada lote, y se lo comunicamos con claridad cuando no podemos suministrar una unidad listada.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['ISO 9001:2015', 'Ensayos de carcasa y asiento al 100 %', 'Titular indicado al cotizar', 'Directo de Fábrica'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Series de Válvulas Contra Incendios</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{valveProducts.map(p => (
					<a href={`/es/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Especificaciones Clave</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Especificación</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Detalles</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Normas</td>
							<td class="px-4 py-3 text-gray-700">Los modelos listados pueden adquirirse a la fábrica titular del certificado (titular indicado por modelo y mercado de destino)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Rango de medidas</td>
							<td class="px-4 py-3 text-gray-700">DN40 – DN300 (1½" – 12")</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Clase de presión</td>
							<td class="px-4 py-3 text-gray-700">PN16 / PN25 (según modelo)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Material del cuerpo</td>
							<td class="px-4 py-3 text-gray-700">Hierro dúctil QT450 / WCB / acero inoxidable CF8 · CF8M</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Conexiones de extremo</td>
							<td class="px-4 py-3 text-gray-700">Bridadas / Ranuradas / Roscadas</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Medio</td>
							<td class="px-4 py-3 text-gray-700">Agua, solución de espuma</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplicaciones</h2>
			<p class="text-gray-700 leading-relaxed">Nuestras válvulas contra incendios se instalan en sistemas de rociadores de edificios comerciales, plantas industriales, almacenes y centros logísticos, centros de datos y redes contra incendios petroquímicas — en cualquier lugar donde el control de flujo certificado y confiable sea un requisito normativo.</p>

			<!-- Why WLFE -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">¿Por Qué Elegir Wanlian Fluid?</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Directo de fábrica</strong> — plazos de entrega estables, soporte OEM/ODM y asistencia de ingeniería para la selección.</li>
				<li><strong>Un pedido, una fábrica</strong> — las válvulas se despachan junto con rociadores, hidrantes y accesorios para el circuito completo de supresión.</li>
			</ul>

			<!-- Related guide -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">¿Es Nuevo en Normas de Válvulas?</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Comience con nuestra guía del comprador: <a href="/es/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">Explicación de las Normas de Válvulas, Mangueras e Hidrantes</a>.</p>
			</div>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Preguntas Frecuentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">¿Necesita Válvulas UL Contra Incendios para su Proyecto?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envíenos el tipo de válvula, DN/PN y la certificación objetivo — nuestros ingenieros responden con la ficha técnica completa y una cotización en menos de 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/es/contact/?product=UL%20Fire%20Valves" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotización</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20UL%20listed%20fire%20valves" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chatear por WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
