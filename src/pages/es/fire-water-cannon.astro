---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: '¿Cuál es el alcance efectivo de su cañón monitor contra incendios?',
		answer: 'El alcance depende del modelo y de la presión de entrada — típicamente de 50 a 110 metros a caudal nominal en nuestra serie PS, con radios de monitoreo de 40–65 m en la serie ZDMS de seguimiento automático. Indíquenos la distribución de su sitio y le recomendaremos el modelo adecuado.'
	},
	{
		question: '¿Puede operarse el cañón monitor a distancia?',
		answer: 'Sí. Nuestro cañón ZDMS de seguimiento automático opera de forma totalmente autónoma con detección de llama IR/UV, y admite control remoto manual desde PC, aplicación móvil o gabinete de control central. También disponemos de cañones monitores fijos con operación manual por palanca.'
	},
	{
		question: '¿Qué caudales están disponibles?',
		answer: 'Los modelos estándar van de 5 L/s hasta 200 L/s. La serie ZDMS está disponible en 5, 10, 20 y 30 L/s (personalizable hasta 150 L/s), mientras que la serie manual PS cubre de 20 a 200 L/s. Se pueden diseñar caudales personalizados según el proyecto.'
	},
	{
		question: '¿El modelo inteligente se integra con los sistemas de alarma contra incendios?',
		answer: 'Sí. Los cañones inteligentes ZDMS usan sensores infrarrojos y ultravioleta multibanda para la detección automática de incendios, el posicionamiento y la descarga del chorro en menos de 30 segundos, y pueden conectarse a los paneles de alarma contra incendios. Las configuraciones a prueba de explosión están disponibles como opción.'
	},
	{
		question: '¿Suministran el sistema completo, incluidas válvulas y tuberías?',
		answer: 'Sí. Como empresa de equipos de fluidos podemos suministrar válvulas, acoples, hidrantes y accesorios coordinados para todo el circuito de supresión, simplificando la compra y garantizando la compatibilidad del sistema.'
	}
];

const cannonProducts = [
	{
		slug: 'auto-tracking-jet-suppression-cannon-zdms',
		name: 'Auto-Tracking Jet Suppression Cannon (ZDMS)',
		img: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		desc: 'Autodetección IR/UV, rotación 360°, radio de 40–65 m'
	},
	{
		slug: 'manual-fire-water-cannon-ps',
		name: 'Manual Fire Water Cannon (PS Series)',
		img: '/assets/products/manual-fire-water-cannon-ps.webp',
		desc: '20–200 L/s, alcance del chorro hasta 110 m, agua o espuma'
	},
	{
		slug: 'foam-fire-hydrant-cabinet-psg30',
		name: 'Foam Fire Hydrant Cabinet (PSG30)',
		img: '/assets/06_extinguishing_cannons/cannon_p42.webp',
		desc: 'Unidad de espuma AFFF al 3% para incendios químicos y de hidrocarburos'
	},
	{
		slug: 'fire-hose-reel-jpso8-19',
		name: 'Fire Hose Reel Accessories Set (JPS0.8-19)',
		img: '/assets/products/fire-hose-reel-jpso8-19.jpg',
		desc: 'Manguera plana de 20–30 m, soporte giratorio, respuesta rápida'
	}
];
---

<Layout
	title="Cañón Monitor Contra Incendios | Control Remoto y Automático"
	description="Cañones monitores contra incendios de alto caudal y largo alcance para plantas, terminales y almacenes. Modelos fijos, remotos y de seguimiento automático."
	type="product"
	locale="es"
	productData={{
		name: 'Cañón Monitor Contra Incendios',
		image: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		description: 'Cañones monitores contra incendios fijos, de control remoto e inteligentes con caudal de 5–200 L/s y alcance de hasta 110 m para la protección contra incendios industrial, fabricados por Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Cañón Monitor Contra Incendios' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/es/" class="hover:text-blue-600">Inicio</a>
			<span>/</span>
			<a href="/es/products/" class="hover:text-blue-600">Productos</a>
			<span>/</span>
			<span class="text-gray-600">Cañón Monitor Contra Incendios</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Sistemas de Cañones Monitores Contra Incendios</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Sistemas de Cañones Monitores Contra Incendios para Entornos Industriales de Alto Riesgo</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid suministra cañones monitores contra incendios de alto caudal para plantas petroquímicas, terminales de GNL, almacenes y aeropuertos — desde monitores fijos manuales hasta cañones de seguimiento automático totalmente autónomos con control remoto e inteligente.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Caudal hasta 200 L/s', 'Alcance hasta 110 m', 'Rotación 360°', 'Autodetección IR/UV'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Series de Cañones Monitores</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{cannonProducts.map(p => (
					<a href={`/es/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Core tech -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Especificaciones Técnicas Principales</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Especificación</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Detalle</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Caudal nominal</td>
							<td class="px-4 py-3 text-gray-700">5 – 200 L/s según el modelo (personalizable hasta 150 L/s en ZDMS)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Alcance del chorro</td>
							<td class="px-4 py-3 text-gray-700">50 – 110 m según el modelo y la presión de entrada</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Rotación</td>
							<td class="px-4 py-3 text-gray-700">Horizontal 360°, vertical de -90° a +70°</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Modos de control</td>
							<td class="px-4 py-3 text-gray-700">Manual / Remoto (PC, aplicación móvil, gabinete central) / Automático (detección de llama)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Material del cuerpo</td>
							<td class="px-4 py-3 text-gray-700">Aleación de aluminio anodizado duro T6 / bronce, conducto de agua en SS304</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Opcional</td>
							<td class="px-4 py-3 text-gray-700">A prueba de explosión (Exde II BT4 Gb), dosificación de espuma</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplicaciones</h2>
			<p class="text-gray-700 leading-relaxed">Los cañones monitores contra incendios protegen áreas de proceso petroquímico, parques de tanques de almacenamiento de petróleo y GNL, terminales de carga, grandes almacenes, hangares de aeropuerto y subestaciones — sitios de techos altos o al aire libre donde la supresión fija debe alcanzar grandes distancias bajo calor intenso.</p>

			<!-- Why WLFE -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Por Qué Elegir Wanlian Fluid</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Suministro integrado</strong> — cañones monitores suministrados con válvulas, acoples e hidrantes coordinados para todo el circuito de supresión.</li>
				<li><strong>Ingeniería de proyecto</strong> — recomendamos el alcance, el caudal y la configuración de control según la distribución de su sitio.</li>
				<li><strong>Calidad certificada</strong> — sistemas de calidad UL/ULC, FM e ISO 9001; consulte nuestra <a href="/es/certificates/" class="text-brand-blue font-semibold hover:underline">página de certificados</a>.</li>
			</ul>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Preguntas Frecuentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">¿Necesita un Cañón Monitor para su Sitio?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envíenos la distribución de su sitio, el alcance y el caudal requeridos — nuestros ingenieros recomiendan el modelo adecuado y responden con una cotización completa en un plazo de 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/es/contact/?product=Fire%20Water%20Cannon" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotización</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20a%20fire%20water%20cannon" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chatear por WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
