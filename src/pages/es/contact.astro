---
import Layout from '../../layouts/Layout.astro';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';

const productName = Astro.url.searchParams.get('product') || "";
---

<Layout locale="es" title="Contáctenos | Cotización B2B Inmediata | Wanlian Fluid" description="Solicite una cotización B2B de válvulas y equipos contra incendios. Envíe planos y especificaciones; responderemos en 12 horas por correo o WhatsApp.">
  <main id="inquiry" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Contacto y Consultas</span>
      <h1 class="text-4xl font-black text-gray-900 tracking-tight">Solicite una Cotización Profesional</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
        Comparta sus requisitos de producto, normas, medidas y la aplicación objetivo. Nuestro equipo de ventas e ingeniería revisará los detalles y le indicará los siguientes pasos.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
      <!-- Contact Info -->
      <div class="space-y-8">
        <div>
          <h3 class="text-xs font-bold text-gray-400 tracking-widest uppercase mb-2">Ubicación de la Empresa</h3>
           <p class="text-lg font-bold text-gray-900">Quanzhou Wanlian Fluid Equipment Co., Ltd.</p>
           <p class="text-gray-500 mt-2 text-sm leading-relaxed">
             Quanzhou, Fujian Province, China
           </p>
        </div>

        <div>
          <h3 class="text-xs font-bold text-gray-400 tracking-widest uppercase mb-3">Canales Directos</h3>
          <ul class="space-y-3 text-sm text-gray-600">
            <li class="flex items-center">
              <span class="font-semibold text-gray-900 w-20">Correo de Ventas:</span>
              <a href="mailto:dhuog77@gmail.com" class="text-blue-600 hover:underline">dhuog77@gmail.com</a>
            </li>
            <li class="flex items-center">
              <span class="font-semibold text-gray-900 w-20">Línea Directa:</span>
              <a href="tel:+8618684324501" class="text-blue-600 hover:underline">+86 186 8432 4501</a>
            </li>
            <li class="flex items-center">
              <span class="font-semibold text-gray-900 w-20">WhatsApp:</span>
              <a href="https://wa.me/8618684324501" target="_blank" rel="noopener noreferrer" class="text-green-600 font-bold hover:underline">+86 186 8432 4501</a>
            </li>
          </ul>
        </div>

        <div class="bg-blue-50/50 p-8 rounded-xl border border-blue-100/50 space-y-4">
          <h3 class="font-bold text-blue-900 text-base">¿Por Qué Asociarse con Wanlian?</h3>
          <ul class="space-y-3 text-sm text-blue-700 font-medium">
              <li class="flex items-center gap-2">
               <span class="text-blue-500 font-bold">✓</span> Asesoría en la selección de productos para sistemas de fluidos
             </li>
             <li class="flex items-center gap-2">
               <span class="text-blue-500 font-bold">✓</span> Se pueden analizar requisitos OEM/ODM
             </li>
             <li class="flex items-center gap-2">
               <span class="text-blue-500 font-bold">✓</span> Soporte de especificaciones y documentación de producto
             </li>
             <li class="flex items-center gap-2">
               <span class="text-blue-500 font-bold">✓</span> Coordinación de empaque de exportación y envíos
             </li>
          </ul>
        </div>
      </div>

      <!-- Form Area -->
      <div class="lg:col-span-2 bg-white p-10 rounded-2xl border border-gray-100 shadow-sm">
        <h2 class="text-xl font-bold text-gray-900 mb-6">Enviar RFQ / Formulario de Consulta</h2>
        <InquiryForm productName={productName} />
      </div>
    </div>
  </main>
</Layout>
