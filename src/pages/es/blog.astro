---
import Layout from '../../layouts/Layout.astro';
import { guidesEs } from '../../utils/guides.es';

// Páginas de sistema/solución (no artículos de guía, agrupadas por separado)
const solutions = [
  {
    title: 'Solución de Sistemas de Hidrantes Contra Incendios',
    description: 'Hidrantes interiores, exteriores, anticolisión e inteligentes IoT para redes municipales, patios industriales y redes de ciudades inteligentes.',
    href: '/es/fire-hydrant-systems/',
    date: '2026',
    category: 'Soluciones de Producto',
    readTime: '5 min de lectura'
  },
  {
    title: 'Solución de Prevención de Reflujo y Control Hidráulico',
    description: 'Dispositivos anti-retorno, reductoras de presión, válvulas de control de nivel y solenoide para agua potable y seguridad hidráulica.',
    href: '/es/backflow-prevention/',
    date: '2026',
    category: 'Soluciones de Producto',
    readTime: '5 min de lectura'
  },
  {
    title: 'Aplicaciones: Protección Contra Incendios, Redes de Agua y Tuberías Industriales',
    description: 'Selección de productos por aplicación: desde suministro municipal de agua y HVAC hasta proyectos petroquímicos, de almacenamiento y marinos.',
    href: '/es/applications/',
    date: '2026',
    category: 'Aplicaciones',
    readTime: '5 min de lectura'
  },
  {
    title: 'Válvulas Contra Incendios UL, Sistemas de Rociadores y Cañones de Agua',
    description: 'Páginas de solución Wanlian para válvulas UL, sistemas de rociadores y cañones de agua, con orientación técnica y enlaces de RFQ.',
    href: '/es/ul-fire-valves/',
    date: '2026',
    category: 'Soluciones de Producto',
    readTime: '5 min de lectura'
  },
  {
    title: 'Solución de Cañones de Agua Contra Incendios',
    description: 'Opciones de cañones de agua manuales y automáticos para plantas petroquímicas, almacenes, aeropuertos y otros sitios de alto riesgo.',
    href: '/es/fire-water-cannon/',
    date: '2026',
    category: 'Soluciones de Producto',
    readTime: '5 min de lectura'
  },
  {
    title: 'Solución de Sistemas de Rociadores',
    description: 'Componentes de alarma tipo húmedo, diluvio, preacción e indicadores de flujo para sistemas de rociadores comerciales, industriales y de almacenes.',
    href: '/es/fire-sprinkler-systems/',
    date: '2026',
    category: 'Soluciones de Producto',
    readTime: '5 min de lectura'
  }
];
---

<Layout
  title="Blog y Guías de Compra | Wanlian Fluid Equipment"
  description="Guías técnicas de compra y conocimiento industrial para equipos de protección contra incendios, válvulas industriales y sistemas de control de fluidos de Quanzhou Wanlian Fluid."
  locale="es"
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Blog y Guías</span>
      <h1 class="text-4xl font-black text-gray-900 tracking-tight">Guías de Compra y Conocimiento Industrial</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
        Conocimiento práctico de ingeniería y compras para proyectos de protección contra incendios y control de fluidos.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {guidesEs.map(article => (
        <a
          href={article.href}
          class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-8 flex flex-col"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2.5 py-1 bg-brand-blue/10 text-brand-blue text-[11px] font-black rounded-full uppercase tracking-wider">{article.category}</span>
            <span class="text-xs text-gray-400">{article.date} · {article.readTime}</span>
          </div>
          <h2 class="text-lg font-black text-gray-900 group-hover:text-brand-blue transition leading-snug mb-3">
            {article.title}
          </h2>
          <p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p>
          <div class="flex flex-wrap gap-2 mt-4">
            {article.tags.map(tag => (
              <a href={`/es/tags/${tag}/`} class="text-[10px] font-bold text-gray-400 uppercase tracking-wider hover:text-brand-blue transition">#{tag.replace(/-/g, ' ')}</a>
            ))}
          </div>
          <span class="mt-6 inline-flex items-center text-brand-red font-bold text-sm group-hover:gap-2 transition-all">
            Leer Guía
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-16 mb-8 flex items-center gap-4">
      <h2 class="text-2xl font-black text-gray-900 tracking-tight">Soluciones de Producto</h2>
      <div class="flex-1 h-px bg-gray-200"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {solutions.map(article => (
        <a
          href={article.href}
          class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-red/30 transition p-8 flex flex-col"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="px-2.5 py-1 bg-brand-red/10 text-brand-red text-[11px] font-black rounded-full uppercase tracking-wider">{article.category}</span>
            <span class="text-xs text-gray-400">{article.date} · {article.readTime}</span>
          </div>
          <h2 class="text-lg font-black text-gray-900 group-hover:text-brand-red transition leading-snug mb-3">
            {article.title}
          </h2>
          <p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p>
          <span class="mt-6 inline-flex items-center text-brand-blue font-bold text-sm group-hover:gap-2 transition-all">
            Ver Solución
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4">
      <h2 class="text-2xl font-black">¿Necesita Asesoría Técnica Específica de Producto?</h2>
      <p class="text-gray-400 max-w-xl mx-auto">
        Nuestros ingenieros le ayudan a elegir las válvulas y equipos de protección contra incendios adecuados para su proyecto.
      </p>
      <a href="/es/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-xl hover:opacity-90 transition">
        Consultar a un Ingeniero
      </a>
    </div>
  </main>
</Layout>
