---
import Layout from '../../layouts/Layout.astro';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';
import { productsEs } from '../../utils/products.es';

// /es/ 首页：hero、公司简介、产品分类、质控流程、热销/全量产品线、系统资源、行业场景、询盘表单。

const featuredSlugs = [
  'resilient-seat-flanged-gate-valve-z41x',
  'indoor-fire-hydrant-head-sn65',
  'wet-alarm-check-valve-zsfz-150',
  'signal-grooved-wafer-butterfly-valve-dn80',
  'sliding-ball-check-valve-hq41x',
  'hydraulic-water-level-control-valve-f745x',
  'telescopic-y-strainer-sgl41h',
  'anti-collision-pressure-regulating-outdoor-hydrant-ssft100'
];
const featuredProducts = productsEs.filter(p => featuredSlugs.includes(p.slug));

const systemResources = [
  { href: '/es/fire-sprinkler-systems/', eyebrow: 'Descripción de Sistema', title: 'Válvulas para Sistemas de Rociadores', desc: 'Válvulas de alarma tipo húmedo, de diluvio y de preacción explicadas para compradores de sistemas de rociadores.' },
  { href: '/es/fire-hydrant-systems/', eyebrow: 'Descripción de Sistema', title: 'Sistemas de Hidrantes Contra Incendios', desc: 'Hidrantes interiores y exteriores, conexiones y normas para redes municipales e industriales.' },
  { href: '/es/fire-water-cannon/', eyebrow: 'Descripción de Sistema', title: 'Cañones de Agua y Monitores', desc: 'Monitores manuales PS y cañones ZDMS de seguimiento automático para supresión en grandes espacios.' },
  { href: '/es/backflow-prevention/', eyebrow: 'Descripción de Sistema', title: 'Prevención de Reflujo y Control Hidráulico', desc: 'Dispositivos anti-retorno y válvulas de control para proteger redes de agua potable.' },
  { href: '/es/ul-fire-valves/', eyebrow: 'Descripción de Sistema', title: 'Válvulas Contra Incendios Certificadas UL', desc: 'Qué significa la certificación UL, UL vs FM y cómo verificar certificados genuinos.' },
  { href: '/es/certificates/', eyebrow: 'Certificaciones', title: 'Certificados y Aprobaciones', desc: 'Listado UL, aprobación FM, marcado CE, ISO 9001 y LPCB: verifique nuestras credenciales.' }
];

const categories = [
  { name: 'Válvulas y Piezas', image: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp' },
  { name: 'Hidrantes y Conexiones de Bomba', image: '/assets/products/indoor-fire-hydrant-head-sn65.jpg' },
  { name: 'Rociadores y Válvulas de Alarma', image: '/assets/products/wet-alarm-check-valve-zsfz-150.webp' },
  { name: 'Seguridad Hidráulica', image: '/assets/products/adjustable-pressure-reducing-valve-500x.webp' },
  { name: 'Cañones de Agua Extintores', image: '/assets/products/manual-fire-water-cannon-ps.webp' },
  { name: 'Gabinetes Contra Incendios e Interfaces', image: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg' }
];

const qualitySteps = [
  { step: '01', title: 'Tejido de Precisión', desc: 'Tejido de poliéster de alta resistencia para cubiertas de manguera contra incendios duraderas.' },
  { step: '02', title: 'Adhesión del Revestimiento', desc: 'Proceso avanzado de vulcanización para un revestimiento de caucho hermético.' },
  { step: '03', title: 'Mecanizado CNC', desc: 'Mecanizado de precisión para cuerpos y componentes de válvulas de hierro dúctil.' },
  { step: '04', title: 'Pruebas de Seguridad', desc: 'Prueba de presión de carcasa y de fuga de aire al 100% en cada unidad.' },
  { step: '05', title: 'Recubrimiento Epóxico', desc: 'Recubrimiento de resina epóxica no tóxico para una resistencia superior a la corrosión.' }
];

const industries = [
  { name: 'Petróleo y Gas', desc: 'Transporte seguro de fluidos en condiciones industriales extremas.' },
  { name: 'Tratamiento de Agua', desc: 'Sistemas municipales de suministro, drenaje y filtración.' },
  { name: 'Protección Contra Incendios', desc: 'Hidrantes certificados, válvulas de rociadores y sistemas de supresión.' }
];

const inquiryPoints = [
  'Cotización basada en consulta',
  'Asesoría de aplicación y selección',
  'Coordinación de empaque de exportación',
  'Soporte de documentación de producto'
];
---

<Layout
  locale="es"
  title="Wanlian Fluid | Proveedor B2B de Válvulas Industriales y Protección Contra Incendios"
  description="Wanlian Fluid es un proveedor B2B con sede en Quanzhou de válvulas industriales, equipos de protección contra incendios y control hidráulico para proyectos globales. Certificación ISO 9001, cotización bajo consulta."
>
  <!-- Hero Section -->
  <section class="relative bg-gray-900 text-white min-h-[85vh] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-r from-gray-900 via-gray-900/80 to-transparent z-10"></div>
      <img 
        src="/og-image.jpg"
        alt="Válvulas industriales Wanlian Fluid"
        class="w-full h-full object-cover object-center opacity-40"
      />
    </div>
    
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="max-w-3xl space-y-8">
        <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full border border-white/20">
          <span class="flex h-2 w-2 rounded-full bg-brand-red animate-pulse"></span>
          <span class="text-sm font-bold tracking-widest uppercase">Empresa Profesional B2B de Equipos de Fluidos</span>
        </div>
        
        <h1 class="text-5xl sm:text-7xl font-black tracking-tight leading-[1.1]">
          Flujo de Precisión <br/>
          <span class="text-brand-red italic">Conectando Seguridad Global.</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-gray-300 max-w-2xl leading-relaxed">
          Quanzhou Wanlian Fluid Equipment Co., Ltd. está ubicada en Quanzhou, Fujian — punto de partida de la Ruta Marítima de la Seda y núcleo de la industria china de tuberías y válvulas. Como empresa profesional de equipos de fluidos que integra I+D, ventas y servicio, nos enfocamos en proveer válvulas de alta calidad, equipos auxiliares contra incendios, equipos de control de fluidos y soluciones integrales para los sectores industrial, municipal, de protección contra incendios, suministro de agua y drenaje.
        </p>
        
        <div class="flex flex-wrap gap-4 pt-4">
          <a href="/es/#inquiry" class="px-8 py-4 bg-brand-red hover:opacity-90 text-white font-bold rounded-lg transition shadow-xl shadow-brand-red/20 transform hover:-translate-y-1">
            Solicitar Cotización
          </a>
          <a href="/es/#perfil" class="px-8 py-4 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white font-bold rounded-lg border border-white/30 transition">
            Conozca la Empresa
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Certification Wall -->
  <div class="bg-gray-100 py-8 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-50 grayscale hover:grayscale-0 transition duration-500">
        <span class="text-gray-900 font-black text-xl tracking-tighter">DATOS TÉCNICOS</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">PLANOS DE PRODUCTO</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">OPCIONES DE MATERIAL</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">CLASIFICACIONES DE PRESIÓN</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">OEM / ODM</span>
        <span class="text-gray-900 font-black text-xl tracking-tighter">SOPORTE DE EXPORTACIÓN</span>
      </div>
    </div>
  </div>

  <!-- About Section: Factory Strength -->
  <section id="perfil" class="py-24 bg-white overflow-hidden scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row items-center gap-16">
        <div class="flex-1 space-y-8">
          <div class="space-y-4">
            <h2 class="text-sm font-black tracking-[0.3em] text-brand-red uppercase flex items-center gap-2">
              <span class="w-8 h-[2px] bg-brand-red"></span>
              Perfil de la Empresa
            </h2>
            <h3 class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight leading-tight">
              Soluciones de Control de Fluidos <br/><span class="text-brand-blue">Para Proyectos Globales.</span>
            </h3>
          </div>
          
          <div class="space-y-6 text-gray-600 text-lg leading-relaxed">
            <p>
              Con sede en Quanzhou, Fujian — núcleo de la industria china de tuberías y válvulas — Quanzhou Wanlian Fluid Equipment Co., Ltd. suministra válvulas industriales, productos de control hidráulico, componentes de hidrantes y equipos de protección contra incendios para proyectos B2B internacionales. La producción se realiza en bases de fabricación cooperativas conforme al Sistema de Gestión de Calidad ISO9001.
            </p>
            <p>
              Organizamos la información de productos alrededor de especificaciones claras, detalles de aplicación y cooperación basada en consultas para sistemas de suministro de agua, control industrial de fluidos y contra incendios.
            </p>
          </div>

          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 pt-4">
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-red tabular-nums">43+</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Modelos en Stock</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-blue tabular-nums">6</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Líneas de Producto</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-red tabular-nums">100%</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Probadas a Presión</span>
            </div>
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-100">
              <span class="block text-3xl font-black text-brand-blue tabular-nums">ISO 9001</span>
              <span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Sistema de Calidad</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-3 pt-2">
            <span class="px-4 py-2 bg-brand-red/5 border border-brand-red/20 text-brand-red text-xs font-black uppercase tracking-widest rounded-full">I+D · Ventas · Servicio</span>
            <span class="px-4 py-2 bg-brand-blue/5 border border-brand-blue/20 text-brand-blue text-xs font-black uppercase tracking-widest rounded-full">Certificado ISO 9001</span>
            <span class="px-4 py-2 bg-gray-100 border border-gray-200 text-gray-700 text-xs font-black uppercase tracking-widest rounded-full">OEM · ODM · Personalización</span>
          </div>

          <a href="/es/#inquiry" class="inline-flex items-center gap-2 font-bold text-brand-blue hover:underline pt-2">
            Solicitar Cotización Profesional <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="flex-1 relative">
          <div class="absolute -top-10 -left-10 w-40 h-40 bg-blue-100 rounded-full blur-3xl opacity-50 z-0"></div>
          <div class="relative z-10 rounded-2xl overflow-hidden shadow-2xl shadow-gray-200">
            <img 
              src="/og-image.jpg"
              alt="Productos de válvulas industriales Wanlian Fluid"
              loading="lazy"
              class="w-full h-auto object-cover"
            />
            <div class="absolute bottom-0 left-0 right-0 p-8 bg-gradient-to-t from-black/80 to-transparent text-white">
              <p class="text-sm font-bold tracking-wide">Excelencia Industrial Profesional | Soluciones B2B de Fluidos</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Classification Grid -->
  <section class="py-24 bg-gray-50 border-y border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <h2 class="text-4xl font-black text-gray-900 tracking-tight uppercase">Categorías Principales de Productos</h2>
        <div class="h-1.5 w-20 bg-brand-red mx-auto"></div>
        <p class="text-gray-500 font-medium italic">Ingeniería de alta precisión para redes globales de incendio y agua.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {categories.map(cat => (
          <div class="group relative bg-white rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-200">
            <div class="aspect-[4/3] overflow-hidden bg-gray-50 p-6 flex items-center justify-center">
              <img src={cat.image} alt={cat.name} loading="lazy" class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-6 bg-white/95 backdrop-blur-sm flex justify-between items-center group-hover:bg-brand-red group-hover:text-white transition-colors">
              <div>
                <h4 class="font-black text-lg">{cat.name}</h4>
                <p class="text-[10px] font-black uppercase tracking-widest opacity-60">Catálogo disponible bajo consulta</p>
              </div>
              <span class="text-2xl font-light">→</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality Control Workflow -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-4">
        <div class="space-y-4">
          <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Flujo de Trabajo de Calidad</h2>
          <h3 class="text-4xl font-black text-gray-900 tracking-tight">Cómo Revisamos los Requisitos del Producto</h3>
        </div>
        <p class="text-gray-500 max-w-md text-right hidden md:block">Una revisión estructurada ayuda a alinear la selección de productos, especificaciones, expectativas de prueba y preparación de exportación.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
        {qualitySteps.map((step, idx) => (
          <div class="relative group">
            <div class="bg-gray-50 p-8 rounded-2xl border border-gray-100 space-y-4 h-full group-hover:bg-blue-50 transition-colors">
              <div class="text-4xl font-black text-gray-200 group-hover:text-brand-blue/20 transition-colors">{step.step}</div>
              <h4 class="font-bold text-gray-900">{step.title}</h4>
              <p class="text-sm text-gray-500 leading-relaxed">{step.desc}</p>
            </div>
            {idx < qualitySteps.length - 1 && (
              <div class="hidden lg:block absolute top-1/2 -right-4 transform -translate-y-1/2 z-10">
                <svg class="w-8 h-8 text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-24 bg-gray-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-16">
        <h2 class="text-4xl font-black text-gray-900 tracking-tight">Los Más <span class="text-brand-red">Vendidos</span></h2>
        <a href="/es/products/" class="text-brand-blue font-bold hover:underline">Catálogo Completo →</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {featuredProducts.map(product => (
          <div class="group bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300">
            <div class="aspect-square relative overflow-hidden bg-gray-50 p-6">
              <img src={product.image} alt={product.name} loading="lazy" class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute top-4 left-4 flex gap-2">
                <span class="px-2 py-1 bg-gray-900/80 text-white text-[10px] font-black uppercase tracking-widest rounded">
                  {product.category}
                </span>
  
              </div>
            </div>
            <div class="p-6 space-y-4">
              <h4 class="font-bold text-gray-900 line-clamp-2 min-h-[3rem] group-hover:text-brand-red transition-colors tracking-tight">{product.name}</h4>
              <div class="pt-4 border-t border-gray-100 flex gap-2">
                <a href={`/es/products/${product.slug}/`} class="flex-1 py-2 text-center text-xs font-black border border-gray-200 rounded hover:bg-gray-50 transition">DETALLES</a>
                <a href={`/es/contact/?product=${encodeURIComponent(product.name)}`} class="flex-1 py-2 text-center text-xs font-black bg-brand-red text-white rounded hover:opacity-90 transition">CONSULTAR</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Complete Product Line: 全量产品内链 -->
  <section class="py-24 bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-12 gap-4">
        <h2 class="text-4xl font-black text-gray-900 tracking-tight">Línea de Productos <span class="text-brand-blue">Completa</span></h2>
        <a href="/es/products/" class="text-brand-red font-bold hover:underline shrink-0">Todos los Productos →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-1">
        {productsEs.map(product => (
          <a href={`/es/products/${product.slug}/`} class="group flex items-center justify-between py-3 border-b border-gray-100 hover:border-brand-red transition-colors">
            <span class="text-sm font-semibold text-gray-700 group-hover:text-brand-red transition-colors line-clamp-1 pr-3">{product.name}</span>
            <span class="text-brand-blue opacity-0 group-hover:opacity-100 transition-opacity shrink-0">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- System Resources: 系统页/认证入口（M3 接入西语指南后扩充） -->
  <section class="py-24 bg-gray-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
        <h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Recursos Técnicos</h2>
        <h3 class="text-4xl font-black text-gray-900 tracking-tight">Descripciones de Sistema y Certificaciones</h3>
        <div class="h-1.5 w-20 bg-brand-red mx-auto"></div>
        <p class="text-gray-500 font-medium">Las fichas técnicas son útiles; el contexto de ingeniería es mejor. Explore antes de especificar.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {systemResources.map(item => (
          <a href={item.href} class="group flex flex-col justify-between bg-white rounded-xl border border-gray-200 p-7 hover:border-brand-red hover:shadow-lg transition-all duration-300">
            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-brand-blue">{item.eyebrow}</span>
              <h4 class="mt-3 text-lg font-black text-gray-900 leading-snug group-hover:text-brand-red transition-colors">{item.title}</h4>
              <p class="mt-2 text-sm text-gray-500 leading-relaxed">{item.desc}</p>
            </div>
            <span class="mt-5 inline-flex items-center gap-1 text-brand-red font-bold text-xs group-hover:gap-2 transition-all">
              Leer Recurso
              <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Industry Scenarios -->
  <section class="py-24 bg-gray-900 text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16 items-center">
        <div class="space-y-6">
          <h2 class="text-4xl font-black tracking-tight leading-tight">Diseñadas para <br/><span class="text-brand-blue">Servicio de Alta Presión.</span></h2>
          <p class="text-gray-400">Nuestra ingeniería se centra en la durabilidad y fiabilidad en infraestructuras peligrosas y críticas.</p>
          <div class="pt-4">
            <a href="/es/#inquiry" class="inline-flex items-center gap-2 px-6 py-3 bg-white/5 border border-white/10 rounded-lg font-bold hover:bg-white/10 transition">
              Ver Certificaciones y Especificaciones
            </a>
          </div>
        </div>
        <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-6">
          {industries.map(ind => (
            <div class="p-8 bg-white/5 border border-white/10 rounded-2xl hover:border-brand-blue/50 transition-colors">
               <h4 class="font-bold mb-2 uppercase tracking-wide">{ind.name}</h4>
               <p class="text-xs text-gray-400 leading-relaxed">{ind.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Inquiry Section -->
  <section id="inquiry" class="py-24 bg-white scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div class="space-y-8">
          <div class="space-y-4">
             <h2 class="text-4xl font-black text-gray-900 tracking-tight uppercase">Obtenga una Cotización Profesional</h2>
             <div class="h-1.5 w-20 bg-brand-red"></div>
          </div>
          <p class="text-lg text-gray-600 leading-relaxed">
            Envíe sus planos técnicos o requisitos de producto. Revisaremos los detalles y le brindaremos información de producto adecuada y los pasos de cotización.
          </p>
          <ul class="space-y-4">
            {inquiryPoints.map(item => (
              <li class="flex items-center gap-3 text-gray-700 font-bold">
                <svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <InquiryForm />
      </div>
    </div>
  </section>
  
  <!-- Final CTA -->
  <section class="py-24 bg-brand-red text-white">
