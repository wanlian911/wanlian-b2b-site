---
import Layout from '../../layouts/Layout.astro';
import { productsEs as products } from '../../utils/products.es';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';
import LeadCaptureSection from '../../components/inquiry/LeadCaptureSection.astro';

const faq = [
  {
    question: '¿Qué fabrica y exporta Wanlian Fluid?',
    answer: 'Wanlian Fluid es un fabricante y exportador con sede en Quanzhou de válvulas industriales y equipos de protección contra incendios: válvulas de compuerta de asiento elástico y metálico, válvulas de mariposa y retención, hidrantes contra incendios y componentes, válvulas de rociador y de alarma, y mangueras con revestimiento de caucho — seis líneas de producto con más de 43 modelos en stock.'
  },
  {
    question: '¿Cómo obtengo el precio de una válvula o hidrante?',
    answer: 'El precio es bajo consulta. Envíe su especificación — modelo o norma, tamaño, clase de presión, material, cantidad y destino — y nuestro equipo le responde con una cotización detallada en 12 horas.'
  },
  {
    question: '¿Cada unidad se prueba antes del envío?',
    answer: 'Sí. Cada válvula, hidrante y manguera se prueba por presión de carcasa y por fuga de aire antes del envío, con registros por unidad. La producción opera bajo un sistema de gestión de calidad ISO 9001.'
  },
  {
    question: '¿Aceptan pedidos OEM o de marca propia?',
    answer: 'Sí. OEM/ODM, marcado personalizado y embalaje de exportación son servicios estándar. El cumplimiento de una norma específica (por ejemplo AWWA C502, listado UL o aprobación FM) se confirma por modelo con informes de prueba y certificados antes de pedir.'
  }
];

// Category grid and the grouped catalog index are both derived from this locale's product
// module, so line names, counts and card photography cannot drift from the live catalog.
// is keyed by English category names, so it stays empty and each line uses its first photo.
const CATEGORY_LEAD: Record<string, string> = {};

const categoryNames: string[] = [...new Set(products.map(p => p.category))];

const categories = categoryNames.map(name => {
  const inCategory = products.filter(p => p.category === name);
  const lead = inCategory.find(p => p.slug === CATEGORY_LEAD[name]) ?? inCategory[0];
  return { name, count: inCategory.length, image: lead.image, leadName: lead.name, href: `/es/products/#category=${encodeURIComponent(name)}` };
});

const catalogByCategory = categoryNames.map(name => ({
  name,
  href: `/es/products/#category=${encodeURIComponent(name)}`,
  items: products.filter(p => p.category === name).map(p => ({ name: p.name, href: '/es/products/' + p.slug + '/' }))
}));

const productionSteps = [{"step":"01","title":"Tejido de Precisión","desc":"Tejido de poliéster de alta resistencia para cubiertas de manguera contra incendios duraderas."},{"step":"02","title":"Adhesión del Revestimiento","desc":"Proceso avanzado de vulcanización para un revestimiento de caucho hermético."},{"step":"03","title":"Mecanizado CNC","desc":"Mecanizado de precisión para cuerpos y componentes de válvulas de hierro dúctil."},{"step":"04","title":"Pruebas de Seguridad","desc":"Prueba de presión de carcasa y de fuga de aire al 100% en cada unidad."},{"step":"05","title":"Recubrimiento Epóxico","desc":"Recubrimiento de resina epóxica no tóxico para una resistencia superior a la corrosión."}];



// Own-name assurance only. Third-party listings belong to the factory that holds them, so this
// strip must never imply that Wanlian itself holds UL, FM, CE or LPCB listings.
const certifications = [{"name":"DATOS TÉCNICOS"},{"name":"PLANOS DE PRODUCTO"},{"name":"OPCIONES DE MATERIAL"},{"name":"CLASIFICACIONES DE PRESIÓN"},{"name":"OEM / ODM"},{"name":"SOPORTE DE EXPORTACIÓN"}];

const waCallbackHref = `https://wa.me/8618684324501?text=${encodeURIComponent('Hola, estoy interesado en sus válvulas y equipos contra incendios.')}`;

const resources = [{"href":"/es/guides/how-to-choose-a-fire-hydrant/","eyebrow":"Guía de Compra","title":"Cómo Elegir un Hidrante Contra Incendios","desc":"Tipos, clases de presión, normas de conexión y verificación de fábrica antes de ordenar."},{"href":"/es/guides/fire-sprinkler-system-valves-guide/","eyebrow":"Guía de Compra","title":"Válvulas para Sistemas de Rociadores","desc":"Cómo funcionan las válvulas de alarma ZSFZ, diluvio ZSFM y preacción ZSFY."},{"href":"/es/guides/b2b-valve-sourcing-checklist/","eyebrow":"Compras B2B","title":"Lista de Verificación para Verificar un Fabricante","desc":"8 puntos de diligencia: certificados, informes por lote, auditoría de fábrica y muestras."},{"href":"/es/fire-hydrant-systems/","eyebrow":"Descripción de Sistema","title":"Sistemas de Hidrantes Contra Incendios","desc":"Hidrantes interiores y exteriores, conexiones y normas para redes municipales e industriales."},{"href":"/es/fire-water-cannon/","eyebrow":"Descripción de Sistema","title":"Cañones de Agua y Monitores","desc":"Monitores manuales PS y cañones ZDMS de seguimiento automático para supresión en grandes espacios."},{"href":"/es/backflow-prevention/","eyebrow":"Descripción de Sistema","title":"Prevención de Reflujo y Control Hidráulico","desc":"Dispositivos anti-retorno y válvulas de control para proteger redes de agua potable."}];

// On-site project evidence: real fire pump room installation (photos + portrait walkthrough video)
const projectPhotos = [
  { src: '/assets/projects/pump-skids.webp', alt: 'Fila de grupos de bombas de riego contra incendio con etiquetas OPEN y CLOSE en una sala de bombas instalada', caption: 'Skids de bombas con etiquetas OPEN/CLOSE' },
  { src: '/assets/projects/valve-train.webp', alt: 'Línea de válvulas de compuerta y manómetros en montantes rojos de la sala de bombas instalada', caption: 'Montantes y línea de válvulas de compuerta' },
  { src: '/assets/projects/riser-grid.webp', alt: 'Red de montantes con conductos aéreos y bandejas portacables en la sala de bombas instalada', caption: 'Red de montantes y conductos aéreos' },
  { src: '/assets/projects/pump-room-final.webp', alt: 'Sala de bombas contra incendios instalada, lista para inspección y entrega', caption: 'Sala de bombas lista para entrega' },
];

const projectScope = [
  'Varios grupos de bombas de riego y contra incendio sobre bases de concreto',
  'Red completa de montantes con válvulas de compuerta, manómetros y etiquetas OPEN/CLOSE',
  'Conductos y bandejas portacables junto a la red de montantes',
  'Sitio listo para la inspección final y la entrega',
];

const industries = [{"name":"Petróleo y Gas","desc":"Transporte seguro de fluidos en condiciones industriales extremas.","icon":"pipe"},{"name":"Tratamiento de Agua","desc":"Sistemas municipales de suministro, drenaje y filtración.","icon":"drop"},{"name":"Protección Contra Incendios","desc":"Hidrantes certificados, válvulas de rociadores y sistemas de supresión.","icon":"flame"}];

type Clip = { src: string; poster: string; title: string; desc: string };

const clips = [{"src":"/videos/factory/assembly.mp4","poster":"/videos/factory/assembly-poster.webp","title":"Montaje","desc":"Juntas con par verificado en válvulas de control hidráulico"},{"src":"/videos/factory/blue-valves.mp4","poster":"/videos/factory/blue-valves-poster.webp","title":"Inspección","desc":"Unidades probadas de presión listas para el envío"},{"src":"/videos/factory/red-field.mp4","poster":"/videos/factory/red-field-poster.webp","title":"Stock Disponible","desc":"Hidrantes terminados en espera de embarque"},{"src":"/videos/factory/loading-close.mp4","poster":"/videos/factory/loading-close-poster.webp","title":"Embalaje y Carga","desc":"Pedido de exportación en la bodega, encajado y fajado"},{"src":"/videos/factory/dispatch.mp4","poster":"/videos/factory/dispatch-poster.webp","title":"Envío","desc":"Camión completo saliendo de la planta hacia el puerto"}];

const walkthroughClip = {"src":"/assets/projects/project-walkthrough.mp4","poster":"/assets/projects/pump-room-wide.webp","title":"Vídeo en Obra"};

const stats = [
  { value: String(products.length), unit: '', label: "Modelos en Stock" },
  { value: String(categories.length), unit: '', label: "Líneas de Producto" },
  { value: '100', unit: '%', label: "Probadas a Presión" },
  { value: 'ISO 9001', unit: '', label: "Sistema de Calidad" }
];

const capability = [{"icon":"valve","title":"Líneas de Producción Propias","body":"Mecanizado CNC, ensamble, pruebas de presión y recubrimiento se realizan en nuestras propias líneas de la planta de Quanzhou, con capacidad colaboradora calificada para picos de demanda."},{"icon":"gauge","title":"Cotización Detallada en 12 Horas","body":"Envíe planos, especificaciones o solo una foto — nuestros ingenieros responden con cotización detallada, stock y tiempo de entrega en 12 horas, los 7 días."},{"icon":"doc","title":"Asesoría de aplicación y selección","body":"Construimos cada página de producto en torno a las especificaciones con las que realmente se trabaja — clase de presión, norma de conexión, material del cuerpo y del obturador, y aplicación — con cotizaciones bajo consulta y soporte de ingeniería para sistemas de suministro de agua, control industrial de fluidos y protección contra incendios."}];

const svgOpen = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">';
const icons: Record<string, string> = {
  valve: svgOpen + '<path d="M4 16 12 9l8 7H4Z"/><path d="M12 9V4"/><path d="M8.5 4h7"/></svg>',
  gauge: svgOpen + '<circle cx="12" cy="10" r="6"/><path d="M12 10l3.2-2.6"/><path d="M6 20h12"/></svg>',
  cog: svgOpen + '<circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.4M12 18.6V21M3 12h2.4M18.6 12H21M5.6 5.6l1.7 1.7M16.7 16.7l1.7 1.7M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7"/></svg>',
  doc: svgOpen + '<path d="M7 3h7l4 4v14H7V3Z"/><path d="M14 3v4h4"/><path d="M10 12h6M10 16h6"/></svg>',
  flame: svgOpen + '<path d="M12 3c3 4 5 6 5 9a5 5 0 0 1-10 0c0-2.2 1.1-3.8 2.6-5.2"/></svg>',
  drop: svgOpen + '<path d="M12 3l5.4 7a6.4 6.4 0 1 1-10.8 0L12 3Z"/></svg>',
  pipe: svgOpen + '<path d="M3 8.5h7v7H3zM14 8.5h7v7h-7z"/><path d="M10 12h4"/><path d="M3 8.5v7M21 8.5v7"/></svg>',
  guide: svgOpen + '<path d="M4 5h7v15H4zM13 5h7v15h-7z"/><path d="M7 9h1M16 9h1"/></svg>',
  chat: svgOpen + '<path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9h8M8 12h5"/></svg>'
};
const tick = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5 9 17.5 20 6.5"/></svg>';
---

<Layout
  locale="es"
  title="Wanlian Fluid | Fabricante y Exportador de Válvulas Industriales y Protección Contra Incendios"
  description="Wanlian Fluid es un fabricante y exportador B2B con sede en Quanzhou de válvulas industriales, equipos de protección contra incendios y control hidráulico para proyectos globales. Líneas de producción propias, ISO 9001, cotización bajo consulta."
  faq={faq}
  video={{ name: 'Wanlian Fluid en 50 Segundos', description: 'Vídeo de presentación de la empresa: sala de muestras, líneas de producción, personalización OEM y control de calidad en la planta de Quanzhou.', thumbnail: '/videos/company-intro-poster.webp', src: '/videos/company-intro.mp4', duration: 'PT49S', uploadDate: '2026-09-18' }}
>
  <div class="c68">

    <section class="c68-hero">
      <div class="c68-wrap c68-hero-grid">
        <div class="c68-rv">
          <p class="c68-eyebrow"><span class="c68-dot"></span>Fabricante y Exportador — Válvulas e Incendio</p>
          <h1>Válvulas y Protección Contra <em>Incendios para Proyectos Globales.</em></h1>
          <p class="c68-rule" aria-hidden="true"></p>
          <p class="c68-lede">Válvulas industriales, hidrantes y grupos de válvulas de alarma y rociado: ensayo de presión del 100%, ISO 9001 y cotización detallada en 12 horas.</p>
          <div class="c68-cta">
            <a class="c68-btn c68-btn-red" href="#product-lines">Categorías</a>
            <a class="c68-btn c68-btn-ghost" href="/es/contact/#inquiry">Solicitar Cotización</a>
          </div>
        </div>
        <figure class="c68-frame c68-rv">
          <span class="c68-frame-tab"></span>
          <img src="/assets/factory/plant-exterior.webp" alt="Wanlian Fluid plant exterior in Quanzhou, Fujian" decoding="async" />
          <figcaption>Imágenes Reales de Nuestra Planta</figcaption>
        </figure>
      </div>
      <div class="c68-stats">
        <div class="c68-wrap c68-stats-grid">
          {stats.map((s) => (
            <div class="c68-stat">
              <p class="c68-stat-num">{s.value}<span>{s.unit}</span></p>
              <p class="c68-stat-label">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="product-lines">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Series de Productos</p>
          <h2>Categorías Principales de <em>Productos.</em></h2>
          <p class="c68-head-sub">Ingeniería de alta precisión para redes globales de incendio y agua.</p>
        </header>
        <div class="c68-lines">
          {categories.map((c) => (
            <a class="c68-line c68-rv" href={c.href}>
              <span class="c68-line-media"><img src={c.image} alt={c.leadName} loading="lazy" decoding="async" /></span>
              <span class="c68-line-body">
                <span class="c68-line-count">{c.count}</span>
                <span class="c68-line-name">{c.name}</span>
                <span class="c68-line-more">Catálogo disponible bajo consulta <i aria-hidden="true">&rarr;</i></span>
              </span>
            </a>
          ))}
          <a class="c68-line c68-line-full c68-rv" href="/es/products/">
            <span class="c68-line-body">
              <span class="c68-line-count">Catálogo Completo</span>
              <span class="c68-line-name c68-line-name-inv">{products.length}</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section class="c68-band">
      <div class="c68-wrap">
        <div class="c68-cap-grid">
          {capability.map((c) => (
            <article class="c68-cap c68-rv">
              <span class="c68-ico" set:html={icons[c.icon]}></span>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="about">
      <div class="c68-wrap c68-profile-grid">
        <div class="c68-rv">
          <header class="c68-head">
            <p class="c68-kicker">Perfil de la Empresa</p>
            <h2>Soluciones de Control de Fluidos <em>Para Proyectos Globales.</em></h2>
          </header>
          <p class="c68-body">Con sede en Quanzhou, Fujian — núcleo de la industria china de tuberías y válvulas — Quanzhou Wanlian Fluid Equipment Co., Ltd. fabrica y exporta válvulas industriales, productos de control hidráulico, componentes de hidrantes y equipos de protección contra incendios para proyectos B2B internacionales. La fabricación se realiza en nuestras propias líneas de producción en Quanzhou, con artículos seleccionados producidos por socios de fabricación cualificados; los cuerpos de válvula se mecanizan por CNC y cada unidad se somete a prueba de presión del cuerpo y de estanqueidad al aire antes del envío, bajo un sistema de gestión de calidad ISO 9001.</p>
          <p class="c68-profile-link"><a href="/es/about/">Sobre Nosotros &rarr;</a><a href="/es/applications/">Aplicaciones &rarr;</a></p>
        </div>
        <div class="c68-shots">
          <figure class="c68-shot c68-rv">
            <img src="/assets/factory/workshop.webp" alt="Main workshop at the Quanzhou plant" loading="lazy" decoding="async" />
          </figure>
          <figure class="c68-shot c68-rv">
            <img src="/assets/factory/powder-coating.webp" alt="Powder coating line at the Quanzhou plant" loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class="c68-band" id="process">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Proceso de Producción</p>
          <h2>Nuestro Proceso de <em>Fabricación.</em></h2>
        </header>
        <ol class="c68-steps">
          {productionSteps.map((s) => (
            <li class="c68-step c68-rv">
              <span class="c68-step-n">{s.step}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="c68-band c68-dark" id="factory">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker c68-kicker-red">En Directo de la Fábrica</p>
          <h2>Imágenes Reales de <em>Nuestra Planta.</em></h2>
          <p class="c68-head-sub">Sin vídeo de stock, nada montado: la planta de Quanzhou en acción, del montaje al envío.</p>
        </header>
        <div class="c68-video-lead">
          <figure class="c68-vid c68-rv">
            <video src="/videos/company-intro.mp4" poster="/videos/company-intro-poster.webp" controls playsinline preload="none"></video>
            <figcaption><strong>Wanlian Fluid en 50 Segundos</strong><span>Sala de muestras, líneas de producción y control de calidad en nuestra planta de Quanzhou — imágenes reales, sin vídeo de stock.</span></figcaption>
          </figure>
          <div class="c68-side">
            <ul class="c68-video-note">
              <li>Certificado ISO 9001</li>
              <li>Coordinación de empaque de exportación</li>
              <li>Soporte de documentación de producto</li>
            </ul>
            <div class="c68-side-shots">
              <figure class="c68-sshot c68-rv">
                <img src="/assets/factory/assembly.webp" alt="Assembly and finishing bay" loading="lazy" decoding="async" style="aspect-ratio: 5 / 2" />
                <figcaption>Montaje</figcaption>
              </figure>
              <figure class="c68-sshot c68-rv">
                <img src="/assets/factory/fire-hose.webp" alt="Stock Disponible" loading="lazy" decoding="async" style="aspect-ratio: 5 / 2" />
                <figcaption>Stock Disponible</figcaption>
              </figure>
            </div>
          </div>
        </div>
        <div class="c68-clips">
          {clips.map((c) => (
            <figure class="c68-clip c68-rv">
              <video src={c.src} poster={c.poster} controls playsinline preload="none"></video>
              <figcaption><strong>{c.title}</strong><span>{c.desc}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Soluciones de Producto</p>
          <h2>Diseñadas para <em>Servicio de Alta Presión.</em></h2>
          <p class="c68-head-sub"><a class="c68-inlink" href="/es/applications/">Soluciones &rarr;</a></p>
        </header>
        <div class="c68-ind">
          {industries.map((i) => (
            <a class="c68-ind-card c68-rv" href="/es/applications/">
              <span class="c68-ico" set:html={icons[i.icon]}></span>
              <h3>{i.name}</h3>
              <p>{i.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band" id="quality">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Certificados</p>
          <h2>Certificado, <em>Cada Lote Probado</em></h2>
        </header>
        <div class="c68-cert-grid">
          {certifications.map((c) => (
            <div class="c68-cert c68-rv">
              <p class="c68-cert-name">{c.name}</p>
            </div>
          ))}
        </div>
        <div class="c68-chips">
          <a class="c68-chip c68-chip-link" href="/es/certificates/">Certificados y Aprobaciones &rarr;</a>
          <a class="c68-chip c68-chip-link" href="/es/faq/">Preguntas Frecuentes &rarr;</a>
        </div>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="resources">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Recursos Técnicos</p>
          <h2>Descripciones de Sistema <em>y Certificaciones</em></h2>
          <p class="c68-head-sub">Las fichas técnicas son útiles; el contexto de ingeniería es mejor. Explore antes de especificar.</p>
        </header>
        <div class="c68-guides">
          {resources.map((r) => (
            <a class="c68-guide c68-rv" href={r.href}>
              <span class="c68-guide-eyebrow">{r.eyebrow}</span>
              <span class="c68-guide-title">{r.title}</span>
              <span class="c68-guide-desc">{r.desc}</span>
              <span class="c68-guide-more">Leer Guía <i aria-hidden="true">&rarr;</i></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="c68-band" id="projects">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Casos de Proyecto</p>
          <h2>Nuestros Proyectos, <em>En Obra</em></h2>
          <p class="c68-head-sub">Fotos y vídeo de un proyecto de sala de bombas contra incendios — trabajo real de instalación, listo para la entrega.</p>
        </header>
        <div class="c68-proj-grid">
          <figure class="c68-vid c68-vid-tall c68-rv">
            <video src={walkthroughClip.src} poster={walkthroughClip.poster} controls playsinline preload="none"></video>
            <figcaption><strong>{walkthroughClip.title}</strong></figcaption>
          </figure>
          <div class="c68-proj-cards">
            {projectPhotos.map((s) => (
              <figure class="c68-pcard c68-rv">
                <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
                <figcaption>{s.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
        <ul class="c68-scope-list">
          {projectScope.map((s) => (<li set:html={tick + '<span>' + s + '</span>'}></li>))}
        </ul>
      </div>
    </section>

    <section class="c68-band c68-band-mist" id="model-index">
      <div class="c68-wrap">
        <header class="c68-head">
          <p class="c68-kicker">Productos</p>
          <h2>Línea de Productos <em>Completa</em></h2>
        </header>
        <div class="c68-index">
          {catalogByCategory.map((g) => (
            <div class="c68-index-col c68-rv">
              <p class="c68-index-head"><a href={g.href}>{g.name}</a><span>{g.items.length}</span></p>
              <ul>
                {g.items.map((it) => (<li><a href={it.href}>{it.name}</a></li>))}
              </ul>
            </div>
