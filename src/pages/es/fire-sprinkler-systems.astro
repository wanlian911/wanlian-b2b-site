---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: '¿Sus rociadores están listados UL?',
		answer: 'Sí. Nuestros rociadores y componentes de sistema están listados UL/ULC cuando corresponde: los certificados están disponibles en nuestra página de Certificados. Nuestros ingenieros confirman el paquete de certificación exacto para su mercado de destino antes de cotizar.'
	},
	{
		question: '¿Cuál es la diferencia entre los sistemas de rociadores húmedos y secos?',
		answer: 'Los sistemas húmedos mantienen agua en las tuberías para una descarga inmediata cuando se activa un rociador. Los sistemas secos utilizan aire o nitrógeno presurizado con una válvula de tubería seca, lo que los hace adecuados para espacios sin calefacción donde existe riesgo de congelación. Los sistemas de preacción combinan ambos beneficios para áreas sensibles al agua.'
	},
	{
		question: '¿Suministran conexiones flexibles de bajada para rociadores?',
		answer: 'Sí, podemos suministrar conexiones de bajada flexibles con malla de acero inoxidable que simplifican la instalación y permiten reposicionar rápidamente los rociadores según la distribución del cielo raso, reduciendo el tiempo de mano de obra frente a la tubería rígida.'
	},
	{
		question: '¿Pueden ofrecer una cotización BOM completa del sistema?',
		answer: 'Sí. Envíenos los planos de su proyecto o una lista de componentes y cotizaremos rociadores, válvulas de alarma, indicadores de flujo, coladores y accesorios como un solo paquete: un único proveedor para todo el circuito de rociadores.'
	},
	{
		question: '¿Qué clasificaciones de temperatura están disponibles?',
		answer: 'Las clasificaciones estándar de bulbo de vidrio incluyen 57 °C, 68 °C, 79 °C, 93 °C y 141 °C con bulbos codificados por color, en versiones de respuesta estándar (bulbo de 5 mm) y respuesta rápida (bulbo de 3 mm) según la práctica NFPA.'
	}
];

const sprinklerProducts = [
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'Glass Bulb Fire Sprinkler (ZST Series)',
		img: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		desc: 'Colgante/vertical/pared lateral, K=80/115, 57–141 °C'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Wet Alarm Check Valve (ZSFZ 150)',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'Campana de alarma hidráulica, cámara de retardo, DN100–DN200'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Deluge Alarm Valve Group (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Operada por diafragma, para sistemas de diluvio y rociado de agua'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Pre-action Alarm System (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Doble disparo a prueba de fallos para bibliotecas, archivos y centros de datos'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Vane Type Water Flow Indicator (ZSJZ)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'Retardo ajustable de 2–60 s, DN50–DN200, montaje de sillín o brida'
	},
	{
		slug: 'telescopic-y-strainer-sgl41h',
		name: 'Telescopic Y-Strainer (SGL41H)',
		img: '/assets/products/telescopic-y-strainer-sgl41h.webp',
		desc: 'Protege las válvulas de partículas, malla SS304/316'
	}
];
---

<Layout
	title="Sistemas de Rociadores Contra Incendios y Cabezales UL - WLFE"
	description="Rociadores listados UL, conexiones flexibles y componentes completos de sistemas de rociadores contra incendios para edificios comerciales e industriales. Precio de fábrica."
	type="product"
	locale="es"
	productData={{
		name: 'Sistemas de Rociadores Contra Incendios',
		image: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		description: 'Rociadores listados UL, válvulas de alarma, indicadores de flujo y componentes de sistema para sistemas de rociadores húmedos, secos y de preacción en edificios comerciales e industriales, fabricados por Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Sistemas de Rociadores Contra Incendios' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/es/" class="hover:text-blue-600">Inicio</a>
			<span>/</span>
			<a href="/es/products/" class="hover:text-blue-600">Productos</a>
			<span>/</span>
			<span class="text-gray-600">Sistemas de Rociadores Contra Incendios</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Suministro Completo de Sistemas de Rociadores</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Sistemas completos de rociadores contra incendios con componentes listados UL</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid suministra rociadores listados UL, conexiones de bajada flexibles, válvulas de alarma y accesorios de sistema para instalaciones húmedas, secas y de preacción en edificios comerciales e industriales: un solo proveedor para todo el circuito de rociadores.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Listado UL/ULC', 'K=80 / K=115', 'Temperaturas 57–141 °C', 'Suministro BOM del Sistema'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Componentes de Sistemas de Rociadores</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{sprinklerProducts.map(p => (
					<a href={`/es/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Especificaciones Clave</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Especificación</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Detalle</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Certificación</td>
							<td class="px-4 py-3 text-gray-700">Listado UL/ULC (según modelo y mercado de destino)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Tamaños de rociador</td>
							<td class="px-4 py-3 text-gray-700">1/2" (DN15), 3/4" (DN20), 1" — colgante, vertical, pared lateral</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Coeficiente de flujo</td>
							<td class="px-4 py-3 text-gray-700">K=80 ±4 / K=115 ±9 (otros factores K según modelo)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Clasificaciones de temperatura</td>
							<td class="px-4 py-3 text-gray-700">57 °C / 68 °C / 79 °C / 93 °C / 141 °C, bulbos de vidrio codificados por color</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Tipos de respuesta</td>
							<td class="px-4 py-3 text-gray-700">Respuesta estándar (bulbo de 5 mm) / Respuesta rápida (bulbo de 3 mm)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Válvulas del sistema</td>
							<td class="px-4 py-3 text-gray-700">Alarma tipo húmedo (ZSFZ), diluvio (ZSFM), preacción (ZSFY), indicadores de flujo (ZSJZ)</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplicaciones</h2>
			<p class="text-gray-700 leading-relaxed">Nuestros componentes de sistemas de rociadores protegen edificios de oficinas comerciales, hoteles, hospitales, escuelas, fábricas, almacenes, centros de datos y estacionamientos subterráneos. Los sistemas de preacción se recomiendan para bibliotecas, archivos y salas de cómputo donde debe evitarse la descarga accidental.</p>

			<!-- Why WLFE -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">¿Por qué elegir Wanlian Fluid?</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Suministro BOM integral</strong> — rociadores, conexiones, válvulas de alarma y accesorios cotizados como un solo paquete.</li>
				<li><strong>Componentes certificados</strong> — listados UL/ULC cuando corresponde; certificados en nuestra <a href="/es/certificates/" class="text-brand-blue font-semibold hover:underline">página de Certificados</a>.</li>
				<li><strong>Orientados a códigos de construcción</strong> — configuraciones alineadas con la práctica NFPA para la aceptación de proyectos a nivel global.</li>
			</ul>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Preguntas Frecuentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">¿Necesita componentes de sistemas de rociadores?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envíenos el tipo de edificio y su lista de componentes: le responderemos con una cotización BOM completa en un plazo de 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/es/contact/?product=Fire%20Sprinkler%20Systems" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotización</a>
						<a href="https://wa.me/8618684324501?text=Hola%2C%20necesito%20componentes%20de%20sistemas%20de%20rociadores%20contra%20incendios" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chatear por WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
