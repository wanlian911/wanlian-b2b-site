---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: '¿Qué es un rociador ESFR?',
		answer: 'ESFR significa Early Suppression Fast Response. El rociador ESFR de esta gama usa un diseño de alto caudal, un bulbo de vidrio de respuesta rápida de 74 °C y orientación colgante o vertical para almacenamiento en altura, bodegas e instalaciones industriales.'
	},
	{
		question: '¿Los rociadores ESFR pueden sustituir a los rociadores en estantería?',
		answer: 'Pueden hacerlo en las disposiciones de almacenamiento que satisfacen los criterios de diseño aplicables. La decisión final depende de la mercancía, la altura de almacenamiento, la altura del techo, la distribución de la estantería, el factor K y la presión de diseño, por lo que el diseñador de protección contra incendios y la autoridad competente deben aprobar la disposición.'
	},
	{
		question: '¿Cómo afecta el factor K a la selección ESFR?',
		answer: 'El factor K y la presión de operación determinan el agua que entrega cada rociador. Use el cálculo hidráulico y los criterios de almacenamiento para seleccionar el modelo ESFR; no elija un rociador por el diámetro nominal de la tubería.'
	},
	{
		question: '¿Qué clasificación de temperatura usa el rociador ESFR?',
		answer: 'El producto ESFR se especifica con un bulbo de vidrio de respuesta rápida de 74 °C (165 °F). Confirme las condiciones ambientales y el listado o aprobación requeridos para el proyecto de destino antes de pedir.'
	},
	{
		question: '¿Qué debe incluir un paquete de rociadores ESFR?',
		answer: 'Un pedido típico empieza por el listado de rociadores y añade los rociadores seleccionados, la válvula de retención con alarma húmeda, los indicadores de flujo de agua, las válvulas de aislamiento monitorizadas y los accesorios de sistema estándar que exija el diseño aprobado.'
	},
	{
		question: '¿Pueden cotizar la lista de materiales completa del sistema de bodega?',
		answer: 'Sí. Envíe el listado de rociadores aprobado, la información de almacenamiento y techo, los datos de diseño hidráulico y la tabla de válvulas. Podemos cotizar los rociadores verificados y los componentes de sistema como un único paquete de proyecto.'
	}
];

const products = [
	{
		slug: 'esfr-sprinkler-head',
		name: 'ESFR Early Suppression Fast Response Sprinkler',
		img: '/assets/products/esfr-sprinkler-head.webp',
		desc: 'ESFR-202 / ESFR-242 / ESFR-363, 74 °C, colgante y vertical'
	},
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'Glass Bulb Fire Sprinkler (ZST Series)',
		img: '/assets/products/glass-bulb-fire-sprinkler-zst.webp',
		desc: 'DN15 / DN20, K=80 ±4 / K=115 ±9, colgante / vertical / pared lateral'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Wet Alarm Check Valve ZSFZ 150',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'DN100 / DN150 / DN200, 1,6 MPa, campana de alarma y cámara de retardo'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Vane Type Water Flow Indicator (ZSJZ Series)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'DN50–DN200, 1,2 / 1,6 MPa, retardo ajustable de 2–60 s'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Signal Butterfly Valve (DN80 PN16)',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80-overlay.png',
		desc: 'DN50–DN300, PN16, posición abierta/cerrada monitorizada'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'UL/FM Fire Protection Resilient Seated OS&Y Gate Valve',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: '2"–10", extremos ranurados, vástago ascendente, listado UL / FM'
	}
];
---

<Layout
	title="Rociadores ESFR y Sistemas de Rociación de Almacén | WLFE"
	description="Rociadores ESFR para sistemas de rociación de almacén: factor K, presión, alternativas en estantería y paquetes de válvulas completos de Wanlian."
	type="product"
	locale="es"
	productData={{
		name: 'Sistemas de Rociadores ESFR',
		image: '/assets/products/esfr-sprinkler-head.webp',
		description: 'Rociadores ESFR y componentes verificados de protección contra incendios para almacenamiento en altura, bodegas e instalaciones industriales.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Rociadores ESFR' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/es/" class="hover:text-blue-600">Inicio</a>
			<span>/</span>
			<a href="/es/products/" class="hover:text-blue-600">Productos</a>
			<span>/</span>
			<span class="text-gray-600">Rociadores ESFR</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Sistemas de Rociación de Bodega — Directo de Fábrica</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Rociadores ESFR para Protección de Almacenes en Altura</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Los rociadores ESFR se eligen cuando el diseño de un almacén necesita una descarga de techo rápida y de alto volumen para proteger el almacenamiento. Wanlian suministra el rociador ESFR y las válvulas monitorizadas, de alarma y de detección de flujo que lo rodean, de modo que el diseño aprobado pueda cotizarse como un único paquete coordinado.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Respuesta rápida 74 °C', 'Colgante / vertical', 'Planificación del factor K', 'Soporte de BOM de almacén'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Rociadores ESFR y Componentes del Sistema</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{products.map(p => (
					<a href={`/es/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Selección y Especificación ESFR</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Punto de selección</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Información verificada del producto</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">Rociador ESFR</td><td class="px-4 py-3 text-gray-700">ESFR-202 / ESFR-242 / ESFR-363 y ZSTX-161; 74 °C; colgante PY o vertical UY; NPT R1/2" o R3/4".</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Planificación hidráulica</td><td class="px-4 py-3 text-gray-700">Use el diseño de almacenamiento aprobado para fijar factor K, presión de operación, demanda de agua y separación entre rociadores antes de liberar.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Opción de rociador estándar</td><td class="px-4 py-3 text-gray-700">Rociadores de bulbo ZST: DN15 / DN20, K=80 ±4 o K=115 ±9, en tipos colgante, vertical y de pared lateral.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Alarma y flujo</td><td class="px-4 py-3 text-gray-700">Válvula de alarma húmeda ZSFZ: DN100 / DN150 / DN200 a 1,6 MPa; indicador de flujo ZSJZ: DN50–DN200 a 1,2 / 1,6 MPa.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Aislamiento y monitorización</td><td class="px-4 py-3 text-gray-700">Válvula de mariposa señalizada: DN50–DN300, PN16, con interruptor de señal eléctrica integrado; válvula de compuerta OS&Y: 2"–10", ranurada, listada UL / FM.</td></tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Qué Incluir en un Solo Pedido ESFR</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2">
				<li><strong>Listado de rociadores aprobado</strong> — mercancía almacenada, información de estantería y techo, modelo de rociador, orientación, rosca y cantidad.</li>
				<li><strong>Base de diseño hidráulico</strong> — factor K seleccionado, presión de diseño, demanda de agua y la norma del proyecto o comentarios de la autoridad competente.</li>
				<li><strong>Juego de control del sistema</strong> — válvula de retención con alarma húmeda, indicadores de flujo de agua y las válvulas de aislamiento monitorizadas especificadas.</li>
				<li><strong>Documentación y embalaje</strong> — datos de producto, certificados requeridos, cantidades por caja y marcado del mercado de destino confirmados antes de fabricar.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Recursos de Diseño ESFR</h2>
			<p class="text-gray-700 leading-relaxed">Para las decisiones de diseño, consulte la <a href="/es/guides/esfr-sprinkler-system-guide/" class="text-brand-blue font-semibold hover:underline">guía del sistema de rociadores ESFR</a>, la <a href="/es/guides/fire-sprinkler-head-selection-guide/" class="text-brand-blue font-semibold hover:underline">guía de selección de rociadores</a> y la <a href="/es/guides/fire-sprinkler-system-valves-guide/" class="text-brand-blue font-semibold hover:underline">guía de válvulas de sistemas de rociadores</a>.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Preguntas Frecuentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">¿Necesita un Paquete de Rociadores ESFR para Almacén?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envíe el listado de rociadores y la base de diseño hidráulico; confirmamos la lista de componentes y respondemos con una cotización coordinada en 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/es/contact/?product=Sistema%20de%20Rociadores%20ESFR" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotización</a>
						<a href="https://wa.me/8618684324501?text=Hola%2C%20necesito%20un%20paquete%20de%20rociadores%20ESFR" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chatear por WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
