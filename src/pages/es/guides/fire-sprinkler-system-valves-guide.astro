---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'wet-pipe-systems-zsfz', label: '1. Sistemas de Tubería Húmeda: La Válvula de Alarma Tipo Húmedo ZSFZ' },
	{ id: 'deluge-systems-zsfm', label: '2. Sistemas de Diluvio: La Válvula de Diluvio ZSFM' },
	{ id: 'pre-action-systems-zsfy', label: '3. Sistemas de Preacción: La Válvula de Doble Disparo ZSFY' },
	{ id: 'zone-detection-zsjz', label: '4. Detección por Zona: El Indicador de Flujo de Agua ZSJZ' },
	{ id: 'selecting-the-right-valve', label: '5. Cómo Seleccionar la Válvula Correcta para su Proyecto' },
	{ id: 'faq', label: 'Preguntas Frecuentes' }
];

const faq = [
	{
		question: '¿Cuál es la diferencia entre una válvula de alarma tipo húmedo y una válvula de diluvio?',
		answer: 'Una válvula de alarma tipo húmedo (ZSFZ) se instala en sistemas de rociadores de tubería húmeda, donde la tubería está siempre cargada de agua; detecta el flujo causado por la apertura de un cabezal de rociador y activa la alarma. Una válvula de diluvio (ZSFM) es una válvula de control seca utilizada en sistemas de diluvio que se abren para inundar simultáneamente con agua toda el área protegida — típicamente para ocupaciones de alto riesgo como plantas químicas y centrales eléctricas.'
	},
	{
		question: '¿Cuándo debe utilizarse un sistema de preacción (ZSFY)?',
		answer: 'Los sistemas de preacción (ZSFY) combinan una válvula tipo diluvio con rociadores automáticos y requieren dos disparos independientes (p. ej., detección de humo más calor) antes de que el agua entre a la tubería. Se especifican para entornos sensibles al agua como museos, archivos, centros de datos y cámaras frigoríficas, donde debe evitarse la descarga accidental.'
	},
	{
		question: '¿Qué función cumple un indicador de flujo de agua (ZSJZ) en un sistema de rociadores?',
		answer: 'Un indicador de flujo de agua tipo paleta (ZSJZ) se instala en las tuberías secundarias de rociadores y detecta el flujo de agua causado por la apertura de un cabezal de rociador, enviando una señal al panel de alarma contra incendios para identificar la zona de activación. Cuenta con un retardo de tiempo ajustable para filtrar las sobrepresiones transitorias.'
	},
	{
		question: '¿Las válvulas ZSFZ, ZSFM y ZSFY son intercambiables?',
		answer: 'No. Cada tipo de válvula corresponde a una arquitectura de sistema específica: ZSFZ para sistemas húmedos, ZSFM para sistemas de diluvio y ZSFY para sistemas de preacción. Sustituir una por otra romperá la lógica del sistema y puede reprobar la inspección. Seleccione según la clase de riesgo de la ocupación y la base de diseño.'
	},
	{
		question: '¿Qué certificaciones se requieren para las válvulas de alarma de rociadores?',
		answer: 'Los conjuntos de válvulas de alarma para rociadores deben estar listados por el organismo de aprobación aplicable a su mercado — comúnmente UL/FM para Norteamérica, CE para Europa, LPCB para proyectos del Reino Unido y el Commonwealth, además de ISO 9001 como línea base de calidad. Wanlian suministra conjuntos ZSFZ/ZSFM/ZSFY con paquetes de certificación acordes al mercado de destino.'
	}
];

const valveProducts = [
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Válvula de Retención de Alarma Tipo Húmedo (ZSFZ-150)',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'Válvula de alarma para tubería húmeda con detección de flujo y disparo de alarma'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Válvula de Diluvio con Alarma (Serie ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Válvula de diluvio operada por diafragma para ocupaciones de alto riesgo'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Sistema de Alarma de Preacción (Serie ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Válvula de preacción de doble disparo a prueba de fallos para zonas sensibles al agua'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Indicador de Flujo de Agua Tipo Paleta (Serie ZSJZ)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'Detección de flujo por zona con retardo ajustable para rociadores húmedos'
	}
];
---

<Layout
	title="Guía de Válvulas de Rociadores: Húmedo, Diluvio y Preacción"
	description="Guía de válvulas de rociadores: alarma tipo húmedo ZSFZ, diluvio ZSFM, preacción ZSFY e indicador de flujo ZSJZ — cómo funciona cada una y cuándo especificarla."
	type="article"
	locale="es"
	faq={faq}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/es/" class="hover:text-blue-600">Inicio</a>
			<span>/</span>
			<span class="text-gray-600">Guías</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Guía de Sistemas de Rociadores Contra Incendios</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Válvulas para Sistemas de Rociadores: Guía Completa (Húmedo, Diluvio y Preacción)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Todo sistema de rociadores se construye alrededor de un conjunto de válvula de control — el punto donde el suministro de agua se convierte en el sistema de supresión contra incendios. Especificar el tipo de válvula equivocado hace que toda la lógica del sistema falle la inspección. Esta guía explica los cuatro tipos de válvula que dominan el diseño moderno de rociadores contra incendios, qué hace cada uno y los tipos de ocupación que protegen. Para las válvulas de aislamiento y de control de sección alrededor del conjunto — compuerta OS&amp;Y, mariposa con señal y retención — lea nuestra <a href="/es/guides/fire-sprinkler-control-valve-types/" class="text-brand-blue font-semibold hover:underline">guía de tipos de válvulas de control para rociadores</a>.</p>

			<div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
				{valveProducts.map(p => (
					<a href={`/es/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			
			<TableOfContents headings={toc} />

			<h2 id="wet-pipe-systems-zsfz" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Sistemas de Tubería Húmeda: La Válvula de Alarma Tipo Húmedo ZSFZ</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Los sistemas de tubería húmeda son la configuración de rociadores más común: la tubería permanece cargada de agua en todo momento y cada rociador se abre de forma individual cuando su elemento termosensible se rompe. La <a href="/es/products/wet-alarm-check-valve-zsfz-150/" class="text-brand-blue font-semibold hover:underline">válvula de retención de alarma tipo húmedo ZSFZ</a> se instala en el montante del sistema y cumple dos funciones: impide el flujo inverso del sistema hacia el suministro y detecta el flujo de agua que se genera cuando un rociador se abre, activando las alarmas mecánica y eléctrica. El flujo continúa hacia el sistema hasta que el suministro se cierra manualmente.</p>
			<p class="text-gray-700 leading-relaxed">Los sistemas húmedos son rápidos, simples y económicos de mantener — pero no pueden utilizarse donde la temperatura ambiente suponga riesgo de congelamiento de la tubería.</p>

			<h2 id="deluge-systems-zsfm" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Sistemas de Diluvio: La Válvula de Diluvio ZSFM</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Los sistemas de diluvio protegen ocupaciones de alto riesgo donde el fuego puede propagarse más rápido de lo que los rociadores individuales pueden responder: plantas químicas, talleres de pintura, centrales eléctricas, hangares de aeronaves. Todas las boquillas de una zona de diluvio están abiertas y el sistema se contiene mediante una única válvula de control — la <a href="/es/products/deluge-alarm-valve-zsfm/" class="text-brand-blue font-semibold hover:underline">válvula de diluvio con alarma ZSFM</a>. Cuando un sistema de detección (humo/calor/llama) señala un incendio, la válvula se abre y el agua inunda todas las boquillas simultáneamente.</p>
			<p class="text-gray-700 leading-relaxed">La ZSFM, operada por diafragma, abre con rapidez y vuelve a sellar de forma fiable tras la operación, lo cual importa porque las zonas de diluvio suelen ser grandes y la válvula es el único punto de fallo del sistema.</p>

			<h2 id="pre-action-systems-zsfy" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Sistemas de Preacción: La Válvula de Doble Disparo ZSFY</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Los sistemas de preacción son hardware de diluvio con un giro de tubería de rociadores: la tubería permanece seca y el agua solo entra <em>después de que dos disparos independientes confirmen un incendio</em>. El <a href="/es/products/pre-action-alarm-system-zsfy/" class="text-brand-blue font-semibold hover:underline">sistema de alarma de preacción ZSFY</a> es el conjunto de control de esta arquitectura — una válvula tipo diluvio operada por una señal de detección de incendios, con rociadores automáticos aguas abajo que también actúan como fusibles individuales.</p>
			<p class="text-gray-700 leading-relaxed mb-4">¿Por qué especificar preacción? Tres razones predominan:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Contenidos sensibles al agua</strong> — museos, archivos, centros de datos, salas de transformadores: no entra agua a menos que dos señales lo confirmen.</li>
				<li><strong>Ambientes con riesgo de congelamiento</strong> — cámaras frigoríficas, almacenes sin calefacción: la tubería seca no puede congelarse.</li>
				<li><strong>Seguro contra descargas accidentales</strong> — la lógica de doble disparo hace que la descarga accidental sea estadísticamente insignificante.</li>
			</ul>

			<h2 id="zone-detection-zsjz" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Detección por Zona: El Indicador de Flujo de Agua ZSJZ</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Una vez que el sistema está en operación, el cuerpo de bomberos y el administrador del edificio necesitan saber <em>qué zona</em> está fluyendo. El <a href="/es/products/water-flow-indicator-zsjz/" class="text-brand-blue font-semibold hover:underline">indicador de flujo de agua tipo paleta ZSJZ</a> se instala en las tuberías secundarias de rociadores: cuando el agua se mueve, la paleta se desvía y el interruptor envía una señal al panel de alarma identificando la zona afectada. Un retardo de tiempo ajustable filtra las sobrepresiones transitorias que, de otro modo, causarían alarmas de molestia.</p>

			<h2 id="selecting-the-right-valve" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Cómo Seleccionar la Válvula Correcta para su Proyecto</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Ocupación / Necesidad</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Tipo de sistema</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Válvula de control</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Oficinas, comercios, almacenes (calefaccionados)</td>
							<td class="px-4 py-3 text-gray-700">Tubería húmeda</td>
							<td class="px-4 py-3 text-gray-700">Válvula de alarma tipo húmedo ZSFZ</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Química, energía, aviación, alto riesgo</td>
							<td class="px-4 py-3 text-gray-700">Diluvio</td>
							<td class="px-4 py-3 text-gray-700">Válvula de diluvio ZSFM</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Museos, centros de datos, cámaras frigoríficas</td>
							<td class="px-4 py-3 text-gray-700">Preacción</td>
							<td class="px-4 py-3 text-gray-700">Sistema de preacción ZSFY</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Identificación de zona (todos los sistemas húmedos)</td>
							<td class="px-4 py-3 text-gray-700">—</td>
							<td class="px-4 py-3 text-gray-700">Indicador de flujo ZSJZ</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Un conjunto completo normalmente combina la válvula de alarma con una válvula de compuerta con señal aguas arriba, una válvula de retención, manómetros y el juego de alarma. Cuando nos envía su clase de riesgo y el diámetro de tubería, cotizamos el conjunto completo de válvulas en lugar de una válvula aislada: un paquete certificado, un solo juego de documentos.</p>

			<!-- Guía relacionada -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Guía Relacionada: Tipos de Sistemas y Rociadores</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">¿Debe elegir entre sistemas húmedos, secos y de preacción, o seleccionar rociadores por factor K y temperatura? Lea la <a href="/es/guides/fire-sprinkler-system-wet-dry-preaction/" class="text-brand-blue font-semibold hover:underline">Guía de Sistemas de Rociadores Contra Incendios</a>.</p>
			</div>

			<!-- Sección de preguntas frecuentes -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Preguntas Frecuentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">¿Necesita una Cotización de un Conjunto de Válvulas de Rociadores?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envíenos su tipo de sistema, clase de riesgo y diámetro de tubería — respondemos con la especificación completa del conjunto de válvulas y el precio de fábrica en un plazo de 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/es/contact/?product=Conjunto%20de%20V%C3%A1lvulas%20de%20Rociadores" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotización</a>
						<a href="https://wa.me/8618684324501?text=Hola%2C%20necesito%20una%20cotizaci%C3%B3n%20de%20un%20conjunto%20de%20v%C3%A1lvulas%20de%20rociadores" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chatear por WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
