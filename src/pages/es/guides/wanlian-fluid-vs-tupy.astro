---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'tupy-overview', label: '1. Tupy: Quiénes Son Realmente' },
	{ id: 'wanlian-overview', label: '2. Wanlian Fluid: Quiénes Somos' },
	{ id: 'product-lines-compared', label: '3. ¿Cómo Se Compara Su Gama de Productos?' },
	{ id: 'valves-deep-dive', label: '4. Válvulas de Hierro Dúctil y Latón: La Superposición Real' },
	{ id: 'geography-and-service', label: '5. Geografía, Normas y Cobertura de Servicio' },
	{ id: 'where-each-wins', label: '6. Dónde Gana Cada Fabricante' },
	{ id: 'which-should-you-choose', label: '7. ¿Cuál Debería Elegir?' },
	{ id: 'faq', label: 'Preguntas Frecuentes' },
	{ id: 'sources', label: 'Fuentes' }
];

const faq = [
	{
		question: '¿Wanlian Fluid y Tupy son empresas relacionadas?',
		answer: 'No. Tupy es un grupo industrial brasileño fundado en 1938 en Joinville, Santa Catarina, con plantas en todo Brasil, enfocado en tubería, accesorios y válvulas de hierro dúctil para agua e industria. Wanlian Fluid es Quanzhou Wanlian Fluid Equipment Co., Ltd, un fabricante y exportador chino de equipo de protección contra incendios y control de fluidos. Son empresas independientes que solo se solapan en un tramo estrecho de válvulas de agua.'
	},
	{
		question: '¿Dónde compiten realmente Tupy y Wanlian Fluid?',
		answer: 'La superposición directa son las válvulas de servicio de agua: las válvulas de latón TupyValves de Tupy (EN 12420, PN25/30/40) y su gama de válvulas de hierro dúctil, frente a las válvulas de compuerta, mariposa, de retención y de control hidráulico de Wanlian (PN10-PN25 y clases ANSI). Fuera de ese tramo, los catálogos apenas se tocan — Tupy es fuerte en tubería y accesorios de hierro dúctil, mientras que Wanlian es fuerte en equipo especializado de protección contra incendios: hidrantes, válvulas de alarma, manguera contra incendios y extintores.'
	},
	{
		question: '¿Puede Tupy suministrar hidrantes y válvulas de alarma contra incendios?',
		answer: 'La gama publicada de Tupy se centra en tubería y accesorios de hierro dúctil y válvulas de latón para servicio de agua, aire y aceite. Los artículos especializados de protección contra incendios — hidrantes de barril seco, hidrantes anticolisión, grupos de válvulas de alarma húmedas, conexiones siamese, manguera contra incendios con revestimiento de caucho — son las líneas centrales de Wanlian. Para un alcance completo de incendio, la ventaja de fuente única está del lado del especialista en incendio.'
	},
	{
		question: '¿Qué opción es mejor para un proyecto municipal brasileño o de LatAm?',
		answer: 'Si el alcance es tubería de hierro dúctil y válvulas de agua con servicio local en Brasil, la huella regional de Tupy es la opción natural. Si el alcance es el lado de incendio del proyecto — hidrantes, válvulas de aislamiento, mangueras y los acoples de la flota — Wanlian Fluid envía el paquete completo de incendio en una sola PO con el patrón de acople de salida adaptado a su flota contra incendios, en configuraciones AWWA, NOM o alineadas con ABNT según modelo.'
	},
	{
		question: '¿Se pueden combinar ambas en un mismo proyecto?',
		answer: 'Sí — muchos proyectos de infraestructura en LatAm combinan a un proveedor regional de tubería/válvulas con un especialista de exportación para el alcance de incendio. El riesgo de coordinación está en las interfaces: acuerde las normas de bridas, los patrones de acople de salida y la documentación de ensayo entre ambas PO antes de ordenar, que es exactamente lo que cubre la secuencia de verificación de nuestra guía de abastecimiento.'
	}
];

const productRows = [
	{ slug: 'overground-fire-hydrant-ss100', name: 'Hidrante Contra Incendios Exterior Anticongelante (SS100/65)', img: '/assets/products/overground-fire-hydrant-ss100.webp', desc: 'Hidrante de barril seco anticongelante para redes de incendio municipal' },
	{ slug: 'resilient-seat-flanged-gate-valve-z41x', name: 'Válvula de Compuerta con Brida y Asiento Elástico (Z41X)', img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp', desc: 'Válvula de aislamiento DN50-DN700 para redes de agua e incendio' },
	{ slug: 'fire-hose-pvc-rubber-lining-8-65', name: 'Manguera Contra Incendios Layflat con Revestimiento de Caucho (8-65)', img: '/assets/products/fire-hose-pvc-rubber-lining-8-65.jpg', desc: 'Manguera de flota municipal con patrones de acople coincidentes' }
];
---

<Layout
	title="Wanlian Fluid vs Tupy: Válvulas e Incendios para LatAm (2026)"
	description="Wanlian Fluid vs Tupy (2026): válvulas de hierro dúctil y latón, hidrantes, mangueras y válvulas de alarma — qué marca encaja en su proyecto de agua e incendio."
	type="article"
	faq={faq}
	breadcrumbs={[{ name: 'Guías', href: '/es/blog/' }, { name: 'Wanlian vs Tupy' }]}
	locale="es"
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/es/" class="hover:text-blue-600">Inicio</a>
			<span>/</span>
			<a href="/es/blog/" class="hover:text-blue-600">Guías</a>
			<span>/</span>
			<span class="text-gray-600">Comparación de Proveedores</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Guía de Comparación de Proveedores · LatAm</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Wanlian Fluid vs Tupy: Equipo Contra Incendios y Válvulas de Hierro Dúctil para Proyectos de América Latina (2026)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Tupy es el nombre al que recurren la mayoría de las empresas de aguas de Brasil cuando el alcance incluye tubería, accesorios y válvulas de latón de hierro dúctil — un grupo industrial regional con fecha de fundación en 1938 y plantas en todo el país. Wanlian Fluid es un fabricante chino de protección contra incendios y control de fluidos que compite solo en el tramo de válvulas y posee el lado de incendio del alcance: hidrantes, válvulas de alarma, mangueras, extintores. Si su proyecto mezcla infraestructura de agua con infraestructura de incendio, la decisión es menos "Tupy o Wanlian" y más "qué línea de alcance lleva cada uno" — esta guía lo mapea a partir de lo que cada empresa publica realmente.</p>

			<div class="bg-blue-50 border border-blue-100 rounded-xl p-5 my-6">
				<p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-blue">Nota de evidencia:</strong> Los hechos de las empresas a continuación proceden de los materiales publicados de cada empresa (historia corporativa de Tupy y páginas de producto TupyValves; datos de producto, práctica de ensayo y páginas de certificados de Wanlian). Donde las dos gamas no se solapan, esta guía lo dice claramente — la respuesta honesta a la mayor parte de esta comparativa es "trabajos distintos".</p>
			</div>

			<!-- Product strip -->
			<div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
				{productRows.map(p => (
					<a href={`/es/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-32 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="tupy-overview" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Tupy: Quiénes Son Realmente</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Tupy fue fundada en 1938 por inmigrantes alemanes; la primera planta está en Joinville (Santa Catarina, Brasil), con plantas adicionales en São Paulo y otros estados brasileños. A lo largo de las décadas creció hasta convertirse en un grupo industrial diversificado, y el lado de manejo de fluidos del negocio — la gama de válvulas y accesorios Tupy Valves — se apoya en el hierro dúctil: barra de hierro fundido continuo, tubería y accesorios, más una familia de válvulas de latón.</p>
			<p class="text-gray-700 leading-relaxed">La gama TupyValves publicada es de válvulas de latón según EN 12420 (CW1617N), fabricadas conforme a ABNT NBR 14788 y EN 13828, con presiones de servicio PN25, PN30 o PN40, extremos roscados según ABNT NBR-8133 e ISO 228, asientos de bola de acero cromado con recubrimiento de PTFE y acabado niquelado. Las aplicaciones declaradas son agua, aire comprimido, aceite y servicio hidráulico en industria, construcción civil y saneamiento. Tupy también publica herramientas de ingeniería (TupyCAD con flujo de cotización integrado y catálogos electrónicos) dirigidas a ingenieros de especificación. La línea de fondo: Tupy es un proveedor regional de infraestructura, más fuerte cuando el proyecto es brasileño, la norma es ABNT y la presencia local importa.</p>

			<h2 id="wanlian-overview" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Wanlian Fluid: Quiénes Somos</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Quanzhou Wanlian Fluid Equipment Co., Ltd es un fabricante y exportador chino con base en Quanzhou, Fujian — el clúster central de la industria de válvulas de China. La producción se desarrolla en sus propias líneas bajo un sistema de gestión de calidad ISO 9001, con artículos seleccionados fabricados por socios de fabricación cualificados, declarado abiertamente por pedido. Cada unidad se somete a prueba de presión del cuerpo y a prueba de fugas de aire antes del envío, con registros por unidad.</p>
			<p class="text-gray-700 leading-relaxed">La gama publicada abarca seis líneas y 45 modelos: hidrantes contra incendios y conexiones de bombeo (el <a href="/es/products/overground-fire-hydrant-ss100/" class="text-brand-blue font-semibold hover:underline">hidrante exterior anticongelante SS100/65</a>, anticolisión SSFT100, inteligente IoT SS100ZN, subterráneo SA, cabezales interiores SN65, siamese SQD100); válvulas de rociadores y de alarma (ZSFZ húmedo, ZSFC seco, ZSFM diluvio, ZSFY preacción, cabezales, indicadores de flujo); válvulas de protección contra incendios e industriales (compuerta de asiento elástico, compuerta telescópica, OS&amp;Y, mariposa, de retención, filtros, equilibrado digital); válvulas de control hidráulico (500X, 100X, F745X, HS41X, prevencionador de vórtice de succión EN 12845); monitores contra incendios (PS manual, ZDMS auto-seguimiento); y accesorios contra incendios (manguera contra incendios con revestimiento de caucho, acoples Storz e HS, carretes de manguera, extintores y armarios). OEM/ODM, respuesta de cotización en 12 horas y el sitio completo en cinco idiomas (EN/ES/RU/FR/AR) lo complementan.</p>

			<h2 id="product-lines-compared" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. ¿Cómo Se Compara Su Gama de Productos?</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Línea de alcance</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Tupy</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Wanlian Fluid</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">Tubería y accesorios de hierro dúctil</td><td class="px-4 py-3 text-gray-700">Negocio central (barra de hierro fundido continuo, tubería, accesorios)</td><td class="px-4 py-3 text-gray-700">No se ofrece</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Válvulas de latón (PN25-40)</td><td class="px-4 py-3 text-gray-700">TupyValves, EN 12420, ABNT NBR 14788 / EN 13828</td><td class="px-4 py-3 text-gray-700">Gama pequeña de latón (p. ej. Z15W-16T latón forjado ANSI)</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Válvulas de hierro: compuerta / mariposa / retención</td><td class="px-4 py-3 text-gray-700">Gama de servicio de agua para distribución</td><td class="px-4 py-3 text-gray-700">Gama completa incl. asiento elástico Z41X, telescópica Z41X-T, OS&amp;Y, D71X, HQ44X — DN50-DN700</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Hidrantes contra incendios</td><td class="px-4 py-3 text-gray-700">No es una línea central publicada</td><td class="px-4 py-3 text-gray-700">Línea central: barril seco/húmedo, anticolisión, IoT inteligente, cabezales interiores, siamese</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Válvulas de rociadores y de alarma</td><td class="px-4 py-3 text-gray-700">No está en la gama publicada</td><td class="px-4 py-3 text-gray-700">Línea central: grupos ZSFZ/ZSFC/ZSFM/ZSFY, cabezales, indicadores de flujo</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Manguera, acoples, extintores</td><td class="px-4 py-3 text-gray-700">No está en la gama publicada</td><td class="px-4 py-3 text-gray-700">Línea central: manguera con revestimiento de caucho, acoples Storz/HS, carretes, armarios, extintores ABC</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Control hidráulico (PRV, nivel, reflujo)</td><td class="px-4 py-3 text-gray-700">No es una línea destacada</td><td class="px-4 py-3 text-gray-700">Línea central: 500X, 100X, F745X, HS41X, prevencionador EN 12845</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Geografía típica</td><td class="px-4 py-3 text-gray-700">Brasil y LatAm (huella regional)</td><td class="px-4 py-3 text-gray-700">Exportación mundial (Asia, LatAm, MEA, Europa, Américas)</td></tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Lea la tabla y la forma de la competición aparece: una celda compartida (válvulas de agua de hierro/latón) y todo lo demás separado por el alcance.</p>

			<h2 id="valves-deep-dive" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Válvulas de Hierro Dúctil y Latón: La Superposición Real</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Esta es la única línea donde un comprador puede poner genuinamente ambas cotizaciones lado a lado. Las válvulas de latón de Tupy van de PN25 a PN40 según EN 12420 con extremos roscados — dimensionadas para servicio de edificación y distribución en el entorno de normas brasileñas. La gama de válvulas de hierro de Wanlian es más amplia en tamaño (la <a href="/es/products/resilient-seat-flanged-gate-valve-z41x/" class="text-brand-blue font-semibold hover:underline">Z41X</a> llega a DN700 en PN10/PN16 con una cuña totalmente encapsulada en EPDM y re-sellable en línea) y cubre también el lado de incendio y el hidráulico: válvulas de control OS&amp;Y para redes de rociadores, válvulas de retención, reducción de presión y control de nivel.</p>
			<p class="text-gray-700 leading-relaxed">Las variables decisivas para la celda compartida: <strong>la norma aplicable en la licitación</strong> (ABNT vs AWWA vs EN — declárela por modelo), <strong>la clase de presión necesaria</strong> (el latón PN25-40 de Tupy cubre servicio de edificación a mayor presión; la gama de hierro de Wanlian es PN10-PN16 estándar, con clases superiores disponibles por modelo) y <strong>la economía de entrega</strong> (una fábrica regional con stock local frente a una cotización de exportación — flete e Incoterm incluidos). Para una comparación en condiciones iguales, envíe a ambos el mismo modelo, norma, cantidad e Incoterm, y compare solo cotizaciones desglosadas.</p>

			<h2 id="geography-and-service" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Geografía, Normas y Cobertura de Servicio</h2>
			<p class="text-gray-700 leading-relaxed mb-4">La ventaja de Tupy es física: plantas en Brasil, una base de suministro construida alrededor del mercado regional y una cadena de herramientas de ingeniería/cotización orientada a la práctica local de especificación. Para una empresa de aguas en São Paulo o Joinville, Tupy está a minutos, no a meses, para repuestos y soporte. La huella de Wanlian Fluid es de exportación: producción en Quanzhou, cotizaciones en 12 horas, registros de ensayo por unidad con cada envío, marca OEM/ODM y documentación en cinco idiomas. Las dos huellas responden a preguntas distintas — "quién está al lado" frente a "quién puede enviar el alcance completo" — y ninguna es un defecto.</p>
			<p class="text-gray-700 leading-relaxed">En normas: Tupy publica cumplimiento ABNT NBR 14788 / EN 13828 para su gama de latón; Wanlian fabrica según GB, AWWA, ISO 5208, EN y regímenes regionales según se especifique por modelo — la <a href="/es/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">guía de normas</a> es la referencia para cómo verificar cada afirmación contra un informe de ensayo antes de mover dinero, y la <a href="/es/guides/latinamerica-certification-requirements-fire-valves/" class="text-brand-blue font-semibold hover:underline">guía de certificación LatAm</a> mapea el panorama NOM/ABNT/UL específicamente para equipo contra incendios.</p>

			<h2 id="where-each-wins" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Dónde Gana Cada Fabricante</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-5">
				<div class="bg-gray-50 border border-gray-100 rounded-xl p-6">
					<p class="font-black text-gray-900 text-sm mb-3 uppercase tracking-wider">Tupy gana cuando…</p>
					<ul class="list-disc pl-5 text-sm text-gray-700 space-y-2">
						<li>El alcance es tubería, accesorios y válvulas de servicio de agua de hierro dúctil para una empresa de aguas brasileña</li>
						<li>Válvulas de latón según ABNT en PN25-40 con stock regional y servicio local</li>
						<li>La proximidad, la respuesta dentro de Brasil y las condiciones comerciales locales importan más que el precio unitario</li>
						<li>El proyecto necesita la herramienta TupyCAD/catálogo en el flujo de especificación</li>
					</ul>
				</div>
				<div class="bg-gray-50 border border-gray-100 rounded-xl p-6">
					<p class="font-black text-gray-900 text-sm mb-3 uppercase tracking-wider">Wanlian Fluid gana cuando…</p>
					<ul class="list-disc pl-5 text-sm text-gray-700 space-y-2">
						<li>El alcance incluye el lado de incendio: hidrantes, válvulas de alarma, mangueras, acoples, extintores</li>
						<li>Una sola PO debe cubrir válvulas + hidrantes + mangueras con patrones de salida coincidentes</li>
						<li>El destino está fuera de Brasil, o la licitación se basa en AWWA/EN/GB</li>
						<li>La marca OEM/ODM, hidrantes IoT o válvulas de control hidráulico figuran en el BOQ</li>
					</ul>
				</div>
			</div>

			<h2 id="which-should-you-choose" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">7. ¿Cuál Debería Elegir?</h2>
			<p class="text-gray-700 leading-relaxed mb-4">La versión corta: <strong>Tupy para la celda de infraestructura de agua brasileña; Wanlian Fluid para la celda de incendio y para los alcances de exportación que la cruzan.</strong> Una empresa de aguas que reconstruye una red de distribución en el sur de Brasil está mejor atendida por la casa regional de hierro dúctil. Un contratista que ejecuta un alcance de protección contra incendios — o un paquete municipal combinado de agua e incendio en cualquier país de LatAm — está mejor atendido por el especialista en incendio que puede enviar hidrantes, válvulas y mangueras con un único conjunto conciliado de registros de ensayo. Y cuando un solo proyecto necesita ambos, el movimiento profesional no es forzar a un solo proveedor a un alcance que no publica — es definir la interfaz (bridas, patrones de acople, normas, documentación de ensayo) por escrito antes de colocar cualquiera de las dos PO.</p>
			<p class="text-gray-700 leading-relaxed">Sea lo que elija, verifique antes de comprometerse: alcance ISO 9001, certificados por modelo, registros de ensayo por lote, una unidad de muestra e inspección de terceros. La secuencia completa está en la <a href="/es/guides/how-to-verify-chinese-valve-supplier/" class="text-brand-blue font-semibold hover:underline">guía de verificación de proveedor</a>.</p>

			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Preguntas Frecuentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<h2 id="sources" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Fuentes</h2>
			<ul class="list-disc pl-6 text-sm text-gray-600 space-y-2 mb-4">
				<li>Historia corporativa de Tupy y páginas de producto — tupy.com.br (fundación 1938, Joinville/SC; TupyValves: EN 12420, ABNT NBR 14788 / EN 13828, PN25/30/40, aplicaciones)</li>
				<li>Datos de producto de Wanlian Fluid, página de empresa y página de certificados — wanlian911.com (gama, práctica de ensayo, redacción de certificación por modelo)</li>
				<li>Referencias de normas: AWWA C502/C515, EN 14384, EN 1074/12266-1, ABNT NBR 14788, ISO 5208 según aplique por destino</li>
			</ul>
