---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'what-ul-listing-means', label: '1. Qué Significa el Listado UL para Válvulas Contra Incendios' },
	{ id: 'fire-valve-types', label: '2. Tipos de Válvulas Contra Incendios que Realmente Especificará' },
	{ id: 'key-specifications', label: '3. Especificaciones Clave para Comparar' },
	{ id: 'ul-vs-fm', label: '4. UL vs FM: ¿Cuál Menciona su Licitación?' },
	{ id: 'common-mistakes', label: '5. Errores Comunes en la Compra de Válvulas Contra Incendios' },
	{ id: 'procurement-checklist', label: '6. Lista de Verificación de Compra Antes de Hacer el Pedido' },
	{ id: 'faq', label: 'Preguntas Frecuentes' }
];

const faq = [
	{
		question: '¿Es obligatoria la certificación UL para las válvulas contra incendios?',
		answer: 'En Norteamérica y en muchos proyectos internacionales, sí: las válvulas de protección contra incendios deben estar listadas UL o ULC (o aprobadas FM) para cumplir con NFPA y los códigos de construcción locales. Para otros mercados pueden aplicar CE, LPCB o normas locales. Confirme siempre la certificación que exige su mercado de destino.'
	},
	{
		question: '¿Cuál es la diferencia entre listado UL y aprobación FM?',
		answer: 'Ambas son certificaciones de terceros para productos de protección contra incendios. El listado UL prueba las válvulas contra las normas UL/ULC de construcción y rendimiento; la aprobación FM añade requisitos de inspección de fábrica y de prevención de pérdidas. Muchos proyectos aceptan cualquiera de las dos, pero algunas especificaciones nombran una en concreto — revise sus documentos de licitación.'
	},
	{
		question: '¿Qué tipos de válvulas contra incendios suelen estar listados UL?',
		answer: 'Las válvulas de compuerta (OS&Y y NRS), las válvulas de mariposa, las de retención, las de diluvio, las de preacción y las de retención con alarma son los tipos listados UL más comunes que se utilizan en sistemas de rociadores y de columna seca, en tamaños aproximados de 1½" a 12".'
	},
	{
		question: '¿Cómo verifico que el certificado UL de un proveedor es genuino?',
		answer: 'Solicite el número de certificado y el número de expediente y luego consúltelos en la base de datos oficial UL Product iQ o en el directorio en línea del organismo certificador. Una copia en un folleto no es una prueba — el listado debe estar activo y cubrir el modelo y el tamaño exactos que usted piensa comprar.'
	},
	{
		question: '¿Puede Wanlian suministrar válvulas listadas UL para mi proyecto?',
		answer: 'Sí. Wanlian Fluid suministra válvulas de compuerta, de mariposa, de retención, de diluvio y de preacción con certificación UL/ULC y FM cuando corresponde. Consulte nuestra página de válvulas UL contra incendios o la página de certificados y nuestros ingenieros confirmarán el paquete de certificación correcto para su mercado de destino.'
	}
];

const valveProducts = [
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Válvula de Compuerta de Asiento Elástico (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'Cuña encapsulada en EPDM, DN50–DN700'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Válvula de Mariposa Tipo Wafer Ranurada con Señal',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp',
		desc: 'DN80 PN16 con monitoreo de estado'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Grupo de Válvula de Diluvio con Alarma (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Operada por diafragma, DN50–DN300'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Sistema de Alarma de Preacción (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Diseño de doble disparo a prueba de fallos'
	}
];
---

<Layout
	title="Cómo Elegir Válvulas Contra Incendios Listadas UL (Guía 2026)"
	description="Selección de válvulas contra incendios listadas UL: tipos, certificación UL vs FM, especificaciones clave, verificación de certificados y lista de compra B2B."
	type="article"
	locale="es"
	faq={faq}
	breadcrumbs={[{ name: 'Guías', href: '/es/blog/' }, { name: 'Guía de Válvulas UL' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Pan de migas -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/es/" class="hover:text-blue-600">Inicio</a>
			<span>/</span>
			<a href="/es/blog/" class="hover:text-blue-600">Guías</a>
			<span>/</span>
			<span class="text-gray-600">Guía de Válvulas UL</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Guía de Selección de Válvulas de Protección Contra Incendios</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Cómo Elegir Válvulas Contra Incendios Listadas UL para su Proyecto (Guía 2026)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Una válvula de protección contra incendios es el componente que decide si su sistema de rociadores funcionará el día en que ocurra un incendio — y si su edificio pasa la inspección antes de eso. El listado UL es el criterio de aceptación que la mayoría de los proyectos norteamericanos y muchos internacionales utilizan para evaluarla. Esta guía explica qué significa realmente el listado UL, qué tipos de válvula están listados, cómo verificar que un certificado es genuino y qué revisar antes de emitir una orden de compra.</p>

			<!-- Franja de productos -->
			<div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
				{valveProducts.map(p => (
					<a href={`/es/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			
			<TableOfContents headings={toc} />

			<h2 id="what-ul-listing-means" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Qué Significa el Listado UL para Válvulas Contra Incendios</h2>
			<p class="text-gray-700 leading-relaxed mb-4">El listado UL (Underwriters Laboratories) es una certificación de terceros que acredita que una válvula ha sido probada contra las normas UL/ULC que cubren la clase de presión, las características de flujo, los materiales y la durabilidad en servicio de protección contra incendios. No es una insignia de marketing — es la base documentada sobre la cual las autoridades con jurisdicción (AHJ) aceptan una válvula en un sistema de rociadores o de columna seca.</p>
			<p class="text-gray-700 leading-relaxed">Cuando una ficha técnica dice «listado UL», verifique tres cosas: que el certificado esté <strong>activo</strong> (no vencido), que cubra el <strong>modelo y el tamaño exactos</strong> que usted compra y que el <strong>número de certificado</strong> aparezca en la base de datos oficial de UL. Un logotipo impreso en una ficha técnica no prueba nada por sí solo.</p>

			<h2 id="fire-valve-types" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Tipos de Válvulas Contra Incendios que Realmente Especificará</h2>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Válvulas de Compuerta — El Estándar de Aislamiento del Sistema</h3>
			<p class="text-gray-700 leading-relaxed mb-4">Las válvulas de compuerta aíslan secciones de un sistema de rociadores para mantenimiento. La <a href="/es/products/resilient-seat-flanged-gate-valve-z41x/" class="text-brand-blue font-semibold hover:underline">válvula de compuerta de asiento elástico Z41X</a>, con su cuña totalmente encapsulada en EPDM, es la opción de trabajo: cierre hermético, baja pérdida de carga cuando está totalmente abierta y tamaños de DN50 a DN700 que cubren todo, desde líneas secundarias hasta tuberías principales. Los modelos OS&amp;Y (husillo exterior y yugo) muestran el estado abierto/cerrado de un vistazo, lo cual les agrada a los AHJ para las válvulas de sección.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Válvulas de Mariposa — Control Compacto con Monitoreo</h3>
			<p class="text-gray-700 leading-relaxed mb-4">Donde el espacio es limitado, las válvulas de mariposa ocupan una fracción de la longitud cara a cara de una válvula de compuerta. La <a href="/es/products/signal-grooved-wafer-butterfly-valve-dn80/" class="text-brand-blue font-semibold hover:underline">válvula de mariposa tipo wafer ranurada con señal</a> incorpora un microinterruptor integrado, de modo que el panel de alarma contra incendios conoce el estado abierto/cerrado de la válvula — un requisito para las válvulas de sección monitoreadas en los sistemas modernos.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Válvulas de Diluvio y de Preacción — El Cerebro del Sistema</h3>
			<p class="text-gray-700 leading-relaxed mb-4">Para los sistemas de diluvio (rociadores abiertos o boquillas de aspersión), la <a href="/es/products/deluge-alarm-valve-zsfm/" class="text-brand-blue font-semibold hover:underline">válvula de diluvio con alarma ZSFM</a> retiene el agua del sistema bajo presión de diafragma y se abre al instante cuando se libera eléctrica, neumática o manualmente. Donde debe evitarse el daño por agua — archivos, centros de datos, museos — el <a href="/es/products/pre-action-alarm-system-zsfy/" class="text-brand-blue font-semibold hover:underline">sistema de preacción ZSFY</a> requiere dos señales independientes antes de inundar la tubería.</p>

			<h2 id="key-specifications" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Especificaciones Clave para Comparar</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Especificación</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Por qué importa</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Rango de tamaños</td>
							<td class="px-4 py-3 text-gray-700">Coincida con el programa de tuberías — las válvulas contra incendios típicas van de DN40–DN300 (1½"–12")</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Clase de presión</td>
							<td class="px-4 py-3 text-gray-700">PN16 (1.6 MPa) cubre la mayoría de las redes; PN25 para edificios altos o zonas de alta presión</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Conexiones de extremo</td>
							<td class="px-4 py-3 text-gray-700">Con brida para tuberías principales, ranuradas para instalación rápida, roscadas para ramales pequeños</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Material del cuerpo</td>
							<td class="px-4 py-3 text-gray-700">Hierro dúctil QT450 estándar; WCB/CF8/CF8M donde se necesite mayor resistencia a la corrosión</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Certificación</td>
							<td class="px-4 py-3 text-gray-700">UL/ULC, FM, CE, LPCB — según el código del mercado de destino</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 id="ul-vs-fm" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. UL vs FM: ¿Cuál Menciona su Licitación?</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Ambos son esquemas de certificación aceptados para equipos de protección contra incendios, pero las licitaciones suelen redactarse para nombrar a uno. El listado UL es común en la construcción comercial de EE. UU.; la aprobación FM se exige con frecuencia para instalaciones aseguradas por FM Global y para sitios de riesgo industrial. Algunos proyectos aceptan cualquiera de los dos. Si su especificación dice «listado UL o aprobado FM», un proveedor con ambas certificaciones puede ofertar sobre cualquiera de las dos bases — confirme la cobertura para el modelo y el tamaño específicos antes de cotizar.</p>

			<h2 id="common-mistakes" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Errores Comunes en la Compra de Válvulas Contra Incendios</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Comprar «compatible con UL» en lugar de listado UL</strong> — «compatible» no es una certificación. Solo cuenta un producto listado con un número de certificado activo.</li>
				<li><strong>Ignorar el monitoreo de estado de la válvula</strong> — las válvulas de sección que pueden cerrarse sin que el panel lo sepa son un clásico de falla en inspección; use válvulas con señal u OS&amp;Y en las secciones monitoreadas.</li>
				<li><strong>Clase de presión mal emparejada</strong> — una válvula PN10 en una red PN16 reprueba la prueba hidrostática.</li>
				<li><strong>Especificar el tipo de válvula equivocado</strong> — una válvula de compuerta no puede hacer el trabajo de una de diluvio, y viceversa. Haga coincidir la válvula con la función del sistema.</li>
				<li><strong>No verificar la disponibilidad de repuestos</strong> — los sellos, los vástagos y los kits de reparación deben confirmarse con el pedido.</li>
			</ul>

			<h2 id="procurement-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Lista de Verificación de Compra Antes de Hacer el Pedido</h2>
			<ol class="list-decimal pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Confirme la certificación que exige su mercado de destino (UL/ULC, FM, CE, LPCB).</li>
				<li>Solicite el número de certificado y verifíquelo en la base de datos oficial de UL/FM.</li>
				<li>Haga coincidir el DN, el PN y las conexiones de extremo con su programa de tuberías.</li>
				<li>Para sistemas monitoreados, especifique válvulas con señal o modelos OS&amp;Y.</li>
				<li>Solicite el informe de prueba hidrostática del lote, no solo un certificado genérico.</li>
				<li>Confirme el MOQ, el plazo de entrega y la disponibilidad de repuestos en una sola oferta comercial.</li>
			</ol>

			<!-- Enlace cruzado a la página de aterrizaje -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Explore Nuestra Gama de Válvulas Contra Incendios Listadas UL</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Vea la serie completa — válvulas de compuerta, de mariposa, de retención, de diluvio y de preacción con las certificaciones publicadas en nuestra <a href="/es/certificates/" class="text-brand-blue font-semibold hover:underline">página de certificados</a> — en la <a href="/es/ul-fire-valves/" class="text-brand-blue font-semibold hover:underline">página de válvulas UL contra incendios</a>.</p>
			</div>

			<!-- Guía relacionada -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Guía Relacionada: Verificación de su Proveedor</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">¿Necesita la lista de verificación de diligencia de 8 puntos para verificar a cualquier fabricante de válvulas antes de hacer el pedido? Lea la <a href="/es/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">Lista de Verificación para el Abastecimiento B2B de Válvulas</a>.</p>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">UL es solo una pieza del rompecabezas del cumplimiento — lea <a href="/es/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">Normas de Hidrantes, Mangueras y Válvulas Contra Incendios Explicadas</a> y luego verifique a cualquier fábrica con <a href="/es/guides/how-to-verify-chinese-valve-supplier/" class="text-brand-blue font-semibold hover:underline">Cómo Verificar un Proveedor Chino de Válvulas y Equipos Contra Incendios</a>.</p>
			</div>

			<!-- FAQ -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Preguntas Frecuentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">¿Necesita Válvulas Contra Incendios Listadas UL para su Proyecto?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envíenos su tipo de válvula, DN/PN y la certificación objetivo — nuestros ingenieros responden con la ficha técnica completa y una cotización en un plazo de 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/es/contact/?product=V%C3%A1lvulas%20UL%20Contra%20Incendios" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotización</a>
						<a href="https://wa.me/8618684324501?text=Hola%2C%20necesito%20v%C3%A1lvulas%20contra%20incendios%20listadas%20UL" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chatear por WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
