							<td class="px-4 py-3 text-gray-700">Planteado bajo AWWA C502 / EN 14384 por modelo</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Hidrante anti-colisión / regulador de presión</td>
							<td class="px-4 py-3 text-gray-700">Corredores de alto tráfico, protección vehicular</td>
							<td class="px-4 py-3 text-gray-700"><a href="/es/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100/" class="text-brand-blue font-semibold hover:underline">Hidrante Exterior Anticollision con Regulación de Presión (SSFT100/65)</a></td>
