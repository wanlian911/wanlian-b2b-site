---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'how-they-work', label: '1. Cómo Funcionan: Una Comparación Rápida' },
	{ id: 'head-to-head-gate-vs-butterfly', label: '2. Cara a Cara: Compuerta vs Mariposa' },
	{ id: 'where-each-valve-belongs', label: '3. Dónde Va Cada Válvula en los Sistemas de Protección Contra Incendios' },
	{ id: 'signal-valves-dn80', label: '4. Válvulas de Señales: Las Especialistas DN80' },
	{ id: 'purchasing-considerations', label: '5. Consideraciones de Compra para Compradores B2B' },
	{ id: 'recommendation-summary', label: '6. Resumen de Recomendaciones' },
	{ id: 'faq', label: 'Preguntas Frecuentes' }
];

const faq = [
	{
		question: '¿Debo usar una válvula de compuerta o una válvula de mariposa en la tubería principal contra incendios?',
		answer: 'Para las tuberías principales contra incendios que requieren flujo total sin obstrucciones y una pérdida de carga mínima, la válvula de compuerta de asiento elástico (como la Z41X) es la opción convencional para el servicio de aislamiento. Las válvulas de mariposa (como la D71X) se prefieren donde el espacio es reducido, donde se necesita operación de cuarto de vuelta o donde el peso importa — por ejemplo, en colectores de válvulas y ramales de rociadores. Muchos proyectos usan ambas: válvulas de compuerta para el aislamiento principal y válvulas de mariposa para el control de ramales.'
	},
	{
		question: '¿Cuál es más económica, una válvula de compuerta o una válvula de mariposa?',
		answer: 'Con el mismo diámetro nominal y la misma clase de presión, las válvulas de mariposa tipo wafer suelen ser entre 20 y 40 % más económicas que las válvulas de compuerta con brida, porque son más livianas, usan menos material y tienen un cuerpo más simple. Sin embargo, el costo total instalado también depende de las bridas, los actuadores y el espacio. Para diámetros grandes (DN200 y superiores), la ventaja de costo de la válvula de mariposa aumenta de forma significativa.'
	},
	{
		question: '¿Cuál es el propósito de una válvula de mariposa de señales en un sistema de rociadores contra incendios?',
		answer: 'Una válvula de señales (como la válvula de mariposa tipo wafer ranurada DN80) incorpora un interruptor de manipulación/límite que envía una señal eléctrica al panel de alarma contra incendios cada vez que la válvula se cierra o queda parcialmente cerrada. Esto garantiza que el sistema de rociadores nunca quede aislado de forma no intencional — un requisito de seguridad obligatorio en instalaciones estilo NFPA-13.'
	},
	{
		question: '¿Cuál es la diferencia de clase de presión entre las válvulas Z41X y D71X?',
		answer: 'La válvula de compuerta de asiento elástico Z41X de hierro dúctil y la válvula de mariposa tipo wafer D71X se suministran comúnmente en PN16 (1.6 MPa), con variantes PN10 disponibles. Para el servicio de protección contra incendios, la PN16 cubre los sistemas municipales e industriales estándar. Confirme siempre la presión estática máxima de su red y especifique PN25 si es necesario.'
	}
];

const valveProducts = [
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Válvula de Compuerta con Brida, Asiento Elástico, Hierro Dúctil (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'Válvula de aislamiento de paso total con sellado hermético para tuberías principales contra incendios'
	},
	{
		slug: 'wafer-type-butterfly-valve-d71x',
		name: 'Válvula de Mariposa Tipo Wafer con Revestimiento de Caucho, Hierro Dúctil (D71X)',
		img: '/assets/products/wafer-type-butterfly-valve-d71x.webp',
		desc: 'Válvula compacta de cuarto de vuelta para espacios reducidos y ramales'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Válvula de Mariposa de Señales Tipo Wafer Ranurada (DN80-PN16)',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp',
		desc: 'Válvula de señales ranurada con interruptor de manipulación para sistemas de rociadores'
	}
];
---

<Layout
	title="Válvula de compuerta vs mariposa en sistemas contra incendios"
	description="¿Compuerta o mariposa en sistemas contra incendios? Flujo, pérdida de carga y costo: Z41X, D71X y válvula de señales DN80 para compradores B2B."
	type="article"
	locale="es"
	faq={faq}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/es/" class="hover:text-blue-600">Inicio</a>
			<span>/</span>
			<span class="text-gray-600">Guías</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Guía de Válvulas Industriales</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">¿Válvula de Compuerta o Válvula de Mariposa para Sistemas de Protección Contra Incendios?</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Es una de las preguntas más frecuentes en la compra de equipos de protección contra incendios: ¿válvula de compuerta o válvula de mariposa? La respuesta honesta es que no son intercambiables — son complementarias. Cada una tiene una zona donde es claramente la opción correcta, y la mayoría de los sistemas contra incendios bien diseñados usan ambas. Esta guía le ofrece un marco de decisión basado en el flujo, el espacio, la velocidad de operación y el costo, con referencia a las configuraciones reales de válvulas que se utilizan en las tuberías principales contra incendios y en los sistemas de rociadores.</p>

			<!-- Product strip -->
			<div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
				{valveProducts.map(p => (
					<a href={`/es/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-32 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			
			<TableOfContents headings={toc} />

			<h2 id="how-they-work" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Cómo Funcionan: Una Comparación Rápida</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Una <strong>válvula de compuerta</strong> usa una cuña que se desliza perpendicular a la dirección del flujo. Totalmente abierta, la cuña queda completamente fuera de la vía de agua, dejando una abertura de paso total en línea recta — por eso las válvulas de compuerta tienen una pérdida de carga casi nula. Una <strong>válvula de mariposa</strong> usa un disco giratorio montado en un eje central. El disco permanece dentro de la vía de agua incluso cuando la válvula está abierta, lo que genera una pérdida de carga pequeña pero medible; sin embargo, la válvula opera con un simple cuarto de vuelta.</p>
			<p class="text-gray-700 leading-relaxed">Esta única diferencia mecánica explica casi todas las diferencias prácticas entre ambas.</p>

			<h2 id="head-to-head-gate-vs-butterfly" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Cara a Cara: Compuerta vs Mariposa</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Criterio</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Válvula de Compuerta (Z41X)</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Válvula de Mariposa (D71X)</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Características de flujo</td>
							<td class="px-4 py-3 text-gray-700">Paso total, pérdida de carga casi nula</td>
							<td class="px-4 py-3 text-gray-700">Disco en la vía de flujo, pequeña pérdida de carga</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Velocidad de operación</td>
							<td class="px-4 py-3 text-gray-700">De varias vueltas (más lenta, sobre todo en tamaños grandes)</td>
							<td class="px-4 py-3 text-gray-700">De cuarto de vuelta (rápida y fácil de accionar)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Espacio y peso</td>
							<td class="px-4 py-3 text-gray-700">Cara a cara largo, pesada en DN grandes</td>
							<td class="px-4 py-3 text-gray-700">Cuerpo wafer compacto, hasta 70 % más liviana</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Costo (mismo DN/PN)</td>
							<td class="px-4 py-3 text-gray-700">Mayor costo de material y mecanizado</td>
							<td class="px-4 py-3 text-gray-700">Generalmente 20–40 % menor</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Sellado</td>
							<td class="px-4 py-3 text-gray-700">Hermético con asiento elástico</td>
							<td class="px-4 py-3 text-gray-700">Revestida de caucho, estanca a la presión nominal</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Servicio ideal</td>
							<td class="px-4 py-3 text-gray-700">Aislamiento principal, abrir/cerrar a flujo total</td>
							<td class="px-4 py-3 text-gray-700">Control de ramales, regulación, espacios reducidos</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 id="where-each-valve-belongs" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Dónde Va Cada Válvula en los Sistemas de Protección Contra Incendios</h2>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Válvulas de compuerta para el aislamiento principal</h3>
			<p class="text-gray-700 leading-relaxed mb-4">En las tuberías principales contra incendios y en las líneas de descarga de bombas, la prioridad es entregar el máximo caudal con la mínima pérdida por fricción. La <a href="/es/products/resilient-seat-flanged-gate-valve-z41x/" class="text-brand-blue font-semibold hover:underline">válvula de compuerta de asiento elástico Z41X de hierro dúctil</a> es la válvula de aislamiento estándar en este punto: paso total, cierre hermético y una vía de agua plana y sin obstrucciones cuando está abierta. Como estas válvulas operan rara vez (solo abrir/cerrar), la operación más lenta de varias vueltas no es un inconveniente práctico.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Válvulas de mariposa para ramales y espacios reducidos</h3>
			<p class="text-gray-700 leading-relaxed mb-4">Donde las válvulas se concentran en salas de montantes de rociadores, cuartos de equipos o colectores de válvulas, el espacio es dinero. La <a href="/es/products/wafer-type-butterfly-valve-d71x/" class="text-brand-blue font-semibold hover:underline">válvula de mariposa tipo wafer D71X</a> se instala entre dos bridas con una fracción de la longitud cara a cara y del peso de una válvula de compuerta, y su palanca de cuarto de vuelta o reductor de tornillo sinfín hace sencilla la operación y el montaje de actuadores. Por eso es la opción predeterminada para el control de ramales de rociadores y el aislamiento por secciones.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Para un desglose completo de las válvulas de los sistemas de rociadores — alarma tipo húmedo, diluvio y preacción — consulte nuestra <a href="/es/guides/fire-sprinkler-system-valves-guide/" class="text-brand-blue font-semibold hover:underline">guía de válvulas de sistemas de rociadores</a>.</p>

			<h2 id="signal-valves-dn80" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Válvulas de Señales: Las Especialistas DN80</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Los sistemas de rociadores regidos por códigos estilo NFPA-13 exigen una válvula de aislamiento supervisada: si alguien cierra la válvula de suministro, el panel de alarma contra incendios debe saberlo de inmediato. La <a href="/es/products/signal-grooved-wafer-butterfly-valve-dn80/" class="text-brand-blue font-semibold hover:underline">válvula de mariposa de señales tipo wafer ranurada DN80</a> integra un interruptor de manipulación/límite con una conexión ranurada, de modo que se acopla a la tubería con acoples, reporta su estado abierta/cerrada al panel y conserva los beneficios de espacio y costo del diseño de mariposa. Es la válvula que se especifica cuando el plano indica "válvula OS&amp;Y o de mariposa supervisada".</p>
			<p class="text-gray-700 leading-relaxed mb-4">¿Sigue decidiendo entre sistemas húmedos, secos o de preacción? Nuestra <a href="/es/guides/fire-sprinkler-system-wet-dry-preaction/" class="text-brand-blue font-semibold hover:underline">comparación de sistemas de rociadores húmedos, secos y de preacción</a> explica qué sistema corresponde a cada perfil de riesgo del edificio.</p>

			<h2 id="purchasing-considerations" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Consideraciones de Compra para Compradores B2B</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Especifique el material del cuerpo y el recubrimiento</strong> — el hierro dúctil QT450 con recubrimiento epoxi resiste la corrosión en los sistemas contra incendios húmedos; solicite la especificación del recubrimiento en la cotización.</li>
				<li><strong>Ajuste la clase de presión a su red</strong> — la PN16 es el estándar; confirme la presión estática antes de ordenar y especifique PN25 para las zonas de edificios de gran altura.</li>
				<li><strong>El estilo de conexión importa</strong> — con brida para las válvulas de compuerta, tipo wafer o ranurado para las de mariposa; confírmelo con su cronograma de tuberías (los acoples ranurados ahorran tiempo de instalación).</li>
				<li><strong>Las válvulas de señales deben especificar el interruptor</strong> — solicite el tipo de interruptor de límite y su grado IP para la interfaz con su panel de alarma.</li>
				<li><strong>Solicite informes de prueba</strong> — certificados de prueba hidrostática y de fugas del asiento del lote real, no una plantilla genérica.</li>
				<li><strong>Consolide su pedido</strong> — ordenar válvulas de compuerta, de mariposa y de señales a un mismo fabricante certificado simplifica la documentación de certificación y la gestión de repuestos. Ejecute nuestra <a href="/es/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">lista de verificación de abastecimiento de válvulas B2B</a> antes de comprometerse con un proveedor.</li>
			</ul>

			<h2 id="recommendation-summary" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Resumen de Recomendaciones</h2>
			<div class="bg-gray-50 rounded-xl border border-gray-200 p-6 my-5">
				<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2">
					<li><strong>Tuberías principales contra incendios / descarga de bomba → válvula de compuerta (Z41X)</strong>: flujo total, pérdida mínima y aislamiento confiable.</li>
					<li><strong>Ramales / salas de montantes / colectores → válvula de mariposa (D71X)</strong>: compacta, liviana y de operación rápida.</li>
					<li><strong>Aislamiento supervisado en sistemas de rociadores → válvula de señales (DN80)</strong>: interruptor de manipulación integrado y conexión ranurada para una instalación rápida.</li>
					<li>Ante la duda, confirme con el diseñador de su sistema — la mayoría de los proyectos necesita los tres tipos.</li>
				</ul>
			</div>

			<!-- FAQ Section -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Preguntas Frecuentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">¿Está Armando un Paquete de Válvulas para un Sistema Contra Incendios?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Indíquenos su cronograma de tuberías y su clase de presión — cotizamos las válvulas de compuerta, de mariposa y de señales como un paquete certificado en un plazo de 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/es/contact/?product=Selecci%C3%B3n%20de%20V%C3%A1lvulas" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotización</a>
						<a href="https://wa.me/8618684324501?text=Hola%2C%20necesito%20ayuda%20para%20seleccionar%20v%C3%A1lvulas%20para%20un%20sistema%20contra%20incendios" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chatear por WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
