---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'do-you-need-a-water-cannon', label: '1. ¿Realmente Necesita un Cañón Monitor?' },
	{ id: 'fixed-remote-or-auto-tracking', label: '2. ¿Fijo, Remoto o de Seguimiento Automático?' },
	{ id: 'sizing-flow-and-range', label: '3. Dimensionamiento: Caudal y Alcance' },
	{ id: 'control-and-integration', label: '4. Control e Integración' },
	{ id: 'procurement-checklist', label: '5. Lista de Verificación de Compra' },
	{ id: 'faq', label: 'Preguntas Frecuentes' }
];

const faq = [
	{
		question: '¿Cuándo necesito un cañón monitor contra incendios en lugar de rociadores estándar?',
		answer: 'Los cañones monitores son adecuados para espacios grandes, abiertos o de techos altos donde la cobertura con rociadores no es práctica: áreas de proceso petroquímico, parques de tanques de petróleo y GNL, terminales de carga, hangares de aeronaves y grandes almacenes. Proporcionan un chorro concentrado de alto caudal a 50–110 metros, controlado de forma manual, remota o automática.'
	},
	{
		question: '¿Qué caudal y alcance necesito?',
		answer: 'El caudal sigue al riesgo: 5–30 L/s es adecuado para la protección de almacenes y atrios, mientras que 30–200 L/s sirve para parques de tanques y unidades de proceso. El alcance depende de la presión de entrada — normalmente de 50 a 110 m al caudal nominal. Envíenos la distribución de su sitio y nuestros ingenieros dimensionarán el modelo.'
	},
	{
		question: 'Cañón de control remoto o de seguimiento automático: ¿cuál debo elegir?',
		answer: 'Si puede haber un operador presente, los modelos de control remoto ofrecen una anulación manual flexible a una distancia segura. Para áreas no tripuladas o con riesgo las 24 horas, los cañones de seguimiento automático con detección IR/UV detectan, apuntan y lanzan el chorro en menos de 30 segundos sin intervención humana.'
	},
	{
		question: '¿Pueden usarse los cañones monitores con espuma?',
		answer: 'Sí. Nuestra serie PS admite agua y espuma como medios, y puede integrarse la dosificación de espuma para riesgos de clase B (combustibles líquidos). El gabinete de espuma PSG30 es una opción empaquetada y completa para riesgos menores de combustible y productos químicos.'
	},
	{
		question: '¿Suministran el cañón con el sistema completo: válvulas, acoples, bombas?',
		answer: 'Sí. Como empresa de equipos de fluidos, suministramos válvulas, acoples, hidrantes y accesorios coordinados para todo el circuito de supresión, de modo que su pedido de cañón monitor puede ser un paquete de fuente única.'
	}
];

const cannonProducts = [
	{
		slug: 'auto-tracking-jet-suppression-cannon-zdms',
		name: 'Cañón de Seguimiento Automático (ZDMS)',
		img: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		desc: 'Detección IR/UV, 5–150 L/s'
	},
	{
		slug: 'manual-fire-water-cannon-ps',
		name: 'Cañón Monitor Manual (PS)',
		img: '/assets/products/manual-fire-water-cannon-ps.webp',
		desc: '20–200 L/s, hasta 110 m'
	},
	{
		slug: 'foam-fire-hydrant-cabinet-psg30',
		name: 'Gabinete de Espuma (PSG30)',
		img: '/assets/06_extinguishing_cannons/cannon_p42.webp',
		desc: 'AFFF al 3% para incendios de combustible y químicos'
	}
];
---

<Layout
	title="Cañón Monitor Contra Incendios: Guía de Compra 2026"
	description="Elegir un cañón monitor contra incendios: fijo, remoto o automático."
	type="article"
	locale="es"
	faq={faq}
	breadcrumbs={[{ name: 'Blog', href: '/es/blog/' }, { name: 'Guía del Cañón Monitor' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Migas de pan -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/es/" class="hover:text-blue-600">Inicio</a>
			<span>/</span>
			<a href="/es/blog/" class="hover:text-blue-600">Blog</a>
			<span>/</span>
			<span class="text-gray-600">Guía del Cañón Monitor</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Guía Industrial de Supresión de Incendios</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Guía de Compra del Cañón Monitor Contra Incendios: ¿Fijo, Remoto o Inteligente? (2026)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Un cañón monitor contra incendios es un monitor de alto caudal que lanza un chorro concentrado a 50–110 metros: la herramienta de supresión preferida para plantas petroquímicas, parques de tanques, terminales y grandes almacenes donde los rociadores no llegan. La decisión de compra se reduce a cuatro preguntas: fijo o controlable, qué caudal, qué alcance y si debe operar por sí solo. Esta guía aborda cada una.</p>

			<!-- Franja de productos -->
			<div class="mt-8 grid grid-cols-2 lg:grid-cols-3 gap-4">
				{cannonProducts.map(p => (
					<a href={`/es/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			
			<TableOfContents headings={toc} />

			<h2 id="do-you-need-a-water-cannon" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. ¿Realmente Necesita un Cañón Monitor?</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Los cañones monitores justifican su costo en tres situaciones: <strong>grandes áreas abiertas</strong> (almacenes, atrios, hangares) donde los rociadores fijos exigirían densidades poco prácticas; <strong>riesgos al aire libre</strong> (parques de tanques, racks de carga, unidades de proceso) donde no hay techo para montar rociadores; y <strong>riesgos de alto valor</strong> donde una supresión rápida y concentrada supera al daño por agua generalizado. Si su sitio es un edificio cerrado de ocupación estándar, un sistema de rociadores es probablemente la respuesta correcta en su lugar — consulte nuestra <a href="/es/fire-sprinkler-systems/" class="text-brand-blue font-semibold hover:underline">página de sistemas de rociadores</a>.</p>

			<h2 id="fixed-remote-or-auto-tracking" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. ¿Fijo, Remoto o de Seguimiento Automático?</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Tipo</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Cómo opera</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Ideal para</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Monitor fijo</td>
							<td class="px-4 py-3 text-gray-700">Apunta con palanca manual; el engranaje autoblocante mantiene la posición</td>
							<td class="px-4 py-3 text-gray-700">Sitios con operadores de turno; opción base rentable</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Control remoto</td>
							<td class="px-4 py-3 text-gray-700">Control por cable o inalámbrico desde una distancia segura, rotación de 360°</td>
							<td class="px-4 py-3 text-gray-700">Riesgos demasiado cercanos para la operación manual</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Seguimiento automático</td>
							<td class="px-4 py-3 text-gray-700">Detección de llama IR/UV, puntería y descarga autónomas en ~30 s</td>
							<td class="px-4 py-3 text-gray-700">Áreas no tripuladas, riesgo 24/7, requisitos de respuesta rápida</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed mb-4">El <a href="/es/products/auto-tracking-jet-suppression-cannon-zdms/" class="text-brand-blue font-semibold hover:underline">cañón de seguimiento automático ZDMS</a> combina sensores infrarrojos y ultravioleta para confirmar una llama real antes de actuar — lo que reduce las activaciones por falsas alarmas — y admite anulación manual desde una PC, una aplicación móvil o un gabinete de control central. La <a href="/es/products/manual-fire-water-cannon-ps/" class="text-brand-blue font-semibold hover:underline">serie manual PS</a> sigue siendo la opción confiable y de bajo costo donde hay operadores presentes.</p>

			<h2 id="sizing-flow-and-range" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Dimensionamiento: Caudal y Alcance</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Dos cifras definen la capacidad de un cañón: el <strong>caudal</strong> (L/s) y el <strong>alcance del chorro</strong> (m). El caudal lo determina el riesgo y el cálculo de la demanda de agua contra incendios; el alcance depende de la presión de entrada y del diseño de la boquilla.</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Almacenes y atrios</strong>: cañones de 5–30 L/s, radio de monitoreo de 40–65 m — el punto óptimo de la ZDMS.</li>
				<li><strong>Parques de tanques y unidades de proceso</strong>: 30–200 L/s con alcances de hasta 110 m — la gama de la serie PS.</li>
				<li><strong>Riesgos con espuma</strong>: especifique la dosificación de espuma o una unidad empaquetada como el <a href="/es/products/foam-fire-hydrant-cabinet-psg30/" class="text-brand-blue font-semibold hover:underline">gabinete de espuma PSG30</a> para riesgos de clase B.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Regla práctica: si no puede dimensionar el caudal con confianza, envíe la distribución del sitio y la demanda de agua contra incendios al proveedor — el modelo correcto se deriva del riesgo, no de una página de catálogo.</p>

			<h2 id="control-and-integration" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Control e Integración</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Los cañones de seguimiento automático solo son tan útiles como su integración: deben conectarse al panel de alarma contra incendios, y la ruta de anulación manual (gabinete local o estación remota) debe probarse con sus operadores. Verifique la interfaz de comunicación, la clasificación a prueba de explosión si el cañón se instala en un área clasificada (disponible Exde II BT4 Gb) y el grado de protección IP para la exposición a la intemperie.</p>

			<h2 id="procurement-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Lista de Verificación de Compra</h2>
			<ol class="list-decimal pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Defina el riesgo y la demanda de agua contra incendios; confirme el caudal y el alcance del cañón con el proveedor.</li>
				<li>Elija el modo de control: fijo, remoto o de seguimiento automático — según la dotación de personal y el tiempo de respuesta.</li>
				<li>Confirme la compatibilidad del medio (solo agua o dosificación de espuma).</li>
				<li>Verifique las clasificaciones a prueba de explosión y de protección IP para el entorno de instalación.</li>
				<li>Solicite el paquete de circuito completo: cañón, válvulas, acoples, hidrantes — una lista de materiales, un solo proveedor.</li>
				<li>Aclare el MOQ, el plazo de entrega, el soporte de instalación y los repuestos en la oferta comercial.</li>
			</ol>

			<!-- Enlace cruzado a la página de destino -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Explore la Gama de Cañones Monitores Contra Incendios</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Compare los modelos fijos, remotos e inteligentes con especificaciones completas en la <a href="/es/fire-water-cannon/" class="text-brand-blue font-semibold hover:underline">página del cañón monitor contra incendios</a>.</p>
			</div>

			<!-- Guía relacionada -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Guía Relacionada: Manual vs. Seguimiento Automático</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">¿Necesita una comparación técnica directa entre los monitores manuales (PS) y los de seguimiento automático (ZDMS)? Consulte la <a href="/es/guides/fire-water-monitor-selection-guide/" class="text-brand-blue font-semibold hover:underline">Guía de Selección de Monitores de Agua Contra Incendios</a>.</p>
			</div>

			<!-- Preguntas frecuentes -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Preguntas Frecuentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- Llamada a la acción -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">¿Necesita un Cañón Monitor para su Sitio?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envíenos la distribución de su sitio, el alcance y el caudal requeridos — nuestros ingenieros recomiendan el modelo adecuado y responden con una cotización completa en un plazo de 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/es/contact/?product=Fire%20Water%20Cannon" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotización</a>
						<a href="https://wa.me/8618684324501?text=Hola%2C%20necesito%20un%20ca%C3%B1%C3%B3n%20monitor%20contra%20incendios" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chatear por WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
