---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: '¿Cuándo es obligatorio por ley un dispositivo anti-retorno?',
		answer: 'Siempre que un sistema no potable se conecta a un suministro de agua potable. Puntos obligatorios típicos: conexiones de rociadores contra incendios y columnas secas, sistemas de riego, líneas de reposición de calderas, torres de enfriamiento y agua de proceso industrial. La mayoría de las jurisdicciones aplican códigos de control de conexiones cruzadas basados en AWWA M14, EN 1717 o los códigos nacionales de plomería — confirme con la autoridad local de agua en qué clase de riesgo cae su conexión.'
	},
	{
		question: '¿Cuál es la diferencia entre una válvula de doble retención y un conjunto de zona de presión reducida (RPZ)?',
		answer: 'Un conjunto de válvulas de doble retención (DCVA) como el HS41X proporciona dos válvulas de retención independientes más una cámara de drenaje intermedia, y es la opción estándar para protección contra incendios y conexiones de riesgo bajo a medio. Un conjunto RPZ añade una válvula de alivio que descarga si la presión de la zona cae, protegiendo contra el retrosifonaje de contaminantes de alto riesgo — se exige para aguas residuales, productos químicos y otras conexiones cruzadas de alto riesgo, y requiere pruebas anuales.'
	},
	{
		question: '¿Un dispositivo anti-retorno causa pérdida de presión en la red contra incendios?',
		answer: 'Sí, todo dispositivo anti-retorno añade pérdida de carga. Un conjunto de doble retención bien diseñado añade típicamente 0.5–1.5 bar al caudal de diseño. La bomba contra incendios y los cálculos hidráulicos deben incluir la pérdida del dispositivo, o los rociadores aguas abajo podrían no alcanzar su presión residual requerida. Proporcione el caudal y le suministraremos la curva de pérdida de carga del HS41X en su tamaño.'
	},
	{
		question: '¿El HS41X puede instalarse horizontal o verticalmente?',
		answer: 'El dispositivo anti-retorno de doble retención HS41X está diseñado para instalación horizontal en la dirección del flujo marcada en el cuerpo, con la cámara de drenaje intermedia orientada hacia abajo. Para montantes verticales, confirme la orientación con nuestros ingenieros — algunos tamaños pueden instalarse verticalmente con flujo ascendente cuando la disposición interna del drenaje lo permite.'
	},
	{
		question: '¿Con qué frecuencia debe probarse un dispositivo anti-retorno?',
		answer: 'Intervalos de prueba típicos: pruebas anuales para conjuntos de doble retención y dispositivos RPZ en sistemas comerciales, y más frecuentes (trimestrales a semestrales) para conexiones de alto riesgo o donde los reglamentos locales lo exijan. Un equipo de prueba verifica que las válvulas de retención mantengan 1.0 bar sin fugas y que la cámara intermedia drene correctamente.'
	}
];

const products = [
	{ slug: 'anti-pollution-backflow-preventer-hs41x', name: 'Dispositivo Anti-Retorno Antipolución (HS41X)', img: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp', desc: 'Conjunto de doble retención con drenaje intermedio automático' },
	{ slug: 'adjustable-pressure-reducing-valve-500x', name: 'Válvula Reductora de Presión Hidráulica (500X)', img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp', desc: 'Control piloto de presión auto-operado, sin energía externa' },
	{ slug: 'hydraulic-water-level-control-valve-f745x', name: 'Válvula de Control de Nivel de Agua (F745X)', img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp', desc: 'Control de nivel por piloto de flotador para depósitos y tanques' },
	{ slug: 'groove-solenoid-control-gate-valve-gkzf1', name: 'Válvula de Compuerta con Control por Solenoide (GKZF-1)', img: '/assets/products/groove-solenoid-control-gate-valve-gkzf1.jpg', desc: 'Válvula ranurada pilotada eléctricamente para redes automatizadas' }
];

const toc = [
	{ id: 'why-backflow', label: '1. Por Qué Importa la Prevención de Reflujo' },
	{ id: 'hazard-classes', label: '2. Clases de Riesgo y Tipos de Dispositivos' },
	{ id: 'double-check', label: '3. Cómo Funciona el Conjunto de Doble Retención HS41X' },
	{ id: 'fire-main', label: '4. Reflujo en Redes de Protección Contra Incendios' },
	{ id: 'sizing', label: '5. Consideraciones de Dimensionamiento y Pérdida de Carga' },
	{ id: 'specs-compare', label: '6. HS41X frente a Válvulas de Control Hidráulico' },
