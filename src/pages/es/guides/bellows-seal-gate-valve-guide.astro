---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

// FAQ: 5 preguntas reales de compra (genera el FAQPage JSON-LD)
const faq = [
	{
		question: '¿Cuál es la diferencia entre una válvula de compuerta de sello de fuelle y una válvula de compuerta estándar?',
		answer: 'Una válvula de compuerta estándar se sella alrededor del vástago únicamente con la empaquetadura del vástago. Una válvula de compuerta de sello de fuelle añade un fuelle metálico soldado entre el vástago y la tapa (bonete), creando una segunda barrera hermética. Si el fuelle llegara a fallar, la empaquetadura sigue conteniendo — por eso se describe como un diseño de doble sellado con cero fugas al exterior.'
	},
	{
		question: '¿Qué medios requieren válvulas de compuerta de sello de fuelle?',
		answer: 'Las válvulas de compuerta de sello de fuelle se especifican típicamente para aceite térmico, vapor y agua de alta temperatura, donde la fuga por el vástago es un problema de seguridad y de eficiencia. También se eligen con frecuencia para medios tóxicos, inflamables o peligrosos donde deben minimizarse las emisiones fugitivas, y para sistemas sujetos a regulación ambiental estricta.'
	},
	{
		question: '¿Qué tamaños y clases de presión están disponibles en las válvulas de compuerta de fuelle de Wanlian?',
		answer: 'Nuestra válvula de compuerta de sello de fuelle con brida y accionamiento manual cubre DN15-DN300 (1/2" a 12") con presiones de trabajo de 1.6-4.0 MPa (Class 150/300) y un rango de temperatura de trabajo de -29 °C a 425 °C. Los cuerpos son de acero forjado (A105) o acero fundido (WCB), y el fuelle es de acero inoxidable 304 o 316Ti.'
	},
	{
		question: '¿Las válvulas de compuerta de sello de fuelle cumplen con las normas internacionales?',
		answer: 'Las válvulas de compuerta de sello de fuelle de Wanlian se fabrican conforme a las normas GB, ANSI, DIN y JIS, con clases de presión expresadas tanto en términos métricos (MPa) como en términos de clase ANSI. Confirme la norma dimensional y de presión exacta que exige su proyecto antes de hacer el pedido.'
	},
	{
		question: '¿Cómo verifico la calidad de una válvula de compuerta de fuelle antes de pedirla?',
		answer: 'Solicite los informes de prueba de presión de carcasa y asiento del lote real, los certificados de material del cuerpo y del fuelle, y confirme en la cotización el material del fuelle (304/316Ti) y la norma de soldadura. Puede concertarse una inspección de terceros antes del envío.'
	}
];

// TOC: corresponde uno a uno con los id de los H2 del contenido
const toc = [
	{ id: 'what-is-bellows-gate-valve', label: '1. ¿Qué Es una Válvula de Compuerta de Sello de Fuelle?' },
	{ id: 'how-bellows-seal-works', label: '2. Cómo Funciona el Doble Sello' },
	{ id: 'where-bellows-valves-are-specified', label: '3. Dónde Se Especifican las Válvulas de Fuelle' },
	{ id: 'standards-and-pressure-classes', label: '4. Normas y Clases de Presión' },
	{ id: 'bellows-vs-standard-gate-valve', label: '5. Válvula de Fuelle vs Válvula de Compuerta Estándar' },
	{ id: 'specification-checklist', label: '6. Lista de Especificación B2B' },
	{ id: 'faq', label: 'Preguntas Frecuentes' }
];

// Productos relacionados (el slug coincide con products.ts)
const products = [
	{ slug: 'flange-manual-bellows-gate-valve', name: 'Válvula de Compuerta de Sello de Fuelle con Brida (Manual)', img: '/assets/products/flange-manual-bellows-gate-valve.webp', desc: 'Acero forjado/fundido, DN15-DN300, Class 150/300' },
	{ slug: 'z85x-stainless-steel-grooved-gate-valve', name: 'Válvula de Compuerta Ranurada de Acero Inoxidable (Z85X)', img: '/assets/products/z85x-stainless-steel-grooved-gate-valve.webp', desc: 'Compuerta fundida 316 (CF8M) para servicios corrosivos' },
	{ slug: 'brass-gate-valve-z15w-16t', name: 'Válvula de Compuerta de Latón Forjado ANSI (Z15W-16T)', img: '/assets/products/brass-gate-valve-z15w-16t.webp', desc: 'Compuerta roscada NPT para líneas de aceite y agua' }
];
---

<Layout
	title="Válvula de compuerta de sello de fuelle: guía ANSI bridada"
	description="Válvula de compuerta de sello de fuelle para vapor y aceite térmico: doble sello, normas ANSI, tamaños DN15-DN300 y lista de especificación B2B."
	type="article"
	locale="es"
	faq={faq}
	breadcrumbs={[{ name: 'Guías', href: '/es/blog/' }, { name: 'Guía de la Válvula de Compuerta de Sello de Fuelle' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/es/" class="hover:text-blue-600">Inicio</a>
			<span>/</span>
			<a href="/es/blog/" class="hover:text-blue-600">Guías</a>
			<span>/</span>
			<span class="text-gray-600">Guía de la Válvula de Compuerta de Sello de Fuelle</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Guía de Válvulas Industriales</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Guía de la Válvula de Compuerta de Sello de Fuelle: Tipos ANSI con Brida para Vapor y Aceite Térmico</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">En resumen: una válvula de compuerta de sello de fuelle es una válvula de compuerta con un fuelle metálico soldado como segunda barrera de sellado detrás de la empaquetadura del vástago, lo que logra cero fugas al exterior por el vástago. Es la válvula que debe especificarse para aceite térmico, vapor y agua de alta temperatura — y para cualquier servicio donde la fuga por el vástago sea inaceptable. Esta guía explica cómo funciona, dónde corresponde usarla y cómo especificarla.</p>

			<TableOfContents headings={toc} />

			<!-- Franja de productos -->
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/es/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Sección 1 -->
			<h2 id="what-is-bellows-gate-valve" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. ¿Qué Es una Válvula de Compuerta de Sello de Fuelle?</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Una válvula de compuerta de sello de fuelle es una válvula de compuerta de vástago ascendente en la que el vástago queda encerrado por un fuelle metálico soldado. El fuelle se expande y se contrae con el recorrido del vástago, sellando el vástago por completo frente al medio — mientras que un prensaestopas convencional situado por encima proporciona una segunda línea de defensa. El resultado es un sistema de doble sellado: incluso si el fuelle se fatiga, la empaquetadura sigue evitando la fuga a la atmósfera.</p>
			<p class="text-gray-700 leading-relaxed">Este diseño es lo que convierte a la válvula de compuerta de fuelle en la respuesta estándar para las <a href="/es/products/flange-manual-bellows-gate-valve/" class="text-brand-blue font-semibold hover:underline">válvulas de compuerta de sello de fuelle con brida y accionamiento manual</a> en servicios térmicos exigentes.</p>

			<!-- Sección 2 -->
			<h2 id="how-bellows-seal-works" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Cómo Funciona el Doble Sello</h2>
			<p class="text-gray-700 leading-relaxed mb-4">En una válvula de compuerta estándar la única barrera entre el medio de proceso y la atmósfera es la empaquetadura del vástago. La empaquetadura es un sello por compresión — funciona, pero puede degradarse, secarse o aflojarse con el tiempo, especialmente bajo ciclos térmicos. Un sello de fuelle elimina el problema en su origen: el fuelle metálico soldado (normalmente acero inoxidable 304 o 316Ti) está fijado al vástago y a la tapa (bonete), de modo que el medio de proceso no puede llegar físicamente a la zona de la empaquetadura.</p>
			<p class="text-gray-700 leading-relaxed mb-4">La empaquetadura situada por encima del fuelle sigue existiendo — sella el interior de la tapa contra el polvo y sirve de respaldo si el fuelle llegara a dañarse. Los equipos de mantenimiento también reciben una advertencia temprana: si el fuelle falla, la válvula empieza a sudar por la empaquetadura en lugar de fallar sin aviso.</p>
			<p class="text-gray-700 leading-relaxed">Como el fuelle es un componente metálico soldado, su material, la calidad de la soldadura y su vida útil en ciclos son los verdaderos diferenciadores de calidad entre proveedores — vale la pena preguntar por ellos en cada cotización.</p>

			<!-- Sección 3 -->
			<h2 id="where-bellows-valves-are-specified" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Dónde Se Especifican las Válvulas de Fuelle</h2>
			<p class="text-gray-700 leading-relaxed mb-4">El servicio clásico de una válvula de compuerta de sello de fuelle es el <strong>aceite térmico y el vapor</strong>. Los sistemas de fluido termoportador operan calientes (hasta 425 °C en nuestra gama estándar) y bajo ciclos térmicos repetidos; un prensaestopas con fugas significa pérdida de calor, planta sucia y un riesgo de seguridad. Los sistemas de agua de alta temperatura presentan el mismo problema en otra forma.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Más allá de los servicios térmicos, las válvulas de fuelle se especifican siempre que <strong>deban controlarse las emisiones fugitivas</strong> — medios tóxicos, inflamables u olorosos, y plantas sujetas a regulación ambiental. El fuelle soldado actúa como una barrera eficaz contra las emisiones fugitivas, particularmente en aplicaciones con alta expansión o contracción térmica.</p>
			<p class="text-gray-700 leading-relaxed">En resumen: si la línea transporta algo caliente, peligroso, o ambas cosas, pregunte si una válvula de compuerta de sello de fuelle debe reemplazar a la válvula de compuerta estándar de solo empaquetadura en la especificación.</p>

			<!-- Sección 4 -->
			<h2 id="standards-and-pressure-classes" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Normas y Clases de Presión</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Las válvulas de compuerta de sello de fuelle se fabrican bajo los mismos marcos dimensionales y de diseño que las demás válvulas de compuerta de acero. Las válvulas de compuerta de sello de fuelle de Wanlian se fabrican conforme a las normas GB, ANSI, DIN y JIS, y las clases de presión se expresan tanto en términos métricos (1.6-4.0 MPa) como en términos de clase ANSI (Class 150/300).</p>
			<p class="text-gray-700 leading-relaxed mb-4">Para válvulas de compuerta de acero con brida en proyectos internacionales, las familias de referencia pertinentes son los marcos ASME/ANSI — la ASME B16.34 rige las clasificaciones de presión-temperatura de las válvulas con brida, y la serie API 600/603 cubre el diseño de las válvulas de compuerta de acero y de aleaciones resistentes a la corrosión. Cuando un proyecto exige específicamente un desempeño frente a emisiones fugitivas, las válvulas suelen especificarse contra ensayos de fuga como ISO 15848 o TA-Luft.</p>
			<p class="text-gray-700 leading-relaxed">Confirme siempre qué norma invoca su proyecto (GB, ANSI o DIN) antes de comparar cotizaciones — las dimensiones cara a cara y la perforación de las bridas pueden diferir.</p>

			<!-- Sección 5 -->
			<h2 id="bellows-vs-standard-gate-valve" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Válvula de Fuelle vs Válvula de Compuerta Estándar</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Comparación</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Válvula de Compuerta Estándar</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Válvula de Compuerta de Sello de Fuelle</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Sellado del vástago</td>
							<td class="px-4 py-3 text-gray-700">Solo empaquetadura</td>
							<td class="px-4 py-3 text-gray-700">Fuelle metálico soldado + empaquetadura</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Emisiones fugitivas</td>
							<td class="px-4 py-3 text-gray-700">Depende del estado de la empaquetadura</td>
							<td class="px-4 py-3 text-gray-700">Cero gracias al fuelle; empaquetadura de respaldo</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Resistencia a los ciclos térmicos</td>
							<td class="px-4 py-3 text-gray-700">La empaquetadura puede aflojarse con los ciclos</td>
							<td class="px-4 py-3 text-gray-700">El fuelle absorbe el movimiento del vástago</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Servicio típico</td>
							<td class="px-4 py-3 text-gray-700">Agua, aire, fluidos generales</td>
							<td class="px-4 py-3 text-gray-700">Vapor, aceite térmico, medios peligrosos</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Costo inicial</td>
							<td class="px-4 py-3 text-gray-700">Menor</td>
							<td class="px-4 py-3 text-gray-700">Mayor — justificado por un servicio sin fugas</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Para los servicios generales de agua y aire, una válvula de compuerta estándar sigue siendo la opción económica — consulte nuestra <a href="/es/guides/gate-valve-vs-butterfly-valve-fire-protection/" class="text-brand-blue font-semibold hover:underline">guía de válvula de compuerta vs válvula de mariposa</a> para ver cómo encajan las compuertas en las tuberías de incendios y de agua, y el <a href="/es/tags/industrial-valves/" class="text-brand-blue font-semibold hover:underline">centro de válvulas industriales</a> para la gama completa de productos.</p>

			<!-- Sección 6 -->
			<h2 id="specification-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Lista de Especificación B2B</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Defina el medio y la temperatura</strong> — aceite térmico, vapor o agua de alta temperatura: indique la temperatura máxima de trabajo para que puedan confirmarse el material del fuelle y la clase del cuerpo.</li>
				<li><strong>Fije la clase de presión y la norma</strong> — Class 150/300 (PN16-PN40) con perforación de brida GB, ANSI o DIN; indique qué norma invoca el proyecto.</li>
				<li><strong>Especifique el material del cuerpo y del fuelle</strong> — cuerpos de acero forjado A105 o acero fundido WCB con fuelle de acero inoxidable 304/316Ti son el punto de partida estándar.</li>
				<li><strong>Pregunte por la construcción del fuelle</strong> — fuelle soldado, proceso de soldadura y cualquier ensayo de vida útil en ciclos realizado por el fabricante.</li>
				<li><strong>Exija los informes de prueba por lote</strong> — certificados de prueba de presión de carcasa y asiento del lote real, más certificados de material a solicitud.</li>
				<li><strong>Verifique primero al proveedor</strong> — la calidad del fuelle es invisible en las fotos. Ejecute nuestra <a href="/es/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">lista de verificación de abastecimiento de válvulas B2B</a> antes de comprometerse con un fabricante.</li>
			</ul>

			<!-- Sección FAQ -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Preguntas Frecuentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- Doble CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">¿Necesita Válvulas de Compuerta de Sello de Fuelle para una Línea de Vapor o Aceite Térmico?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Indíquenos su medio, temperatura, DN y norma de brida — nuestros ingenieros confirman la especificación del fuelle y le cotizan en un plazo de 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/es/contact/?product=V%C3%A1lvula%20de%20Compuerta%20de%20Sello%20de%20Fuelle" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotización</a>
						<a href="https://wa.me/8618684324501?text=Hola%2C%20necesito%20v%C3%A1lvulas%20de%20compuerta%20de%20sello%20de%20fuelle%20para%20vapor%2Faceite%20t%C3%A9rmico" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chatear por WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
