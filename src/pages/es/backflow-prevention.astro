---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: '¿Cuál es la diferencia entre un dispositivo anti-retorno y una válvula de retención?',
		answer: 'Una válvula de retención estándar impide el flujo inverso de forma mecánica, pero no se prueba contra fugas y no tiene drenaje intermedio. Un dispositivo anti-retorno como el HS41X combina dos retenciones independientes con una cámara de drenaje intermedia automática, es comprobable en sitio y cumple los requisitos de control de conexiones cruzadas para la protección del agua potable. Las válvulas de retención por sí solas no se aceptan en conexiones cruzadas de agua potable.'
	},
	{
		question: '¿Dónde debe instalarse el dispositivo anti-retorno en una conexión de servicio contra incendios?',
		answer: 'En la conexión del servicio contra incendios con la red principal de agua potable, aguas arriba de la succión de la bomba contra incendios o del montante del sistema. Debe ser accesible para pruebas, estar protegido contra el congelamiento e incluir su pérdida de carga en el cálculo hidráulico de la bomba contra incendios. En sistemas de edificios de gran altura, confirme que la clasificación del dispositivo coincida con la presión estática máxima del suministro.'
	},
	{
		question: '¿Las válvulas de control hidráulico necesitan electricidad para operar?',
		answer: 'La mayoría de las válvulas de control hidráulico —la 500X reductora de presión, la F745X de control de nivel y el HS41X anti-retorno— operan totalmente por sí solas con la presión de la tubería y no requieren energía externa. Los modelos con control por solenoide, como la GKZF-1, usan AC220V o DC24V para la automatización remota.'
	},
	{
		question: '¿Qué materiales se usan en aplicaciones de agua potable?',
		answer: 'Para redes de agua potable, el dispositivo anti-retorno HS41X usa cuerpo de hierro dúctil con sellos EPDM e internos de acero inoxidable 304, conforme a los requisitos sanitarios de la norma GB/T17219. Confirme el certificado sanitario para su mercado — nuestros ingenieros entregan el paquete de documentación con el pedido.'
	},
	{
		question: '¿Pueden suministrar el paquete completo de válvulas hidráulicas para una sala de bombas?',
		answer: 'Sí. Suministramos dispositivos anti-retorno, válvulas reductoras de presión, de control de nivel, con control por solenoide, preventores de vórtice y coladores en Y como un paquete coordinado — clases de presión, guarniciones e informes de prueba emparejados de un único proveedor.'
	}
];

const hydraulicProducts = [
	{
		slug: 'anti-pollution-backflow-preventer-hs41x',
		name: 'Anti-Pollution Backflow Preventer (HS41X-16)',
		img: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		desc: 'Conjunto de doble retención con drenaje intermedio, DN50–DN600'
	},
	{
		slug: 'adjustable-pressure-reducing-valve-500x',
		name: 'Hydraulic Pressure Reducing Valve (500X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'Control piloto auto-operado, ajuste de 0.1–1.6 MPa'
	},
	{
		slug: 'hydraulic-water-level-control-valve-f745x',
		name: 'Hydraulic Water Level Control Valve (F745X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'Control de nivel por piloto de flotador para depósitos y tanques'
	},
	{
		slug: 'groove-solenoid-control-gate-valve-gkzf1',
		name: 'Solenoid Control Gate Valve (GKZF-1)',
		img: '/assets/products/groove-solenoid-control-gate-valve-gkzf1.jpg',
		desc: 'Válvula ranurada pilotada DC24V/AC220V, clase 300 PSI'
	},
	{
		slug: 'suction-vortex-preventer-en12845',
		name: 'Suction Vortex Preventer (EN12845)',
		img: '/assets/02_valves_parts/valves_p21.webp',
		desc: 'SS304/316, elimina la cavitación de la bomba, drenaje de 100 mm'
	}
];

const trustBadges = ['Doble Retención + Drenaje', 'PN10–PN25', 'Sanitario GB/T17219', 'Pilotos Auto-Operados'];
---

<Layout
	title="Dispositivos Anti-Retorno y Válvulas de Control Hidráulico"
	description="Dispositivos anti-retorno y válvulas de control hidráulico (HS41X, 500X, F745X, GKZF-1) para redes de agua potable y contra incendios. DN50–DN600 de fábrica."
	type="product"
	locale="es"
	productData={{
		name: 'Prevención de Reflujo y Control Hidráulico',
		image: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		description: 'Dispositivos anti-retorno y válvulas de control hidráulico para la protección del agua potable, la gestión de presión y las redes de agua automatizadas, fabricados por Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Dispositivos Anti-Retorno' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/es/" class="hover:text-blue-600">Inicio</a>
			<span>/</span>
			<a href="/es/products/" class="hover:text-blue-600">Productos</a>
			<span>/</span>
			<span class="text-gray-600">Dispositivos Anti-Retorno</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Protección del Agua Potable &amp; Control Hidráulico</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Dispositivos Anti-Retorno y Válvulas de Control Hidráulico</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid suministra toda la gama de seguridad hidráulica — dispositivos anti-retorno antipolución HS41X, válvulas reductoras de presión 500X, válvulas de control de nivel F745X y válvulas de control por solenoide GKZF-1 — protegiendo las redes de agua potable y automatizando el control de presión y nivel en un paquete coordinado.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Gama de Válvulas de Seguridad Hidráulica</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydraulicProducts.map(p => (
					<a href={`/es/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Especificaciones Clave</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Válvula</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Función</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Rango de tamaño</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Clasificación</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">HS41X</td>
							<td class="px-4 py-3 text-gray-700">Prevención de retorno antipolución</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">500X</td>
							<td class="px-4 py-3 text-gray-700">Reducción y sostenimiento de presión</td>
							<td class="px-4 py-3 text-gray-700">DN20 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">F745X</td>
							<td class="px-4 py-3 text-gray-700">Control de nivel de agua</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN400</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">GKZF-1</td>
							<td class="px-4 py-3 text-gray-700">Control de apertura/cierre por solenoide</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN300</td>
							<td class="px-4 py-3 text-gray-700">300 PSI, AC220V/DC24V</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Preventor de Vórtice</td>
							<td class="px-4 py-3 text-gray-700">Protección de succión de bomba</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN1000</td>
							<td class="px-4 py-3 text-gray-700">EN12845 / GB50974</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Aplicaciones</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Control de conexiones cruzadas en agua potable (redes contra incendios, riego, calderas)</li>
				<li>Control de nivel de depósitos de agua y tanques elevados</li>
				<li>Gestión de zonas de presión en redes municipales y de edificios</li>
				<li>Redes de agua automatizadas con control remoto de válvulas</li>
				<li>Protección de succión de bombas en depósitos y tanques</li>
			</ul>

			<!-- FAQ Section -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Preguntas Frecuentes</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">¿Necesita un Paquete de Válvulas Hidráulicas para su Red?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Envíenos su DN, clase de presión y tipo de conexión — nuestros ingenieros responden con curvas de pérdida de carga, fichas técnicas y una cotización del paquete en un plazo de 12 horas.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/es/contact/?product=Backflow%20Prevention%20%26%20Hydraulic%20Control" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Solicitar Cotización</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20help%20selecting%20hydraulic%20control%20valves" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chatear por WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
