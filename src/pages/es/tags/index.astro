---
import Layout from '../../../layouts/Layout.astro';
import { tags } from '../../../utils/tags';
import { tagsEs } from '../../../utils/tags.es';

const tagStats = tags.map(tag => ({
  ...tag,
  es: tagsEs[tag.slug] ?? tag,
  guideCount: tag.guideHrefs.length,
  productCount: tag.productSlugs.length
}));
---

<Layout
  title="Centro de Conocimiento: Temas de Protección Contra Incendios y Válvulas"
  description="Temas de protección contra incendios y válvulas industriales: hidrantes, rociadores, cañones de agua, prevención de reflujo, certificación y guías de compras B2B de Wanlian Fluid."
  locale="es"
  breadcrumbs={[{ name: 'Temas' }]}
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4">
      <span class="text-xs font-bold tracking-widest text-brand-red uppercase">Centro de Conocimiento</span>
      <h1 class="text-4xl font-black text-gray-900 tracking-tight">Explorar por Tema</h1>
      <p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
        Guías técnicas y productos agrupados por tema — desde hidrantes y sistemas de rociadores hasta prevención de reflujo y compras B2B.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {tagStats.map(tag => (
        <a
          href={`/es/tags/${tag.slug}/`}
          class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-8 flex flex-col"
        >
          <div class="flex items-center justify-between mb-4">
            <span class="px-2.5 py-1 bg-brand-blue/10 text-brand-blue text-[11px] font-black rounded-full uppercase tracking-wider">Tema</span>
            <span class="text-xs text-gray-400">
              {tag.guideCount} {tag.guideCount !== 1 ? 'guías' : 'guía'} · {tag.productCount} {tag.productCount !== 1 ? 'productos' : 'producto'}
            </span>
          </div>
          <h2 class="text-xl font-black text-gray-900 group-hover:text-brand-blue transition leading-snug mb-3">
            {tag.es.name}
          </h2>
          <p class="text-sm text-gray-500 leading-relaxed flex-grow">{tag.es.description}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {tag.relatedTags.slice(0, 3).map(rel => (
              <a href={`/es/tags/${rel}/`} class="text-[10px] font-bold text-gray-400 uppercase tracking-wider hover:text-brand-blue transition">#{rel.replace(/-/g, ' ')}</a>
            ))}
          </div>
          <span class="mt-4 inline-flex items-center text-brand-red font-bold text-sm group-hover:gap-2 transition-all">
            Explorar Tema
            <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4">
      <h2 class="text-2xl font-black">¿Busca una Familia de Productos Específica?</h2>
      <p class="text-gray-400 max-w-xl mx-auto">
        Explore el catálogo completo o pida a nuestros ingenieros que seleccionen la válvula adecuada para su proyecto.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href="/es/products/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-xl hover:opacity-90 transition">Catálogo Completo</a>
        <a href="/es/contact/" class="inline-block px-8 py-4 bg-white/10 border border-white/20 text-white font-bold rounded-xl hover:bg-white/20 transition">Consultar a un Ingeniero</a>
      </div>
    </div>
  </main>
</Layout>
