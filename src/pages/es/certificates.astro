---
import Layout from '../../layouts/Layout.astro';

const certifications = [
  {
    name: 'Listado UL',
    code: 'UL 262 / UL 1091',
    desc: 'Norma para válvulas de compuerta y válvulas de retención para servicio de protección contra incendios.',
    scope: 'Válvulas de compuerta y válvulas de retención para servicio de protección contra incendios suministradas al mercado norteamericano (UL 262 / UL 1091).',
    products: 'Válvulas de compuerta de asiento elástico, válvulas de retención',
    verify: 'El alcance del certificado aplica a los modelos específicos listados en el certificado UL. Contáctenos para confirmar la cobertura de modelos y solicitar una copia.',
    icon: '🏆'
  },
  {
    name: 'Aprobación FM',
    code: 'Class 1120/1130',
    desc: 'Norma de aprobación para válvulas de control de servicio contra incendios (tipo OS&Y y NRS).',
    scope: 'Válvulas de control de servicio contra incendios (tipo OS&Y y NRS) aprobadas conforme a FM Class 1120/1130.',
    products: 'Válvulas de compuerta OS&Y, válvulas de control de servicio contra incendios',
    verify: 'La aprobación cubre los modelos listados en el certificado de aprobación FM. Se proporcionan copias bajo petición para la documentación de su proyecto.',
    icon: '🛡️'
  },
  {
    name: 'Marcado CE',
    code: 'EN 12266-1',
    desc: 'Cumplimiento de las normas europeas de salud, seguridad y protección del medio ambiente.',
    scope: 'Equipos a presión probados y marcados de acuerdo con las directivas de la UE aplicables y la norma de prueba EN 12266-1.',
    products: 'Válvulas suministradas a proyectos de la UE (según el alcance de la directiva aplicable)',
    verify: 'El marcado CE aplica dentro del alcance de las directivas pertinentes. Confirme la directiva y la categoría aplicables para su proyecto.',
    icon: '🇪🇺'
  },
  {
    name: 'Certificación ISO 9001:2015',
    code: 'Gestión de Calidad',
    desc: 'Norma internacional para sistemas de gestión de calidad en la fabricación.',
    scope: 'Diseño, producción y venta de válvulas, equipos contra incendios y productos de control de fluidos bajo un sistema de gestión de calidad certificado ISO 9001:2015.',
    products: 'Todas las líneas de producción',
    verify: 'Certificado de sistema emitido por el organismo de certificación acreditado; válido según el período del certificado. Copia disponible bajo petición.',
    icon: '⚙️'
  },
  {
    name: 'Certificado LPCB',
    code: 'Prevención de Pérdidas',
    desc: 'Listado RedBook para productos y servicios de protección contra incendios.',
    scope: 'Productos de protección contra incendios listados bajo el esquema RedBook de LPCB para los mercados del Reino Unido y la Commonwealth.',
    products: 'Productos de protección contra incendios listados (según la entrada de RedBook)',
    verify: 'El listado RedBook cubre los productos y las normas específicos que se muestran en la entrada del listado. Verifique el número de entrada para su producto objetivo.',
    icon: '📜'
  },
  {
    name: 'Norma GB',
    code: 'GB 5135 / GB 4452',
    desc: 'Cumplimiento de las normas nacionales chinas para equipos de protección contra incendios.',
    scope: 'Fabricados y probados de acuerdo con las normas nacionales chinas pertinentes (serie GB 5135, GB 4452, GB 50974).',
    products: 'Componentes de sistemas de rociadores, hidrantes contra incendios, válvulas de alarma',
    verify: 'Cumplimiento según la norma GB específica aplicable a cada modelo de producto. Informes de prueba disponibles bajo petición.',
    icon: '🇨🇳'
  }
];
---

<Layout 
  locale="es"
  title="Certificados de Producto y Documentación Técnica | Wanlian Fluid"
  description="Certificados UL, FM, CE, LPCB e ISO 9001 de válvulas y equipos contra incendios Wanlian Fluid, con fichas técnicas e informes de prueba bajo petición."
>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
         Documentación de <span class="text-brand-red">Producto.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
         Comparta los requisitos de su proyecto y le proporcionaremos la información disponible del producto, las especificaciones técnicas y la documentación para su revisión.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p>
            <div class="space-y-3 text-sm text-gray-600">
              <p><span class="font-bold text-gray-900">Alcance: </span>{cert.scope}</p>
              <p><span class="font-bold text-gray-900">Productos cubiertos: </span>{cert.products}</p>
              <p class="text-xs text-gray-500 leading-relaxed border-t border-gray-200 pt-3">{cert.verify}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-6">
        <h2 class="text-3xl font-black">¿Necesita Copias de Certificados o Fichas Técnicas?</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          Proporcionamos copias de certificados, informes de prueba hidrostática, fichas técnicas, planos CAD y manuales de instalación para nuestra gama de productos bajo petición. Especifique la certificación, el modelo de producto y su mercado objetivo para que podamos confirmar el alcance aplicable.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a href="/es/contact/?product=Certificate%20%26%20Technical%20Documentation%20Request" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
            Solicitar Certificados y Documentos
          </a>
          <a href="/es/products/" class="inline-block px-10 py-5 bg-white/10 border border-gray-600 text-white font-black rounded-xl hover:bg-white/20 transition">
            Ver Productos Certificados
          </a>
        </div>
        <p class="text-xs text-gray-500 pt-2">
          La certificación aplica a los productos, modelos y alcance específicos indicados en cada certificado. Nuestros ingenieros confirmarán la cobertura de modelos antes de que realice su pedido.
        </p>
      </div>
    </div>
  </section>
</Layout>
