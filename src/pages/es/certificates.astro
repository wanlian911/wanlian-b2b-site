---
import Layout from '../../layouts/Layout.astro';

const certifications = [
  {
    name: 'ISO 9001:2015',
    code: 'EN NOMBRE PROPIO',
    desc: 'Sistema de gestión de calidad de Quanzhou Wanlian Fluid Equipment Co., Ltd.',
    scope: 'Diseño, producción y venta de válvulas, equipos contra incendios y productos de control de fluidos bajo un sistema de gestión de calidad certificado ISO 9001:2015.',
    products: 'Todo lo que vendemos: líneas de producción propias y artículos adquiridos a fábricas asociadas',
    verify: 'El número de certificado y el organismo emisor se proporcionan para verificación. Se incluye una copia con la documentación de su pedido.',
    icon: '⚙️'
  },
  {
    name: 'Registros de ensayos por lote',
    code: 'EN NOMBRE PROPIO',
    desc: 'Ensayos documentados del 100 % de presión de carcasa y estanqueidad del asiento, lote por lote.',
    scope: 'Cada unidad se somete a ensayos de presión de carcasa y de estanqueidad al aire antes del embalaje, según GB/T 13927 o EN 12266-1 conforme a su especificación, y los registros se concilian con los números de serie de su lista de empaque.',
    products: 'Todas las válvulas y equipos de protección contra incendios que enviamos',
    verify: 'Los registros de ensayos viajan con los documentos de exportación. Podemos organizar ensayos presenciados por terceros (SGS, BV, Intertek) antes del envío.',
    icon: '🧪'
  },
  {
    name: 'EN 12266-1 / serie GB 5135',
    code: 'BASE DE DISEÑO Y ENSAYOS',
    desc: 'Base de fabricación y ensayos cuando ningún listado de terceros aplica a su especificación.',
    scope: 'Las válvulas se fabrican y ensayan según EN 12266-1 o GB/T 13927 conforme a su especificación; los componentes de rociadores, hidrantes contra incendios y válvulas de alarma siguen la serie GB 5135, GB 4452 y GB 50974, y el diseño del sistema toma como referencia EN 12845. El marcado CE, cuando aplica, es declarado por la fábrica que ostenta dicha declaración.',
    products: 'Componentes de sistemas de rociadores, hidrantes contra incendios, válvulas de alarma y válvulas de servicio general',
    verify: 'Esto es una declaración de base de fabricación y ensayos, no una certificación, y así lo indicamos. Los informes de ensayos de fábrica se proporcionan con el envío.',
    icon: '🧱'
  },
  {
    name: 'UL 262 / UL 1091',
    code: 'EN PODER DE LA FÁBRICA PRODUCTORA',
    desc: 'Normas para válvulas de compuerta y válvulas de retención utilizadas en servicios de protección contra incendios en Norteamérica.',
    scope: 'El listado UL se concede a la fábrica que fabrica el modelo listado. Wanlian no posee listados UL y no los presenta en nombre propio.',
    products: 'Los modelos listados pueden adquirirse a la fábrica titular del certificado cuando su especificación los exija.',
    verify: 'Cuando su licitación exige UL, confirmamos por escrito antes de la producción: la razón social del titular del certificado, el modelo y tamaño listados y una copia del certificado; después usted lo verifica en UL Product iQ.',
    icon: '🏆'
  },
  {
    name: 'FM Class 1120 / 1130',
    code: 'EN PODER DE LA FÁBRICA PRODUCTORA',
    desc: 'Norma de aprobación para válvulas de control de servicio contra incendios de tipo OS&Y y NRS.',
    scope: 'Las aprobaciones FM se conceden por fabricante y línea de productos. Suministramos modelos aprobados de la instalación aprobada; no presentamos una aprobación FM como credencial de Wanlian.',
    products: 'Válvulas de compuerta OS&Y y válvulas de control de servicio contra incendios, en configuraciones listadas bajo petición',
    verify: 'Indicamos el titular de la aprobación y el modelo aprobado, proporcionamos una copia del certificado y usted confirma la entrada en la FM Approval Guide.',
    icon: '🛡️'
  },
  {
    name: 'LPCB RedBook',
    code: 'EN PODER DE LA FÁBRICA PRODUCTORA',
    desc: 'Listado de certificación de prevención de pérdidas para productos y servicios de protección contra incendios.',
    scope: 'Las entradas de RedBook se publican para el fabricante certificado. Es pertinente para proyectos del Reino Unido y la Commonwealth que exigen equipos listados por LPCB.',
    products: 'Productos de protección contra incendios listados, según la entrada de RedBook de la fábrica suministradora',
    verify: 'Identificamos la entrada de RedBook y el fabricante certificado de su producto objetivo antes de que se comprometa; la entrada puede consultarse gratuitamente en redbooklive.com.',
    icon: '📜'
  }
];

const faq = [
  {
    question: '¿Tiene Wanlian Fluid la certificación ISO 9001?',
    answer: 'Sí — la producción se rige por un sistema de gestión de calidad ISO 9001:2015 que cubre el diseño, la producción y la venta de válvulas, equipos contra incendios y productos de control de fluidos. El número de certificado y el organismo emisor se proporcionan para verificación.'
  },
  {
    question: '¿Sus válvulas contra incendios están listadas UL o FM?',
    answer: 'No — esos listados pertenecen a las fábricas que los ostentan, no a Wanlian. Si su licitación menciona UL 262, UL 1091, FM Class 1120 o FM Class 1130, obtenemos el modelo listado de la fábrica titular del certificado y lo confirmamos por escrito antes de la producción: la razón social del titular, el modelo y tamaño listados y una copia del certificado. Si no podemos suministrar una unidad realmente listada, se lo comunicamos en la fase de cotización, antes de comprometer su pedido.'
  },
  {
    question: '¿Qué cubre el marcado CE de sus válvulas?',
    answer: 'El marcado CE es declarado por la fábrica que ostenta la declaración de la UE aplicable, dentro del alcance de las directivas pertinentes, y los ensayos de válvulas siguen EN 12266-1. Indíquenos su proyecto y destino y identificaremos esa fábrica, la directiva, la categoría y la documentación del modelo exacto antes del pedido.'
  },
  {
    question: '¿Cómo puedo verificar que sus certificados son auténticos?',
    answer: 'Le proporcionamos la razón social del titular del certificado y una copia para el modelo exacto, para que pueda comprobarlos en UL Product iQ, la FM Approval Guide, LPCB RedBook o el portal del organismo emisor. Un proveedor que no identifica al titular del certificado es una señal de alerta; esta prueba también se aplica a nosotros.'
  },
  {
    question: '¿Proporcionan informes de prueba con el envío?',
    answer: 'Sí — los registros de prueba de presión del cuerpo y de estanqueidad al aire por unidad, conciliados con los números de serie de la lista de empaque, viajan con los documentos de exportación (factura, lista de empaque, certificado de origen), además de certificados de materiales y certificados específicos de norma bajo petición.'
  }
];
---

<Layout 
  locale="es"
  title="Cumplimiento, ensayos y certificación | Wanlian Fluid"
  description="Qué mantiene Wanlian en nombre propio, qué pertenece a la fábrica productora y según qué base fabricamos y ensayamos, con verificación caso a caso."
  faq={faq}
  breadcrumbs={[{ name: 'Certificados' }]}
>
  <section class="py-24 bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-blue/10 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-5xl sm:text-6xl font-black tracking-tight mb-8">
         Documentación de <span class="text-brand-red">Producto.</span>
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl leading-relaxed">
         Comparta los requisitos de su proyecto y le proporcionaremos la información disponible del producto, las especificaciones técnicas y la documentación para su revisión.
      </p>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {certifications.map(cert => (
          <div class="p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-brand-blue/30 transition-all group">
            <div class="text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 inline-block">{cert.icon}</div>
            <h3 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h3>
            <p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p>
            <p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p>
            <div class="space-y-3 text-sm text-gray-600">
              <p><span class="font-bold text-gray-900">Alcance: </span>{cert.scope}</p>
              <p><span class="font-bold text-gray-900">Productos cubiertos: </span>{cert.products}</p>
              <p class="text-xs text-gray-500 leading-relaxed border-t border-gray-200 pt-3">{cert.verify}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center space-y-6">
        <h2 class="text-3xl font-black">¿Necesita Copias de Certificados o Fichas Técnicas?</h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          Proporcionamos copias de certificados, informes de prueba hidrostática, fichas técnicas, planos CAD y manuales de instalación para nuestra gama de productos bajo petición. Especifique la certificación, el modelo de producto y su mercado objetivo para que podamos confirmar el alcance aplicable.
        </p>
        <div class="flex flex-wrap justify-center gap-4 pt-2">
          <a href="/es/contact/?product=Certificate%20%26%20Technical%20Documentation%20Request" class="inline-block px-10 py-5 bg-brand-red text-white font-black rounded-xl hover:opacity-90 transition">
            Solicitar Certificados y Documentos
          </a>
          <a href="/es/products/" class="inline-block px-10 py-5 bg-white/10 border border-gray-600 text-white font-black rounded-xl hover:bg-white/20 transition">
            Ver Productos Certificados
          </a>
        </div>
        <p class="text-xs text-gray-500 pt-2">
          La certificación aplica a los productos, modelos y alcance específicos indicados en cada certificado. Nuestros ingenieros confirmarán la cobertura de modelos antes de que realice su pedido.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 bg-gray-50 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="text-sm font-bold tracking-widest text-blue-600 uppercase">FAQ</span>
        <h2 class="text-3xl font-black text-gray-900 tracking-tight">Preguntas Frecuentes</h2>
      </div>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-white rounded-xl border border-gray-100 p-6 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
