---
import Layout from '../../layouts/Layout.astro';
const faq = [
  { question: 'Für welche Branchen sind die Produkte geeignet?', answer: 'Für kommunale Wasser- und Brandschutznetze, industrielle Rohrleitungen, HVAC, petrochemische Anlagen, Lager, Rechenzentren sowie maritime Anwendungen.' },
  { question: 'Können Armaturen und Brandschutzausrüstung als Projektpaket geliefert werden?', answer: 'Ja. Eine Bestellung kann Absperrschieber, Hydranten, Sprinklerarmaturen und feuerbeständige Schläuche mit abgestimmter OEM/ODM-Kennzeichnung und Exportdokumentation kombinieren.' },
  { question: 'Wie wird die passende Armatur ausgewählt?', answer: 'Ausgangspunkt sind Medium, Nennweite, Druckstufe und Anschlussnorm; anschließend werden Funktion, Werkstoff und Betriebsbedingungen bewertet. Unsere Ingenieure unterstützen die Auswahl.' }
];
const applications = [
  { title: 'Brandschutz und Sicherheit', icon: '🚒', description: 'Komplette Brandschutzinfrastruktur für Gebäude, Industrieanlagen und kommunale Netze.', points: ['Über- und Unterflurhydranten', 'Sprinkler-, Nassalarm- und Sprühflutsysteme', 'Löschmonitore für große Hallen', 'Schlauchhaspeln und Hydrantenschränke'], links: [{ label: 'Hydranten & Pumpenanschlüsse', href: '/de/products/#category=Hydranten%20%26%20Pumpenanschl%C3%BCsse' }, { label: 'Sprinkler & Alarmventile', href: '/de/products/#category=Sprinkler%20%26%20Alarmventile' }, { label: 'Löschmonitore', href: '/de/products/#category=L%C3%B6schmonitore%20%26%20L%C3%B6schkanonen' }] },
  { title: 'Kommunale Wasser- und Abwassernetze', icon: '🏙️', description: 'Robuste Absperr- und Regelarmaturen für Verteilnetze, Abwasserleitungen und Pumpstationen.', points: ['Absperrschieber und Absperrklappen', 'Rückschlagventile für Pumpenanlagen', 'Rückflussverhinderer für Trinkwasser', 'Hydranten für kommunale Netze'], links: [{ label: 'Absperrschieber', href: '/de/products/resilient-seat-flanged-gate-valve-z41x/' }, { label: 'Rückschlagventile', href: '/de/products/spherical-ball-check-valve-hq44x/' }, { label: 'Rückflussverhinderer', href: '/de/products/anti-pollution-backflow-preventer-hs41x/' }] },
  { title: 'Industrielle Prozessrohrleitungen', icon: '🏭', description: 'Hochdruckarmaturen und Schmutzfänger für Petrochemie, Energie, Metallurgie und Lebensmittelverarbeitung.', points: ['Faltenbalg-Absperrschieber für hohe Temperaturen', 'Y-Schmutzfänger zum Geräteschutz', 'Druckminderventile für stabilen Betrieb', 'Durchflussmessgeräte für die Prozessüberwachung'], links: [{ label: 'Faltenbalg-Absperrschieber', href: '/de/products/flange-manual-bellows-gate-valve/' }, { label: 'Y-Schmutzfänger', href: '/de/products/telescopic-y-strainer-sgl41h/' }, { label: 'Durchflussmessgeräte', href: '/de/products/smart-electromagnetic-flow-meter/' }] },
  { title: 'HVAC und Gebäudetechnik', icon: '🏢', description: 'Kompakte, wartungsarme Armaturen für Heizung, Lüftung und Klimatisierung in Gewerbe- und Wohngebäuden.', points: ['Wafer-Absperrklappen', 'Weichdichtende Absperrschieber', 'Hydraulische Regelventile', 'Teleskop-Armaturen für Ausgleichsbewegungen'], links: [{ label: 'Absperrklappen', href: '/de/products/wafer-type-butterfly-valve-d71x/' }, { label: 'Hydraulische Regelventile', href: '/de/products/hydraulic-water-level-control-valve-f745x/' }] },
  { title: 'Öl, Gas und Petrochemie', icon: '🛢️', description: 'Leistungsfähige Durchflussregelung und Brandschutz für Raffinerien, Tanklager und Chemieanlagen.', points: ['Manuelle und automatisch schwenkende Löschmonitore', 'Schaumlöschschränke', 'Korrosionsbeständige Werkstoffe', 'Ausrüstung für anspruchsvolle Medien'], links: [{ label: 'Löschmonitore', href: '/de/products/manual-fire-water-cannon-ps/' }, { label: 'Automatische Löschkanonen', href: '/de/products/auto-tracking-jet-suppression-cannon-zdms/' }] },
  { title: 'Logistik, Lager und Rechenzentren', icon: '📦', description: 'Brandschutzsysteme für große Innenräume, in denen eine schnelle und kontrollierte Löschung erforderlich ist.', points: ['Vorgesteuerte Trockensysteme für sensible Anlagen', 'Automatische Löschmonitore für große Raumhöhen', 'Nassalarmventile für Standardlager', 'Durchflussmelder zur Zonenüberwachung'], links: [{ label: 'Vorgesteuerte Systeme', href: '/de/products/pre-action-alarm-system-zsfy/' }, { label: 'Alarmventile', href: '/de/products/wet-alarm-check-valve-zsfz-150/' }, { label: 'Strömungswächter', href: '/de/products/water-flow-indicator-zsjz/' }] }
];
---
<Layout locale="de" title="Anwendungen und Branchen | Wanlian Fluid" description="Industriearmaturen und Brandschutzausrüstung für kommunale Wassertechnik, Prozessanlagen, HVAC, Petrochemie, Lager und maritime Anwendungen." faq={faq} breadcrumbs={[{ name: 'Anwendungen' }]}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20"><div class="text-center mb-16 space-y-4"><span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Anwendungen</span><h1 class="text-4xl sm:text-5xl font-black text-gray-900">Für <span class="text-brand-red">anspruchsvolle Umgebungen</span> entwickelt</h1><p class="text-lg text-gray-500 max-w-3xl mx-auto leading-relaxed">Wanlian-Produkte werden dort eingesetzt, wo Betriebssicherheit und zuverlässige Fluidsteuerung unverzichtbar sind.</p></div><div class="grid md:grid-cols-2 gap-8">{applications.map(app => <div class="bg-white p-8 rounded-2xl border shadow-sm"><div class="flex items-center gap-4 mb-4"><span class="text-4xl">{app.icon}</span><h2 class="text-xl font-black text-gray-900">{app.title}</h2></div><p class="text-gray-600 leading-relaxed mb-5">{app.description}</p><ul class="space-y-2 mb-6">{app.points.map(point => <li class="flex items-start text-sm text-gray-700"><span class="text-brand-blue mr-2">✓</span>{point}</li>)}</ul><div class="flex flex-wrap gap-3 border-t pt-4">{app.links.map(link => <a href={link.href} class="text-sm font-bold text-brand-red hover:underline">{link.label} →</a>)}</div></div>)}</div><div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center"><h2 class="text-2xl font-black">Sie sind bei der Produktauswahl unsicher?</h2><p class="text-gray-400 max-w-xl mx-auto mt-3">Senden Sie Ihre Anwendungsdaten. Unsere Ingenieure empfehlen innerhalb von 12 Stunden eine geeignete Lösung.</p><a href="/de/contact/" class="inline-block mt-6 px-8 py-4 bg-brand-red rounded-xl font-bold">Technische Beratung anfordern</a></div></main>
</Layout>
