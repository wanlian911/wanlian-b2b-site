---
import Layout from '../../../layouts/Layout.astro';
const faq = [{ question: 'Warum zeigt das Tool einen Index?', answer: 'Wanlian Fluid erstellt Angebote auf Anfrage. Der relative Index hilft, Menge, Incoterm und Zielregion zu vergleichen; er ist keine Preisliste.' }, { question: 'Ist der Index ein verbindliches Angebot?', answer: 'Nein. Der tatsächliche Preis hängt von Modell, Nennweite, Werkstoff, Norm, Menge und Zielort ab und wird in einem detaillierten Angebot bestätigt.' }];
---
<Layout title="Kostenrechner: Ventile und Hydranten" description="Interaktives Tool zur Schätzung eines relativen Kostenindex nach Menge, Incoterm und Zielregion." type="website" locale="de" faq={faq} breadcrumbs={[{ name: 'Ressourcen' }, { name: 'Kostenrechner' }]}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/de/">Startseite</a><span>/</span><span class="text-gray-600">Kostenrechner</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Interaktives Tool</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Kostenrechner für Ventile und Hydranten</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Schätzen Sie einen <strong>relativen Lieferkostenindex</strong>, indem Sie Menge, Incoterm und Zielregion anpassen. Basis 100 = ein Hydrant, EXW, Zielregion Ostasien.</p><div class="bg-amber-50 border border-amber-200 rounded-xl p-4 my-6"><p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-red">Wichtig:</strong> Der Index dient der Planung. Das endgültige Angebot hängt von exaktem Modell, Nennweite, Werkstoff, Norm und Menge ab.</p></div><div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 sm:p-8 my-6"><h2 class="text-lg font-black text-gray-900 mb-4">1 · Los konfigurieren</h2><div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="line-items"><label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3"><span class="text-sm font-semibold text-gray-800">Hydranten (SS100)</span><input type="number" min="0" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="100"/></label><label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3"><span class="text-sm font-semibold text-gray-800">Absperrschieber (Z41X)</span><input type="number" min="0" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="70"/></label><label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3"><span class="text-sm font-semibold text-gray-800">Absperrklappen (D381X)</span><input type="number" min="0" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="45"/></label><label class="flex items-center justify-between gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3"><span class="text-sm font-semibold text-gray-800">Rückschlagventile (HQ41X)</span><input type="number" min="0" value="0" class="w-20 text-right border border-gray-200 rounded-lg px-2 py-1 text-sm qty" data-index="55"/></label></div><h2 class="text-lg font-black text-gray-900 mt-8 mb-4">2 · Lieferparameter</h2><div class="grid grid-cols-1 sm:grid-cols-2 gap-4"><label class="text-sm font-semibold text-gray-700">Incoterm<select id="incoterm" class="mt-2 w-full border border-gray-200 rounded-lg px-3 py-2 font-normal"><option value="1">EXW (1,00)</option><option value="1.08">FOB (1,08)</option><option value="1.18">CIF (1,18)</option><option value="1.3">DDP (1,30)</option></select></label><label class="text-sm font-semibold text-gray-700">Zielregion<select id="region" class="mt-2 w-full border border-gray-200 rounded-lg px-3 py-2 font-normal"><option value="1">Ostasien</option><option value="1.12">Europa</option><option value="1.18">Nordamerika</option><option value="1.25">Lateinamerika</option></select></label></div><button id="estimate" class="mt-6 px-8 py-3 bg-brand-red text-white font-bold rounded-lg">Index berechnen</button></div><div id="result" class="hidden bg-blue-50 border border-blue-100 rounded-2xl p-6 sm:p-8 my-6"><p class="text-xs font-bold uppercase tracking-widest text-brand-blue">Relativer Kostenindex</p><p id="index-value" class="text-5xl font-black text-gray-900 mt-2">0</p><p class="mt-3 text-sm text-gray-600"><span id="units-label">0</span> Einheiten · <span id="incoterm-label">EXW</span> · <span id="region-label">Ostasien</span></p><p id="drivers" class="mt-4 text-sm text-gray-700"></p></div><div class="mt-10 text-center"><h2 class="text-2xl font-black text-gray-900">Benötigen Sie ein verbindliches Angebot?</h2><p class="mt-3 text-gray-600">Senden Sie Ihre vollständige Spezifikation an unsere Ingenieure.</p><a href="/de/contact/" class="inline-block mt-6 px-8 py-4 bg-brand-red text-white font-bold rounded-lg">Angebot anfordern</a></div></article></main>
</Layout>
<script>function estimate(){const inputs=[...document.querySelectorAll('.qty')];let base=0,units=0;for(const i of inputs){const q=Math.max(0,parseInt(i.value||'0',10));base+=q*parseFloat(i.dataset.index||'0');units+=q}const result=document.getElementById('result');result.classList.remove('hidden');const inc=document.getElementById('incoterm');const reg=document.getElementById('region');const mult=units<10?1:units<100?.9:units<1000?.82:.75;document.getElementById('index-value').textContent=String(Math.round(base*mult*parseFloat(inc.value)*parseFloat(reg.value)));document.getElementById('units-label').textContent=String(units);document.getElementById('incoterm-label').textContent=inc.options[inc.selectedIndex].text.split(' (')[0];document.getElementById('region-label').textContent=reg.options[reg.selectedIndex].text;document.getElementById('drivers').textContent=units?'Relativer Index zur Planung; senden Sie die Spezifikation für den tatsächlichen Preis.':'Fügen Sie mindestens einen Artikel hinzu, um den Index zu berechnen.'}document.getElementById('estimate').addEventListener('click',estimate)</script>
