---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{ question: 'Welche wirksame Reichweite hat Ihre Löschkanone?', answer: 'Die Reichweite hängt von Modell und Eintrittsdruck ab – bei Nennvolumenstrom typischerweise 50 bis 110 m für die PS-Serie; die Überwachungsradien der automatisch suchenden ZDMS-Serie betragen 40–65 m. Teilen Sie uns Ihren Standortplan mit, damit wir das passende Modell empfehlen können.' },
	{ question: 'Kann die Löschkanone ferngesteuert betrieben werden?', answer: 'Ja. Die automatisch suchende ZDMS-Löschkanone arbeitet mit Infrarot-/Ultraviolett-Flammenerkennung vollständig autonom und unterstützt eine manuelle Fernübersteuerung per PC, mobiler Anwendung oder zentralem Schaltschrank. Fest installierte Monitore sind ebenfalls mit Handhebelbedienung erhältlich.' },
	{ question: 'Welche Volumenströme sind verfügbar?', answer: 'Die Standardmodelle reichen von 5 l/s bis 200 l/s. Die ZDMS-Serie ist mit 5, 10, 20 und 30 l/s erhältlich und bis 150 l/s anpassbar; die manuelle PS-Serie deckt 20–200 l/s ab. Projektspezifische Volumenströme können ausgelegt werden.' },
	{ question: 'Lässt sich das intelligente Modell in Brandmeldeanlagen integrieren?', answer: 'Ja. Intelligente ZDMS-Löschkanonen verwenden mehrbandige Infrarot- und Ultraviolettsensoren zur automatischen Branderkennung, Positionierung und Löschstrahlsteuerung innerhalb von 30 Sekunden und können an Brandmelderzentralen angebunden werden. Explosionsgeschützte Ausführungen sind optional verfügbar.' },
	{ question: 'Liefern Sie die komplette Anlage einschließlich Ventilen und Rohrleitungen?', answer: 'Ja. Wir fertigen die Löschkanone und liefern sie zusammen mit passenden Ventilen, Kupplungen, Hydranten und Zubehör für den vollständigen Löschkreis. Das vereinfacht die Beschaffung und gewährleistet die Systemkompatibilität.' }
];

const cannonProducts = [
	{ slug: 'auto-tracking-jet-suppression-cannon-zdms', name: 'Automatisch suchende Löschkanone (ZDMS)', img: '/assets/06_extinguishing_cannons/cannon_p45.webp', desc: 'Automatische IR/UV-Erkennung, 360°-Drehung, Radius 40–65 m' },
	{ slug: 'manual-fire-water-cannon-ps', name: 'Manuelle Löschkanone (PS-Serie)', img: '/assets/products/manual-fire-water-cannon-ps.webp', desc: '20–200 l/s, Strahlreichweite bis 110 m, Wasser oder Schaum' },
	{ slug: 'foam-fire-hydrant-cabinet-psg30', name: 'Schaumhydrantenschrank (PSG30)', img: '/assets/06_extinguishing_cannons/cannon_p42.webp', desc: '3-%-AFFF-Schaumeinheit für Chemikalien- und Ölbrände' },
	{ slug: 'fire-hose-reel-jpso8-19', name: 'Zubehörsatz für Feuerlösch-Schlauchhaspel (JPS0.8-19)', img: '/assets/products/fire-hose-reel-jpso8-19.jpg', desc: '20–30 m Flachrollschlauch, Schwenkhalterung, schnelle Einsatzbereitschaft' },
	{ slug: 'adjustable-pistol-grip-fire-nozzle', name: 'Verstellbares Feuerlöschstrahlrohr mit Pistolengriff', img: '/assets/products/adjustable-pistol-grip-fire-nozzle.jpg', desc: 'Vollstrahl / Sprühstrahl, Messing-Pistolengriff für handgeführte Leitungen' },
	{ slug: 'sqd100-1-6-fire-pump-adapter', name: 'Feuerwehr-Pumpenanschluss (SQD100/1-6)', img: '/assets/products/sqd100-1-6-fire-pump-adapter.webp', desc: 'Doppelstutzen-Feuerwehreinspeisung DN100/1,6 für zwei Zuläufe' }
];
---

<Layout locale="de" title="Löschkanonen | Ferngesteuerte & intelligente Löschmonitore" description="Löschkanonen von WLFE bieten hohen Volumenstrom und große Reichweite für Werke, Terminals und Lagerhäuser. Fest, ferngesteuert und automatisch suchend." type="product" productData={{ name: 'Löschkanonen', image: '/assets/06_extinguishing_cannons/cannon_p45.webp', description: 'Feste, ferngesteuerte und intelligente Löschkanonen mit 5–200 l/s und bis zu 110 m Reichweite für den industriellen Brandschutz, gefertigt von Quanzhou Wanlian Fluid Equipment Co., Ltd.' }} faq={faq} breadcrumbs={[{ name: 'Löschkanonen' }]}>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/de/" class="hover:text-blue-600">Startseite</a><span>/</span><a href="/de/products/" class="hover:text-blue-600">Produkte</a><span>/</span><span class="text-gray-600">Löschkanonen</span></nav>
		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Löschkanonenanlagen</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Löschkanonenanlagen für industrielle Bereiche mit hohem Risiko</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid fertigt Löschkanonen mit hohem Volumenstrom für petrochemische Anlagen, LNG-Terminals, Lagerhäuser und Flughäfen – von fest installierten manuellen Löschmonitoren bis zu vollständig autonomen, automatisch suchenden Kanonen mit Fern- und Intelligenzsteuerung.</p>
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">{['Volumenstrom bis 200 l/s', 'Reichweite bis 110 m', '360°-Drehung', 'Automatische IR/UV-Erkennung'].map(b => (<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span></div>))}</div>
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Löschkanonen-Serie</h2><div class="grid grid-cols-2 lg:grid-cols-3 gap-4">{cannonProducts.map(p => (<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition"><img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" /><div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p><p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p></div></a>))}</div>
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Wichtige technische Daten</h2><div class="overflow-x-auto rounded-xl border border-gray-200 my-5"><table class="min-w-full divide-y divide-gray-200 text-sm"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Spezifikation</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Details</th></tr></thead><tbody class="bg-white divide-y divide-gray-200"><tr><td class="px-4 py-3 font-bold text-gray-900">Nennvolumenstrom</td><td class="px-4 py-3 text-gray-700">5–200 l/s je Modell (ZDMS bis 150 l/s anpassbar)</td></tr><tr><td class="px-4 py-3 font-bold text-gray-900">Strahlreichweite</td><td class="px-4 py-3 text-gray-700">50–110 m abhängig von Modell und Eintrittsdruck</td></tr><tr><td class="px-4 py-3 font-bold text-gray-900">Drehbereich</td><td class="px-4 py-3 text-gray-700">Horizontal 360°, vertikal −90° bis +70°</td></tr><tr><td class="px-4 py-3 font-bold text-gray-900">Steuerungsarten</td><td class="px-4 py-3 text-gray-700">Manuell / Fernsteuerung (PC, mobile Anwendung, zentraler Schaltschrank) / automatisch (Flammenerkennung)</td></tr><tr><td class="px-4 py-3 font-bold text-gray-900">Gehäusewerkstoff</td><td class="px-4 py-3 text-gray-700">Hartanodisiertes Aluminium T6 / Bronze, wasserführende Teile SS304</td></tr><tr><td class="px-4 py-3 font-bold text-gray-900">Optionen</td><td class="px-4 py-3 text-gray-700">Explosionsschutz (Exde II BT4 Gb), Schaummittelzumischung</td></tr></tbody></table></div>
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Anwendungen</h2><p class="text-gray-700 leading-relaxed">Löschkanonen schützen petrochemische Prozessbereiche, Öl- und LNG-Tanklager, Verladeterminals, große Lagerhäuser, Flughafendocks und Umspannwerke – Bereiche mit großer Höhe oder im Freien, in denen eine stationäre Löschanlage bei hoher Wärmeeinwirkung große Entfernungen überbrücken muss.</p><h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Warum Wanlian Fluid?</h2><ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4"><li><strong>Eine Bestellung, ein Werk</strong> – Löschkanonen zusammen mit passenden Ventilen, Kupplungen und Hydranten für den vollständigen Löschkreis.</li><li><strong>Projektengineering</strong> – wir empfehlen Reichweite, Volumenstrom und Steuerung anhand Ihres Standortplans.</li><li><strong>Zertifizierte Qualität</strong> – UL/ULC, FM und Qualitätsmanagement nach ISO 9001; siehe unsere <a href="/de/certificates/" class="text-brand-blue font-semibold hover:underline">Zertifikatsseite</a>.</li></ul>
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Häufig gestellte Fragen</h2><div class="space-y-4">{faq.map(item => (<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>))}</div>
			<div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white tracking-tight">Benötigen Sie eine Löschkanone für Ihren Standort?</h2><p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Senden Sie uns Standortplan, erforderliche Reichweite und Volumenstrom – unsere Ingenieure empfehlen das passende Modell und antworten innerhalb von 12 Stunden mit einem vollständigen Angebot.</p><div class="mt-6 flex flex-col sm:flex-row justify-center gap-4"><a href="/de/contact/?product=Löschkanonen" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Angebot anfordern</a><a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Guten Tag, ich benötige eine Löschkanone.')}`} class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Über WhatsApp chatten</a></div></div></div>
		</article></main>
</Layout>
