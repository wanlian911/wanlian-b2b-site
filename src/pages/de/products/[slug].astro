---
import ProductGallery from '../../../components/shared/ProductGallery.astro';
import Layout from '../../../layouts/Layout.astro';
import { productsDe, productsDeBySlug } from '../../../utils/products.de';
import { PRODUCT_FAMILY_RELATED } from '../../../utils/product-families';
import { guidesDe } from '../../../utils/guides.de';

export async function getStaticPaths() {
  return Object.values(productsDeBySlug).map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

// Allgemeine Einkaufs-FAQs nach Kategorie
const faqByCategory: Record<string, { question: string; answer: string }[]> = {
  'Industrieventile & Schmutzfänger': [
    { question: 'Welche Normen und Anschlussarten stehen für Wanlian-Armaturen zur Verfügung?', answer: 'Wanlian-Armaturen werden auf Anfrage nach den Normen GB, ANSI, DIN und JIS gefertigt. Je nach Modell sind Flansch-, Rillpress-, Klemm- und Gewindeanschlüsse verfügbar. Geben Sie in Ihrer Anfrage DN/PN und Anschlussart an, unsere Ingenieure bestätigen die passende Ausführung.' },
    { question: 'Welche Werkstoffe werden für Gehäuse und Abdichtung verwendet?', answer: 'Die Gehäuse bestehen je nach Modell aus duktilem Gusseisen (QT450), Grauguss oder Stahlguss bzw. Schmiedeteilen. Dichtelemente verwenden EPDM- oder NBR-Kautschuk, die Spindeln sind aus Edelstahl (2Cr13/304). Die Werkstoffe lassen sich an konkrete Medien und Temperaturbereiche anpassen.' },
    { question: 'Wie hoch sind MOQ und Lieferzeit?', answer: 'Die MOQ liegt üblicherweise bei 20 Stück je Modell für Lagergrößen, die Produktionszeit beträgt 15 bis 30 Tage je nach Menge und Anpassung. Musterbestellungen zur Prüfung vor dem Versand sind möglich.' },
    { question: 'Wie werden die Armaturen vor dem Versand geprüft?', answer: 'Jede Armatur wird zu 100 % einer Gehäuse- und Sitzdruckprüfung nach der geltenden Norm unterzogen (z. B. GB/T13927, EN 12266-1). Prüfberichte und eine Inspektion durch Dritte sind auf Anfrage möglich.' }
  ],
  'Hydranten & Pumpenanschlüsse': [
    { question: 'Welche Ausgangsanschlüsse sind für Export-Hydranten verfügbar?', answer: 'Übliche Ausgangsanschlüsse sind BS336 (UK und Commonwealth), NIST (Naher Osten), KWS (Deutschland) sowie flexible Flansche. Wir liefern Hydranten mit dem für Ihren Markt vorgesehenen Anschluss.' },
    { question: 'Welche Druckstufe sollte ein kommunaler Hydrant haben?', answer: 'Standard-Hydranten für Kommunen sind auf PN16 (1,6 MPa) ausgelegt und decken die meisten städtischen und industriellen Versorgungsnetze ab. In Hochhäusern oder bedarfsintensiven Industriegebieten können Hydranten in PN25 erforderlich sein.' },
    { question: 'Sind Wanlian-Hydranten mit UL- oder FM-Zulassung erhältlich?', answer: 'Ja, abhängig von Modell und Zielmarkt. Nennen Sie uns Ihre Projektspezifikation und die Zielregion, damit wir das passende Zulassungspaket zuordnen können.' },
    { question: 'Haben Überflurhydranten einen Frostschutz?', answer: 'Modelle wie der Überflurhydrant SS100 verfügen über einen automatischen Ablassmechanismus gegen Frost für kalte Klimate. Varianten mit Anprallschutz (SSFT100) und IoT-Ausführung (SS100ZN) sind ebenfalls verfügbar.' }
  ],
  'Sprinkler & Alarmventile': [
    { question: 'Was ist der Unterschied zwischen einem Nassalarmventil und einem Sprühflutventil?', answer: 'Ein Nassalarmventil (ZSFZ) hält die Sprinklerleitungen mit Wasser gefüllt und löst bei Durchfluss den Alarm aus. Ein Sprühflutventil (ZSFM) bleibt durch Druckluft oder Wasserdruck geschlossen und flutet die Anlage erst, wenn ein Brandmeldesignal es öffnet - eingesetzt in hochgefährdeten Bereichen, die sofort eine große Wassermenge erfordern.' },
    { question: 'Nach welchen Normen sind die Komponenten der Sprinkleranlage gefertigt?', answer: 'Die Komponenten werden nach der Reihe GB 5135 gefertigt und geprüft; auf Anfrage auch nach weiteren internationalen Normen. Stimmen Sie die für Ihr Projekt geltende Norm mit unseren Ingenieuren ab.' },
    { question: 'Wie hoch ist der Betriebsdruck der Alarmventile?', answer: 'Der Standard-Betriebsdruck beträgt 1,6 MPa, der Prüfdruck 3,2 MPa. Die Nennweiten decken je nach Modell üblicherweise DN50 bis DN300 ab.' },
    { question: 'Lassen sich die Alarmventilgruppen in vorhandene Brandmeldeanlagen einbinden?', answer: 'Ja. Sprühflutventile und vorgesteuerte Systeme unterstützen eine mechanische, pneumatische oder elektrische Auslösung (Magnetventil DC24V) und lassen sich in die meisten Brandmeldezentralen einbinden.' }
  ],
  'Hydraulische Regelventile': [
    { question: 'Benötigen hydraulische Regelventile eine Stromversorgung?', answer: 'Die meisten hydraulischen Regelventile (z. B. F745X Niveaukontrolle, 500X Druckminderung) arbeiten vollständig gesteuert über den Leitungsdruck und benötigen keine externe Energieversorgung. Modelle mit Magnetventilsteuerung wie GKZF-1 arbeiten mit AC220V oder DC24V.' },
    { question: 'Welchen Einstellbereich hat das Druckminderventil 500X?', answer: 'Das 500X regelt den Druck hinter dem Ventil von 0,1 MPa bis 1,6 MPa und arbeitet mit Eingangsdrücken bis zur Nenndruckstufe (PN10/PN16/PN25).' },
    { question: 'Welche Werkstoffe werden für Trinkwasseranwendungen verwendet?', answer: 'Für Trinkwassernetze verwenden Modelle wie der Rückflussverhinderer HS41X Gehäuse aus duktilem Gusseisen mit EPDM-Dichtungen und Innenkörper aus Edelstahl, entsprechend den hygienischen Anforderungen nach GB/T17219.' },
    { question: 'Wie wird ein Wasserschlag in hydraulischen Ventilen vermieden?', answer: 'Ventile mit Pilotsteuerung schließen sanft und langsam, wodurch Druckstöße vermieden werden. Nadelventile erlauben die Anpassung der Schlussgeschwindigkeit an die jeweilige Leitungsbedingung.' }
  ],
  'Löschmonitore & Löschkanonen': [
    { question: 'Welche Durchflüsse und Wurfweiten sind für Löschkanonen verfügbar?', answer: 'Manuelle Löschkanonen (Baureihe PS) decken 20 bis 200 L/s mit Wurfweiten von 50 bis 110 Metern ab. Automatisch suchende Löschkanonen (Baureihe ZDMS) liefern 5 bis 30 L/s (bis 150 L/s anpassbar) mit einem Überwachungsradius von 40 bis 65 m.' },
    { question: 'Wie erkennt eine automatisch suchende Löschkanone ein Feuer?', answer: 'Die Löschkanone ZDMS kombiniert Infrarot- und UV-Sensoren, um Flammen zu erkennen und zu verfolgen, und richtet das Wasser anschließend automatisch aus. Ein manueller Fernzugriff per PC oder App sowie über ein zentrales Bedienfeld ist möglich.' },
    { question: 'Gibt es explosionsgeschützte Ausführungen?', answer: 'Ja, für petrochemische Anlagen und explosionsgefährdete Bereiche sind Ex-geschützte Ausführungen erhältlich (z. B. Exde II BT4 Gb).' },
    { question: 'Mit welchem Druck arbeiten die Löschkanonen?', answer: 'Manuelle Löschkanonen arbeiten mit 0,8 bis 1,2 MPa, automatisch suchende Modelle mit 0,6 bis 0,8 MPa. Bestätigen Sie die Nennweite des Eingangsflansches (DN100/DN150/DN200) für Ihre Anlage.' }
  ],
  'Schlauchhaspeln & Hydrantenschränke': [
    { question: 'Was enthält ein Schlauchhaspel-Set?', answer: 'Das Set der Baureihe JPS enthält eine Haspel aus Kohlenstoffstahl mit Schwenkhalterung, einen flexiblen Flachschlauch aus PVC (20/25/30 m) sowie ein Strahlrohr aus Messing oder Legierung, das Vollstrahl und Nebel unterstützt.' },
    { question: 'Gibt es Schaumschränke für Brände von Brandflüssigkeiten?', answer: 'Ja. Der Schaumschrank PSG30 bündelt Schaummittelbehälter, Zumischgerät, Schlauchhaspel und Schaumrohr in einem wandmontierten Gerät - wirksam bei Bränden von Kraftstoffen, Chemikalien und Lösungsmitteln (Brandklasse B).' },
    { question: 'Welche Anschlussnormen unterstützen die Adapter für Schlauchkupplungen?', answer: 'Adapter der Reihe HS gibt es in DN50/DN65 mit Innengewinden für internationale Feuerwehrkupplungen, gefertigt nach GB12514 oder Werksnorm.' },
    { question: 'Welche Werkstoffe werden für Schränke und Haspeln verwendet?', answer: 'Schränke und Haspeln bestehen aus kaltgewalztem Kohlenstoffstahl mit korrosionsschützender roter Pulverbeschichtung. Strahlrohre und Zumischgeräte sind aus Messing oder eloxierter Aluminiumlegierung.' }
  ]
};

// Anwendungsgebiete und Prüfnormen je Kategorie
const categoryInfo: Record<string, { applications: string[]; testing: string }> = {
  'Industrieventile & Schmutzfänger': {
    applications: ['Wasserversorgung und -verteilung', 'Abwasser- und Schmutzwassernetze', 'Industrielle Prozessleitungen', 'Heizungs-, Lüftungs- und Klimatechnik'],
    testing: 'Gehäuse- und Sitzdruckprüfung zu 100 % nach GB/T13927 oder EN 12266-1; Epoxidharz-Beschichtung auf Korrosionsbeständigkeit geprüft.'
  },
  'Hydranten & Pumpenanschlüsse': {
    applications: ['Kommunale Löschwassernetze', 'Industrie- und Lagerplätze', 'Steigleitungen in Gebäuden', 'Freiaufstellung in kalten Klimaten'],
    testing: 'Statische Druckprüfung (typisch 2,4 MPa) und Durchflussprüfung nach GB 4452 oder den jeweils geltenden Exportnormen.'
  },
  'Sprinkler & Alarmventile': {
    applications: ['Automatische Sprinkleranlagen', 'Gewerbe- und Wohngebäude', 'Industrielager und Hallen', 'Hochgefährdete Anlagen mit Sprühflutanlage oder vorgesteuertem System'],
    testing: 'Druck- und Dichtheitsprüfungen nach der Reihe GB 5135; Alarmempfindlichkeit mit Strömungswächtern und Alarmgongs geprüft.'
  },
  'Hydraulische Regelventile': {
    applications: ['Niveauregelung in Behältern', 'Druckmanagement in Wassernetzen', 'Rückflussverhinderung in Trinkwassernetzen', 'Saugseitiger Pumpenschutz'],
    testing: 'Funktions- und Druckprüfungen nach den geltenden Normen; Membran- und Dichtungsgarnituren auf Lebensdauer geprüft.'
  },
  'Löschmonitore & Löschkanonen': {
    applications: ['Petrochemische Anlagen und Tanklager', 'Flughäfen und Messezentren', 'Großflächige Lagerhallen', 'Löschfahrzeuge und maritime Löschtechnik'],
    testing: 'Prüfungen von Durchfluss, Wurfweite und Schwenkbereich; Ex-geschützte Ausführungen werden nach Ex-Normen nachgewiesen (optional).'
  },
  'Schlauchhaspeln & Hydrantenschränke': {
    applications: ['Löschstationen im Gebäudeinneren', 'Lagerflächen für Chemikalien und Kraftstoffe', 'Schlauchleitungssysteme in Gebäuden', 'Marine- und Offshore-Anlagen'],
    testing: 'Druck- und Funktionsprüfung von Haspeln, Strahlrohren und Zumischgeräten; Expansionsverhältnis des Schaums je Modell geprüft.'
  }
};

// Product-level FAQ takes priority; falls back to the category FAQ
const faqs = product.faqs ?? faqByCategory[product.category] ?? [];
const info = categoryInfo[product.category];

// Optional product video: rendered plus VideoObject JSON-LD when the data provides one
const videoData = product.video
  ? {
      name: `${product.name} | Videoüberblick`,
      description: product.video.description ?? `Videoüberblick zu ${product.name}: Aufbau, wichtigste Abmessungen und Einbauorte.`,
      thumbnail: product.video.poster ?? product.image,
      src: product.video.src,
      duration: product.video.duration ?? 'PT2M0S',
      uploadDate: product.video.uploadDate ?? '2026-09-21'
    }
  : undefined;
// Related guides per product family; products without a family fall back to category interlinking
const bySlug = new Map(productsDe.map(p => [p.slug, p]));
const familySlugs = PRODUCT_FAMILY_RELATED[product.slug] ?? [];
const relatedProducts = familySlugs.length
  ? familySlugs.map(s => bySlug.get(s)).filter((p): p is typeof productsDe[number] => Boolean(p))
  : productsDe.filter(p => p.category === product.category && p.slug !== product.slug).slice(0, 4);
const catAnchor = encodeURIComponent(product.category);

// Einkaufsführer je Kategorie
const guidesByHref: Record<string, { title: string; description: string }> = {};
for (const g of guidesDe) guidesByHref[g.href] = { title: g.title, description: g.description };
const guideCard = (href: string) => {
  const g = guidesByHref[href];
  if (!g) throw new Error('Leitfaden fehlt in guides.de.ts: ' + href);
  return { href: href, title: g.title, description: g.description };
};
const guideByCategory: Record<string, { href: string; title: string; description: string }[]> = {
  'Industrieventile & Schmutzfänger': [guideCard('/de/guides/gate-valve-vs-butterfly-valve-fire-protection/'), guideCard('/de/guides/check-valve-types-guide/')],
  'Hydranten & Pumpenanschlüsse': [guideCard('/de/guides/how-to-choose-a-fire-hydrant/'), guideCard('/de/guides/fire-hydrant-valve-standards-guide/')],
  'Sprinkler & Alarmventile': [guideCard('/de/guides/fire-sprinkler-control-valve-types/'), guideCard('/de/guides/fire-sprinkler-system-wet-dry-preaction/')],
  'Hydraulische Regelventile': [guideCard('/de/guides/pressure-reducing-valve-guide/'), guideCard('/de/guides/backflow-prevention-guide/')],
  'Löschmonitore & Löschkanonen': [guideCard('/de/guides/fire-water-monitor-selection-guide/'), guideCard('/de/guides/fire-water-cannon-buying-guide/')],
  'Schlauchhaspeln & Hydrantenschränke': [guideCard('/de/guides/fire-hose-reel-cabinet-guide/'), guideCard('/de/guides/fire-extinguisher-selection-guide/')]
};

const relatedGuides = (guideByCategory[product.category] ?? []).slice(0, 3);
---

<Layout
  locale="de"
  title={product.seoTitle}
  description={product.seoDescription}
  productData={product}
  type="product"
  faq={faqs}
  video={videoData}
  breadcrumbs={[{ name: 'Produkte', href: '/de/products/' }, { name: product.category, href: `/de/products/#category=${catAnchor}` }, { name: product.name }]}
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 mb-20">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-8 flex gap-2">
      <a href="/de/" class="hover:text-blue-600">Startseite</a>
      <span>/</span>
      <a href="/de/products/" class="hover:text-blue-600">Produkte</a>
      <span>/</span>
      <a href={`/de/products/#category=${catAnchor}`} class="hover:text-blue-600">{product.category}</a>
      <span>/</span>
      <span class="text-gray-600">{product.name}</span>
    </nav>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <!-- Product Image -->
      <ProductGallery 
        mainImage={product.image} 
        gallery={product.gallery} 
        alt={product.name} 
      />

      <!-- Product video (only when the data provides product.video) -->
      {product.video && (
        <div class="mt-4 rounded-2xl overflow-hidden shadow-sm border border-gray-100 bg-gray-900">
          <video class="w-full h-auto" controls playsinline preload="metadata" poster={product.video.poster}>
            <source src={product.video.src} type="video/mp4" />
              Ihr Browser unterstützt kein eingebettetes Video.
          </video>
        </div>
      )}

      <!-- Product Details -->
      <div class="space-y-6">
        <div>
          <span class="text-blue-600 font-semibold uppercase tracking-wider text-sm">{product.category}</span>
          <h1 class="text-4xl font-bold text-gray-900 mt-2">{product.name}</h1>
        </div>

        <div class="text-lg text-gray-600 leading-relaxed space-y-4">
          {product.description.split('\n\n').map(paragraph => (
            <p>{paragraph}</p>
          ))}
        </div>

        <div class="space-y-4">
          <h2 class="text-xl font-bold border-b pb-2">Wichtige Merkmale</h2>
          <ul class="grid grid-cols-1 gap-2">
            {product.features.map(feature => (
              <li class="flex items-start">
                <svg class="h-6 w-6 text-green-500 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-700">{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-gray-100 p-6 rounded-xl space-y-4">
          <h2 class="text-xl font-bold">Technische Spezifikationen</h2>
          <dl class="grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2">
            {Object.entries(product.specs).map(([key, value]) => (
              <div class="border-b border-gray-200 py-2">
                <dt class="text-sm font-medium text-gray-500">{key}</dt>
                <dd class="mt-1 text-sm font-bold text-gray-900">{value}</dd>
              </div>
            ))}
          </dl>
        </div>

        {product.Werkstoffs && (
          <div class="bg-gray-50 p-6 rounded-xl border border-gray-200/60 space-y-4">
            <h2 class="text-xl font-bold text-gray-900">Teile- und Werkstoffliste</h2>
            <dl class="grid grid-cols-1 gap-x-4 gap-y-2 sm:grid-cols-2">
              {Object.entries(product.Werkstoffs).map(([part, Werkstoff]) => (
                <div class="border-b border-gray-200/60 py-2 flex justify-between items-center text-sm">
                  <dt class="font-medium text-gray-500">{part}</dt>
                  <dd class="font-bold text-gray-900 text-right">{Werkstoff}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {product.dimensions && (
          <div class="bg-white p-6 rounded-xl border border-gray-100 space-y-4 shadow-sm overflow-x-auto">
            <h2 class="text-xl font-bold text-gray-900">Standardabmessungen</h2>
            <table class="min-w-full divide-y divide-gray-200 text-sm">
              <thead class="bg-gray-50">
                <tr>
                  {product.dimensions.headers.map(header => (
                    <th class="px-3 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">{header}</th>
                  ))}
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                {product.dimensions.rows.map(row => (
                  <tr class="hover:bg-gray-50/50">
                    {row.map(cell => (
                      <td class="px-3 py-3 text-gray-700 font-medium whitespace-nowrap">{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {info && (
          <div class="space-y-4">
            <div class="bg-blue-50/50 p-6 rounded-xl border border-blue-100/50">
              <h2 class="text-xl font-bold text-gray-900 mb-3">Anwendungen</h2>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                {info.applications.map(app => (
                  <li class="flex items-start text-sm text-gray-700">
                    <svg class="h-5 w-5 text-blue-600 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {app}
                  </li>
                ))}
              </ul>
            </div>
            <div class="bg-gray-50 p-6 rounded-xl border border-gray-200/60">
              <h2 class="text-xl font-bold text-gray-900 mb-3">Qualität und Prüfungen</h2>
              <p class="text-sm text-gray-700 leading-relaxed">{info.testing}</p>
            </div>
          </div>
        )}

        <div class="flex flex-col sm:flex-row gap-4 pt-6">
          <a
            href={`/de/contact/?product=${encodeURIComponent(product.name)}`}
            class="flex-1 text-center py-4 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition shadow-lg shadow-blue-600/20"
          >
            Angebot anfordern
          </a>
          <a
            href={`/de/contact/?product=${encodeURIComponent('Produktdokumentation anfordern')}`}
            class="flex-1 text-center py-4 bg-white text-blue-600 font-bold border-2 border-blue-600 rounded-xl hover:bg-blue-50 transition"
          >
            Produktdokumentation anfordern
          </a>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    {faqs.length > 0 && (
      <section class="mt-20 max-w-4xl">
        <h2 class="text-3xl font-black text-gray-900 mb-8">Häufig gestellte Fragen</h2>
        <div class="space-y-4">
          {faqs.map((faq, index) => (
            <details class="group bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer px-6 py-5 font-bold text-gray-900 hover:bg-gray-50 transition list-none">
                <span>{faq.question}</span>
                <svg class="w-5 h-5 text-gray-400 group-open:rotate-45 transition-transform flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                </svg>
              </summary>
              <div class="px-6 pb-6 text-gray-600 leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Guides (backlinks GEO) -->
    {relatedGuides.length > 0 && (
      <section class="mt-20">
        <h2 class="text-3xl font-black text-gray-900 mb-8">Verwandte Einkaufsleitfäden</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedGuides.map(guide => (
            <a href={guide.href} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-6 flex flex-col">
              <span class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-2">Einkaufsleitfaden</span>
              <h3 class="text-sm font-bold text-gray-900 group-hover:text-brand-blue transition leading-snug">{guide.title}</h3>
              <p class="text-xs text-gray-500 leading-relaxed mt-2 flex-grow">{guide.description}</p>
              <span class="mt-4 inline-flex items-center text-brand-red font-bold text-xs group-hover:gap-1 transition-all">
                Leitfaden lesen
                <svg class="w-3.5 h-3.5 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <section class="mt-20">
        <h2 class="text-3xl font-black text-gray-900 mb-8">Verwandte Produkte</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {relatedProducts.map(related => (
            <a href={`/de/products/${related.slug}/`} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:border-brand-blue/30 transition p-6 flex flex-col">
              <img src={related.image} alt={related.name} class="w-full h-40 object-contain rounded-lg bg-gray-50 p-2 mb-4" loading="lazy" />
              <span class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-2">{related.category}</span>
              <h3 class="text-sm font-bold text-gray-900 group-hover:text-brand-blue transition leading-snug">{related.name}</h3>
              <span class="mt-4 inline-flex items-center text-brand-red font-bold text-xs group-hover:gap-1 transition-all">
                Details ansehen
                <svg class="w-3.5 h-3.5 ml-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
