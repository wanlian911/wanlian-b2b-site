---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{ question: 'Was bedeutet die UL-Listung für Brandschutzventile?', answer: 'Die UL-Listung bestätigt, dass ein Ventil die Brandschutzanforderungen von UL/ULC an Volumenstrom, Druckstufe und Dauerhaftigkeit erfüllt. Dadurch wird ein zuverlässiger Betrieb in Sprinkler- und Steigleitungssystemen sichergestellt. Für die meisten nordamerikanischen und viele internationale Projekte ist sie vorgeschrieben.' },
	{ question: 'Welche Brandschutzventile fertigt Wanlian mit UL-Listung?', answer: 'Wir fertigen Absperrschieber, Absperrklappen, Rückschlagventile, Sprühflutventile und vorgesteuerte Ventile mit Flansch-, Nut- und Gewindeanschlüssen von DN40 bis DN300. Senden Sie unserem Vertrieb Ihre Projektspezifikation, damit wir Ventiltyp und Zertifizierungspaket passend auswählen.' },
	{ question: 'Können Sie das UL-Zertifikat vor der Bestellung bereitstellen?', answer: 'Ja. Unsere UL/ULC- und FM-Zertifikate sind auf Anfrage erhältlich. Sie finden Referenzen auf unserer Zertifikatsseite; vor der Angebotserstellung bestätigen unsere Ingenieure die für den Zielmarkt geltende Zertifizierung.' },
	{ question: 'Wie hoch sind Mindestbestellmenge und Lieferzeit für Brandschutzventile?', answer: 'Die Mindestbestellmenge hängt von Ventiltyp und Nennweite ab – bei Lagergrößen üblicherweise 10–20 Stück je Modell, bei einer Fertigungszeit von 15–30 Tagen. Musterbestellungen zur Prüfung und Freigabe vor dem Versand sind möglich.' },
	{ question: 'Unterstützen Sie OEM- und Handelsmarkenlösungen für Brandschutzventile?', answer: 'Ja, wir unterstützen OEM/ODM mit individueller Kennzeichnung, Verpackung und Anpassung der Spezifikation gemäß den Projektanforderungen. Die Fertigung erfolgt auf unseren eigenen Produktionslinien unter einem Qualitätsmanagementsystem nach ISO 9001.' }
];

const valveProducts = [
	{ slug: 'resilient-seat-flanged-gate-valve-z41x', name: 'Weichdichtender Absperrschieber (Z41X)', img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp', desc: 'EPDM-ummantelter Keil, blasenfreie Absperrung, DN50–DN700' },
	{ slug: 'signal-grooved-wafer-butterfly-valve-dn80', name: 'Signal-Absperrklappe in Zwischenflanschausführung', img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp', desc: 'DN80 PN16 mit integriertem Endschalter zur Zustandsüberwachung' },
	{ slug: 'ul-fm-resilient-seat-osy-gate-valve', name: 'UL/FM-OS&amp;Y-Absperrschieber (Nutanschluss)', img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp', desc: 'UL/FM-gelisteter Absperrschieber mit steigender Spindel, 2–10 Zoll, Nutenden' },
	{ slug: 'spherical-ball-check-valve-hq44x', name: 'Kugel-Rückschlagventil (HQ44X)', img: '/assets/products/spherical-ball-check-valve-hq44x.webp', desc: 'Geringer Druckverlust, verstopfungsarme Rollkugelkonstruktion' },
	{ slug: 'deluge-alarm-valve-zsfm', name: 'Sprühflut-Alarmventilstation (ZSFM)', img: '/assets/products/deluge-alarm-valve-zsfm.webp', desc: 'Membrangesteuert, DN50–DN300, schnelles Öffnen' },
	{ slug: 'pre-action-alarm-system-zsfy', name: 'Vorgesteuerte Alarmventilstation (ZSFY)', img: '/assets/products/pre-action-alarm-system-zsfy.jpg', desc: 'Ausfallsichere Doppelauslösung für wasserempfindliche Räume' },
	{ slug: 'wafer-type-butterfly-valve-d71x', name: 'Absperrklappe in Zwischenflanschausführung (D71X)', img: '/assets/products/wafer-type-butterfly-valve-d71x.webp', desc: 'Gummierte Absperrklappe aus Sphäroguss, DN50–DN300, UL/FM-Option' },
	{ slug: 'wet-alarm-check-valve-zsfz-150', name: 'Nassalarm-Rückschlagventil (ZSFZ-150)', img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp', desc: 'Nassalarm-Rückschlagventil mit Hydraulikglocke und Verzögerungskammer, DN100–DN200' }
];
---

<Layout locale="de" title="UL-gelistete Brandschutzventile | Hersteller – WLFE" description="WLFE fertigt UL-gelistete Brandschutzventile: Absperrschieber, Absperrklappen, Rückschlag-, Sprühflut- und vorgesteuerte Ventile. Direktangebot ab Werk." type="product" productData={{ name: 'UL-gelistete Brandschutzventile', image: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp', description: 'UL-gelistete Absperrschieber, Absperrklappen, Rückschlag-, Sprühflut- und vorgesteuerte Ventile für Brandschutzanlagen, geliefert von Quanzhou Wanlian Fluid Equipment Co., Ltd.' }} faq={faq} breadcrumbs={[{ name: 'UL-Brandschutzventile' }]}>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/de/" class="hover:text-blue-600">Startseite</a><span>/</span><a href="/de/products/" class="hover:text-blue-600">Produkte</a><span>/</span><span class="text-gray-600">UL-Brandschutzventile</span></nav>
		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">UL-zertifizierte Brandschutzventile</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">UL-gelistete Brandschutzventile für zuverlässige Brandschutzanlagen</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid fertigt UL-gelistete Absperrschieber, Absperrklappen, Rückschlagventile, Sprühflutventile und vorgesteuerte Ventile für gewerbliche und industrielle Brandschutzanlagen. Jedes Ventil wird auf unseren eigenen Produktionslinien nahe Quanzhou unter einem Qualitätsmanagementsystem nach ISO 9001 gefertigt – direkt ab Werk, mit verlässlichen Lieferzeiten und vollständiger Zertifizierungsdokumentation für Ihr Projekt.</p>
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">{['UL/ULC-gelistet', 'FM-zugelassen', 'ISO 9001:2015', 'Direkt ab Werk'].map(b => (<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span></div>))}</div>
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Brandschutzventil-Serie</h2><div class="grid grid-cols-2 lg:grid-cols-3 gap-4">{valveProducts.map(p => (<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition"><img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" /><div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p><p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p></div></a>))}</div>
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Wichtige technische Daten</h2><div class="overflow-x-auto rounded-xl border border-gray-200 my-5"><table class="min-w-full divide-y divide-gray-200 text-sm"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Spezifikation</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Details</th></tr></thead><tbody class="bg-white divide-y divide-gray-200"><tr><td class="px-4 py-3 font-bold text-gray-900">Normen</td><td class="px-4 py-3 text-gray-700">UL-/ULC-gelistet, FM-zugelassen (modell- und zielmarktbezogen)</td></tr><tr><td class="px-4 py-3 font-bold text-gray-900">Nennweitenbereich</td><td class="px-4 py-3 text-gray-700">DN40–DN300 (1½–12 Zoll)</td></tr><tr><td class="px-4 py-3 font-bold text-gray-900">Druckstufe</td><td class="px-4 py-3 text-gray-700">PN16 / PN25 (modellabhängig)</td></tr><tr><td class="px-4 py-3 font-bold text-gray-900">Gehäusewerkstoff</td><td class="px-4 py-3 text-gray-700">Sphäroguss QT450 / WCB / CF8 · Edelstahl CF8M</td></tr><tr><td class="px-4 py-3 font-bold text-gray-900">Anschlussarten</td><td class="px-4 py-3 text-gray-700">Flansch / Nut / Gewinde</td></tr><tr><td class="px-4 py-3 font-bold text-gray-900">Medium</td><td class="px-4 py-3 text-gray-700">Wasser, Schaumlösung</td></tr></tbody></table></div>
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Anwendungen</h2><p class="text-gray-700 leading-relaxed">Unsere UL-Brandschutzventile werden in Sprinkleranlagen von Gewerbegebäuden, Industrieanlagen, Lager- und Logistikzentren, Rechenzentren sowie petrochemischen Feuerlöschleitungen eingesetzt – überall dort, wo zertifizierte und zuverlässige Durchflussregelung vorgeschrieben ist.</p><h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Warum Wanlian Fluid?</h2><ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4"><li><strong>Zertifizierte Qualität</strong> – UL/ULC- und FM-Zertifikate auf unserer <a href="/de/certificates/" class="text-brand-blue font-semibold hover:underline">Zertifikatsseite</a>, vor der Bestellung überprüfbar.</li><li><strong>Direkt ab Werk</strong> – verlässliche Lieferzeiten, OEM/ODM-Unterstützung und technische Auswahlhilfe.</li><li><strong>Eine Bestellung, ein Werk</strong> – Ventile zusammen mit Sprinklerköpfen, Hydranten und Zubehör für den vollständigen Löschkreis.</li></ul>
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8"><h2 class="text-xl font-black text-gray-900 tracking-tight">Neu bei Ventilnormen?</h2><p class="mt-2 text-gray-600 text-sm leading-relaxed">Beginnen Sie mit unserem Einkaufsleitfaden: <a href="/de/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">Normen für Hydranten, Feuerwehrschläuche und Ventile erklärt</a>.</p></div>
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Häufig gestellte Fragen</h2><div class="space-y-4">{faq.map(item => (<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>))}</div>
			<div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white tracking-tight">Benötigen Sie UL-Brandschutzventile für Ihr Projekt?</h2><p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Senden Sie uns Ventiltyp, DN/PN und gewünschte Zertifizierung – unsere Ingenieure antworten innerhalb von 12 Stunden mit Datenblatt und Angebot.</p><div class="mt-6 flex flex-col sm:flex-row justify-center gap-4"><a href="/de/contact/?product=UL-Brandschutzventile" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Angebot anfordern</a><a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Guten Tag, ich benötige UL-gelistete Brandschutzventile.')}`} class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Über WhatsApp chatten</a></div></div></div>
		</article></main>
</Layout>
