---
import Layout from '../../layouts/Layout.astro';
import { guidesDe } from '../../utils/guides.de';
import { tagsDe } from '../../utils/tags.de';

const solutions = [
  { title: 'Hydrantensysteme für den Brandschutz', description: 'Überflurhydranten, Unterflurhydranten und Pumpenanschlüsse für kommunale Netze, Industrieanlagen und Brandschutzprojekte.', href: '/de/fire-hydrant-systems/' },
  { title: 'Rückflussverhinderer und hydraulische Regelung', description: 'Rückflussverhinderer, Druckminderventile und hydraulische Regelventile für Trinkwasser und sichere Rohrleitungsnetze.', href: '/de/backflow-prevention/' },
  { title: 'Industrieventile und Anwendungen', description: 'Lösungen für kommunale Wasserversorgung, HLK/HVAC, Bewässerung, Öl und Gas sowie industrielle Rohrleitungen.', href: '/de/applications/' },
  { title: 'UL- und FM-Brandschutzventile', description: 'Brandschutzventile, Sprinklersysteme und technische Unterstützung für Projekte mit hohen Anforderungen.', href: '/de/ul-fire-valves/' },
  { title: 'Löschmonitore und Löschkanonen', description: 'Manuelle und automatisch suchende Löschmonitore für Raffinerien, Lager, Flughäfen und Risikobereiche.', href: '/de/fire-water-cannon/' },
  { title: 'Sprinkler- und Alarmventile', description: 'Nassalarmventile, Sprühflutventile, vorgesteuerte Trockensysteme und Durchflussmelder.', href: '/de/fire-sprinkler-systems/' }
];
---
<Layout title="Blog und Leitfäden | Wanlian Fluid" description="Technische Einkaufsleitfäden und Fachwissen zu Brandschutz, Industrieventilen und Fluidtechnik für B2B-Projekte." locale="de">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20">
    <div class="text-center mb-16 space-y-4"><span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Blog und Leitfäden</span><h1 class="text-4xl font-black text-gray-900 tracking-tight">Einkaufsleitfäden und industrielles Fachwissen</h1><p class="mt-4 text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">Praxisnahes Ingenieur- und Einkaufswissen für Brandschutzprojekte und die industrielle Fluidtechnik.</p></div>
    {guidesDe.length > 0 && <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">{guidesDe.map(article => <a href={article.href} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition p-8 flex flex-col"><div class="flex items-center gap-3 mb-4"><span class="px-2.5 py-1 bg-brand-blue/10 text-brand-blue text-[11px] font-black rounded-full uppercase tracking-wider">{article.category}</span><span class="text-xs text-gray-400">{article.date} · {article.readTime}</span></div><h2 class="text-lg font-black text-gray-900 group-hover:text-brand-blue transition leading-snug mb-3">{article.title}</h2><p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p><div class="flex flex-wrap gap-2 mt-4">{article.tags.map(tag => <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">#{tagsDe[tag]?.name ?? tag.replace(/-/g, ' ')}</span>)}</div><span class="mt-6 inline-flex items-center text-brand-red font-bold text-sm">Leitfaden lesen →</span></a>)}</div>}
    <div class="mt-16 mb-8 flex items-center gap-4"><h2 class="text-2xl font-black text-gray-900 tracking-tight">Produktlösungen</h2><div class="flex-1 h-px bg-gray-200"></div></div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">{solutions.map(article => <a href={article.href} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition p-8 flex flex-col"><span class="px-2.5 py-1 bg-brand-red/10 text-brand-red text-[11px] font-black rounded-full uppercase tracking-wider w-fit mb-4">Lösung</span><h2 class="text-lg font-black text-gray-900 group-hover:text-brand-red transition leading-snug mb-3">{article.title}</h2><p class="text-sm text-gray-500 leading-relaxed flex-grow">{article.description}</p><span class="mt-6 inline-flex items-center text-brand-blue font-bold text-sm">Lösung ansehen →</span></a>)}</div>
    <div class="mt-20 p-10 bg-gray-900 rounded-3xl text-white text-center space-y-4"><h2 class="text-2xl font-black">Benötigen Sie eine technische Beratung?</h2><p class="text-gray-400 max-w-xl mx-auto">Unsere Ingenieure unterstützen Sie bei der Auswahl geeigneter Ventile und Ausrüstung für Ihr Projekt.</p><a href="/de/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-xl">Ingenieur kontaktieren</a></div>
  </main>
</Layout>
