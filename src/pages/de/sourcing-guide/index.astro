---
import Layout from '../../../layouts/Layout.astro';
const faq = [{ question: 'Wie lange dauert der vollständige Einkaufsprozess?', answer: 'Bei Lagerware dauern Spezifikation und Angebot wenige Tage, ein Muster meist 1–3 Wochen und die Produktion 15–30 Tage. OEM/ODM-Artikel können zusätzliche Zeit erfordern.' }, { question: 'Welche Dokumente sollte ich verlangen?', answer: 'Fordern Sie Handelsrechnung, Packliste, Ursprungszeugnis, Stückprüfberichte, Werkstoffzertifikate und die für das Modell geltenden Normzertifikate an.' }];
const steps = [
 { n: '01', title: 'Spezifikation erstellen', body: 'Definieren Sie Norm, Nennweiten, Nenndruck, Werkstoffe, Mengen, Zielort und Incoterm. Eine klare Spezifikation reduziert Abweichungsrisiken.', links: [{ label: 'Industrieglossar', href: '/de/glossary/' }, { label: 'Leitfaden zu Normen', href: '/de/guides/fire-hydrant-valve-standards-guide/' }] },
 { n: '02', title: 'Lieferanten qualifizieren und prüfen', body: 'Bestätigen Sie die Rechtspersönlichkeit, das ISO-9001-System, die Fertigungskapazität, die Exporthistorie und die Zertifikate im Portal der ausstellenden Stelle.', links: [{ label: 'B2B-Einkaufscheckliste', href: '/de/guides/b2b-valve-sourcing-checklist/' }, { label: 'Chinesischen Lieferanten prüfen', href: '/de/guides/how-to-verify-chinese-valve-supplier/' }] },
 { n: '03', title: 'Detaillierte Angebote anfordern und vergleichen', body: 'Vergleichen Sie dasselbe Modell, dieselbe Norm, denselben Werkstoff, dieselbe Menge, denselben Incoterm und denselben Zielort. Bewerten Sie nicht nur den Stückpreis, sondern die gesamten Lieferkosten.', links: [{ label: 'Kostenrechner', href: '/de/cost-calculator/' }] },
 { n: '04', title: 'Muster bestellen und prüfen', body: 'Fordern Sie je Modell ein Muster an. Prüfen Sie Typenschild, Seriennummer, Werkstoff und Druckprüfung vor der Bestellung größerer Mengen.', links: [{ label: 'Hydranten auswählen', href: '/de/guides/how-to-choose-a-fire-hydrant/' }] },
 { n: '05', title: 'Produktion, Qualität und Dokumente bestätigen', body: 'Verlangen Sie Produktionsplan, Stückprüfberichte, Exportverpackung und Dokumentation vor der Schlusszahlung.', links: [{ label: 'Wanlian Fluid – Werk und Prüfungen', href: '/de/about/' }] },
 { n: '06', title: 'Logistik und After-Sales planen', body: 'Wählen Sie EXW, FOB, CIF oder DDP entsprechend der Risikoverteilung. Bewahren Sie Zertifikate und Prüfberichte für Abnahme, Wartung und Ersatzteile auf.', links: [{ label: 'Angebot anfordern', href: '/de/contact/' }] }
];
---
<Layout title="Einkaufsleitfaden: Brandschutzventile und Hydranten" description="B2B-Leitfaden zum Einkauf von Ventilen, Hydranten und Brandschutzausrüstung: Spezifikation, Prüfung, Muster, Qualität und Dokumente." type="website" locale="de" faq={faq} breadcrumbs={[{ name: 'Ressourcen' }, { name: 'Einkaufsleitfaden' }]}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/de/">Startseite</a><span>/</span><span class="text-gray-600">Einkaufsleitfaden</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">B2B-Einkaufszentrum</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Ventile, Hydranten und Brandschutzausrüstung richtig einkaufen</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Ein Leitfaden in sechs Schritten – von der schriftlichen Spezifikation bis zum After-Sales-Service beim Einkauf beim chinesischen Hersteller.</p><div class="bg-blue-50 border border-blue-100 rounded-xl p-5 my-6"><p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-blue">Warum eine feste Reihenfolge:</strong> Die größten Risiken entstehen an den Übergängen zwischen Spezifikation, Prüfung, Muster und Dokumentation. Die folgende Liste hilft, sie vor der Zahlung zu erkennen.</p></div>{steps.map(s => <section class="mt-10"><h2 class="text-2xl font-black text-gray-900 mb-3 tracking-tight scroll-mt-24 flex items-center gap-3"><span class="text-brand-red text-2xl tabular-nums">{s.n}</span>{s.title}</h2><p class="text-gray-700 leading-relaxed mb-3">{s.body}</p><div class="flex flex-wrap gap-2">{s.links.map(l => <a href={l.href} class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 text-gray-700 text-xs font-bold rounded-full">{l.label} →</a>)}</div></section>)}<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6">Häufige Fragen</h2><div class="space-y-4">{faq.map(item => <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>)}</div><div class="mt-12 text-center"><a href="/de/contact/" class="inline-block px-8 py-4 bg-brand-red text-white font-bold rounded-lg">Spezifikation senden</a></div></article></main>
</Layout>
