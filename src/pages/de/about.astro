---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';

const factoryDir = path.join(process.cwd(), 'public', 'assets', 'factory');
const hasAsset = (file) => fs.existsSync(path.join(factoryDir, file));
const plantPhotos = [
  { file: 'plant-exterior.webp', alt: 'Außenansicht der Wanlian-Fluid-Fertigungsstätte in Quanzhou', caption: 'Unsere Fertigungsstätte — Quanzhou, Fujian' },
  { file: 'workshop.webp', alt: 'Werkstattbereich mit Blechbearbeitung und Krananlage', caption: 'Blechbearbeitung und Montage' },
  { file: 'powder-coating.webp', alt: 'Pulverbeschichtungslinie von Wanlian Fluid', caption: 'Pulverbeschichtung und Aushärtung' },
  { file: 'assembly.webp', alt: 'Montagebereich für Brandschutzausrüstung', caption: 'Montage und Endbearbeitung' },
  { file: 'qc-test-bench.webp', alt: 'Prüfstand für Gehäusedruck und Luftleckage', caption: 'Prüfstand für Druck- und Leckageprüfungen' }
].filter(p => hasAsset(p.file));
const factoryEvidence = plantPhotos.length > 0 || hasAsset('business-license.webp') || hasAsset('production-line.mp4');
const heroPhoto = hasAsset('plant-exterior.webp') ? '/assets/factory/plant-exterior.webp' : '/og-image.jpg';
const manufacturingProcess = [
  ['01', 'Wareneingangsprüfung', 'Prüfung von Gusskörpern, Dichtwerkstoffen und Beschichtungen gemäß Auftragsspezifikation.'],
  ['02', 'CNC-Bearbeitung', 'Präzisionsbearbeitung von Armaturengehäusen, Scheiben und Innenteilen nach vorgegebenen Toleranzen.'],
  ['03', 'Montage', 'Montage von Dichtungen, Innenteilen und Betätigungsmechanismen unter kontrollierten Bedingungen.'],
  ['04', 'Druck- und Leckageprüfung', 'Gehäuse-Druckprüfung und Luft-Leckageprüfung an 100 % der Einheiten vor der Endbearbeitung.'],
  ['05', 'Epoxidbeschichtung', 'Ungiftige Epoxidharzbeschichtung für Korrosionsbeständigkeit und lange Lebensdauer.'],
  ['06', 'Exportverpackung', 'Exportgerechte Verpackung, Kennzeichnung und Dokumentation für den internationalen Versand.']
];
const faq = [
  { question: 'Ist Wanlian Fluid Hersteller oder Handelsunternehmen?', answer: 'Wir sind Hersteller mit eigenen Fertigungslinien in Quanzhou, Fujian. Armaturengehäuse werden intern CNC-bearbeitet, Montage und Druckprüfung erfolgen in unserer Werkstatt. Ausgewählte Positionen werden durch qualifizierte Partner gefertigt und auftragsbezogen dokumentiert.' },
  { question: 'Welche Produktlinien werden gefertigt?', answer: 'Unser Sortiment umfasst Industrieventile, Hydranten und Pumpenanschlüsse, Sprinkler- und Alarmventile, Löschmonitore, Feuerlösch-Schlauchhaspeln sowie weitere Komponenten für Wasser-, Industrie- und Brandschutzsysteme.' },
  { question: 'Wie werden Armaturen vor dem Versand geprüft?', answer: 'Jede Einheit wird vor der Endbearbeitung einer Gehäuse-Druckprüfung und einer Luft-Leckageprüfung unterzogen. Prüfprotokolle je Einheit und unabhängige Vorabinspektionen können auf Anfrage bereitgestellt werden.' }
];
---
<Layout locale="de" title="Über uns | Quanzhou Wanlian Fluid Equipment" description="Hersteller von Industriearmaturen und Brandschutzausrüstung in Quanzhou, Fujian. Eigene Fertigung, OEM/ODM und technischer B2B-Service." faq={faq} breadcrumbs={[{ name: 'Über uns' }]}>
  <section class="relative bg-gray-900 text-white overflow-hidden py-20"><div class="absolute inset-0 bg-cover bg-center opacity-20" style={`background-image: url('${heroPhoto}');`}></div><div class="relative max-w-7xl mx-auto px-4 text-center space-y-4"><span class="text-xs font-bold tracking-widest text-blue-500 uppercase">Über uns</span><h1 class="text-3xl sm:text-5xl font-black">Quanzhou Wanlian Fluid</h1><p class="text-lg text-gray-400 max-w-2xl mx-auto">Hersteller und Exporteur von Industriearmaturen und Brandschutzausrüstung mit eigenen Fertigungslinien im chinesischen Armaturencluster.</p></div></section>
  <section class="py-24 bg-white"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-16 items-center"><div class="space-y-6"><span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Unternehmensprofil</span><h2 class="text-3xl font-black text-gray-900">Verwurzelt im Zentrum der Armaturenindustrie</h2><p class="text-gray-600 leading-relaxed">Quanzhou Wanlian Fluid Equipment Co., Ltd. hat seinen Sitz in Quanzhou, Fujian — einem bedeutenden Zentrum der chinesischen Armaturen- und Rohrleitungsindustrie. Wir fertigen und exportieren Armaturen, Brandschutzausrüstung und Lösungen zur Fluidsteuerung für industrielle, kommunale und gebäudetechnische Anwendungen.</p><p class="text-gray-600 leading-relaxed">Unsere Fertigung verbindet erfahrene Ingenieure mit interner CNC-Bearbeitung, Montage und Druckprüfung. Jede Einheit wird vor dem Versand geprüft; die Produktion erfolgt unter einem Qualitätsmanagementsystem nach ISO 9001.</p><p class="text-gray-600 leading-relaxed">Unser Katalog ist nach den Angaben strukturiert, die Planer und Einkäufer tatsächlich benötigen: Druckstufe, Anschlussnorm, Werkstoff, Innenteile und Anwendung.</p><div class="grid grid-cols-2 gap-6 pt-4 border-t"><div><span class="block text-2xl font-black text-blue-600">Industrieventile</span><span class="text-xs text-gray-400 uppercase">Fluidsteuerung</span></div><div><span class="block text-2xl font-black text-blue-600">Brandschutz</span><span class="text-xs text-gray-400 uppercase">Eigene Fertigung</span></div></div></div><div class="rounded-2xl overflow-hidden aspect-video shadow-lg"><img src={heroPhoto} alt="Fertigungsstätte von Wanlian Fluid in Quanzhou" loading="lazy" class="object-cover w-full h-full" /></div></div></section>
  {factoryEvidence && <section class="py-24 bg-gray-50 border-y"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="text-center max-w-3xl mx-auto mb-12"><span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Fertigungsnachweise</span><h2 class="text-3xl font-black text-gray-900 mt-3">Einblick in unsere Fertigung</h2><p class="text-gray-500 mt-3">Fotos, Dokumente und Prüfaufzeichnungen unterstützen Ihre technische und kaufmännische Lieferantenprüfung.</p></div>{plantPhotos.length > 0 && <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{plantPhotos.map(photo => <figure class="bg-white rounded-xl overflow-hidden border"><img src={`/assets/factory/${photo.file}`} alt={photo.alt} loading="lazy" class="w-full" /><figcaption class="p-4 text-sm font-semibold text-gray-700">{photo.caption}</figcaption></figure>)}</div>}<div class="mt-12 bg-white rounded-2xl border p-8"><h3 class="font-bold text-lg text-gray-900">Was Sie anfordern können</h3><ul class="mt-5 grid md:grid-cols-2 gap-3 text-sm text-gray-600"><li>• ISO-9001-Zertifikat mit Geltungsbereich</li><li>• Prüfberichte je Charge oder Einheit</li><li>• Werks- oder Drittinspektion vor Versand</li><li>• OEM/ODM-Kennzeichnung und Exportverpackung</li></ul></div></div></section>}
  <section class="py-24 bg-white"><div class="max-w-7xl mx-auto px-4"><div class="text-center mb-14"><span class="text-sm font-bold tracking-widest text-blue-600 uppercase">Qualitätskontrolle</span><h2 class="text-3xl font-black text-gray-900 mt-3">Unser standardisierter Fertigungsprozess</h2></div><div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">{manufacturingProcess.map(step => <div class="bg-gray-50 p-8 rounded-xl border relative"><span class="text-4xl font-black text-gray-200">{step[0]}</span><h3 class="font-bold text-lg text-gray-900 mt-3">{step[1]}</h3><p class="text-sm text-gray-500 leading-relaxed mt-2">{step[2]}</p></div>)}</div></div></section>
  <section class="py-20 bg-gray-900 text-white text-center"><div class="max-w-3xl mx-auto px-4"><h2 class="text-3xl font-black">Ihr Projekt mit Wanlian Fluid besprechen</h2><p class="text-gray-400 mt-4">Senden Sie uns Ihre technischen Anforderungen. Unser Team unterstützt Sie bei Auswahl, Dokumentation und Exportabwicklung.</p><a href="/de/contact/" class="inline-block mt-7 px-8 py-4 bg-brand-red rounded-lg font-bold">Gespräch beginnen →</a></div></section>
</Layout>
