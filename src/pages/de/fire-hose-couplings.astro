---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Ist jede Schlauchkupplung mit 2.5 Zoll austausbar?',
		answer: 'Nein. Eine Nennweite von 2.5 Zoll oder 65 mm benennt weder das Verriegelungsmuster noch das Gewinde. Storz-, National-, John-Morris-, Nakajima- und Schnellkupplungen erfordern das passende Gegenstück oder einen geprüften Adapter.'
	},
	{
		question: 'Was ist eine Storz-Kupplung?',
		answer: 'Storz ist eine symmetrische Schnellkupplung. Das geprüfte Storz-Produkt ist eine Kupplung aus Aluminium nach deutschem Standard mit 2.5 Zoll, selbstabdichtender Kante, Verbindung durch Vierteldrehung und Widerhaken für den Flachroll-Feuerwehrschlauch.'
	},
	{
		question: 'Wann verwende ich einen Hydranten-Adapter?',
		answer: 'Verwenden Sie einen Adapter, wenn die Norm des Hydrantenabgangs und die Norm von Schlauch oder Strahlrohr voneinander abweichen. Bestätigen Sie beide Schnittstellen, Nennweite, Dichtung und Betriebsdruck; ein Adapter soll eine definierte Abweichung lösen, keinen unsicheren Schlauchplan verdecken.'
	},
	{
		question: 'Welchen Betriebsdruck soll ich angeben?',
		answer: 'Bemessen Sie die komplette Leitung: Hydrant, Kupplung, Schlauch, Strahlrohr und Adapter. Die geprüfte Storz-Kupplung und der Hydrantenschlauch-Adapter HS sind mit 1.6 MPa angegeben; bestätigen Sie die genaue Druckanforderung der gesamten Baugruppe vor der Bestellung.'
	},
	{
		question: 'Aluminium oder Messing wählen?',
		answer: 'Aluminium ist leicht und wird für die Storz- und HS-Kupplungen dieser Baureihe eingesetzt. Die Bestellung muss den geforderten Werkstoff, die Oberfläche, die Dichtung und die Umgebung benennen; bestätigen Sie jede Messing-Option oder Kompatibilitätsanforderung mit dem Angebot.'
	},
	{
		question: 'Was gehört in eine einzige Kupplungsbestellung?',
		answer: 'Geben Sie die Norm mit Namen, die Nennweite, das Gegenstück, Schlauch- oder Gewindeende, Werkstoff, Dichtung, Betriebsdruck, Schlauchlänge und die Schnittstelle des Strahlrohrs an. Ein Muster oder eine Maßzeichnung ist hilfreich, wenn die Norm der örtlichen Feuerwehr nicht eindeutig ist.'
	}
];

const products = [
	{
		slug: 'storz-coupling-2-5inch-aluminum',
		name: 'Aluminum Storz Fire Coupling (2.5" · German Standard)',
		img: '/assets/products/storz-coupling-2-5inch-aluminum-overlay.png',
		desc: 'Deutsches Storz, Aluminium, 1.6 MPa, selbstabdichtend, mit Widerhaken'
	},
	{
		slug: 'fire-hydrant-hose-coupling-adapter-hs',
		name: 'Aluminum Firefighting Hydrant Hose Coupling Adapter (HS Series)',
		img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg',
		desc: 'DN50 / DN65, Innengewinde 2.5 Zoll, 1.6 MPa'
	},
	{
		slug: 'fire-hose-pvc-rubber-lining-8-65',
		name: 'PVC Rubber Lining Layflat Fire Hose (Model 8-65)',
		img: '/assets/products/fire-hose-pvc-rubber-lining-8-65.jpg',
		desc: 'Innendurchmesser 19–400 mm, Kupplungsgröße 65 mm nach Standard'
	},
	{
		slug: 'adjustable-pistol-grip-fire-nozzle',
		name: 'Adjustable Pistol Grip Firefighting Nozzle',
		img: '/assets/products/adjustable-pistol-grip-fire-nozzle.jpg',
		desc: 'Eingang 1.5" / 2" / 2.5", 150–500 LPM, Vollstrahl bis Nebel'
	}
];
---

<Layout
	title="Storz-Kupplung, Schlauchkupplungen, Adapter | WLFE"
	description="Storz-Kupplung, Schlauchkupplung und Hydranten-Adapter für B2B: Normen, Werkstoffe, Betriebsdruck sowie Schlauch- und Strahlrohranschlüsse."
	type="product"
	locale="de"
	productData={{
		name: 'Schlauchkupplungen und Hydranten-Adapter',
		image: '/assets/products/storz-coupling-2-5inch-aluminum-overlay.png',
		description: 'Schlauchkupplungen, Storz-Schnittstellen, Hydrantenschlauch-Adapter, Flachroll-Schläuche und verstellbare Strahlrohre für komplette Feuerwehrleitungen im B2B-Geschäft.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Schlauchkupplungen' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/de/" class="hover:text-blue-600">Startseite</a><span>/</span><a href="/de/products/" class="hover:text-blue-600">Produkte</a><span>/</span><span class="text-gray-600">Schlauchkupplungen</span></nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Schnittstellen der Feuerwehrleitung — Direkt ab Werk</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Auswahl von Storz-Kupplung und Schlauchkupplungen</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Eine Schlauchkupplung ist nur dann korrekt, wenn Norm, Gegenstück, Dichtung, Werkstoff und Druck zum Rest der Leitung passen. Wanlian liefert Storz-Kupplung, Hydranten-Adapter, Flachroll-Schläuche und Strahlrohranschlüsse für Projektkäufer, die einen kompletten Anschlussatz bestellen.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">{['Storz-Schnellkupplung', 'Hydranten-Adapter', 'Schlauch 19–400 mm', 'Strahlrohr 150–500 LPM'].map(b => (<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span></div>))}</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Produkte für Schlauchkupplungen</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">{products.map(p => (<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition"><img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" /><div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p><p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p></div></a>))}</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Normen und Auswahltabelle für Kupplungen</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5"><table class="min-w-full divide-y divide-gray-200 text-sm"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Auswahlpunkt</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Was zu bestätigen ist</th></tr></thead><tbody class="bg-white divide-y divide-gray-200">
				<tr><td class="px-4 py-3 font-bold text-gray-900">Storz</td><td class="px-4 py-3 text-gray-700">Deutsche Storz-Schnellkupplung; das geprüfte Produkt ist 2.5 Zoll mit Korpus aus Aluminium, selbstabdichtender Kante, Widerhaken und 1.6 MPa Druck.</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">National / John Morris / Nakajima / Schnellkupplung</td><td class="px-4 py-3 text-gray-700">Behandeln Sie jeden Typ als eigene Schnittstelle. Bestätigen Sie das Muster der örtlichen Feuerwehr und verwenden Sie eine geprüfte passende Kupplung oder einen Adapter, statt anzunehmen, dass die Nennweite genügt.</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Hydranten-Adapter</td><td class="px-4 py-3 text-gray-700">HS-Baureihe: Größenbereich DN50 / DN65, Innengewinde 2.5 Zoll, eloxierte Aluminiumlegierung und 1.6 MPa Betriebsdruck.</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Schlauch</td><td class="px-4 py-3 text-gray-700">Modell 8-65 PVC-Schlauch mit Gummierung: Innendurchmesser 19–400 mm, Kupplungsgröße 65 mm; bestätigen Sie Länge, Durchmesser und Kupplungsenden.</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Strahlrohr</td><td class="px-4 py-3 text-gray-700">Verstellbares Strahlrohr mit Pistolengriff: Eingang 1.5", 2" oder 2.5", Aluminiumlegierung, 150–500 LPM und Vollstrahl bis Nebel.</td></tr>
			</tbody></table></div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Was in eine einzige Kupplungsbestellung gehört</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2"><li><strong>Norm und Gegenstück</strong> — Storz, National, John Morris, Nakajima oder Schnellkupplung, für beide Enden ausdrücklich benannt.</li><li><strong>Größe und Ausführung der Enden</strong> — Schlauch-Nennweite, Kupplungsgröße, Gewinde- oder Schlauchende und ob die Kupplung lose oder werksseitig montiert ist.</li><li><strong>Werkstoff und Dichtung</strong> — Aluminium oder ein anderer spezifizierter Werkstoff, Oberfläche, Dichtung und Betriebsmedium wie Klarwasser oder Schaumgemisch.</li><li><strong>Passende Gesamtleitung</strong> — Schlauch, Adapter, Strahlrohr, Betriebsdruck, Länge und Schnittstelle der Feuerwehr am Zielort.</li></ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Unterlagen zu Schlauchkupplungen</h2>
			<p class="text-gray-700 leading-relaxed">Lesen Sie die <a href="/de/guides/fire-hose-buying-guide/" class="text-brand-blue font-semibold hover:underline">Richtlinie für den Kauf von Feuerwehrschläuchen</a>, die <a href="/de/guides/how-to-choose-a-fire-hydrant/" class="text-brand-blue font-semibold hover:underline">Auswahlrichtlinie für Hydranten</a> und die <a href="/de/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">Normenrichtlinie für Hydrantenarmaturen</a>, bevor Sie einen Kupplungsplan freigeben.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Häufig gestellte Fragen</h2><div class="space-y-4">{faq.map(item => (<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>))}</div>

			<div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white tracking-tight">Brauchen Sie einen passenden Schlauchkupplungs-Satz?</h2><p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Senden Sie die örtliche Kupplungsnorm, die Schlauchgröße und die Strahlrohrschnittstelle — wir bestätigen das passende Paket und antworten mit einem Angebot innerhalb von 12 Stunden.</p><div class="mt-6 flex flex-col sm:flex-row justify-center gap-4"><a href="/de/contact/?product=Schlauchkupplungen" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Angebot anfordern</a><a href="https://wa.me/8618684324501?text=Hallo%2C%20ich%20brauche%20Schlauchkupplungen" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Auf WhatsApp chatten</a></div></div></div>
		</article>
	</main>
</Layout>
