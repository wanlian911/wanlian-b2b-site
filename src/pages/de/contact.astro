---
import Layout from '../../layouts/Layout.astro';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';
const productName = Astro.url.searchParams.get('product') || '';
const whatsappText = encodeURIComponent('Guten Tag, ich interessiere mich für Industriearmaturen oder Brandschutzausrüstung von Wanlian Fluid. Bitte senden Sie mir ein Angebot.');
---
<Layout locale="de" title="Kontakt und B2B-Angebot | Quanzhou Wanlian Fluid" description="Fordern Sie ein B2B-Angebot für Industriearmaturen und Brandschutzausrüstung an. Senden Sie Spezifikationen und Zeichnungen — Antwort innerhalb von 12 Stunden.">
  <main id="inquiry" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 mb-20"><div class="text-center mb-16 space-y-4"><span class="text-xs font-bold tracking-widest text-blue-600 uppercase">Kontakt und Anfrage</span><h1 class="text-4xl font-black text-gray-900">Professionelles Angebot anfordern</h1><p class="text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">Teilen Sie Produktanforderungen, Normen, Nennweiten und Anwendung mit. Unser Vertriebs- und Ingenieurteam prüft die Angaben und meldet sich mit den nächsten Schritten.</p></div><div class="grid lg:grid-cols-3 gap-16"><div class="space-y-8"><div><h2 class="text-xs font-bold text-gray-400 tracking-widest uppercase mb-2">Unternehmensstandort</h2><p class="text-lg font-bold text-gray-900">Quanzhou Wanlian Fluid Equipment Co., Ltd.</p><p class="text-gray-500 mt-2 text-sm">Quanzhou, Provinz Fujian, China</p></div><div><h2 class="text-xs font-bold text-gray-400 tracking-widest uppercase mb-3">Direkte Kontaktwege</h2><ul class="space-y-3 text-sm text-gray-600"><li><strong class="text-gray-900">E-Mail: </strong><a href="mailto:sales@wanlian911.com" class="text-blue-600 hover:underline">sales@wanlian911.com</a></li><li><strong class="text-gray-900">Telefon: </strong><a href="tel:+8618684324501" class="text-blue-600 hover:underline">+86 186 8432 4501</a></li><li><strong class="text-gray-900">WhatsApp: </strong><a href={`https://wa.me/8618684324501?text=${whatsappText}`} target="_blank" rel="noopener noreferrer" class="text-green-600 font-bold hover:underline">Nachricht senden</a></li></ul></div><div class="bg-blue-50/50 p-8 rounded-xl border border-blue-100/50"><h2 class="font-bold text-blue-900">Warum Wanlian Fluid?</h2><ul class="mt-4 space-y-3 text-sm text-blue-700"><li>✓ Unterstützung bei Produktauswahl und Fluidtechnik</li><li>✓ OEM/ODM-Anforderungen besprechbar</li><li>✓ Produktdokumentation und Spezifikationssupport</li><li>✓ Koordination von Exportverpackung und Versand</li></ul></div></div><div class="lg:col-span-2 bg-white p-10 rounded-2xl border shadow-sm"><h2 class="text-xl font-bold text-gray-900 mb-6">RFQ / Anfrageformular senden</h2><InquiryForm productName={productName} /></div></div></main>
</Layout>
