---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Was ist der Unterschied zwischen einem Rückflussverhinderer und einem Rückschlagventil?',
		answer: 'Ein herkömmliches Rückschlagventil verhindert den Rückfluss mechanisch, ist jedoch nicht auf Dichtheit geprüft und besitzt keine Zwischenentleerung. Ein Rückflussverhinderer wie der HS41X kombiniert zwei unabhängige Rückschlagstufen mit einer automatisch entleerenden Zwischenkammer, ist vor Ort prüfbar und erfüllt die Anforderungen an die Sicherung von Trinkwasser gegen Kreuzverbindungen. Rückschlagventile allein sind an Trinkwasser-Kreuzverbindungen nicht zulässig.'
	},
	{
		question: 'Wo sollte der Rückflussverhinderer in einem Feuerlöschanschluss installiert werden?',
		answer: 'Am Feuerlöschanschluss zur Trinkwasser-Hauptleitung, vor der Saugseite der Feuerlöschpumpe oder vor dem Steigstrang. Das Bauteil muss für Prüfungen zugänglich, frostsicher geschützt und mit seinem Druckverlust in der hydraulischen Berechnung der Feuerlöschpumpe berücksichtigt werden. Bei Hochhäusern ist zu prüfen, dass der Nenndruck des Geräts dem maximalen statischen Versorgungsdruck entspricht.'
	},
	{
		question: 'Benötigen hydraulische Regelventile elektrische Energie für den Betrieb?',
		answer: 'Die meisten hydraulischen Regelventile – das Druckminderventil 500X, das Wasserstandsregelventil F745X und der Rückflussverhinderer HS41X – arbeiten vollständig selbsttätig mit dem Leitungsdruck und benötigen keine externe Energieversorgung. Magnetventilgesteuerte Modelle wie GKZF-1 verwenden AC220V oder DC24V für die Fernautomation.'
	},
	{
		question: 'Welche Werkstoffe werden für Trinkwasseranwendungen eingesetzt?',
		answer: 'Für Trinkwassernetze verwendet der Rückflussverhinderer HS41X ein Gehäuse aus Sphäroguss, EPDM-Dichtungen und Innenteile aus Edelstahl 304 gemäß den hygienischen Anforderungen nach GB/T17219. Bitte bestätigen Sie das für Ihren Markt erforderliche Hygienezertifikat; unsere Ingenieure stellen das Dokumentationspaket zusammen mit der Bestellung bereit.'
	},
	{
		question: 'Können Sie ein vollständiges hydraulisches Ventilpaket für einen Pumpenraum liefern?',
		answer: 'Ja. Wir fertigen Rückflussverhinderer, Druckminderventile, Wasserstandsregelventile, Magnetventil-Regelventile, Saugschirme und Y-Schmutzfänger und liefern sie als abgestimmtes Paket – mit passenden Druckstufen, Werkstoffausführungen und Prüfberichten aus einer einzigen Fertigung.'
	}
];

const hydraulicProducts = [
	{
		slug: 'anti-pollution-backflow-preventer-hs41x',
		name: 'Rückflussverhinderer gegen Verunreinigung (HS41X-16)',
		img: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		desc: 'Doppelrückschlagstufe mit Zwischenentleerung, DN50–DN600'
	},
	{
		slug: 'adjustable-pressure-reducing-valve-500x',
		name: 'Hydraulisches Druckminderventil (500X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'Selbsttätige Pilotsteuerung, Einstellbereich 0,1–1,6 MPa'
	},
	{
		slug: 'hydraulic-water-level-control-valve-f745x',
		name: 'Hydraulisches Wasserstandsregelventil (F745X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.webp',
		desc: 'Schwimmergesteuerte Wasserstandsregelung für Behälter und Tanks'
	},
	{
		slug: 'groove-solenoid-control-gate-valve-gkzf1',
		name: 'Magnetventilgesteuerter Absperrschieber (GKZF-1)',
		img: '/assets/products/groove-solenoid-control-gate-valve-gkzf1.jpg',
		desc: 'Gesteuertes Nutventil DC24V/AC220V, Nenndruck 300 PSI'
	},
	{
		slug: 'suction-vortex-preventer-en12845',
		name: 'Saugschirm gegen Wirbelbildung (EN12845)',
		img: '/assets/02_valves_parts/valves_p21.webp',
		desc: 'SS304/316, verhindert Pumpenkavitation, Entleerungstiefe 100 mm'
	}
];

const trustBadges = ['Doppelrückschlagstufe + Entleerung', 'PN10–PN25', 'Hygiene nach GB/T17219', 'Selbsttätige Pilotsteuerung'];
---

<Layout
	locale="de"
	title="Rückflussverhinderer & hydraulische Regelventile – WLFE"
	description="Rückflussverhinderer (HS41X), Druckminder- (500X), Wasserstandsregel- (F745X) und Magnetventile für Trinkwasser- und Feuerlöschanlagen. DN50–DN600 direkt ab Werk."
	type="product"
	productData={{
		name: 'Rückflussverhinderung & hydraulische Regelung',
		image: '/assets/products/anti-pollution-backflow-preventer-hs41x.webp',
		description: 'Rückflussverhinderer und hydraulische Regelventile zum Schutz von Trinkwasser, zur Druckregelung und für automatisierte Wassernetze, gefertigt von Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Rückflussverhinderung' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/de/" class="hover:text-blue-600">Startseite</a>
			<span>/</span>
			<a href="/de/products/" class="hover:text-blue-600">Produkte</a>
			<span>/</span>
			<span class="text-gray-600">Rückflussverhinderung</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Trinkwasserschutz &amp; hydraulische Regelung</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Rückflussverhinderer &amp; hydraulische Regelventile</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid fertigt das vollständige Sortiment für hydraulische Sicherheit – Rückflussverhinderer HS41X gegen Verunreinigung, Druckminderventile 500X, Wasserstandsregelventile F745X und Magnetventil-Regelventile GKZF-1 – zum Schutz von Trinkwassernetzen sowie zur automatisierten Druck- und Wasserstandsregelung aus einer abgestimmten Lieferung.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Sortiment hydraulischer Sicherheitsventile</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydraulicProducts.map(p => (
					<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Wichtige technische Daten</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50"><tr>
						<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Ventil</th>
						<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Funktion</th>
						<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Nennweite</th>
						<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Druckstufe</th>
					</tr></thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">HS41X</td><td class="px-4 py-3 text-gray-700">Rückflussverhinderung gegen Verunreinigung</td><td class="px-4 py-3 text-gray-700">DN50–DN600</td><td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">500X</td><td class="px-4 py-3 text-gray-700">Druckminderung / Druckhaltung</td><td class="px-4 py-3 text-gray-700">DN20–DN600</td><td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">F745X</td><td class="px-4 py-3 text-gray-700">Wasserstandsregelung</td><td class="px-4 py-3 text-gray-700">DN50–DN400</td><td class="px-4 py-3 text-gray-700">PN10 / PN16</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">GKZF-1</td><td class="px-4 py-3 text-gray-700">Magnetventilgesteuertes Öffnen/Schließen</td><td class="px-4 py-3 text-gray-700">DN50–DN300</td><td class="px-4 py-3 text-gray-700">300 PSI, AC220V/DC24V</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Saugschirm</td><td class="px-4 py-3 text-gray-700">Schutz der Pumpensaugseite</td><td class="px-4 py-3 text-gray-700">DN50–DN1000</td><td class="px-4 py-3 text-gray-700">EN12845 / GB50974</td></tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Anwendungen</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Sicherung von Trinkwasser-Kreuzverbindungen (Feuerlöschleitungen, Bewässerung, Kesselanlagen)</li>
				<li>Wasserstandsregelung in Vorratsbehältern und Dachbehältern</li>
				<li>Druckzonenregelung in kommunalen Netzen und Gebäudeinstallationen</li>
				<li>Automatisierte Wassernetze mit fernbetätigten Ventilen</li>
				<li>Schutz der Pumpensaugseite in Vorratsbehältern und Tanks</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Häufig gestellte Fragen</h2>
			<div class="space-y-4">{faq.map(item => (
				<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
					<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary>
					<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
				</details>
			))}</div>

			<div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
				<h2 class="text-2xl font-black text-white tracking-tight">Benötigen Sie ein hydraulisches Ventilpaket für Ihr Netz?</h2>
				<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Senden Sie uns DN, Druckstufe und Anschlussart – unsere Ingenieure antworten innerhalb von 12 Stunden mit Druckverlustkurven, Datenblättern und einem Paketangebot.</p>
				<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
					<a href="/de/contact/?product=Rückflussverhinderung%20%26%20hydraulische%20Regelung" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Angebot anfordern</a>
					<a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Guten Tag, ich benötige Unterstützung bei der Auswahl hydraulischer Regelventile.')}`} class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Über WhatsApp chatten</a>
				</div>
			</div></div>
		</article>
	</main>
</Layout>
