---
import Layout from '../../../layouts/Layout.astro';
const groups = [{ title: 'Ventile und Komponenten', terms: [{ term: 'Absperrschieber', definition: 'Absperrarmatur mit Keil zum Unterbrechen des Durchflusses in Wasser- und Brandschutznetzen.' }, { term: 'Absperrklappe', definition: 'Vierteldreharmatur mit Klappenscheibe zur Regelung und Absperrung von Rohrleitungen.' }, { term: 'Rückschlagventil', definition: 'Ventil, das den Durchfluss in eine Richtung zulässt und den Rückfluss verhindert.' }, { term: 'Druckminderventil', definition: 'Ventil, das den Eingangsdruck automatisch auf einen stabilen Ausgangsdruck reduziert.' }, { term: 'Rückflussverhinderer', definition: 'Einrichtung zum Schutz des Trinkwassers vor Verunreinigung durch Rückfluss an einer Kreuzverbindung.' }, { term: 'Faltenbalg-Absperrschieber', definition: 'Absperrschieber mit Faltenbalg zur leckagearmen Abdichtung der Spindel, etwa für Dampf und Thermalöl.' }] }, { title: 'Hydranten und Anschlüsse', terms: [{ term: 'Überflurhydrant', definition: 'Oberhalb des Geländeniveaus installierter Hydrant für kommunale und industrielle Wassernetze.' }, { term: 'Unterflurhydrant', definition: 'Unter dem Geländeniveau installierter Hydrant mit geschütztem Zugangsschacht.' }, { term: 'Wandhydrantenventil', definition: 'Ventil beziehungsweise Hydrantenkopf für einen Wandhydranten, beispielsweise SN65 DN65.' }, { term: 'Feuerwehr-Einspeisung (FDC)', definition: 'Anschluss, über den die Feuerwehr Wasser in ein Sprinklersystem oder Brandschutznetz einspeist.' }] }, { title: 'Sprinkler und Löschtechnik', terms: [{ term: 'Sprinklerkopf', definition: 'Auslöseeinrichtung, die Wasser abgibt, sobald das thermische Element seine Auslösetemperatur erreicht.' }, { term: 'Sprinklersystem', definition: 'Rohrleitungsnetz aus Ventilen und Sprinklerköpfen zum automatischen Brandschutz.' }, { term: 'Vorgesteuertes Trockensystem', definition: 'Normalerweise trockenes Rohrleitungssystem, das unabhängige Signale benötigt, bevor Wasser freigegeben wird.' }, { term: 'Nassalarmventil', definition: 'Alarmventilstation für dauerhaft wassergefüllte Sprinkleranlagen.' }, { term: 'Sprühflutventil', definition: 'Ventil zur Freigabe eines Sprühflutsystems, dessen Auslässe offen oder vorgesteuert sein können.' }, { term: 'Löschmonitor', definition: 'Manuell oder automatisch ausrichtbare Löschkanone für die Abgabe großer Wassermengen.' }] }, { title: 'Normen, Prüfung und Einkauf', terms: [{ term: 'Nenndruck (PN)', definition: 'Referenzdruckstufe einer Armatur, beispielsweise PN16, für die Auslegung und Prüfung.' }, { term: 'Nennweite (DN)', definition: 'Normierte Größenbezeichnung einer Rohrleitung oder Armatur, beispielsweise DN50 oder DN65.' }, { term: 'Stückprüfung', definition: 'Prüfung jeder einzelnen Einheit, typischerweise einschließlich Gehäuse- und Dichtheitsprüfung.' }, { term: 'Incoterm', definition: 'International vereinbarte Lieferklausel zur Verteilung von Kosten, Aufgaben und Risiken zwischen Verkäufer und Käufer.' }] }];
---
<Layout title="Glossar für Ventile und Brandschutz" description="Technisches Glossar zu Absperrschiebern, Hydranten, Sprinklern, Zertifizierungen, Prüfungen und B2B-Einkauf." type="website" locale="de" breadcrumbs={[{ name: 'Glossar' }]}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/de/">Startseite</a><span>/</span><span class="text-gray-600">Glossar</span></nav><article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Technische Referenz</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Glossar für Ventile und Brandschutz</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Präzise Definitionen für Spezifikationen, Ausschreibungen, Datenblätter und den B2B-Einkauf von Ventilen, Hydranten, Sprinklern und Brandschutzausrüstung.</p><div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-8">{groups.map(g => <a href={`#${g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="px-4 py-3 bg-gray-50 border border-gray-100 rounded-xl text-xs font-bold text-brand-blue text-center">{g.title}</a>)}</div>{groups.map(g => <section class="mt-12"><h2 id={g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')} class="text-2xl font-black text-gray-900 mb-5 tracking-tight">{g.title}</h2><div class="space-y-4">{g.terms.map(t => <div class="bg-gray-50 rounded-xl border border-gray-100 p-5"><h3 class="text-lg font-black text-gray-900">{t.term}</h3><p class="mt-2 text-gray-700 leading-relaxed text-sm">{t.definition}</p></div>)}</div></section>)}<div class="mt-12 bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center rounded-2xl"><h2 class="text-2xl font-black text-white">Bereit für die Spezifikation?</h2><p class="mt-3 text-blue-100">Senden Sie Mengen und Zielort, um ein detailliertes Angebot zu erhalten.</p><a href="/de/contact/" class="inline-block mt-6 px-8 py-4 bg-brand-red text-white font-bold rounded-lg">Angebot anfordern</a></div></article></main>
</Layout>
