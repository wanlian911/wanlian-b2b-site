---
import Layout from '../../layouts/Layout.astro';
import { productsDe } from '../../utils/products.de';
import { guidesDe } from '../../utils/guides.de';
import InquiryForm from '../../components/inquiry/InquiryForm.astro';
import LeadCaptureSection from '../../components/inquiry/LeadCaptureSection.astro';
import CompanyIntroVideo from '../../components/sections/CompanyIntroVideo.astro';
import VideoCarousel from '../../components/sections/VideoCarousel.astro';

const faq = [
  { question: 'Was fertigt und exportiert Wanlian Fluid?', answer: 'Wanlian Fluid ist ein Hersteller und Exporteur aus Quanzhou für Industriearmaturen und Brandschutzausrüstung: Absperrschieber, Absperrklappen, Rückschlagventile, Hydranten, Sprinkler- und Alarmventile sowie feuerbeständige Schläuche.' },
  { question: 'Wie erhalte ich den Preis einer Armatur oder eines Hydranten?', answer: 'Der Preis wird auf Anfrage erstellt. Bitte senden Sie Modell oder Norm, Nennweite, Druckstufe, Werkstoff, Menge und Bestimmungsort. Unser Team erstellt innerhalb von 12 Stunden ein detailliertes Angebot.' },
  { question: 'Wird jedes Produkt vor dem Versand geprüft?', answer: 'Ja. Jede Armatur und jeder Hydrant wird vor dem Versand einer Gehäuse-Druckprüfung und einer Luft-Leckageprüfung unterzogen. Die Fertigung erfolgt unter einem Qualitätsmanagementsystem nach ISO 9001.' },
  { question: 'Sind OEM-, ODM- und Eigenmarkenaufträge möglich?', answer: 'Ja. OEM/ODM, kundenspezifische Kennzeichnung und Exportverpackung gehören zu unserem Standardservice. Die Konformität mit AWWA-, EN-, UL- oder FM-Anforderungen wird je Modell bestätigt.' }
];

const featuredProducts = productsDe.filter(p => [
  'resilient-seat-flanged-gate-valve-z41x', 'indoor-fire-hydrant-head-sn65', 'wet-alarm-check-valve-zsfz-150',
  'signal-grooved-wafer-butterfly-valve-dn80', 'spherical-ball-check-valve-hq44x', 'hydraulic-water-level-control-valve-f745x',
  'telescopic-y-strainer-sgl41h', 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100'
].includes(p.slug));

// Kategorienamen und -zahlen werden aus productsDe abgeleitet statt hartcodiert: die
// Kartenwerte müssen mit den data-category-Werten von /de/products/ übereinstimmen, sonst
// läuft der #category-Deeplink ins Leere. Bilder stammen aus dem image-Feld echter Produkte
// derselben Kategorie, es wird kein neuer Pfad erfunden.
const CARD_LEAD_SLUGS = [
  'resilient-seat-flanged-gate-valve-z41x',
  'indoor-fire-hydrant-head-sn65',
  'wet-alarm-check-valve-zsfz-150',
  'hydraulic-water-level-control-valve-f745x',
  'manual-fire-water-cannon-ps',
  'foam-fire-hydrant-cabinet-psg30',
];
const categoryNames: string[] = [...new Set(productsDe.map((p) => p.category))];
const categories = categoryNames.map((name) => {
  const inCategory = productsDe.filter((p) => p.category === name);
  const lead = inCategory.find((p) => CARD_LEAD_SLUGS.includes(p.slug)) ?? inCategory[0];
  return { name, count: String(inCategory.length), image: lead.image };
});

const catalogByCategory = categories.map((cat) => ({
  name: cat.name,
  items: productsDe.filter((p) => p.category === cat.name)
}));

// Die sechs Einträge entsprechen wörtlich der Liste auf /de/certificates/ (Name und Norm).
// Deren Geltungsbereich ist modellbezogen formuliert, daher darf der Streifen nicht als
// uneingeschränkte Zusage gelesen werden.
const certifications = [
  { name: 'UL-gelistet', code: 'UL 262 / UL 1091' },
  { name: 'FM-zugelassen', code: 'Class 1120/1130' },
  { name: 'CE-Kennzeichnung', code: 'EN 12266-1' },
  { name: 'ISO 9001:2015', code: 'Qualitätsmanagement' },
  { name: 'LPCB-Zertifizierung', code: 'RedBook-Listung' },
  { name: 'Chinesische GB-Normen', code: 'GB 5135 / GB 4452' }
];

// Reale Montage-Dokumentation eines Brandschutz-Pumpenraums; identische Assets und
// identischer Aussageumfang wie die englische und spanische Startseite.
const projectPhotos = [
  { src: '/assets/projects/pump-skids.webp', alt: 'Reihe von Sprinkler- und Feuerlöschpumpen mit OPEN- und CLOSE-Positionsschildern in einem installierten Brandschutz-Pumpenraum', caption: 'Pumpen-Skids mit OPEN/CLOSE-Kennzeichnung' },
  { src: '/assets/projects/valve-train.webp', alt: 'Reihe von Absperrschiebern und Manometern an roten Steigsträngen im installierten Brandschutz-Pumpenraum', caption: 'Steigstränge und Schieber-Reihe' },
  { src: '/assets/projects/riser-grid.webp', alt: 'Steigstrangnetz mit Überkopf-Kanälen und Kabeltrassen im installierten Brandschutz-Pumpenraum', caption: 'Steigstrangnetz und Deckenkanäle' },
  { src: '/assets/projects/pump-room-final.webp', alt: 'Installierter Brandschutz-Pumpenraum, bereit für Abnahme und Übergabe', caption: 'Pumpenraum bereit für die Übergabe' },
];

const projectScope = [
  'Mehrere Sprinkler- und Feuerlöschpumpen auf Betonsockeln installiert',
  'Vollständiges Steigstrangnetz mit Absperrschiebern, Manometern und OPEN/CLOSE-Kennzeichnung',
  'Deckenkanäle und Kabeltrassen entlang des Steigstrangnetzes geführt',
  'Anlage bereit für die Schlussabnahme und Übergabe',
];

const productionSteps = [
  { step: '01', title: 'Präzisionsfertigung', desc: 'CNC-Bearbeitung von Armaturengehäusen und Komponenten mit engen Toleranzen.' },
  { step: '02', title: 'Montage', desc: 'Kontrollierte Montage von Dichtungen, Betätigungselementen und Innenteilen.' },
  { step: '03', title: 'Druckprüfung', desc: 'Gehäuse- und Sitzprüfung an 100 % der Einheiten vor der Endbearbeitung.' },
  { step: '04', title: 'Epoxidbeschichtung', desc: 'Ungiftige Epoxidharzbeschichtung für hohe Korrosionsbeständigkeit.' }
];

const resources = [
  { href: '/de/applications/', title: 'Anwendungen und Branchen', desc: 'Armaturen und Brandschutzlösungen für Wasserwerke, Industrie, Gebäude und Prozessanlagen.' },
  { href: '/de/certificates/', title: 'Technische Dokumentation', desc: 'Zertifikate, Prüfberichte, Werkstoffoptionen und Exportdokumente auf Anfrage.' },
  ...guidesDe.map(g => ({ href: g.href.replace(/^\/[^/]+\//, '/de/'), title: g.title, desc: g.description }))
];

const visibleResources = resources.slice(0, 6);
const moreResources = resources.slice(6);
const industries = [
  { name: 'Wasser- und Abwassertechnik', desc: 'Zuverlässige Armaturen für kommunale Netze und Pumpstationen.' },
  { name: 'Industrielle Prozessanlagen', desc: 'Druckbeständige Ventile und Schmutzfänger für kritische Medien.' },
  { name: 'Brandschutz', desc: 'Hydranten, Sprinklerarmaturen und Löschsysteme für sichere Anlagen.' }
];
---

<Layout locale="de" title="Wanlian Fluid | Industriearmaturen und Brandschutz" description="Hersteller von Industriearmaturen, Hydranten und Brandschutzausrüstung in Quanzhou. ISO 9001, CNC-Bearbeitung und detailliertes Angebot innerhalb von 12 Stunden." faq={faq} breadcrumbs={[{ name: 'Startseite', href: '/de/' }]} video={{ name: 'Wanlian Fluid in 50 Sekunden', description: 'Unternehmensvideo mit Ausstellungsraum, Fertigung, OEM-Service und Qualitätskontrolle.', thumbnail: '/videos/company-intro-poster.webp', src: '/videos/company-intro.mp4', duration: 'PT49S', uploadDate: '2026-09-18' }}>
  <section class="relative bg-gray-900 text-white min-h-[85vh] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0" aria-hidden="true"><img src="/og-image.jpg" alt="" fetchpriority="high" class="w-full h-full object-cover object-center opacity-90 hero-kenburns" /><div class="absolute inset-0 bg-gradient-to-r from-gray-950 via-gray-950/75 to-gray-950/15"></div></div>
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20"><div class="max-w-3xl space-y-7">
      <span class="inline-flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full border border-white/20 text-sm font-bold tracking-widest uppercase"><span class="h-2 w-2 rounded-full bg-brand-red"></span>Hersteller &amp; Exporteur — Industriearmaturen &amp; Brandschutz</span>
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight leading-tight">Armaturen und <span class="text-brand-red">Brandschutzlösungen</span> für globale Projekte.</h1>
      <p class="text-lg sm:text-xl text-gray-300 max-w-2xl leading-relaxed">Industrieventile, Hydranten sowie Sprinkler- und Alarmventile — 100 % Druckprüfung, ISO 9001 und detaillierte Angebote innerhalb von 12 Stunden.</p>
      <div class="flex flex-wrap gap-4 pt-4"><a href="/de/products/" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg">Katalog ansehen</a><a href="/de/contact/#inquiry" class="px-8 py-4 bg-white/10 text-white font-bold rounded-lg border border-white/30">Angebot anfordern</a></div>
    </div></div>
  </section>
  <VideoCarousel locale="de" />
  <section class="py-10 bg-white border-b border-gray-200"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-px bg-gray-200 border border-gray-200 rounded-xl overflow-hidden">{certifications.map(cert => <div class="bg-white px-4 py-5 text-center"><p class="text-sm font-black text-gray-900 tracking-tight leading-tight">{cert.name}</p><p class="mt-1 text-[11px] font-bold text-brand-blue uppercase tracking-widest">{cert.code}</p></div>)}</div><div class="mt-4 flex flex-wrap items-center justify-between gap-3"><p class="text-xs text-gray-500 leading-relaxed max-w-2xl">Listung und Zulassung gelten modellbezogen. Zertifikatskopien und die gelisteten Modelle werden vor der Bestellung anhand Ihrer Spezifikation abgeglichen.</p><a href="/de/certificates/" class="inline-flex items-center gap-2 text-sm font-bold text-brand-blue hover:underline shrink-0">Zertifikate und Geltungsbereich <span aria-hidden="true">→</span></a></div></div></section>
  <section class="py-20 bg-white"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="grid lg:grid-cols-2 gap-16 items-center"><div class="space-y-6"><span class="text-sm font-black tracking-[0.3em] text-brand-red uppercase">Unternehmensprofil</span><h2 class="text-4xl font-black text-gray-900">Fluidtechnik für <span class="text-brand-blue">globale Projekte.</span></h2><p class="text-lg text-gray-600 leading-relaxed">Quanzhou Wanlian Fluid Equipment Co., Ltd. fertigt und exportiert Industriearmaturen, Hydranten und Brandschutzausrüstung für internationale B2B-Projekte. Unsere eigene Fertigung in Quanzhou umfasst CNC-Bearbeitung, Montage und Druckprüfung; ausgewählte Positionen werden durch qualifizierte Fertigungspartner ergänzt.</p><p class="text-lg text-gray-600 leading-relaxed">Jede Produktseite ist nach den Anforderungen von Planern aufgebaut: Druckstufe, Anschlussnorm, Werkstoff und Anwendung. Unsere Ingenieure unterstützen die Auswahl und erstellen Angebote auf Anfrage.</p><div class="grid grid-cols-2 lg:grid-cols-4 gap-4 pt-4"><div class="p-5 bg-gray-50 rounded-xl border border-gray-100"><span class="block text-3xl font-black text-brand-red tabular-nums">{productsDe.length}</span><span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Modelle im Katalog</span></div><div class="p-5 bg-gray-50 rounded-xl border border-gray-100"><span class="block text-3xl font-black text-brand-blue tabular-nums">{categories.length}</span><span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Produktlinien</span></div><div class="p-5 bg-gray-50 rounded-xl border border-gray-100"><span class="block text-3xl font-black text-brand-red tabular-nums">100 %</span><span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Druckprüfung</span></div><div class="p-5 bg-gray-50 rounded-xl border border-gray-100"><span class="block text-3xl font-black text-brand-blue">ISO 9001</span><span class="text-[11px] font-bold text-gray-500 uppercase tracking-widest">Qualitätssystem</span></div></div>
  <section class="py-20 bg-gray-50 border-y border-gray-200"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="text-center max-w-3xl mx-auto mb-14 space-y-4"><h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Ihre Vorteile</h2><h3 class="text-4xl font-black text-gray-900 tracking-tight">Warum <span class="text-brand-red">Wanlian Fluid</span></h3></div><div class="grid md:grid-cols-3 gap-8"><div class="p-8 rounded-2xl border border-gray-200 bg-white hover:shadow-lg transition-shadow duration-300"><h4 class="text-lg font-black text-gray-900 mb-2">Eigene Fertigung in Quanzhou</h4><p class="text-gray-600 text-sm leading-relaxed">CNC-Bearbeitung, Montage und Druckprüfung laufen im eigenen Werk; ausgewählte Positionen werden durch qualifizierte Fertigungspartner ergänzt.</p></div><div class="p-8 rounded-2xl border border-gray-200 bg-white hover:shadow-lg transition-shadow duration-300"><h4 class="text-lg font-black text-gray-900 mb-2">Geprüfte Qualität</h4><p class="text-gray-600 text-sm leading-relaxed">Jede Armatur und jeder Hydrant wird vor dem Versand einer Gehäuse-Druckprüfung und einer Luft-Leckageprüfung unterzogen; Fertigung nach ISO 9001.</p></div><div class="p-8 rounded-2xl border border-gray-200 bg-white hover:shadow-lg transition-shadow duration-300"><h4 class="text-lg font-black text-gray-900 mb-2">Angebot in 12 Stunden</h4><p class="text-gray-600 text-sm leading-relaxed">Modell oder Norm, Nennweite, Druckstufe, Werkstoff, Menge und Bestimmungsort genügen; das detaillierte Angebot folgt innerhalb von 12 Stunden.</p></div></div></div></section>
<a href="/de/about/" class="font-bold text-brand-blue hover:underline">Vollständiges Unternehmensprofil lesen →</a></div><div><CompanyIntroVideo locale="de" /></div></div></div></section>
  <section class="py-20 bg-gray-50 border-y border-gray-200"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="text-center mb-14"><h2 class="text-4xl font-black text-gray-900">Unsere Produktkategorien</h2><p class="mt-4 text-gray-500">Präzisionstechnik für Wasser-, Industrie- und Brandschutzsysteme.</p></div><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">{categories.map(cat => <a href={`/de/products/#category=${encodeURIComponent(cat.name)}`} class="group bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-xl"><div class="aspect-[4/3] p-6 flex items-center justify-center bg-gray-50"><img src={cat.image} alt={cat.name} loading="lazy" class="max-w-full max-h-full object-contain group-hover:scale-105 transition" /></div><div class="p-6 flex justify-between font-black"><span>{cat.name}</span><span>→</span></div></a>)}</div></div></section>
  <section class="py-20 bg-white"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="flex flex-col lg:flex-row gap-14 items-center"><div class="lg:w-1/3"><span class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Fertigungsablauf</span><h2 class="text-4xl font-black text-gray-900 mt-4">Unser Herstellungsprozess</h2><p class="text-gray-500 mt-5">Jede Einheit durchläuft eine kontrollierte Abfolge von der Bearbeitung bis zur Prüfung und Exportverpackung.</p></div><div class="lg:w-2/3 grid sm:grid-cols-2 gap-4">{productionSteps.map(step => <div class="p-6 bg-gray-50 rounded-xl border border-gray-100"><span class="text-3xl font-black text-gray-200">{step.step}</span><h3 class="font-black text-gray-900 mt-3">{step.title}</h3><p class="text-sm text-gray-600 mt-2 leading-relaxed">{step.desc}</p></div>)}</div></div></div></section>
  <section class="py-20 bg-gray-50 border-y border-gray-200"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="flex justify-between items-end mb-12"><h2 class="text-4xl font-black text-gray-900">Ausgewählte Produkte</h2><a href="/de/products/" class="text-brand-blue font-bold hover:underline">Gesamtkatalog →</a></div><div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">{featuredProducts.map(product => <div class="bg-white rounded-xl border border-gray-200 overflow-hidden"><div class="aspect-square p-6 bg-gray-50"><img src={product.image} alt={product.name} loading="lazy" class="w-full h-full object-contain" /></div><div class="p-5"><h3 class="font-bold text-gray-900 min-h-[3rem]">{product.name}</h3><div class="flex gap-2 mt-4"><a href={`/de/products/${product.slug}/`} class="flex-1 py-2 text-center text-xs font-black border rounded">DETAILS</a><a href={`/de/contact/?product=${encodeURIComponent(product.name)}`} class="flex-1 py-2 text-center text-xs font-black bg-brand-red text-white rounded">ANFRAGEN</a></div></div></div>)}</div></div></section>
  <section class="py-20 bg-white border-t border-gray-200"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="flex flex-col md:flex-row justify-between items-end mb-14 gap-4"><div class="space-y-4"><h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Projektbeispiele</h2><h3 class="text-4xl font-black text-gray-900 tracking-tight">Unsere Projekte, <span class="text-brand-red">vor Ort</span></h3></div><p class="text-gray-500 max-w-md text-right hidden md:block">Fotos und Video eines Brandschutz-Pumpenraums — reale Montagearbeit, übergabebereit.</p></div><div class="grid grid-cols-2 lg:grid-cols-4 gap-5">{projectPhotos.map(photo => <figure class="group bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300"><div class="aspect-[4/3] overflow-hidden bg-gray-100"><img src={photo.src} alt={photo.alt} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" /></div><figcaption class="px-4 py-3 text-xs font-bold text-gray-600 leading-snug">{photo.caption}</figcaption></figure>)}</div><div class="mt-10 grid md:grid-cols-3 gap-6 items-center"><div class="flex justify-center"><div class="relative rounded-xl overflow-hidden bg-gray-900 shadow-xl"><video class="h-[420px] w-auto object-cover" src="/assets/projects/project-walkthrough.mp4" poster="/assets/projects/pump-room-wide.webp" muted loop autoplay playsinline preload="metadata" controls></video><span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-brand-red text-white text-[10px] font-black uppercase tracking-wider pointer-events-none">Video von der Baustelle</span></div></div><div class="md:col-span-2"><h4 class="text-xl font-black text-gray-900 mb-5">Was auf dieser Anlage installiert wurde</h4><ul class="space-y-3 mb-8">{projectScope.map(item => <li class="flex items-start gap-3"><span class="mt-1 w-2 h-2 rounded-full bg-brand-red shrink-0"></span><span class="text-gray-600 text-sm leading-relaxed">{item}</span></li>)}</ul><a href="/de/contact/" class="inline-flex items-center gap-2 px-8 py-4 bg-brand-red hover:opacity-90 text-white font-bold rounded-lg transition shadow-lg shadow-brand-red/20 transform hover:-translate-y-0.5">Über Ihr Projekt sprechen <span aria-hidden="true">→</span></a></div></div></div></section>
  <section class="py-20 bg-white border-t border-gray-200"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="flex flex-col md:flex-row md:justify-between md:items-end gap-4 mb-12"><div class="space-y-4"><h2 class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Vollständiges Modellverzeichnis</h2><h3 class="text-4xl font-black text-gray-900 tracking-tight">Komplette <span class="text-brand-red">Produktpalette</span></h3></div><a href="/de/products/" class="text-brand-red font-bold hover:underline shrink-0">Alle Produkte und Filter →</a></div><div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-x-10 gap-y-12">{catalogByCategory.map(group => <div><div class="flex items-baseline justify-between gap-3 pb-3 mb-1 border-b-2 border-brand-blue/30"><a href={`/de/products/#category=${encodeURIComponent(group.name)}`} class="font-black text-gray-900 hover:text-brand-red transition-colors leading-tight">{group.name}</a><span class="text-[11px] font-bold text-gray-400 uppercase tracking-widest tabular-nums shrink-0">{group.items.length}</span></div><ul>{group.items.map(product => <li><a href={`/de/products/${product.slug}/`} class="group flex items-start justify-between gap-3 py-2 border-b border-gray-100 hover:border-brand-red transition-colors"><span class="text-sm font-semibold text-gray-700 group-hover:text-brand-red transition-colors leading-snug">{product.name}</span><span class="text-brand-blue opacity-0 group-hover:opacity-100 transition-opacity shrink-0">→</span></a></li>)}</ul></div>)}</div></div></section>
  <section class="py-20 bg-white"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="text-center mb-12"><span class="text-sm font-black tracking-[0.3em] text-brand-blue uppercase">Technische Ressourcen</span><h2 class="text-4xl font-black text-gray-900 mt-3">Auswahlhilfen und Systemübersichten</h2></div><div class="grid md:grid-cols-3 gap-6">{visibleResources.map(item => <a href={item.href} class="p-7 rounded-2xl border border-gray-200 hover:border-brand-blue hover:shadow-lg"><h3 class="text-xl font-black text-gray-900">{item.title}</h3><p class="text-sm text-gray-600 leading-relaxed mt-3">{item.desc}</p><span class="inline-block mt-5 text-brand-red font-bold">Ressource lesen →</span></a>)}</div>{moreResources.length > 0 && <details class="mt-10 border-t border-gray-200 pt-6"><summary class="cursor-pointer text-sm font-black uppercase tracking-[0.2em] text-brand-blue hover:text-brand-red">Alle Auswahlhilfen anzeigen ({moreResources.length})</summary><ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10">{moreResources.map(item => <li><a href={item.href} class="group flex items-start justify-between gap-3 py-2 border-b border-gray-100 hover:border-brand-red transition-colors"><span class="text-sm font-semibold text-gray-700 group-hover:text-brand-red transition-colors leading-snug">{item.title}</span><span class="text-brand-blue opacity-0 group-hover:opacity-100 transition-opacity shrink-0">→</span></a></li>)}</ul></details>}</div></section>
  <section class="py-20 bg-gray-900 text-white"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-14 items-center"><div><h2 class="text-4xl font-black">Entwickelt für <span class="text-brand-blue">hohe Druckstufen.</span></h2><p class="text-gray-400 mt-5 leading-relaxed">Unsere Konstruktion konzentriert sich auf Dauerhaftigkeit und Betriebssicherheit in kritischer Infrastruktur.</p><a href="/de/certificates/" class="inline-block mt-7 px-7 py-3 bg-white/10 border border-white/30 rounded-lg font-bold">Zertifikate und Spezifikationen</a></div><div class="space-y-4">{industries.map(industry => <div class="p-6 bg-white/5 rounded-2xl border border-white/10"><h3 class="font-black text-lg">{industry.name}</h3><p class="text-sm text-gray-400 mt-1">{industry.desc}</p></div>)}</div></div></section>
  <section id="inquiry" class="py-20 bg-white"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-14"><div><h2 class="text-4xl font-black text-gray-900">Professionelles Angebot anfordern</h2><p class="text-lg text-gray-600 mt-5 leading-relaxed">Senden Sie Zeichnungen, Spezifikationen oder Ihre Projektanforderungen. Unsere Ingenieure prüfen die Details und melden sich mit den nächsten Schritten.</p><ul class="mt-6 space-y-3 text-gray-700"><li>• Angebot auf Anfrage</li><li>• Unterstützung bei Anwendung und Auswahl</li><li>• Exportverpackung und Dokumentation</li></ul></div><InquiryForm /></div></section>
