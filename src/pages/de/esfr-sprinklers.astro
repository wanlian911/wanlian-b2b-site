---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Was ist ein ESFR-Sprinkler?',
		answer: 'ESFR steht für Early Suppression Fast Response. Der ESFR-Sprinkler dieser Baureihe nutzt eine Konstruktion mit hoher Durchflussmenge, eine Glasampulle mit schneller Reaktion bei 74°C sowie hängende oder stehende Ausführungen für Hochregallager, Lagerhallen und Industrieanlagen.'
	},
	{
		question: 'Können ESFR-Sprinkler Sprinkler im Regallager ersetzen?',
		answer: 'Ja, bei Lageranordnungen, die den geltenden Auslegungskriterien entsprechen. Die endgültige Entscheidung hängt von Ware, Lagerhöhe, Raumhöhe, Regalanordnung, K-Faktor und Auslegungsdruck ab, daher müssen der Brandschutzplaner und die zuständige Behörde die Anordnung freigeben.'
	},
	{
		question: 'Wie beeinflusst der K-Faktor die ESFR-Auswahl?',
		answer: 'K-Faktor und Betriebsdruck bestimmen die Wassermenge, die jeder Sprinkler abgibt. Verwenden Sie die hydraulische Berechnung und die Lagerkriterien für die Wahl des ESFR-Modells; wählen Sie keinen Sprinkler nach der Nennweite des Rohres.'
	},
	{
		question: 'Welche Temperaturklasse hat der ESFR-Sprinkler?',
		answer: 'Das ESFR-Produkt ist mit einer Glasampulle mit schneller Reaktion bei 74°C (165°F) spezifiziert. Bestätigen Sie Umgebungsbedingungen sowie die geforderte Listung oder Zulassung für das Zielprojekt vor der Bestellung.'
	},
	{
		question: 'Was sollte ein ESFR-Paket enthalten?',
		answer: 'Eine typische Bestellung beginnt mit dem Sprinklerplan und ergänzt die ausgewählten Sprinkler, das Nassalarmventil, die Strömungswächter, die überwachten Absperrschieber und die Standard-Systemarmaturen, die die freigegebene Auslegung verlangt.'
	},
	{
		question: 'Können Sie die Stückliste der Lager-Sprinkleranlage komplett kalkulieren?',
		answer: 'Ja. Senden Sie den freigegebenen Sprinklerplan, die Angaben zu Lager und Raumhöhe, die hydraulischen Auslegungsdaten und die Ventilliste. Wir können die geprüften Sprinkler und die Systemkomponenten als ein Projektpaket kalkulieren.'
	}
];

const products = [
	{
		slug: 'esfr-sprinkler-head',
		name: 'ESFR Early Suppression Fast Response Sprinkler',
		img: '/assets/products/esfr-sprinkler-head.webp',
		desc: 'ESFR-202 / ESFR-242 / ESFR-363, 74°C, hängend und stehend'
	},
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'Glass Bulb Fire Sprinkler (ZST Series)',
		img: '/assets/products/glass-bulb-fire-sprinkler-zst.webp',
		desc: 'DN15 / DN20, K=80 ±4 / K=115 ±9, hängend / stehend / seitlich'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Wet Alarm Check Valve ZSFZ 150',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'DN100 / DN150 / DN200, 1.6 MPa, Alarmgong und Verzögerungskammer'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Vane Type Water Flow Indicator (ZSJZ Series)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'DN50–DN200, 1.2 / 1.6 MPa, einstellbare Verzögerung 2–60 s'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Signal Butterfly Valve (DN80 PN16)',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80-overlay.png',
		desc: 'DN50–DN300, PN16, überwachte offene/geschlossene Stellung'
	},
	{
		slug: 'ul-fm-resilient-seat-osy-gate-valve',
		name: 'UL/FM Fire Protection Resilient Seated OS&Y Gate Valve',
		img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp',
		desc: '2"–10", genutete Anschlüsse, steigende Spindel, UL / FM gelistet'
	}
];
---

<Layout
	title="ESFR-Sprinklerköpfe für Hochregallager | WLFE"
	description="ESFR-Sprinkler für Sprinkleranlagen im Lager: K-Faktor, Betriebsdruck, Alternativen im Regallager und komplette Ventilpakete von Wanlian."
	type="product"
	locale="de"
	productData={{
		name: 'ESFR-Sprinkleranlagen',
		image: '/assets/products/esfr-sprinkler-head.webp',
		description: 'ESFR-Sprinkler und geprüfte Komponenten für den Brandschutz in Hochregallagern, Lagerhallen und Industrieanlagen.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'ESFR-Sprinkler' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/de/" class="hover:text-blue-600">Startseite</a>
			<span>/</span>
			<a href="/de/products/" class="hover:text-blue-600">Produkte</a>
			<span>/</span>
			<span class="text-gray-600">ESFR-Sprinkler</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Sprinkleranlagen für Hochregallager — Direkt ab Werk</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">ESFR-Sprinklerköpfe für den Schutz von Hochregallagern</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">ESFR-Sprinklerköpfe werden gewählt, wenn die Auslegung eines Lagers eine schnelle Deckenabgabe mit hohem Durchfluss zum Schutz der Ware verlangt. Wanlian liefert den ESFR-Sprinkler sowie die überwachten Armaturen, Alarm- und Strömungskomponenten darum herum, sodass die freigegebene Auslegung als ein abgestimmtes Paket kalkuliert werden kann.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Schnelle Reaktion 74°C', 'Hängend / stehend', 'K-Faktor-Planung', 'Unterstützung der Lager-Stückliste'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">ESFR-Sprinkler und Systemkomponenten</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{products.map(p => (
					<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">ESFR-Auswahl und Spezifikation</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Auswahlpunkt</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Geprüfte Produktinformation</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr><td class="px-4 py-3 font-bold text-gray-900">ESFR-Sprinkler</td><td class="px-4 py-3 text-gray-700">ESFR-202 / ESFR-242 / ESFR-363 und ZSTX-161; 74°C; hängend PY oder stehend UY; R1/2" oder R3/4" NPT.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Hydraulische Auslegung</td><td class="px-4 py-3 text-gray-700">Verwenden Sie die freigegebene Lagerauslegung, um K-Faktor, Betriebsdruck, Wasserbedarf und Sprinklerabstände vor der Freigabe festzulegen.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Option Standardsprinkler</td><td class="px-4 py-3 text-gray-700">ZST-Sprinkler mit Glasampulle: DN15 / DN20, K=80 ±4 oder K=115 ±9, in hängenden, stehenden und seitlichen Ausführungen.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Alarm und Durchfluss</td><td class="px-4 py-3 text-gray-700">Nassalarmventil ZSFZ: DN100 / DN150 / DN200 bei 1.6 MPa; Strömungswächter ZSJZ: DN50–DN200 bei 1.2 / 1.6 MPa.</td></tr>
						<tr><td class="px-4 py-3 font-bold text-gray-900">Absperrung und Überwachung</td><td class="px-4 py-3 text-gray-700">Signal-Absperrklappe: DN50–DN300, PN16, mit integriertem elektrischem Signalgeber; Absperrschieber OS&amp;Y: 2"–10", genutet, UL / FM gelistet.</td></tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Was in eine einzige ESFR-Bestellung gehört</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2">
				<li><strong>Freigegebener Sprinklerplan</strong> — Lagerware, Angaben zu Regalen und Raumhöhe, Sprinklermodell, Ausführung, Gewinde und Menge.</li>
				<li><strong>Grundlage der hydraulischen Auslegung</strong> — gewählter K-Faktor, Auslegungsdruck, Wasserbedarf sowie Projektnorm oder Hinweise der zuständigen Behörde.</li>
				<li><strong>Armaturensatz des Systems</strong> — Nassalarmventil, Strömungswächter und die spezifizierten überwachten Absperrschieber.</li>
				<li><strong>Dokumentation und Verpackung</strong> — Produktdaten, geforderte Zertifikate, Mengen pro Karton und Kennzeichnung für den Zielmarkt, vor der Produktion bestätigt.</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Konstruktionsunterlagen für ESFR</h2>
			<p class="text-gray-700 leading-relaxed">Für Konstruktionsentscheidungen lesen Sie die <a href="/de/guides/commercial-building-sprinkler-system-bom-guide/" class="text-brand-blue font-semibold hover:underline">Stücklisten-Richtlinie für Sprinkleranlagen</a>, die <a href="/de/guides/fire-sprinkler-head-selection-guide/" class="text-brand-blue font-semibold hover:underline">Auswahlrichtlinie für Sprinklerköpfe</a> und die <a href="/de/guides/fire-sprinkler-system-valves-guide/" class="text-brand-blue font-semibold hover:underline">Richtlinie zu Armaturen von Sprinkleranlagen</a>.</p>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Häufig gestellte Fragen</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Benötigen Sie ein ESFR-Sprinklerpaket für Ihr Lager?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Senden Sie den Sprinklerplan und die hydraulische Auslegungsgrundlage — wir bestätigen die Stückliste und antworten mit einem abgestimmten Angebot innerhalb von 12 Stunden.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/de/contact/?product=ESFR-Sprinkler" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Angebot anfordern</a>
						<a href="https://wa.me/8618684324501?text=Hallo%2C%20ich%20brauche%20ein%20ESFR-Sprinklerpaket" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Auf WhatsApp chatten</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
