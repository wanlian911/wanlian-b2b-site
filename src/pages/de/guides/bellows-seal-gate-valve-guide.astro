---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'Was ist der Unterschied zwischen einem Faltenbalg-Absperrschieber und einem Standard-Absperrschieber?',
		answer: 'Ein Standard-Absperrschieber dichtet die bewegliche Spindel ausschließlich mit einer Stopfbuchspackung ab. Ein Faltenbalg-Absperrschieber ergänzt zwischen Spindel und Deckel einen verschweißten Metallfaltenbalg als zweite, leckagefreie Barriere. Sollte der Faltenbalg ausfallen, hält die Packung weiterhin dicht – deshalb wird von einer Doppeldichtung mit null flüchtiger Leckage gesprochen.'
	},
	{
		question: 'Für welche Medien sind Faltenbalg-Absperrschieber erforderlich?',
		answer: 'Faltenbalg-Absperrschieber werden typischerweise für Thermalöl, Dampf und Heißwasser spezifiziert, bei denen Spindelleckagen ein Sicherheits- und Effizienzproblem darstellen. Sie werden außerdem häufig für toxische, brennbare oder gefährliche Medien eingesetzt, wenn flüchtige Emissionen minimiert werden müssen, sowie für Anlagen mit strengen Umweltauflagen.'
	},
	{
		question: 'Welche Nennweiten und Druckstufen sind für Wanlian-Faltenbalg-Absperrschieber verfügbar?',
		answer: 'Unser manueller, geflanschter Faltenbalg-Absperrschieber deckt DN15–DN300 (1/2" bis 12") bei Betriebsdrücken von 1,6–4,0 MPa (Class 150/300) und einem Betriebstemperaturbereich von -29 °C bis 425 °C ab. Die Gehäuse bestehen aus Schmiedestahl (A105) oder Gussstahl (WCB), der Faltenbalg aus Edelstahl 304 oder 316Ti.'
	},
	{
		question: 'Entsprechen Faltenbalg-Absperrschieber internationalen Normen?',
		answer: 'Wanlian-Faltenbalg-Absperrschieber werden entsprechend den Normen GB, ANSI, DIN und JIS gefertigt. Die Druckstufen werden sowohl metrisch (MPa) als auch nach ANSI Class angegeben. Bestätigen Sie vor der Bestellung die für Ihr Projekt geforderte Maß- und Drucknorm.'
	},
	{
		question: 'Wie lässt sich die Qualität eines Faltenbalg-Absperrschiebers vor der Bestellung prüfen?',
		answer: 'Fordern Sie Druckprüfberichte für Gehäuse und Sitz der tatsächlichen Charge sowie Werkstoffzeugnisse für Gehäuse und Faltenbalg an. Bestätigen Sie im Angebot außerdem den Faltenbalgwerkstoff (304/316Ti) und die Schweißnorm. Eine Prüfung durch Dritte vor dem Versand kann organisiert werden.'
	}
];

const toc = [
	{ id: 'what-is-bellows-gate-valve', label: '1. Was ist ein Faltenbalg-Absperrschieber?' },
	{ id: 'how-bellows-seal-works', label: '2. Funktionsweise der Doppeldichtung' },
	{ id: 'where-bellows-valves-are-specified', label: '3. Einsatzbereiche von Faltenbalg-Armaturen' },
	{ id: 'standards-and-pressure-classes', label: '4. Normen und Druckstufen' },
	{ id: 'bellows-vs-standard-gate-valve', label: '5. Faltenbalg- gegenüber Standard-Absperrschieber' },
	{ id: 'specification-checklist', label: '6. B2B-Spezifikations-Checkliste' },
	{ id: 'faq', label: 'Häufig gestellte Fragen' }
];

const products = [
	{ slug: 'flange-manual-bellows-gate-valve', name: 'Manueller, geflanschter Faltenbalg-Absperrschieber', img: '/assets/products/flange-manual-bellows-gate-valve.webp', desc: 'Schmiede-/Gussstahl, DN15–DN300, Class 150/300' },
	{ slug: 'z85x-stainless-steel-grooved-gate-valve', name: 'Z85X genuteter Absperrschieber aus Edelstahl', img: '/assets/products/z85x-stainless-steel-grooved-gate-valve.webp', desc: 'Absperrschieber aus Guss 316 (CF8M) für korrosive Medien' },
	{ slug: 'brass-gate-valve-z15w-16t', name: 'ANSI-Absperrschieber aus Schmiedemessing (Z15W-16T)', img: '/assets/products/brass-gate-valve-z15w-16t.webp', desc: 'NPT-Gewinde-Absperrschieber für Öl- und Wasserleitungen' }
];
---

<Layout
	title="Faltenbalg-Absperrschieber: Leitfaden für Dampf & Thermalöl"
	description="Leitfaden zu Faltenbalg-Absperrschiebern für Dampf und Thermalöl: Doppeldichtung, ANSI-Normen, Nennweiten und B2B-Spezifikationscheckliste für Einkäufer."
	type="article"
	locale="de"
	faq={faq}
	breadcrumbs={[{ name: 'Leitfäden', href: '/de/blog/' }, { name: 'Leitfaden Faltenbalg-Absperrschieber' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/de/" class="hover:text-blue-600">Startseite</a>
			<span>/</span>
			<a href="/de/blog/" class="hover:text-blue-600">Leitfäden</a>
			<span>/</span>
			<span class="text-gray-600">Leitfaden Faltenbalg-Absperrschieber</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Leitfaden für Industriearmaturen</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Leitfaden Faltenbalg-Absperrschieber: geflanschte ANSI-Bauformen für Dampf und Thermalöl</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Kurz gesagt: Ein Faltenbalg-Absperrschieber ist ein Absperrschieber mit einem verschweißten Metallfaltenbalg als zweiter Dichtbarriere hinter der Spindelpackung. Dadurch wird eine flüchtige Leckage an der Spindel verhindert. Er ist für Thermalöl, Dampf und Heißwasser sowie für alle Anwendungen vorgesehen, in denen Spindelleckagen nicht akzeptabel sind. Dieser Leitfaden erläutert die Funktionsweise, Einsatzbereiche und Spezifikation.</p>

			<TableOfContents headings={toc} />

			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 id="what-is-bellows-gate-valve" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Was ist ein Faltenbalg-Absperrschieber?</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Ein Faltenbalg-Absperrschieber ist ein Absperrschieber mit steigender Spindel, die von einem verschweißten Metallfaltenbalg umschlossen wird. Der Faltenbalg dehnt sich mit dem Spindelhub aus und zieht sich zusammen, sodass die Spindel vollständig vom Medium getrennt bleibt. Gleichzeitig bildet eine herkömmliche Stopfbuchse darüber eine zweite Schutzbarriere. Das Ergebnis ist ein Doppeldichtungssystem: Selbst wenn der Faltenbalg durch Ermüdung ausfällt, verhindert die Packung weiterhin den Austritt in die Atmosphäre.</p>
			<p class="text-gray-700 leading-relaxed">Diese Konstruktion macht den Faltenbalg-Absperrschieber zur Standardlösung für <a href="/de/products/flange-manual-bellows-gate-valve/" class="text-brand-blue font-semibold hover:underline">manuelle, geflanschte Faltenbalg-Absperrschieber</a> in anspruchsvollen thermischen Anwendungen.</p>

			<h2 id="how-bellows-seal-works" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Funktionsweise der Doppeldichtung</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Bei einem Standard-Absperrschieber ist die Spindelpackung die einzige Barriere zwischen dem Prozessmedium und der Atmosphäre. Eine Packung ist eine Dichtung durch Kompression. Sie funktioniert, kann sich jedoch mit der Zeit verschlechtern, austrocknen oder lockern, insbesondere bei thermischen Zyklen. Die Faltenbalgdichtung beseitigt das Problem an seiner Ursache: Der verschweißte Metallfaltenbalg (typischerweise aus Edelstahl 304 oder 316Ti) ist an Spindel und Deckel befestigt, sodass das Prozessmedium den Packungsbereich physisch nicht erreichen kann.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Die Packung oberhalb des Faltenbalgs bleibt erhalten. Sie dichtet den Deckelinnenraum gegen Staub ab und dient als Reserve, falls der Faltenbalg beschädigt wird. Das Wartungsteam erhält außerdem eine frühzeitige Warnung: Bei einem Faltenbalgausfall beginnt die Armatur an der Packung zu lecken, anstatt ohne Vorzeichen auszufallen.</p>
			<p class="text-gray-700 leading-relaxed">Da der Faltenbalg ein verschweißtes Metallbauteil ist, entscheiden Werkstoff, Schweißqualität und Zyklenlebensdauer über die tatsächliche Qualität und unterscheiden die Anbieter voneinander. Diese Punkte sollten in jedem Angebot abgefragt werden.</p>

			<h2 id="where-bellows-valves-are-specified" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Einsatzbereiche von Faltenbalg-Armaturen</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Der klassische Einsatz eines Faltenbalg-Absperrschiebers ist <strong>Thermalöl und Dampf</strong>. Wärmeträgeranlagen arbeiten mit hohen Temperaturen (in unserem Standardbereich bis 425 °C) und wiederholten Temperaturwechseln. Eine undichte Spindelstopfbuchse bedeutet Wärmeverlust, eine verschmutzte Anlage und ein Sicherheitsrisiko. Heißwassersysteme weisen dasselbe Problem in anderer Form auf.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Über thermische Anwendungen hinaus werden Faltenbalg-Armaturen überall dort spezifiziert, wo <strong>flüchtige Emissionen kontrolliert werden müssen</strong>: bei toxischen, brennbaren oder geruchsintensiven Medien sowie in Anlagen mit Umweltauflagen. Der verschweißte Faltenbalg bildet eine wirksame Barriere gegen flüchtige Emissionen, insbesondere bei Anwendungen mit hoher thermischer Ausdehnung oder Kontraktion.</p>
			<p class="text-gray-700 leading-relaxed">Kurz gesagt: Wenn die Leitung heiße oder gefährliche Medien – oder beides – führt, sollte geprüft werden, ob ein Faltenbalg-Absperrschieber den Standard-Absperrschieber mit ausschließlicher Packungsdichtung in der Spezifikation ersetzen sollte.</p>

			<h2 id="standards-and-pressure-classes" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Normen und Druckstufen</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Faltenbalg-Absperrschieber werden nach denselben Maß- und Konstruktionsgrundlagen gefertigt wie andere Absperrschieber aus Stahl. Wanlian-Faltenbalg-Absperrschieber entsprechen den Normen GB, ANSI, DIN und JIS. Die Druckstufen werden sowohl metrisch (1,6–4,0 MPa) als auch nach ANSI Class (Class 150/300) angegeben.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Für geflanschte Absperrschieber aus Stahl in internationalen Projekten sind die ASME/ANSI-Regelwerke maßgeblich. ASME B16.34 regelt die Druck-Temperatur-Nennwerte geflanschter Armaturen, während die API-Reihen 600/603 die Konstruktion von Absperrschiebern aus Stahl und korrosionsbeständigen Legierungen abdecken. Wenn ein Projekt ausdrücklich die Leistung hinsichtlich flüchtiger Emissionen fordert, werden Armaturen häufig nach Leckageprüfungen wie ISO 15848 oder TA-Luft spezifiziert.</p>
			<p class="text-gray-700 leading-relaxed">Bestätigen Sie vor dem Angebotsvergleich immer, welche Norm Ihr Projekt zugrunde legt (GB, ANSI oder DIN), da Baulängen und Flanschbohrungen voneinander abweichen können.</p>

			<h2 id="bellows-vs-standard-gate-valve" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Faltenbalg- gegenüber Standard-Absperrschieber</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Vergleich</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Standard-Absperrschieber</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Faltenbalg-Absperrschieber</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Spindelabdichtung</td>
							<td class="px-4 py-3 text-gray-700">Nur Packung</td>
							<td class="px-4 py-3 text-gray-700">Verschweißter Metallfaltenbalg + Packung</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Flüchtige Leckage</td>
							<td class="px-4 py-3 text-gray-700">Abhängig vom Zustand der Packung</td>
							<td class="px-4 py-3 text-gray-700">Null durch den Faltenbalg; Packung als Reserve</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Beständigkeit gegen Temperaturwechsel</td>
							<td class="px-4 py-3 text-gray-700">Packung kann sich über die Zyklen lockern</td>
							<td class="px-4 py-3 text-gray-700">Faltenbalg nimmt die Spindelbewegung auf</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Typischer Einsatz</td>
							<td class="px-4 py-3 text-gray-700">Wasser, Luft, allgemeine Medien</td>
							<td class="px-4 py-3 text-gray-700">Dampf, Thermalöl, gefährliche Medien</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Anschaffungskosten</td>
							<td class="px-4 py-3 text-gray-700">Niedriger</td>
							<td class="px-4 py-3 text-gray-700">Höher – gerechtfertigt durch leckagefreien Betrieb</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Für allgemeine Wasser- und Luftanwendungen bleibt der Standard-Absperrschieber die wirtschaftliche Wahl. In unserem <a href="/de/guides/gate-valve-vs-butterfly-valve-fire-protection/" class="text-brand-blue font-semibold hover:underline">Leitfaden Absperrschieber gegenüber Absperrklappe</a> erfahren Sie, wie Absperrschieber in Feuerlösch- und Wassernetzen eingesetzt werden. Einen Überblick über das erweiterte Sortiment bietet unser <a href="/de/tags/industrial-valves/" class="text-brand-blue font-semibold hover:underline">Bereich Industriearmaturen</a>.</p>

			<h2 id="specification-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. B2B-Spezifikations-Checkliste</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Medium und Temperatur festlegen</strong> – Thermalöl, Dampf oder Heißwasser: Geben Sie die maximale Betriebstemperatur an, damit Faltenbalgwerkstoff und Gehäuseauslegung bestätigt werden können.</li>
				<li><strong>Druckstufe und Norm festlegen</strong> – Class 150/300 (PN16–PN40) mit GB-, ANSI- oder DIN-Flanschbohrung; nennen Sie die für das Projekt geltende Norm.</li>
				<li><strong>Gehäuse- und Faltenbalgwerkstoff spezifizieren</strong> – Gehäuse aus Schmiedestahl A105 oder Gussstahl WCB mit Edelstahlfaltenbalg 304/316Ti sind der übliche Ausgangspunkt.</li>
				<li><strong>Nach dem Faltenbalgaufbau fragen</strong> – verschweißter Faltenbalg, Schweißverfahren und vom Hersteller durchgeführte Prüfungen der Zyklenlebensdauer.</li>
				<li><strong>Chargenprüfberichte verlangen</strong> – Druckprüfzeugnisse für Gehäuse und Sitz der tatsächlichen Charge sowie auf Wunsch Werkstoffzeugnisse.</li>
				<li><strong>Lieferanten zuerst prüfen</strong> – Die Faltenbalgqualität ist auf Fotos nicht erkennbar. Nutzen Sie unsere <a href="/de/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">B2B-Checkliste zur Beschaffung von Industriearmaturen</a>, bevor Sie sich für einen Hersteller entscheiden.</li>
			</ul>

			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Häufig gestellte Fragen</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Benötigen Sie Faltenbalg-Absperrschieber für eine Thermalöl- oder Dampfleitung?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Nennen Sie uns Medium, Temperatur, DN und Flanschnorm. Unsere Ingenieure bestätigen die Faltenbalgspezifikation und erstellen innerhalb von 12 Stunden ein Angebot.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href={`/de/contact/?product=${encodeURIComponent('Faltenbalg-Absperrschieber')}`} class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Angebot anfordern</a>
						<a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Hallo, ich benötige Faltenbalg-Absperrschieber für Dampf oder Thermalöl')}`} class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Über WhatsApp chatten</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
