---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'Was ist der Hauptunterschied zwischen einem Sprühflutventil und einem Pre-Action-Ventil?',
		answer: 'Eine Sprühflutanlage hat offene Sprinkler oder Düsen, sodass das Öffnen des Sprühflutventils gleichzeitig Wasser zu jeder Auslassstelle leitet. Eine Pre-Action-Anlage verfügt normalerweise über geschlossene Sprinkler und nutzt eine Branderkennung, um ein Steuerungsventil zu öffnen, bevor ein Sprinkler Wasser abgibt. Sprühflut wird für eine schnelle, gleichzeitige Abdeckung gewählt; Pre-Action dort, wo eine unbeabsichtigte Wasserabgabe begrenzt werden muss. Bestätigen Sie die erforderliche Verriegelung und Abfolge anhand der geltenden Fassung.'
	},
	{
		question: 'Soll das Sprühflutventil elektrisch oder hydraulisch ausgelöst werden?',
		answer: 'Wählen Sie die Auslöseart anhand der Auslegung der Branderkennung, der Anforderungen des Gefahrenbereichs, der verfügbaren Energieversorgung und der erforderlichen ausfallsicheren Abfolge. Eine elektrische Auslösung ist zweckmäßig, wenn Brandmelderzentrale und überwachte Magnetventilleitung bereits spezifiziert sind. Eine hydraulische oder pneumatische Auslösung eignet sich für Anlagen mit eigener Druckleitung oder bevorzugter pneumatischer Erkennung. Wanlian liefert die Ventilgruppe und kompatibles Zubehör; die Abfolge der Erkennungs- und Steuerzentrale muss vom Anlagenplaner bestätigt werden.'
	},
	{
		question: 'Wie wird eine Sprühflutanlage in kaltem Klima geschützt?',
		answer: 'Halten Sie die Sprühflutventilgruppe und die Innengarnitur möglichst in einem beheizten, zugänglichen Raum und vermeiden Sie wassergefüllte, ungeschützte Rohrleitungen bei Frostgefahr. Sehen Sie eine Kondensatsammlung und Entwässerung für die Erkennungsgarnitur vor, isolieren Sie gefährdete Abschnitte und verwenden Sie bei entsprechender Auslegung eine zugelassene Trocken- oder Pneumatikanordnung. Ersetzen Sie die Garnitur nicht durch Frostschutzmittel und ändern Sie sie nicht ohne Zustimmung der zuständigen Stelle. Bestätigen Sie das Frostschutzverfahren anhand der geltenden Fassung.'
	},
	{
		question: 'Wie lässt sich die Erkennungsleitung gegen unbeabsichtigtes Auslösen schützen?',
		answer: 'Trennen Sie die Erkennungsleitung von normalen Betriebssteuerungen, überwachen Sie ihren Druck oder Schaltungsstatus, schützen Sie außenliegende Geräte vor Stößen und verwenden Sie die für die Gefährdung vorgeschriebene Auslöseabfolge der Steuerzentrale. Eine manuelle Auslösung sollte geschützt, aber zugänglich sein; Prüfanschlüsse müssen eindeutig gekennzeichnet und nach der Prüfung wiederhergestellt werden. Hydraulische, pneumatische und elektrische Erkennung benötigen jeweils eine eigene Alarm- und Störungsüberwachung. Die endgültige Ursache-Wirkungs-Matrix sollte vor der Inbetriebnahme genehmigt werden.'
	},
	{
		question: 'Welche Angaben gehören in eine Anfrage für ein Sprühflutventil?',
		answer: 'Senden Sie die Beschreibung der Gefährdung, die geschützte Fläche, Auslegungsdurchfluss und -druck, Ventilnennweite und Endanschluss, die Anordnung offener Sprinkler oder Monitore, die Erkennungsmethode, die erforderliche Auslöseabfolge, die Umgebungstemperatur, die Entwässerung und die geltende Normenausgabe. Fordern Sie außerdem Garniturzeichnungen, Werkstoffdaten, Druckprüfberichte, Ersatzteilinformationen und Betriebsanweisungen an. Wenn eine Listung oder Zulassung erforderlich ist, geben Sie dies ausdrücklich an und bitten Sie den Lieferanten, die aktuelle Dokumentation zu bestätigen.'
	},
	{
		question: 'Liefert Wanlian die Erkennungs- und Steuerzentrale für die Sprühflutanlage?',
		answer: 'Wanlian liefert Sprühflutventilgruppen sowie zugehörige Ventile und Überwachungszubehör, einschließlich der ZSFM-Gruppe und geeigneter Absperr- oder Steuerungskomponenten. Eine Erkennungs- und Steuerzentrale wird nicht als Bestandteil des Standardventilpakets dargestellt, wenn sie nicht mitgeliefert wird. Auslösezentrale, Melder und Ursache-Wirkungs-Programmierung sollten mit dem Brandmelde- oder spezialisierten Erkennungsunternehmen spezifiziert und anschließend mit Ventilgarnitur und Anlagenabfolge abgeglichen werden.'
	}
];

const toc = [
	{ id: 'when-deluge', label: '1. Wann eine Anlage Sprühflutschutz benötigt' },
	{ id: 'how-it-works', label: '2. Funktionsweise der ZSFM-Sprühflutventilgruppe' },
	{ id: 'actuation', label: '3. Auswahl der Auslöseart' },
	{ id: 'sizing', label: '4. Dimensionierung nach Durchfluss und Auslösezeit' },
	{ id: 'discharge', label: '5. Offene Sprinkler, Monitore und Auslassanordnung' },
	{ id: 'testing', label: '6. Inbetriebnahme und regelmäßige Prüfung' },
	{ id: 'rfq-checklist', label: '7. Checkliste für die Sprühflutventil-Anfrage' },
	{ id: 'faq', label: 'Häufig gestellte Fragen' }
];

const products = [
	{ slug: 'deluge-alarm-valve-zsfm', name: 'Sprühflut-Alarmventilgruppe (ZSFM-Serie)', img: '/assets/products/deluge-alarm-valve-zsfm.webp', desc: 'Sprühflutventilgruppe mit nasser Unterseite für Anlagen mit offenen Sprinklern und Monitoren' },
	{ slug: 'pre-action-alarm-system-zsfy', name: 'Pre-Action-Sprühflutalarmsystem (ZSFY-Serie)', img: '/assets/products/pre-action-alarm-system-zsfy.jpg', desc: 'Pre-Action-Baugruppen mit einfacher und doppelter Verriegelung' },
	{ slug: 'manual-fire-water-cannon-ps', name: 'Manueller Feuerlöschmonitor (PS-Serie)', img: '/assets/products/manual-fire-water-cannon-ps.webp', desc: 'Fester Monitor für Sprühflut- und Monitorauslassaufgaben' },
	{ slug: 'ul-fm-resilient-seat-osy-gate-valve', name: 'UL/FM-Absperrschieber mit elastischem Sitz OS&amp;Y', img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp', desc: '2"–10", genutete Enden, steigende Spindel, UL/FM-gelistet' }
];
