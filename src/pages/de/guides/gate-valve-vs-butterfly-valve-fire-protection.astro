---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'how-they-work', label: '1. Funktionsweise: ein schneller Vergleich' },
	{ id: 'head-to-head-gate-vs-butterfly', label: '2. Direktvergleich: Absperrschieber vs. Absperrklappe' },
	{ id: 'where-each-valve-belongs', label: '3. Einsatzbereiche in Brandschutzsystemen' },
	{ id: 'signal-valves-dn80', label: '4. Signalventile: die DN80-Spezialisten' },
	{ id: 'purchasing-considerations', label: '5. Kaufkriterien für B2B-Einkäufer' },
	{ id: 'recommendation-summary', label: '6. Zusammenfassung der Empfehlungen' },
	{ id: 'faq', label: 'Häufig gestellte Fragen' }
];

const faq = [
	{
		question: 'Soll ich in einer Feuerlösch-Hauptleitung einen Absperrschieber oder eine Absperrklappe einsetzen?',
		answer: 'Für Feuerlösch-Hauptleitungen, die einen vollständigen, ungehinderten Durchfluss bei minimalem Druckverlust erfordern, ist ein weichdichtender Absperrschieber (z. B. Z41X) die übliche Wahl für die Absperrfunktion. Absperrklappen (z. B. D71X) werden bevorzugt, wenn der Platz begrenzt ist, eine Vierteldrehung erforderlich ist oder das Gewicht eine Rolle spielt – etwa in Armaturenbaugruppen und Sprinklersträngen. Viele Projekte setzen beide ein: Absperrschieber für die Hauptabsperrung und Absperrklappen für die Strangregelung.'
	},
	{
		question: 'Was ist günstiger: ein Absperrschieber oder eine Absperrklappe?',
		answer: 'Bei gleicher Nennweite und Druckstufe sind Absperrklappen in Wafer-Bauform in der Regel 20–40 % günstiger als geflanschte Absperrschieber, da sie leichter sind, weniger Material benötigen und ein einfacheres Gehäuse haben. Die gesamten Einbaukosten hängen jedoch auch von Flanschen, Antrieben und dem verfügbaren Platz ab. Bei großen Nennweiten (DN200 und größer) wächst der Kostenvorteil der Absperrklappe deutlich.'
	},
	{
		question: 'Welchen Zweck hat eine Signal-Absperrklappe in einer Sprinkleranlage?',
		answer: 'Eine Signalarmatur (z. B. die genutete Signal-Absperrklappe DN80 in Wafer-Bauform) ist mit einem Überwachungs- bzw. Endschalter ausgestattet, der bei vollständig oder teilweise geschlossener Armatur ein elektrisches Signal an die Brandmeldezentrale sendet. Dadurch bleibt die Sprinkleranlage niemals unbeabsichtigt abgesperrt – eine zwingende Sicherheitsanforderung in Installationen nach dem Muster der NFPA 13.'
	},
	{
		question: 'Was ist der Unterschied zwischen den Druckstufen der Armaturen Z41X und D71X?',
		answer: 'Der weichdichtende Absperrschieber Z41X aus duktilem Gusseisen und die Absperrklappe D71X in Wafer-Bauform werden beide üblicherweise mit PN16 (1,6 MPa) geliefert; Varianten in PN10 sind verfügbar. Für den Brandschutz deckt PN16 standardmäßige kommunale und industrielle Anlagen ab. Bestätigen Sie stets den maximalen statischen Druck Ihres Netzes und spezifizieren Sie bei Bedarf PN25.'
	}
];

const valveProducts = [
	{
		slug: 'resilient-seat-flanged-gate-valve-z41x',
		name: 'Geflanschter weichdichtender Absperrschieber aus duktilem Gusseisen (Z41X)',
		img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp',
		desc: 'Absperrarmatur mit vollem Durchgang und blasenfreier Dichtheit für Feuerlösch-Hauptleitungen'
	},
	{
		slug: 'wafer-type-butterfly-valve-d71x',
		name: 'Absperrklappe in Wafer-Bauform aus gummiertem duktilem Gusseisen (D71X)',
		img: '/assets/products/wafer-type-butterfly-valve-d71x.webp',
		desc: 'Kompakte Vierteldreharmatur für beengte Platzverhältnisse und Strangleitungen'
	},
	{
		slug: 'signal-grooved-wafer-butterfly-valve-dn80',
		name: 'Genutete Signal-Absperrklappe in Wafer-Bauform (DN80-PN16)',
		img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp',
		desc: 'Genutete Signalarmatur mit Überwachungsschalter für Sprinkleranlagen'
	},
	{
		slug: 'telescopic-resilient-seat-gate-valve-z41x-t',
		name: 'Teleskopierbarer weichdichtender Absperrschieber (Z41X-T)',
		img: '/assets/products/telescopic-resilient-seat-gate-valve-z41x-t.webp',
		desc: 'Kompakter Teleskop-Absperrschieber für Feuerlöschleitungen mit Dehnungsausgleich'
	}
];
---

<Layout
	title="Absperrschieber oder Absperrklappe im Brandschutz"
	description="Absperrschieber oder Absperrklappe im Brandschutz: Durchfluss, Druckverlust und Kosten. Z41X, D71X und DN80 – Auswahlhilfe für B2B-Einkäufer."
	type="article"
	locale="de"
	faq={faq}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/de/" class="hover:text-blue-600">Startseite</a>
			<span>/</span>
			<span class="text-gray-600">Leitfäden</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Leitfaden für Industriearmaturen</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Absperrschieber oder Absperrklappe: Welche Armatur für Brandschutzsysteme?</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Dies ist eine der häufigsten Fragen bei der Beschaffung von Brandschutzausrüstung: Absperrschieber oder Absperrklappe? Die ehrliche Antwort lautet, dass beide nicht austauschbar, sondern komplementär sind. Jede Armatur hat einen Einsatzbereich, in dem sie eindeutig die richtige Wahl ist, und die meisten fachgerecht geplanten Brandschutzanlagen verwenden beide. Dieser Leitfaden bietet einen Entscheidungsrahmen auf Grundlage von Durchfluss, Platzbedarf, Betätigungsgeschwindigkeit und Kosten – mit Bezug auf die tatsächlichen Armaturenkonfigurationen in Feuerlösch-Hauptleitungen und Sprinkleranlagen.</p>

			<!-- Produktübersicht -->
			<div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
				{valveProducts.map(p => (
					<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-32 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="how-they-work" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Funktionsweise: ein schneller Vergleich</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Ein <strong>Absperrschieber</strong> verwendet eine Keilplatte, die senkrecht zum Strömungsweg verschoben wird. Bei vollständig geöffneter Armatur befindet sich die Keilplatte vollständig außerhalb des Wasserwegs. Dadurch entsteht eine gerade, voll durchgängige Öffnung – deshalb weisen Absperrschieber einen vernachlässigbaren Druckverlust auf. Eine <strong>Absperrklappe</strong> verwendet eine drehbare Klappenscheibe auf einer zentralen Welle. Die Scheibe bleibt auch im geöffneten Zustand im Wasserweg und erzeugt einen kleinen, aber messbaren Druckverlust; dafür lässt sich die Armatur mit einer einfachen Vierteldrehung betätigen.</p>
			<p class="text-gray-700 leading-relaxed">Dieser eine mechanische Unterschied bestimmt nahezu alle praktischen Unterschiede zwischen beiden Bauarten.</p>

			<h2 id="head-to-head-gate-vs-butterfly" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Direktvergleich: Absperrschieber vs. Absperrklappe</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Kriterium</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Absperrschieber (Z41X)</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Absperrklappe (D71X)</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Strömungseigenschaften</td>
							<td class="px-4 py-3 text-gray-700">Voller Durchgang, nahezu kein Druckverlust</td>
							<td class="px-4 py-3 text-gray-700">Scheibe im Strömungsweg, geringer Druckverlust</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Betätigungsgeschwindigkeit</td>
							<td class="px-4 py-3 text-gray-700">Mehrfachumdrehung (langsamer, besonders bei großen Nennweiten)</td>
							<td class="px-4 py-3 text-gray-700">Vierteldrehung (schnell, einfach anzutreiben)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Platzbedarf &amp; Gewicht</td>
							<td class="px-4 py-3 text-gray-700">Große Baulänge, hohes Gewicht bei großen DN</td>
							<td class="px-4 py-3 text-gray-700">Kompakte Wafer-Bauform, bis zu 70 % leichter</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Kosten (gleiche DN/PN)</td>
							<td class="px-4 py-3 text-gray-700">Höhere Material- und Bearbeitungskosten</td>
							<td class="px-4 py-3 text-gray-700">Typischerweise 20–40 % niedriger</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Dichtheit</td>
							<td class="px-4 py-3 text-gray-700">Blasenfreie Dichtheit mit weichdichtendem Sitz</td>
							<td class="px-4 py-3 text-gray-700">Gummiert, dicht bei Nenndruck</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Beste Anwendung</td>
							<td class="px-4 py-3 text-gray-700">Hauptabsperrung, voller Durchfluss im geöffneten und geschlossenen Zustand</td>
							<td class="px-4 py-3 text-gray-700">Strangregelung, Drosselung, beengte Platzverhältnisse</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 id="where-each-valve-belongs" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Einsatzbereiche in Brandschutzsystemen</h2>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Absperrschieber für die Hauptabsperrung</h3>
			<p class="text-gray-700 leading-relaxed mb-4">In Feuerlösch-Hauptleitungen und Pumpendruckleitungen hat die Bereitstellung eines maximalen Durchflusses bei minimalem Reibungsverlust Priorität. Ein <a href="/de/products/resilient-seat-flanged-gate-valve-z41x/" class="text-brand-blue font-semibold hover:underline">weichdichtender Absperrschieber Z41X aus duktilem Gusseisen</a> ist hier die Standardarmatur für die Absperrung: voller Durchgang, blasenfreies Schließen und ein flacher, unbehinderter Wasserweg im geöffneten Zustand. Da diese Armaturen nur selten betätigt werden (ausschließlich Öffnen und Schließen), ist die langsamere Mehrfachumdrehung kein praktischer Nachteil.</p>
			<h3 class="text-xl font-bold text-gray-800 mt-6 mb-3">Absperrklappen für Strangleitungen und beengte Platzverhältnisse</h3>
			<p class="text-gray-700 leading-relaxed mb-4">Wenn Armaturen in Sprinkler-Steigleitungsräumen, Technikräumen oder Armaturenbaugruppen dicht angeordnet sind, ist Platz gleich Kosten. Die <a href="/de/products/wafer-type-butterfly-valve-d71x/" class="text-brand-blue font-semibold hover:underline">Absperrklappe D71X in Wafer-Bauform</a> wird zwischen zwei Flanschen montiert und benötigt nur einen Bruchteil der Baulänge und des Gewichts eines Absperrschiebers. Ihr Vierteldrehhebel oder Schneckenrad erleichtert die Betätigung und die Montage eines Antriebs. Damit ist sie die Standardwahl für die Regelung von Sprinklersträngen und die Abschnittsabsperrung.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Eine vollständige Übersicht über Sprinklerarmaturen – Nassalarm-, Sprühflut- und vorgesteuerte Systeme – finden Sie in unserem <a href="/de/guides/fire-sprinkler-system-valves-guide/" class="text-brand-blue font-semibold hover:underline">Leitfaden zu Armaturen für Sprinkleranlagen</a>.</p>

			<h2 id="signal-valves-dn80" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Signalarmaturen: die DN80-Spezialisten</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Sprinkleranlagen nach Vorschriften im Stil der NFPA 13 erfordern eine überwachte Absperrarmatur: Wenn jemand die Zulaufarmatur schließt, muss die Brandmeldezentrale sofort darüber informiert werden. Die <a href="/de/products/signal-grooved-wafer-butterfly-valve-dn80/" class="text-brand-blue font-semibold hover:underline">genutete Signal-Absperrklappe DN80 in Wafer-Bauform</a> verbindet einen Überwachungs- bzw. Endschalter mit einem genuteten Anschluss. Sie wird mit Kupplungen in die Rohrleitung eingebaut, meldet der Zentrale ihren Öffnungs- bzw. Schließzustand und bietet zugleich die Platz- und Kostenvorteile einer Absperrklappe. Diese Armatur wird spezifiziert, wenn der Plan eine „überwachte OS&amp;Y- oder Absperrklappe“ fordert.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Entscheiden Sie noch zwischen Nass-, Trocken- oder vorgesteuerten Systemen? Unser <a href="/de/guides/fire-sprinkler-system-wet-dry-preaction/" class="text-brand-blue font-semibold hover:underline">Vergleich von Nass-, Trocken- und vorgesteuerten Sprinklersystemen</a> erläutert, welches System zu welchem Gebäuderisikoprofil passt.</p>

			<h2 id="purchasing-considerations" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Kaufkriterien für B2B-Einkäufer</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Gehäusewerkstoff und Beschichtung spezifizieren</strong> – duktiles Gusseisen QT450 mit Epoxidbeschichtung widersteht der Korrosion in Nassanlagen; fordern Sie die Beschichtungsspezifikation im Angebot an.</li>
				<li><strong>Druckstufe an das Netz anpassen</strong> – PN16 ist Standard; bestätigen Sie vor der Bestellung den statischen Druck und verwenden Sie für Hochhauszonen PN25.</li>
				<li><strong>Die Anschlussart ist entscheidend</strong> – geflanscht bei Absperrschiebern, Wafer- oder genutet bei Absperrklappen; stimmen Sie die Auswahl mit dem Rohrleitungsplan ab (genutete Kupplungen verkürzen die Montagezeit).</li>
				<li><strong>Bei Signalarmaturen muss die Schalterspezifikation angegeben sein</strong> – fordern Sie Schaltertyp und IP-Schutzart für die Schnittstelle zur Brandmeldezentrale an.</li>
				<li><strong>Prüfberichte anfordern</strong> – hydrostatische Prüfbescheinigungen und Sitzdichtheitsprüfungen für die tatsächliche Charge, keine allgemeine Vorlage.</li>
				<li><strong>Bestellung bündeln</strong> – die Bestellung von Absperrschiebern, Absperrklappen und Signalarmaturen bei einem zertifizierten Hersteller vereinfacht die Zertifizierungsunterlagen und die Ersatzteilverwaltung. Nutzen Sie vor der Lieferantenentscheidung unsere <a href="/de/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">B2B-Checkliste für die Beschaffung von Armaturen</a>.</li>
			</ul>

			<h2 id="recommendation-summary" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Zusammenfassung der Empfehlungen</h2>
			<div class="bg-gray-50 rounded-xl border border-gray-200 p-6 my-5">
				<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2">
					<li><strong>Feuerlösch-Hauptleitungen / Pumpendruckleitungen → Absperrschieber (Z41X)</strong>: voller Durchfluss, minimaler Verlust, zuverlässige Absperrung.</li>
					<li><strong>Strangleitungen / Steigleitungsräume / Armaturenbaugruppen → Absperrklappe (D71X)</strong>: kompakt, leicht und schnell zu betätigen.</li>
					<li><strong>Überwachte Absperrung in Sprinkleranlagen → Signalarmatur (DN80)</strong>: integrierter Überwachungsschalter und genuteter Anschluss für eine schnelle Montage.</li>
					<li>Bei Unsicherheit sollten Sie den Systemplaner konsultieren – die meisten Projekte benötigen alle drei Armaturentypen.</li>
				</ul>
			</div>

			<!-- Abschnitt: Häufig gestellte Fragen -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Häufig gestellte Fragen</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- Handlungsaufforderung -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Planen Sie ein Armaturenpaket für eine Brandschutzanlage?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Teilen Sie uns Ihren Rohrleitungsplan und die Druckstufe mit – wir erstellen innerhalb von 12 Stunden ein Angebot für Absperrschieber, Absperrklappen und Signalarmaturen als zertifiziertes Gesamtpaket.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/de/contact/?product=Armaturenauswahl" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Angebot anfordern</a>
						<a href="https://wa.me/8618684324501?text=Hallo%2C%20ich%20ben%C3%B6tige%20Hilfe%20bei%20der%20Auswahl%20von%20Armaturen%20f%C3%BCr%20eine%20Brandschutzanlage" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Per WhatsApp chatten</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
