---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'do-you-need-a-water-cannon', label: '1. Benötigen Sie tatsächlich einen Löschmonitor?' },
	{ id: 'fixed-remote-or-auto-tracking', label: '2. Fest, fernsteuerbar oder automatisch schwenkend?' },
	{ id: 'sizing-flow-and-range', label: '3. Durchfluss und Reichweite auslegen' },
	{ id: 'control-and-integration', label: '4. Steuerung und Integration' },
	{ id: 'procurement-checklist', label: '5. Beschaffungs-Checkliste' },
	{ id: 'faq', label: 'Häufig gestellte Fragen' }
];

const faq = [
	{
		question: 'Wann benötige ich statt herkömmlicher Sprinkler einen Löschmonitor?',
		answer: 'Löschmonitore eignen sich für große offene oder hohe Räume, in denen eine Sprinklerabdeckung unpraktisch ist: petrochemische Prozessbereiche, Tanklager für Öl und LNG, Verladeterminals, Flugzeughangars und große Lagerhallen. Sie erzeugen einen konzentrierten Strahl mit hohem Durchfluss über 50–110 m, der manuell, fernbedient oder automatisch gesteuert wird.'
	},
	{
		question: 'Welchen Durchfluss und welche Reichweite benötige ich?',
		answer: 'Der Durchfluss richtet sich nach dem Risiko: 5–30 L/s eignen sich für Lagerhallen und Atrien, während 30–200 L/s für Tanklager und Prozessanlagen eingesetzt werden. Die Reichweite hängt vom Eintrittsdruck ab und beträgt bei Nennbetrieb typischerweise 50–110 m. Senden Sie uns Ihren Lageplan; unsere Ingenieure legen das passende Modell aus.'
	},
	{
		question: 'Fernsteuerbarer oder automatisch schwenkender Löschmonitor – welche Ausführung soll ich wählen?',
		answer: 'Wenn ein Bediener vor Ort sein kann, bieten fernsteuerbare Modelle eine flexible manuelle Übersteuerung aus sicherer Entfernung. Für unbemannte Bereiche oder Risiken rund um die Uhr erkennen, zielen und löschen automatisch schwenkende Monitore mit IR-/UV-Erkennung innerhalb von 30 Sekunden ohne menschliches Eingreifen.'
	},
	{
		question: 'Können Löschmonitore mit Schaum betrieben werden?',
		answer: 'Ja. Unsere PS-Serie unterstützt sowohl Wasser als auch Schaum; eine Schaummitteldosierung kann für Risiken der Brandklasse B (brennbare Flüssigkeiten) integriert werden. Der Schaumschrank PSG30 ist eine vollständige, vormontierte Lösung für kleinere Brennstoff- und Chemikalienrisiken.'
	},
	{
		question: 'Liefern Sie den Löschmonitor als Komplettsystem mit Ventilen, Kupplungen und Pumpen?',
		answer: 'Ja. Wir fertigen den Löschmonitor in unseren eigenen Produktionslinien und liefern ihn zusammen mit abgestimmten Ventilen, Kupplungen, Hydranten und Zubehör für den vollständigen Löschkreislauf. Dadurch erhalten Sie Ihre Bestellung als Komplettpaket aus einer Fertigung.'
	}
];

const cannonProducts = [
	{
		slug: 'auto-tracking-jet-suppression-cannon-zdms',
		name: 'Automatisch schwenkender Löschmonitor (ZDMS)',
		img: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		desc: 'IR-/UV-Erkennung, 5–150 L/s'
	},
	{
		slug: 'manual-fire-water-cannon-ps',
		name: 'Manueller Löschmonitor (PS)',
		img: '/assets/products/manual-fire-water-cannon-ps.webp',
		desc: '20–200 L/s, bis 110 m'
	},
	{
		slug: 'foam-fire-hydrant-cabinet-psg30',
		name: 'Schaumschrank (PSG30)',
		img: '/assets/06_extinguishing_cannons/cannon_p42.webp',
		desc: '3 % AFFF für Brennstoff- und Chemikalienbrände'
	}
];

const referencePages = [
	{ slug: 'auto-tracking-jet-suppression-cannon-zdms', name: 'Automatisch schwenkender Löschmonitor (ZDMS)' },
	{ slug: 'manual-fire-water-cannon-ps', name: 'Manueller Löschmonitor (PS)' },
	{ slug: 'foam-fire-hydrant-cabinet-psg30', name: 'Schaumschrank (PSG30)' }
];
---

<Layout
	title="Löschmonitor kaufen: fest, fernbedient oder intelligent?"
	description="B2B-Leitfaden zur Auswahl von Löschmonitoren: Bauart, Fernsteuerung, Durchfluss, Reichweite, Schaumeignung, Integration und Beschaffungs-Checkliste."
	type="article"
	locale="de"
	faq={faq}
	breadcrumbs={[{ name: 'Leitfäden', href: '/de/blog/' }, { name: 'Leitfaden zu Löschmonitoren' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Brotkrümelnavigation -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/de/" class="hover:text-blue-600">Startseite</a>
			<span>/</span>
			<a href="/de/blog/" class="hover:text-blue-600">Leitfäden</a>
			<span>/</span>
			<span class="text-gray-600">Leitfaden zu Löschmonitoren</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Leitfaden zur industriellen Brandbekämpfung</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Leitfaden zum Kauf von Löschmonitoren: fest, fernbedient oder intelligent?</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Ein Löschmonitor ist ein Monitor mit hohem Durchfluss, der einen konzentrierten Strahl über 50–110 m abgibt – die bevorzugte Löschtechnik für petrochemische Anlagen, Tanklager, Terminals und große Lagerhallen, in denen Sprinkler nicht ausreichen. Die Kaufentscheidung hängt von vier Fragen ab: fest oder steuerbar, welcher Durchfluss, welche Reichweite und ob das Gerät selbstständig reagieren muss. Dieser Leitfaden erläutert jeden Punkt.</p>

			<!-- Produktübersicht -->
			<div class="mt-8 grid grid-cols-2 lg:grid-cols-3 gap-4">
				{cannonProducts.map(p => (
					<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="do-you-need-a-water-cannon" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Benötigen Sie tatsächlich einen Löschmonitor?</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Löschmonitore rechtfertigen ihre Kosten in drei Situationen: <strong>große offene Bereiche</strong> (Lagerhallen, Atrien, Hangars), in denen fest installierte Sprinkler eine unpraktische Dichte erfordern würden; <strong>Außenrisiken</strong> (Tanklager, Verladeeinrichtungen, Prozessanlagen), in denen keine Decke für die Montage von Sprinklern vorhanden ist; und <strong>Risiken mit hohem Sachwert</strong>, bei denen eine schnelle, konzentrierte Brandbekämpfung großflächige Wasserschäden vermeidet. Wenn es sich bei Ihrem Standort um ein geschlossenes Gebäude mit üblicher Nutzung handelt, ist wahrscheinlich eine Sprinkleranlage die richtige Lösung – siehe unsere <a href="/de/fire-sprinkler-systems/" class="text-brand-blue font-semibold hover:underline">Seite zu Sprinkleranlagen</a>.</p>

			<h2 id="fixed-remote-or-auto-tracking" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Fest, fernsteuerbar oder automatisch schwenkend?</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Bauart</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Funktionsweise</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Geeignet für</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Fest installierter Monitor</td>
							<td class="px-4 py-3 text-gray-700">Ausrichtung über Handhebel, selbsthemmendes Getriebe hält die Position</td>
							<td class="px-4 py-3 text-gray-700">Standorte mit Bedienpersonal; wirtschaftliche Basislösung</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Fernsteuerbar</td>
							<td class="px-4 py-3 text-gray-700">Kabelgebundene oder kabellose Steuerung aus sicherer Entfernung, Drehung um 360°</td>
							<td class="px-4 py-3 text-gray-700">Gefahrenbereiche, die für eine manuelle Bedienung zu nah liegen</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Automatisch schwenkend</td>
							<td class="px-4 py-3 text-gray-700">IR-/UV-Flammenerkennung, selbstständige Ausrichtung und Löschstrahl in ca. 30 s</td>
							<td class="px-4 py-3 text-gray-700">Unbemannte Bereiche, Risiken rund um die Uhr, kurze Reaktionszeiten</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed mb-4">Der <a href="/de/products/auto-tracking-jet-suppression-cannon-zdms/" class="text-brand-blue font-semibold hover:underline">automatisch schwenkende ZDMS-Löschmonitor</a> kombiniert Infrarot- und Ultraviolettsensoren, um vor der Auslösung eine echte Flamme zu bestätigen und Fehlalarme zu reduzieren. Die manuelle Übersteuerung ist über PC, mobile App oder Zentralschrank möglich. Die <a href="/de/products/manual-fire-water-cannon-ps/" class="text-brand-blue font-semibold hover:underline">manuelle PS-Serie</a> bleibt eine zuverlässige und kostengünstige Lösung, wenn Bedienpersonal vorhanden ist.</p>

			<h2 id="sizing-flow-and-range" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Durchfluss und Reichweite auslegen</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Zwei Werte bestimmen die Leistungsfähigkeit eines Löschmonitors: <strong>Durchfluss</strong> (L/s) und <strong>Strahlreichweite</strong> (m). Der Durchfluss wird durch das Risiko und die Berechnung des Löschwasserbedarfs festgelegt; die Reichweite hängt vom Eintrittsdruck und der Düsenkonstruktion ab.</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Lagerhallen und Atrien</strong>: Monitore mit 5–30 L/s und einem Überwachungsradius von 40–65 m – der optimale Einsatzbereich des ZDMS.</li>
				<li><strong>Tanklager und Prozessanlagen</strong>: 30–200 L/s mit Strahlreichweiten bis 110 m – der Leistungsbereich der PS-Serie.</li>
				<li><strong>Schaumrisiken</strong>: Legen Sie eine Schaummitteldosierung oder eine vormontierte Einheit wie den <a href="/de/products/foam-fire-hydrant-cabinet-psg30/" class="text-brand-blue font-semibold hover:underline">Schaumschrank PSG30</a> für Risiken der Brandklasse B fest.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Faustregel: Wenn Sie den erforderlichen Durchfluss nicht sicher auslegen können, senden Sie dem Lieferanten den Lageplan und den Löschwasserbedarf. Das richtige Modell ergibt sich aus dem Risiko – nicht aus einer Katalogseite.</p>

			<h2 id="control-and-integration" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Steuerung und Integration</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Automatisch schwenkende Löschmonitore sind nur so leistungsfähig wie ihre Integration: Sie sollten mit der Brandmeldezentrale verbunden werden, und der Weg zur manuellen Übersteuerung (lokaler Schrank oder Fernbedienstation) muss mit Ihrem Bedienpersonal geprüft werden. Kontrollieren Sie die Kommunikationsschnittstelle, die Explosionsschutzklasse, wenn der Monitor in einem klassifizierten Bereich steht (Exde II BT4 Gb ist verfügbar), sowie die IP-Schutzart für den Einsatz im Freien.</p>

			<h2 id="procurement-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Beschaffungs-Checkliste</h2>
			<ol class="list-decimal pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Definieren Sie das Risiko und den Löschwasserbedarf; bestätigen Sie Durchfluss und Reichweite mit dem Lieferanten.</li>
				<li>Wählen Sie die Steuerungsart: fest, fernsteuerbar oder automatisch schwenkend – passend zu Personalbesetzung und Reaktionszeit.</li>
				<li>Bestätigen Sie die Medienverträglichkeit (nur Wasser oder Schaummitteldosierung).</li>
				<li>Prüfen Sie Explosionsschutz und IP-Schutzart für die Montageumgebung.</li>
				<li>Fordern Sie das Komplettpaket für den Löschkreislauf an: Monitor, Ventile, Kupplungen und Hydranten – eine Stückliste, ein Werk.</li>
				<li>Klären Sie Mindestbestellmenge, Lieferzeit, Unterstützung bei der Montage und Ersatzteile im kommerziellen Angebot.</li>
			</ol>

			<!-- Verweis auf die Produktseite -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Unsere Löschmonitor-Serie entdecken</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Vergleichen Sie fest installierte, fernsteuerbare und intelligente Modelle mit vollständigen Spezifikationen auf der <a href="/de/fire-water-cannon/" class="text-brand-blue font-semibold hover:underline">Seite zu Löschmonitoren</a>.</p>
			</div>

			<!-- Verwandter Leitfaden -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Verwandter Leitfaden: manuell oder automatisch schwenkend</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Benötigen Sie einen direkten technischen Vergleich zwischen manuellen (PS) und automatisch schwenkenden (ZDMS) Monitoren? Lesen Sie den <a href="/de/guides/fire-water-monitor-selection-guide/" class="text-brand-blue font-semibold hover:underline">Leitfaden zur Auswahl von Löschmonitoren</a>.</p>
			</div>

			<!-- Häufig gestellte Fragen -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Häufig gestellte Fragen</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- Kontaktaufforderung -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Benötigen Sie einen Löschmonitor für Ihren Standort?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Senden Sie uns Ihren Lageplan sowie die erforderliche Reichweite und den Durchfluss. Unsere Ingenieure empfehlen das passende Modell und antworten innerhalb von 12 Stunden mit einem vollständigen Angebot.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/de/contact/?product=Fire%20Water%20Cannon" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Angebot anfordern</a>
						<a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Guten Tag, ich benötige einen Löschmonitor')}`} class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Über WhatsApp chatten</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
