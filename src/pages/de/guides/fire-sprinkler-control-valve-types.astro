	{ slug: 'ul-fm-resilient-seat-osy-gate-valve', name: 'UL/FM-OS&Y-Absperrschieber (genutet)', img: '/assets/products/ul-fm-resilient-seat-osy-gate-valve.webp', desc: 'UL/FM-gelisteter Absperrschieber mit steigender Spindel, 2–10 Zoll, genutete Enden' },
	{ slug: 'signal-grooved-wafer-butterfly-valve-dn80', name: 'Genutete Signal-Wafer-Absperrklappe', img: '/assets/products/signal-grooved-wafer-butterfly-valve-dn80.webp', desc: 'DN80 PN16 mit integriertem Überwachungsschalter' },
	{ slug: 'wet-alarm-check-valve-zsfz-150', name: 'Nassalarm-Rückschlagventil ZSFZ-150', img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp', desc: 'Nassalarm-Rückschlagventil DN100–DN200 mit Verzögerungskammer' },
	{ slug: 'deluge-alarm-valve-zsfm', name: 'Sprühflut-Alarmventilgruppe (ZSFM)', img: '/assets/products/deluge-alarm-valve-zsfm.webp', desc: 'Membrangesteuerte Systemarmatur, DN50–DN300' },
	{ slug: 'pre-action-alarm-system-zsfy', name: 'Pre-Action-Alarmanlage (ZSFY)', img: '/assets/products/pre-action-alarm-system-zsfy.jpg', desc: 'Ausfallsichere Doppelaktivierung für wasserempfindliche Räume' }
];

const referencePages = [
	{ slug: 'ul-fm-resilient-seat-osy-gate-valve', name: 'UL/FM-OS&Y-Absperrschieber' },
	{ slug: 'signal-grooved-wafer-butterfly-valve-dn80', name: 'Genutete Signal-Wafer-Absperrklappe' },
	{ slug: 'wet-alarm-check-valve-zsfz-150', name: 'Nassalarm-Rückschlagventil ZSFZ-150' },
	{ slug: 'deluge-alarm-valve-zsfm', name: 'Sprühflut-Alarmventilgruppe ZSFM' },
