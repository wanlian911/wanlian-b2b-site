---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'the-three-system-types', label: '1. Die drei Systemtypen im Vergleich' },
	{ id: 'choosing-sprinkler-heads', label: '2. Sprinklerköpfe auswählen' },
	{ id: 'components-your-bom-needs', label: '3. Erforderliche BOM-Komponenten' },
	{ id: 'compliance-notes', label: '4. Hinweise zur Konformität' },
	{ id: 'procurement-checklist', label: '5. Beschaffungscheckliste' },
	{ id: 'faq', label: 'Häufig gestellte Fragen' }
];

const faq = [
	{
		question: 'Nass-, Trocken- oder Pre-Action-System – wie wähle ich das richtige Sprinklersystem?',
		answer: 'Nassanlagen sind der Standard für beheizte Gebäude: schnellste Reaktion und niedrigste Kosten. Trockenanlagen eignen sich für unbeheizte Bereiche wie Parkhäuser und Kühllager, in denen Rohrleitungen einfrieren könnten. Pre-Action-Systeme schützen wasserempfindliche Bereiche wie Rechenzentren, Archive und Museen, indem sie Wasser zurückhalten, bis zwei unabhängige Signale einen Brand bestätigen. Die Bauvorschriften und die Gefährdungsklasse Ihres Gebäudes bestimmen die Mindestanforderung.'
	},
	{
		question: 'Was bedeuten K-Faktor und Temperaturklasse bei einem Sprinklerkopf?',
		answer: 'Der K-Faktor definiert die Wassermenge, die ein Sprinklerkopf bei einem bestimmten Druck abgibt – K80 und K115 sind die gängigen Standards. Die Temperaturklasse legt den Auslösepunkt fest (57 °C bis 141 °C, farbcodierte Glasampullen). Stimmen Sie beide Werte auf Gefährdung und Deckenhöhe ab; Sprinklerköpfe mit Schnellansprache (3-mm-Glasampulle) reagieren schneller als Ausführungen mit Standardansprache (5-mm-Glasampulle).'
	},
	{
		question: 'Sind Wanlian-Sprinklerkomponenten UL-gelistet?',
		answer: 'Ja. Unsere Sprinklerköpfe und Systemkomponenten sind, soweit zutreffend, UL/ULC-gelistet; die Zertifikate stehen auf unserer Zertifikatsseite zur Verfügung. Vor der Angebotserstellung bestätigen unsere Ingenieure das genaue Zertifizierungspaket für den Zielmarkt Ihres Projekts.'
	},
	{
		question: 'Können Sie eine vollständige BOM für ein Sprinklersystem liefern?',
		answer: 'Ja. Senden Sie uns die Projektzeichnungen oder eine Komponentenliste. Wir bieten Sprinklerköpfe, flexible Anschlüsse, Alarmventile, Strömungswächter, Schmutzfänger und Zubehör als Paket an – ein einziger Werksauftrag für den gesamten Kreislauf mit aufeinander abgestimmten Spezifikationen.'
	},
	{
		question: 'Welche Funktion hat das Nassalarm-Rückschlagventil in einer Nassanlage?',
		answer: 'Das Nassalarm-Rückschlagventil (z. B. ZSFZ) trennt die Versorgungsleitung von der Sprinklerrohrleitung und löst bei einsetzendem Durchfluss eine hydraulische Alarmglocke aus. Die Verzögerungskammer filtert dabei Fehlalarme durch Druckstöße. Strömungswächter (ZSJZ) melden anschließend die ausgelöste Zone an die Zentrale.'
	}
];

const referencePages = [
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'Glasampullen-Sprinklerkopf (ZST)',
		img: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		desc: 'K=80/115, 57–141 °C, hängend/stehend/seitlich'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Nassalarm-Rückschlagventil (ZSFZ)',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'Alarmglocke + Verzögerungskammer, DN100–DN200'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Pre-Action-System (ZSFY)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Ausfallsichere Doppelaktivierung für kritische Räume'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Strömungswächter (ZSJZ)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'Einstellbare Verzögerung 2–60 s, DN50–DN200'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Sprühflut-Alarmventilgruppe (ZSFM)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Für Sprühflut- und Wasserlöschanlagen'
	}
];
---

<Layout
	title="Sprinkleranlagen: Nass-, Trocken- oder Pre-Action-System?"
	description="Vergleich von Nass-, Trocken- und Pre-Action-Sprinkleranlagen: Sprinklerköpfe, Komponenten, Normen und B2B-Beschaffungscheckliste für Projekte."
	type="article"
	locale="de"
	faq={faq}
	breadcrumbs={[{ name: 'Leitfäden', href: '/de/blog/' }, { name: 'Leitfaden zu Sprinkleranlagen' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/de/" class="hover:text-blue-600">Startseite</a>
			<span>/</span>
			<a href="/de/blog/" class="hover:text-blue-600">Leitfäden</a>
			<span>/</span>
			<span class="text-gray-600">Leitfaden zu Sprinkleranlagen</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Leitfaden zu Sprinkleranlagen</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Sprinkleranlagen: Nass-, Trocken- oder Pre-Action-System? (Leitfaden 2026)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Sprinkleranlagen verfolgen ein gemeinsames Ziel: Wasser schnell zum Brand zu bringen. Die Rohrleitungsanordnung zwischen Wasserversorgung und Sprinklerkopf beeinflusst jedoch Reaktionszeit, Frostbeständigkeit und das Risiko von Wasserschäden grundlegend. Dieser Leitfaden vergleicht die drei wichtigsten Systemtypen, erklärt die Auswahl von Sprinklerköpfen und nennt die Komponenten, die Ihre BOM tatsächlich benötigt.</p>

			<!-- Produktübersicht -->
			<div class="mt-8 grid grid-cols-2 lg:grid-cols-5 gap-4">
				{referencePages.map(p => (
					<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="the-three-system-types" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Die drei Systemtypen im Vergleich</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Typ</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Funktionsweise</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Typischer Einsatz</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Nassanlage</td>
							<td class="px-4 py-3 text-gray-700">Rohrleitungen ständig gefüllt; Kopf öffnet → sofortige Wasserabgabe</td>
							<td class="px-4 py-3 text-gray-700">Beheizte Gewerbe-, Wohn- und Industriegebäude</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Trockenanlage</td>
							<td class="px-4 py-3 text-gray-700">Rohrleitungen mit Druckluft oder Stickstoff; Trockenrohrventil lässt bei Auslösung Wasser ein</td>
							<td class="px-4 py-3 text-gray-700">Unbeheizte Bereiche: Parkhäuser, Kühllager, Verladerampen</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Pre-Action</td>
							<td class="px-4 py-3 text-gray-700">Mit Luft gefüllte Rohrleitungen; Wasser erst nach zwei unabhängigen Signalen</td>
							<td class="px-4 py-3 text-gray-700">Rechenzentren, Archive, Museen, Computerräume</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed mb-4">Nassanlagen reagieren am schnellsten und verursachen die geringsten Wartungskosten. Deshalb schreiben Bauvorschriften sie überall dort als Standard vor, wo Räume beheizt werden. Trockenanlagen tauschen einige Sekunden Reaktionszeit gegen Frostschutz. Pre-Action-Systeme verzögern die Flutung bewusst, bis die Branderkennung den Brand bestätigt – die richtige Lösung, wenn eine Fehlauslösung ebenso große Schäden verursachen könnte wie der Brand selbst.</p>

			<h2 id="choosing-sprinkler-heads" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Sprinklerköpfe auswählen</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Der Sprinklerkopf ist die Schnittstelle zwischen Anlage und Brand. Drei Parameter bestimmen seine Auslegung:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>K-Faktor</strong> – Abgabekapazität. K80 und K115 decken die meisten Nutzungen ab; höhere K-Faktoren sind für besondere Gefährdungen vorgesehen. Unsere <a href="/de/products/glass-bulb-fire-sprinkler-zst/" class="text-brand-blue font-semibold hover:underline">ZST-Serie</a> bietet beide Ausführungen.</li>
				<li><strong>Temperaturklasse</strong> – Auslösetemperatur von 57 °C (rot) bis 141 °C (blau), mit farbcodierten Glasampullen. Decken bei normaler Gefährdung werden mit 68 °C ausgelegt; Bereiche mit wärmeerzeugenden Anlagen benötigen höhere Temperaturklassen.</li>
				<li><strong>Ansprechverhalten</strong> – Sprinkler mit Schnellansprache (3-mm-Glasampulle) reagieren schneller und sind für Wohnbereiche und geringe Gefährdungen häufig vorgeschrieben; Standardansprache (5-mm-Glasampulle) eignet sich für normale und erhöhte Gefährdungen.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Auch die Einbaulage ist wichtig: Hängende Sprinklerköpfe befinden sich unterhalb der Rohrleitung, stehende oberhalb; Seitenwandsprinkler schützen Korridore und kleine Räume. Stimmen Sie den Sprinklerkopf auf die Deckenkonstruktion ab – nicht nur auf das Katalogfoto.</p>

			<h2 id="components-your-bom-needs" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Erforderliche BOM-Komponenten</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Neben den Sprinklerköpfen umfasst ein vollständiges Sprinklersystem die Alarmventilstation, die Durchflussüberwachung und Schutzkomponenten:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Nassalarm-Rückschlagventil</strong> (<a href="/de/products/wet-alarm-check-valve-zsfz-150/" class="text-brand-blue font-semibold hover:underline">ZSFZ</a>) – trennt die Versorgung von der Sprinklerrohrleitung, löst die hydraulische Alarmglocke aus und filtert mit seiner Verzögerungskammer Fehlalarme durch Druckstöße.</li>
				<li><strong>Sprühflut- und Pre-Action-Ventile</strong> (<a href="/de/products/deluge-alarm-valve-zsfm/" class="text-brand-blue font-semibold hover:underline">ZSFM</a>, <a href="/de/products/pre-action-alarm-system-zsfy/" class="text-brand-blue font-semibold hover:underline">ZSFY</a>) – die Steuerung für Sprühflut- und Pre-Action-Konfigurationen.</li>
				<li><strong>Strömungswächter</strong> (<a href="/de/products/water-flow-indicator-zsjz/" class="text-brand-blue font-semibold hover:underline">ZSJZ</a>) – erkennen den Durchfluss in jeder Zone und melden den ausgelösten Bereich an die Zentrale.</li>
				<li><strong>Y-Schmutzfänger</strong> (<a href="/de/products/telescopic-y-strainer-sgl41h/" class="text-brand-blue font-semibold hover:underline">SGL41H</a>) – halten Partikel von Ventilen und Sprinklerköpfen fern; eine kostengünstige Komponente zur Vermeidung teurer Verstopfungen.</li>
			</ul>

			<h2 id="compliance-notes" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Hinweise zur Konformität</h2>
			<p class="text-gray-700 leading-relaxed mb-4">NFPA 13 regelt die Installation in Nordamerika und dient in vielen Exportmärkten als maßgebliche Referenz. Häufig übersehene Punkte sind zertifizierte Komponenten (soweit zutreffend UL/ULC-gelistet), die korrekte Gefährdungsklassifizierung vor der Auswahl der Löschwasserdichte und eine belastbare Dokumentation. Fordern Sie die tatsächlichen Zertifikate und Chargenprüfberichte an, nicht nur Kataloglogos. Auf unserer <a href="/de/certificates/" class="text-brand-blue font-semibold hover:underline">Zertifikatsseite</a> ist das Zertifizierungspaket veröffentlicht.</p>

			<h2 id="procurement-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Beschaffungscheckliste</h2>
			<ol class="list-decimal pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Klassifizieren Sie die Gefährdung der Nutzung (gering / normal / erhöht) und bestätigen Sie die Auslegungsdichte.</li>
				<li>Wählen Sie den Systemtyp: Nass-, Trocken- oder Pre-Action-System, abhängig von Gebäudetemperatur und Wasserempfindlichkeit.</li>
				<li>Wählen Sie Sprinklerköpfe nach K-Faktor, Temperaturklasse, Ansprechverhalten und Einbaulage aus.</li>
				<li>Stellen Sie sicher, dass die Komponentenzertifizierung (UL/ULC) dem Zielmarkt entspricht.</li>
				<li>Fordern Sie ein gemeinsames BOM-Angebot für Sprinklerköpfe, Ventile, Strömungswächter und Schmutzfänger an.</li>
				<li>Klären Sie Mindestbestellmenge, Lieferzeit und Ersatzteile im kommerziellen Angebot.</li>
			</ol>

			<!-- Querverweis zur Übersichtsseite -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Unsere Komponenten für Sprinkleranlagen entdecken</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Sehen Sie sich das vollständige Sortiment – Sprinklerköpfe, Alarmventile und Strömungswächter – auf der <a href="/de/fire-sprinkler-systems/" class="text-brand-blue font-semibold hover:underline">Seite zu Sprinkleranlagen</a> an.</p>
			</div>

			<!-- Verwandter Leitfaden -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Verwandter Leitfaden: Ventile für Sprinkleranlagen</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Vertiefen Sie Ihr Wissen über Ventilgruppen – ZSFZ für Nassalarm, ZSFM für Sprühflut, ZSFY für Pre-Action und ZSJZ-Strömungswächter. Lesen Sie den <a href="/de/guides/fire-sprinkler-system-valves-guide/" class="text-brand-blue font-semibold hover:underline">Leitfaden zu Ventilen für Sprinkleranlagen</a>.</p>
			</div>

			<!-- FAQ -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Häufig gestellte Fragen</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- Handlungsaufforderung -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Benötigen Sie Komponenten für Sprinkleranlagen?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Senden Sie uns Gebäudetyp und Komponentenliste – innerhalb von 12 Stunden erhalten Sie ein vollständiges BOM-Angebot.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/de/contact/?product=Fire%20Sprinkler%20Systems" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Angebot anfordern</a>
						<a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Hallo, ich benötige Komponenten für Sprinkleranlagen.')}`} class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Über WhatsApp chatten</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
