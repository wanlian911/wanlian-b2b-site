---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'wet-pipe-systems-zsfz', label: '1. Nassanlagen: das Nassalarmventil ZSFZ' },
	{ id: 'deluge-systems-zsfm', label: '2. Sprühflutanlagen: das Sprühflutventil ZSFM' },
	{ id: 'pre-action-systems-zsfy', label: '3. Vorgesteuerte Anlagen: das Doppeltrigger-Ventil ZSFY' },
	{ id: 'zone-detection-zsjz', label: '4. Zonenüberwachung: der Strömungswächter ZSJZ' },
	{ id: 'selecting-the-right-valve', label: '5. Das richtige Ventil für Ihr Projekt auswählen' },
	{ id: 'faq', label: 'Häufig gestellte Fragen' }
];

const faq = [
	{
		question: 'Was ist der Unterschied zwischen einem Nassalarmventil und einem Sprühflutventil?',
		answer: 'Ein Nassalarmventil (ZSFZ) wird in Sprinkleranlagen mit Nassrohrsystem installiert, deren Rohrleitungen ständig mit Wasser gefüllt sind. Es erkennt den durch das Öffnen eines Sprinklerkopfs verursachten Durchfluss und löst den Alarm aus. Ein Sprühflutventil (ZSFM) ist ein trockenes Steuerventil für Sprühflutanlagen, das den gesamten geschützten Bereich gleichzeitig mit Wasser beaufschlagt – typischerweise in Bereichen mit hoher Gefährdung wie Chemieanlagen und Kraftwerken.'
	},
	{
		question: 'Wann sollte eine vorgesteuerte Anlage (ZSFY) eingesetzt werden?',
		answer: 'Vorgesteuerte Anlagen (ZSFY) kombinieren ein Sprühflutventil mit automatischen Sprinklern und erfordern zwei unabhängige Auslösesignale (z. B. Rauchmeldung und Wärmeerkennung), bevor Wasser in die Rohrleitung eintritt. Sie werden für wasserempfindliche Umgebungen wie Museen, Archive, Rechenzentren und Kühllager spezifiziert, in denen eine unbeabsichtigte Auslösung vermieden werden muss.'
	},
	{
		question: 'Welche Funktion hat ein Strömungswächter (ZSJZ) in einer Sprinkleranlage?',
		answer: 'Ein Strömungswächter mit Klappe (ZSJZ) wird in den Abzweigleitungen der Sprinkler installiert. Er erkennt den durch einen geöffneten Sprinklerkopf verursachten Wasserstrom und sendet ein Signal an die Brandmeldezentrale, um die ausgelöste Zone zu identifizieren. Eine einstellbare Zeitverzögerung filtert vorübergehende Druckstöße.'
	},
	{
		question: 'Sind die Ventile ZSFZ, ZSFM und ZSFY untereinander austauschbar?',
		answer: 'Nein. Jeder Ventiltyp ist einer bestimmten Systemarchitektur zugeordnet: ZSFZ für Nassanlagen, ZSFM für Sprühflutanlagen und ZSFY für vorgesteuerte Anlagen. Der Austausch eines Ventils gegen einen anderen Typ beeinträchtigt die Systemlogik und kann dazu führen, dass die Anlage die normative Prüfung nicht besteht. Die Auswahl muss entsprechend der Gefährdungsklasse und der Auslegungsgrundlage erfolgen.'
	},
	{
		question: 'Welche Zertifizierungen sind für Sprinkler-Alarmventile erforderlich?',
		answer: 'Sprinkler-Alarmventil-Baugruppen sollten von der für den Zielmarkt zuständigen Zulassungsstelle gelistet sein – in Nordamerika üblicherweise UL/FM, in Europa CE und für Projekte im Vereinigten Königreich bzw. im Commonwealth LPCB; ISO 9001 bildet die Qualitätsgrundlage. Wanlian liefert ZSFZ-/ZSFM-/ZSFY-Baugruppen mit auf den Zielmarkt abgestimmten Zertifizierungsunterlagen.'
	}
];

const referencePages = [
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Nassalarm-Rückschlagventil ZSFZ-150',
		img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp',
		desc: 'Nassalarmventil mit Durchflusserkennung und Alarmauslösung'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Sprühflut-Alarmventilgruppe (ZSFM-Serie)',
		img: '/assets/products/deluge-alarm-valve-zsfm.webp',
		desc: 'Membrangesteuertes Sprühflutventil für Bereiche mit hoher Gefährdung'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Vorgesteuerte Sprühflut-Alarmanlage (ZSFY-Serie)',
		img: '/assets/products/pre-action-alarm-system-zsfy.jpg',
		desc: 'Ausfallsichere vorgesteuerte Anlage mit Doppeltrigger für wasserempfindliche Zonen'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Strömungswächter mit Klappe (ZSJZ-Serie)',
		img: '/assets/products/water-flow-indicator-zsjz.png',
		desc: 'Zonenüberwachung mit einstellbarer Verzögerung für Nasssprinkleranlagen'
	}
];
---

<Layout
	title="Sprinklerventile: Nass-, Sprühflut- und Pre-Action-Systeme"
	description="Leitfaden zu Sprinklerventilen: ZSFZ-Nassalarm, ZSFM-Sprühflut, ZSFY-Pre-Action und ZSJZ-Strömungswächter – Funktion, Auswahl und Anfrage."
	type="article"
	locale="de"
	faq={faq}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/de/" class="hover:text-blue-600">Startseite</a>
			<span>/</span>
			<span class="text-gray-600">Leitfäden</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Leitfaden für Sprinkleranlagen</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Sprinklerventile für Brandschutzanlagen: der vollständige Leitfaden (Nass, Sprühflut und Pre-Action)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Jede Sprinkleranlage basiert auf einer Steuerventil-Baugruppe – dem Punkt, an dem die Wasserversorgung zum Feuerlöschsystem wird. Wird der falsche Ventiltyp spezifiziert, kann die gesamte Systemlogik die Prüfung nicht bestehen. Dieser Leitfaden erläutert die vier Ventiltypen, die den modernen Sprinkleranlagenbau prägen, ihre jeweilige Funktion und die zu schützenden Nutzungsarten. Für die Absperr- und Abschnittsventile an der Baugruppe – OS&amp;Y-Absperrschieber, Signal-Absperrklappe und Rückschlagventile – lesen Sie unseren <a href="/de/guides/fire-sprinkler-control-valve-types/" class="text-brand-blue font-semibold hover:underline">Leitfaden zu Steuerventiltypen für Sprinkleranlagen</a>.</p>

			<div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-4">
				{referencePages.map(p => (
					<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="wet-pipe-systems-zsfz" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Nassanlagen: das Nassalarmventil ZSFZ</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Nassanlagen sind die häufigste Sprinklerkonfiguration: Die Rohrleitungen sind dauerhaft mit Wasser gefüllt, und jeder Sprinklerkopf öffnet einzeln, sobald sein wärmeempfindliches Element auslöst. Das <a href="/de/products/wet-alarm-check-valve-zsfz-150/" class="text-brand-blue font-semibold hover:underline">Nassalarm-Rückschlagventil ZSFZ</a> sitzt am Steigrohr der Anlage und erfüllt zwei Aufgaben: Es verhindert den Rückfluss aus der Anlage in die Versorgung und erkennt den beim Öffnen eines Sprinklerkopfs entstehenden Wasserstrom, wodurch mechanische und elektrische Alarme ausgelöst werden. Der Durchfluss in die Anlage bleibt bestehen, bis die Versorgung manuell abgesperrt wird.</p>
			<p class="text-gray-700 leading-relaxed">Nassanlagen sind schnell, einfach und kostengünstig zu warten – sie dürfen jedoch nicht eingesetzt werden, wenn die Umgebungstemperatur ein Einfrieren der Rohrleitungen verursachen kann.</p>

			<h2 id="deluge-systems-zsfm" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Sprühflutanlagen: das Sprühflutventil ZSFM</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Sprühflutanlagen schützen Bereiche mit hoher Gefährdung, in denen sich ein Brand schneller ausbreiten kann, als einzelne Sprinklerköpfe reagieren: Chemieanlagen, Lackierereien, Kraftwerke und Flugzeughangars. Alle Düsen in einer Sprühflutzone sind offen; die Anlage wird durch ein einziges Steuerventil zurückgehalten – das <a href="/de/products/deluge-alarm-valve-zsfm/" class="text-brand-blue font-semibold hover:underline">Sprühflut-Alarmventil ZSFM</a>. Wenn eine Detektionsanlage (Rauch, Wärme oder Flamme) einen Brand meldet, öffnet das Ventil und beaufschlagt alle Düsen gleichzeitig mit Wasser.</p>
			<p class="text-gray-700 leading-relaxed">Das membrangesteuerte ZSFM öffnet schnell und schließt nach dem Auslösen zuverlässig wieder. Dies ist wichtig, weil Sprühflutzonen oft groß sind und das Ventil den einzigen Ausfallpunkt der Anlage darstellt.</p>

			<h2 id="pre-action-systems-zsfy" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Vorgesteuerte Anlagen: das Doppeltrigger-Ventil ZSFY</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Vorgesteuerte Anlagen verwenden Sprühfluttechnik mit einer besonderen Sprinklerrohrkonfiguration: Die Rohrleitungen sind trocken, und Wasser tritt erst ein, <em>wenn zwei unabhängige Auslösesignale einen Brand bestätigt haben</em>. Die <a href="/de/products/pre-action-alarm-system-zsfy/" class="text-brand-blue font-semibold hover:underline">vorgesteuerte Alarmanlage ZSFY</a> bildet die Steuereinheit dieser Architektur – ein Sprühflutventil, das durch ein Brandmeldesignal betätigt wird, mit automatischen Sprinklern auf der Nachgeschaltetseite, die zusätzlich als einzelne Auslöseelemente wirken.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Warum eine vorgesteuerte Anlage spezifizieren? Drei Gründe sind ausschlaggebend:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Wasserempfindliche Inhalte</strong> – Museen, Archive, Rechenzentren und Transformatorräume: Wasser tritt nur ein, wenn zwei Signale die Auslösung bestätigen.</li>
				<li><strong>Umgebungen mit Frostgefahr</strong> – Kühllager und unbeheizte Lagerhallen: Trockene Rohrleitungen können nicht einfrieren.</li>
				<li><strong>Schutz vor Fehlauslösung</strong> – Die Doppeltrigger-Logik macht eine unbeabsichtigte Auslösung statistisch äußerst unwahrscheinlich.</li>
			</ul>

			<h2 id="zone-detection-zsjz" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Zonenüberwachung: der Strömungswächter ZSJZ</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Sobald die Anlage in Betrieb ist, müssen Feuerwehr und Gebäudeverantwortliche wissen, <em>welche Zone</em> Wasser führt. Der <a href="/de/products/water-flow-indicator-zsjz/" class="text-brand-blue font-semibold hover:underline">Strömungswächter mit Klappe ZSJZ</a> wird an den Sprinkler-Abzweigleitungen installiert: Wenn Wasser strömt, wird die Klappe ausgelenkt und der Schalter sendet ein Signal an die Brandmeldezentrale, das die betroffene Zone identifiziert. Eine einstellbare Zeitverzögerung filtert Druckstöße, die andernfalls Fehlalarme auslösen könnten.</p>

			<h2 id="selecting-the-right-valve" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Das richtige Ventil für Ihr Projekt auswählen</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Nutzung / Anforderung</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Anlagentyp</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Steuerventil</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Büros, Einzelhandel, beheizte Lagerhallen</td>
							<td class="px-4 py-3 text-gray-700">Nassanlage</td>
							<td class="px-4 py-3 text-gray-700">Nassalarmventil ZSFZ</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Chemie, Energie, Luftfahrt, hohe Gefährdung</td>
							<td class="px-4 py-3 text-gray-700">Sprühflut</td>
							<td class="px-4 py-3 text-gray-700">Sprühflutventil ZSFM</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Museen, Rechenzentren, Kühllager</td>
							<td class="px-4 py-3 text-gray-700">Vorgesteuert</td>
							<td class="px-4 py-3 text-gray-700">Vorgesteuerte Anlage ZSFY</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Zonenidentifikation (alle Nassanlagen)</td>
							<td class="px-4 py-3 text-gray-700">–</td>
							<td class="px-4 py-3 text-gray-700">Strömungswächter ZSJZ</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Eine vollständige Baugruppe kombiniert das Alarmventil typischerweise mit einem vorgeschalteten Signal-Absperrschieber, einem Rückschlagventil, Manometern und der Alarmgarnitur. Wenn Sie uns Gefährdungsklasse und Rohrleitungsgröße mitteilen, bieten wir die komplette Ventilbaugruppe statt eines Einzelventils an – ein zertifiziertes Paket mit einem vollständigen Dokumentensatz.</p>

			<!-- Verwandter Leitfaden -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Verwandter Leitfaden: Anlagentypen und Sprinklerköpfe</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Sie möchten zwischen Nass-, Trocken- und vorgesteuerten Anlagen wählen oder Sprinklerköpfe nach K-Faktor und Temperatur auswählen? Lesen Sie den <a href="/de/guides/fire-sprinkler-system-wet-dry-preaction/" class="text-brand-blue font-semibold hover:underline">Leitfaden für Sprinkleranlagen</a>.</p>
			</div>

			<!-- Abschnitt: Häufig gestellte Fragen -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Häufig gestellte Fragen</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- Handlungsaufforderung -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Benötigen Sie ein Angebot für eine Sprinklerventil-Baugruppe?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Senden Sie uns Anlagentyp, Gefährdungsklasse und Rohrleitungsgröße – innerhalb von 12 Stunden erhalten Sie die vollständigen Spezifikationen der Ventilbaugruppe und den Werkspreis.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/de/contact/?product=Sprinkler%20Valve%20Assembly" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Angebot anfordern</a>
						<a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Hallo, ich benötige ein Angebot für eine Sprinklerventil-Baugruppe')}`} class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Über WhatsApp chatten</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
