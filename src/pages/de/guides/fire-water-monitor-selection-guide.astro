---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'manual-monitors-ps', label: '1. Manuelle Löschmonitore (PS-Serie): Bedienersteuerung' },
	{ id: 'auto-tracking-monitors-zdms', label: '2. Automatische Löschmonitore (ZDMS): Autonome Reaktion' },
	{ id: 'head-to-head-comparison', label: '3. Direktvergleich' },
	{ id: 'sizing-and-installation', label: '4. Wesentliche Punkte zu Auslegung und Installation' },
	{ id: 'faq', label: 'Häufig gestellte Fragen' }
];

const faq = [
	{
		question: 'Was ist der Unterschied zwischen einem manuellen und einem automatisch nachführenden Löschmonitor?',
		answer: 'Ein manueller Löschmonitor der PS-Serie wird von einer Einsatzkraft vor Ort ausgerichtet und bedient, direkt am Turm oder über ein entferntes Handrad. Ein automatisch nachführender Monitor der ZDMS-Serie überwacht den geschützten Bereich kontinuierlich mit Infrarot-/UV-Flammendetektoren, schwenkt bei bestätigter Flammensignatur automatisch zum Brand und bekämpft ihn ohne Bedienereingriff – entscheidend bei großen Flächen, auf denen der Brand innerhalb weniger Sekunden getroffen werden muss.'
	},
	{
		question: 'Wo werden automatisch nachführende Löschkanonen (ZDMS) benötigt?',
		answer: 'Automatisch nachführende Löschkanonen werden typischerweise für große Innenräume mit hohen Decken spezifiziert, in denen Erkennung und Reaktion automatisch erfolgen müssen: Ausstellungshallen, Atrien, Lager, Flugzeughangars und industrielle Werkstätten. Deckenhöhe und Grundfläche bestimmen die Anzahl der Kanonen und ihre Abdeckungszonen.'
	},
	{
		question: 'Welche wirksame Reichweite hat ein Löschmonitor?',
		answer: 'Die wirksame Reichweite hängt vom Volumenstrom und der Düsenkonfiguration ab. Manuelle PS-Monitore liefern üblicherweise 20–60 L/s bei Reichweiten von 30–70 m; automatisch nachführende ZDMS-Kanonen werden für Innenräume typischerweise mit 20–40 L/s und einer Reaktionszeit von unter 30 Sekunden ausgelegt. Die Brandschutzplanung muss den Monitor anhand der erforderlichen Wasserdichte und der abzudeckenden Fläche auslegen.'
	},
	{
		question: 'Können Löschmonitore mit Schaum eingesetzt werden?',
		answer: 'Ja. Die meisten Monitore der PS-Serie unterstützen Wasser oder Schaummittel durch Umschalten der Düseneinstellung und werden deshalb häufig in petrochemischen Terminals und Tanklagern eingesetzt. Wenn Schaumbetrieb vorgesehen ist, geben Sie dies in Ihrer Anfrage an, damit der Monitor mit der passenden Schnittstelle für die Schaummittelzumischung konfiguriert wird.'
	}
];

const referencePages = [
	{
		slug: 'manual-fire-water-cannon-ps',
		name: 'Manueller Löschmonitor (PS-Serie)',
		img: '/assets/products/manual-fire-water-cannon-ps.webp',
		desc: 'Manueller Hochleistungsmonitor für Wasser oder Schaum, Reichweite 30–70 m'
	},
	{
		slug: 'auto-tracking-jet-suppression-cannon-zdms',
		name: 'Automatisch nachführende Löschkanone (ZDMS-Serie)',
		img: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		desc: 'IR-/UV-überwachende Kanone mit autonomer Erkennung und Brandbekämpfung'
	}
];
---

<Layout
	title="Löschmonitor auswählen: Manuell vs. automatisch (ZDMS)"
	description="Leitfaden zur Auswahl von Löschmonitoren: manuelle PS- und automatische ZDMS-Kanonen im Vergleich von Reichweite, Volumenstrom, Erkennung und Reaktionszeit."
	type="article"
	locale="de"
	faq={faq}
	breadcrumbs={[{ name: 'Leitfäden', href: '/de/blog/' }, { name: 'Löschmonitore' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/de/" class="hover:text-blue-600">Startseite</a>
			<span>/</span>
			<a href="/de/blog/" class="hover:text-blue-600">Leitfäden</a>
			<span>/</span>
			<span class="text-gray-600">Löschmonitore</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Leitfaden für Brandschutztechnik</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Löschmonitor auswählen: Manuell vs. automatisch (ZDMS)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Löschmonitore – auch Löschkanonen genannt – erzeugen über größere Entfernungen einen konzentrierten Wasserstrahl mit hohem Volumenstrom. Grundsätzlich gibt es zwei unterschiedliche Bedienkonzepte: <strong>manuelle Monitore</strong>, die von Bedienern ausgerichtet werden, und <strong>automatisch nachführende Monitore</strong>, die selbstständig erkennen, ausrichten und den Brand bekämpfen. Die Auswahl hängt von Reaktionszeit, Gefährdung der Nutzung und Budget ab. Dieser Leitfaden erläutert die Entscheidung.</p>

			<div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
				{referencePages.map(p => (
					<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-40 object-contain bg-white p-3" />
						<div class="p-4">
							<p class="text-sm font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-xs text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="manual-monitors-ps" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Manuelle Löschmonitore (PS-Serie): Bedienersteuerung</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Der <a href="/de/products/manual-fire-water-cannon-ps/" class="text-brand-blue font-semibold hover:underline">manuelle Löschmonitor der PS-Serie</a> ist das Arbeitspferd der industriellen Brandbekämpfung: ein fest installierter Monitor mit 20–60 L/s und einer Reichweite von bis zu 70 m, umschaltbar zwischen Vollstrahl und Sprühstrahl sowie für Wasser oder Schaum geeignet. Die Bedienung erfolgt direkt über Handrad oder Turm beziehungsweise aus der Ferne durch einen Bediener, der die Situation überwacht.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Geeignete Einsatzbereiche:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Petrochemische Terminals, Tanklager und Verladeanlagen</strong> – schaumgeeignete Monitore an festgelegten Schutzpunkten.</li>
				<li><strong>Außenlager und Prozessbereiche</strong>, in denen Bediener den Monitor oder eine Fernbedienungsposition sicher erreichen können.</li>
				<li><strong>Kühlung und Unterstützung von Sprühflutanlagen</strong>, bei denen gerichtete manuelle Strahlen automatische Systeme ergänzen.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Der Nachteil ist klar: Ein manueller Monitor ist nur so schnell wie sein Bediener. Wenn bei einem Brandausbruch niemand den Bedienpunkt sicher erreichen kann, wird er möglicherweise überhaupt nicht eingesetzt.</p>

			<h2 id="auto-tracking-monitors-zdms" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Automatische Löschmonitore (ZDMS): Autonome Reaktion</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Die <a href="/de/products/auto-tracking-jet-suppression-cannon-zdms/" class="text-brand-blue font-semibold hover:underline">automatisch nachführende Löschkanone ZDMS</a> nimmt den Menschen aus der Reaktionskette. Zweibandige Infrarot-/UV-Flammendetektoren überwachen den geschützten Raum kontinuierlich. Sobald eine Flammensignatur bestätigt ist, schwenkt die Kanone zum Brand, öffnet das Ventil und bekämpft ihn – typischerweise innerhalb von 30 Sekunden nach der Zündung, rund um die Uhr.</p>
			<p class="text-gray-700 leading-relaxed mb-4">Geeignete Einsatzbereiche:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Große Innenräume mit hohen Decken</strong> – Ausstellungshallen, Atrien, Lager, Werkstätten und Hangars.</li>
				<li><strong>Bereiche, in denen sich ein Brand schneller ausbreiten kann, als das Personal reagieren kann</strong>.</li>
				<li><strong>Unbeaufsichtigte oder nächtliche Gefährdung</strong> – das System überwacht den Bereich ständig.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Da ZDMS-Kanonen nach Abdeckungszone und Deckenhöhe ausgelegt werden, muss die Planung die Sichtfelder der Detektoren und die Wasserdichte über den gesamten Bereich abbilden. Deshalb ist die technische Unterstützung des Lieferanten ebenso wichtig wie die Hardware.</p>

			<h2 id="head-to-head-comparison" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Direktvergleich</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Kriterium</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Manuell (PS)</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Automatisch nachführend (ZDMS)</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Reaktion</td>
							<td class="px-4 py-3 text-gray-700">Abhängig von Reichweite und Reaktion des Bedieners</td>
							<td class="px-4 py-3 text-gray-700">Autonom, typischerweise &lt;30 s ab Zündung</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Volumenstrom / Reichweite</td>
							<td class="px-4 py-3 text-gray-700">20–60 L/s, 30–70 m</td>
							<td class="px-4 py-3 text-gray-700">20–40 L/s, Innenabdeckung nach Zone</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Erkennung</td>
							<td class="px-4 py-3 text-gray-700">Keine (Ausrichtung durch Bediener)</td>
							<td class="px-4 py-3 text-gray-700">Zweibandige IR-/UV-Überwachung</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Löschmittel</td>
							<td class="px-4 py-3 text-gray-700">Wasser oder Schaum (umschaltbar)</td>
							<td class="px-4 py-3 text-gray-700">Wasser; Schaum je nach Konfiguration</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Typische Anwendung</td>
							<td class="px-4 py-3 text-gray-700">Tanklager, Außenlager, Prozessbereiche</td>
							<td class="px-4 py-3 text-gray-700">Atrien, Lager, Hallen, Werkstätten</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Kosten</td>
							<td class="px-4 py-3 text-gray-700">Geringere Hardwarekosten</td>
							<td class="px-4 py-3 text-gray-700">Höher; einschließlich Erkennung und Steuerung</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 id="sizing-and-installation" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Wesentliche Punkte zu Auslegung und Installation</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Hydraulik zuerst</strong> – der Volumenstrombedarf des Monitors (L/s) und der erforderliche Restdruck müssen vor der Auswahl mit Pumpe und Rohrleitungsnetz abgeglichen werden.</li>
				<li><strong>Abdeckungsplanung für ZDMS</strong> – Sichtfeld der Detektoren, Deckenhöhe und Wasserdichte bestimmen Anzahl und Position der Kanonen; fordern Sie beim Lieferanten eine Layoutzeichnung an.</li>
				<li><strong>Schaumverträglichkeit</strong> – bestätigen Sie für Tanklager die Eignung der Monitordüse und der Schnittstelle zur Schaummittelzumischung.</li>
				<li><strong>Prüfprotokoll</strong> – vereinbaren Sie mit dem Lieferanten bereits im Vertrag eine Inbetriebnahmeprüfung für Reichweite und Reaktionszeit.</li>
			</ul>

			<!-- Verwandter Leitfaden -->
			<div class="mt-10 bg-gray-50 rounded-2xl border border-gray-100 p-6 sm:p-8">
				<h2 class="text-xl font-black text-gray-900 tracking-tight">Verwandter Leitfaden: Die Kaufentscheidung</h2>
				<p class="mt-2 text-gray-600 text-sm leading-relaxed">Sie möchten zwischen fester, entfernter und intelligenter Steuerung entscheiden und Volumenstrom sowie Reichweite für Ihren Standort auslegen? Lesen Sie den <a href="/de/guides/fire-water-cannon-buying-guide/" class="text-brand-blue font-semibold hover:underline">Leitfaden zum Kauf von Löschkanonen</a>.</p>
			</div>

			<!-- FAQ-Bereich -->
			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Häufig gestellte Fragen</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- Handlungsaufforderung -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Möchten Sie ein Monitorsystem für Ihren Standort auslegen?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Senden Sie uns Standorttyp, geschützte Fläche und Deckenhöhe – unsere Ingenieure antworten innerhalb von 12 Stunden mit Kanonenlayout und Preis.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/de/contact/?product=Fire%20Water%20Monitor" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Angebot anfordern</a>
						<a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Guten Tag, ich benötige Unterstützung bei der Auslegung von Löschmonitoren')}`} class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Über WhatsApp schreiben</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
