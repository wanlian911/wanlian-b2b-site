---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const toc = [
	{ id: 'project-scope', label: '1. Was ein kommunaler Wasser- und Brandschutzumfang tatsächlich umfasst' },
	{ id: 'standards-regimes', label: '2. Normen in der Region: Was die Ausschreibung verlangen kann' },
	{ id: 'one-purchase-order', label: '3. Wie eine einzige Bestellung das Koordinationsrisiko senkt' },
	{ id: 'selection-matrix', label: '4. Auswahlmatrix: Bauteil, typische Spezifikation, empfohlenes Modell' },
	{ id: 'specification-documentation', label: '5. Anzufordernde Spezifikationen und Dokumente' },
	{ id: 'procurement-checklist', label: '6. Checkliste für die kommunale Beschaffung' },
	{ id: 'faq', label: 'Häufig gestellte Fragen' },
	{ id: 'sources', label: 'Quellen' }
];

const faq = [
	{
		question: 'Kann ein einziger Lieferant Hydranten, Ventile, Schläuche und Rückflussverhinderer für ein kommunales Projekt liefern?',
		answer: 'Ja. Wanlian Fluid betreibt eigene Produktionslinien in Quanzhou; ausgewählte Artikel werden von qualifizierten Fertigungspartnern hergestellt. Hydranten, Absperrschieber und Regelventile, Feuerwehrschläuche, Kupplungen und Rückflussverhinderer werden unter einer Bestellung gebündelt. Das bedeutet eine Dokumentationsspur, eine Inspektionsstelle und einen verantwortlichen Hersteller für den gesamten Lieferumfang.'
	},
	{
		question: 'Welche Normen wird meine Ausschreibung in Lateinamerika tatsächlich nennen?',
		answer: 'Das hängt vom Land und davon ab, ob der Umfang einer US-amerikanischen, europäischen oder nationalen Referenz folgt. Mexikanische Ausschreibungen nennen häufig NOM, Brasilien ABNT; Projekte nach US-Spezifikation oder für den Reexport können AWWA, NFPA oder UL/FM nennen. Viele Projekte verweisen auf EN oder ISO. Lesen Sie stets zuerst die in der Spezifikation genannte Norm: Die Konformität mit einer bestimmten Norm muss vor der Bestellung je Modell anhand von Prüfberichten und Zertifikaten bestätigt werden.'
	},
	{
		question: 'Verfügt Wanlian Fluid über eine AWWA-, NOM- oder ABNT-Zertifizierung?',
		answer: 'Wanlian Fluid arbeitet nach einem Qualitätsmanagementsystem gemäß ISO 9001 und prüft jede Einheit vor dem Versand einer Druckprüfung. Die Qualifizierung nach einer bestimmten Norm wird je Modell behandelt: Senden Sie die in Ihrer Spezifikation genannte Norm, und das Team bestätigt die Konformität für die exakt bestellten Modelle anhand der zugehörigen Prüfberichte und Zertifikate, bevor Sie sich festlegen.'
	},
	{
		question: 'Was bedeutet die Prüfung jeder Einheit in der Praxis für meine Bestellung?',
		answer: 'Das Gehäuse jeder einzelnen Einheit wird vor der Verpackung einer Druckprüfung und anschließend einer Luftdichtheitsprüfung unterzogen – nicht nur eine Stichprobe aus der Charge. Für sicherheitskritische Brandschutzausrüstung ist dies die verantwortungsvolle Grundlage; die Prüfung wird je Einheit dokumentiert, sodass Ihr Prüfer sie zurückverfolgen kann.'
	},
	{
		question: 'Wie lange dauert ein Angebot für einen vollständigen Lieferumfang?',
		answer: 'Senden Sie Ihre Spezifikation und den Bestimmungsort. Wanlian Fluid verpflichtet sich, innerhalb von 12 Stunden ein aufgeschlüsseltes Angebot zu senden, in dem jedes Bauteil, die Größe, die Druckklasse und die Normreferenz aufgeführt sind, damit Sie es Position für Position mit Ihrer Ausschreibung vergleichen können.'
	}
];

const referencePages = [
	{ slug: 'overground-fire-hydrant-ss100', name: 'Frostschutz-Überflurhydrant (SS100/65)', img: '/assets/products/overground-fire-hydrant-ss100.webp', desc: 'Überflurhydrant für kommunale Wasser- und Löschwassernetze' },
	{ slug: 'resilient-seat-flanged-gate-valve-z41x', name: 'Weichdichtender Flansch-Absperrschieber aus Sphäroguss (Z41X)', img: '/assets/products/resilient-seat-flanged-gate-valve-z41x.webp', desc: 'Absperrarmatur mit vollem Durchgang für Wasserleitungen und Löschwasserrohre' },
	{ slug: 'fire-hose-pvc-rubber-lining-8-65', name: 'Flachroll-Feuerwehrschlauch mit PVC-Gummierung (Modell 8-65)', img: '/assets/products/fire-hose-pvc-rubber-lining-8-65.jpg', desc: 'Gummierter Flachrollschlauch für Brandbekämpfung und Wasserförderung' }
];
---

<Layout
	title="Kommunale Wasser- und Brandschutzinfrastruktur in Lateinamerika"
	description="Hydranten, Absperrschieber, Feuerwehrschläuche und Rückflussverhinderer für kommunale Netze in Lateinamerika: B2B-Beschaffungsleitfaden 2026."
	type="article"
	locale="de"
	faq={faq}
	breadcrumbs={[{ name: 'Leitfäden', href: '/de/blog/' }, { name: 'Kommunales Wasser und Brandschutz, Lateinamerika' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/de/" class="hover:text-blue-600">Startseite</a><span>/</span>
			<a href="/de/blog/" class="hover:text-blue-600">Leitfäden</a><span>/</span>
			<span class="text-gray-600">Kommunales Wasser und Brandschutz, Lateinamerika</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Kommunale Infrastruktur und B2B-Beschaffung</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Kommunale Wasser- und Brandschutzinfrastruktur in Lateinamerika: B2B-Beschaffungsleitfaden (2026)</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Ein kommunales Wasser- und Brandschutzprojekt in Lateinamerika ist selten eine einzelne Beschaffung. Eine Ausschreibung verlangt Überflurhydranten an Straßenecken, Absperrschieber in der Hauptleitung, Druckminderventile an den Grenzen der Druckzonen, Rückflussverhinderer zum Schutz der Trinkwasserversorgung sowie Feuerwehrschläuche mit Kupplungen für die örtliche Feuerwehr – und jedes Bauteil wird häufig von einem anderen Lieferanten angeboten. Diese Aufteilung führt zu Verzögerungen: nicht passende Schnittstellen, geteilte Verantwortung und eine Dokumentation, für die niemand allein zuständig ist. Dieser Leitfaden zeigt, wie Sie den Umfang als koordinierten Satz zusammenstellen, die Normen einer lateinamerikanischen Ausschreibung richtig einordnen und die Anforderungen so festlegen und dokumentieren, dass ein Hersteller den gesamten Lieferumfang unter einer Bestellung anbieten, prüfen und versenden kann.</p>

			<div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
				{referencePages.map(p => (
					<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-32 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<TableOfContents headings={toc} />

			<h2 id="project-scope" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Was ein kommunaler Wasser- und Brandschutzumfang tatsächlich umfasst</h2>
			<p class="text-gray-700 leading-relaxed mb-4">In Mexiko, Kolumbien, Peru, Chile, Brasilien und Mittelamerika gliedert sich ein kommunaler Wasser- und Brandschutzumfang normalerweise in fünf Bauteilfamilien. Sie als koordinierten Satz zu behandeln – statt als fünf getrennte Positionen mit unterschiedlichen Beschaffungszeitplänen – ist die wirksamste Maßnahme, um das Risiko von Schnittstellenfehlern auf der Baustelle zu verringern:</p>
			<ol class="list-decimal pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Hydranten.</strong> Überflurhydranten an Straßen und in Wohnblöcken sowie kollisionsgeschützte oder druckregelnde Ausführungen an stark befahrenen Verkehrswegen. Sie sind das sichtbarste Ergebnis des Lieferumfangs.</li>
				<li><strong>Absperrarmaturen.</strong> Weichdichtende Absperrschieber mit vollem Durchgang in der Hauptleitung und an Hydrantenabzweigen sowie Absperrklappen, wenn Bauraum oder Gewicht maßgeblich sind.</li>
				<li><strong>Druck- und Zonenregelung.</strong> Einstellbare Druckminderventile an der Grenze jeder Druckzone, damit das Netz innerhalb seines Auslegungsbereichs bleibt.</li>
				<li><strong>Rückflussschutz.</strong> Rückflussverhinderer gegen Verunreinigungen an Anschlüssen, an denen die Trinkwasserversorgung durch Siphonwirkung oder Gegendruck belastet werden könnte.</li>
				<li><strong>Feuerwehrschläuche und Kupplungen.</strong> Flachroll-Angriffsschläuche mit passenden Kupplungen für die Feuerwehr und für den Betrieb zwischen Hydrant und Löschfahrzeug.</li>
			</ol>
			<p class="text-gray-700 leading-relaxed">Es geht nicht darum, alles von einer Marke zu kaufen, sondern sicherzustellen, dass die fünf Familien <em>für den gemeinsamen Betrieb ausgelegt und dokumentiert</em> sind. Hydrant, Absperrschieber, Druckminderventil, Rückflussverhinderer und Schlauch werden an dieselben Hauptleitungen angeschlossen und nach denselben Betriebsverfahren eingesetzt. Daher müssen Flansche, Gewinde, Druckklassen und Werkstoffe vor der Fertigung kompatibel sein.</p>

			<h2 id="standards-regimes" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Normen in der Region: Was die Ausschreibung verlangen kann</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Lateinamerika weist unterschiedliche Normenregelwerke auf. Die Ausschreibung selbst legt fest, welches Regelwerk für Ihren Umfang gilt: Lesen Sie zuerst die Spezifikation und ordnen Sie anschließend jedes Bauteil der zutreffenden Norm zu. Die folgende Tabelle zeigt die Regelwerke, denen Sie wahrscheinlich begegnen – als mögliche Anforderungen der Ausschreibung, nicht als Liste von Zertifizierungen eines beliebigen Lieferanten:</p>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Regelwerk</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Wo es vorkommt</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Was es typischerweise abdeckt</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Was je Auftrag zu bestätigen ist</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">AWWA C502 / C515</td>
							<td class="px-4 py-3 text-gray-700">Projekte nach US-Spezifikation, Reexporte und einige private Versorgungsunternehmen</td>
							<td class="px-4 py-3 text-gray-700">Trockenrohrhydranten und weichdichtende Absperrschieber</td>
							<td class="px-4 py-3 text-gray-700">Konformität je Modell mit Prüfberichten und Zertifikaten vor der Bestellung</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">NOM / NR (Mexiko)</td>
							<td class="px-4 py-3 text-gray-700">Mexikanische kommunale und staatliche Ausschreibungen</td>
							<td class="px-4 py-3 text-gray-700">Nationale Anforderungen an Wasser- und Brandschutzprodukte</td>
							<td class="px-4 py-3 text-gray-700">Welche NOM-Klausel die Ausschreibung nennt und die entsprechende Prüfung je Modell</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">ABNT (Brasilien)</td>
							<td class="px-4 py-3 text-gray-700">Brasilianische kommunale und industrielle Projekte</td>
							<td class="px-4 py-3 text-gray-700">Brasilianische Normen für Wasserversorgung und Brandschutzausrüstung</td>
							<td class="px-4 py-3 text-gray-700">ABNT-Referenz je Bauteil und Bestätigung je Modell mit Prüfberichten</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">EN / ISO (EN 14384, ISO 5208, ISO 7165)</td>
							<td class="px-4 py-3 text-gray-700">Kolumbien, Peru, Chile und von Planern erstellte Spezifikationen</td>
							<td class="px-4 py-3 text-gray-700">Hydrantenauslegung sowie Prüf- und Druckbemessungsverfahren für Armaturen</td>
							<td class="px-4 py-3 text-gray-700">Druckklasse und Prüfverfahren müssen der Spezifikation entsprechen</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">NFPA 1961 / 13 / 24</td>
							<td class="px-4 py-3 text-gray-700">Referenzen für Feuerwehren und Hydranteninstallationen</td>
							<td class="px-4 py-3 text-gray-700">Leistung von Feuerwehrschläuchen, Sprinkleranlagen und Hydranteninstallation</td>
							<td class="px-4 py-3 text-gray-700">Im Umfang genannter Kupplungstyp und Installationsdetails des Hydranten</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">UL / FM</td>
							<td class="px-4 py-3 text-gray-700">Bei US-Spezifikation im Versicherungsbereich oder bei Reexporten</td>
							<td class="px-4 py-3 text-gray-700">Gelistete oder zugelassene Brandschutzprodukte</td>
							<td class="px-4 py-3 text-gray-700">Nur wenn der Vertrag dies verlangt; Prüfung je Modell bei der ausstellenden Stelle</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed mb-4">Die praktische Regel ist in allen Märkten gleich: <strong>Die Konformität mit einer bestimmten Norm muss vor der Bestellung je Modell anhand von Prüfberichten und Zertifikaten bestätigt werden.</strong> Eine allgemeine Broschüre beweist nicht, dass ein bestimmter Hydrant oder ein bestimmtes Ventil die in Ihrer Ausschreibung genannte Klausel erfüllt – ein Prüfbericht je Modell schon. Unser <a href="/de/guides/fire-hydrant-valve-standards-guide/" class="text-brand-blue font-semibold hover:underline">Leitfaden zu Hydranten- und Armaturennormen</a> erklärt, wie Sie eine Norm Zeile für Zeile mit einem Prüfbericht abgleichen.</p>
			<p class="text-gray-700 leading-relaxed">Kupplungen bilden eine zweite Ebene. Geben Sie die von Ihrer Feuerwehr tatsächlich verwendete Schnittstelle an – Storz (in der Region weit verbreitet), NH-Gewinde oder Sofortkupplung/BS 336 – und lassen Sie sie vom Lieferanten schriftlich bestätigen. Unsere <a href="/de/products/storz-coupling-2-5inch-aluminum/" class="text-brand-blue font-semibold hover:underline">2,5-Zoll-Aluminium-Storz-Kupplung</a> ist eine übliche Verbindung für den Betrieb zwischen Hydrant und Löschfahrzeug; der <a href="/de/guides/how-to-choose-a-fire-hydrant/" class="text-brand-blue font-semibold hover:underline">Leitfaden zur Hydrantenauswahl</a> erläutert Hydrantentypen, Druckklassen und Anschlussnormen.</p>

			<h2 id="one-purchase-order" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. Wie eine einzige Bestellung das Koordinationsrisiko senkt</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Wenn Hydranten, Ventile, Schläuche und Rückflussschutz von einem Hersteller unter einer Bestellung geliefert werden, entfallen die Fehlerquellen, die kommunale Projekte am häufigsten verzögern:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Ein Verantwortlicher.</strong> Wenn ein Hydrantenabzweig und seine Absperrarmatur nicht zusammenpassen, klären Sie die Angelegenheit mit einem Lieferanten statt mit drei.</li>
				<li><strong>Koordinierte Schnittstellen.</strong> Flanschflächen, Gewinde, Druckklassen und Werkstoffe werden vor der Fertigung im gesamten Satz abgeglichen, sodass die Bauteile anschlussfertig eintreffen.</li>
				<li><strong>Eine Dokumentationsspur.</strong> Prüfberichte je Einheit, Zertifikate und Exportdokumente liegen in einer Datei, die Ihr Prüfer und die Vergabestelle gemeinsam prüfen können.</li>
				<li><strong>Eine Qualitätsprüfung.</strong> Jede Einheit des Satzes wird vor dem Versand einer Gehäuse-Druckprüfung und einer Luftdichtheitsprüfung unterzogen – nach einem Qualitätsmanagementsystem gemäß ISO 9001.</li>
				<li><strong>Eine Inspektionsstelle.</strong> Eine Drittinspektion, beispielsweise durch SGS oder Bureau Veritas, kann für eine Lieferung statt für mehrere angesetzt werden.</li>
				<li><strong>OEM- und Branding-Optionen.</strong> Wenn die Ausschreibung das Branding der Vergabestelle oder Ihrer Marke verlangt, werden individuelle Kennzeichnung und Exportverpackung in derselben Bestellung koordiniert.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed">Nichts davon hängt von einer einzelnen Zertifizierungsbehauptung ab. Entscheidend ist, dass der Hersteller den gesamten Satz tatsächlich fertigt und prüft. Dafür sind die eigenen Produktionslinien von Wanlian Fluid ausgelegt – ausgewählte Artikel werden von qualifizierten Partnern hergestellt, Ventilkörper werden intern CNC-bearbeitet. Das veröffentlichte Sortiment umfasst 6 Produktlinien und mehr als 43 Lager-Modelle. Für die Lieferantenseite lesen Sie unseren <a href="/de/guides/how-to-verify-chinese-valve-supplier/" class="text-brand-blue font-semibold hover:underline">Leitfaden zur Prüfung chinesischer Lieferanten von Ventilen und Brandschutzausrüstung</a>.</p>

			<h2 id="selection-matrix" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Auswahlmatrix: Bauteil, typische Spezifikation, empfohlenes Modell</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Nutzen Sie diese Matrix als Ausgangspunkt für Ihre Angebotsanfrage. Jede Zeile verbindet ein Bauteil des Lieferumfangs mit der Spezifikationsart, die eine lateinamerikanische Ausschreibung häufig nennt, sowie mit einem passenden Wanlian-Fluid-Modell. Prüfen Sie Größe, Druckklasse und Normreferenz anhand <em>Ihrer</em> Spezifikation – der Hinweis zur Qualifizierung je Modell gilt für jede Zeile:</p>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Bauteil</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Typische Ausschreibungsspezifikation</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Empfohlenes Wanlian-Fluid-Modell</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Hinweis</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Überflurhydrant</td>
							<td class="px-4 py-3 text-gray-700">Sphäroguss, außen aufgestellt, an Straßen und in Wohnblöcken</td>
							<td class="px-4 py-3 text-gray-700"><a href="/de/products/overground-fire-hydrant-ss100/" class="text-brand-blue font-semibold hover:underline">Frostschutz-Überflurhydrant (SS100/65)</a></td>
							<td class="px-4 py-3 text-gray-700">AWWA C502 / EN 14384 je Modell bestätigen</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Kollisionsgeschützter / druckregelnder Hydrant</td>
							<td class="px-4 py-3 text-gray-700">Stark befahrene Verkehrswege, Schutz vor Fahrzeugen</td>
							<td class="px-4 py-3 text-gray-700"><a href="/de/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100/" class="text-brand-blue font-semibold hover:underline">Kollisionsgeschützter druckregelnder Überflurhydrant (SSFT100/65)</a></td>
							<td class="px-4 py-3 text-gray-700">Stoßfestigkeit und Druckregelung je Modell bestätigen</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Überwachter / intelligenter Hydrant</td>
							<td class="px-4 py-3 text-gray-700">Überwachung des Netzzustands</td>
							<td class="px-4 py-3 text-gray-700"><a href="/de/products/iot-smart-ground-fire-hydrant-ss100zn/" class="text-brand-blue font-semibold hover:underline">Intelligenter IoT-Unterflurhydrant (SS100/65-1.6ZN)</a></td>
							<td class="px-4 py-3 text-gray-700">Umfang von Kommunikation und Telemetrie bestätigen</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Absperrschieber</td>
							<td class="px-4 py-3 text-gray-700">Sphäroguss, weichdichtend, voller Durchgang, PN16 oder ANSI</td>
							<td class="px-4 py-3 text-gray-700"><a href="/de/products/resilient-seat-flanged-gate-valve-z41x/" class="text-brand-blue font-semibold hover:underline">Weichdichtender Flansch-Absperrschieber aus Sphäroguss (Z41X)</a></td>
							<td class="px-4 py-3 text-gray-700">Prüfverfahren nach ISO 5208; Klasse an den Systemdruck anpassen</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Druckminderventil</td>
							<td class="px-4 py-3 text-gray-700">Hydraulisch, einstellbar, an der Zonengrenze</td>
							<td class="px-4 py-3 text-gray-700"><a href="/de/products/adjustable-pressure-reducing-valve-500x/" class="text-brand-blue font-semibold hover:underline">Hydraulisch einstellbares Druckminderventil (500X)</a></td>
							<td class="px-4 py-3 text-gray-700">Ein- und Ausgangsdruckbereich aus der Netzauslegung festlegen</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Rückflussverhinderer</td>
							<td class="px-4 py-3 text-gray-700">Gegen Verunreinigung, Schutz der Trinkwasserversorgung</td>
