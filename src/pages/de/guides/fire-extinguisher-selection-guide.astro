---
import Layout from '../../../layouts/Layout.astro';
import TableOfContents from '../../../components/sections/TableOfContents.astro';

const faq = [
	{
		question: 'Welche Brandklassen kann ein ABC-Pulverfeuerlöscher bekämpfen?',
		answer: 'Ein ABC-Pulverfeuerlöscher deckt Brände der Klassen A (Holz, Papier, Textilien), B (brennbare Flüssigkeiten), C (brennbare Gase) und E (elektrische Anlagen) ab und ist daher die Standardlösung für tragbare Geräte in Gewerbe- und Industriegebäuden. Für Speiseölbrände der Klasse F ist er nicht geeignet (dafür Nasslöschmittel verwenden), ebenso wenig für Metallbrände der Klasse D (hier Spezial-Metallpulver einsetzen).'
	},
	{
		question: 'Was bedeutet die Zertifizierung nach ISO 7165 bei einem Feuerlöscher?',
		answer: 'ISO 7165 ist die internationale Norm für tragbare Feuerlöscher und umfasst Leistung, Konstruktion, Kennzeichnung und Prüfungen. Unser ABC-Pulvermodell mit 5 kg wird nach ISO 7165 gefertigt und trägt zusätzlich die CCCF-Kennzeichnung. CCCF steht für die chinesische Pflichtzertifizierung für Brandschutzprodukte: Sie qualifiziert das Gerät für den chinesischen Markt, ist allein jedoch kein Exportzertifikat. Für den Export sollten Sie das Zertifikat für das exakte Modell und den Zielmarkt anfordern.'
	},
	{
		question: 'Welche Größen von ABC-Pulverfeuerlöschern sind verfügbar?',
		answer: 'Der Wanlian-ABC-Pulverfeuerlöscher ist mit 3 kg, 4 kg und 5 kg Löschmittel-Nettogewicht erhältlich. Die Entleerungszeit beträgt etwa 8–15 Sekunden; der Zylinder aus Kohlenstoffstahl besitzt ein farbcodiertes Manometer. Ein 5-kg-Gerät ist eine gängige Ausführung für Büros, Lager und Gewerbeanlagen. Geben Sie bei Ihrer Anfrage die Gefährdungsklasse und die abzudeckende Fläche an.'
	},
	{
		question: 'Kann ich Feuerlöscher mit meiner eigenen Marke und Kennzeichnung (OEM) bestellen?',
		answer: 'Ja. Wir unterstützen OEM-Anpassungen an Zylinderfarbe, Gehäuseetikett, Logo und Sprache und können die Kennzeichnung an den Zielmarkt anpassen. MOQ, Druckfreigabe und Lieferzeit werden im Angebot bestätigt. Senden Sie uns bitte Zielmenge und Markt, damit wir die passende Ausführung kalkulieren können.'
	},
	{
		question: 'Benötigen Pulverfeuerlöscher für den Exportversand eine spezielle Verpackung?',
		answer: 'Da der Zylinder unter Druck steht, müssen Gefahrgutklassifizierung (UN-Nummer) und Anforderungen an die Transportverpackung für das konkrete Modell mit Ihrem Spediteur abgestimmt werden. Bei aus China versendeten und als Gefahrgut eingestuften Waren muss der Exporteur das Prüfzeugnis für die Transportverpackung ausgehender Gefahrgüter vorlegen. Fälle aus der Zollüberwachung zeigen, dass Sendungen ohne dieses Dokument zurückgehalten und sanktioniert werden können. Verpackungs- und Dokumentationsanforderungen stimmen wir vor der Produktion mit Ihnen ab.'
	},
	{
		question: 'Wann sollte ich statt ABC-Pulver CO2 wählen?',
		answer: 'CO2 eignet sich dort, wo Pulverrückstände aufwendig oder teuer zu entfernen wären, etwa in Leitwarten, Serverräumen, Laboren und Schaltanlagen. ABC-Pulver bietet das beste Preis-Leistungs-Verhältnis für allgemeine Gewerbe-, Lager- und Industrieflächen mit gemischten Gefährdungen der Klassen A und B. Bei Projekten mit beiden Bereichen werden üblicherweise Pulvergeräte für offene Flächen und CO2-Geräte für Räume mit empfindlicher Technik kombiniert.'
	}
];

const toc = [
	{ id: 'why-fire-extinguishers', label: '1. Warum Feuerlöscher die Beschaffung im Brandschutz anführen' },
	{ id: 'fire-classes-agents', label: '2. Brandklassen und Löschmittel' },
	{ id: 'abc-specifications', label: '3. ABC-Pulverspezifikationen erklärt' },
	{ id: 'certification-compliance', label: '4. Zertifizierung und Konformität für den Export' },
	{ id: 'applications-scenarios', label: '5. Wo Feuerlöscher eingesetzt werden' },
	{ id: 'factory-buying-checklist', label: '6. Werks-Checkliste: OEM, MOQ und Gefahrgutverpackung' },
	{ id: 'faq', label: 'Häufig gestellte Fragen' }
];

const products = [
	{ slug: 'abc-dry-powder-fire-extinguisher-5kg', name: 'ABC-Pulverfeuerlöscher (5 kg)', img: '/assets/products/abc-dry-powder-fire-extinguisher-5kg.webp', desc: 'Tragbares ISO-7165-Gerät für Brände der Klassen A/B/C/E' },
	{ slug: 'stainless-steel-fire-extinguisher-box', name: 'Feuerlöscherschrank aus Edelstahl', img: '/assets/products/stainless-steel-fire-extinguisher-box.jpg', desc: 'SS304/201-Schrank zur Aufbewahrung von Feuerlöscher oder Schlauchhaspel' },
	{ slug: 'metal-fire-extinguisher-box-red', name: 'Metall-Feuerlöscherschrank (rot)', img: '/assets/products/metal-fire-extinguisher-box-red.jpg', desc: 'Pulverbeschichteter Schrank mit Anleitungstafel, OEM-Abmessungen' }
];
---

<Layout
	title="Feuerlöscher-Auswahl: ABC-Pulver für B2B und Export"
	description="Leitfaden für B2B-Einkäufer zur Auswahl tragbarer Feuerlöscher: ABC-Pulver, Brandklassen, ISO 7165, Größen, OEM und sichere Exportverpackung."
	type="article"
	locale="de"
	faq={faq}
	breadcrumbs={[{ name: 'Leitfäden', href: '/de/blog/' }, { name: 'Feuerlöscher-Auswahl' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/de/" class="hover:text-blue-600">Startseite</a>
			<span>/</span>
			<a href="/de/blog/" class="hover:text-blue-600">Leitfäden</a>
			<span>/</span>
			<span class="text-gray-600">Feuerlöscher-Auswahl</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Brandschutz-Leitfaden</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Leitfaden zur Feuerlöscher-Auswahl: ABC-Pulver für B2B- und Exportprojekte</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Tragbare Feuerlöscher sind der mengenmäßig wichtigste Einstieg in die Beschaffung von Brandschutztechnik – doch ABC-Pulver-, CO2-, Schaum- und Wasserlöscher sind nicht austauschbar. Dieser Leitfaden unterstützt Importeure, Händler und Projektkäufer dabei, Brandklassen passenden Löschmitteln zuzuordnen, die entscheidenden Spezifikationen zu prüfen und Zertifikate sowie Gefahrgutunterlagen vor dem Versand korrekt zusammenzustellen.</p>

			<TableOfContents headings={toc} />

			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
				{products.map(p => (
					<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 id="why-fire-extinguishers" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">1. Warum Feuerlöscher die Beschaffung im Brandschutz anführen</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Suchdaten von Branchenplattformen aus dem August 2026 zeigen, dass <strong>Feuerlöscher</strong> in der untersuchten Brandschutzstichprobe die meistgesuchte Kategorie waren – mit rund 19.800 Suchanfragen, also etwa einem Drittel aller Suchanfragen der führenden Kategorien. Verwandte tragbare Ausführungen wie Aerosol- und Kugellöscher kamen mit weiteren Tausenden hinzu. Der relative Google-Interessenindex für „Feuerlöscher“ lag im August 2026 bei 80/100, nachdem er zu Jahresbeginn 100 erreicht hatte. Das stärkste relative Interesse wurde in Katar, den Vereinigten Arabischen Emiraten, den Philippinen, den USA und dem Vereinigten Königreich gemessen.</p>
			<p class="text-gray-700 leading-relaxed">Für einen Lieferanten bedeuten diese Zahlen vor allem eines: Die Nachfrage kommt gleichzeitig aus drei unterschiedlichen Beschaffungssituationen – Händler füllen Standard-SKUs auf, Auftragnehmer statten Gebäude nach Vorgabe aus und Facility Manager ersetzen abgelaufene Geräte. Ein allgemeines Angebot für „Brandschutztechnik“ vermischt Handels- und Engineering-Käufer zu einer unklaren Anfrage. Wenn Löschmittel, Füllmenge, Brandklassenabdeckung und Zertifizierung von Anfang an angegeben werden, kann jeder Käufer die passende Produktfamilie selbst auswählen.</p>

			<h2 id="fire-classes-agents" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">2. Brandklassen und Löschmittel</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Jeder tragbare Feuerlöscher ist für bestimmte Brandklassen ausgelegt; das Löschmittel muss zur Gefährdung passen. ABC-Pulver ist die vielseitige Standardlösung. Andere Löschmittel sind überlegen, wenn Rückstände, Wiederentzündungsrisiken oder besondere Brennstoffe die Auswahl bestimmen.</p>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Brandklasse</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Typische Brennstoffe</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Wirksamste Löschmittel</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Eignung von ABC-Pulver</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Klasse A</td>
							<td class="px-4 py-3 text-gray-700">Holz, Papier, Textilien, Kunststoffe</td>
							<td class="px-4 py-3 text-gray-700">Wasser, Schaum, ABC-Pulver</td>
							<td class="px-4 py-3 text-gray-700">Standardwahl</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Klasse B</td>
							<td class="px-4 py-3 text-gray-700">Benzin, Öle, Lösungsmittel, Lacke</td>
							<td class="px-4 py-3 text-gray-700">ABC-Pulver, Schaum, CO2</td>
							<td class="px-4 py-3 text-gray-700">Standardwahl</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Klasse C</td>
							<td class="px-4 py-3 text-gray-700">Propan, Butan, Methan, LPG</td>
							<td class="px-4 py-3 text-gray-700">ABC-Pulver (Zufuhr zuerst absperren)</td>
							<td class="px-4 py-3 text-gray-700">Geeignet</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Klasse E</td>
							<td class="px-4 py-3 text-gray-700">Unter Spannung stehende Elektrogeräte</td>
							<td class="px-4 py-3 text-gray-700">CO2, ABC-Pulver (nicht leitfähig)</td>
							<td class="px-4 py-3 text-gray-700">Geeignet – Pulverrückstände beachten</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Klasse F</td>
							<td class="px-4 py-3 text-gray-700">Speiseöle und Fette</td>
							<td class="px-4 py-3 text-gray-700">Nasslöschmittel</td>
							<td class="px-4 py-3 text-gray-700">Nicht empfohlen</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Klasse D</td>
							<td class="px-4 py-3 text-gray-700">Brennbare Metalle (Mg, Na)</td>
							<td class="px-4 py-3 text-gray-700">Spezial-Metallpulver</td>
							<td class="px-4 py-3 text-gray-700">Nicht geeignet</td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="text-gray-700 leading-relaxed">Für die gemischten Nutzungen, die die meisten B2B-Käufer beliefern – Büros, Lager, Werkstätten und Verkaufsflächen – deckt eine ABC-Pulverlinie typischerweise 80 % der tragbaren Geräte in der Materialliste ab. CO2 bleibt elektrischen Betriebsräumen vorbehalten, Schaum oder Nasslöschmittel besonderen Gefährdungen.</p>

			<h2 id="abc-specifications" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">3. ABC-Pulverspezifikationen erklärt</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Wenn ein Angebot eintrifft, sollten Sie vor dem Preisvergleich zwischen Lieferanten diese fünf Parameter prüfen:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Löschmittel und Füllmenge</strong> – ABC-Pulver auf Basis von Monoammoniumphosphat ist die vielseitige Standardlösung. Das Nettogewicht des Löschmittels (3 kg / 4 kg / 5 kg in unserem Sortiment) bestimmt sowohl die Reichweite als auch die Frachtkosten.</li>
				<li><strong>Wirkstoffgehalt</strong> – unser ABC-Pulver ist mit einem Wirkstoffgehalt von 90 % spezifiziert. Dieser beeinflusst die Löschleistung pro Kilogramm.</li>
				<li><strong>Entleerungsleistung</strong> – bei einem 5-kg-Gerät ist mit einer wirksamen Entleerungszeit von etwa 8–15 Sekunden zu rechnen. Das Datenblatt sollte diesen Wert ausdrücklich nennen.</li>
				<li><strong>Überdruckbetrieb und Manometer</strong> – Treibmittel und Pulver stehen in einem Zylinder gemeinsam unter Druck. Ein farbcodiertes Manometer zeigt die Einsatzbereitschaft; seine Ausführung ist daher für Wartungsprüfungen relevant.</li>
				<li><strong>Qualität von Zylinder und Ventil</strong> – ein Zylinder aus Kohlenstoffstahl mit korrosionsbeständiger roter Beschichtung, eine Messingventilbaugruppe sowie ein Löschschlauch mit Düse vervollständigen das Gerät.</li>
			</ul>
			<p class="text-gray-700 leading-relaxed mb-4">Unser <a href="/de/products/abc-dry-powder-fire-extinguisher-5kg/" class="text-brand-blue font-semibold hover:underline">ABC-Pulverfeuerlöscher mit 5 kg</a> wird nach ISO 7165 mit CCCF-Kennzeichnung gefertigt, deckt die Brandklassen A/B/C/E ab und ist mit 3 kg / 4 kg / 5 kg Löschmittel-Nettogewicht sowie einjähriger Garantie erhältlich. Löschschlauch, Manometer und Messingventil gehören zur Standardausstattung.</p>
			<p class="text-gray-700 leading-relaxed">Ein wichtiger, ehrlicher Hinweis für Ihre Kunden: Pulver hinterlässt Rückstände, die von Böden und Maschinen kostengünstig entfernt werden können, aber elektronische Komponenten beschädigen. Genau deshalb ist die Zeile zur Klasse E in der obigen Tabelle mit einem Hinweis versehen.</p>

			<h2 id="certification-compliance" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">4. Zertifizierung und Konformität für den Export</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Bei der Beschaffung tragbarer Feuerlöscher ist die Zertifizierung entscheidend, da die Kennzeichnungen zum tatsächlichen Modell passen müssen – nicht nur zu einer Marke oder Baureihe.</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>ISO 7165</strong> – die internationale Norm für tragbare Feuerlöscher umfasst Konstruktion, Leistung und Prüfungen. Sie ist für die meisten Exportmärkte ein wichtiger Referenzpunkt und auf unserem 5-kg-Modell angegeben.</li>
				<li><strong>CCCF</strong> – die chinesische Pflichtzertifizierung für Brandschutzprodukte. Sie qualifiziert das Gerät für den chinesischen Markt, ist aber <strong>kein</strong> Exportzertifikat. Diese Unterscheidung ist wichtig, wenn ein Käufer außerhalb Chinas weiterverkaufen möchte.</li>
				<li><strong>Zertifizierung im Zielmarkt</strong> – für die EU ist die CE-Kennzeichnung anhand der für das konkrete Modell geltenden Norm zu prüfen; bestimmte nordamerikanische Anwendungen verlangen UL- oder ULC-gelistete Geräte. Fordern Sie stets das Zertifikat für die von Ihnen zu importierende Kombination aus Modell und Ventil an und akzeptieren Sie keine allgemeinen Aussagen für eine ganze Baureihe.</li>
				<li><strong>Kennzeichnung und Sprache</strong> – Bedienpiktogramme, Angaben zur Brandklasse und die Sprache des Anleitungsetiketts müssen vor der Serienproduktion für das Zielland bestätigt werden, da eine nachträgliche Umkennzeichnung kostspielig ist.</li>
				<li><strong>Chargenprüfberichte</strong> – verlangen Sie den Prüfbericht der tatsächlichen Produktionscharge, nicht eine Vorlage für ein anderes Modell. Unsere Seite zu <a href="/de/certificates/" class="text-brand-blue font-semibold hover:underline">Zertifikaten und Konformität</a> erläutert die Dokumentation für unser Brandschutzsortiment.</li>
			</ul>

			<h2 id="applications-scenarios" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">5. Einsatzorte von Feuerlöschern: Gewerbe, Lager und Fahrzeuge</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Dasselbe 5-kg-ABC-Gerät kann für sehr unterschiedliche Endanwender bestimmt sein. Die Spezifikation richtet sich nach dem Einsatzort:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Gewerbegebäude und Büros</strong> – wandmontierte ABC-Geräte mit 4–5 kg in der Nähe von Ausgängen und Gemeinschaftsbereichen, ergänzt durch CO2-Geräte in elektrischen Betriebsräumen. Wandschränke schützen das Gerät und erleichtern die Inspektion.</li>
				<li><strong>Lager und Industrieflächen</strong> – ABC-Pulver für gemischte Gefährdungen der Klassen A und B. Große offene Bereiche werden meist mit Schlauchhaspelsystemen und bei sehr hohen Decken mit stationären Löschanlagen kombiniert. Unser <a href="/de/guides/fire-hose-reel-cabinet-guide/" class="text-brand-blue font-semibold hover:underline">Leitfaden zu Schlauchhaspeln und Hydrantenschränken</a> behandelt die stationäre Ausrüstung desselben Pakets.</li>
				<li><strong>Fahrzeuge und mobile Anwendungen</strong> – kompakte Geräte für Lkw, Gabelstapler und Technikräume. Unsere 3-kg-Ausführung eignet sich für diese Bereiche und kann mit Befestigungsmaterial angeboten werden.</li>
				<li><strong>Außenbereiche und korrosive Umgebungen</strong> – der <a href="/de/products/stainless-steel-fire-extinguisher-box/" class="text-brand-blue font-semibold hover:underline">Edelstahl-Feuerlöscherschrank</a> (SS304/201 mit Sichtfenster) schützt Geräte an Flughäfen, Küstenstandorten und Chemieanlagen. Der <a href="/de/products/metal-fire-extinguisher-box-red/" class="text-brand-blue font-semibold hover:underline">rote Metall-Feuerlöscherschrank</a> mit aufgedruckter Bedienungsanleitung ist die wirtschaftliche Standardlösung für Innenbereiche.</li>
			</ul>

			<h2 id="factory-buying-checklist" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">6. Werks-Checkliste: OEM, MOQ und Gefahrgutverpackung</h2>
			<p class="text-gray-700 leading-relaxed mb-4">Der Einkauf von Feuerlöschern bei einem chinesischen Hersteller ist ebenso eine Dokumentationsaufgabe wie eine Produktaufgabe. Arbeiten Sie diese Checkliste vor der Bestellung durch:</p>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>OEM-Umfang</strong> – Zylinderfarbe, Gehäuseetikett, Logo und Etikettensprache können angepasst werden. Bestätigen Sie Druckvorlage und Freigabetermin im Bestellplan.</li>
				<li><strong>MOQ und Lieferzeit</strong> – beides hängt von Modell, Menge und Etikettenausführung ab und wird im Angebot bestätigt. Nennen Sie Zielmarkt und Jahresmenge, damit Sie eine realistische Angabe erhalten.</li>
				<li><strong>Gefahrgutklassifizierung</strong> – der unter Druck stehende Zylinder kann für den Transport als Gefahrgut eingestuft werden. Klären Sie die UN-Klassifizierung und Verpackungsanforderungen für das konkrete Modell vor der Buchung mit Ihrem Spediteur.</li>
				<li><strong>Chinesische Exportdokumente</strong> – wenn eine Sendung als Gefahrgut eingestuft ist, muss der chinesische Exporteur das Prüfzeugnis für die Transportverpackung ausgehender Gefahrgüter vorlegen. Fälle aus der Zollüberwachung zeigen, dass Sendungen ohne dieses Dokument zurückgehalten und sanktioniert werden. Lassen Sie sich vom Lieferanten bestätigen, dass das Dokument vorliegt.</li>
				<li><strong>Lieferumfang bündeln</strong> – wenn Feuerlöscher, Wandschränke, Schlauchhaspeln und Ventile bei einem Hersteller bestellt werden, vereinfacht dies Zertifikatsunterlagen und Fracht. Unsere <a href="/de/guides/b2b-valve-sourcing-checklist/" class="text-brand-blue font-semibold hover:underline">B2B-Checkliste zur Ventilbeschaffung</a> behandelt die Werksprüfung im Rahmen derselben Sorgfaltspflicht.</li>
			</ul>

			<h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Häufig gestellte Fragen</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
