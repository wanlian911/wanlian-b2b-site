---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/sections/TableOfContents.astro';
const faq = [
 { question: 'Welche Produkte fertigt und exportiert Wanlian Fluid?', answer: 'Wir fertigen Industrieventile, Hydranten und Pumpenanschlüsse, Sprinkler- und Alarmventile, hydraulische Regelventile, Löschmonitore sowie Schlauchhaspeln und Hydrantenschränke. Modell, Werkstoff und Spezifikation finden Sie im Katalog.' },
 { question: 'Welche Normen gelten für die Produkte?', answer: 'Die anzuwendende Norm hängt von Modell und Zielmarkt ab. Wir arbeiten unter anderem mit AWWA, ISO 5208, EN 1074, EN 12266-1, NFPA, GB sowie den jeweils geltenden nationalen Anforderungen. Prüfberichte je Modell werden auf Anfrage bereitgestellt.' },
 { question: 'Werden CAD-Zeichnungen, Datenblätter und Prüfberichte bereitgestellt?', answer: 'Ja. Zertifikate, hydrostatische Prüfungen, Datenblätter, CAD-Zeichnungen und Montageanleitungen sind auf Anfrage verfügbar. Bitte nennen Sie Modell und Zielmarkt, damit die passenden Unterlagen bestätigt werden können.' },
 { question: 'Sind die Ventile UL- oder FM-zertifiziert?', answer: 'Eine UL- oder FM-Zertifizierung gilt für ein bestimmtes Produkt und Modell. Bitte bestätigen Sie vor der Bestellung die Abdeckung des exakten Modells und fordern Sie die zugehörigen Zertifikate an.' },
 { question: 'Wie hoch sind MOQ und Lieferzeit?', answer: 'Die Standard-Mindestbestellmenge beträgt für Lagergrößen meist 20 Stück je Modell. Die Produktion dauert normalerweise 15–30 Tage, abhängig von Menge und kundenspezifischer Ausführung. Musterbestellungen sind zur Freigabe möglich.' },
 { question: 'Warum werden auf der Website keine öffentlichen Preise angezeigt?', answer: 'Der B2B-Preis hängt von Modell, Nennweite, Werkstoff, Menge, Incoterm und Zielort ab. Senden Sie eine vollständige Spezifikation, um in der Regel innerhalb von 12 Stunden ein detailliertes Angebot zu erhalten.' },
 { question: 'Ist eine Inspektion durch Dritte vor dem Versand möglich?', answer: 'Ja. SGS, Bureau Veritas, Intertek oder ein vom Käufer benannter Prüfer können Stückprüfungen begleiten und die Werksunterlagen vor dem Versand überprüfen.' },
 { question: 'Welche Dokumente werden mit der Bestellung geliefert?', answer: 'Je nach Projekt umfasst das Dokumentenpaket Handelsrechnung, Packliste, Konnossement, Ursprungszeugnis, Stückprüfberichte sowie Werkstoff- und Normzertifikate.' },
 { question: 'Bieten Sie OEM/ODM und Eigenmarken an?', answer: 'Ja. Wir bieten OEM/ODM, kundenspezifische Kennzeichnung, Exportverpackung und technische Dokumentation für Distributoren – abhängig von Modell und Bestellmenge.' },
 { question: 'Wie kann ich mich nach der Bestellung melden?', answer: 'Senden Sie Ihre Anfrage an sales@wanlian911.com oder kontaktieren Sie uns über WhatsApp unter +86 186 8432 4501. Bei Garantie- oder Ersatzteilanfragen geben Sie bitte Seriennummer und Modell an.' }
];
const toc = [{ id: 'products', label: 'Produkte und Spezifikationen' }, { id: 'certification', label: 'Zertifizierung und Konformität' }, { id: 'procurement', label: 'Einkauf, Produktion und Logistik' }];
const sections = [{ id: 'products', title: 'Produkte und Spezifikationen', items: faq.slice(0, 3) }, { id: 'certification', title: 'Zertifizierung und Konformität', items: faq.slice(3, 5) }, { id: 'procurement', title: 'Einkauf, Produktion und Logistik', items: faq.slice(5) }];
---
<Layout title="Häufige Fragen zu Ventilen und Brandschutzausrüstung" description="B2B-Antworten zu MOQ, Lieferzeiten, UL/FM-Zertifizierung, Inspektion, Exportdokumenten, OEM und Kundendienst." type="website" faq={faq} breadcrumbs={[{ name: 'FAQ' }]} locale="de">
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16"><nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/de/">Startseite</a><span>/</span><span class="text-gray-600">FAQ</span></nav>
    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10"><p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">FAQ für Einkäufer · Aktualisiert 2026</p><h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Häufige Fragen zu Ventilen und Brandschutzausrüstung</h1><p class="mt-5 text-gray-600 leading-relaxed text-lg">Klare Antworten für B2B-Einkäufer, die Brandschutzausrüstung und Fluidtechnik von einem chinesischen Hersteller spezifizieren und importieren.</p><TableOfContents headings={toc}/>{sections.map(section => <section><h2 id={section.id} class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">{section.title}</h2><div class="space-y-4">{section.items.map(item => <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>)}</div></section>)}
      <div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white">Ihre Frage ist nicht dabei?</h2><p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Senden Sie uns Spezifikation, Nennweiten und Zielort. Ein Ingenieur antwortet innerhalb von 12 Stunden.</p><a href="/de/contact/" class="inline-block mt-6 px-8 py-4 bg-brand-red text-white font-bold rounded-lg">Angebot anfordern</a></div></div>
    </article>
  </main>
</Layout>
