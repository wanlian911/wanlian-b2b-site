---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{
		question: 'Was ist der Unterschied zwischen Innen- und Überflurhydranten?',
		answer: 'Innenhydranten mit Wandhydrantenventil SN65 werden an Steigleitungsanlagen von Gebäuden angeschlossen und versorgen die Schlauchanschlüsse auf den einzelnen Geschossen. Überflurhydranten des Typs SS100 werden aus kommunalen oder industriellen Versorgungsleitungen gespeist und dienen der Versorgung von Feuerwehrfahrzeugen sowie der Brandbekämpfung im Außenbereich. Beide Bauarten bedienen unterschiedliche Entnahmestellen und werden nach unterschiedlichen Regelwerken ausgelegt.'
	},
	{
		question: 'Welche Anschlussnormen sind für exportgeeignete Hydranten verfügbar?',
		answer: 'Zu den gängigen Abgangsanschlüssen gehören BS336 (Vereinigtes Königreich und Commonwealth), NIST (Nahost), KWS (Deutschland) sowie flexible Flanschlösungen. Wanlian fertigt Hydranten SS100/65 und SSFT100/65 mit dem für Ihren Zielmarkt vorgegebenen Anschlusstyp und kann passende Kupplungen und Adapter im selben Container mitliefern.'
	},
	{
		question: 'Sind Wanlian-Hydranten mit UL- oder FM-Zertifizierung erhältlich?',
		answer: 'Ja, abhängig von Modell und Zielmarkt. Senden Sie unserem Vertrieb Ihre Projektspezifikation und Zielregion, damit wir das passende Zertifizierungspaket zuordnen können: UL/FM für Nordamerika, CE für Europa und LPCB für Projekte im Vereinigten Königreich und im Commonwealth.'
	},
	{
		question: 'Welcher Hydrant eignet sich für eine Stadt mit kaltem Klima?',
		answer: 'Der Überflurhydrant SS100 verfügt über einen automatischen Entleerungsmechanismus nach dem Schließen. Die trockene Bauweise verhindert das Einfrieren und ein Bersten des Hydrantenkörpers und ist daher die Standardlösung für kommunale Netze in kalten Regionen. Für verkehrsbelastete Standorte bietet die anprallgeschützte Variante SSFT100 zusätzlich einen Sollbruchkörper und eine Druckregelung.'
	},
	{
		question: 'Können intelligente Hydranten in unser SCADA-System integriert werden?',
		answer: 'Ja. Der IoT-Hydrant SS100ZN überträgt Druck-, Neigungs- und Ventilstatusdaten über NB-IoT, LTE-M oder GPRS und lässt sich in gängige SCADA-Plattformen integrieren. Fordern Sie vor der Bestellung die Spezifikation der Datenschnittstelle und ein Mustergerät für Integrationstests an.'
	}
];

const hydrantProducts = [
	{
		slug: 'indoor-fire-hydrant-head-sn65',
		name: 'Wandhydrantenventil für Innenbereiche SN65',
		img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg',
		desc: 'Wandhydrantenventil aus Sphäroguss, PN16, für Steigleitungsanlagen'
	},
	{
		slug: 'overground-fire-hydrant-ss100',
		name: 'Frostgeschützter Überflurhydrant SS100/65',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'Trockene Bauweise mit Frostschutzentleerung für kommunale Netze in kalten Regionen'
	},
	{
		slug: 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100',
		name: 'Anprallgeschützter Hydrant mit Druckregelung SSFT100/65',
		img: '/assets/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100.webp',
		desc: 'Sollbruchkörper und Druckregelung für Verkehrsflächen und Industriehöfe'
	},
	{
		slug: 'iot-smart-ground-fire-hydrant-ss100zn',
		name: 'Intelligenter IoT-Überflurhydrant SS100/65-1.6ZN',
		img: '/assets/products/overground-fire-hydrant-ss100.webp',
		desc: 'Echtzeitüberwachung von Druck, Neigung und Wasserentnahme für intelligente Netze'
	},
	{
		slug: 'fire-hydrant-hose-coupling-adapter-hs',
		name: 'Aluminium-Schlauchkupplungsadapter, Baureihe HS',
		img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg',
		desc: 'BS336-, NIST- und KWS-kompatible Kupplungen für die Verbindung von Hydrant und Schlauch'
	}
];

const trustBadges = ['PN16 / 2,4 MPa geprüft', 'BS336 / NIST / KWS', 'Frostgeschützte Trockenbauweise', 'IoT- und SCADA-bereit'];
---

<Layout
	locale="de"
	title="Hydrantensysteme &amp; Hydrantenventile | Wanlian Fluid"
	description="Hydrantensysteme mit Wandhydrantenventilen SN65, Überflurhydranten SS100, anprallgeschützten SSFT100 und intelligenten IoT-Hydranten SS100ZN. PN16, direkt ab Werk."
	type="product"
	productData={{
		name: 'Hydrantensysteme',
		image: '/assets/products/overground-fire-hydrant-ss100.webp',
		description: 'Innen- und Außenhydranten sowie intelligente Hydrantensysteme für kommunale Netze, Industriehöfe und Gebäude-Steigleitungsanlagen, gefertigt von Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Hydrantensysteme' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/de/" class="hover:text-blue-600">Startseite</a>
			<span>/</span>
			<a href="/de/products/" class="hover:text-blue-600">Produkte</a>
			<span>/</span>
			<span class="text-gray-600">Hydrantensysteme</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Komplette Hydrantenbaureihe — im eigenen Werk gefertigt</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Komplette Hydrantensysteme für kommunale und industrielle Netze</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid fertigt die vollständige Hydrantenbaureihe: Wandhydrantenventile SN65 für Innenbereiche, Überflurhydranten SS100, anprallgeschützte Hydranten SSFT100 und intelligente IoT-Hydranten SS100ZN. Exportanschlüsse nach BS336, NIST und KWS sowie passende Kupplungen werden auf unseren eigenen Produktionslinien für das gesamte Hydrantennetz gefertigt.</p>

			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Komponenten der Hydrantensysteme</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydrantProducts.map(p => (
					<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Wichtige Spezifikationen</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Modell</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Typ</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Hauptmerkmal</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Nenndaten</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SN65</td>
							<td class="px-4 py-3 text-gray-700">Wandhydrantenventil für Innenbereiche</td>
							<td class="px-4 py-3 text-gray-700">Gerillter oder geflanschter Zulauf, Montage im Hydrantenschrank</td>
							<td class="px-4 py-3 text-gray-700">PN16 (mit 2,4 MPa geprüft)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SS100/65</td>
							<td class="px-4 py-3 text-gray-700">Überflurhydrant</td>
							<td class="px-4 py-3 text-gray-700">Automatische Frostschutzentleerung der Trockenbauweise</td>
							<td class="px-4 py-3 text-gray-700">PN16, 2 × 65 mm + 1 × 100 mm Abgänge</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SSFT100/65</td>
							<td class="px-4 py-3 text-gray-700">Anprallgeschützter Hydrant</td>
							<td class="px-4 py-3 text-gray-700">Sollbruchkörper, Druckregelung und automatische Entleerung</td>
							<td class="px-4 py-3 text-gray-700">PN16, kalibrierte Scherbolzen</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SS100ZN</td>
							<td class="px-4 py-3 text-gray-700">Intelligenter IoT-Hydrant</td>
							<td class="px-4 py-3 text-gray-700">NB-IoT/4G, Überwachung von Druck, Neigung und Wasserentnahme</td>
							<td class="px-4 py-3 text-gray-700">GB4452-2011, Batterielebensdauer 5 Jahre</td>
						</tr>
					</tbody>
				</table>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Anwendungen</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Kommunale Wasserversorgungsnetze und Löschwasserleitungen</li>
				<li>Industriehöfe, Tanklager und Brandbekämpfung in Lagerhallen</li>
				<li>Steigleitungs- und Schlauchanlagen in Gebäuden mit Wandhydrantenventilen</li>
				<li>Intelligente Stadtnetze mit Anforderungen an die Fernüberwachung</li>
				<li>Installationen in kalten Regionen mit erforderlichem Frostschutz</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Komplettlösung: Steigleitungs- und Alarmventile</h2>
			<p class="text-gray-600 leading-relaxed mb-6">Ein Hydrantennetz funktioniert nur mit den vorgeschalteten Ventilen, die es versorgen. Wanlian fertigt Alarm-, Sprühflut- und Pre-Action-Ventile ebenfalls in der PN16-Baureihe aus Sphäroguss. Spezifizieren Sie Hydranten und Ventilsatz gemeinsam: Alles wird in einem Container mit einem Prüfprotokollsatz und einem zentralen Ansprechpartner versendet.</p>
			<div class="grid sm:grid-cols-2 gap-4">
				<a href="/de/products/deluge-alarm-valve-zsfm/" class="group bg-gray-50 rounded-xl border border-gray-100 hover:border-brand-red p-4 transition">
					<p class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-1">Produkt</p>
					<p class="text-sm font-bold text-gray-900 group-hover:text-brand-red leading-snug">Sprühflut-Alarmventil ZSFM (PN16)</p>
				</a>
				<a href="/de/guides/how-to-choose-ul-listed-fire-valves/" class="group bg-gray-50 rounded-xl border border-gray-100 hover:border-brand-red p-4 transition">
					<p class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-1">Leitfaden</p>
					<p class="text-sm font-bold text-gray-900 group-hover:text-brand-red leading-snug">Auswahl UL-gelisteter Brandschutzventile</p>
				</a>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Leitfäden zur Hydrantenauswahl</h2>
			<div class="grid sm:grid-cols-3 gap-4">
				<a href="/de/guides/how-to-choose-a-fire-hydrant/" class="group bg-gray-50 rounded-xl border border-gray-100 hover:border-brand-red p-4 transition">
					<p class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-1">Auswahl</p>
					<p class="text-sm font-bold text-gray-900 group-hover:text-brand-red leading-snug">So wählen Sie den passenden Hydranten</p>
					<p class="text-[11px] text-gray-500 mt-1">Innen- oder Außenhydrant, trockene oder nasse Bauweise, Abgangsnormen</p>
				</a>
				<a href="/de/guides/fire-hydrant-valve-standards-guide/" class="group bg-gray-50 rounded-xl border border-gray-100 hover:border-brand-red p-4 transition">
					<p class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-1">Normen</p>
					<p class="text-sm font-bold text-gray-900 group-hover:text-brand-red leading-snug">Hydranten- und Ventilnormen erklärt</p>
					<p class="text-[11px] text-gray-500 mt-1">AWWA C502, NFPA 1963 und die Zuordnung zu Ihrem Projekt</p>
				</a>
				<a href="/de/guides/antifreeze-anti-collision-fire-hydrant-guide/" class="group bg-gray-50 rounded-xl border border-gray-100 hover:border-brand-red p-4 transition">
					<p class="text-[10px] font-bold text-brand-blue uppercase tracking-wider mb-1">Sondereinsatz</p>
					<p class="text-sm font-bold text-gray-900 group-hover:text-brand-red leading-snug">Frostgeschützte und anprallgeschützte Hydranten</p>
					<p class="text-[11px] text-gray-500 mt-1">Entleerung trockener Hydrantenkörper und Sollbruchausführungen für anspruchsvolle Standorte</p>
				</a>
			</div>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Hydrantenbeschaffung für Südostasien</h2>
			<p class="text-gray-600 leading-relaxed mb-6">Wanlian versendet über die Häfen Xiamen und Quanzhou. Kurze Seefrachtrouten verbinden diese Häfen mit den wichtigsten südostasiatischen Umschlagplätzen. Angebote werden FOB Xiamen oder CIF Bestimmungshafen erstellt. Teilen Sie uns Ihren Hafen und die für Ihr lokales Projekt erforderliche Abgangsnorm mit.</p>
			<ul class="space-y-3 mb-4">
				<li class="flex gap-3 items-start">
					<span class="mt-1 w-2 h-2 bg-brand-red rounded-full shrink-0"></span>
					<span class="text-gray-700 text-sm leading-relaxed">Abgänge werden nach der für Ihr Projekt vorgegebenen Norm bearbeitet; passende Kupplungen und Adapter werden im selben Container mitgeliefert</span>
				</li>
				<li class="flex gap-3 items-start">
					<span class="mt-1 w-2 h-2 bg-brand-red rounded-full shrink-0"></span>
					<span class="text-gray-700 text-sm leading-relaxed">Seefeste Verpackung in Holzkisten; auf Wunsch erhalten Sie vor dem Versand Fotos der Beladung</span>
				</li>
				<li class="flex gap-3 items-start">
					<span class="mt-1 w-2 h-2 bg-brand-red rounded-full shrink-0"></span>
					<span class="text-gray-700 text-sm leading-relaxed">Dokumentationspaket zu jeder Bestellung: Gehäuse- und Dichtungssitzprüfprotokolle, Packliste sowie auf Wunsch Ursprungszeugnis</span>
				</li>
				<li class="flex gap-3 items-start">
					<span class="mt-1 w-2 h-2 bg-brand-red rounded-full shrink-0"></span>
					<span class="text-gray-700 text-sm leading-relaxed">Wir erstellen Angebote für Einzelersatzteile bis hin zu vollständigen Containerladungen. Senden Sie Modell, Menge und Bestimmungshafen</span>
				</li>
			</ul>

			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Häufig gestellte Fragen</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Benötigen Sie ein projektspezifisch ausgelegtes Hydrantennetz?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Senden Sie uns DN/PN, Anschlussnorm und gewünschte Zertifizierung. Unsere Ingenieure antworten innerhalb von 12 Stunden mit einem vollständigen technischen Datenblatt und einem Angebot.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/de/contact/?product=Hydrantensysteme" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Angebot anfordern</a>
						<a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Guten Tag, ich benötige Unterstützung bei der Auswahl eines Hydrantensystems.')}`} class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Über WhatsApp kontaktieren</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
