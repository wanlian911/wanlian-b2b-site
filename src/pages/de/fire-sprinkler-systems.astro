---
import Layout from '../../layouts/Layout.astro';

const faq = [
	{ question: 'Sind Ihre Sprinklerköpfe UL-gelistet?', answer: 'Ja. Unsere Sprinklerköpfe und Systemkomponenten sind, sofern zutreffend, nach UL/ULC gelistet. Die Zertifikate sind auf unserer Zertifikatsseite verfügbar. Vor der Angebotserstellung bestätigen unsere Ingenieure das genaue Zertifizierungspaket für den Zielmarkt.' },
	{ question: 'Was ist der Unterschied zwischen Nass- und Trockensprinkleranlagen?', answer: 'Bei Nassanlagen befindet sich das Wasser für eine sofortige Auslösung beim Öffnen eines Sprinklerkopfs in den Rohrleitungen. Trockensysteme arbeiten mit Druckluft oder Stickstoff und einem Trockenrohrventil und eignen sich für unbeheizte Bereiche mit Frostgefahr. Vorgesteuerte Trockensysteme verbinden beide Vorteile für wasserempfindliche Bereiche.' },
	{ question: 'Liefern Sie flexible Anschlussleitungen für Sprinklerköpfe?', answer: 'Ja, wir fertigen flexible, edelstahlummantelte Anschlussleitungen, die die Montage vereinfachen und eine schnelle Anpassung der Sprinklerköpfe an die Deckengeometrie ermöglichen. Gegenüber starren Rohrleitungen wird dadurch die Montagezeit verkürzt.' },
	{ question: 'Können Sie ein vollständiges Leistungsverzeichnis-Angebot für die Anlage erstellen?', answer: 'Ja. Senden Sie uns Ihre Projektzeichnungen oder eine Komponentenliste. Wir bieten Sprinklerköpfe, Alarmventile, Strömungswächter, Schmutzfänger und Zubehör als ein Paket an – eine Bestellung ab Werk für den gesamten Sprinklerstrang.' },
	{ question: 'Welche Temperaturauslösungen sind verfügbar?', answer: 'Standardausführungen mit Glasampulle sind für 57 °C, 68 °C, 79 °C, 93 °C und 141 °C mit farbcodierten Ampullen erhältlich, als Sprinkler mit Standardauslösung (5-mm-Ampulle) oder Schnellauslösung (3-mm-Ampulle) gemäß NFPA-Praxis.' }
];

const sprinklerProducts = [
	{ slug: 'glass-bulb-fire-sprinkler-zst', name: 'Brandschutzsprinkler mit Glasampulle (ZST-Serie)', img: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png', desc: 'Hängend/stehend/seitlich, K=80/115, 57–141 °C' },
	{ slug: 'wet-alarm-check-valve-zsfz-150', name: 'Nassalarm-Rückschlagventil (ZSFZ 150)', img: '/assets/products/wet-alarm-check-valve-zsfz-150.webp', desc: 'Hydraulische Alarmglocke, Verzögerungskammer, DN100–DN200' },
	{ slug: 'deluge-alarm-valve-zsfm', name: 'Sprühflut-Alarmventilstation (ZSFM)', img: '/assets/products/deluge-alarm-valve-zsfm.webp', desc: 'Membrangesteuert für Sprühflut- und Wasserberieselungsanlagen' },
	{ slug: 'pre-action-alarm-system-zsfy', name: 'Vorgesteuerte Alarmventilstation (ZSFY)', img: '/assets/products/pre-action-alarm-system-zsfy.jpg', desc: 'Doppelauslösung mit Ausfallsicherung für Bibliotheken, Archive und Rechenzentren' },
	{ slug: 'water-flow-indicator-zsjz', name: 'Strömungswächter mit Flügelrad (ZSJZ)', img: '/assets/products/water-flow-indicator-zsjz.png', desc: 'Einstellbare Verzögerung 2–60 s, DN50–DN200, Sattel-/Flanschanschluss' },
	{ slug: 'telescopic-y-strainer-sgl41h', name: 'Teleskop-Y-Schmutzfänger (SGL41H)', img: '/assets/products/telescopic-y-strainer-sgl41h.webp', desc: 'Schützt Ventile vor Partikeln, Sieb aus SS304/316' },
	{ slug: 'horizontal-sidewall-fire-sprinkler-t-zstbs', name: 'Horizontaler Seitenwandsprinkler (T-ZSTBS)', img: '/assets/products/horizontal-sidewall-fire-sprinkler-t-zstbs.png', desc: 'Seitlicher T-Kopf, K=80/115, für den Schutz unter Trägern und in Regallagern' },
	{ slug: 'zstdy-concealed-fire-sprinkler', name: 'Verdeckter Brandschutzsprinkler (ZST-DY)', img: '/assets/products/zstdy-concealed-fire-sprinkler.webp', desc: 'Versenkter dekorativer Kopf, farblich passende Rosette für fertige Decken' },
	{ slug: 'indoor-fire-hydrant-head-sn65', name: 'Wandhydrantenkopf für Innenbereiche (SN65)', img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg', desc: 'Innenliegender Strahlrohranschluss DN65 für Feuerlöschstationen in Gebäuden' }
];
---

<Layout locale="de"
	title="Sprinkleranlagen & UL-Sprinklerköpfe – WLFE"
	description="UL-gelistete Sprinklerköpfe, flexible Anschlüsse und vollständige Komponenten für Sprinkleranlagen in Gewerbe- und Industriebauten. Direkt ab Werk."
	type="product"
	productData={{ name: 'Sprinkleranlagen', image: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png', description: 'UL-gelistete Sprinklerköpfe, Alarmventile, Strömungswächter und Systemkomponenten für Nass-, Trocken- und vorgesteuerte Sprinkleranlagen in Gewerbe- und Industriebauten, gefertigt von Quanzhou Wanlian Fluid Equipment Co., Ltd.' }}
	faq={faq} breadcrumbs={[{ name: 'Sprinkleranlagen' }]}>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2"><a href="/de/" class="hover:text-blue-600">Startseite</a><span>/</span><a href="/de/products/" class="hover:text-blue-600">Produkte</a><span>/</span><span class="text-gray-600">Sprinkleranlagen</span></nav>
		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Komplette Sprinkleranlagen – direkt ab Werk</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Komplette Sprinkleranlagen mit UL-gelisteten Komponenten</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid fertigt und exportiert UL-gelistete Sprinklerköpfe, flexible Anschlussleitungen, Alarmventile und Systemzubehör für Nass-, Trocken- und vorgesteuerte Anlagen in Gewerbe- und Industriebauten – eine Bestellung ab Werk für den gesamten Sprinklerstrang.</p>
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">{['UL/ULC-gelistet', 'K=80 / K=115', 'Temperaturbereiche 57–141 °C', 'Vollständiges Leistungsverzeichnis'].map(b => (<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center"><span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span></div>))}</div>
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Komponenten für Sprinkleranlagen</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">{sprinklerProducts.map(p => (<a href={`/de/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition"><img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" /><div class="p-3"><p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p><p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p></div></a>))}</div>
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Wichtige technische Daten</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5"><table class="min-w-full divide-y divide-gray-200 text-sm"><thead class="bg-gray-50"><tr><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Spezifikation</th><th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Details</th></tr></thead><tbody class="bg-white divide-y divide-gray-200">
				<tr><td class="px-4 py-3 font-bold text-gray-900">Zertifizierung</td><td class="px-4 py-3 text-gray-700">UL/ULC-gelistet (modell- und zielmarktbezogen)</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Sprinklergrößen</td><td class="px-4 py-3 text-gray-700">1/2" (DN15), 3/4" (DN20), 1" – hängend, stehend, seitlich</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Durchflussbeiwert</td><td class="px-4 py-3 text-gray-700">K=80 ±4 / K=115 ±9 (weitere K-Faktoren modellabhängig)</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Temperaturauslösungen</td><td class="px-4 py-3 text-gray-700">57 °C / 68 °C / 79 °C / 93 °C / 141 °C, farbcodierte Glasampullen</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Auslösearten</td><td class="px-4 py-3 text-gray-700">Standardauslösung (5-mm-Ampulle) / Schnellauslösung (3-mm-Ampulle)</td></tr>
				<tr><td class="px-4 py-3 font-bold text-gray-900">Anlagenventile</td><td class="px-4 py-3 text-gray-700">Nassalarm (ZSFZ), Sprühflut (ZSFM), vorgesteuert (ZSFY), Strömungswächter (ZSJZ)</td></tr>
			</tbody></table></div>
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Anwendungen</h2><p class="text-gray-700 leading-relaxed">Unsere Komponenten für Sprinkleranlagen schützen Bürogebäude, Hotels, Krankenhäuser, Schulen, Fabriken, Lagerhäuser, Rechenzentren und Tiefgaragen. Vorgesteuerte Anlagen werden für Bibliotheken, Archive und Technikräume empfohlen, in denen eine unbeabsichtigte Auslösung vermieden werden muss.</p>
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Warum Wanlian Fluid?</h2><ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4"><li><strong>Komplettanlage aus einer Bestellung</strong> – Sprinklerköpfe, Anschlüsse, Alarmventile und Zubehör als ein Paket ab Werk.</li><li><strong>Zertifizierte Komponenten</strong> – sofern zutreffend UL/ULC-gelistet; Zertifikate auf unserer <a href="/de/certificates/" class="text-brand-blue font-semibold hover:underline">Zertifikatsseite</a>.</li><li><strong>Orientierung an Bauvorschriften</strong> – Konfigurationen nach NFPA-Praxis für internationale Projektabnahmen.</li></ul>
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Häufig gestellte Fragen</h2><div class="space-y-4">{faq.map(item => (<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30"><summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none"><span>{item.question}</span><span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span></summary><p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p></details>))}</div>
			<div class="mt-12 rounded-2xl overflow-hidden"><div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center"><h2 class="text-2xl font-black text-white tracking-tight">Benötigen Sie Komponenten für eine Sprinkleranlage?</h2><p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Senden Sie uns Gebäudetyp und Komponentenliste – wir antworten innerhalb von 12 Stunden mit einem vollständigen Leistungsverzeichnis-Angebot.</p><div class="mt-6 flex flex-col sm:flex-row justify-center gap-4"><a href="/de/contact/?product=Sprinkleranlagen" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Angebot anfordern</a><a href={`https://wa.me/8618684324501?text=${encodeURIComponent('Guten Tag, ich benötige Komponenten für eine Sprinkleranlage.')}`} class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Über WhatsApp chatten</a></div></div></div>
		</article>
	</main>
</Layout>
