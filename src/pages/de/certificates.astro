---
import Layout from '../../layouts/Layout.astro';
const certifications = [
  { name: 'UL-gelistet', code: 'UL 262 / UL 1091', desc: 'Norm für Absperrschieber und Rückschlagventile im Brandschutz.', scope: 'Brandschutzarmaturen für den nordamerikanischen Markt gemäß dem Geltungsbereich des jeweiligen Zertifikats.', products: 'Weichdichtende Absperrschieber, Rückschlagventile', verify: 'Die Listung gilt für die im UL-Zertifikat aufgeführten Modelle. Bitte fordern Sie den Modellabgleich und eine Kopie an.', icon: '🏆' },
  { name: 'FM-zugelassen', code: 'Class 1120/1130', desc: 'Zulassung für Brandschutz-Absperrarmaturen, einschließlich OS&Y- und NRS-Ausführungen.', scope: 'Brandschutz-Absperrarmaturen gemäß FM Class 1120/1130, soweit im Zulassungsdokument aufgeführt.', products: 'OS&Y-Absperrschieber und weitere Brandschutzarmaturen', verify: 'Die Zulassung ist modellbezogen. Kopien der relevanten FM-Unterlagen werden auf Anfrage bereitgestellt.', icon: '🛡️' },
  { name: 'CE-Kennzeichnung', code: 'EN 12266-1', desc: 'Konformität mit den anwendbaren europäischen Anforderungen an Gesundheit, Sicherheit und Umweltschutz.', scope: 'Druckgeräte und Armaturen mit Prüfung nach EN 12266-1 innerhalb der jeweils anwendbaren Richtlinie.', products: 'Armaturen für EU-Projekte gemäß Richtlinienumfang', verify: 'Bitte teilen Sie Markt, Medium und Projektanforderung mit, damit Richtlinie und Kategorie bestätigt werden können.', icon: '🇪🇺' },
  { name: 'ISO 9001:2015', code: 'Qualitätsmanagement', desc: 'Internationaler Standard für Qualitätsmanagementsysteme in der Fertigung.', scope: 'Entwicklung, Produktion und Vertrieb von Armaturen, Brandschutzausrüstung und Fluidtechnik unter einem zertifizierten ISO-9001:2015-System.', products: 'Alle Fertigungslinien', verify: 'Zertifikat und ausstellende Stelle werden zur Prüfung auf Anfrage bereitgestellt.', icon: '⚙️' },
  { name: 'LPCB-Zertifizierung', code: 'Loss Prevention', desc: 'RedBook-Listung für Brandschutzprodukte und -leistungen.', scope: 'Aufgeführte Brandschutzprodukte für die Märkte des Vereinigten Königreichs und des Commonwealth.', products: 'Gemäß dem jeweiligen RedBook-Eintrag', verify: 'Die Listung gilt für die im Eintrag genannten Produkte und Normen. Bitte teilen Sie das Zielmodell mit.', icon: '📜' },
  { name: 'Chinesische GB-Normen', code: 'GB 5135 / GB 4452', desc: 'Konformität mit den anwendbaren chinesischen Normen für Brandschutzausrüstung.', scope: 'Fertigung und Prüfung nach den jeweils anwendbaren Normen der GB-5135-, GB-4452- und GB-50974-Reihe.', products: 'Sprinklerkomponenten, Hydranten und Alarmventile', verify: 'Die konkrete GB-Konformität ist modellbezogen; Prüfberichte werden auf Anfrage bereitgestellt.', icon: '🇨🇳' }
];
const faq = [
  { question: 'Verfügt Wanlian Fluid über ISO 9001?', answer: 'Ja. Die Fertigung erfolgt unter einem ISO-9001:2015-Qualitätsmanagementsystem für Entwicklung, Produktion und Vertrieb. Zertifikatsnummer und ausstellende Stelle werden zur Prüfung bereitgestellt.' },
  { question: 'Sind die Brandschutzarmaturen UL-gelistet oder FM-zugelassen?', answer: 'Bestimmte Absperrschieber und Rückschlagventile sind gemäß UL 262 / UL 1091 gelistet; bestimmte Brandschutzarmaturen verfügen über FM Class 1120/1130. Die Bestätigung erfolgt exakt nach Modell und Zertifikatsumfang.' },
  { question: 'Wie kann ich Zertifikate verifizieren?', answer: 'Zertifikatsnummer, Hersteller, Modell und Geltungsbereich können beim jeweiligen Aussteller abgeglichen werden. Wir stellen die für Ihr Projekt relevanten Kopien und Prüfunterlagen bereit.' }
];
---
<Layout locale="de" title="Technische Dokumentation und Zertifikate | Wanlian Fluid" description="Fordern Sie technische Dokumentation, Prüfberichte, Werkstoffoptionen und Exportunterlagen für Wanlian-Armaturen und Brandschutzausrüstung an." faq={faq} breadcrumbs={[{ name: 'Zertifikate' }]}>
  <section class="py-24 bg-gray-900 text-white"><div class="max-w-7xl mx-auto px-4"><h1 class="text-5xl font-black mb-8">Technische <span class="text-brand-red">Dokumentation.</span></h1><p class="text-xl text-gray-400 max-w-2xl leading-relaxed">Teilen Sie Ihre Projektanforderungen. Wir stellen verfügbare Produktinformationen, technische Spezifikationen und Dokumente zur Bewertung bereit.</p></div></section>
  <section class="py-24 bg-white"><div class="max-w-7xl mx-auto px-4"><div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">{certifications.map(cert => <div class="p-8 bg-gray-50 rounded-2xl border hover:border-brand-blue/30"><div class="text-4xl mb-6">{cert.icon}</div><h2 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h2><p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p><p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p><div class="space-y-3 text-sm text-gray-600"><p><strong class="text-gray-900">Geltungsbereich: </strong>{cert.scope}</p><p><strong class="text-gray-900">Abgedeckte Produkte: </strong>{cert.products}</p><p class="text-xs text-gray-500 border-t pt-3">{cert.verify}</p></div></div>)}</div><div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center"><h2 class="text-3xl font-black">Benötigen Sie Zertifikate oder technische Datenblätter?</h2><p class="text-gray-400 max-w-2xl mx-auto mt-4">Wir stellen Zertifikate, hydrostatische Prüfberichte, Datenblätter, CAD-Zeichnungen und Montageanleitungen auf Anfrage bereit. Nennen Sie Modell, Zertifizierung und Zielmarkt.</p><div class="flex flex-wrap justify-center gap-4 mt-7"><a href="/de/contact/?product=Anfrage%20zu%20Zertifikaten%20und%20technischer%20Dokumentation" class="px-10 py-5 bg-brand-red rounded-xl font-black">Dokumente anfordern</a><a href="/de/products/" class="px-10 py-5 bg-white/10 border border-gray-600 rounded-xl font-black">Zertifizierte Produkte ansehen</a></div></div></div></section>
</Layout>
