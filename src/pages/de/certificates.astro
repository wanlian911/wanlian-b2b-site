---
import Layout from '../../layouts/Layout.astro';
const certifications = [
  { name: 'ISO 9001:2015', code: 'IM EIGENEN NAMEN', desc: 'Qualitätsmanagementsystem von Quanzhou Wanlian Fluid Equipment Co., Ltd.', scope: 'Entwicklung, Produktion und Vertrieb von Armaturen, Brandschutzausrüstung und Fluidtechnik unter einem zertifizierten Qualitätsmanagementsystem nach ISO 9001:2015.', products: 'Unser gesamtes Sortiment: eigene Fertigungslinien und von Partnerwerken bezogene Produkte', verify: 'Zertifikatsnummer und ausstellende Stelle werden zur Prüfung bereitgestellt. Eine Kopie liegt Ihren Auftragsunterlagen bei.', icon: '⚙️' },
  { name: 'Prüfprotokolle je Charge', code: 'IM EIGENEN NAMEN', desc: 'Dokumentierte Prüfungen von Gehäusedruck und Sitzdichtheit für jede Charge.', scope: 'Jede Einheit wird vor der Verpackung nach GB/T 13927 oder EN 12266-1 gemäß Ihrer Spezifikation auf Gehäusedruck und Luftdichtheit geprüft; die Protokolle werden mit den Seriennummern auf der Packliste abgeglichen.', products: 'Alle von uns gelieferten Armaturen und Brandschutzausrüstungen', verify: 'Die Prüfprotokolle werden mit den Exportdokumenten versandt. Prüfungen unter Beteiligung Dritter (SGS, BV, Intertek) können vor dem Versand organisiert werden.', icon: '🧪' },
  { name: 'EN 12266-1 / GB-5135-Reihe', code: 'AUSLEGUNGS- UND PRÜFGRUNDLAGE', desc: 'Grundlage für Fertigung und Prüfung, wenn für Ihre Spezifikation keine Listung Dritter gilt.', scope: 'Armaturen werden nach EN 12266-1 oder GB/T 13927 gemäß Ihrer Spezifikation gefertigt und geprüft; Sprinklerkomponenten, Hydranten und Alarmventile folgen der GB-5135-Reihe, GB 4452 und GB 50974, und die Systemauslegung berücksichtigt EN 12845. Eine CE-Kennzeichnung wird, soweit anwendbar, vom Werk erklärt, das diese Erklärung hält.', products: 'Sprinklerkomponenten, Hydranten, Alarmventile und Armaturen für allgemeine Anwendungen', verify: 'Dies ist eine Erklärung der Fertigungs- und Prüfgrundlage, keine Zertifizierung; wir kennzeichnen sie entsprechend. Werksprüfberichte werden mit der Lieferung bereitgestellt.', icon: '🧱' },
  { name: 'UL 262 / UL 1091', code: 'IM NAMEN DES HERSTELLERWERKS', desc: 'Normen für Absperrschieber und Rückschlagventile im Brandschutz in Nordamerika.', scope: 'Eine UL-Listung wird dem Werk gewährt, das das gelistete Modell herstellt. Wanlian besitzt keine UL-Listungen und tritt auch nicht als deren Inhaber auf.', products: 'Gelistete Modelle können, sofern von Ihrer Spezifikation verlangt, vom zertifikathaltenden Werk bezogen werden', verify: 'Wenn Ihre Ausschreibung UL nennt, bestätigen wir vor der Produktion schriftlich den rechtlichen Namen des Zertifikatsinhabers, das gelistete Modell und die Größe sowie eine Zertifikatskopie; anschließend prüfen Sie den Eintrag selbst in UL Product iQ.', icon: '🏆' },
  { name: 'FM Class 1120 / 1130', code: 'IM NAMEN DES HERSTELLERWERKS', desc: 'Zulassungsstandard für Brandschutz-Steuerventile der Typen OS&Y und NRS.', scope: 'FM-Zulassungen werden je Hersteller und Produktlinie erteilt. Wir liefern zugelassene Modelle aus dem zugelassenen Werk. Wir weisen eine FM-Zulassung nicht als eigene Bescheinigung aus.', products: 'OS&Y-Absperrschieber und Brandschutz-Steuerventile in auf Anfrage gelisteten Ausführungen', verify: 'Wir nennen den Zulassungsinhaber und das zugelassene Modell, stellen eine Zertifikatskopie bereit, und Sie bestätigen den Eintrag im FM Approval Guide.', icon: '🛡️' },
  { name: 'LPCB RedBook', code: 'IM NAMEN DES HERSTELLERWERKS', desc: 'Loss-Prevention-Certification-Listung für Brandschutzprodukte und -leistungen.', scope: 'RedBook-Einträge werden für den zertifizierten Hersteller veröffentlicht. Relevant für Projekte im Vereinigten Königreich und im Commonwealth, die LPCB-gelistete Ausrüstung verlangen.', products: 'Gelistete Brandschutzprodukte gemäß dem RedBook-Eintrag des liefernden Werks', verify: 'Vor Ihrer Entscheidung nennen wir den RedBook-Eintrag und den zertifizierten Hersteller für Ihr Zielprodukt; der Eintrag kann kostenlos auf redbooklive.com geprüft werden.', icon: '📜' }\n];
const faq = [
  { question: 'Verfügt Wanlian Fluid über eine ISO-9001-Zertifizierung?', answer: 'Ja — die Fertigung erfolgt unter einem Qualitätsmanagementsystem nach ISO 9001:2015 für Entwicklung, Produktion und Vertrieb von Armaturen, Brandschutzausrüstung und Fluidtechnik. Zertifikatsnummer und ausstellende Stelle werden zur Prüfung bereitgestellt.' },
  { question: 'Sind Ihre Brandschutzarmaturen UL-gelistet oder FM-zugelassen?', answer: 'Nein — diese Listungen gehören dem Werk, das sie innehat, nicht Wanlian. Wenn Ihre Ausschreibung UL 262, UL 1091, FM Class 1120 oder FM Class 1130 nennt, beschaffen wir das gelistete Modell beim Zertifikatsinhaber und bestätigen vor der Produktion schriftlich den rechtlichen Namen, Modell und Größe sowie die Zertifikatskopie. Falls wir keine wirklich gelistete Einheit liefern können, teilen wir dies in der Angebotsphase mit.' },
  { question: 'Was bedeutet die CE-Kennzeichnung für Ihre Armaturen?', answer: 'Die CE-Kennzeichnung wird vom Werk erklärt, das die anwendbare EU-Erklärung hält, innerhalb des Geltungsbereichs der relevanten Richtlinien; die Armaturenprüfung folgt EN 12266-1. Teilen Sie uns Projekt und Bestimmungsland mit, damit wir Werk, Richtlinie, Kategorie und Dokumentation des genauen Modells vor der Bestellung benennen.' },
  { question: 'Wie kann ich die Echtheit von Zertifikaten prüfen?', answer: 'Wir nennen den rechtlichen Namen des Zertifikatsinhabers und stellen die Kopie für das genaue Modell bereit, damit Sie selbst in UL Product iQ, dem FM Approval Guide, dem LPCB RedBook oder dem Portal der ausstellenden Stelle prüfen können. Ein Lieferant, der den Zertifikatsinhaber nicht nennt, ist ein Warnsignal — auch für uns gilt dieser Maßstab.' },
  { question: 'Stellen Sie Prüfberichte mit der Lieferung bereit?', answer: 'Ja — je Einheit werden die Prüfprotokolle für Gehäusedruck und Luftdichtheit mit den Seriennummern auf der Packliste abgeglichen und den Exportdokumenten (Rechnung, Packliste, Ursprungszeugnis) beigefügt; Werkstoffzertifikate und normbezogene Zertifikate gibt es auf Anfrage.' }\n];
---
<Layout locale="de" title="Technische Dokumentation und Zertifikate | Wanlian Fluid" description="Fordern Sie technische Dokumentation, Prüfberichte, Werkstoffoptionen und Exportunterlagen für Wanlian-Armaturen und Brandschutzausrüstung an." faq={faq} breadcrumbs={[{ name: 'Zertifikate' }]}>
  <section class="py-24 bg-gray-900 text-white"><div class="max-w-7xl mx-auto px-4"><h1 class="text-5xl font-black mb-8">Technische <span class="text-brand-red">Dokumentation.</span></h1><p class="text-xl text-gray-400 max-w-2xl leading-relaxed">Teilen Sie Ihre Projektanforderungen. Wir stellen verfügbare Produktinformationen, technische Spezifikationen und Dokumente zur Bewertung bereit.</p></div></section>
  <section class="py-24 bg-white"><div class="max-w-7xl mx-auto px-4"><div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">{certifications.map(cert => <div class="p-8 bg-gray-50 rounded-2xl border hover:border-brand-blue/30"><div class="text-4xl mb-6">{cert.icon}</div><h2 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h2><p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p><p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p><div class="space-y-3 text-sm text-gray-600"><p><strong class="text-gray-900">Geltungsbereich: </strong>{cert.scope}</p><p><strong class="text-gray-900">Abgedeckte Produkte: </strong>{cert.products}</p><p class="text-xs text-gray-500 border-t pt-3">{cert.verify}</p></div></div>)}</div><div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center"><h2 class="text-3xl font-black">Benötigen Sie Zertifikate oder technische Datenblätter?</h2><p class="text-gray-400 max-w-2xl mx-auto mt-4">Wir stellen Zertifikate, hydrostatische Prüfberichte, Datenblätter, CAD-Zeichnungen und Montageanleitungen auf Anfrage bereit. Nennen Sie Modell, Zertifizierung und Zielmarkt.</p><div class="flex flex-wrap justify-center gap-4 mt-7"><a href="/de/contact/?product=Anfrage%20zu%20Zertifikaten%20und%20technischer%20Dokumentation" class="px-10 py-5 bg-brand-red rounded-xl font-black">Dokumente anfordern</a><a href="/de/products/" class="px-10 py-5 bg-white/10 border border-gray-600 rounded-xl font-black">Zertifizierte Produkte ansehen</a></div></div></div></section>
</Layout>
