---
import Layout from '../../layouts/Layout.astro';
const certifications = [
  { name: 'ISO 9001:2015', code: 'IM EIGENEN NAMEN', desc: 'Zertifiziertes Qualitätsmanagementsystem von Quanzhou Wanlian Fluid Equipment Co., Ltd.', scope: 'Entwicklung, Produktion und Vertrieb von Armaturen, Brandschutzausrüstung und Fluidtechnik unter einem zertifizierten ISO-9001:2015-System.', products: 'Alle von uns gelieferten Armaturen und Brandschutzausrüstungen', verify: 'Zertifikatsnummer und ausstellende Stelle werden zur Prüfung auf Anfrage bereitgestellt.', icon: '⚙️' },
  { name: 'Chargen-Prüfprotokolle', code: 'IM EIGENEN NAMEN', desc: 'Dokumentierte Schalen- und Dichtheitsprüfungen für jede ausgelieferte Charge.', scope: 'Jede Einheit wird vor dem Verpacken nach der in Ihrer Spezifikation genannten Norm geprüft; die Prüfprotokolle werden den Seriennummern auf der Packliste zugeordnet.', products: 'Alle von uns gelieferten Armaturen und Brandschutzausrüstungen', verify: 'Prüfprotokolle werden mit den Exportdokumenten bereitgestellt; überwachte Prüfungen durch SGS, BV oder Intertek sind auf Anfrage möglich.', icon: '🧪' },
  { name: 'EN 12266-1 / GB 5135-Reihe', code: 'AUSLEGUNGS- UND PRÜFGRUNDLAGE', desc: 'Fertigungs- und Prüfgrundlage, wenn keine Drittanbieter-Listung für Ihre Spezifikation gilt.', scope: 'Armaturen werden nach EN 12266-1 oder GB/T 13927 geprüft; Sprinklerkomponenten, Hydranten und Alarmventile folgen der GB-5135-Reihe, GB 4452 und GB 50974.', products: 'Sprinklerkomponenten, Feuerhydranten, Alarmventile und allgemeine Armaturen', verify: 'Dies ist eine Auslegungs- und Prüfgrundlage, keine Zertifizierung; werkseitige Prüfberichte werden mit der Lieferung bereitgestellt.', icon: '🧱' },
  { name: 'UL 262 / UL 1091', code: 'IM NAMEN DES HERSTELLERWERKS', desc: 'Normen für Absperrschieber und Rückschlagventile im nordamerikanischen Brandschutz.', scope: 'Eine UL-Listung wird dem Werk erteilt, das das gelistete Modell herstellt. Wanlian besitzt keine UL-Listungen und tritt auch nicht als deren Inhaber auf.', products: 'Gelistete Modelle können bei Bedarf vom zertifikatsinhabenden Werk bezogen werden.', verify: 'Bei einer UL-Anforderung bestätigen wir vor der Produktion den rechtlichen Namen des Inhabers, Modell und Größe sowie die Zertifikatskopie.', icon: '🏆' },
  { name: 'FM Class 1120 / 1130', code: 'IM NAMEN DES HERSTELLERWERKS', desc: 'Zulassungsgrundlage für Brandschutz-Absperrarmaturen in OS&Y- und NRS-Ausführung.', scope: 'FM-Zulassungen werden je Hersteller und Produktlinie erteilt. Wir liefern zugelassene Modelle des zugelassenen Werks und weisen eine FM-Zulassung nicht als eigene Bescheinigung aus.', products: 'OS&Y-Absperrschieber und Brandschutzarmaturen in gelisteten Ausführungen auf Anfrage', verify: 'Wir nennen den Zulassungsinhaber, das zugelassene Modell und stellen die Zertifikatskopie zur eigenen Prüfung bereit.', icon: '🛡️' },
  { name: 'LPCB RedBook', code: 'IM NAMEN DES HERSTELLERWERKS', desc: 'RedBook-Listung für Brandschutzprodukte und -leistungen.', scope: 'RedBook-Einträge werden für den zertifizierten Hersteller veröffentlicht und gelten für die dort genannten Produkte.', products: 'Gelistete Brandschutzprodukte gemäß dem RedBook-Eintrag des liefernden Werks', verify: 'Wir nennen vor der Bestellung den RedBook-Eintrag und den zertifizierten Hersteller des Zielprodukts.', icon: '📜' }
];
const faq = [
  { question: 'Verfügt Wanlian Fluid über eine ISO-9001-Zertifizierung?', answer: 'Ja — die Fertigung erfolgt unter einem ISO-9001:2015-Qualitätsmanagementsystem für Entwicklung, Produktion und Vertrieb von Armaturen, Brandschutzausrüstung und Fluidtechnik. Zertifikatsnummer und ausstellende Stelle werden zur Prüfung bereitgestellt.' },
  { question: 'Sind Ihre Brandschutzarmaturen UL-gelistet oder FM-zugelassen?', answer: 'Nein — diese Listungen gehören dem Werk, das sie innehat, nicht Wanlian. Wenn Ihre Ausschreibung UL 262, UL 1091, FM Class 1120 oder FM Class 1130 verlangt, beschaffen wir das gelistete Modell beim zertifikatsinhabenden Werk und bestätigen vor der Produktion den Inhaber, das Modell und die Zertifikatskopie.' },
  { question: 'Was umfasst die CE-Kennzeichnung Ihrer Armaturen?', answer: 'Die CE-Kennzeichnung wird innerhalb des Geltungsbereichs der anwendbaren Richtlinien vom Herstellerwerk erklärt, das diese Erklärung innehat; die Armaturenprüfung erfolgt nach EN 12266-1. Teilen Sie uns Projekt und Zielmarkt mit, damit wir Werk, Richtlinie, Kategorie und Unterlagen für das genaue Modell bestätigen können.' },
  { question: 'Wie kann ich die Echtheit Ihrer Zertifikate prüfen?', answer: 'Wir nennen den rechtlichen Namen des Zertifikatsinhabers und stellen die Kopie für das genaue Modell bereit, damit Sie selbst beim jeweiligen Aussteller oder im entsprechenden Portal prüfen können. Den Zertifikatsinhaber nicht zu nennen, wäre ein Warnsignal — auch für uns.' },
  { question: 'Stellen Sie Prüfberichte mit der Lieferung bereit?', answer: 'Ja — pro Einheit zugeordnete Schalen- und Dichtheitsprüfungen sowie Werkstoff- und normbezogene Unterlagen werden mit den Exportdokumenten bereitgestellt; weitere Prüfprotokolle sind auf Anfrage erhältlich.' }
];
---
<Layout locale="de" title="Technische Dokumentation und Zertifikate | Wanlian Fluid" description="Fordern Sie technische Dokumentation, Prüfberichte, Werkstoffoptionen und Exportunterlagen für Wanlian-Armaturen und Brandschutzausrüstung an." faq={faq} breadcrumbs={[{ name: 'Zertifikate' }]}>
  <section class="py-24 bg-gray-900 text-white"><div class="max-w-7xl mx-auto px-4"><h1 class="text-5xl font-black mb-8">Technische <span class="text-brand-red">Dokumentation.</span></h1><p class="text-xl text-gray-400 max-w-2xl leading-relaxed">Teilen Sie Ihre Projektanforderungen. Wir stellen verfügbare Produktinformationen, technische Spezifikationen und Dokumente zur Bewertung bereit.</p></div></section>
  <section class="py-24 bg-white"><div class="max-w-7xl mx-auto px-4"><div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">{certifications.map(cert => <div class="p-8 bg-gray-50 rounded-2xl border hover:border-brand-blue/30"><div class="text-4xl mb-6">{cert.icon}</div><h2 class="text-2xl font-black text-gray-900 mb-2">{cert.name}</h2><p class="text-brand-blue font-bold text-sm mb-4 uppercase tracking-widest">{cert.code}</p><p class="text-gray-600 leading-relaxed mb-4">{cert.desc}</p><div class="space-y-3 text-sm text-gray-600"><p><strong class="text-gray-900">Geltungsbereich: </strong>{cert.scope}</p><p><strong class="text-gray-900">Abgedeckte Produkte: </strong>{cert.products}</p><p class="text-xs text-gray-500 border-t pt-3">{cert.verify}</p></div></div>)}</div><div class="mt-20 p-12 bg-gray-900 rounded-3xl text-white text-center"><h2 class="text-3xl font-black">Benötigen Sie Zertifikate oder technische Datenblätter?</h2><p class="text-gray-400 max-w-2xl mx-auto mt-4">Wir stellen Zertifikate, hydrostatische Prüfberichte, Datenblätter, CAD-Zeichnungen und Montageanleitungen auf Anfrage bereit. Nennen Sie Modell, Zertifizierung und Zielmarkt.</p><div class="flex flex-wrap justify-center gap-4 mt-7"><a href="/de/contact/?product=Anfrage%20zu%20Zertifikaten%20und%20technischer%20Dokumentation" class="px-10 py-5 bg-brand-red rounded-xl font-black">Dokumente anfordern</a><a href="/de/products/" class="px-10 py-5 bg-white/10 border border-gray-600 rounded-xl font-black">Zertifizierte Produkte ansehen</a></div></div></div></section>
</Layout>
