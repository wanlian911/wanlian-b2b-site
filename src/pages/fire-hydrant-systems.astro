---
import Layout from '../layouts/Layout.astro';

const faq = [
	{
		question: 'What is the difference between indoor and outdoor fire hydrants?',
		answer: 'Indoor hydrants (SN65 head) connect to building standpipe systems and feed hose stations on each floor. Outdoor hydrants (SS100 ground type) draw from municipal or industrial mains and supply fire engines and external firefighting. The two serve different distribution points and are specified against different codes.'
	},
	{
		question: 'What outlet connection standards are available for export hydrants?',
		answer: 'Common outlet connections include BS336 (UK/Commonwealth), NIST (Middle East), KWS (Germany) and flexible flange options. Wanlian supplies SS100/65 and SSFT100/65 hydrants with the connection type specified for your market, and can ship matching couplings and adapters in the same container.'
	},
	{
		question: 'Are Wanlian hydrants available with UL or FM certification?',
		answer: 'Yes, depending on the model and destination market. Contact our sales team with your project specification and target region so we can match the correct certification package — UL/FM for North America, CE for Europe, LPCB for UK/Commonwealth projects.'
	},
	{
		question: 'Which hydrant should I choose for a cold-climate city?',
		answer: 'The SS100 overground hydrant features an automatic post-closing dry-barrel drainage mechanism that prevents freezing and barrel rupture — the standard choice for municipal networks in cold regions. For traffic-exposed locations, the SSFT100 anti-collision variant adds a breakaway body and pressure regulation.'
	},
	{
		question: 'Can smart hydrants integrate with our SCADA system?',
		answer: 'Yes. The SS100ZN IoT hydrant transmits pressure, tilt and valve-status data via NB-IoT/LTE-M/GPRS and integrates with standard SCADA platforms. Request the data interface spec and a sample device for integration testing before ordering.'
	}
];

const hydrantProducts = [
	{
		slug: 'indoor-fire-hydrant-head-sn65',
		name: 'Indoor Fire Hydrant Head SN65',
		img: '/assets/products/indoor-fire-hydrant-head-sn65.jpg',
		desc: 'PN16 ductile iron indoor hydrant for standpipe systems'
	},
	{
		slug: 'overground-fire-hydrant-ss100',
		name: 'Overground Antifreeze Fire Hydrant (SS100/65)',
		img: '/assets/products/overground-fire-hydrant-ss100.png',
		desc: 'Dry-barrel antifreeze design for cold-climate municipal networks'
	},
	{
		slug: 'anti-collision-pressure-regulating-outdoor-hydrant-ssft100',
		name: 'Anti-Collision Pressure-Regulating Hydrant (SSFT100/65)',
		img: '/assets/products/anti-collision-pressure-regulating-outdoor-hydrant-ssft100.png',
		desc: 'Breakaway body + pressure regulation for traffic and industrial yards'
	},
	{
		slug: 'iot-smart-ground-fire-hydrant-ss100zn',
		name: 'IoT Smart Ground Fire Hydrant (SS100/65-1.6ZN)',
		img: '/assets/products/overground-fire-hydrant-ss100.png',
		desc: 'Real-time pressure, tilt and water-theft monitoring for smart grids'
	},
	{
		slug: 'fire-hydrant-hose-coupling-adapter-hs',
		name: 'Aluminum Hose Coupling Adapter (HS Series)',
		img: '/assets/products/fire-hydrant-hose-coupling-adapter-hs.jpg',
		desc: 'BS336/NIST/KWS compatible couplings for hydrant-to-hose connection'
	}
];

const trustBadges = ['PN16 / 2.4 MPa Tested', 'BS336 / NIST / KWS', 'Antifreeze Dry-Barrel', 'IoT / SCADA Ready'];
---

<Layout
	title="Fire Hydrant Systems & Municipal Fire Hydrant Valves - WLFE"
	description="Fire hydrant systems: SN65 indoor heads, SS100 overground, SSFT100 anti-collision and SS100ZN IoT smart hydrants. PN16, factory direct with export connections."
	type="product"
	productData={{
		name: 'Fire Hydrant Systems',
		image: '/assets/products/overground-fire-hydrant-ss100.png',
		description: 'Indoor and outdoor fire hydrant valves and smart hydrant systems for municipal networks, industrial yards and building standpipe systems, manufactured by Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Fire Hydrant Systems' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/" class="hover:text-blue-600">Home</a>
			<span>/</span>
			<a href="/products/" class="hover:text-blue-600">Products</a>
			<span>/</span>
			<span class="text-gray-600">Fire Hydrant Systems</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Complete Fire Hydrant Supply</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Complete Fire Hydrant Systems for Municipal &amp; Industrial Networks</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid supplies the full fire hydrant range — indoor SN65 hydrant heads, overground SS100 hydrants, SSFT100 anti-collision hydrants and SS100ZN IoT smart hydrants — with export connection standards (BS336, NIST, KWS) and matching couplings, one supplier for the whole hydrant network.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Fire Hydrant System Components</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydrantProducts.map(p => (
					<a href={`/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Key Specifications</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Model</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Type</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Key feature</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Rating</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SN65</td>
							<td class="px-4 py-3 text-gray-700">Indoor hydrant head</td>
							<td class="px-4 py-3 text-gray-700">Grooved/flanged inlet, wall cabinet mount</td>
							<td class="px-4 py-3 text-gray-700">PN16 (2.4 MPa tested)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SS100/65</td>
							<td class="px-4 py-3 text-gray-700">Overground hydrant</td>
							<td class="px-4 py-3 text-gray-700">Automatic antifreeze dry-barrel drainage</td>
							<td class="px-4 py-3 text-gray-700">PN16, 2×65mm + 1×100mm outlets</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SSFT100/65</td>
							<td class="px-4 py-3 text-gray-700">Anti-collision hydrant</td>
							<td class="px-4 py-3 text-gray-700">Breakaway body + pressure regulation + self-drain</td>
							<td class="px-4 py-3 text-gray-700">PN16, calibrated shear bolts</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">SS100ZN</td>
							<td class="px-4 py-3 text-gray-700">IoT smart hydrant</td>
							<td class="px-4 py-3 text-gray-700">NB-IoT/4G, pressure/tilt/theft monitoring</td>
							<td class="px-4 py-3 text-gray-700">GB4452-2011, 5-year battery</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Applications</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Municipal water supply networks and fire protection mains</li>
				<li>Industrial yards, tank farms and warehouse firefighting</li>
				<li>Building standpipe and hose systems (indoor hydrant heads)</li>
				<li>Smart city grids with remote monitoring requirements</li>
				<li>Cold-climate installations needing freeze protection</li>
			</ul>

			<!-- FAQ Section -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Frequently Asked Questions</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Need a Hydrant Network Specified for Your Project?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Send us your DN/PN, connection standard and target certification — our engineers reply with a full technical datasheet and quotation within 12 hours.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/contact/?product=Fire%20Hydrant%20System" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Request a Quote</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20help%20selecting%20a%20fire%20hydrant%20system" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat on WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
