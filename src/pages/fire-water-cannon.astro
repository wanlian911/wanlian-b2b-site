---
import Layout from '../layouts/Layout.astro';

const faq = [
	{
		question: 'What is the effective range of your fire water cannon?',
		answer: 'Range depends on model and inlet pressure — typically 50 to 110 meters at rated flow for our PS series, with monitoring radii of 40–65 m for the ZDMS auto-tracking series. Tell us your site layout and we will recommend the right model.'
	},
	{
		question: 'Can the water cannon be operated remotely?',
		answer: 'Yes. Our ZDMS auto-tracking cannon operates fully autonomously with IR/UV flame detection, and supports manual remote override via PC, mobile app or central control cabinet. Fixed monitors are also available with manual hand-lever operation.'
	},
	{
		question: 'What flow rates are available?',
		answer: 'Standard models range from 5 L/s up to 200 L/s. The ZDMS series is available at 5, 10, 20 and 30 L/s (customizable up to 150 L/s), while the PS manual series covers 20–200 L/s. Custom flow rates can be engineered per project.'
	},
	{
		question: 'Does the smart model integrate with fire alarm systems?',
		answer: 'Yes, ZDMS smart water cannons use multi-band infrared and ultraviolet sensors for automatic fire detection, positioning and jetting within 30 seconds, and can be linked to fire alarm panels. Explosion-proof configurations are available as an option.'
	},
	{
		question: 'Do you supply the complete system including valves and piping?',
		answer: 'Yes. As a fluid equipment enterprise we can supply matched valves, couplings, hydrants and accessories for the full suppression loop, simplifying procurement and ensuring system compatibility.'
	}
];

const cannonProducts = [
	{
		slug: 'auto-tracking-jet-suppression-cannon-zdms',
		name: 'Auto-Tracking Jet Suppression Cannon (ZDMS)',
		img: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		desc: 'IR/UV auto-detection, 360° rotation, 40–65m radius'
	},
	{
		slug: 'manual-fire-water-cannon-ps',
		name: 'Manual Fire Water Cannon (PS Series)',
		img: '/assets/products/manual-fire-water-cannon-ps.webp',
		desc: '20–200 L/s, jet range up to 110m, water or foam'
	},
	{
		slug: 'foam-fire-hydrant-cabinet-psg30',
		name: 'Foam Fire Hydrant Cabinet (PSG30)',
		img: '/assets/06_extinguishing_cannons/cannon_p42.webp',
		desc: '3% AFFF foam unit for chemical and oil fires'
	},
	{
		slug: 'fire-hose-reel-jpso8-19',
		name: 'Fire Hose Reel Accessories Set (JPS0.8-19)',
		img: '/assets/products/fire-hose-reel-jpso8-19.jpg',
		desc: '20–30m layflat hose, swivel mount, fast response'
	}
];
---

<Layout
	title="Fire Water Cannon | Remote Control & Smart Fire Monitors"
	description="WLFE fire water cannons deliver high-flow, long-range suppression for plants, terminals and warehouses. Fixed, remote and auto-tracking smart models."
	type="product"
	productData={{
		name: 'Fire Water Cannon',
		image: '/assets/06_extinguishing_cannons/cannon_p45.webp',
		description: 'Fixed, remote controlled and smart fire water cannons with 5-200 L/s flow and up to 110 m range for industrial fire protection, manufactured by Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Fire Water Cannon' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/" class="hover:text-blue-600">Home</a>
			<span>/</span>
			<a href="/products/" class="hover:text-blue-600">Products</a>
			<span>/</span>
			<span class="text-gray-600">Fire Water Cannon</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Fire Water Cannon Systems</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Fire Water Cannon Systems for High-Risk Industrial Environments</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid supplies high-flow fire water cannons for petrochemical plants, LNG terminals, warehouses and airports — from fixed manual monitors to fully autonomous auto-tracking cannons with remote and smart control.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['Up to 200 L/s Flow', 'Up to 110 m Range', '360° Rotation', 'IR/UV Auto-Detection'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Water Cannon Series</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{cannonProducts.map(p => (
					<a href={`/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Core tech -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Core Technical Specifications</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Specification</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Details</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Rated flow</td>
							<td class="px-4 py-3 text-gray-700">5 – 200 L/s per model (customizable up to 150 L/s on ZDMS)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Jet range</td>
							<td class="px-4 py-3 text-gray-700">50 – 110 m depending on model and inlet pressure</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Rotation</td>
							<td class="px-4 py-3 text-gray-700">Horizontal 360°, vertical -90° to +70°</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Control modes</td>
							<td class="px-4 py-3 text-gray-700">Manual / Remote (PC, mobile APP, central cabinet) / Automatic (flame detection)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Body material</td>
							<td class="px-4 py-3 text-gray-700">T6 hard-anodized aluminum alloy / bronze, SS304 waterway</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Optional</td>
							<td class="px-4 py-3 text-gray-700">Explosion-proof (Exde II BT4 Gb), foam proportioning</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Applications</h2>
			<p class="text-gray-700 leading-relaxed">Fire water cannons protect petrochemical process areas, oil and LNG storage tank farms, loading terminals, large warehouses, airport hangars and substations — high-ceiling or open-air sites where fixed suppression must reach long distances under high heat.</p>

			<!-- Why WLFE -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Why Choose Wanlian Fluid</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>Integrated supply</strong> — water cannons supplied with matched valves, couplings and hydrants for the complete suppression loop.</li>
				<li><strong>Project engineering</strong> — we recommend range, flow and control configuration from your site layout.</li>
				<li><strong>Certified quality</strong> — UL/ULC, FM and ISO 9001 quality systems; see our <a href="/certificates/" class="text-brand-blue font-semibold hover:underline">certificates page</a>.</li>
			</ul>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Frequently Asked Questions</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Need a Water Cannon for Your Site?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Send us your site layout, required range and flow — our engineers recommend the right model and reply with a full quotation within 12 hours.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/contact/?product=Fire%20Water%20Cannon" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Request a Quote</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20a%20fire%20water%20cannon" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat on WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
