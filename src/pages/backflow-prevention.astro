---
import Layout from '../layouts/Layout.astro';

const faq = [
	{
		question: 'What is the difference between a backflow preventer and a check valve?',
		answer: 'A standard check valve prevents reverse flow mechanically but is not tested for leakage and has no intermediate drain. A backflow preventer such as the HS41X combines two independent checks with an automatic intermediate drain chamber, is testable in place, and meets cross-connection control requirements for potable water protection. Check valves alone are not accepted at potable cross-connections.'
	},
	{
		question: 'Where should the backflow preventer be installed in a fire service connection?',
		answer: 'On the fire service connection to the potable main, upstream of the fire pump suction or system riser. It must be accessible for testing, protected from freezing, and its head loss included in the fire pump hydraulic calculation. For high-rise systems, confirm the device rating matches the maximum static pressure of the supply.'
	},
	{
		question: 'Do hydraulic control valves need electricity to operate?',
		answer: 'Most hydraulic control valves — the 500X pressure reducing valve, F745X level control valve and HS41X backflow preventer — are fully self-operated by pipeline pressure and require no external power. Solenoid-controlled models such as the GKZF-1 use AC220V or DC24V for remote automation.'
	},
	{
		question: 'What materials are used for potable water applications?',
		answer: 'For drinking water networks, the HS41X backflow preventer uses a ductile iron body with EPDM seals and stainless steel 304 internals, compliant with GB/T17219 sanitary requirements. Confirm the sanitary certificate for your market — our engineers provide the documentation package with the order.'
	},
	{
		question: 'Can you supply the complete hydraulic valve package for a pump room?',
		answer: 'Yes. We supply backflow preventers, pressure reducing valves, level control valves, solenoid control valves, vortex preventers and Y-strainers as a coordinated package — matched pressure classes, trims and test reports from a single supplier.'
	}
];

const hydraulicProducts = [
	{
		slug: 'anti-pollution-backflow-preventer-hs41x',
		name: 'Anti-Pollution Backflow Preventer (HS41X-16)',
		img: '/assets/products/anti-pollution-backflow-preventer-hs41x.jpg',
		desc: 'Double check assembly with intermediate drain, DN50–DN600'
	},
	{
		slug: 'adjustable-pressure-reducing-valve-500x',
		name: 'Hydraulic Pressure Reducing Valve (500X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.jpg',
		desc: 'Self-operated pilot control, 0.1–1.6 MPa adjustment'
	},
	{
		slug: 'hydraulic-water-level-control-valve-f745x',
		name: 'Hydraulic Water Level Control Valve (F745X)',
		img: '/assets/products/adjustable-pressure-reducing-valve-500x.jpg',
		desc: 'Float pilot level control for reservoirs and tanks'
	},
	{
		slug: 'groove-solenoid-control-gate-valve-gkzf1',
		name: 'Solenoid Control Gate Valve (GKZF-1)',
		img: '/assets/products/groove-solenoid-control-gate-valve-gkzf1.jpg',
		desc: 'DC24V/AC220V piloted groove valve, 300 PSI rated'
	},
	{
		slug: 'suction-vortex-preventer-en12845',
		name: 'Suction Vortex Preventer (EN12845)',
		img: '/assets/02_valves_parts/valves_p21.png?v=20260729',
		desc: 'SS304/316, eliminates pump cavitation, 100mm drain depth'
	}
];

const trustBadges = ['Dual Check + Drain', 'PN10–PN25', 'GB/T17219 Sanitary', 'Self-Operated Pilots'];
---

<Layout
	title="Backflow Preventers & Hydraulic Control Valves - WLFE"
	description="Backflow preventers (HS41X), pressure reducing valves (500X), level control valves (F745X) and solenoid control valves for potable water and fire protection networks. Factory direct, DN50-DN600. Request a quote."
	type="product"
	productData={{
		name: 'Backflow Prevention & Hydraulic Control',
		image: '/assets/products/anti-pollution-backflow-preventer-hs41x.jpg',
		description: 'Backflow preventers and hydraulic control valves for potable water protection, pressure management and automated water networks, manufactured by Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Backflow Prevention' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/" class="hover:text-blue-600">Home</a>
			<span>/</span>
			<a href="/products/" class="hover:text-blue-600">Products</a>
			<span>/</span>
			<span class="text-gray-600">Backflow Prevention</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Potable Water Protection &amp; Hydraulic Control</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Backflow Preventers &amp; Hydraulic Control Valves</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid supplies the full hydraulic safety range — HS41X anti-pollution backflow preventers, 500X pressure reducing valves, F745X level control valves and GKZF-1 solenoid control valves — protecting potable water networks and automating pressure and level control in one coordinated package.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{trustBadges.map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Hydraulic Safety Valve Range</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{hydraulicProducts.map(p => (
					<a href={`/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Key Specifications</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Valve</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Function</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Size range</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Rating</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">HS41X</td>
							<td class="px-4 py-3 text-gray-700">Anti-pollution backflow prevention</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">500X</td>
							<td class="px-4 py-3 text-gray-700">Pressure reducing / sustaining</td>
							<td class="px-4 py-3 text-gray-700">DN20 – DN600</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16 / PN25</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">F745X</td>
							<td class="px-4 py-3 text-gray-700">Water level control</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN400</td>
							<td class="px-4 py-3 text-gray-700">PN10 / PN16</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">GKZF-1</td>
							<td class="px-4 py-3 text-gray-700">Solenoid on/off control</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN300</td>
							<td class="px-4 py-3 text-gray-700">300 PSI, AC220V/DC24V</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Vortex Preventer</td>
							<td class="px-4 py-3 text-gray-700">Pump suction protection</td>
							<td class="px-4 py-3 text-gray-700">DN50 – DN1000</td>
							<td class="px-4 py-3 text-gray-700">EN12845 / GB50974</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Applications</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li>Potable water cross-connection control (fire mains, irrigation, boilers)</li>
				<li>Water reservoir and roof tank level control</li>
				<li>Pressure zone management in municipal and building networks</li>
				<li>Automated water networks with remote valve control</li>
				<li>Pump suction protection in reservoirs and tanks</li>
			</ul>

			<!-- FAQ Section -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Frequently Asked Questions</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Need a Hydraulic Valve Package for Your Network?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Send us your DN, pressure class and connection type — our engineers reply with head-loss curves, datasheets and a package quotation within 12 hours.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/contact/?product=Backflow%20Prevention%20%26%20Hydraulic%20Control" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Request a Quote</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20help%20selecting%20hydraulic%20control%20valves" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat on WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
