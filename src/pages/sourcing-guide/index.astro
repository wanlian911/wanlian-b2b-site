---
import Layout from '../../layouts/Layout.astro';

const faq = [
  {
    question: 'How long does the full sourcing process take from specification to shipment?',
    answer: 'For in-stock models it typically runs a few weeks: specification and quote within days, a sample order of 1–3 weeks, third-party inspection before the production run, then production and container loading. OEM or custom-branded items add tooling and branding time. Wanlian Fluid responds to a full specification within 12 hours, which keeps the early stages on a tight schedule.'
  },
  {
    question: 'What documents should a Chinese valve and fire-equipment supplier provide with the shipment?',
    answer: 'At minimum: commercial invoice, packing list, bill of lading, certificate of origin, and per-lot/per-unit shell pressure and air-leakage test records that reconcile with the serial numbers on the packing list. Add material (mill) test certificates and any requested standard-specific certificates. A complete, reconcilable document pack is itself a quality signal.'
  },
  {
    question: 'Should I order a sample before a bulk order?',
    answer: 'For safety-critical fire equipment, yes. A one-unit sample of each model lets you verify the nameplate, serial, material, and a pressure-test video against your specification before committing to volume. It is the cheapest counterfeit and specification-risk insurance available.'
  },
  {
    question: 'How do I compare quotes from a Chinese manufacturer against a local distributor?',
    answer: 'Compare on a like-for-like basis: same model, standard, material, quantity and Incoterm. Use a relative planning tool first to size the cost drivers (volume, incoterm, destination), then request itemized quotes from both. Factor in total landed cost and the risk of coordinating valves, hydrants and hose from multiple suppliers.'
  }
];

const steps = [
  {
    n: '01',
    title: 'Define the specification in writing',
    body: 'Fix the standard (AWWA, ISO 5208, NFPA, NOM, or the tender’s requirement), sizes, pressure classes, materials, quantities and destination. Ambiguity here is the most expensive defect later. Start with the shared vocabulary in the industry glossary so your spec, the tender and the supplier all mean the same thing.',
    links: [
      { label: 'Industry glossary', href: '/glossary/' },
      { label: 'Fire hydrant, hose & valve standards guide', href: '/guides/fire-hydrant-valve-standards-guide/' }
    ]
  },
  {
    n: '02',
    title: 'Qualify and verify the supplier',
    body: 'Confirm the legal entity, ISO 9001 scope, export track record and factory capability. Run a detection process to rule out counterfeit risk: request per-unit test records, verify any certificates at the issuing body, and ask for a sample. A supplier that resists verification has answered the question.',
    links: [
      { label: 'B2B valve sourcing checklist', href: '/guides/b2b-valve-sourcing-checklist/' },
      { label: 'Verify a Chinese valve supplier', href: '/guides/how-to-verify-chinese-valve-supplier/' },
      { label: 'Detect fake valves & forged certificates', href: '/guides/detect-fake-valves-fire-equipment-counterfeits/' }
    ]
  },
  {
    n: '03',
    title: 'Request and compare itemized quotes',
    body: 'Ask for an itemized, per-model quote — not a single blended figure — and compare like-for-like on standard, material, quantity and Incoterm. Use the relative cost estimator to size the impact of volume, trade term and destination before you brief your team on budget.',
    links: [
      { label: 'Cost estimator (relative index)', href: '/cost-calculator/' },
      { label: 'Certification requirements for fire valves', href: '/guides/latinamerica-certification-requirements-fire-valves/' }
    ]
  },
  {
    n: '04',
    title: 'Order a sample and inspect',
    body: 'Buy one unit of each model. Check the nameplate, serial, material grade and a serial-numbered pressure-test video against your specification. For volume orders, appoint a third-party agency (SGS, Bureau Veritas, Intertek) to witness testing and review records at the factory before shipment.',
    links: [
      { label: 'How to choose a fire hydrant', href: '/guides/how-to-choose-a-fire-hydrant/' }
    ]
  },
  {
    n: '05',
    title: 'Production, QC and documentation',
    body: 'Confirm the production schedule, then require the document pack before final payment: commercial invoice, packing list, certificate of origin and per-unit shell pressure and air-leakage test records reconciled to the serials on the packing list. OEM/ODM branding and export packaging are applied at this stage.',
    links: [
      { label: 'Wanlian Fluid — factory & testing', href: '/about/' }
    ]
  },
  {
    n: '06',
    title: 'Logistics, Incoterms and after-sales',
    body: 'Choose the incoterm that matches your risk and cost split (EXW, FOB, CIF, DDP), agree container loading, and keep the test records and certificates for acceptance and future maintenance. Establish a clear channel for warranty, spare parts and repeat orders.',
    links: [
      { label: 'Request a quote', href: '/contact/' }
    ]
  }
];
---

<Layout
  title="Fire Valve & Hydrant Sourcing Guide: Full Procurement Journey (2026) | Wanlian Fluid"
  description="The complete B2B sourcing journey for fire valves, hydrants and fire hose from a Chinese manufacturer: specification, supplier verification, sampling, QC, documentation, logistics and after-sales."
  type="website"
  faq={faq}
  breadcrumbs={[{ name: 'Resources' }, { name: 'Sourcing Guide' }]}
>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
    <nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span>/</span>
      <span class="text-gray-600">Sourcing Guide</span>
    </nav>

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
      <p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Procurement Hub</p>
      <h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Sourcing Fire Valves, Hydrants &amp; Fire Equipment: The Full Journey</h1>
      <p class="mt-5 text-gray-600 leading-relaxed text-lg">A step-by-step B2B procurement roadmap for buying fire valves, hydrants and fire hose from a Chinese manufacturer — from written specification to after-sales. Each stage links to the guides, tools and documentation you need to de-risk the decision. Use it as a checklist and as a shared reference with your engineering and procurement teams.</p>

      <div class="bg-blue-50 border border-blue-100 rounded-xl p-5 my-6">
        <p class="text-sm text-gray-700 leading-relaxed"><strong class="text-brand-blue">Why one roadmap:</strong> fire-equipment sourcing fails most often at the seams — between specification, verification, sampling and documentation — not at any single step. Walking the six stages below, in order, with the linked guides, catches the risk before money moves.</p>
      </div>

      {steps.map(s => (
        <section class="mt-10">
          <h2 id={`step-${s.n}`} class="text-2xl font-black text-gray-900 mb-3 tracking-tight scroll-mt-24 flex items-center gap-3">
            <span class="text-brand-red text-2xl tabular-nums">{s.n}</span>{s.title}
          </h2>
          <p class="text-gray-700 leading-relaxed mb-3">{s.body}</p>
          <div class="flex flex-wrap gap-2">
            {s.links.map(l => (
              <a href={l.href} class="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 hover:bg-brand-blue/10 text-gray-700 hover:text-brand-blue text-xs font-bold rounded-full transition">{l.label} →</a>
            ))}
          </div>
        </section>
      ))}

      <h2 id="documentation" class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight scroll-mt-24">Documentation to Request at Each Stage</h2>
      <div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Stage</th>
              <th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Request</th>
              <th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Why it matters</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <tr><td class="px-4 py-3 font-bold text-gray-900">Specification</td><td class="px-4 py-3 text-gray-700">Written standard, sizes, classes, quantities, destination</td><td class="px-4 py-3 text-gray-700">Makes compliance contractual, not requested</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">Verification</td><td class="px-4 py-3 text-gray-700">Business license, ISO 9001 scope, factory video, certificate numbers</td><td class="px-4 py-3 text-gray-700">Rules out trading desks and forged certs</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">Sampling</td><td class="px-4 py-3 text-gray-700">Per-unit test records, MTC, serial-numbered pressure-test video</td><td class="px-4 py-3 text-gray-700">Confirms the real product before volume</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">Production</td><td class="px-4 py-3 text-gray-700">Schedule, per-lot test records, OEM/branding samples</td><td class="px-4 py-3 text-gray-700">Locks in schedule and brand before load</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">Shipment</td><td class="px-4 py-3 text-gray-700">Invoice, packing list, B/L, certificate of origin, reconciled serials</td><td class="px-4 py-3 text-gray-700">Enables customs, acceptance and traceability</td></tr>
            <tr><td class="px-4 py-3 font-bold text-gray-900">After-sales</td><td class="px-4 py-3 text-gray-700">Warranty terms, spare-parts channel, repeat-order pricing</td><td class="px-4 py-3 text-gray-700">Keeps the project supported over its life</td></tr>
          </tbody>
        </table>
      </div>

      <h2 id="faq" class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight scroll-mt-24">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faq.map(item => (
          <details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
            <summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
              <span>{item.question}</span>
              <span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
          </details>
        ))}
      </div>

      <div class="mt-12 rounded-2xl overflow-hidden">
        <div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
          <h2 class="text-2xl font-black text-white tracking-tight">Start Your Sourcing With a 12-Hour Quote</h2>
          <p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Send your specification and destination — we reply with an itemized quote, per-model test approach and logistics options within 12 hours.</p>
          <div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
            <a href="/contact/?product=Sourcing%20Project" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Request a Quote</a>
            <a href="https://wa.me/8618684324501?text=Hi%2C%20I%20am%20sourcing%20fire%20valves%2C%20hydrants%20and%20hose%20and%20would%20like%20a%20quote" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat on WhatsApp</a>
          </div>
        </div>
      </div>
    </article>
  </main>
</Layout>
