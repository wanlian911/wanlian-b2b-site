---
import Layout from '../layouts/Layout.astro';

const faq = [
	{
		question: 'Are your sprinkler heads UL listed?',
		answer: 'Yes. Our sprinkler heads and system components are UL/ULC listed where applicable — certificates are available on our Certificates page. Our engineers confirm the exact certification package for your destination market before quoting.'
	},
	{
		question: 'What is the difference between wet and dry sprinkler systems?',
		answer: 'Wet systems keep water in the pipes for immediate discharge when a sprinkler head activates. Dry systems use pressurized air or nitrogen with a dry pipe valve, making them suited to unheated spaces where pipe freezing is a risk. Pre-action systems combine both benefits for water-sensitive areas.'
	},
	{
		question: 'Do you supply flexible sprinkler drop connections?',
		answer: 'Yes, we can supply flexible stainless braided drop connections that simplify installation and allow fast repositioning of sprinkler heads to match ceiling layouts — reducing labor time compared to rigid piping.'
	},
	{
		question: 'Can you provide a full system BOM quotation?',
		answer: 'Yes. Send us your project drawings or a component list and we will quote sprinkler heads, alarm valves, flow indicators, strainers and accessories as one package — a single supplier for the whole sprinkler loop.'
	},
	{
		question: 'Which temperature ratings are available?',
		answer: 'Standard glass bulb ratings include 57°C, 68°C, 79°C, 93°C and 141°C with color-coded bulbs, in standard-response (5mm bulb) and quick-response (3mm bulb) types per NFPA practice.'
	}
];

const sprinklerProducts = [
	{
		slug: 'glass-bulb-fire-sprinkler-zst',
		name: 'Glass Bulb Fire Sprinkler (ZST Series)',
		img: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		desc: 'Pendent/upright/sidewall, K=80/115, 57–141°C'
	},
	{
		slug: 'wet-alarm-check-valve-zsfz-150',
		name: 'Wet Alarm Check Valve (ZSFZ 150)',
		img: 'https://s.alicdn.com/@sc04/kf/H82d57eb132e942ecba6023697838d6afn/Water-Alarm-Valves-ZSFZ-150-Flexible-Cast.png?hasNWGrade=1',
		desc: 'Hydraulic alarm gong, retard chamber, DN100–DN200'
	},
	{
		slug: 'deluge-alarm-valve-zsfm',
		name: 'Deluge Alarm Valve Group (ZSFM)',
		img: 'https://s.alicdn.com/@sc04/kf/HTB1q4J9bEzrK1RjSspm763OdFXa1.png?v=20260729',
		desc: 'Diaphragm-operated, for deluge and water spray systems'
	},
	{
		slug: 'pre-action-alarm-system-zsfy',
		name: 'Pre-action Alarm System (ZSFY)',
		img: 'https://s.alicdn.com/@sc04/kf/H2857379540b7417c83f169d67ff70ab3a.png_300x300.jpg?v=20260729',
		desc: 'Dual-trigger failsafe for libraries, archives, data centers'
	},
	{
		slug: 'water-flow-indicator-zsjz',
		name: 'Vane Type Water Flow Indicator (ZSJZ)',
		img: 'https://sc02.alicdn.com/kf/A463ac39a948d44a391017ca222837de2B.png?v=20260729',
		desc: 'Adjustable 2–60s delay, DN50–DN200, saddle/flange'
	},
	{
		slug: 'telescopic-y-strainer-sgl41h',
		name: 'Telescopic Y-Strainer (SGL41H)',
		img: 'https://s.alicdn.com/@sc04/kf/H74fea4ebfe674c69b187eb9d73b2115cP.jpg_720x720q50.jpg?v=20260729',
		desc: 'Protects valves from particulates, SS304/316 screen'
	}
];
---

<Layout
	title="Fire Sprinkler Systems & UL Sprinkler Heads - WLFE"
	description="UL listed fire sprinkler heads, flexible sprinkler connections and complete sprinkler system components for commercial and industrial buildings. Factory direct. Request a quote."
	type="product"
	productData={{
		name: 'Fire Sprinkler Systems',
		image: '/assets/05_sprinklers_alarms/sprinkler_p32_head_white.png',
		description: 'UL listed sprinkler heads, alarm valves, flow indicators and system components for wet, dry and pre-action fire sprinkler systems in commercial and industrial buildings, manufactured by Quanzhou Wanlian Fluid Equipment Co., Ltd.'
	}}
	faq={faq}
	breadcrumbs={[{ name: 'Fire Sprinkler Systems' }]}
>
	<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-14 mb-16">
		<!-- Breadcrumbs -->
		<nav class="text-xs text-gray-400 font-bold uppercase tracking-widest mb-6 flex gap-2">
			<a href="/" class="hover:text-blue-600">Home</a>
			<span>/</span>
			<a href="/products/" class="hover:text-blue-600">Products</a>
			<span>/</span>
			<span class="text-gray-600">Fire Sprinkler Systems</span>
		</nav>

		<article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10">
			<p class="text-brand-red font-bold uppercase tracking-widest text-sm mb-3">Complete Sprinkler System Supply</p>
			<h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight tracking-tight">Complete Fire Sprinkler Systems with UL Listed Components</h1>
			<p class="mt-5 text-gray-600 leading-relaxed text-lg">Wanlian Fluid supplies UL listed sprinkler heads, flexible drop connections, alarm valves and system accessories for wet, dry and pre-action installations in commercial and industrial buildings — one supplier for the whole sprinkler loop.</p>

			<!-- Trust badges -->
			<div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
				{['UL/ULC Listed', 'K=80 / K=115', '57–141°C Ratings', 'System BOM Supply'].map(b => (
					<div class="bg-gray-50 border border-gray-100 rounded-xl px-4 py-3 text-center">
						<span class="text-xs font-black text-brand-blue uppercase tracking-wider">{b}</span>
					</div>
				))}
			</div>

			<!-- Product series -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Sprinkler System Components</h2>
			<div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
				{sprinklerProducts.map(p => (
					<a href={`/products/${p.slug}/`} class="group bg-gray-50 rounded-xl border border-gray-100 overflow-hidden hover:border-brand-red hover:shadow-md transition">
						<img src={p.img} alt={p.name} loading="lazy" class="w-full h-28 object-contain bg-white p-2" />
						<div class="p-3">
							<p class="text-xs font-bold text-gray-800 group-hover:text-brand-red leading-snug transition-colors">{p.name}</p>
							<p class="text-[10px] text-gray-400 mt-1 line-clamp-2">{p.desc}</p>
						</div>
					</a>
				))}
			</div>

			<!-- Specifications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Key Specifications</h2>
			<div class="overflow-x-auto rounded-xl border border-gray-200 my-5">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
					<thead class="bg-gray-50">
						<tr>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Specification</th>
							<th class="px-4 py-3 text-left font-bold text-gray-500 uppercase tracking-wider">Details</th>
						</tr>
					</thead>
					<tbody class="bg-white divide-y divide-gray-200">
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Certification</td>
							<td class="px-4 py-3 text-gray-700">UL/ULC Listed (per model and destination market)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Sprinkler sizes</td>
							<td class="px-4 py-3 text-gray-700">1/2" (DN15), 3/4" (DN20), 1" — pendent, upright, sidewall</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Flow coefficient</td>
							<td class="px-4 py-3 text-gray-700">K=80 ±4 / K=115 ±9 (other K-factors per model)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Temperature ratings</td>
							<td class="px-4 py-3 text-gray-700">57°C / 68°C / 79°C / 93°C / 141°C, color-coded glass bulbs</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">Response types</td>
							<td class="px-4 py-3 text-gray-700">Standard response (5mm bulb) / Quick response (3mm bulb)</td>
						</tr>
						<tr>
							<td class="px-4 py-3 font-bold text-gray-900">System valves</td>
							<td class="px-4 py-3 text-gray-700">Wet alarm (ZSFZ), deluge (ZSFM), pre-action (ZSFY), flow indicators (ZSJZ)</td>
						</tr>
					</tbody>
				</table>
			</div>

			<!-- Applications -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Applications</h2>
			<p class="text-gray-700 leading-relaxed">Our sprinkler system components protect commercial office buildings, hotels, hospitals, schools, factories, warehouses, data centres and underground parking — with pre-action systems recommended for libraries, archives and computer rooms where accidental discharge must be avoided.</p>

			<!-- Why WLFE -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-4 tracking-tight">Why Choose Wanlian Fluid</h2>
			<ul class="list-disc pl-6 text-gray-700 leading-relaxed space-y-2 mb-4">
				<li><strong>One-stop BOM supply</strong> — heads, connections, alarm valves and accessories quoted as a single package.</li>
				<li><strong>Certified components</strong> — UL/ULC listed where applicable; certificates on our <a href="/certificates/" class="text-brand-blue font-semibold hover:underline">certificates page</a>.</li>
				<li><strong>Building-code oriented</strong> — configurations aligned with NFPA practice for global project acceptance.</li>
			</ul>

			<!-- FAQ -->
			<h2 class="text-2xl font-black text-gray-900 mt-12 mb-6 tracking-tight">Frequently Asked Questions</h2>
			<div class="space-y-4">
				{faq.map(item => (
					<details class="group bg-gray-50 rounded-xl border border-gray-100 p-5 open:border-brand-red/30">
						<summary class="flex justify-between items-center font-bold text-gray-800 cursor-pointer list-none">
							<span>{item.question}</span>
							<span class="text-brand-blue text-xl transition-transform group-open:rotate-45">+</span>
						</summary>
						<p class="mt-3 text-gray-600 leading-relaxed text-sm">{item.answer}</p>
					</details>
				))}
			</div>

			<!-- CTA -->
			<div class="mt-12 rounded-2xl overflow-hidden">
				<div class="bg-gradient-to-r from-brand-blue to-blue-800 px-6 sm:px-10 py-10 text-center">
					<h2 class="text-2xl font-black text-white tracking-tight">Need Sprinkler System Components?</h2>
					<p class="mt-3 text-blue-100 max-w-xl mx-auto text-sm leading-relaxed">Send us your building type and component list — we reply with a full BOM quotation within 12 hours.</p>
					<div class="mt-6 flex flex-col sm:flex-row justify-center gap-4">
						<a href="/contact/?product=Fire%20Sprinkler%20Systems" class="px-8 py-4 bg-brand-red text-white font-bold rounded-lg hover:opacity-90 transition">Request a Quote</a>
						<a href="https://wa.me/8618684324501?text=Hi%2C%20I%20need%20fire%20sprinkler%20system%20components" class="px-8 py-4 bg-white text-brand-blue font-bold rounded-lg hover:bg-blue-50 transition" target="_blank" rel="noopener">Chat on WhatsApp</a>
					</div>
				</div>
			</div>
		</article>
	</main>
</Layout>
